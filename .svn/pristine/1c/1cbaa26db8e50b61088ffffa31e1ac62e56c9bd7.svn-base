ui/* CSS Document */

.table{
	background-color:#FFFFFF;
    border-bottom:0px;
    border-left:0px;
    border-top:0px;
    border-right:0px;
    font-family:Verdana, Arial, Helvetica, sans-serif;
    font-size:12px;
}

.tablelogin{
	background-image:url(/datacenter/util/imgs/login.gif);
    border-bottom:0px;
    border-left:0px;
    border-top:0px;
    border-right:0px;
    font-family:Verdana, Arial, Helvetica, sans-serif;
    font-size:12px;
}

.tablelogin2{
	background-image:url(/datacenter/util/imgs/login2.gif);
    border-bottom:0px;
    border-left:0px;
    border-top:0px;
    border-right:0px;
    font-family:Verdana, Arial, Helvetica, sans-serif;
    font-size:12px;
}

.txtlogin{
	font-family:Verdana, Arial, Helvetica, sans-serif;
    font-size:13px;
    font-weight:bold;
	color:#1a4896;    
}

.msglogin{
	font-family:Verdana, Arial, Helvetica, sans-serif;
	font-size:11px;

}

.space,whitespace,spaceSearch{ /* 4px to separate a table*/
    font-size:5px;
    

} 
.input{
   font-size:10px;
   font-family:Arial, Helvetica, sans-serif;
   background-color:#F8F8F8;
}
.inputSelect{
   font-size:10px;
   font-family:Arial, Helvetica, sans-serif;
   background-color:#FFFFFF;
}

.cursor{
   cursor:pointer;

}

