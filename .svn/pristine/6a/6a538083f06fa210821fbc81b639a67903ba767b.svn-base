			try {

				if (userSessionData == null) {
					throw new DeslogedException("jjDataBySubtype","userSessionData = null");
				}
			 
				Session session=HibernateUtil.currentSession();
				Query queryNonRecordable=session.createQuery("select nr from JJCrashNonRecordable as nr where nr.snapshot.year="+year+" and nr.snapshot.month="+month+"");
				Integer countNonRecordable=0;
				Iterator iter=queryNonRecordable.list().iterator();
				if(iter.hasNext()){
					JJCrashNonRecordable nr=(JJCrashNonRecordable) iter.next();
					countNonRecordable=nr.getCount();
				}
				
				Query query=session.createQuery("select ch from JJCrashSubtypes as ch where ch.snapshot.year="+year+" and ch.snapshot.month="+month+" order by ch.order ");
	            iter=query.list().iterator();
	         
	            while(iter.hasNext()){
	            	JJCrashSubtypes ch=(JJCrashSubtypes) iter.next();
	            	JJCrashSubtypesData data=ch.getData();
	            	data.setCountNonRecordable(countNonRecordable);
	            	res.add(data);
	            }
				

			} catch (Exception e) {
				Object[] parameters = {year,month};
			    handler.getException(e,"jjDataBySubtype",userSessionData,parameters);
			}
			
			return res;
		}
	
	
