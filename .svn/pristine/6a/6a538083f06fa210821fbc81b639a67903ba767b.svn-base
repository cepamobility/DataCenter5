    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,systemaccess" 
     */
    public ArrayList<ChecklistReportHead> findCheckReportHead(Integer startDay, Integer startMonth , Integer startYear, Integer endDay,Integer endMonth,Integer endYear,String type,UserSessionData userSessionData) throws Exception {
    	ArrayList<ChecklistReportHead> res = new ArrayList<ChecklistReportHead>();
        try {
        	if (userSessionData == null) {
        		throw new DeslogedException("findCheckReportHead","userSessionData = null");
        	}
        	Integer corporation=userSessionData.getCorporationId();
        			
        	Session session = HibernateUtil.currentSession();
            String sql = " select to_char(vehicleCheck.date, 'YYYY/MM/DD')  as dateStr, vehicle.divOrg1, vehicleCheck.result,vehicle.divOrg3, vehicle.matricula, vehicleCheck.inspectedBy,vehicleCheck.vehicleCheckId,vehicle.id, un.id as unid "+ 
            			 " from vehiclecheck as vehicleCheck "+
            			 " inner join vehicles as vehicle on( vehicle.id = vehicleCheck.vehicle )"+
            			 " left outer join unconformitydpa as un on( un.vehicleCheckId = vehicleCheck.vehicleCheckId ) "+
            			 " where vehicle.corporation= "+corporation+" "+
            			 " and  "+(startYear!=null?"to_date(to_char(vehicleCheck.date, 'YYYY-MM-DD'), 'YYYY-MM-DD')>=to_date((:sd), 'YYYY-MM-DD') and":"")+" "+(endYear!=null?"to_date(to_char(vehicleCheck.date, 'YYYY-MM-DD'), 'YYYY-MM-DD')<to_date((:ed), 'YYYY-MM-DD')  and":"")+" vehicleCheck.name="+(type.equalsIgnoreCase("s")?"'79'":"'80'") +
            			 " order by dateStr desc ";
            
            Query query = session.createSQLQuery(sql);//
            
            if(startYear!=null){
            	query.setParameter("sd", Util.formatHSQL(Util.getDateFloor(startYear, startMonth, startDay),0));	
            }
            
            if(endYear!=null){
            	query.setParameter("ed", Util.formatHSQL(Util.getDateFloor(endYear,endMonth,endDay),1));	
            }
            
            
            Iterator iter = query.list().iterator();
            while(iter.hasNext()){
            	Object[] row=(Object[])iter.next();
        		String date=(String) row[0];
        		Integer divOrg1=(Integer) row[1];
        		Integer result=(Integer) row[2];
        		Integer divOrg3=(Integer) row[3];
        		String matricula=(String) row[4];
        		String inspectedBy=(String) row[5];
        		Integer checkId=(Integer) row[6];
        		Integer vehicleId=(Integer) row[7];
        		Integer unId=(Integer) row[8];
        		ChecklistReportHead vc=new ChecklistReportHead();
            	vc.setResult(result.toString());
            	vc.setPlate(matricula);
            	vc.setDate(date);
            	vc.setInspectedBy(inspectedBy);
            	vc.setVehicleCheckId(checkId);
            	vc.setVehicleId(vehicleId);
            	vc.setUnconformityId(unId);
            	
            	if(corporation.equals(CorporationData.COFUSA) || corporation.equals(9) || corporation.equals(50)){
            		if(divOrg1!=null && divOrg1>0){
                		DivOrgItemLevel1 divOrg=(DivOrgItemLevel1)session.load(DivOrgItemLevel1.class, divOrg1);
                		if(divOrg!=null){
                			vc.setTransporter(divOrg.getResourceKey());
                    	}
            		}
            	}else if(corporation.equals(19) )
	            	if(divOrg3!=null && divOrg3>0){
	            		DivOrgItemLevel1 divOrg=(DivOrgItemLevel1)session.load(DivOrgItemLevel1.class, divOrg3);
	            		if(divOrg!=null){
	            			vc.setTransporter(divOrg.getResourceKey());
	            		}
	            	}
            	
            	Query query2=session.createSQLQuery("select count(*) from vehiclecheckitemsvalues where vehiclecheck="+checkId+" and itemValue='2'");
            	BigInteger val=(BigInteger) query2.uniqueResult();
            	vc.setWithObservations(val.intValue()>0);
            	
            	res.add(vc);
            }
            
            
            return res;
        } catch (Exception e) {
        	Object[] parameters = {userSessionData,startMonth,endMonth};
            handler.getException(e,"ChecklistReportHead",userSessionData,parameters);
        }
        return new ArrayList<ChecklistReportHead>();
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,systemaccess" 
     */
    public ArrayList<ChecklistReportItem> findCheckReportItem(Integer startDay, Integer startMonth , Integer startYear, Integer endDay,Integer endMonth,Integer endYear,String type,UserSessionData userSessionData) throws Exception {
    	ArrayList<ChecklistReportItem> res = new ArrayList<ChecklistReportItem>();
        try {
        	if (userSessionData == null) {
        		throw new DeslogedException("findCheckReportItem","userSessionData = null");
        	}
        	Integer corporation=userSessionData.getCorporationId();
        			
        	Session session = HibernateUtil.currentSession();
            String sql = "  select to_char(vehicleCheck.date, 'YYYY/MM/DD')  as dateStr, vehicle.divOrg1, vehicleCheck.result,vehicle.divOrg3, vehicle.matricula,iv.itemvalue,iv.itemtag,vehicleCheck.inspectedBy,m.text  "+ 
            			 " from vehiclecheckitemsvalues as iv "+
            			 " inner join vehiclecheck as vehicleCheck on(vehicleCheck.vehicleCheckId=iv.vehicleCheck) "+
            			 " inner join vehicles as vehicle on( vehicle.id = vehicleCheck.vehicle ) "+
            			 " inner join items as i on (i.id=iv.item) "+
                 		 " inner join generalmessages as m on (m.labelKey=i.text and m.language='es') "+
            			 " left outer join unconformitydpa as un on( un.vehicleCheckId = vehicleCheck.vehicleCheckId ) "+
            			 " where iv.itemvalue='2' and vehicle.corporation= "+corporation+" "+
            			 " and  "+(startYear!=null?"to_date(to_char(vehicleCheck.date, 'YYYY-MM-DD'), 'YYYY-MM-DD')>=to_date((:sd), 'YYYY-MM-DD') and":"")+" "+(endYear!=null?"to_date(to_char(vehicleCheck.date, 'YYYY-MM-DD'), 'YYYY-MM-DD')<to_date((:ed), 'YYYY-MM-DD')  and":"")+" vehicleCheck.name="+(type.equalsIgnoreCase("s")?"'79'":"'80'") +
            			 " order by dateStr desc";
            
            Query query = session.createSQLQuery(sql);//
            
            if(startYear!=null){
            	query.setParameter("sd", Util.formatHSQL(Util.getDateFloor(startYear, startMonth, startDay),0));	
            }
            
            if(endYear!=null){
            	query.setParameter("ed", Util.formatHSQL(Util.getDateFloor(endYear,endMonth,endDay),1));	
            }
            
            
            Iterator iter = query.list().iterator();
            while(iter.hasNext()){
            	ChecklistReportItem item=new ChecklistReportItem();
            	Object[] row=(Object[])iter.next();
        		String date=(String) row[0];
        		Integer divOrg1=(Integer) row[1];
        		Integer result=(Integer) row[2];
        		Integer divOrg3=(Integer) row[3];
        		String matricula=(String) row[4];
        		String value=(String) row[5];
        		String tag=(String) row[6];
        		String inspectedBy=(String) row[7];
        		String text=(String) row[8];
            	
        		item.setDate(date);
        		item.setInspectedBy(inspectedBy);
        		item.setObservations("");
        		item.setTag(tag);
        		item.setPlate(matricula);
        		item.setResult(value);
        		item.setText(text);
        		
            	if(corporation.equals(CorporationData.COFUSA) || corporation.equals(9) || corporation.equals(50)){
            		if(divOrg1!=null && divOrg1>0){
                		DivOrgItemLevel1 divOrg=(DivOrgItemLevel1)session.load(DivOrgItemLevel1.class, divOrg1);
                		if(divOrg!=null){
                			item.setTransporter(divOrg.getResourceKey());
                    	}
            		}
            	}else if(corporation.equals(19) )
	            	if(divOrg3!=null && divOrg3>0){
	            		DivOrgItemLevel1 divOrg=(DivOrgItemLevel1)session.load(DivOrgItemLevel1.class, divOrg3);
	            		if(divOrg!=null){
	            			item.setTransporter(divOrg.getResourceKey());
	            		}
	            	}
            	
            	
            	
            	res.add(item);
            }
            
            
            return res;
        } catch (Exception e) {
        	Object[] parameters = {userSessionData,startMonth,endMonth};
            handler.getException(e,"findCheckReportItem",userSessionData,parameters);
        }
        return new ArrayList<ChecklistReportItem>();
    }

    
    
    /**
	 * @throws Exception 
     * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,systemaccess"
	*/
	public ArrayList<UnconformityAction> forestalesUnconformities(Integer vehicleId,String checkName,Date start,Date end,Integer type,Integer times ,  UserSessionData userSessionData,Text messages) throws Exception{
		 ArrayList<UnconformityAction> res=new ArrayList<UnconformityAction>();
		try {

			if (userSessionData == null) {
				throw new DeslogedException("forestalesUnconformities","userSessionData = null");
			}
		 
			String where=""+UtilityQuery.corporationDivisionsRestictionsSQL("v", userSessionData);
			if(start!=null || end!=null){
				where+=" and vc.name in ("+checkName+")  ";
				where+=" and "+(start!=null?"to_date(to_char(u.date, 'YYYY-MM-DD'), 'YYYY-MM-DD') >=to_date((:start), 'YYYY-MM-DD')":"1=1");
				where+=" and ";
				where+= end!=null?"to_date(to_char(u.date, 'YYYY-MM-DD'), 'YYYY-MM-DD') <to_date((:end), 'YYYY-MM-DD') ":"1=1";
				
			}
			if(vehicleId!=null){
				where+=" and v.id="+vehicleId; 
			}
			
			switch (times) {
				case 5:
					where+=" and  EXTRACT(MONTH FROM i.expirity)=EXTRACT(MONTH FROM u.date  + interval '30 day') and EXTRACT(YEAR FROM i.expirity)=EXTRACT(YEAR FROM u.date + interval '30 day') and EXTRACT(DAY FROM (i.expirity ))=EXTRACT(DAY FROM u.date + interval '30 day') ";
					break;
				case 1:
					where+=" and  EXTRACT(MONTH FROM i.expirity )=EXTRACT(MONTH FROM u.date + interval '0 day') and EXTRACT(YEAR FROM i.expirity)=EXTRACT(YEAR FROM u.date + interval '0 day') and EXTRACT(DAY FROM i.expirity )=EXTRACT(DAY FROM u.date + interval '0 day') ";
					break;
				case 2:
					where+=" and  EXTRACT(MONTH FROM i.expirity )=EXTRACT(MONTH FROM u.date + interval '1 day') and EXTRACT(YEAR FROM i.expirity)=EXTRACT(YEAR FROM u.date + interval '1 day') and EXTRACT(DAY FROM i.expirity)=EXTRACT(DAY FROM u.date  + interval '1 day') ";
					break;
				case 3:
					where+=" and  EXTRACT(MONTH FROM i.expirity )=EXTRACT(MONTH FROM u.date + interval '2 day') and EXTRACT(YEAR FROM i.expirity)=EXTRACT(YEAR FROM u.date + interval '2 day') and EXTRACT(DAY FROM i.expirity)=EXTRACT(DAY FROM u.date  + interval '2 day') ";
					break;
	
				case 4:
					where+=" and  EXTRACT(MONTH FROM i.expirity )=EXTRACT(MONTH FROM u.date + interval '3 day') and EXTRACT(YEAR FROM i.expirity)=EXTRACT(YEAR FROM u.date + interval '3 day') and EXTRACT(DAY FROM i.expirity)=EXTRACT(DAY FROM u.date  + interval '3 day') ";
					break;
				case 6://Expiranron o expiran en la proxima semana
					where+=" and  i.expirity>=current_timestamp + interval '1h' * 6 and i.expirity<=current_timestamp + interval '1 h' * 6 + interval '7 day'" ;
					break;
				default:
					break;
			}
			
			switch (type) {
			// //"Todas las fallas","Consulta de fallas abiertas","Consulta de fallas cerradas","Fallas cerradas en fecha","Fallas cerradas fuera de plazo"
				case 1:
					where+=" and i.correctiveactiondpa is null "; 
					break;
				case 2:
					where+=" and i.correctiveactiondpa is not null "; 
					break;
				case 3://Se corrige en plazo o se corige y es sin plazo
					where+=" and i.correctiveactiondpa is not null and (to_date(to_char(a.date, 'YYYY-MM-DD'), 'YYYY-MM-DD') <= to_date(to_char(i.expirity, 'YYYY-MM-DD'), 'YYYY-MM-DD') or to_date(to_char(u.date, 'YYYY-MM-DD'), 'YYYY-MM-DD')=to_date(to_char(i.expirity + interval '1 day', 'YYYY-MM-DD'), 'YYYY-MM-DD')) "; 
					break;
				case 4://Esta corregida y es con fecha de corrección mayor a la de expiración o y no es sin plazo. 
					where+=" and i.correctiveactiondpa is not null and  to_date(to_char(a.date, 'YYYY-MM-DD'), 'YYYY-MM-DD') > to_date(to_char(i.expirity , 'YYYY-MM-DD'), 'YYYY-MM-DD') and not  ( to_date(to_char(u.date, 'YYYY-MM-DD'), 'YYYY-MM-DD') = to_date(to_char(i.expirity + interval '1 day' , 'YYYY-MM-DD'), 'YYYY-MM-DD'))"; 
					break;
				case 5://No esta corregida y es con fecha  expiración vencida. 
					where+=" and i.correctiveactiondpa is null and ( to_date(to_char(CURRENT_TIMESTAMP, 'YYYY-MM-DD'), 'YYYY-MM-DD') > to_date(to_char(i.expirity , 'YYYY-MM-DD'), 'YYYY-MM-DD') or ( to_date(to_char(CURRENT_TIMESTAMP, 'YYYY-MM-DD'), 'YYYY-MM-DD') = to_date(to_char(i.expirity , 'YYYY-MM-DD'), 'YYYY-MM-DD') and to_date(to_char(CURRENT_TIMESTAMP, 'YYYY-MM-DD'), 'YYYY-MM-DD') = to_date(to_char(u.date , 'YYYY-MM-DD'), 'YYYY-MM-DD')) ) and  not ( to_date(to_char(u.date, 'YYYY-MM-DD'), 'YYYY-MM-DD') = to_date(to_char(i.expirity + interval '1 day' , 'YYYY-MM-DD'), 'YYYY-MM-DD'))"; 
					break;	
				default:
					break;
			}
			
			Session session=HibernateUtil.currentSession();
			Query query=session.createSQLQuery("select u.id,u.date,i.type,i.comment as iComment,i.expirity ,v.matricula,i.correctiveactiondpa, a.comment as aComment, a.date as aDate, v.divOrg1,v.divOrg3"+ 
	            		" from unconformityitemdpa as i INNER JOIN unconformitydpa as u on (i.unconformitydpa=u.id and u.corpId="+userSessionData.getCorporationId()+") "+ 
	            		" INNER JOIN vehiclecheck as vc on vc.vehiclecheckid=u.vehiclecheckid "+
	            		" LEFT OUTER JOIN  correctiveactiondpa as a ON a.id=i.correctiveactiondpa "+ 
	            		" INNER JOIN vehicles as v on vc.vehicle=v.id "+where+" order by u.date");
			if(start!=null){
	            	query.setParameter("start", Util.formatHSQL(start,0));
            }
            if(end!=null){
            	query.setParameter("end", Util.formatHSQL(end,1));
            }
	            
	            
            Iterator iter=query.list().iterator();
            
            while(iter.hasNext()){
            	Object[] row=(Object[])iter.next();
            	Integer uId=(Integer) row[0];
            	Date uDate=(Date)row[1];
            	String iType=(String) row[2];
            	String iComment=(String) row[3];
            	Date iExpirity=(Date)row[4];
            	String matricula =(String)row[5];
            	Integer caId=(Integer)row[6];
            	String caComment=(String)row[7];
            	Date aDate=(Date)row[8];
            	Integer divOrg1=(Integer)row[9];
            	Integer divOrg3=(Integer)row[10];
            	String contractorName="";
            	if(userSessionData.getCorporationId()==CorporationData.WEYERHAEUSER){
            		DivOrgItemLevel1 item1=(DivOrgItemLevel1) session.load(DivOrgItemLevel1.class, divOrg3);
            		contractorName=item1.getResourceKey();
            	}else{
            		DivOrgItemLevel1 item1=(DivOrgItemLevel1) session.load(DivOrgItemLevel1.class, divOrg1);
            		contractorName=item1.getResourceKey();
                }
            	UnconformityAction rowUA=new UnconformityAction();
            	rowUA.setDateItem(Util.formatDateWithHour2(uDate));
            	rowUA.setCommentAction(caComment);
            	rowUA.setCommentItem(iComment);
            	rowUA.setContractorName(contractorName);
            	rowUA.setCorrectiveActionId(caId);
            	rowUA.setDateAction(Util.formatDateWithHour2(aDate));
            	rowUA.setIdItem(uId);
            	rowUA.setMatricula(matricula);
            	rowUA.setTypeItem(messages.getText(iType));
            	
            	Calendar cal =Calendar.getInstance();
            	cal.setTime(Util.floorDate(uDate));
            	Calendar cal2 =Calendar.getInstance();
            	cal2.setTime(Util.floorDate(iExpirity));
            	if(Util.compareOnlyDate(cal2,cal)>=0){
            	
            		rowUA.setExpirityItem(Util.formatDateWithHour2(iExpirity));
            		if(caId!=null){
            			cal =Calendar.getInstance();
            			cal.setTime(Util.floorDate(aDate));
            			if(Util.compareOnlyDate(cal,cal2)<=0){
            				//En fecha
            				rowUA.setStatus(1);
            			}else{
            				rowUA.setStatus(2);
            			}
            		}else{
            			Calendar calNow =Calendar.getInstance();
            			calNow.setTime(Util.floorDate(new Date()));
            			//Si no es detención inmediata y todavía no venció incluyendo hoy.
            			if(Util.compareOnlyDate(calNow, cal2)<=0 && !(Util.compareOnlyDate(cal,cal2)==0)){
            				//Nn vencio
            				rowUA.setStatus(3);
            			}else{
            				//Vencida
            				rowUA.setStatus(4);
            			}
            				
            		}
            	}else{
            		if(caId!=null){
            			rowUA.setStatus(1);
            			rowUA.setExpirityItem("S/P");
            		}else{
	            		rowUA.setExpirityItem("S/P");
	            		rowUA.setStatus(3);//
            		}
            	}
            	
            	res.add(rowUA);
            }
           

		} catch (Exception e) {
			Object[] parameters = {start,end,type,times};
		    handler.getException(e,"forestalesUnconformities",userSessionData,parameters);
		}
		return res;
	}
	
	
	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,systemaccess"
     */ 
    public ListResult findVehicleList(String value, UserSessionData userRequest,int attribute,int first,int count, int status) throws Exception {
        ListResult listResult=null;
        try{    
            Session session = HibernateUtil.currentSession();

            String queryStr = "SELECT COUNT(*) FROM Vehicle AS vehicle ";
            
            if(userRequest.isDriver()) {
                queryStr += " WHERE vehicle.corpCountry.pk.corporation.id = "+userRequest.getFilter().getCorporationId();
                queryStr += " AND vehicle.driver IS NOT null AND vehicle.driver.id = "+String.valueOf(userRequest.getDriverData().getId());            
            }else {
                queryStr += UtilityQuery.corporationDivisionsRestictions("vehicle",userRequest);                
            }
            
            Query query = getQuery(session,attribute,queryStr,value,userRequest, status);
            
            List vehicleColl = query.list();
            Iterator iter = vehicleColl.iterator();
            Integer total = new Integer(0);
            while (iter.hasNext()) {
                total = new Integer(((Long) iter.next()).intValue());
            }
            
            queryStr = " SELECT vehicle FROM Vehicle AS vehicle ";
            
            if(userRequest.isDriver()) {
                queryStr += " WHERE vehicle.corpCountry.pk.corporation.id = "+userRequest.getFilter().getCorporationId();
                queryStr += " AND vehicle.driver IS NOT null AND vehicle.driver.id = "+String.valueOf(userRequest.getDriverData().getId());            
            }else {
                queryStr += UtilityQuery.corporationDivisionsRestictions("vehicle",userRequest);                
            }
            
            query = getQueryWithOrderBy(session,attribute,queryStr,value,status, userRequest);
            
            if(count != -1) {
                if(total.intValue() < first) {
                    if(total.intValue() % count == 0) {
                        first = total.intValue() - count;
                    }else {
                        first = total.intValue() - (total.intValue() % count);
                    }
                }
                query.setFirstResult(first);
                query.setMaxResults(count);
            }
            
            vehicleColl = query.list();
            Collection result = new LinkedList();
            if (vehicleColl != null){
            	 iter = vehicleColl.iterator();
                 Vehicle vehicle;
                 while (iter.hasNext()) {
                	 vehicle = (Vehicle) iter.next();
                	 if (vehicle != null && vehicle.getVehicleData()!= null){
                		 result.add(vehicle.getVehicleData());
                	 }
                 }
            }

            listResult = new ListResult(result, total.intValue());
            
        } catch (Exception e) {
			Object[] parameters = {value,attribute,first,count,status};
             handler.getException(e,"findList",userRequest,parameters);
             
        }
        
        return listResult;
            
    }  
    
    /**
	 * @ejb.permission role-name ="administrator,systemaccess"
	 * @ejb.interface-method
	 */
	public ListResult findDriverByCorporationIdFirstNameLastName(String stringSearch,Integer level, UserSessionData userRequest) throws Exception {
		
		if (userRequest == null) {
			throw new DeslogedException("findDriverByCorporationIdFirstNameLastName","session null");
		}
		Collection values = new LinkedList();
		ListResult result=new ListResult();
		try {
			
			if(stringSearch!=null){
				stringSearch=stringSearch.toUpperCase();
			}
			
			String queryStr = "SELECT COUNT(*) FROM drivers AS driver ";
            
			switch (level) {
			case 0://Todas
				break;
			case 1://Puntaje amarillo entre 80 y 60 puntos
				queryStr+=" inner join PointAccount as p on (CAST(p.reference as INTEGER)=driver.id and p.type=1 and p.total<=80 and  p.total>60) ";
				break;
			case 2://Puntaje naranja entre 60 y 40 puntos
				queryStr+=" inner join PointAccount as p on (CAST(p.reference as INTEGER)=driver.id and p.type=1 and p.total<=60 and  p.total>40) ";
				break;
			case 3://Puntaje rojo menor a 40 puntos 
				queryStr+=" inner join PointAccount as p on (CAST(p.reference as INTEGER)=driver.id and p.type=1 and p.total<=40) ";
				break;
			}
		
			queryStr += UtilityQuery.corporationDivisionsRestictionsSQL("driver", userRequest);
			
			if(stringSearch != null){
				queryStr += " AND ( driver.corporationId like '"+stringSearch+"%' or driver.firstName like '"+stringSearch+"%' or driver.lastName like '"+stringSearch+"%') ";
			}
		
			
			Query query =HibernateUtil.currentSession().createSQLQuery(queryStr);
	        
            List drivereColl = query.list();
            Iterator iter = drivereColl.iterator();
            Integer total = new Integer(0);
            while (iter.hasNext()) {
                total = new Integer(((BigInteger) iter.next()).intValue());
            }
         
			String sql = "SELECT driver.id FROM drivers AS driver  ";
	
   			switch (level) {
			case 0://Todas
				break;
			case 1://Puntaje amarillo entre 80 y 60 puntos
				sql+=" inner join PointAccount as p on (CAST(p.reference as INTEGER)=driver.id and p.type=1 and p.total<=80 and  p.total>60) ";
				break;
			case 2://Puntaje naranja entre 60 y 40 puntos
				sql+=" inner join PointAccount as p on (CAST(p.reference as INTEGER)=driver.id and p.type=1 and p.total<=60 and  p.total>40) ";
				break;
			case 3://Puntaje rojo menor a 40 puntos 
				sql+=" inner join PointAccount as p on (CAST(p.reference as INTEGER)=driver.id and p.type=1 and p.total<=40) ";
				break;
			}
			
   			sql += UtilityQuery.corporationDivisionsRestictionsSQL("driver", userRequest);
			
   			if(stringSearch != null){
				sql += " AND ( driver.corporationId like '"+stringSearch+"%' or driver.firstName like '"+stringSearch+"%' or driver.lastName like '"+stringSearch+"%' )";
			}
				
			query = HibernateUtil.currentSession().createSQLQuery(sql);
			 
			CorporationReport corpReport=CorporationReportUtil.getHome().create();
			
			List drivers = query.list();
			if (drivers != null) {
				Iterator driversIt = drivers.iterator();
				while (driversIt.hasNext()) {
					Driver driver= (Driver)HibernateUtil.currentSession().load(Driver.class, (Integer)driversIt.next()) ;
					DriverStatusData statusD=new DriverStatusData();
					statusD.setDriver(driver.getDriverData());
					statusD.setPointAccount(corpReport.getPointAccount(1,driver.getId(),userRequest));
					values.add(statusD);
				}
			}
			result = new ListResult(values, total);
		} catch (Exception e) {
			Object[] parameters = { stringSearch };
			handler.getException(e, "findDriverByCorporationIdFirstNameLastName", userRequest, parameters);
		}
	 
		return result;
	}
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */ 
    public ListResult findVehicleWithStatusList(String value, UserSessionData userRequest,int attribute,int first,int count, int status, Text messages) throws Exception {
        ListResult listResult=null;
        try{    
            Session session = HibernateUtil.currentSession();

            String queryStr = "SELECT COUNT(*) FROM Vehicle AS vehicle ";
            
            if(userRequest.isDriver()) {
                queryStr += " WHERE vehicle.corpCountry.pk.corporation.id = "+userRequest.getFilter().getCorporationId();
                queryStr += " AND vehicle.driver IS NOT null AND vehicle.driver.id = "+String.valueOf(userRequest.getDriverData().getId());            
            }else {
                queryStr += UtilityQuery.corporationDivisionsRestictions("vehicle",userRequest);                
            }
            
            Query query = getQuery(session,attribute,queryStr,value,userRequest, status);
            
            List vehicleColl = query.list();
            Iterator iter = vehicleColl.iterator();
            Integer total = new Integer(0);
            while (iter.hasNext()) {
                total = new Integer(((Long) iter.next()).intValue());
            }
            
            queryStr = " SELECT vehicle FROM Vehicle AS vehicle ";
            
            if(userRequest.isDriver()) {
                queryStr += " WHERE vehicle.corpCountry.pk.corporation.id = "+userRequest.getFilter().getCorporationId();
                queryStr += " AND vehicle.driver IS NOT null AND vehicle.driver.id = "+String.valueOf(userRequest.getDriverData().getId());            
            }else {
                queryStr += UtilityQuery.corporationDivisionsRestictions("vehicle",userRequest);                
            }
            
            query = getQueryWithOrderBy(session,attribute,queryStr,value,status, userRequest);
            
            if(count != -1) {
                if(total.intValue() < first) {
                    if(total.intValue() % count == 0) {
                        first = total.intValue() - count;
                    }else {
                        first = total.intValue() - (total.intValue() % count);
                    }
                }
                query.setFirstResult(first);
                query.setMaxResults(count);
            }
            
            CorporationReport corpReport=CorporationReportUtil.getHome().create();

            vehicleColl = query.list();
            Collection result = new LinkedList();
            if (vehicleColl != null){
            	 iter = vehicleColl.iterator();
                 Vehicle vehicle;
                 while (iter.hasNext()) {
                	 vehicle = (Vehicle) iter.next();
                	 if (vehicle != null && vehicle.getVehicleData()!= null){
                		 
                		 Query queryState=session.createQuery("select s from VehicleState as s where s.vehicle.id="+vehicle.getId());
                		 List list=queryState.list();
                		 VehicleState vstate=new VehicleState();
                		 if(list.iterator().hasNext()){
                			 vstate = (VehicleState)list.iterator().next();
                		 }else{
                		 	 vstate.setState(VehicleStateData.ACTIVE);
            				 vstate.setStateDate(vehicle.getInclusionDate());
            			 }
                		 
                		 VehicleStatusData statusV=new VehicleStatusData();
                		 
                		 statusV.setState(vstate.getData());
                 		 statusV.setPointAccount(corpReport.getPointAccount(2,vehicle.getId(),userRequest));
                 		 statusV.setVehicle(vehicle.getVehicleData());
                 		 statusV.setUnconformities(forestalesUnconformities(vehicle.getId(), "80", null, null, 5, 0, userRequest, messages));
                		 
                 		 result.add(statusV);
                	 }
                 }
            }

            listResult = new ListResult(result, total.intValue());
            
        } catch (Exception e) {
			Object[] parameters = {value,attribute,first,count,status};
             handler.getException(e,"findVehicleWithStatusList",userRequest,parameters);
             
        }
        
        return listResult;
            
    }   
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,systemaccess"
     */ 
    public DriverStatusData findDriverWithStatus(Integer driverId, UserSessionData userRequest, Text messages) throws Exception {
        ListResult listResult=null;
        try{    
            Session session = HibernateUtil.currentSession();
            CorporationReport corpReport=CorporationReportUtil.getHome().create();
            CorporationABM corpABM=CorporationABMUtil.getHome().create();
            
            String queryStr = " SELECT driver FROM Driver AS driver ";
            
            queryStr += UtilityQuery.corporationDivisionsRestictions("driver",userRequest);                
          
            queryStr +=" and driver.id="+driverId;
            
            Iterator iter=session.createQuery(queryStr).list().iterator();
            Driver driver = (Driver) iter.next();
        	if (driver != null && driver.getDriverData()!= null){
        		 
        		 DriverStatusData statusD=new DriverStatusData();
        		 
        		 statusD.setPointAccount(corpReport.getPointAccount(1,driver.getId(),userRequest));
        		 statusD.getPointAccount().setMoves(corpReport.getPointMoves(statusD.getPointAccount().getId(),30,false, userRequest));
        		 statusD.setDriver(driver.getDriverData());
         		 
         		 return statusD;
        	 }
          
        } catch (Exception e) {
			Object[] parameters = {driverId};
             handler.getException(e,"findVehicleWithStatus",userRequest,parameters);
             
        }
        
        return null;
            
    }   
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */ 
    public VehicleStatusData findVehicleWithStatus(Integer vehicleId, UserSessionData userRequest, Text messages) throws Exception {
        ListResult listResult=null;
        try{    
            Session session = HibernateUtil.currentSession();
            CorporationReport corpReport=CorporationReportUtil.getHome().create();
            CorporationABM corpABM=CorporationABMUtil.getHome().create();
            
            String queryStr = " SELECT vehicle FROM Vehicle AS vehicle ";
            
            if(userRequest.isDriver()) {
                queryStr += " WHERE vehicle.corpCountry.pk.corporation.id = "+userRequest.getFilter().getCorporationId();
                queryStr += " AND vehicle.driver IS NOT null AND vehicle.driver.id = "+String.valueOf(userRequest.getDriverData().getId());            
            }else {
                queryStr += UtilityQuery.corporationDivisionsRestictions("vehicle",userRequest);                
            }
            queryStr +=" and vehicle.id="+vehicleId;
            
            Iterator iter=session.createQuery(queryStr).list().iterator();
            Vehicle vehicle = (Vehicle) iter.next();
        	if (vehicle != null && vehicle.getVehicleData()!= null){
        		 
        		 VehicleState vstate=corpABM.getOrCreateVehicleState(vehicle.getVehicleData());
        	
        		 VehicleStatusData statusV=new VehicleStatusData();
        		 
        		 statusV.setState(vstate.getData());
         		 statusV.setPointAccount(corpReport.getPointAccount(2,vehicle.getId(),userRequest));
         		 statusV.getPointAccount().setMoves(corpReport.getPointMoves(statusV.getPointAccount().getId(),30,false, userRequest));
         		 statusV.setVehicle(vehicle.getVehicleData());
         		 
         		 statusV.setUnconformities(forestalesUnconformities(vehicle.getId(), "80", null, null, 5, 0, userRequest, messages));
         		 
         		 return statusV;
        	 }
          
        } catch (Exception e) {
			Object[] parameters = {vehicleId};
             handler.getException(e,"findVehicleWithStatus",userRequest,parameters);
             
        }
        
        return null;
            
    }   
    
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */ 
    public FleetStatusData findFleetWithStatusList(Date dateBase,UserSessionData userRequest,Text messages ) throws Exception {
    	FleetStatusData res=new FleetStatusData();
        try{    
            Session session = HibernateUtil.currentSession();

            String querySQLStr = "select v.matricula,c.total,m.description,m.amount,m.date,m.time ,v.id"+ 
		            		 " from PointAccount as c "+ 
		            		 " inner join PointMoves as m on(m.account=c.id) "+
		            		 " inner join Vehicles as v on(v.id=CAST(c.reference as INTEGER))";
            
            if(userRequest.isDriver()) {
            	querySQLStr += " WHERE v.corporation = "+userRequest.getFilter().getCorporationId();
            	querySQLStr += " AND v.driver IS NOT null AND v.driver = "+String.valueOf(userRequest.getDriverData().getId());            
            }else {
            	querySQLStr += UtilityQuery.corporationDivisionsRestictionsSQL("v",userRequest);                
            }
            Calendar cal=Calendar.getInstance();
            cal.setTime(dateBase);
            cal.add(Calendar.DATE,-8);
            querySQLStr+=" ORDER BY m.date desc, m.time desc LIMIT 50";
            Query query = session.createSQLQuery(querySQLStr);
            res.setMoves(new ArrayList<PointMoveData>());
            Iterator iter=query.list().iterator();
            while(iter.hasNext()){
            	Object[] row=(Object[])iter.next();
            	String plate=(String) row[0];
            	Double total=(Double) row[1];
            	String desc=(String) row[2];
            	Double amount=(Double) row[3];
            	Date date=(Date) row[4];
            	Time time=(Time) row[5];
            	Integer vehicleId= (Integer)row[6];
            	cal=Calendar.getInstance();
            	cal.setTime(date);
				cal.set(Calendar.HOUR,time.getHours());
				cal.set(Calendar.MINUTE,time.getMinutes());
				cal.set(Calendar.SECOND,time.getSeconds());
					
            	PointMoveData move=new PointMoveData();
            	move.setAmount(amount);
            	move.setReference(plate);
            	move.setDate(cal);
            	move.setDescription(desc);
            	move.setId(vehicleId);
            	
            	res.getMoves().add(move);
            }

            querySQLStr=" select v.id, v.matricula,s.state,s.statedate,s.hours,s.reasoncode,s.typeofpenalty "+ 
						" from VehicleState as s "+
						" inner join vehicles as v on(v.id=s.vehicle  and v.exclusiondate is null) ";
            if(userRequest.isDriver()) {
            	querySQLStr += " WHERE v.corporation = "+userRequest.getFilter().getCorporationId();
            	querySQLStr += " AND v.driver IS NOT null AND v.driver = "+String.valueOf(userRequest.getDriverData().getId());            
            }else {
            	querySQLStr += UtilityQuery.corporationDivisionsRestictionsSQL("v",userRequest);                
            }
            querySQLStr+=" and s.state in ('SUSPENDED_INDETERMINATE','SUSPENDED_HOURS')"; 
            query = session.createSQLQuery(querySQLStr);
            res.setSuspendedVehicles(new ArrayList<VehicleStatusData>());
            iter=query.list().iterator();
            while(iter.hasNext()){
            	Object[] row=(Object[])iter.next();
            	Integer vehicleId=(Integer) row[0];
            	String plate=(String) row[1];
            	String state=(String) row[2];
            	Date stateDate=(Date) row[3];
            	Integer hours=(Integer) row[4];
            	Integer reasonCode=(Integer) row[5];
            	Integer typeOfPenalty=(Integer) row[6];
            	
            	VehicleStatusData status=new VehicleStatusData();
            	status.setVehicle(new VehicleData());
            	status.getVehicle().setMatricula(plate);
            	status.getVehicle().setId(vehicleId);
            	status.setState(new VehicleStateData());
            	status.getState().setState(state);
            	status.getState().setHours(hours);
            	status.getState().setStateDate(stateDate);
            	status.getState().setReasonCode(reasonCode);
            	status.getState().setTypeOfPenalty(typeOfPenalty);
            	
            	res.getSuspendedVehicles().add(status);
            }
            
            res.setUnconformities(forestalesUnconformities(null, "80", null, null, 5, 0, userRequest, messages));
            
        } catch (Exception e) {
        	e.printStackTrace();
			Object[] parameters = {};
             handler.getException(e,"findFleetWithStatusList",userRequest,parameters);
             
        }
        
        return res;
            
    }
    
    
