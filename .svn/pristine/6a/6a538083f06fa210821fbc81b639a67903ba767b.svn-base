		/**
		  * @ejb.interface-method
		  * @ejb.permission role-name = "administrator,pointconfupdate"
		  */
		public CalculateRetroactiveImpactData pointsCalculateRetroactiveImapact(Collection<PointsDefinitionData> definitions,ArrayList<FringeData> fringers, Integer backDays, UserSessionData userSessionData) throws Exception{		
			CalculateRetroactiveImpactData res=new CalculateRetroactiveImpactData();
				try {

					if (userSessionData == null) {
						throw new DeslogedException("pointsCalculateRetroactiveImapact","userSessionData = null");
					}
				 
					String idsSegRutaDefPoints="0";
					HashMap<Integer, PointsDefinitionData> hashDefinitions=new HashMap<Integer, PointsDefinitionData>();
					for(PointsDefinitionData pd:definitions){
						hashDefinitions.put(pd.getId(), pd);
						if(pd.getType().equals(PointsDefinitionData.SEG_ROUTE) && pd.getAmount()>0){
							idsSegRutaDefPoints+=","+pd.getReference();
						}
					}
					
					
					Calendar cal=Calendar.getInstance();
					cal.add(Calendar.DATE,-backDays);
					Calendar calNow=Calendar.getInstance();
					Calendar calFirstMonthDay=Calendar.getInstance();
					calFirstMonthDay.set(Calendar.DATE, 1);
					
					Session session=HibernateUtil.currentSession();
					//Totos los vehiculos con cuentas abiertas
					Query query=session.createSQLQuery("select distinct v.id from vehicles as v  inner join PointAccount as p on ( CAST(p.reference AS INTEGER)=v.id) "+UtilityQuery.corporationDivisionsRestictionsSQL("v", userSessionData)+" AND v.exclusiondate is null ");
					
		            Iterator iter=query.list().iterator();
		            
		            //Cantidad de horas que se pierden en penalizaciones
		            Integer sumStopedHour=0;
		            //Cantidad total de vehiculos evaluados
		            Integer sumTotalVehicles=0;
		            //Cantidad total suspensiones
		            Integer sumTotalStopedVehicles=0;
		            //Cantidad total de puntos restados
		            Double sumTotalLessPointss=0d;
		            
		            //Se usa para guardar por horas cuantos vehiculos se suspendieron
		            HashMap<Integer, Integer> suspendedXHours=new HashMap<Integer, Integer>();
		            
		            
		            while(iter.hasNext()){
		            	++sumTotalVehicles;
		            	
		            	Integer vehicleid =(Integer)iter.next();
		            	//Busco el estado de la cuenta al inicio
		            	Query queryAccount=session.createSQLQuery("select p.total,m.actualTotal "+
		            			" from PointAccount as p "+
		            			" left outer join pointmoves as m on (m.account=p.id) "+
		            			" Where m.date > "+ Util.formatSQL(cal.getTime())+" and CAST(p.reference AS INTEGER)= "+vehicleid+" "+
		            			" ORDER BY m.date asc "+
		            			" LIMIT 1 ");
		            	Double total=100d;
		            	if(queryAccount.list().iterator().hasNext()){
			            	Object[] row=(Object[])queryAccount.list().iterator().next();
			            	total=(Double)row[0];
			            	Double actualTotal=(Double)row[1];
			            	if(actualTotal!=null){
			            		total=actualTotal;
			            	}
		            		
		            	}
		            	
		            	//Busco todos los eventos de este vehiculo
			            Query queryEvents=session.createSQLQuery("( (select pd.id as pdid, vc.date as date, 'check' as type "+
		            			" from vehiclecheckitemsvalues as vi "+
		            			" inner join  vehiclecheck as vc on (vc.vehiclecheckid=vi.vehiclecheck and  vc.vehicle= "+vehicleid+" )  "+  
		            			" inner join pointsdefinitions as pd on(CAST(pd.reference AS INTEGER)=vi.item and pd.type='SEG_RUTA' and pd.corporationId="+userSessionData.getCorporationId()+" ) "+
		            			" where vi.itemValue='2' and vc.date > "+ Util.formatSQL(cal.getTime())+" and vi.item in("+idsSegRutaDefPoints+") "+
		            			" ORDER BY  vc.date ) "+
		            			" union "+
		            			" (select pd.id as pdid, e.fechahora as date, 'speed' as type "+
		            			" from mobiltrackevents as e "+
		            			" inner join pointsdefinitions as pd on(pd.type='FOSA_SPEED' and pd.corporationId="+userSessionData.getCorporationId()+") "+
		            			" where e.vehicle="+vehicleid+" and  e.fechahora > "+ Util.formatSQL(cal.getTime())+" and velGPS > 90 and  velGPS < 100 "+
		            			" ORDER BY e.fechahora) )"+
		            			" UNION "+
		            			" (select pd.id as pdid, e.fechahora as date, 'speed' as type "+
		            			" from mobiltrackevents as e "+
		            			" inner join pointsdefinitions as pd on(pd.type='FOSA_SPEED_2' and pd.corporationId="+userSessionData.getCorporationId()+") "+
		            			" where e.vehicle="+vehicleid+" and  e.fechahora > "+ Util.formatSQL(cal.getTime())+" and velGPS >=100 and  velGPS < 120  "+
		            			" ORDER BY e.fechahora) "+
		            			" ORDER BY DATE ASC" );
			            Iterator iterEvent=queryEvents.list().iterator();
			            boolean endMonth=false;
			            boolean stateVehicle=true;
			            Calendar calStateEnd=Calendar.getInstance(); 
			            while(iterEvent.hasNext()){
			            	Object[] row=(Object[])iterEvent.next();
			            	Integer pdId=(Integer)row[0];
			            	Date dateEvent=(Date)row[1];
			            	
			            	Double amount =hashDefinitions.containsKey(pdId)?hashDefinitions.get(pdId).getAmount():0;
			            	
			            	if(amount>0){
				            	Calendar calAux=Calendar.getInstance();
				            	calAux.setTime(dateEvent);
				            	//Controlo cierre de mes 
				            	if(! endMonth &&calAux.get(Calendar.MONTH)==calFirstMonthDay.get(Calendar.MONTH) && calAux.get(Calendar.DATE)>=calFirstMonthDay.get(Calendar.DATE)){
				            		total=100d;
				            		endMonth=true;
				            	}

				            	if(!stateVehicle){
				            		if(calStateEnd.compareTo(calAux)<=0){
				            			stateVehicle=true;
				            		}
				            	}
				            	//Salteo los eventos que se producen mientras esta suspendido el vehiculo
				            	if(stateVehicle){
					            	//Resto los puntos
				            		total-=amount;
				            		sumTotalLessPointss-=amount;
				            		
									for(FringeData fringerAux:fringers){
										if(total<fringerAux.getAmount() && total+amount>=fringerAux.getAmount() ){
											//Entra en franja critica 
											calStateEnd.setTime(dateEvent);
											Integer time=Integer.valueOf(fringerAux.getTime());
											calStateEnd.add(Calendar.HOUR, time);
											stateVehicle=false;
											++sumTotalStopedVehicles;
											if(!suspendedXHours.containsKey( time)){
												suspendedXHours.put(time,0);
											}
											sumStopedHour+=time;
											suspendedXHours.put(time,suspendedXHours.get(Integer.valueOf(fringerAux.getTime()))+1);
											break;
										}
									}
				            	}
				            	
			            	}

			            }

		            }
				
		            res.setSumStopedHour(sumStopedHour);
		            res.setSumTotalLessPointss(sumTotalLessPointss);
		            res.setSumTotalStopedVehicles(sumTotalStopedVehicles);
		            res.setSumTotalVehicles(sumTotalVehicles);
		            Integer[][] aux=new Integer[suspendedXHours.keySet().size()][2];
		            Integer index=0;
		            for(Integer hours:suspendedXHours.keySet()){
		            	aux[index][0]=hours;
		            	aux[index][1]=suspendedXHours.get(hours);		
		            	index++;		
		            }
		            res.setSuspendedXHours(aux);
				} catch (Exception e) {
					Object[] parameters = {};
				    handler.getException(e,"pointsCalculateRetroactiveImapact",userSessionData,parameters);
				}
				
				return res;
				 
			}
		
