    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */ 
    public ArrayList<ContractorData> findFOSAContractors(UserSessionData userRequest ) throws Exception {
    	ArrayList<ContractorData> res=new ArrayList<ContractorData>();
        try{    
            Session session = HibernateUtil.currentSession();

            String querySQLStr = " select d.id,d.resourcekey from divorgitemlevel1s as d inner join ContractorData as c on( c.sendresume=1 and c.mail is not null and c.id=d.id) ";
            
            String[] st = userRequest.getFilter().getDivOrgLeaves();
            querySQLStr += " where d.id in ("+st[0]+") ";
            
            querySQLStr+=" and d.divorg=10 and char_length(btrim(d.resourcekey))>0 order by d.resourcekey ";
            
            
            Query query = session.createSQLQuery(querySQLStr);
            
            Iterator<Object[]> iter=query.list().iterator();
            while(iter.hasNext()){
            	Object[] row=iter.next();
            	Integer id=(Integer)row[0];
            	String name=(String)row[1];
            	ContractorData data=new ContractorData();
            	data.setId(id);
            	data.setName(name);
            	res.add(data);
            }
        
	       
           
            
        } catch (Exception e) {
        	e.printStackTrace();
			Object[] parameters = {};
             handler.getException(e,"findFOSAContractors",userRequest,parameters);
             
        }
        
        return res;
            
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */ 
    public ArrayList<ContractorPointData> findContractorsPointData(Date startDate,Date endDate,Integer contractorId,UserSessionData userRequest ) throws Exception {
    	ArrayList<ContractorPointData> res=new ArrayList<ContractorPointData>();
        try{    
            Session session = HibernateUtil.currentSession();

            String querySQLStr = "select v.matricula,pm.actualTotal,pm.amount,pm.description,d.resourcekey,pm.date,pm.time "+
            					 " from PointMoves as pm "+
 								 " inner join PointAccount as pa on (pa.id=pm.account) "+
								 " inner join Vehicles as v on(v.id=CAST(pa.reference as INTEGER) and v.corporation="+userRequest.getCorporationId()+" and v.exclusiondate is null)  "+
								 " inner join divorgitemlevel1s as d on(d.id=v.divorg1) ";
            
           	querySQLStr += UtilityQuery.corporationDivisionsRestictionsSQL("v",userRequest);
           	
            querySQLStr+=(contractorId==0?"":" and v.divOrg1="+contractorId);
            querySQLStr+=" and "+(startDate!=null?" to_date(to_char(pm.date, 'YYYY-MM-DD'), 'YYYY-MM-DD') >=to_date((:start), 'YYYY-MM-DD') ":" 1=1 ");
            querySQLStr+=" and "+(endDate!=null?" to_date(to_char(pm.date, 'YYYY-MM-DD'), 'YYYY-MM-DD') <to_date((:end), 'YYYY-MM-DD') ":" 1=1 ");
            
            Query query = session.createSQLQuery(querySQLStr);
            
            if(startDate!=null){
            	query.setParameter("start", Util.formatHSQL(startDate,0));
	        }
	        if(endDate!=null){
	        	query.setParameter("end", Util.formatHSQL(endDate,1));
	        }
        
	        HashMap<String, HashMap<String, VehiclePointData>> contractorsVehicleMap=new HashMap<String, HashMap<String,VehiclePointData>>();
            
            Iterator iter=query.list().iterator();
            while(iter.hasNext()){
            	Object[] row=(Object[])iter.next();
            	String contractor=(String)row[4];
            	String vehicle=(String)row[0];
            	if(!contractorsVehicleMap.containsKey(contractor)){
            		contractorsVehicleMap.put(contractor,new HashMap<String, VehiclePointData>());
            	}
            	if(!contractorsVehicleMap.get(contractor).containsKey(vehicle)){
            		contractorsVehicleMap.get(contractor).put(vehicle, new VehiclePointData());
            		contractorsVehicleMap.get(contractor).get(vehicle).setPlate(vehicle);
            	}
            	
            	PointMoveData pointMove=new PointMoveData();
            	Date date=(Date) row[5];
            	Time time=(Time) row[6];
            	Calendar cal=Calendar.getInstance();
            	cal.setTime(date);
				cal.set(Calendar.HOUR_OF_DAY,time.getHours());
				cal.set(Calendar.MINUTE,time.getMinutes());
				cal.set(Calendar.SECOND,time.getSeconds());
            	
				pointMove.setDate(cal);
				pointMove.setDescription((String)row[3]);
				pointMove.setActualTotal((Double)row[1]);
				pointMove.setAmount((Double)row[2]);
				contractorsVehicleMap.get(contractor).get(vehicle).getMoves().add(pointMove);
            }

            for(String contractorKey:contractorsVehicleMap.keySet()){
            	ContractorPointData contractorPointData=new ContractorPointData();
            	contractorPointData.setName(contractorKey);
            	HashMap<String, ResumePointData> resumeContractorMap=new HashMap<String, ResumePointData>();
            	for(String vehicleKey:contractorsVehicleMap.get(contractorKey).keySet()){
            		VehiclePointData vehiclePointData=contractorsVehicleMap.get(contractorKey).get(vehicleKey);
            		HashMap<String, ResumePointData> resumeMap=new HashMap<String, ResumePointData>();
            		for(PointMoveData move:vehiclePointData.getMoves()){
            			if(!resumeMap.containsKey(move.getDescription())){
            				resumeMap.put(move.getDescription(), new ResumePointData());
            				resumeMap.get(move.getDescription()).setText(move.getDescription());
            			}
            			if(!resumeContractorMap.containsKey(move.getDescription())){
            				resumeContractorMap.put(move.getDescription(), new ResumePointData());
            				resumeContractorMap.get(move.getDescription()).setText(move.getDescription());
            			}
            			
            			resumeMap.get(move.getDescription()).setCount(resumeMap.get(move.getDescription()).getCount()+1);
            			resumeMap.get(move.getDescription()).setPoints(resumeMap.get(move.getDescription()).getPoints()+move.getAmount().intValue());
            			resumeContractorMap.get(move.getDescription()).setCount(resumeContractorMap.get(move.getDescription()).getCount()+1);
            			resumeContractorMap.get(move.getDescription()).setPoints(resumeContractorMap.get(move.getDescription()).getPoints()+move.getAmount().intValue());
            		}
            		
            		vehiclePointData.getResume().addAll(resumeMap.values());
            		Collections.sort(vehiclePointData.getResume(), new Comparator<ResumePointData>() {

						@Override
						public int compare(ResumePointData o1,ResumePointData o2) {
							// TODO Auto-generated method stub
							return o1.getText().compareTo(o2.getText());
						}
					});
            		contractorPointData.getVehicles().add(vehiclePointData);
            		
            		Collections.sort(vehiclePointData.getMoves(), new Comparator<PointMoveData>() {

						@Override
						public int compare(PointMoveData o1,PointMoveData o2) {
							// TODO Auto-generated method stub
							return o1.getDate().compareTo(o2.getDate());
						}
					});
            	}
            	
            	contractorPointData.getResume().addAll(resumeContractorMap.values());
            	Collections.sort(contractorPointData.getResume(), new Comparator<ResumePointData>() {

					@Override
					public int compare(ResumePointData o1,ResumePointData o2) {
						// TODO Auto-generated method stub
						return o1.getText().compareTo(o2.getText());
					}
				});
            	
            	Collections.sort(contractorPointData.getVehicles(), new Comparator<VehiclePointData>() {

					@Override
					public int compare(VehiclePointData o1,VehiclePointData o2) {
						// TODO Auto-generated method stub
						return o1.getPlate().compareTo(o2.getPlate());
					}
				});
            	
            	res.add(contractorPointData);
            }
           
            Collections.sort(res, new Comparator<ContractorPointData>() {

				@Override
				public int compare(ContractorPointData o1,ContractorPointData o2) {
					// TODO Auto-generated method stub
					return o1.getName().compareTo(o2.getName());
				}
			});
            
        } catch (Exception e) {
        	e.printStackTrace();
			Object[] parameters = {};
             handler.getException(e,"findContractorsPointData",userRequest,parameters);
             
        }
        
        return res;
            
    }
    
    /**
     * 
     * @param session
     * @param attribute
     * @param queryStr
     * @param value
     * @param userRequest
     * @param status
     * @return
     * @throws Exception
     */
    public Query getQuery(Session session, int attribute,String queryStr, String value, UserSessionData userRequest, int status) throws Exception {
    	try{ 
            //Check data integrity
    		if (value == null) {
                throw new InvalidDataException("getQuery","value is null");
            }
            if (userRequest == null) {
                throw new DeslogedException("getQuery","session is null");
            }

            switch (attribute) {
                case MATRICULA:
                    queryStr += " and  lower(matricula) like lower(:value)";
                    value+="%";
                    break;
                case PREFIX:
                    queryStr += " and  lower(vehicle.optionalInfo.prefix) like lower(:value)";
                    value+="%";
                    break;
                default:
                    throw new InvalidDataException("getQuery","invalid attribute");
            }
            switch (status) {
               case VehicleData.ACTIVE:
                   queryStr += " and exclusionDate is null";
                   break;
               case VehicleData.EXCLUDED:
                   queryStr += " and exclusionDate is not null";
                   break;
            }
            
            Query query = session.createQuery(queryStr);
            if(value.endsWith("%"))
                query.setParameter("value", "%" + value);
            else
                query.setParameter("value", new Integer(value));

            return query;

    	}catch (Exception e) {
    		Object[] parameters = {session,attribute,queryStr,value,status};
   			handler.getException(e, "getQuery", userRequest, parameters);
    	}
    	return null;
    }
    
    /**
     * @param session
     * @param attribute
     * @param queryStr
     * @param value
     * @param status
     * @param userRequest
     * @return
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws DCException
     */
    public Query getQueryWithOrderBy(Session session, int attribute,String queryStr, String value, int status ,UserSessionData userRequest) throws Exception {
    	try{ 
            //Check data integrity
            if (value == null) {
                throw new InvalidDataException("Class persistence.vehicle.VehicleReport(findVehicleByLike), value name is empty",   "generic.vehicle.vehicledata.valueempty");
            }
            if (userRequest == null) {
                throw new DeslogedException(
                        "Class persistence.vehicle.VehicleReport(findUserByLike), session data is empty","generic.error.deslogued");
            }

            
            switch (attribute) {
                case MATRICULA:
                    queryStr += " and  lower(matricula) like lower(:value)";
                    value+="%";
                    break;
                case PREFIX:
                    queryStr += " and  lower(vehicle.optionalInfo.prefix) like lower(:value)";
                    value+="%";
                    break;
                default:
                    throw new InvalidDataException(
                        "Class persistence.vehicle.VehicleReport(findVehicleByLike), attribute name is mot right",
                        "generic.vehicle.vehicledata.invalidattribute");
            }
            
            switch (status) {
               case VehicleData.ACTIVE:
                   queryStr += " and exclusionDate is null";
                   break;
               case VehicleData.EXCLUDED:
                   queryStr += " and exclusionDate is not null";
                   break;
            }
            String orderBy = " order by vehicle.matricula";
            Query query = session.createQuery(queryStr+orderBy);
            
            //Query query = session.createQuery(queryStr);
        
            if(value.endsWith("%"))
                query.setParameter("value", "%" + value);
            else
                query.setParameter("value", new Integer(value));

            return query;
            
    	}catch (Exception e) {
       		Object[] parameters = {session,attribute,queryStr,value,status};
   			handler.getException(e, "getQueryWithOrderBy", userRequest, parameters);
    	}
    	return null;
    }
    
    /**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,systemaccess"
	 */
	public JJResumeLAData jjResumeLA(Integer year, Integer month, UserSessionData userSessionData) throws Exception{		
		JJResumeLAData data=new JJResumeLAData();
		try {

			if (userSessionData == null) {
				throw new DeslogedException("jjResumeLA","userSessionData = null");
			}
		 
			Session session=HibernateUtil.currentSession();
			Query query=session.createQuery("select ch from JJOGSumTotal as ch where ch.lineLabel='Total LA' and  ch.snapshot.year="+year+" and ch.snapshot.month="+month+" order by ch.order ");
            Iterator iter=query.list().iterator();
            query=session.createQuery("select g from JJGoals as g where g.year="+year+"");
        	JJGoals goal=(JJGoals)query.list().iterator().next();
        	
            if(iter.hasNext()){
            	JJOGSumTotal ch=(JJOGSumTotal) iter.next();
            	
            	data.setTotalAccident( ch.getTotalCrashes());
            	data.setTotalIncident( ch.getTotalIncidents());
            	data.setNumberCrashesWithInjuries(ch.getInjured());
            	data.setTotalMiles(ch.getTotalMiles());
            	data.setTotalVehicles(ch.getAverageVehicles());
            	data.setAvMilesPerVehicle(ch.getAverageMiles());
            	data.setPercentageVehicleInCrashesAP(ch.getAnnualizedProjection());
            	data.setCpmm(ch.getCpmm());
            	data.setIpmm(ch.getIpmm());
            	
            	data.setCpmmGoal(goal.getCpmm());
            	data.setIpmmGoal(goal.getIpmm());
            			
            }
			

		} catch (Exception e) {
			Object[] parameters = {year,month};
		    handler.getException(e,"jjResumeLA",userSessionData,parameters);
		}
		
		return data;
	}
	
