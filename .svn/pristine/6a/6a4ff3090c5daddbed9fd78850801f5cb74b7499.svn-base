<%@page language="java" 
errorPage="../exception.jsp"
	import="java.util.*"
	import="business.*"
	import="business.event.*"
	import="business.administration.user.*"
	import="communication.language.*"
	import="communication.security.*"
	import="communication.administration.user.tables.*"
	import="communication.event.tables.*"
	import="communication.administration.corporation.tables.*"
	import="communication.util.*"
 	import="presentation.translator.web.util.*"
%>

<%@ taglib uri="/WEB-INF/struts-html.tld"
        prefix="html"
%>

<script language="JavaScript" type="text/javascript">
function doSubmit() {
	document.forms[2].submit();
}
function submitPagination(page,all) {
	document.forms[2].all.value = all;
	document.forms[2].pageNum.value = page;
	document.forms[2].submit();
}
function setAction(form,action){
	form.action.value=action;
}
function deleteIFConfirm(form,msg){

	var elements=form.elements;
	var length=elements.length;
	var i;
	var valueCheckboxParamList="";
	var separator="<";
		
	for(i=0;i<length;i++){
		var element=elements[i];
		if(element.type.toLowerCase()=="checkbox"){
			if(element.checked){
				if(valueCheckboxParamList==""){
					valueCheckboxParamList=element.value;
				}else{
					valueCheckboxParamList=element.value+"<"+valueCheckboxParamList;
				}	
			}	
		} 
	}
	form.event.value=valueCheckboxParamList;
	if(valueCheckboxParamList.length>0){
		if(confirm(msg)){
			form.submit();
		}
	}
}
</script>
<html>
<%!
	RequestDispatcher dispatcher; String context;
	Text messages; SystemAccess sys;
	Integer pageNum; boolean all; int pageSize; 
	String value;String type;String status;String country;String folioNumber;
%>
<%
	
	sys=(SystemAccess)session.getAttribute("SystemAccess");
	String check = null;
	if(sys.getUserSessionData().isDriver()) {
	    check = Util.checkPermission(sys,SecurityConstants.DRIVER_VIEW_EVENT_LIST);
	}else {
	    check = Util.checkPermission(sys,SecurityConstants.VIEW_EVENT_LIST);
	}
	if(check!=null) {
		response.sendRedirect(request.getContextPath()+check);
	}else {
		session.setAttribute("url","event/EventList.jsp");

		context=request.getContextPath();
		dispatcher=request.getRequestDispatcher("/util/jsp/message.jsp");
		dispatcher.include(request,response);
	
		messages=sys.getText();
	
		session.setAttribute("target","EventList");

		session.removeAttribute("FineForm");
		session.removeAttribute("EventForm");
		session.removeAttribute("AccidentForm");
		session.removeAttribute("FineSuperviseForm");
		session.removeAttribute("EventSuperviseForm");

		UserReportFacade userReport = sys.getUserReportFacade();
		if(request.getParameter("pageNum")!=null){
			pageNum=new Integer(request.getParameter("pageNum"));
		}else{
			pageNum=new Integer(1);
		}
		value = "";
		if(request.getParameter("value")!=null){
			value = request.getParameter("value");
		}		
		type = "0";
		if(request.getParameter("type")!=null){
		    type = request.getParameter("type");
		}		
		status = "0";
		if(request.getParameter("status")!=null){
			status = request.getParameter("status");
		}		
		country = "0";
		if(request.getParameter("country")!=null){
			country = request.getParameter("country");
		}		
		pageSize = 10;
		if(request.getParameter("pageSize")!=null){
			pageSize = Integer.parseInt(request.getParameter("pageSize"));
		}		
		int first = 0;
		int count = pageSize;
		all=!Util.empty(request.getParameter("all")) && request.getParameter("all").equals("true");
		if(all) {
		    count=-1;
		}else{
		    first=(pageNum.intValue()-1)*pageSize;
		}

		String link = request.getContextPath()+"/event/EventList.jsp";

		folioNumber = "0";
		if(request.getParameter("folioNumber")!=null){
			folioNumber = request.getParameter("folioNumber");
			if (!Util.isNumber(folioNumber)){
				folioNumber = "0";
			}
		}	
		ListResult result = sys.getEventReportFacade().findEventList(value,Integer.parseInt(type),
				first,count,Integer.parseInt(status),Integer.parseInt(country),
				Integer.parseInt(folioNumber),sys.getUserSessionData());
		
		int corporationId = sys.getUserSessionData().getFilter().getCorporationId().intValue();
		
		//Elimino de la session los datos del formulario de eventos porque sigue en la session y cuando entran a crear tiene todos
		//los datos guardados
		session.removeAttribute("NewEventForm");
		session.removeAttribute("EventForm");
%>


	<LINK REL=StyleSheet HREF="../util/css/estilo.css" TYPE="text/css">
	<style type="text/css">
<!--
body {
	margin-left: 0px;
	margin-top: 0px;
	margin-right: 0px;
	margin-bottom: 0px;
}
-->
</style><head>
		<META http-equiv="Cache-Control" content="no-cache">
		<META http-equiv="Pragma" content="no-cache">
		<META http-equiv="Expires" content="-1">		
	</head>

<body bgcolor="#FFFFFF">
	<table width="800" border="0" align="center" cellpadding="0" cellspacing="0">
		<tr class="guide1">
			<jsp:include  page='<%="../component/titlecomponent.jsp?title="+messages.getText("generic.data.event.pl")%>' />
  		</tr>
      	<tr>
			<jsp:include  page="../component/spaceline.jsp" />
      	</tr>
      	<tr>
        	<td width="50%">
				<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("generic.messages.search")%>' />
				<table width="100%" border="0" cellpadding="0" cellspacing="0">
					<tr>
						<td width="100%">
							<form action="layout.jsp?refer=/event/EventList.jsp" method="post">
								<table class="texts" width="100%" height="100%" border="0" cellpadding="0" cellspacing="0">
									<tr>
<% 						if(sys.getUserSessionData().isDriver()) {
%>										<td>
											<input type="hidden" name="pageNum" value='<%=String.valueOf(pageNum)%>'/>    
	 										<input type="hidden" name="all" <%=(all) ? "value='all'" : "" %>/>    
											<input type="hidden" name="value" value='<%=sys.getUserSessionData().getDriverData().getLastName()%>'>    
										</td>
<% 						}else{
%>										<td>
											<input type="hidden" name="pageNum" value='<%=String.valueOf(pageNum)%>'/>    
	 										<input type="hidden" name="all" <%=(all) ? "value='all'" : "" %>/>    	
											<span class="texts"><%=messages.getText("generic.event.eventdata.firstorlastname")%></span>
										</td>
										<td>
											<input type="text" name="value" value='<%=value%>'  width="30" class="input">    
										</td>
<%						} 
%>	
										
										
									</tr>  
	      							<tr  class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
									<tr>
										<td>
											<span class="texts"><%=messages.getText("generic.event.eventdata.type")%></span>
										</td>
										<td>
											<select name="type" class="input" width="100%">
												<option value="0" class="input">
													<%=messages.getText("generic.messages.all.pl")%>
												</option>
												<option value='<%=String.valueOf(EventDataType.ACCIDENT)%>' <%=(type.equals(String.valueOf(EventDataType.ACCIDENT)))? "selected" : "" %> class="input">
													<%=messages.getText("generic.event.accident")%>
												</option>
												<option value='<%=String.valueOf(EventDataType.INCIDENT)%>' <%=(type.equals(String.valueOf(EventDataType.INCIDENT)))? "selected" : "" %> class="input">
													<%=messages.getText("generic.event.incident")%>
												</option>
<%						if(sys.isCorporation(new int[]{CorporationData.MONSANTO,CorporationData.WEYERHAEUSER})) {
%>												<option value='<%=String.valueOf(EventDataType.NEARMISS)%>' <%=(type.equals(String.valueOf(EventDataType.NEARMISS)))? "selected" : "" %> class="input">
													<%=messages.getText("generic.event.nearmiss")%>
												</option>
<%						}
%>												<option value='<%=String.valueOf(EventDataType.FINE)%>' <%=(type.equals(String.valueOf(EventDataType.FINE)))? "selected" : "" %> class="input">
													<%=messages.getText("generic.event.fine")%>
												</option>
											</select>
										</td>
									</tr>  
	      							<tr  class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
