											<select name="status" class="input" >
												<option value="0" class="input">
													<%=messages.getText("generic.messages.all.pl")%>
												</option>
												<option value='<%=String.valueOf(EventMainAttributes.PENDING_SUPERVISION)%>' <%=(status.equals(String.valueOf(EventMainAttributes.PENDING_SUPERVISION)))? "selected" : "" %> class="input">
													<%=messages.getText("generic.event.eventdata.pendingsupervision")%>
												</option>
												<option value='<%=String.valueOf(EventMainAttributes.SUPERVISED)%>' <%=(status.equals(String.valueOf(EventMainAttributes.SUPERVISED)))? "selected" : "" %> class="input">
													<%=messages.getText("generic.event.eventdata.supervised")%>
												</option>
<%						if(corporationId != CorporationData.PEPSICO) {
%>												<option value='<%=String.valueOf(EventMainAttributes.PENDING_RECOMENDATION)%>' <%=(status.equals(String.valueOf(EventMainAttributes.PENDING_RECOMENDATION)))? "selected" : "" %> class="input">
													<%=messages.getText("generic.event.eventdata.pendingrecomendation")%>
												</option>
<%						}
%>											</select>
										</td>
									</tr>  
	      							<tr  class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
									<tr>
										<td>
											<span class="texts"><%=messages.getText("corporation.country")%></span>
										</td>
										<td>
											<select name="country" class="input" >
												<option value="0" class="input">
													<%=messages.getText("generic.messages.all.pl")%>
												</option>
<%		Iterator countryIt = sys.getUserSessionData().getFilter().getCountries();
		while(countryIt.hasNext()) {
		    GeoItemAttribute countryAttr = (GeoItemAttribute)countryIt.next();
		    String selected = (countryAttr.getId().intValue() == Integer.parseInt(country)) ? "selected" : "";
%>												<option value='<%=String.valueOf(countryAttr.getId())%>' class="input" <%=selected%> >
													<%=messages.getText(countryAttr.getName())%>
												</option>
<%		}
%>												
											</select>
										</td>
									</tr>
									
									  
	      							<tr  class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
<%		if (corporationId == CorporationData.CIMSA){ %>
	      							<tr>
										<td>
											<span class="texts"><%=messages.getText("generic.events.folioNumber")%></span>
										</td>
										<td>
											<input type="text" name="folioNumber" value='<%=folioNumber%>' width="30" class="input">
										</td>
									</tr>
									<tr  class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
<% 		} %>
									<tr>  
										<td colspan="2" align="right">
	   										<input type="hidden" name="pageSize" value='<%=pageSize%>'/>    
											<input name="button" type="button" onClick="javascript:doSubmit();" value='<%=messages.getText("generic.messages.search")%>' class="input"/>	
										</td>	
									</tr>  
								</table>	
							</form>			
						</td>
					</tr>
				</table>			
   				<jsp:include page="../component/utilityboxbottom.jsp"/>	
			</td>
        	<td width="16">&nbsp;</td>
        	<td width="50%" valign="top">
				<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("generic.messages.options")%>' />
				<table width="100%" height="100%" border="0" cellpadding="0" cellspacing="0" class="texts">
<%		if(sys.getUserSessionData().isDriver()) {
			if(sys.getUserSessionData().checkPermission(SecurityConstants.DRIVER_CREATE_EVENT)) {	
%>					<tr>
   						<td>
   							<img align="middle" border="0" src="/datacenter/util/imgs/icon1.jpg" width="12">&nbsp;
   							<span class="texts">
   								<a class="texts" href="layout.jsp?refer=/event/SelectVehicle.jsp?form=new">
   									<%=messages.getText("generic.messages.addevent")%>
   								</a>
   							</span>
   						</td>
   					</tr>
 <%			}	
		}else {
			if(sys.getUserSessionData().checkPermission(SecurityConstants.CREATE_EVENT)) {
				if(sys.isCorporation(new int[]{CorporationData.BAYER_MX,CorporationData.WEYERHAEUSER})) {
%>					<tr>
						<td>
							<img align="middle" border="0" src="/datacenter/util/imgs/icon1.jpg" width="12">&nbsp;
							<span class="texts">
								<a class="texts" href="layout.jsp?refer=/driver/DriverSearch.jsp?link=layout.jsp?refer=/event/SelectVehicle.jsp&title=generic.event.selectdriver&form=old">
									<%=messages.getText("generic.messages.addevent")%>						
								</a>
							</span>
						</td>
					</tr>
					
<%				} else if(sys.isCorporation(new int[]{CorporationData.SYNGENTA_BR})){
%>										<tr>
											<td>
												<img align="middle" border="0" src="/datacenter/util/imgs/icon1.jpg" width="12">&nbsp;
												<span class="texts">
													<a class="texts" href="layout.jsp?refer=/driver/DriverSearch.jsp?link=layout.jsp?refer=/event/SelectVehicle.jsp&title=generic.event.selectdriver&form=new">
														<%=messages.getText("generic.messages.addevent")%>						
													</a>
												</span>
											</td>
										</tr>
<%				}else {
%>	
					<tr>
						<td>
							<img align="middle" border="0" src="/datacenter/util/imgs/icon1.jpg" width="12">&nbsp;
							<span class="texts">
								<a class="texts" href="layout.jsp?refer=/driver/DriverSearch.jsp?link=layout.jsp?refer=/event/SelectVehicle.jsp&title=generic.event.selectdriver&form=new">
									<%=messages.getText("generic.messages.addevent")+" "+messages.getText("generic.messages.addevent.post2016")%>						
								</a>
							</span>
						</td>
					</tr>	
					<tr><td>&nbsp;</td></tr>
					<tr>
						<td>
							<img align="middle" border="0" src="/datacenter/util/imgs/icon1.jpg" width="12">&nbsp;
							<span class="texts">
								<a class="texts" href="layout.jsp?refer=/driver/DriverSearch.jsp?link=layout.jsp?refer=/event/SelectVehicle.jsp&title=generic.event.selectdriver&form=old">
									<%=messages.getText("generic.messages.addevent")+" "+messages.getText("generic.messages.addevent.ant2016")%>						
								</a>
							</span>
						</td>
					</tr>
<%				}
			}	
%>					<tr><td>&nbsp;</td></tr>
<%			if(sys.getUserSessionData().checkPermission(SecurityConstants.CREATE_FINE)) {	
%>					<tr>
						<td>
							<img align="middle" border="0" src="/datacenter/util/imgs/icon1.jpg" width="12">&nbsp;
							<span class="texts">
								<a class="texts" href="layout.jsp?refer=/driver/DriverSearch.jsp?link=layout.jsp?refer=/event/selectVehicleFine.jsp&title=generic.event.selectdriver">
									<%=messages.getText("generic.messages.addfine")%>					
								</a>
							</span>
						</td>
					</tr>	
					<tr><td>&nbsp;</td></tr>
					<tr>
						<td>
							<img align="middle" border="0" src="/datacenter/util/imgs/icon1.jpg" width="12">&nbsp;
							<span class="texts">
								<a class="texts" href="layout.jsp?refer=/vehicle/VehicleSearch.jsp?link=layout.jsp?refer=/vehicle/fineVehicleDrivers.jsp&title=generic.event.selectvehicle">
									<%=messages.getText("generic.messages.addfinevehicle")%>					
								</a>
							</span>
						</td>
					</tr>	
<%			}	
		}	
%>				</table>
				<jsp:include page="../component/utilityboxbottom.jsp"/>	
			</td>
      	</tr>
      	<tr>
			<jsp:include  page="../component/spaceline.jsp" />
