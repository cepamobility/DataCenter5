      	<tr>
        	<td colspan="3">
				<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("web.event.eventlist")%>' />
				<table width='100%' border="0" align='center' cellpadding="0" cellspacing="0">
      				<tr>
        				<td width="100%">
<%		int total = result.getTotal();
		String lastColumn = "corporation.country";
		boolean contractor = false;
		if(sys.getUserSessionData().getFilter().getCorporationId().intValue() == CorporationData.FORESTALORIENTAL) {
		    contractor = true;
		    lastColumn = "corporation.tile.contractors";	
		}
		if(sys.getUserSessionData().getFilter().getCorporationId().intValue() == CorporationData.KLABIN) {
		    contractor = true;
		    lastColumn = "corporation.klabin.unit";	
		}
%>		    				<html:form action="/Eventdelete"  >
		    					<table width="100%" border="0" name="drivers">
              						<tr align="center">
<%		if(sys.getUserSessionData().checkPermission(SecurityConstants.DELETE_DRIVER)) {	
%>	              						<td width='5%' class="guide2"></td>
<%		}																
%>							            <td width='15%' class="guide2"><%=messages.getText("generic.event.eventdata.date")%></td>
							            <td width='35%'	class="guide2"><%=messages.getText("generic.event.eventdata.driver")%></td>
							            <td width='15%'	class="guide2"><%=messages.getText("generic.event.eventdata.type")%></td>
							            <td width='15%'	class="guide2"><%=messages.getText("generic.event.eventdata.status")%></td>
							            <td width='15%'	class="guide2"><%=messages.getText(lastColumn)%></td>
              						</tr>
<%		if(total == 0) {
%>
              						<tr align="left">
	              						<td colspan="5">
											<%=messages.getText("generic.messages.notresult")%>
										</td>
									</tr>
<%		}else {
			Collection elements = result.getElements();
			Collections.sort((List)elements);
			Iterator iter = elements.iterator();
			int counter = 0;
			boolean linetwo = true;
			while(iter.hasNext() && (counter < pageSize || all)){
				counter++;
				EventListData event=(EventListData)iter.next();
%>									<tr align=center align="right" class='<%=(linetwo) ? "linetwo" : "lineone" %>'>                
<%				if(sys.getUserSessionData().checkPermission(SecurityConstants.DELETE_EVENT)) {
%>	            						<td width='5%' align="center"><input type='checkbox' name='<%=String.valueOf(event.getId())%>' value='<%=String.valueOf(event.getId())%>' ></td>
<%				}
				if(sys.getUserSessionData().checkPermission(SecurityConstants.EDIT_EVENT) || (sys.getUserSessionData().isDriver() && sys.getUserSessionData().checkPermission(SecurityConstants.DRIVER_EVENT_EDIT))) {
%>					                	<td width='15%' align="right">
<%					String eventLink = (event.getType() == EventDataType.FINE) ? "layout.jsp?refer=/event/FineView.jsp?fine="+String.valueOf(event.getId()) : "layout.jsp?refer=/event/EventView.jsp?eventId="+String.valueOf(event.getId());
%>											<a href='<%=eventLink%>'>
												<%=Util.formatDate(event.getDate())%> 
											</a>
										</td>
<%				}else{
%>						            	<td width='15%' align="right"><%=Util.formatDate(event.getDate())%></td>
<%				}
%>		          						<td width='35%' align="right">
		            						 <%=event.getDriverName()+" "+event.getDriverLastName()%> 
	              						</td>
<%				String eventType = "generic.event.accident";
				switch(event.getType()) {
					case EventDataType.INCIDENT:
					    eventType = "generic.event.incident";
					    break;
					case EventDataType.NEARMISS:
					    eventType = "generic.event.nearmiss";
					    break;
					case EventDataType.FINE:
					    eventType = "generic.event.fine";
					    break;
				}					    
%>					                	<td width='15%' align="right"><%=messages.getText(eventType)%> </td>
<%				String statusValue = "";
				switch(event.getStatus().intValue()) {
					case EventMainAttributes.PENDING_SUPERVISION:
					    statusValue = "generic.event.eventdata.pendingsupervision";
					    break;
					case EventMainAttributes.SUPERVISED:
					    statusValue = "generic.event.eventdata.supervised";
					    break;
					case EventMainAttributes.PENDING_RECOMENDATION:
					    statusValue = "generic.event.eventdata.pendingrecomendation";
					    break;
				}
%>					                	<td width='15%' align="right"><%=messages.getText(statusValue)%> </td>
					                	<td width='15%' align="right"><%=(contractor) ? event.getDivOrg() : messages.getText(event.getCountry())%> </td>
		                			</tr>
<%	
			linetwo = !linetwo;
		}
		}					
%>								</table>
        	      				<html:hidden property="event" />
            				</html:form>
            			</td>
            		</tr>
   					<tr>
       					<td class="linetwo" align="right">
<%		if(total > 0 && sys.getUserSessionData().checkPermission(SecurityConstants.DELETE_EVENT)) {	%>
   							<input name="button2" type="button" onClick="javascript:setAction(document.forms[3],'delete');deleteIFConfirm(document.forms[3],'<%=messages.getText("generic.event.confirmdelete")%>');" value='<%=messages.getText("generic.messages.delete")%>' class="input"/>
<%		}															
%>	            		</td>
              		</tr>
<%		if(total > 0) {	
			Hashtable paginationParameters = new Hashtable();
			paginationParameters.put("value",value);
			paginationParameters.put("type",type);
			paginationParameters.put("status",status);
			paginationParameters.put("advanced","false");
			session.setAttribute("paginationParameters",paginationParameters);
%>     				<tr>
        				<td>
        					<jsp:include page='<%="../util/pagination2.jsp?size="+pageSize+"&num="+String.valueOf(pageNum)+"&total="+String.valueOf(total)+"&link="+link%>' />        
        				</td>
      				</tr>
<%		}
%>          	</table>		
   				<jsp:include page="../component/utilityboxbottom.jsp"/>	
			</td>
      	</tr>
      	<tr>
			<jsp:include  page="../component/spaceline.jsp" />
      	</tr>
    </table>
</body>
<%	}
%>	
</html>
