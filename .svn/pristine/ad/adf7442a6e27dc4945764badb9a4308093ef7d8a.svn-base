package persistence.activity.tables;

import java.io.Serializable;

public class MediaActivity implements Serializable {

    private static final long serialVersionUID = 1L;

	private Integer id;

	private String activity;                		        
	private Integer corporation;                		        		                
	private Integer country;                		        		                

	private String key;
    
	private Integer activities;
	private Integer items;
	private Integer total;
	private Integer errors;
	private Integer media;
	
	public MediaActivity() {
	}

	public Integer getId() {
		return id;
	}
	public void setId(Integer id) {
		this.id = id;
	}
	public String getActivity() {
		return activity;
	}
	public void setActivity(String activity) {
		this.activity = activity;
	}
	public Integer getCorporation() {
		return corporation;
	}
	public void setCorporation(Integer corporation) {
		this.corporation = corporation;
	}
	public Integer getCountry() {
		return country;
	}
	public void setCountry(Integer country) {
		this.country = country;
	}
	public String getKey() {
		return key;
	}
	public void setKey(String key) {
		this.key = key;
	}
	public Integer getActivities() {
		return activities;
	}
	public void setActivities(Integer activities) {
		this.activities = activities;
	}
	public Integer getItems() {
		return items;
	}
	public void setItems(Integer items) {
		this.items = items;
	}
	public Integer getTotal() {
		return total;
	}
	public void setTotal(Integer total) {
		this.total = total;
	}
	public Integer getErrors() {
		return errors;
	}
	public void setErrors(Integer errors) {
		this.errors = errors;
	}
	public Integer getMedia() {
		return media;
	}
	public void setMedia(Integer media) {
		this.media = media;
	}

}
