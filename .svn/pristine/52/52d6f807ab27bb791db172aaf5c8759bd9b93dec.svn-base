package communication.alert;

import java.util.Date;

public class PersonData {
	
	private Integer idDriver; // Si no es driver null.
	private Integer idCorporation; // id de la corporacion de la persona, por ejemplo MONSANTO = 1
	private String firstName;
	private String lastName;
	private String email;
	private String login;
	private String link;
	
	private String language;	
	private Date licenseExpiry;
	
	private String supervisorEmail;
	private String supervisorName;
	
	
	/**
	 * @return the language
	 */
	public String getLanguage() {
		return language;
	}

	/**
	 * @param language the language to set
	 */
	public void setLanguage(String language) {
		this.language = language;
	}

	/**
	 * @return the licenseExpiry
	 */
	public Date getLicenseExpiry() {
		return licenseExpiry;
	}

	/**
	 * @param licenseExpiry the licenseExpiry to set
	 */
	public void setLicenseExpiry(Date licenseExpiry) {
		this.licenseExpiry = licenseExpiry;
	}

	public PersonData() {
		super();		
	}
	
	/* 
	 * @param firstName
	 * @param lastName
	 * @param email
	 */
	public PersonData(String firstName, String lastName, String email) {
		super();
		this.firstName = firstName;
		this.lastName = lastName;
		this.email = email;
		this.login = null;
		this.link = null;
	}
	 
	/**
	 * 
	 * @param firstName
	 * @param lastName
	 * @param email
	 * @param login
	 */
	public PersonData(String firstName, String lastName, String email, String login) {
		super();
		this.firstName = firstName;
		this.lastName = lastName;
		this.email = email;
		this.login = login;
	}
	/**
	 * @return the firstName
	 */
	public String getFirstName() {
		return firstName;
	}
	/**
	 * @param firstName the firstName to set
	 */
	public void setFirstName(String firstName) {
		this.firstName = firstName;
	}
	/**
	 * @return the lastName
	 */
	public String getLastName() {
		return lastName;
	}
	/**
	 * @param lastName the lastName to set
	 */
	public void setLastName(String lastName) {
		this.lastName = lastName;
	}
	/**
	 * @return the email
	 */
	public String getEmail() {
		return email;
	}
	/**
	 * @param email the email to set
	 */
	public void setEmail(String email) {
		this.email = email;
	}

	/**
	 * @return the login
	 */
	public String getLogin() {
		return login;
	}

	/**
	 * @param login the login to set
	 */
	public void setLogin(String login) {
		this.login = login;
	}

	/**
	 * @return the supervisorEmail
	 */
	public String getSupervisorEmail() {
		return supervisorEmail;
	}

	/**
	 * @param supervisorEmail the supervisorEmail to set
	 */
	public void setSupervisorEmail(String supervisorEmail) {
		this.supervisorEmail = supervisorEmail;
	}

	/**
	 * @return the supervisorName
	 */
	public String getSupervisorName() {
		return supervisorName;
	}

	/**
	 * @param supervisorName the supervisorName to set
	 */
	public void setSupervisorName(String supervisorName) {
		this.supervisorName = supervisorName;
	}

	/**
	 * @return the idDriver
	 */
	public Integer getIdDriver() {
		return idDriver;
	}

	/**
	 * @param idDriver the idDriver to set
	 */
	public void setIdDriver(Integer idDriver) {
		this.idDriver = idDriver;
	}

	/**
	 * @return the idCorporation
	 */
	public Integer getIdCorporation() {
		return idCorporation;
	}

	/**
	 * @param idCorporation the idCorporation to set
	 */
	public void setIdCorporation(Integer idCorporation) {
		this.idCorporation = idCorporation;
	}

	/**
	 * @return the link
	 */
	public String getLink() {
		return link;
	}

	/**
	 * @param link the link to set
	 */
	public void setLink(String link) {
		this.link = link;
	}

	

}
