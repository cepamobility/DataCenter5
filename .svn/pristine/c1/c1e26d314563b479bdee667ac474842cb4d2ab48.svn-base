package communication.external.instructors;

import java.util.ArrayList;

import org.codehaus.jackson.annotate.JsonIgnoreProperties;

@JsonIgnoreProperties(ignoreUnknown = true)
public class QualificationsRestData {
	
	private Integer checklistId;
	
	private Integer driverId;
	
	private ArrayList<ItemQualifResData> itemsQualif;

	public Integer getChecklistId() {
		return checklistId;
	}

	public void setChecklistId(Integer checklistId) {
		this.checklistId = checklistId;
	}

	public Integer getDriverId() {
		return driverId;
	}

	public void setDriverId(Integer driverId) {
		this.driverId = driverId;
	}

	public ArrayList<ItemQualifResData> getItemsQualif() {
		return itemsQualif;
	}

	public void setItemsQualif(ArrayList<ItemQualifResData> itemsQualif) {
		this.itemsQualif = itemsQualif;
	}
	
	

}
