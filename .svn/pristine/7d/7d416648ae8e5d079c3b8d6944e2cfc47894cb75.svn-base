<%@page import="org.apache.struts.action.DynaActionForm"%>
<%@page language="java" 
	errorPage="../exception.jsp"
	import="java.util.*"
	import="business.*"
	import="business.driver.*"
	import="business.administration.user.*"
	import="communication.language.*"
	import="communication.security.*"
	import="communication.administration.user.tables.*"
	import="communication.driver.tables.*"
	import="communication.administration.corporation.tables.*"
	import="communication.driver.tables.*"
	import="communication.util.*"
 	import="presentation.translator.web.util.*"
 	import="presentation.translator.web.driver.*"
%>

<%@ taglib uri="/WEB-INF/struts-html.tld"
        prefix="html"
%>

<script language="JavaScript" type="text/javascript">
function submitPagination(page,all) {
	document.forms[0].all.value = all;
	document.forms[0].pageNum.value = page;
	document.forms[0].submit();
}
</script>
<html:html>
<%!
	RequestDispatcher dispatcher; 
	String pathLanguage; Text messages; SystemAccess sys;
	Integer pageNum; boolean all; int pageSize; 
	String checkboxParamList;String action;
%>
<%
	
	sys=(SystemAccess)session.getAttribute("SystemAccess");
	String check = Util.checkPermission(sys,SecurityConstants.VIEW_DRIVER_LIST);
	if(check!=null) {
		response.sendRedirect(request.getContextPath()+check);
	}else {

		dispatcher=request.getRequestDispatcher("/util/jsp/message.jsp");
		dispatcher.include(request,response);
	
		dispatcher=request.getRequestDispatcher("/util/jsp/language.jsp");
		dispatcher.include(request,response);

		messages=sys.getText();
	
		String origin = request.getParameter("temp");
		String destiny = request.getParameter("id");
		List list = sys.getDriverReportFacade().getDrivers(origin+","+destiny, sys.getUserSessionData());
		if(list.size() > 0) {
			Iterator iter = list.iterator(); 
			DriverMainAttributes temporal = null;
			DriverMainAttributes original = null;
			while(iter.hasNext()){
				DriverMainAttributes driver=(DriverMainAttributes)iter.next();
				if(driver.getId().intValue() == Integer.parseInt(request.getParameter("temp"))) {
					temporal = driver;
				}else {
					original = driver;
				}
			}
%>


	<head>
		<META http-equiv="Cache-Control" content="no-cache">
		<META http-equiv="Pragma" content="no-cache">
		<META http-equiv="Expires" content="-1">		
		<LINK REL=StyleSheet HREF="../util/css/estilo.css" TYPE="text/css">
	</head>
	
	<body bgcolor="#FFFFFF">
		<html:form action="/UnificateDriver">
			<html:hidden property="origin" value="<%=origin%>"/>
			<html:hidden property="destiny" value="<%=destiny%>"/>
			<table width="600" border="0" align="center" cellpadding="0" cellspacing="0">
				<tr class="guide1">
					<jsp:include  page='<%="../component/titlecomponent.jsp?title="+messages.getText("driver.unificatedrivers")%>' />
	  			</tr>
    	  		<tr>
					<jsp:include  page="../component/spaceline.jsp" />
	      		</tr>
        		<tr>
    	    		<td colspan="3">
						<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("driver.unificatedrivers.involved")%>' />
						<table width='100%' border="0" align='center' cellpadding="0" cellspacing="0">
      						<tr>
        						<td width="100%">
									<jsp:include  page='<%="../component/utilitybox2top.jsp?title="+messages.getText("driver.unificatedrivers.origin")%>' />
			    					<table width="100%" border="0" cellpadding="0" cellspacing="0">
		         						<tr class='lineone'>               
	    	      							<td align="right">
	    	      								<a href="layout.jsp?refer=/driver/DriverView.jsp?id=<%=temporal.getId().toString()%>">
		        	          						<%=temporal.getFirstName()+" "+temporal.getLastName()%>
		        	          					</a>
	            	  						</td>
	               						</tr>
		         						<tr align=center align="left" class='lineone'>               
	    	      							<td align="left">
	        	          						<%=messages.getText("driver.unificate.delete")%>:
	        	          						<html:select property="deleteOrigin">
	        	          							<html:option value="1"><%=messages.getText("generic.messges.yes")%></html:option>
	        	          							<html:option value="2"><%=messages.getText("generic.messges.no")%></html:option>
	        	          						</html:select>
	            	  						</td>
	               						</tr>
			   						</table>
									<jsp:include  page='../component/utilitybox2bottom.jsp' />
	          					</td>
		      				</tr>
			    	  		<tr>
								<jsp:include  page="../component/spaceline.jsp" />
				      		</tr>
      						<tr>
        						<td width="100%">
									<jsp:include  page='<%="../component/utilitybox2top.jsp?title="+messages.getText("driver.unificatedrivers.destiny")%>' />
			    					<table width="100%" border="0" cellpadding="0" cellspacing="0">
		         						<tr class='lineone'>               
	    	      							<td align="right">
	    	      								<a href="layout.jsp?refer=/driver/DriverView.jsp?id=<%=temporal.getId().toString()%>">
		        	          						<%=original.getFirstName()+" "+original.getLastName()%>
		        	          					</a>
	            	  						</td>
	               						</tr>
		         						<tr align=center align="left" class='lineone'>               
	    	      							<td align="left">&nbsp;</td>
	               						</tr>
			   						</table>
									<jsp:include  page='../component/utilitybox2bottom.jsp' />
	          					</td>
		      				</tr>
						</table>
   						<jsp:include page="../component/utilityboxbottom.jsp"/>	
					</td>
	      		</tr>
    	  		<tr>
					<jsp:include  page="../component/spaceline.jsp" />
	      		</tr>
				<tr>
					<td width="100%" colspan="3">
						<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("generic.driver.comment")+"*"%>' />
						<table width="100%" cellpadding="0" cellspacing="0">
							<tr>
								<td>
									<html:textarea property="comment" cols="70" />
								</td>
							</tr>
						</table>
						<jsp:include  page="../component/utilityboxbottom.jsp" />
					</td>
				</tr>
				<tr>
					<jsp:include  page="../component/spaceline.jsp" />
 				</tr>
				<tr  class="linetwo">
					<td colspan="2">&nbsp;</td>
					<td align="right">
						<html:submit styleClass="input"><%=messages.getText("driver.unificate.accept")%></html:submit>
		 				<html:cancel styleClass="input"><%=messages.getText("generic.messages.cancel")%></html:cancel >
					</td>
				</tr>
	    	</table>
		</html:form>
	</body>
<%		}else {
%>		<jsp:include  page='<%="/util/allowedData.jsp?message=driver.error.access.driver" %>'/>
<%		}
	}	
%>
</html:html>
