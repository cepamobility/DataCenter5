package presentation.translator.web.dpa;

import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.util.Calendar;
import java.util.Collection;
import java.util.HashMap;
import java.util.Iterator;
import java.util.LinkedList;
import java.util.StringTokenizer;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

import net.sf.jasperreports.engine.JRExporterParameter;
import net.sf.jasperreports.engine.JasperCompileManager;
import net.sf.jasperreports.engine.JasperFillManager;
import net.sf.jasperreports.engine.JasperPrint;
import net.sf.jasperreports.engine.JasperReport;
import net.sf.jasperreports.engine.export.JRPdfExporter;
import net.sf.jasperreports.engine.util.JRLoader;

import org.apache.struts.action.ActionForm;
import org.apache.struts.action.ActionForward;
import org.apache.struts.action.ActionMapping;
import org.apache.struts.action.DynaActionForm;

import presentation.translator.web.util.AbstractAction;
import presentation.translator.web.util.Util;
import business.SystemAccess;

import communication.activity.tables.CheckListData;
import communication.activity.tables.ItemData;
import communication.activity.tables.PointData;
import communication.administration.corporation.tables.CorporationData;
import communication.administration.dpa.UnconformityDPAData;
import communication.administration.dpa.UnconformityReportDPADataSource;
import communication.administration.user.tables.UserData;
import communication.alert.AlertConstants;
import communication.language.Text;
import communication.security.SecurityConstants;
import communication.util.MailSender;
import communication.vehicle.tables.VehicleCheckData;

/**
 * @author fcarriquiry
 */
public class DPASendUnconformityReportAction extends AbstractAction {

	
	public ActionForward action(ActionMapping mapping, ActionForm form, HttpServletRequest request, HttpServletResponse response) throws Throwable {

        HttpSession session = request.getSession();
        SystemAccess sys = ((SystemAccess)session.getAttribute("SystemAccess"));
        Text messages = sys.getText();
        
         DynaActionForm controlData = (DynaActionForm)form;
         
        String tmpDirectory=AlertConstants.TEMP_DIRECTORY_DPA;
 		String fileName = controlData.getString("unconformityFileName");
 		String unconformityId = controlData.getString("unconformityId");
 		String file = tmpDirectory+"out/"+fileName;
 		
 		UnconformityDPAData unconformityData=sys.getCorporationReportFacade().findUnconformityDPAById(sys.getUserSessionData(), Integer.valueOf(unconformityId));
 		
 		StringTokenizer tokenizer = new StringTokenizer(controlData.getString("address"),",");
		Collection addressTo = new LinkedList();
		while(tokenizer.hasMoreTokens()) {
			String address = tokenizer.nextToken().trim();
			if(!Util.checkEmail(address)) {
		    	session.setAttribute("Msg", messages.getText("generic.sendemail.wrongaddress")+": "+address);
		    	sys.getUserSessionData().setUrl("/dpa/DPASendUnconformityReport.jsp?id="+unconformityId);
				return mapping.findForward("success");
			}else {
				addressTo.add(address);
			}
		}

		
		Collection<String> files = new LinkedList();
		Collection<String> names = new LinkedList();
		String fileName2 = controlData.getString("unconformityFileName");
 		String file2 = tmpDirectory+"out/"+fileName2;
 		
 		UnconformityDPAData unconformity = sys.getCorporationReportFacade().findUnconformityDPAById(sys.getUserSessionData(), Integer.valueOf(unconformityId));
 		
 		VehicleCheckData data = sys.getVehicleReportFacade().findVehicleCheck(unconformity.getCheck(), sys.getUserSessionData());
 		
 		
 		if(sys.isCorporation(CorporationData.DPA)){
 			  
	 		
	
	        HashMap<String,Object> parameters2 = new HashMap<String,Object>();
	        parameters2.put("header", tmpDirectory+"images/header.jpg");
	        parameters2.put("footer", tmpDirectory+"images/footer.jpg");
	        parameters2.put("logo_cepa", tmpDirectory+"images/logo_cepa.png");
	        parameters2.put("title", messages.getText("generic.dpa.unconformity.title"));
	        parameters2.put("date", Util.formatDate(Calendar.getInstance().getTime()));
	        parameters2.put("back1", tmpDirectory+"images/back1.jpg");
	        parameters2.put("tabla1",tmpDirectory+"images/tabla1.jpg");
	        parameters2.put("tabla2",tmpDirectory+"images/tabla3.jpg");
	        parameters2.put("tabla3",tmpDirectory+"images/tabla2.jpg");
	        parameters2.put("tabla4",tmpDirectory+"images/tabla4.jpg");
	        parameters2.put("unconformitydata", "DATA "+messages.getText("generic.dpa.unconformity.title").toUpperCase()+": "+Util.formatDate(unconformity.getDate()));
	        parameters2.put("unconformitytype", messages.getText("generic.dpa.unconformity.type")+": "+messages.getText(unconformity.getType().getResourceBundleId()));
	        parameters2.put("actions", messages.getText("generic.dpa.correctiveactions.title"));
	        parameters2.put("picturestitle", messages.getText("generic.dpa.unconformity.files"));
	        parameters2.put("itemstitle", messages.getText("generic.dpa.itemssolved"));
	        parameters2.put("obstext", messages.getText("generic.dpa.uncnformity.comment"));
	        parameters2.put("obsvalue", unconformity.getComment());
	        parameters2.put("divorglevel1",messages.getText("generic.dpa.divorglevel1")+":"+unconformity.getRelatedInformation("divOrgLevel1"));
	        parameters2.put("divorglevel2",messages.getText("generic.dpa.divorglevel2")+":"+unconformity.getRelatedInformation("divOrgLevel2"));
	        parameters2.put("divorglevel3",messages.getText("generic.dpa.divorglevel3")+":"+unconformity.getRelatedInformation("divOrgLevel3"));
	        parameters2.put("SUBREPORT_DIR", tmpDirectory+"jasper/");
	        
	        
	        String report=""; 
	        if(unconformity.getDriverId()!=null){
	        	parameters2.put("reference", unconformity.getRelatedInformation("fullName"));
	        	report="Driver";
	        }else if(unconformity.getCheck()!=null){
        		report="CheckList";
	        	parameters2.put("header1", tmpDirectory+"images/check_header1.jpg");
	        	parameters2.put("header2", tmpDirectory+"images/check_header2.jpg");
	        	parameters2.put("header3", tmpDirectory+"images/check_header3.jpg");
	        	parameters2.put("header4", tmpDirectory+"images/check_header4.jpg");
	        	
	        	
	        	
	        	if(sys.isCorporation(CorporationData.DPA)){
		        	
		    		boolean t1 = data.getName().equals("75");
		    		
		    		CheckListData checkList = sys.getVehicleReportFacade().getCheckList(new Integer(data.getName()),sys.getUserSessionData());
		    		parameters2.put("checkdata", "DATA CHECK LIST: "+Util.formatDate(data.getDate()));
			        Iterator<PointData> it = checkList.getSortPoints();
			        String[][] values = null;
			        if(t1) {
			        	report+="T1";
			        	parameters2.put("data", tmpDirectory+"images/datosCheckListT1.jpg");
			        	parameters2.put("table", tmpDirectory+"images/tablaCheckListT1.jpg");
			        	parameters2.put("romeo", "ROMEU");
			        	parameters2.put("juliet", "JULIETA");
			        	values = new String[][]{{"driver","link","transporter"},{"valueRomeo1","valueJuliet1"},{"valueRomeo2","valueJuliet2"}};
			        }else {
			        	report+="T2";
			        	parameters2.put("data", tmpDirectory+"images/datosCheckListT2.jpg");
			        	parameters2.put("table", tmpDirectory+"images/tablaCheckListT2.jpg");
			        	parameters2.put("romeo", "ROMEU");
				        parameters2.put("horse", "CAVALO");
				        parameters2.put("first", messages.getText("generic.dpa.checklist.1carreta"));
				        parameters2.put("second", messages.getText("generic.dpa.checklist.2carreta"));
			        	values = new String[][]{{"driver","link","transporter"},{"valueHorse","valueFirst1","valueSecond1"},{"valueRomeo","valueFirst2","valueSecond2"}};
			        }
			        for(int j = 0; j < values.length; j++) {
				        Iterator<ItemData> items = it.next().getSortItems();
				        for(int i = 0; i < values[j].length; i++) {
					        ItemData item = items.next();
					        String text = (j == 0) ? messages.getText(item.getText()) + ": " + data.getValueFromItem(item) : data.getValueFromItem(item);
					        parameters2.put(values[j][i], text);
				        }
			        }
			        parameters2.put("tanks", messages.getText("generic.dpa.checklist.nrotank"));
			        parameters2.put("plates", "PLACAS");
	        	}else{
	        		//General
	        		parameters2.put("vehiculo", messages.getText("generic.messages.matricula")+" : "+data.getVehicle().getMatricula());
	        	}
	        } 
        
      
            Collection correctiveActions=sys.getCorporationReportFacade().findCorrectiveActionsByUnconformityId(sys.getUserSessionData(), Integer.valueOf(unconformityId));
            
    		UnconformityReportDPADataSource dataSourceUn = new UnconformityReportDPADataSource(correctiveActions,messages);
    		JasperCompileManager.compileReportToFile(tmpDirectory+"jasper/UnconformityItemsSubreport"+(report.equals("Driver")?"2":"")+".jrxml", tmpDirectory+"jasper/UnconformityItemsSubreport.jasper");
    		JasperCompileManager.compileReportToFile(tmpDirectory+"jasper/UnconformityPictureSubreport.jrxml", tmpDirectory+"jasper/UnconformityPictureSubreport.jasper");
            JasperCompileManager.compileReportToFile(tmpDirectory+"jasper/UnconformityReport"+report+".jrxml", tmpDirectory+"jasper/UnconformityReport"+report+".jasper");
            FileInputStream input2 = new FileInputStream(new File(tmpDirectory+"jasper/UnconformityReport"+report+".jasper"));

            JasperReport jasperReport = (JasperReport)JRLoader.loadObject(input2);
            FileOutputStream out2 = new FileOutputStream(new File(file2));
            JasperPrint jasperPrint = JasperFillManager.fillReport(jasperReport, parameters2, dataSourceUn);
           
            JRPdfExporter exporter = new JRPdfExporter();
            exporter.setParameter(JRExporterParameter.JASPER_PRINT, jasperPrint);
            exporter.setParameter(JRExporterParameter.OUTPUT_STREAM, out2);
            exporter.exportReport();       
            out2.flush();
            out2.close();
        }else{
        	CheckListData checkList = sys.getVehicleReportFacade().getCheckList(new Integer(data.getName()),sys.getUserSessionData());
        	file2=sys.getVehicleReportFacade().reportChecklistPDF(fileName2, checkList, data, sys.getUserSessionData(), messages);
        }
                
        files.add(file2);
		names.add(fileName2);
        
    	MailSender sender = new MailSender();
		Collection bcc = new LinkedList();
		if(sys.isCorporation(CorporationData.DPA) && SecurityConstants.isProductionServer()){
			bcc.add("controle.dpa@cepadc.com");
			UserData user=sys.getUserReportFacade().findUserByPrimaryKey(sys.getUserSessionData().getFilter().getLoginName(), sys.getUserSessionData());
			bcc.add(user.getEmail());
		}
		String body = Util.toHTMLString(controlData.getString("body"));

		boolean sended = false;
		int count = 0;
		while(!sended && count < 10) {
			try {
				sender.sendImageMandrill(addressTo,
						"CEPA DataCenter", 
						AlertConstants.EMAIL_SUPPORT, 
						controlData.getString("subject"), body, files,
						names, 
						"", "", bcc,null);
				sended = true;
			}catch (Exception e) {
				e.printStackTrace();
			}
			count++; 
		}

		session.setAttribute("Msg", messages.getText("generic.sendemail.reportsended"));
    	sys.getUserSessionData().setUrl("/dpa/DPAUnconformityView.jsp?id="+unconformityId);
		return mapping.findForward("success");
	}

    public ActionForward cancel(HttpSession session,ActionMapping mapping, ActionForm form) {
        return null;
    }
}
