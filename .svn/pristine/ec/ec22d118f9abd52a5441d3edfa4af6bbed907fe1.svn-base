    <mbean code="org.jboss.mq.server.jmx.Topic" name="jboss.mq.destination:service=Topic,name=DayAlertTopic">
	  <attribute name="JNDIName">topic/DayAlertTopic</attribute>
	  <depends optional-attribute-name="DestinationManager">jboss.mq:service=DestinationManager</depends>
	</mbean>
-->
         
