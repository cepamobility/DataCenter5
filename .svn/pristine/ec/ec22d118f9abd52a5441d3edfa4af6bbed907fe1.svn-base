<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE server PUBLIC 
	"-//JBoss//DTD MBean Service 5.0//EN" 
	"http://www.jboss.org/j2ee/dtd/jboss-service_5_0.dtd">
<server>

<mbean code="org.jboss.varia.scheduler.Scheduler" name=":service=DayScheduler">
	<attribute name="StartAtStartup">true</attribute>
	<attribute name="SchedulableClass">business.alert.scheduledtask.DayAlert</attribute>
	<attribute name="DateFormat">dd/MM/yy HH:mm</attribute>
	
	<!-- Corre cada un dia a las doce y 10 de noche. -->
	<!-- <attribute name="InitialStartDate">09/06/2010 02:01</attribute> -->  
	
	<attribute name="InitialStartDate">NOW</attribute> 
	<!-- <attribute name="SchedulePeriod">43200000</attribute> -->
	<!-- <attribute name="SchedulePeriod">10000</attribute> -->
	<!-- <attribute name="SchedulePeriod">1000 * 60 * 30 </attribute> --><!-- every 30 minutes -->
	<!-- <attribute name="SchedulePeriod">1000</attribute> --><!-- every second -->
	<!-- <attribute name="InitialStartDate">22/10/2007 11:30</attribute> -->	
	<attribute name="SchedulePeriod">43200000</attribute> <!--  Cada 1 dia -->	
	<!-- <attribute name="InitialRepetitions">-1</attribute> -->
	<attribute name="InitialRepetitions">-1</attribute>	
</mbean>



