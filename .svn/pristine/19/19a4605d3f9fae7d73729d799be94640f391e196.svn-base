<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">


<hibernate-mapping package="persistence.driver.tables">
	<class name="DriverPointHistory" table="driverpointhistory">
		
       	<composite-id class="DriverPointHistoryPK" name="pk" >
       		<key-many-to-one name="driver" column="id" class="Driver" />
	        <key-property column="period" name="period" type="java.lang.Integer" />
	        <key-property column="year" name="year" type="java.lang.Integer" />
		</composite-id>
		
	   	<property name="total"	column="total" type="java.lang.Double" not-null="true" />
        <property column="level" name="level" type="java.lang.Integer" not-null="true" />
		
  	</class>
</hibernate-mapping>
