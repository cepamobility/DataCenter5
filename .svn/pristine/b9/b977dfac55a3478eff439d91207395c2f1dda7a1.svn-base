package persistence.cenapra.tables;

import java.io.Serializable;

public class CENAPRACorrectAnswerPK implements Serializable {

     private Integer checkList;
     private Integer item;

     public CENAPRACorrectAnswerPK() {
     }

    public Integer getCheckList() {
        return checkList;
    }

    public Integer getItem() {
        return item;
    }

    public void setCheckList(Integer checkList) {
        this.checkList = checkList;
    }

    public void setItem(Integer item) {
        this.item = item;
    }

}
