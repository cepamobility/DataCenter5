<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">


<hibernate-mapping package="persistence.administration.corporation.tables"  default-cascade="all">
    <class
        name="DivOrgItemLevel1"
        table="divorgitemlevel1s"
    >

        <id
            name="id"
            column="id"
            type="java.lang.Integer"
        >
            <generator class="native">
            </generator>
        </id>

		<many-to-one name="divOrg" column="divorg" not-null="true"/>
        <property column="resourcekey" name="resourceKey" type="java.lang.String" not-null="true" />
        <property name="active" not-null="true" />
		
		<many-to-one 
			name="divOrgItemLevel2"
			class="DivOrgItemLevel2"
			not-null="false"
		/>         
        
    </class>

</hibernate-mapping>
