package communication.administration.corporation.tables;

import java.io.Serializable;

public class ContractorPlateFOSAData extends CorporationAttribute implements Serializable {
	
    private static final long serialVersionUID = 1L;
    private Integer id;
    
    private Integer fosaId;
	private String plate;
	public Integer getId() {
		return id;
	}
	public void setId(Integer id) {
		this.id = id;
	}
	public Integer getFosaId() {
		return fosaId;
	}
	public void setFosaId(Integer fosaId) {
		this.fosaId = fosaId;
	}
	public String getPlate() {
		return plate;
	}
	public void setPlate(String plate) {
		this.plate = plate;
	}
	
	
     

}
