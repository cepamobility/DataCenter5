package persistence.log.fleet;

import java.io.Serializable;
import java.util.Date;

public class FleetIncidentLogPK implements Serializable {

    private Integer fleetIncident;
    private String userId;
    private Date date;

    public FleetIncidentLogPK() {
    }

    /**
     * @param fleetAccident
     * @param user
     * @param date
     */
    public FleetIncidentLogPK(Integer fleetIncident, String user, Date date) {
        super();
        this.fleetIncident = fleetIncident;
        this.userId = user;
        this.date = date;
    }

    public Date getDate() {
        return date;
    }

    public Integer getFleetIncident() {
        return fleetIncident;
    }

    public String getUserId() {
        return userId;
    }

    public void setDate(Date date) {
        this.date = date;
    }

    public void setFleetIncident(Integer fleetIncident) {
        this.fleetIncident = fleetIncident;
    }

    public void setUserId(String user) {
        this.userId = user;
    }
    
    
}
