package business.ws.client.driver;

import java.io.Serializable;
import java.util.Date;


import business.ws.client.common.WSLDivOrgData;

import communication.administration.corporation.tables.CorporationData;
import communication.driver.tables.AptitudTestData;

public class WSLDriverData implements Serializable {

	private static final long serialVersionUID = 1L;
	
	protected Integer id;
	protected String firstName;
	protected String lastName;
	protected String country;
    protected Date birthDate;
	protected String city;
    protected Date exclusionDate;
    protected String licenceExpirity;
    private String sex;
    private String nationality;
    private CorporationData corporation;
    
	private WSLDivOrgData[] divOrgs;
	private String licenseCategory;
	private Date licenseGet;

  	private String officeAddress;
	private String email;
	private String personalAddress;
	private String stateOrRegion; // estado o localidad donde se ubica la ciudad (ubicacion del conductor)
	private String corporationId;
    private String phoneNumber;
    private Date inclusionDate;
    private String hrdConditions;
    private boolean drives;
    private boolean employee;
    private AptitudTestData[] aptitudTest;
    
    private boolean licenseNotExpiry;
	protected boolean temporal;
	private String divOrgItem1;
	private String divOrgItem2;
	private String divOrgItem3;
	private Integer pontos;

	public WSLDriverData(){
		
	}

	public Integer getPontos() {
		return pontos;
	}

	public void setPontos(Integer pontos) {
		this.pontos = pontos;
	}

	public String getDivOrgItem1() {
		return divOrgItem1;
	}

	public void setDivOrgItem1(String divOrgItem1) {
		this.divOrgItem1 = divOrgItem1;
	}

	public String getDivOrgItem2() {
		return divOrgItem2;
	}

	public void setDivOrgItem2(String divOrgItem2) {
		this.divOrgItem2 = divOrgItem2;
	}

	public String getDivOrgItem3() {
		return divOrgItem3;
	}

	public void setDivOrgItem3(String divOrgItem3) {
		this.divOrgItem3 = divOrgItem3;
	}

	public Integer getId() {
		return id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public String getFirstName() {
		return firstName;
	}

	public void setFirstName(String firstName) {
		this.firstName = firstName;
	}

	public String getLastName() {
		return lastName;
	}

	public void setLastName(String lastName) {
		this.lastName = lastName;
	}

	public String getCountry() {
		return country;
	}

	public void setCountry(String country) {
		this.country = country;
	}

	public Date getBirthDate() {
		return birthDate;
	}

	public void setBirthDate(Date birthDate) {
		this.birthDate = birthDate;
	}

	public String getCity() {
		return city;
	}

	public void setCity(String city) {
		this.city = city;
	}

	public Date getExclusionDate() {
		return exclusionDate;
	}

	public void setExclusionDate(Date exclusionDate) {
		this.exclusionDate = exclusionDate;
	}

	public String getLicenceExpirity() {
		return licenceExpirity;
	}

	public void setLicenceExpirity(String licenceExpirity) {
		this.licenceExpirity = licenceExpirity;
	}

	public String getSex() {
		return sex;
	}

	public void setSex(String sex) {
		this.sex = sex;
	}

	public String getNationality() {
		return nationality;
	}

	public void setNationality(String nationality) {
		this.nationality = nationality;
	}

	public CorporationData getCorporation() {
		return corporation;
	}

	public void setCorporation(CorporationData corporation) {
		this.corporation = corporation;
	}

	public WSLDivOrgData[] getDivOrgs() {
		return divOrgs;
	}

	public void setDivOrgs(WSLDivOrgData[] divOrgs) {
		this.divOrgs = divOrgs;
	}

	public String getLicenseCategory() {
		return licenseCategory;
	}

	public void setLicenseCategory(String licenseCategory) {
		this.licenseCategory = licenseCategory;
	}

	public Date getLicenseGet() {
		return licenseGet;
	}

	public void setLicenseGet(Date licenseGet) {
		this.licenseGet = licenseGet;
	}

	public String getOfficeAddress() {
		return officeAddress;
	}

	public void setOfficeAddress(String officeAddress) {
		this.officeAddress = officeAddress;
	}

	public String getEmail() {
		return email;
	}

	public void setEmail(String email) {
		this.email = email;
	}

	public String getPersonalAddress() {
		return personalAddress;
	}

	public void setPersonalAddress(String personalAddress) {
		this.personalAddress = personalAddress;
	}

	public String getStateOrRegion() {
		return stateOrRegion;
	}

	public void setStateOrRegion(String stateOrRegion) {
		this.stateOrRegion = stateOrRegion;
	}

	public String getCorporationId() {
		return corporationId;
	}

	public void setCorporationId(String corporationId) {
		this.corporationId = corporationId;
	}

	public String getPhoneNumber() {
		return phoneNumber;
	}

	public void setPhoneNumber(String phoneNumber) {
		this.phoneNumber = phoneNumber;
	}

	public Date getInclusionDate() {
		return inclusionDate;
	}

	public void setInclusionDate(Date inclusionDate) {
		this.inclusionDate = inclusionDate;
	}

	public String getHrdConditions() {
		return hrdConditions;
	}

	public void setHrdConditions(String hrdConditions) {
		this.hrdConditions = hrdConditions;
	}

	public boolean isDrives() {
		return drives;
	}

	public void setDrives(boolean drives) {
		this.drives = drives;
	}

	public boolean isEmployee() {
		return employee;
	}

	public void setEmployee(boolean employee) {
		this.employee = employee;
	}

	public AptitudTestData[] getAptitudTest() {
		return aptitudTest;
	}

	public void setAptitudTest(AptitudTestData[] aptitudTest) {
		this.aptitudTest = aptitudTest;
	}

	public boolean isLicenseNotExpiry() {
		return licenseNotExpiry;
	}

	public void setLicenseNotExpiry(boolean licenseNotExpiry) {
		this.licenseNotExpiry = licenseNotExpiry;
	}

	public boolean isTemporal() {
		return temporal;
	}

	public void setTemporal(boolean temporal) {
		this.temporal = temporal;
	}
	
	
}
