package persistence.datatype.tables;

import communication.datatype.tables.GeneralDTData;
import communication.datatype.tables.VehicleContractDataType;

public class VehicleContractType  extends GeneralDataType{
	
	public VehicleContractType() {
		super();
	}


	public VehicleContractType(String id) {
		super(id);
	}

	/* (non-Javadoc)
	 * @see persistence.datatype.tables.GeneralDataType#getData()
	 */
	public GeneralDTData getData() {
		return new VehicleContractDataType(resourceBundleId);
	}

}
