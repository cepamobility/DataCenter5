package persistence.activity.tables;


public class OldResult {
	
	private static final long serialVersionUID = 1L;
	
	String ndtexto;
	String nddesccorta;
	String textoinformetexto;
	Integer crcursoid;
	Integer crconductorid;
	String crobservaciones;
	
		
	public Integer getCrconductorid() {
		return crconductorid;
	}
	public void setCrconductorid(Integer crconductorid) {
		this.crconductorid = crconductorid;
	}
	public Integer getCrcursoid() {
		return crcursoid;
	}
	public void setCrcursoid(Integer crcursoid) {
		this.crcursoid = crcursoid;
	}
	public String getNddesccorta() {
		return (nddesccorta != null)?nddesccorta:"";
	}
	public void setNddesccorta(String nddesccorta) {
		this.nddesccorta = nddesccorta;
	}
	public String getNdtexto() {
		return (ndtexto != null)?ndtexto:"";
	}
	public void setNdtexto(String ndtexto) {
		this.ndtexto = ndtexto;
	}
	public String getTextoinformetexto() {
		return (textoinformetexto != null)?textoinformetexto:"";
	}
	public void setTextoinformetexto(String textoinformetexto) {
		this.textoinformetexto = textoinformetexto;
	}
	public String getCrobservaciones() {
		return (crobservaciones != null)?crobservaciones:"";
	}
	public void setCrobservaciones(String crobservaciones) {
		this.crobservaciones = crobservaciones;
	}
	
	

}
