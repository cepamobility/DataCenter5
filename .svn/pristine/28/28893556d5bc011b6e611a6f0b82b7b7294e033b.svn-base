package communication.driver.tables;

import java.io.Serializable;
import java.util.Date;

import communication.administration.user.tables.UserData;


public class TelematicControlSendMailData implements Serializable{

	private Integer id;

	private static final long serialVersionUID = 8235161610226719412L;
	
	private TelematicControlData telematicControl;
	
	private String subject;
	
	private String body;
	
	private String to;
    
    private UserData user;
    
    private Date date;
    
    
    public TelematicControlSendMailData() {
    }

    
    
	public Date getDate() {
		return date;
	}



	public void setDate(Date date) {
		this.date = date;
	}



	public Integer getId() {
		return id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public TelematicControlData getTelematicControlData() {
		return telematicControl;
	}

	public void setTelematicControlData(TelematicControlData telematicControl) {
		this.telematicControl = telematicControl;
	}

	public String getSubject() {
		return subject;
	}

	public void setSubject(String subject) {
		this.subject = subject;
	}

	public String getBody() {
		return body;
	}

	public void setBody(String body) {
		this.body = body;
	}

	public String getTo() {
		return to;
	}

	public void setTo(String to) {
		this.to = to;
	}

	public UserData getUserData() {
		return user;
	}

	public void setUserData(UserData user) {
		this.user = user;
	}

     
	
	
	

}
