<%@page import="communication.administration.user.UserSessionData"%>
<%@page import="org.apache.struts.action.DynaActionForm"%>
<%@page language="java" 
	errorPage="../exception.jsp"
	import="java.util.*"
	import="business.*"
	import="business.driver.*"
	import="business.administration.user.*"
	import="communication.language.*"
	import="communication.security.*"
	import="communication.administration.user.tables.*"
	import="communication.driver.tables.*"
	import="communication.administration.corporation.tables.*"
	import="communication.driver.tables.*"
	import="communication.util.*"
 	import="presentation.translator.web.util.*"
 	import="presentation.translator.web.driver.*"
%>

<%@ taglib uri="/WEB-INF/struts-html.tld"
        prefix="html"
%>

<script language="JavaScript" type="text/javascript">
function submitPagination(page,all) {
	document.forms[0].all.value = all;
	document.forms[0].pageNum.value = page;
	document.forms[0].submit();
}
</script>
<html:html>
<%!
	RequestDispatcher dispatcher; 
	String pathLanguage; Text messages; SystemAccess sys;
	Integer pageNum; boolean all; int pageSize; 
	String checkboxParamList;String action;
%>
<%
	
	sys=(SystemAccess)session.getAttribute("SystemAccess");
	String check = Util.checkPermission(sys,SecurityConstants.VIEW_DRIVER_LIST);
	if(check!=null) {
		response.sendRedirect(request.getContextPath()+check);
	}else {

		dispatcher=request.getRequestDispatcher("/util/jsp/message.jsp");
		dispatcher.include(request,response);
	
		dispatcher=request.getRequestDispatcher("/util/jsp/language.jsp");
		dispatcher.include(request,response);

		messages=sys.getText();
	
		// session.setAttribute("target","DriverExclude");

		if(request.getParameter("checkboxParamList") != null) {
			checkboxParamList = request.getParameter("checkboxParamList");
			action = request.getParameter("action");
		}else {
		    DynaActionForm form = (DynaActionForm)session.getAttribute("DriverDeleteForm");
			checkboxParamList = (String)form.get("checkboxParamList");
			action = (String)form.get("action");
		}
		// session.setAttribute("url","driver/DriverExclusion.jsp?checkboxParamList="+checkboxParamList+"&action="+action);
		
		List list = sys.getDriverReportFacade().getDrivers(checkboxParamList.replaceAll("<",","), sys.getUserSessionData());
		if(list.size() > 0) {
			sys.getUserSessionData().setUrl(null);
			// session.setAttribute("List_drivers",list);
%>


<LINK REL=StyleSheet HREF="../util/css/estilo.css" TYPE="text/css">
<head>
	<META http-equiv="Cache-Control" content="no-cache">
	<META http-equiv="Pragma" content="no-cache">
	<META http-equiv="Expires" content="-1">		
</head>

<body bgcolor="#FFFFFF">
	<html:form action="/Driverdelete">
		<html:hidden property="checkboxParamList" value='<%=checkboxParamList%>'/>
		<html:hidden property="action" value='<%=action%>'/>
		<table width="600" border="0" align="center" cellpadding="0" cellspacing="0">
			<tr class="guide1">
				<jsp:include  page='<%="../component/titlecomponent.jsp?title="+messages.getText("web.driver."+action)%>' />
	  		</tr>
    	  	<tr>
				<jsp:include  page="../component/spaceline.jsp" />
	      	</tr>
<%		if(action.equals("exclude")) {
%>      	<tr  class="linetwo">
				<th align="left"> <%=messages.getText("generic.driver.driverdata.exclusiondate")%></th>
				<td align="left">
			    	<html:text property="exclusionDate" style="width:20;" styleClass="input"/>&nbsp;/&nbsp;
			        <html:text property="exclusionMonth" style="width:20;" styleClass="input"/>&nbsp;/&nbsp;
		    	    <html:text property="exclusionYear" style="width:40;" styleClass="input"/>
			    </td>
       			<td align="left" >
       				<%="( "+messages.getText("generic.supportmaterial.reports.format")+": "+messages.getText("generic.messages.dateformat")+" )"%>
       			</td>
			</tr>
	      	<tr>
				<jsp:include  page="../component/spaceline.jsp" />
      		</tr>
<%		}
%>        	<tr>
    	    	<td colspan="3">
					<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("web.driver.driverlist.systemdrivers")%>' />
					<table width='100%' border="0" align='center' cellpadding="0" cellspacing="0">
      					<tr>
        					<td width="100%">
<%!			Iterator iter; DriverMainAttributes driver; int i;
			String uid; int pageMax; int contIter; int total;
%>		    					<table width="100%" border="0">
              						<tr align="center">
					    	            <td class="guide2"><%=messages.getText("generic.driver.driverdata.firstname")%></td>
              						</tr>
<%			iter=list.iterator();
			contIter=0;
			while(iter.hasNext()){
				contIter++;
				driver=(DriverMainAttributes)iter.next();
%>	         						<tr align=center align="right" class='<%=((contIter % 2)==0) ? "lineone" : "linetwo"%>'>               
    	      							<td align="right">
        	          						<%=driver.getFirstName()+" "+driver.getLastName()%>
            	  						</td>
               						</tr>
<%			}
%>		   						</table>
          					</td>
	      				</tr>
					</table>
   					<jsp:include page="../component/utilityboxbottom.jsp"/>	
				</td>
	      	</tr>
    	  	<tr>
				<jsp:include  page="../component/spaceline.jsp" />
	      	</tr>
			<tr>
				<td width="100%" colspan="3">
					<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("generic.driver.comment")+"*"%>' />
					<table width="100%" cellpadding="0" cellspacing="0">
						<tr>
							<td>
								<html:textarea property="comment" cols="70" />
							</td>
						</tr>
					</table>
					<jsp:include  page="../component/utilityboxbottom.jsp" />
				</td>
			</tr>
			<tr>
				<jsp:include  page="../component/spaceline.jsp" />
 			</tr>
			<tr  class="linetwo">
				<td colspan="2">&nbsp;</td>
				<td align="right">
					<html:submit styleClass="input"><%=messages.getText("web.driver.message."+action)%></html:submit>
		 			<html:cancel styleClass="input"><%=messages.getText("generic.messages.cancel")%></html:cancel >
				</td>
			</tr>
	    </table>
	</html:form>
</body>
<%		}else {
%>		<jsp:include  page='<%="/util/allowedData.jsp?message=driver.error.access.driver" %>'/>
<%		}
	}	
%></html:html>
