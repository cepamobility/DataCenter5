	public static String getTEMPImage(int coprporation){
		switch (coprporation) {
		case CorporationData.DPA:
			return TEMP_DIRECTORY_IMAGE_DPA;
		case CorporationData.SYNGENTA:
			return TEMP_DIRECTORY_IMAGE_SYNGENTA;
		case CorporationData.SYNGENTA_BR:
			return TEMP_DIRECTORY_IMAGE_SYNGENTA;	
		}
		
		return TEMP_DIRECTORY_IMAGE_GENERAL;
	}
	
	public static String getTEMP(int coprporation){
		switch (coprporation) {
			case CorporationData.JJ:
				return TEMP_DIRECTORY_REPORTER_JJ;
			case CorporationData.DPA:
				return TEMP_DIRECTORY_DPA;
			case CorporationData.SYNGENTA:
				return TEMP_DIRECTORY_SYNGENTA;
		}
		
		return TEMP_DIRECTORY_GENERAL;
	}
    	
