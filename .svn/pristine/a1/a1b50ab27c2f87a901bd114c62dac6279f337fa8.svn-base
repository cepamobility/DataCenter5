	public static String getBodyChangeDriver(boolean changeVehicle, boolean exclude, boolean include, DriverData data, Driver driver, int corporation) {
		String corporationStr = "--";
		switch(corporation) {
			case CorporationData.MONSANTO:
				corporationStr = "Monsanto";
				break;
			case CorporationData.BAYER:
				corporationStr = "Bayer "+driver.getDivOrg1().getDivOrgItemLevel2().getDivOrgItemLevel3().getResourceKey();
				break;
		}
		String body = "<p>A mudança ocorreu em um condutor</p>";
		body += "<p>Condutor:" + data.getFirstName() + " " + data.getLastName() +"</p>";
		body += "<p>Corporação:" + corporationStr +"</p>";
		if(corporation == CorporationData.MONSANTO) {
			body += "<p>Observações:" + data.getLicenseObs() +"</p>";
		}
		String link = "https://www.cepadc.com/datacenter/layout.jsp?refer=/driver/DriverView.jsp?id="+data.getId();
		body += "<p>Link: <a href='"+link+"'>"+link+"</a></p>";
		if(changeVehicle) {
			body += "<p>- Veículo autorizado anterior:"+Text.getVehicleAllowed(driver.getVehicleAllowed()) +"</p>";
			body += "<p>- Veículo autorizado novo:"+Text.getVehicleAllowed(data.getVehicleAllowed().getResourceBundleId()) +"</p>";
		}
		if(exclude)
			body += "<p>- O condutor foi desativado</p>";
		if(include)
			body += "<p>- O condutor foi ativado</p>";
		return body;
	}
	 
}
