    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate"
     */
    public void addProvisionalBTW(Integer driver,String result,Date btwDate,UserSessionData userSessionData) throws Exception {
        try{
        	Calendar c = Calendar.getInstance();
        	c.setTime(btwDate);
        	c.set(Calendar.HOUR_OF_DAY, 23);
        	c.set(Calendar.MINUTE, 59);
        	c.add(Calendar.DATE, 15);
        	DriverABMUtil.getHome().create().addProvisionalBTW(driver,c.getTime(),result,btwDate,userSessionData);
        }catch(Exception e) {
			Object[] parameters = {driver,result,btwDate};
			handler.handleException("addProvisionalBTW",e,userSessionData,parameters);
        }
    }
    

