        }
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate"
     */
    public void unificateDrivers(Integer origin, Integer destiny, boolean delete, String comment, UserSessionData userSessionData) throws Exception {
        try{
        	Integer[] driverLink = new Integer[4];
        	driverLink[0] = destiny;
        	DriverABM driverABM = DriverABMUtil.getHome().create();
        	driverABM.unificateDrivers(origin,destiny,delete,comment,userSessionData);
        	boolean updateLinks = false;
        	if(userSessionData.getCorporationId() == CorporationData.FORESTALES) {
        		DriverReport driverReport = DriverReportUtil.getHome().create();
        		Integer[] linksOrigin = driverReport.getDriverLink(origin, userSessionData);
        		Integer[] linksDestiny = driverReport.getDriverLink(destiny, userSessionData);
        		
        		for(int i = 0; i < 3; i++) {
    				driverLink[i+1] = linksDestiny[i];
        			if(linksOrigin[i] != null && linksDestiny[i] != null) {
        	        	driverABM.unificateDrivers(linksOrigin[i],linksDestiny[i],delete,comment,userSessionData);
        			} else if(linksOrigin[i] != null) {
        				driverLink[i+1] = linksOrigin[i];
        				updateLinks = true;
        			}
        		}
        		if(updateLinks) {
        			driverABM.updateDriverLinks(driverLink,userSessionData);
        		}
        		if(delete) {
        			driverABM.deleteDriverLinks(origin,userSessionData);
        		}
        	}
        }catch(Exception e) {
			Object[] parameters = {origin,destiny,delete,comment};
            handler.handleException("unificateDrivers",e,userSessionData,parameters);
        }
    }
    
