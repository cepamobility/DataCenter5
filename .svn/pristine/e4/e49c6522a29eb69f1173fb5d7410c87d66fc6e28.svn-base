    /**
     * @ejb.interface-method
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,drivercreate"
     */
    public Hashtable createDrivers(Hashtable drivers, UserSessionData userSessionData) throws Exception {
        DriverABM driverABM = null;
        try{    
            if(userSessionData == null) {
                throw new DeslogedException("createDrivers","userSessionData = null");
            }
            if(drivers == null) {
                throw new InvalidDataException("createDrivers","drivers = null");
            }

            Enumeration it = drivers.elements();
            CorporationData corp = new CorporationData(userSessionData.getFilter().getCorporationId(),null,null,null,null,null);
            while(it.hasMoreElements()) {
                DriverData data = (DriverData)it.nextElement();
                data.setCorporation(corp);
                String valid = data.validate(userSessionData);
                if (valid != null) {
                    throw new InvalidDataException("createDrivers",valid);
                }
    
                DriverABMHome home = DriverABMUtil.getHome();
                driverABM = home.create();      
                Integer id = driverABM.driverCreate(data, userSessionData,"Inserted by file");
                data.setId(id);
                if(userSessionData.isPointCorporation()) {
                	CorporationABMFacadeUtil.getHome().create().addDriver(data, userSessionData);
                }
            }
        } catch (Exception exception) {
        	Object[] parameters = new Object[1];
        	parameters[0] = drivers;
        		
            handler.handleException("createDrivers",exception, userSessionData, parameters);
        } 
        return drivers;
    }

