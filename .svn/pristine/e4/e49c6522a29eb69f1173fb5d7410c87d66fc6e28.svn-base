    }
  

    public void loadDriverPoints(UserSessionData userSessionData) throws Exception {
    	try {
    		DriverReport driverReport = DriverReportUtil.getHome().create();
    		CorporationABMFacade corporationABM = CorporationABMFacadeUtil.getHome().create();
    		Collection drivers = driverReport.findDriverByCorporationId(null,userSessionData);
    		Iterator it = drivers.iterator();
    		while(it.hasNext()) {
    			DriverData driver = (DriverData) it.next();
    			corporationABM.addDriver(driver, userSessionData);
    		}
    	}catch(Exception e) {
			Object[] parameters = {};
            handler.handleException("loadDriverPoints",e,userSessionData,parameters);
        }
    }
 
