    private ExceptionHandler handler = new ExceptionHandler(DriverABMFacadeBean.class);

	/**
	 * Create method
	 * @ejb.permission role-name = "driverdelete,driverupdate,drivercreate,administrator,drivertests,driverupdateowndata,driverbayerdata,jjreporter"
	 * @ejb.create-method
	 */
	public void ejbCreate() throws javax.ejb.CreateException {

	}
	
	/**
	 * @ejb.interface-method view-type = "remote"
	 * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,drivercreate,drivertests"
	 * @param data
	 * @throws Exception 
	 */
	public void driverCreate(DriverData data,String comment,UserSessionData userSessionData) throws Exception {
		
        DriverABM driverABM = null;
        try{	
            if(userSessionData == null) {
                throw new DeslogedException("Class business.driver.DriverABMFacade(userCreate), session data is empty","generic.error.deslogued");
            }
            if(data == null) {
                throw new InvalidDataException("Class business.driver.DriverABMFacade(userCreate), driver data is empty","generic.driver.driverdata.isempty");
            }
		
            String valid = data.validate(userSessionData);
            if (valid != null) {
                throw new InvalidDataException("Class business.driver.DriverABMFacade(driverCreate), invalid user data",valid);
            }

            DriverABMHome home = DriverABMUtil.getHome();
            driverABM = home.create();		
            Integer id = driverABM.driverCreate(data, userSessionData,comment);
            data.setId(id);
            
            if(userSessionData.isPointCorporation())
            	CorporationABMFacadeUtil.getHome().create().addDriver(data, userSessionData);
            
        } catch (Exception exception) {
        	Object[] parameters = new Object[2];
        	parameters[0] = data;
        	parameters[1] = comment;
            handler.handleException("driverCreate",exception, userSessionData, parameters);
        } 
	}

	/**
	 * @ejb.interface-method view-type = "remote"
	 * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,drivercreate,drivertests"
	 * @param data
	 * @throws Exception 
	 */
	public void driverCreate(DriverData data,String comment,boolean[] corporations,UserSessionData userSessionData) throws Exception {
		
        DriverABM driverABM = null;
        try{	
            if(userSessionData == null) {
                throw new DeslogedException("Class business.driver.DriverABMFacade(userCreate), session data is empty","generic.error.deslogued");
            }
            if(data == null) {
                throw new InvalidDataException("Class business.driver.DriverABMFacade(userCreate), driver data is empty","generic.driver.driverdata.isempty");
            }
		
            String valid = data.validate(userSessionData);
            if (valid != null) {
                throw new InvalidDataException("Class business.driver.DriverABMFacade(driverCreate), invalid user data",valid);
            }

            DriverABMHome home = DriverABMUtil.getHome();
            driverABM = home.create();		
            Integer id = driverABM.driverCreate(data, userSessionData,comment);
            data.setId(id);
            if(userSessionData.isPointCorporation())
            	CorporationABMFacadeUtil.getHome().create().addDriver(data, userSessionData);

           	replicateDrivers(data,comment,corporations,userSessionData);
            
        } catch (Exception exception) {
        	Object[] parameters = new Object[2];
        	parameters[0] = data;
        	parameters[1] = comment;
            handler.handleException("driverCreate",exception, userSessionData, parameters);
        } 
	}

	/**
	 * @ejb.interface-method
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,driverdelete"
	 * @param data
	 * @throws InvalidDataException
	 * @throws CommunicationProblemException
	 * @throws DeslogedException
	 */
	public void driverDelete(DriverData data, String comment,UserSessionData userSessionData)	throws Exception {
		DriverABM driverABM = null;
		try {
		    if (userSessionData == null) {
		        throw new DeslogedException("Class business.driver.DriverABMFacade(driverDelete), session data is empty","generic.error.deslogued");
		    }
		    if (data == null) {
		        throw new InvalidDataException("Class bisiness.driver.DriverABMFacade(driverDelete), driver data is empty","generic.driverdata.isempty");
		    }
		
        	UserABMHome userABMHome = UserABMUtil.getHome();
        	UserABM userABM = userABMHome.create();
        	userABM.deleteUserByDriver(data.getId(), userSessionData);
        	
        	DriverABMHome home = DriverABMUtil.getHome();
		    driverABM = home.create();
		    driverABM.driverDelete(data, userSessionData, comment);

		    DriverReport driverReport = DriverReportUtil.getHome().create();
            if(userSessionData.getCorporationId() == CorporationData.FORESTALES) {
				Integer[] driverLinks = DriverReportUtil.getHome().create().getDriverLink(data.getId(), userSessionData);
				if(driverLinks != null) {
					for(int i = 0; i < driverLinks.length; i++) {
						if(driverLinks[i] != null) {
	    	                DriverData driverData = driverReport.findDriverByPrimaryKey(new Integer(driverLinks[i]),userSessionData);
	    	                driverABM.driverDelete(driverData, userSessionData, comment);
						}
					}
				}

            }

		} catch (Exception exception) {
        	Object[] parameters = new Object[2];
        	parameters[0] = data;
        	parameters[1] = comment;
            handler.handleException("driverDelete",exception, userSessionData, parameters);
        } 
	}

	/**
	 * @ejb.interface-method
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,driverupdate,driverupdateowndata,driverbayerdata"
	 * 
	 * @param data
	 * @throws InvalidDataException
	 * @throws CommunicationProblemException
	 * @throws DeslogedException
	 */
	public void driverUpdate(DriverData data,String comment,UserSessionData userSessionData) throws Exception {
	    MemoryLog.getInstance().log(MemoryLog.START,"driverUpdate",getClass());
        try{	
            if (userSessionData == null) {
                throw new DeslogedException("driverUpdate","session = null");
            }
            if (data == null) {
                throw new InvalidDataException("driverUpdate","data = null");
            }

            String valid = data.validate(userSessionData);
            if (valid != null) {
                throw new InvalidDataException("driverUpdate",valid);
            }
	
            DriverABMHome home = DriverABMUtil.getHome();
            DriverABM driverABM = home.create();
		
			// Nueva funcionalidad para todas las empresas menos FOSA y WEYERHAEUSER
			// Si cambian las divisiones organizacionales del vehículos se cambian las del conductor
			boolean changed = false;
			Integer[] divOrgs = null;
			Collection vehicles = null;
			if(userSessionData.getCorporationId() != CorporationData.WEYERHAEUSER && 
					userSessionData.getCorporationId() != CorporationData.FORESTALORIENTAL &&
					(!userSessionData.hasPermission(SecurityConstants.DRIVER_BAYER_DATA) || userSessionData.isAdministrator())) {
				// Si estoy en BAYER y actualizo "algunos datos" del conductor directamente (no las divorgs)
				// entonces no hago nada con los vehiculos.
				
				vehicles = VehicleReportUtil.getHome().create().findDriversVehicles(userSessionData, data.getId());
				if(vehicles != null && vehicles.size() > 0) {
					DriverReport driverReport = DriverReportUtil.getHome().create();
					divOrgs = data.getDivOrgIds();
					changed = driverReport.hasChangedDivisions(data.getId(),divOrgs,userSessionData);
				}
			}

			driverABM.driverUpdate(data, userSessionData, comment, LogActions.UPDATE);
			
			if(changed && (userSessionData.checkPermission(SecurityConstants.MODIFY_VEHICLE)
					|| userSessionData.checkPermission(SecurityConstants.DRIVER_MODIFY_VEHICLE))) {
				VehicleABM vehicleABM = VehicleABMUtil.getHome().create();
				Iterator it = vehicles.iterator();
				while(it.hasNext()) {
					VehicleData vehicle = (VehicleData)it.next();
					vehicleABM.updateDivisions(vehicle.getId(),divOrgs,userSessionData);
				}
			}

			if(userSessionData.isDriver()) {
                DriverReportHome reportHome = DriverReportUtil.getHome();
                DriverReport driverReport = reportHome.create();
                DriverData driverData = driverReport.findDriverByPrimaryKey(data.getId(),userSessionData);
                userSessionData.setDriver(driverData);                
            }
        } catch (Exception exception) {
        	Object[] parameters = new Object[2];
        	parameters[0] = data;
        	parameters[1] = comment;
            handler.handleException("DrvierABMFacadeBean: driverUpdate",exception, userSessionData, parameters);
        } 
        MemoryLog.getInstance().log(MemoryLog.START,"driverUpdate",getClass());
	}
	
	/**
	 * @ejb.interface-method view-type = "remote"
	 * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,drivercreate,drivertests"
	 * @param data
	 * @throws Exception 
	 */
	public void replicateDrivers(DriverData data,String comment,boolean[] corporations,UserSessionData userSessionData) throws Exception {
		
        CorporationReport corporationReport = null;
        try{	
        	corporationReport = CorporationReportUtil.getHome().create();
        	Integer[] links = corporationReport.getTransporterLink(((ItemData)((DivOrgData)data.getDivOrgsIterator().next()).getDivOrgLevels().getItemIterator().next()).getId(),userSessionData);
        	
            DriverABM driverABM = DriverABMUtil.getHome().create();
            Integer[] driverLinks = new Integer[4];
            driverLinks[0] = data.getId();
            		
            if(links[0] != null && corporations[0]) {
            	data.replaceDivOrg(1,links[0],null,null);
            	data.replaceDivGeo(null,TransporterLink.FOSA_REGION,TransporterLink.FOSA_COUNTRY);
            	data.setCorporation(new CorporationData(CorporationData.FORESTALORIENTAL,"",null,null,null,null));
            	Integer id = driverABM.driverCreate(data, userSessionData,comment);
                if(userSessionData.isPointCorporation()) {
                	data.setId(id);
                	CorporationABMFacadeUtil.getHome().create().addDriver(data, userSessionData);
                }
            	driverLinks[1] = id;
            }
            
            if(links[2] != null && corporations[2]) {
            	data.replaceDivOrg(1,links[2],null,null);
            	data.replaceDivGeo(null,TransporterLink.MDP_REGION,TransporterLink.MDP_COUNTRY);
            	data.setCorporation(new CorporationData(CorporationData.MONTES_DE_PLATA,"",null,null,null,null));
            	Integer id = driverABM.driverCreate(data, userSessionData,comment);
            	data.setId(id);
            	CorporationABMFacadeUtil.getHome().create().addDriver(data, userSessionData);
            	driverLinks[3] = id;
            }

            if(links[1] != null && corporations[1]) {
            	data.replaceDivOrg(1,TransporterLink.WEYERHAEUSER_DESTINY,null,null);
            	data.addDivOrg(TransporterLink.WEYERHAEUSER_PRODUCT_ID,TransporterLink.WEYERHAEUSER_PRODUCT_NAME,TransporterLink.WEYERHAEUSER_PRODUCT,null,null);
            	data.addDivOrg(TransporterLink.WEYERHAEUSER_TRANSPORTER_ID,TransporterLink.WEYERHAEUSER_TRANSPORTER_NAME,links[1],null,null);
            	data.replaceDivGeo(null,TransporterLink.WEYERHAEUSER_REGION,TransporterLink.WEYERHAEUSER_COUNTRY);
            	data.setCorporation(new CorporationData(CorporationData.WEYERHAEUSER,"",null,null,null,null));
            	Integer id = driverABM.driverCreate(data, userSessionData,comment);
                if(userSessionData.isPointCorporation()) {
                	data.setId(id);
                	CorporationABMFacadeUtil.getHome().create().addDriver(data, userSessionData);
                }
            	driverLinks[2] = id;
            }
            
            
            driverABM.saveDriverLinks(driverLinks,userSessionData);
	
        } catch (Exception exception) {
        	Object[] parameters = new Object[2];
        	parameters[0] = data;
        	parameters[1] = comment;
            handler.handleException("driverCreate",exception, userSessionData, parameters);
        } 
	}

	/**
	 * @ejb.interface-method view-type = "remote"
	 * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,drivercreate,drivertests"
	 * @param data
	 * @throws Exception 
	 */
	public void copyDriver(DriverData data,String comment,int corporation,UserSessionData userSessionData) throws Exception {
		
        CorporationReport corporationReport = null;
        try{	
        	corporationReport = CorporationReportUtil.getHome().create();
        	Integer[] links = corporationReport.getTransporterLink(((ItemData)((DivOrgData)data.getDivOrgsIterator().next()).getDivOrgLevels().getItemIterator().next()).getId(),userSessionData);
        	
            DriverABM driverABM = DriverABMUtil.getHome().create();
            Integer[] driverLinks = {data.getId(),null,null,null};
            Integer[] currentLinks = DriverReportUtil.getHome().create().getDriverLink(data.getId(), userSessionData);
            for(int i = 0; i < 3; i++)
            	driverLinks[i+1] = currentLinks[i];
            
            Collection aptitudTests = data.getAptitudTest();
            data.setAptitudTest(new LinkedList());
            Integer id = null;
            Integer divOrg = null;
            switch(corporation) {
            	case CorporationData.FORESTALORIENTAL:
            		divOrg = links[0]; 
            		if(divOrg == null) 
            			divOrg = TransporterLink.FOSA_TRANSPORTER;
                	data.replaceDivOrg(1,divOrg,null,null);
                	data.replaceDivGeo(null,TransporterLink.FOSA_REGION,TransporterLink.FOSA_COUNTRY);
                	data.setCorporation(new CorporationData(CorporationData.FORESTALORIENTAL,"",null,null,null,null));
                	id = driverABM.driverCreate(data, userSessionData,comment);
                    if(userSessionData.isPointCorporation()) {
                    	data.setId(id);
                    	CorporationABMFacadeUtil.getHome().create().addDriver(data, userSessionData);
                    }
                	driverLinks[1] = id;
            		break;
            	case CorporationData.WEYERHAEUSER:
            		divOrg = links[1]; 
            		if(divOrg == null) 
            			divOrg = TransporterLink.WEYERHAEUSER_TRANSPORTER;
                	data.replaceDivOrg(1,TransporterLink.WEYERHAEUSER_DESTINY,null,null);
                	data.addDivOrg(TransporterLink.WEYERHAEUSER_PRODUCT_ID,TransporterLink.WEYERHAEUSER_PRODUCT_NAME,TransporterLink.WEYERHAEUSER_PRODUCT,null,null);
                	data.addDivOrg(TransporterLink.WEYERHAEUSER_TRANSPORTER_ID,TransporterLink.WEYERHAEUSER_TRANSPORTER_NAME,divOrg,null,null);
                	data.replaceDivGeo(null,TransporterLink.WEYERHAEUSER_REGION,TransporterLink.WEYERHAEUSER_COUNTRY);
                	data.setCorporation(new CorporationData(CorporationData.WEYERHAEUSER,"",null,null,null,null));
                	id = driverABM.driverCreate(data, userSessionData,comment);
                    if(userSessionData.isPointCorporation()) {
                    	data.setId(id);
                    	CorporationABMFacadeUtil.getHome().create().addDriver(data, userSessionData);
                    }
                	driverLinks[2] = id;
            		break;
            	case CorporationData.MONTES_DE_PLATA:
            		divOrg = links[2]; 
            		if(divOrg == null) 
            			divOrg = TransporterLink.MDP_TRANSPORTER;
                	data.replaceDivOrg(1,divOrg,null,null);
                	data.replaceDivGeo(null,TransporterLink.MDP_REGION,TransporterLink.MDP_COUNTRY);
                	data.setCorporation(new CorporationData(CorporationData.MONTES_DE_PLATA,"",null,null,null,null));
                	id = driverABM.driverCreate(data, userSessionData,comment);
                	data.setId(id);
                	CorporationABMFacadeUtil.getHome().create().addDriver(data, userSessionData);
                	driverLinks[3] = id;
            		break;
            }
            driverABM.updateDriverLinks(driverLinks,userSessionData);
    
            if(id != null && aptitudTests != null) {
            	Iterator it = aptitudTests.iterator();
            	while(it.hasNext()) {
            		AptitudTestData test = (AptitudTestData) it.next();
            		driverABM.createAptitudTest(id, test, userSessionData);
            	}
            }
	
            ActivityReport activityReport = ActivityReportUtil.getHome().create();
            Collection activities = activityReport.findActivityByDriver(userSessionData, data.getId(), true);
            if(activities != null) {
        		ActivityABM activityABM = ActivityABMUtil.getHome().create();
            	Iterator it = activities.iterator();
            	while(it.hasNext()) {
            		CEPAActivityScheduleRegistryData activityRegistry = (CEPAActivityScheduleRegistryData) it.next();
            		CEPAActivityScheduleData activity = (CEPAActivityScheduleData)activityRegistry.getActivity();
                    Integer[] activityLinks = {activity.getActivityId(),data.getId(),null,null,null};
                    currentLinks = activityReport.getActivityLink(activity.getActivityId(), data.getId(), userSessionData);
                    for(int i = 0; i < 3; i++)
                    	activityLinks[i+2] = currentLinks[i];
            		Integer newActivityId = null;
                    switch(corporation) {
	                	case CorporationData.FORESTALORIENTAL:
	                		activity.replaceDivOrg(1,divOrg,null,null);
	                		activity.replaceDivGeo(null,TransporterLink.FOSA_REGION,TransporterLink.FOSA_COUNTRY);
	                		activity.setCorpooration(new CorporationData(CorporationData.FORESTALORIENTAL,"",null,null,null,null));
	                		newActivityId = activityABM.createCEPAScheduleActivity(activity,comment,userSessionData);
	                    	activityLinks[2] = newActivityId;
	                		break;
	                	case CorporationData.WEYERHAEUSER:
	                		activity.replaceDivOrg(1,TransporterLink.WEYERHAEUSER_DESTINY,null,null);
	                		activity.addDivOrg(TransporterLink.WEYERHAEUSER_PRODUCT_ID,TransporterLink.WEYERHAEUSER_PRODUCT_NAME,TransporterLink.WEYERHAEUSER_PRODUCT,null,null);
	                		activity.addDivOrg(TransporterLink.WEYERHAEUSER_TRANSPORTER_ID,TransporterLink.WEYERHAEUSER_TRANSPORTER_NAME,divOrg,null,null);
	                    	activity.replaceDivGeo(null,TransporterLink.WEYERHAEUSER_REGION,TransporterLink.WEYERHAEUSER_COUNTRY);
	                    	activity.setCorpooration(new CorporationData(CorporationData.WEYERHAEUSER,"",null,null,null,null));
	                		newActivityId = activityABM.createCEPAScheduleActivity(activity,comment,userSessionData);
	                    	activityLinks[3] = newActivityId;
	                		break;
	                	case CorporationData.MONTES_DE_PLATA:
	                		activity.replaceDivOrg(1,divOrg,null,null);
	                		activity.replaceDivGeo(null,TransporterLink.MDP_REGION,TransporterLink.MDP_COUNTRY);
	                		activity.setCorpooration(new CorporationData(CorporationData.MONTES_DE_PLATA,"",null,null,null,null));
	                		newActivityId = activityABM.createCEPAScheduleActivity(activity,comment,userSessionData);
	                    	activityLinks[4] = newActivityId;
	                		break;
	                }
                    activityABM.updateActivityLinks(activityLinks,userSessionData);
        			activityABM.replicateActivityResult(activity.getActivityId(),data.getId(),newActivityId,id,userSessionData);

            	}
            }
        } catch (Exception exception) {
        	Object[] parameters = new Object[2];
        	parameters[0] = data;
        	parameters[1] = comment;
            handler.handleException("driverCreate",exception, userSessionData, parameters);
        } 
	}

	/**
	 * @ejb.interface-method view-type = "remote"
	 * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,drivercreate,drivertests"
	 * @param data
	 * @throws Exception 
	 */
	public void updateForstalDrivers(DriverData data,String comment,UserSessionData userSessionData) throws Exception {
		
        try{	
    	    MemoryLog.getInstance().log(MemoryLog.START,"driverUpdate",getClass());
            if (userSessionData == null) {
                throw new DeslogedException("driverUpdate","session = null");
            }
            if (data == null) {
                throw new InvalidDataException("driverUpdate","data = null");
            }

            String valid = data.validate(userSessionData);
            if (valid != null) {
                throw new InvalidDataException("driverUpdate",valid);
            }
	
            DriverABM driverABM = DriverABMUtil.getHome().create();
   			driverABM.driverUpdate(data, userSessionData, comment, LogActions.UPDATE);

            if(userSessionData.getCorporationId() == CorporationData.FORESTALES) {
	        	Integer[] links = DriverReportUtil.getHome().create().getDriverLink(data.getId(),userSessionData);
	        	CorporationReport corporationReport = CorporationReportUtil.getHome().create();
	        	Integer[] transporterlinks = corporationReport.getTransporterLink(((ItemData)((DivOrgData)data.getDivOrgsIterator().next()).getDivOrgLevels().getItemIterator().next()).getId(),userSessionData);
	        	
	            for(int i = 0; i < links.length; i++) {
		        	if(links[i] != null) {
		            	data.setId(links[i]);
		            	driverABM.driverUpdateForestales(data, transporterlinks[i], userSessionData, comment, LogActions.UPDATE);
		            }
	            }
            }            
        } catch (Exception exception) {
        	Object[] parameters = new Object[2];
        	parameters[0] = data;
        	parameters[1] = comment;
            handler.handleException("updateForstalDrivers",exception, userSessionData, parameters);
        } 
	}

	/**
	 * @ejb.interface-method view-type = "remote"
	 * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,driverupdate"
	 * @param data
	 * @throws Exception 
	 */
	public void changeTemporal(Integer driverId, UserSessionData userSessionData) throws Exception {
        try{	
        	DriverReport driverReport = DriverReportUtil.getHome().create();
        	DriverData driver = driverReport.findDriverByPrimaryKey(driverId, userSessionData);
        	driver.setTemporal(false);
            DriverABM driverABM = DriverABMUtil.getHome().create();
   			driverABM.driverUpdate(driver, userSessionData, "Change Temporal Value", LogActions.CHANGE_TEMPORAL);
            if(userSessionData.getCorporationId() == CorporationData.FORESTALES) {
            	Integer[] dlinks = driverReport.getDriverLink(driver.getId(), userSessionData); 
            	if(dlinks == null || (dlinks[0] == null && dlinks[1] == null && dlinks[2] == null)) {
					boolean[] corporations = {true,true,true};
            		replicateDrivers(driver, "Replicated From Tablet", corporations, userSessionData);
            	} else {
    	        	CorporationReport corporationReport = CorporationReportUtil.getHome().create();
    	        	Integer[] transporterlinks = corporationReport.getTransporterLink(((ItemData)((DivOrgData)driver.getDivOrgsIterator().next()).getDivOrgLevels().getItemIterator().next()).getId(),userSessionData);
    	        	
    	            for(int i = 0; i < dlinks.length; i++) {
    		        	if(dlinks[i] != null) {
    		            	driver.setId(dlinks[i]);
    		            	driverABM.driverUpdateForestales(driver, transporterlinks[i], userSessionData, "Change Temporal Value", LogActions.CHANGE_TEMPORAL);
    		            }
    	            }

            	}
            }
        } catch (Exception exception) {
        	Object[] parameters = {driverId};
            handler.handleException("changeTemporal",exception, userSessionData, parameters);
        } 
	}
	
