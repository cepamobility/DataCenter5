    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate"
     */
    public void deleteTelematicControl(String[] controlIds,UserSessionData userSessionData) throws Exception {
        try{
        	DriverABM driverABM = DriverABMUtil.getHome().create();
        	for(int i = 0; i < controlIds.length; i++) 
        		driverABM.deleteTelematicControl(new Integer(controlIds[i]),userSessionData);
