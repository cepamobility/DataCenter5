    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate,driverupload"
     * Guarda una coleccion de controles telematicos.
     */
    public void addManyTelematicControls(Collection<TelematicControlData> telematicControls,UserSessionData userSessionData) throws Exception {
        try{
        	DriverABM abm = DriverABMUtil.getHome().create();
        	TelematicControlData telematicControlData;
        	if (telematicControls != null && telematicControls.size() > 0){
        		Iterator<TelematicControlData> it = telematicControls.iterator();
        		while (it.hasNext()){
        			telematicControlData = it.next();
        			if (telematicControlData != null && userSessionData != null)
        				abm.addTelematicControl(telematicControlData,userSessionData);
        		}
        	}        	
        }catch(Exception e) {
			Object[] parameters = {telematicControls};
            handler.handleException("addManyTelematicControl",e,userSessionData,parameters);
        }
    }

