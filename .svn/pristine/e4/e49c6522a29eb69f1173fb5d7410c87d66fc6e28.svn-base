        	parameters[0] = driverId;
        	parameters[1] =  test;
            handler.handleException("createAptitudTest",exception, userSessionData, parameters);
        } 
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate,drivertests"
     */
    public void deleteAptitudTest(Integer driverId, Collection tests, UserSessionData userSessionData) throws Exception {
        DriverABM driverABM = null;
        try{    
            if(userSessionData == null) {
                throw new DeslogedException("deleteAptitudTest","userSessionData = null");
            }
            if(driverId == null) {
                throw new InvalidDataException("deleteAptitudTest","driverId = null");
            }
            DriverABMHome home = DriverABMUtil.getHome();
            driverABM = home.create();      
            
            DriverReport driverReport = DriverReportUtil.getHome().create();

            Iterator it = tests.iterator();
            while(it.hasNext()) {
	        	String date = (String)it.next();
	        	driverABM.deleteAptitudTest(driverId,date,userSessionData);

	
            	if(userSessionData.getCorporationId() == CorporationData.FORESTALES) {
		        	Integer[] links = driverReport.getDriverLink(driverId,userSessionData);
	            	for(int i = 0; i < links.length; i++) {
	    	            if(links[i] != null) {
	    	                driverABM.deleteAptitudTest(links[i],date,userSessionData);
	    	            }
	            	}
	            }
            }
        } catch (Exception exception) {
        	Object[] parameters = new Object[2];
        	parameters[0] = driverId;
        	parameters[1] = tests;
            handler.handleException("deleteAptitudTest",exception, userSessionData, parameters);
        } 
    }

