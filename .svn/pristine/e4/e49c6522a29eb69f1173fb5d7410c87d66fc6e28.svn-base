    /**
     * @ejb.interface-method
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,driverupdate"
     */
    public void driverHRD(Integer driverId, String hrd, Date date, String comment, int action, UserSessionData userSessionData) throws Exception {
        try{    
            if (userSessionData == null) {
                throw new DeslogedException("session NULL","generic.error.deslogued");
            }

            DriverData driverData = DriverReportUtil.getHome().create().findDriverByPrimaryKey(driverId,userSessionData);
            if(action == LogActions.MARK_HRD) {
            	driverData.setIdDallas(hrd);
            	driverData.setAuthorizateDate(date);
            	driverData.setAuthorizateWho(userSessionData.getFilter().getLoginName());
            	driverData.setFederativeEntity(comment);
            }else {
            	driverData.setIdDallas(null);
            	driverData.setAuthorizateDate(null);
            	driverData.setAuthorizateWho(userSessionData.getFilter().getLoginName());
            	driverData.setFederativeEntity(comment);
            }
            DriverABMUtil.getHome().create().driverUpdate(driverData, userSessionData, comment, action);
        } catch (Exception exception) {
        	Object[] parameters = {driverId};
            handler.handleException("driverHRD",exception, userSessionData, parameters);
        }
    }

    /**
     * @ejb.interface-method
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,drivercreate"
     */
    public void createDrivers(Collection drivers, UserSessionData userSessionData, String notes) throws Exception {
        DriverABM driverABM = null;
        DriverData data = null;
        String valid = null;
        try{    
        	
            if(userSessionData == null) {
                throw new DeslogedException("createDrivers","userSessionData = null");
            }
            if(drivers == null) {
                throw new InvalidDataException("createDrivers","drivers = null");
            }

            DriverABMHome home = DriverABMUtil.getHome();
            driverABM = home.create();
            
            Iterator it = drivers.iterator();
            CorporationData corp = new CorporationData(userSessionData.getFilter().getCorporationId(),null,null,null,null,null);
            while(it.hasNext()) {
                data = (DriverData)it.next();
                data.setCorporation(corp);
                valid = data.validate(userSessionData);
                if (valid != null) {
                	System.out.println("Invalid Data Exception: "+
                			data.getFirstName()+" "+data.getLastName());
                    throw new InvalidDataException("createDrivers",valid);
                }                  
                Integer id = driverABM.driverCreate(data, userSessionData,"Inserted by file. "+notes);
                if(userSessionData.isPointCorporation()) {
                	data.setId(id);
                	CorporationABMFacadeUtil.getHome().create().addDriver(data, userSessionData);
                }
            }
    
        } catch (Exception exception) {
        	Object[] parameters = new Object[1];
        	parameters[0] = drivers;
            handler.handleException("createDrivers",exception, userSessionData, parameters);
        } 
    }
    
