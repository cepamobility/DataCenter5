		    	                driverData.setExclusionDate(null);
		    	                driverABM.driverUpdate(driverData, userSessionData, comment, LogActions.INCLUDE);
    						}
    					}
    				}

                }
            }
        } catch (Exception exception) {
        	Object[] parameters = new Object[2];
