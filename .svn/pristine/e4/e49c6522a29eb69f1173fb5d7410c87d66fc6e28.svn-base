    /**
     * @ejb.interface-method
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,driverupdate"
     * 
     * @param data
     * @throws InvalidDataException
     * @throws CommunicationProblemException
     * @throws DeslogedException
     */
    public void driverExclude(String drivers,Date exclusionDate, String comment,UserSessionData userSessionData) throws Exception {
        DriverABM driverABM = null; 
        try{    
            if (userSessionData == null) {
                throw new DeslogedException("Class business.driver.DriverABMFacade(driverUpdate), session data is empty","generic.error.deslogued");
            }

            DriverReportHome reportHome = DriverReportUtil.getHome();
            DriverReport driverReport = reportHome.create();

            DriverABMHome home = DriverABMUtil.getHome();
            driverABM = home.create();

            StringTokenizer tokenizer = new StringTokenizer(drivers,",");
            while(tokenizer.hasMoreTokens()) {
                String driverId = tokenizer.nextToken();
                DriverData driverData = driverReport.findDriverByPrimaryKey(new Integer(driverId),userSessionData);
                driverData.setExclusionDate(exclusionDate);
                driverABM.driverUpdate(driverData, userSessionData, comment, LogActions.EXCLUDE);
                
                if(userSessionData.getCorporationId() == CorporationData.FORESTALES) {
    				Integer[] driverLinks = DriverReportUtil.getHome().create().getDriverLink(new Integer(driverId), userSessionData);
    				if(driverLinks != null) {
    					for(int i = 0; i < driverLinks.length; i++) {
    						if(driverLinks[i] != null) {
		    	                driverData = driverReport.findDriverByPrimaryKey(new Integer(driverLinks[i]),userSessionData);
		    	                driverData.setExclusionDate(exclusionDate);
		    	                driverABM.driverUpdate(driverData, userSessionData, comment, LogActions.EXCLUDE);
    						}
    					}
    				}

                }
                
                if(userSessionData.getFilter().getCorporationId().intValue() == CorporationData.MONSANTO && driverData.getCountryName().equals(CountryData.ARGENTINA)) {
                	UserABM userABM = UserABMUtil.getHome().create();
                	userABM.deleteDriverUser(driverData.getId(),userSessionData);
                }
            }
        } catch (Exception exception) {
        	Object[] parameters = new Object[3];
        	parameters[0] = drivers;
        	parameters[1] = exclusionDate;
        	parameters[2] = comment;        	
            handler.handleException("driverExclude",exception, userSessionData, parameters);
        }
    }

