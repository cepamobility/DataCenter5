<html:html>
<%! RequestDispatcher dispatcher; String context;String pathView; 
	String pathMsg; String pathSearch; String id;
	Text messages; String pathLanguage;
	SystemAccess sys; VehicleData data; VehicleReportFacade vehicleReport;
	UserSessionData userSessionData;
	String allerganUnit;
%>
<%
	session.removeAttribute("TruckCheckListForm");
	session.removeAttribute("TruckCheckListEditForm");

	sys = (SystemAccess)session.getAttribute("SystemAccess");

	userSessionData=sys.getUserSessionData();
	
	String check = null;
	if(userSessionData.isDriver()) {
	    check = Util.checkPermission(sys,SecurityConstants.DRIVER_EDIT_VEHICLE);
	}else {
	    check = Util.checkPermission(sys,SecurityConstants.EDIT_VEHICLE);
	}
	if(check!=null) {
		response.sendRedirect(request.getContextPath()+check);
	}else {
		messages=sys.getText();

		int corporationId = sys.getCorporationId();
		
		pathLanguage="/util/jsp/language.jsp";
	
		dispatcher=request.getRequestDispatcher(pathLanguage);
		dispatcher.include(request,response);
	
		context=request.getContextPath();
		pathMsg="/util/jsp/message.jsp";
	
		dispatcher=request.getRequestDispatcher(pathMsg);
		dispatcher.include(request,response);

		id=(String)request.getParameter("id");
		if(id==null){
	id = (String)session.getAttribute("id");			
	session.removeAttribute("id");
		}
		session.setAttribute("url","vehicle/VehicleView.jsp?id="+id);
	
		// Borro el contenido de from para los checklist
		session.setAttribute("from","vehicleview");
		
		// Elimino form de checklist si es que existe
		session.removeAttribute("VehicleCheckForm");	
		
		
		String cancel = "layout.jsp?refer=/vehicle/VehicleList.jsp";
		if(!Util.empty(request.getParameter("trailer"))) {
		    cancel = "layout.jsp?refer=/vehicle/TrailerView.jsp?trailer="+request.getParameter("trailer")+"&vehicle="+id;
		}else{
	cancel = "javascript:history.back();";
		}
		
		if(id!=null){	
	pathView="./view.jsp?id="+id;
	session.setAttribute("target","VehicleView");
		
	vehicleReport=sys.getVehicleReportFacade();
	data=vehicleReport.findVehicleByPrimaryKey(new Integer(id),userSessionData); 

	if(data!=null){
		VehicleForm vehicleForm=VehicleUtil.createVehicleForm(data,VehicleUtil.VIEW,messages);
		session.setAttribute("VehicleCreateForm",vehicleForm); 
		
		if(session.getAttribute("Breadcrumb") != null) {
		    Hashtable parameters = new Hashtable();
		    parameters.put("id",data.getId());
		    parameters.put("name",data.getMatricula());
		    ((Breadcrumb)session.getAttribute("Breadcrumb")).addItem(Breadcrumb.VEHICLE_EDIT,parameters);
		}
		

		//	Datos Opcionales de Vehiculos (Camiones Brasil), en particular para KLABIN
		boolean hasOptionalData = false;
		if (corporationId == CorporationData.KLABIN || 
		corporationId == CorporationData.YOLI ||
		        corporationId == CorporationData.CIMSA ||
		        corporationId == CorporationData.PEPSICO ||
		        corporationId == CorporationData.FORESTALORIENTAL){
	// Cimsa y Pepsico usan la matricula como numero economico
	// y el campo prefijo de optionaInfo como matricula
	
	hasOptionalData = true;
		}
%>

<LINK REL=StyleSheet HREF="../util/css/estilo.css" TYPE="text/css">
<script type="text/javascript" src="./menu/js/html2canvas.min.js"></script>
<head>
	<script>

	function CanvasToBase64Image(canvas)
	{
		var ctx = canvas.getContext("2d");
		var dataURL = canvas.toDataURL("image/png");
		var r = dataURL;//.replace(/^data:image\/(png|jpg);base64,/, "");
		return r;
	}

	$(document).ready(
		function(){
			$("#linkpdfscreen").click(function(event ) {
  			    event.preventDefault();
  			    var sel=$("table#bvehicle");
  			  var count = sel.length;
  			  for(i=0; i<count;i++){
	  			  		html2canvas(sel[i], {
			            onrendered: function(canvas) {
			                //document.body.appendChild(canvas);
			                 fd = new FormData();
							 xhr = new XMLHttpRequest();
							 fd.append('contents', CanvasToBase64Image(canvas));
							 fd.append('id', 0);
							 xhr.open('POST', 'Copy.do',false);
							 xhr.send(fd);
							 document.location.href="ImageToPDF.do";	
				        }
			        });
  			  }
  			  
  			
  		  			  
  			 		
			});
		}
	);

	
	function setAction(form,action){
		form.action.value=action;
	}
	function deleteIFConfirm(form,msg){
		form.submit();
	} 
	function desassociate(formDes,formTrailers,msg){
		var elements=formTrailers.elements;
		var length=elements.length;
		var i;
		var list="";
		
		for(i=0;i<length;i++){
			var element=elements[i];
			if(element.type.toLowerCase()=="checkbox"){
				if(element.checked){
					if(list==""){
						list=element.value;
					}else{
						list=element.value+"<"+list;
					}	
				}	
			} 
		}
		if(list.length>0){
			formDes.list.value=list;
			if(confirm(msg)) {
				formDes.submit();
			}
		} 
	}


	function selectContract(form1,form2){
		form2.vehicle.value = form1.vehicle.value;
		form2.day.value = form1.day.value;
		form2.month.value = form1.month.value;
		form2.year.value = form1.year.value;
		form2.type.value = form1.type.value;
		form2.submit();
		
	}

	function dpaDeleteHistoryCheckList(){

		if(confirm('<%=messages.getText("generic.dpachecklist.confirmdelete")%>')){
			$('input[deleteCheckList="true"]').each(
					function(){
						if($(this).is(':checked')){
							var tthis=this;
							
							//DPASendCheckList
							$.ajax(
								{
									url:'DPASendCheckList.do?deleteCheckList=true&check='+$(this).attr('check'),
									async:true,
									dataType:'json',
									success:function(res){
										if(!res){
											alert('No se puede eliminar, primero elimine las no conformidades asociadas');	
										}else{
											$(tthis).parent().parent().hide('slow',function(){$(this).remove();});				
										}
									}
								}
							);
						}
					}
			);
		}
	}
	
	</script>
</head>
	
