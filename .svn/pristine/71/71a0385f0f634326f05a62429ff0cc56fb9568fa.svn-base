							userSessionData.checkPermission(SecurityConstants.CHECKLIST_VEHICLE))
						) {							
							session.setAttribute("idVehicle",id);			
							String href = "layout.jsp?refer=/vehicle/VehiclePursuitRouteForm.jsp" + "?id=" + id; 
							line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
								<td style="width:50%">  
		                			
			                		<img align="middle" border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
									<a href='<%=href %>' class="texts">
										<%=messages.getText("generic.messages.addpursuitroute")%>
									</a>
								</td>
					<%=(line) ? "</tr>" : "" %>							
<%							if(corporationId == CorporationData.LOSPIQUES) {
								line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
								<td style="width:50%">  
			                		<img align="middle" border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
									<a href='layout.jsp?refer=/vehicle/unconformities.jsp?id=<%=String.valueOf(data.getId())+"&name="+data.getMatricula()%>' class="texts">
										<%=messages.getText("generic.driver.unconformities")%>
									</a>								
								</td>
					<%=(line) ? "</tr>" : "" %>							
<%							}
						}	
					
					if((userSessionData.checkPermission(SecurityConstants.QUERY))) {	
						session.setAttribute("idVehicle",id);			
						String href = "layout.jsp?refer=/vehicle/VehicleDriversForm.jsp" + "?idVehicle=" + id + "&plate=" + data.getMatricula();
						line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
							<td style="width:50%">
		                		<img align="middle" border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
								<a href='<%=href %>' class="texts">
									<%=messages.getText("generic.messages.viewdriverlist")%>
								</a>
							</td>
					<%=(line) ? "</tr>" : "" %>							
<%					}	
					
					
					// Exclusion
					if(data.getExclusionDate() != null) {	
						if((userSessionData.checkPermission(SecurityConstants.MODIFY_VEHICLE))) {	
							line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
							<td style="width:50%">  
								<img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;
								<a href="javascript:setAction(document.forms['exclusion'],'include');deleteIFConfirm(document.forms['exclusion'],'<%=messages.getText("generic.driver.driverdata.confirminclude")%>');" class="texts")>
				         			<%=messages.getText("generic.driver.include")%>
				         		</a>
				         	</td>
					<%=(line) ? "</tr>" : "" %>							
<%						}	
					}else {
						if((userSessionData.checkPermission(SecurityConstants.MODIFY_VEHICLE))) {	
							line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
							<td style="width:50%"> 	
	        					<img align="middle" border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
								<a href="javascript:setAction(document.forms['exclusion'],'exclude');deleteIFConfirm(document.forms['exclusion'],'<%=messages.getText("generic.driver.driverdata.confirmexclude")%>');" class="texts">
				    	     		<%=messages.getText("generic.driver.exclude")%>
				        	 	</a>
				        	</td>
					<%=(line) ? "</tr>" : "" %>							
<%						}
						if(userSessionData.checkPermission(SecurityConstants.DELETE_VEHICLE)) {	
							line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
					       	<td style="width:50%">  						
		        				<img align="middle" border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
								<a href="javascript:setAction(document.forms['exclusion'],'delete');deleteIFConfirm(document.forms['exclusion'],'<%=messages.getText("generic.driver.driverdata.confirmdelete")%>');" class="texts">
									<%=messages.getText("generic.messages.delete")%>
								</a>
							</td>
					<%=(line) ? "</tr>" : "" %>							
<%						}
					}
					if(data.getCountryId().intValue() == CountryData.ARGENTINA_ID.intValue() && corporationId == CorporationData.MONSANTO) {
						String maintenanceLink = "layout.jsp?refer=vehicle/maintenance.jsp?type=Create&id="+String.valueOf(data.getId());
						line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
					       	<td style="width:50%" valign="middle">  						
	        					<img border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
								<a href='<%=maintenanceLink%>' class="texts">
									<%=messages.getText("generic.vehicle.addmaintenance")%>
								</a>
							</td>
					<%=(line) ? "</tr>" : "" %>							
<%					}						
					if(corporationId == CorporationData.ALLERGAN) {
						String maintenanceLink = "layout.jsp?refer=vehicle/contract.jsp?id="+String.valueOf(data.getId());
						line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
					       	<td style="width:50%" valign="middle">  						
	        					<img border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
								<a href='<%=maintenanceLink%>' class="texts">
									<%=messages.getText("generic.vehicle.generatecontract")%>
								</a>
							</td>
					<%=(line) ? "</tr>" : "" %>							
<%					}						
					if(corporationId == CorporationData.PEPSICO) {
						String maintenanceLink = "layout.jsp?refer=vehicle/complaint.jsp?id="+String.valueOf(data.getId());
						line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
					       	<td style="width:50%" valign="middle">  						
	        					<img border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
								<a href='<%=maintenanceLink%>' class="texts">
									<%=messages.getText("generic.vehicle.addcomplaint")%>
								</a>
							</td>
					<%=(line) ? "</tr>" : "" %>							
<%					}						
%>					<%=(line) ? "<tr>" : "" %>							
						<td style="width:50%"> 	
							<img align="middle" border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
							<a href="#" onClick="javascript:document.forms['cancel'].submit()" class="texts">
								<%=messages.getText("generic.messages.cancel")%>
							</a>
						</td>
					</tr>
<%				} 
%>				</table>
				<jsp:include page="../component/utilitybox3bottom.jsp"/>
			</td>
		</tr>
		<!-- Fin Opciones -->
		
		<tr>
			<jsp:include  page="../component/spaceline.jsp" />
   		</tr>
	
</table>
 

<%			}else {
%>	<jsp:include  page='<%="/util/allowedData.jsp?message=vehicle.error.access.vehicle" %>'/>
<%			}
		}else{
			dispatcher=request.getRequestDispatcher("layout.jsp?refer=/vehicle/VehicleList.jsp");
			dispatcher.forward(request,response);
		}	
	}
	
%>

<% if (sys.getCorporationId() == CorporationData.ALLERGAN){ %>
<!-- Form para generar los contratos -->
<html:form action="/VehicleContract" method="post">	
<html:hidden property="vehicle" value="" />
<html:hidden property="day" value="" />
<html:hidden property="month" value="" />
<html:hidden property="year"  value=""/>
<html:hidden property="type"  value=""/>
</html:form>
<% } %>

</html:html>

