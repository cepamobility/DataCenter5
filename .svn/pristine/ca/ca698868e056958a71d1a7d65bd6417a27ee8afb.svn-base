<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.activity.tables" >
    <class name="Item" table="items">
	 	<id column="id" name="id">
            <generator class="sequence"> 
            	<param name="sequence">Item_Sequence</param>
            </generator>
        </id>
        <property	name="text" type="java.lang.String" column="text"/>                		        		
        <property	name="textReport" type="java.lang.String" column="textReport"/>                		        		        

		<property name="itemOrder" type="integer">
		    <column name="itemOrder" default="-1"/>
		</property>
        <property	name="type" type="java.lang.Integer" column="type"/>                		        		

		<property name="idRadio" type="java.lang.Integer" column="idRadio" />
		<property name="disabledItems" type="java.lang.String" column="disabledItems" />

   </class>
</hibernate-mapping>