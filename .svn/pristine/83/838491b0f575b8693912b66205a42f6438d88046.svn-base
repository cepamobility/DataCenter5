<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.datatype.tables">
    <class name="CEPAActivityType" table="datatypecepaactivityscheduletype">

        <id	column="resourceBundleId"	name="resourceBundleId"	type="java.lang.String">
            <generator class="native" />
        </id>
        <property name="oldId" />
    </class>
</hibernate-mapping>
