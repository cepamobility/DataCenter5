/**
 * @author jrodriguez
 */
public class SendCheckListDPAAction extends AbstractAction {

	public ActionForward action(ActionMapping mapping, ActionForm form, HttpServletRequest request, HttpServletResponse response) throws Throwable {

        HttpSession session = request.getSession();
        SystemAccess sys = ((SystemAccess)session.getAttribute("SystemAccess"));
        Text messages = sys.getText();
        
        //Se llama desde VehicleView.jsp
        if(request.getParameter("deleteCheckList")!=null){
        	return deleteCheckListAction(mapping, form, request, response);
        }
        
        DynaActionForm controlData = (DynaActionForm)form;
        
 		String fileName = controlData.getString("fileName");
 		String file = AlertConstants.TEMP_DIRECTORY_DPA+"out/"+fileName;

		StringTokenizer tokenizer = new StringTokenizer(controlData.getString("address"),",");
		Collection addressTo = new LinkedList();
		while(tokenizer.hasMoreTokens()) {
			String address = tokenizer.nextToken().trim();
			if(!Util.checkEmail(address)) {
		    	session.setAttribute("Msg", messages.getText("generic.sendemail.wrongaddress")+": "+address);
		    	sys.getUserSessionData().setUrl("/driver/SendTelematicControl.jsp?control="+controlData.getString("control"));
				return mapping.findForward("success");
			}else {
				addressTo.add(address);
			}
		}

		VehicleCheckData data = sys.getVehicleReportFacade().findVehicleCheck(new Integer(controlData.getString("check")), sys.getUserSessionData());
		boolean t1 = data.getName().equals("75");
		
		CheckListData checkList = sys.getVehicleReportFacade().getCheckList(new Integer(data.getName()),sys.getUserSessionData());
		Boolean resume=controlData.getString("checkListResume")!=null && controlData.getString("checkListResume").equals("1");
		
        HashMap<String,Object> parameters = new HashMap<String,Object>();
        parameters.put("header", AlertConstants.TEMP_DIRECTORY_DPA+"images/header.jpg");
        parameters.put("footer", AlertConstants.TEMP_DIRECTORY_DPA+"images/footer.jpg");
        parameters.put("logo_cepa", AlertConstants.TEMP_DIRECTORY_DPA+"images/logo_cepa.png");
        parameters.put("title", (resume?messages.getText("checklist.sendreport.resume").toUpperCase()+" ":"")+messages.getText("checklist.dpa.title"+data.getName()));
        parameters.put("date", Util.formatDate(Calendar.getInstance().getTime()));
        parameters.put("header1", AlertConstants.TEMP_DIRECTORY_DPA+"images/check_header1.jpg");
        parameters.put("header2", AlertConstants.TEMP_DIRECTORY_DPA+"images/check_header2.jpg");
        parameters.put("header3", AlertConstants.TEMP_DIRECTORY_DPA+"images/check_header3.jpg");
        parameters.put("header4", AlertConstants.TEMP_DIRECTORY_DPA+"images/check_header4.jpg");
        parameters.put("checkdata", "DATA: "+Util.formatDate(data.getDate()));
        Iterator<PointData> it = checkList.getSortPoints();
        String[][] values = null;
        if(t1) {
            parameters.put("data", AlertConstants.TEMP_DIRECTORY_DPA+"images/datosCheckListT1.jpg");
            parameters.put("table", AlertConstants.TEMP_DIRECTORY_DPA+"images/tablaCheckListT1.jpg");
	        parameters.put("romeo", "ROMEU");
	        parameters.put("juliet", "JULIETA");
        	values = new String[][]{{"driver","link","transporter"},{"valueRomeo1","valueJuliet1"},{"valueRomeo2","valueJuliet2"}};
        }else {
            parameters.put("data", AlertConstants.TEMP_DIRECTORY_DPA+"images/datosCheckListT2.jpg");
            parameters.put("table", AlertConstants.TEMP_DIRECTORY_DPA+"images/tablaCheckListT2.jpg");
	        parameters.put("romeo", "ROMEU");
	        parameters.put("horse", "CAVALO");
	        parameters.put("first", messages.getText("generic.dpa.checklist.1carreta"));
	        parameters.put("second", messages.getText("generic.dpa.checklist.2carreta"));
        	values = new String[][]{{"driver","link","transporter"},{"valueHorse","valueFirst1","valueSecond1"},{"valueRomeo","valueFirst2","valueSecond2"}};
        }
        for(int j = 0; j < values.length; j++) {
	        Iterator<ItemData> items = it.next().getSortItems();
	        for(int i = 0; i < values[j].length; i++) {
		        ItemData item = items.next();
		        String text = (j == 0) ? messages.getText(item.getText()) + ": " + data.getValueFromItem(item) : data.getValueFromItem(item);
		        parameters.put(values[j][i], text);
	        }
        }
        parameters.put("aprouved", "A");
        parameters.put("reprouved", "R");
        parameters.put("tanks", messages.getText("generic.dpa.checklist.nrotank"));
        parameters.put("plates", "PLACAS");
        parameters.put("obs", messages.getText("generic.messages.observations"));
        parameters.put("stop", "P");	
        String result = messages.getText("generic.activity.result") +": ";
        result += (data.getResult().intValue() == 1) ? messages.getText("generic.activity.note.approved") : messages.getText("generic.activity.note.notapproved"); 
        parameters.put("pictures", messages.getText("generic.checklist.pictures"));
        parameters.put("finaldata", messages.getText("generic.checklist.finaldata"));
        parameters.put("result", result);
        parameters.put("inspected", messages.getText("generic.checklist.inspector")+": "+data.getInspectedby());
        parameters.put("obsText", messages.getText("generic.messages.observations"));
        parameters.put("obsValue", (data.getObs() == null) ? "--------" : data.getObs());
        String city= (data.getSerie() == null) ? "--------" : data.getSerie();
        parameters.put("city", messages.getText("checklist.dpa.city")+": "+city);

        Collection<CheckListImageData> images = data.getPointImageSet();
        String[] imgSources = new String[images.size()];
        String[] imgTexts = new String[images.size()];
        String[] imgPointTexts = new String[images.size()];
	    if(images.size() > 0) {
	        Iterator<CheckListImageData> imgIt = images.iterator();
	        int index = 0;
	        while(imgIt.hasNext()) {
	        	CheckListImageData imageData = imgIt.next();
	        	imgSources[index] = imageData.getFileName();
	        	PointData point = checkList.getPoint(imageData.getPointId());
	        	if(point.getPointOrder().intValue() == 1) {
	        		imgTexts[index] = "checklistdap.images.panoramic";
	        		imgPointTexts[index]="";
	        	}else {
	        		imgTexts[index] = point.getSortItems().next().getText();
	        		imgPointTexts[index]=data.getValueFromCommentPoint(point.getId());
	        	}
	        	index++;
	        }
	        PictureDPADataSource sub = new PictureDPADataSource(imgSources,imgTexts,imgPointTexts,messages);
	        JasperCompileManager.compileReportToFile(AlertConstants.TEMP_DIRECTORY_DPA+"jasper/PictureSubreport.jrxml", AlertConstants.TEMP_DIRECTORY_DPA+"jasper/PictureSubreport.jasper");
	        FileInputStream input = new FileInputStream(new File(AlertConstants.TEMP_DIRECTORY_DPA+"jasper/PictureSubreport.jasper"));
	        JasperReport subReport = (JasperReport)JRLoader.loadObject(input);
	        parameters.put("sub", sub);
	        parameters.put("subreport", subReport);
        }else {
	        PictureDPADataSource sub = new PictureDPADataSource(imgSources,imgTexts,imgPointTexts,messages);
	        JasperCompileManager.compileReportToFile(AlertConstants.TEMP_DIRECTORY_DPA+"jasper/PictureSubreport2.jrxml", AlertConstants.TEMP_DIRECTORY_DPA+"jasper/PictureSubreport2.jasper");
	        FileInputStream input = new FileInputStream(new File(AlertConstants.TEMP_DIRECTORY_DPA+"jasper/PictureSubreport2.jasper"));
	        JasperReport subReport = (JasperReport)JRLoader.loadObject(input);
	        parameters.put("sub", sub);
	        parameters.put("subreport", subReport);
        }
	    

	    Iterator<PointData> itWar=checkList.getSortPoints();
		boolean war=false;
		while(itWar.hasNext() && !war){
			PointData pointData=itWar.next();
			Iterator<ItemData> itItWar=pointData.getSortItems();
			while(itItWar.hasNext() && !war){
				ItemData itData=itItWar.next();
				String tag=data.getValueTagFromItem(itData.getId());
				war=tag!=null && Integer.valueOf(tag)==1?true:false;
			}
		}
		
		if(war){
			parameters.put("warning", AlertConstants.TEMP_DIRECTORY_DPA+"images/warning.jpg");
			parameters.put("warningB",true);
		}else{
			parameters.put("warningB",false);
		}
		

		boolean checkListReport = controlData.getString("includeCheckList")!=null && controlData.getString("includeCheckList").trim().length()>0 && Integer.parseInt(controlData.getString("includeCheckList")) == 1;
		Collection<String> files = new LinkedList();
		Collection<String> names = new LinkedList();
		if(checkListReport){
	        CheckListDPADataSource dataSource = new CheckListDPADataSource(resume, data, checkList, sys.getText());
	        
	        String type = (t1) ? "T1" : "T2"; 
	        JasperCompileManager.compileReportToFile(AlertConstants.TEMP_DIRECTORY_DPA+"jasper/CheckListDPA"+type+".jrxml", AlertConstants.TEMP_DIRECTORY_DPA+"jasper/CheckListDPA"+type+".jasper");
	        FileInputStream input2 = new FileInputStream(new File(AlertConstants.TEMP_DIRECTORY_DPA+"jasper/CheckListDPA"+type+".jasper"));
	
	        JasperReport jasperReport = (JasperReport)JRLoader.loadObject(input2);
	        FileOutputStream out = new FileOutputStream(new File(file));
	        JasperPrint jasperPrint = JasperFillManager.fillReport(jasperReport, parameters, dataSource);
	        
	        JRPdfExporter exporter = new JRPdfExporter();
	        exporter.setParameter(JRExporterParameter.JASPER_PRINT, jasperPrint);
	        exporter.setParameter(JRExporterParameter.OUTPUT_STREAM, out);
	        exporter.exportReport();       
	        out.flush();
	        out.close();
	
			
			files.add(file);
			names.add(fileName);
		}
		
		boolean unconformityReport = controlData.getString("includeUnconformity")!=null && controlData.getString("includeUnconformity").trim().length()>0 && Integer.parseInt(controlData.getString("includeUnconformity")) == 1;
		if(unconformityReport) {
	 		String fileName2 = controlData.getString("unconformityFileName");
	 		String file2 = AlertConstants.TEMP_DIRECTORY_DPA+"out/"+fileName2;

	 		UnconformityDPAData unconformity = sys.getCorporationReportFacade().findUnconformityDPAByCheckId(sys.getUserSessionData(), data.getVehicleCheckId());
	
	        HashMap<String,Object> parameters2 = new HashMap<String,Object>();
	        parameters2.put("header", AlertConstants.TEMP_DIRECTORY_DPA+"images/header.jpg");
	        parameters2.put("footer", AlertConstants.TEMP_DIRECTORY_DPA+"images/footer.jpg");
	        parameters2.put("logo_cepa", AlertConstants.TEMP_DIRECTORY_DPA+"images/logo_cepa.png");
	        parameters2.put("title", messages.getText("generic.dpa.unconformity.title"));
	        parameters2.put("date", Util.formatDate(Calendar.getInstance().getTime()));
	        parameters2.put("back1", AlertConstants.TEMP_DIRECTORY_DPA+"images/back1.jpg");
	        parameters2.put("tabla1",AlertConstants.TEMP_DIRECTORY_DPA+"images/tabla1.jpg");
	        parameters2.put("tabla2",AlertConstants.TEMP_DIRECTORY_DPA+"images/tabla3.jpg");
	        parameters2.put("tabla3",AlertConstants.TEMP_DIRECTORY_DPA+"images/tabla2.jpg");
	        parameters2.put("tabla4",AlertConstants.TEMP_DIRECTORY_DPA+"images/tabla4.jpg");
	        parameters2.put("checktitle",messages.getText("unconformity.checklist.data"));
	        parameters2.put("checkdatatxt", messages.getText("generic.messages.date"));
	        parameters2.put("checkdata", Util.formatDate(data.getDate()));
	        String[] values2 = new String[]{"driver","link","transporter"};
	        it = checkList.getSortPoints();
	        Iterator<ItemData> items = it.next().getSortItems();
	        for(int i = 0; i < values2.length; i++) {
		        ItemData item = items.next();
		        parameters2.put(values2[i]+"txt", messages.getText(item.getText()));
		        parameters2.put(values2[i], data.getValueFromItem(item));
	        }        
	        parameters2.put("unconformitydata", "DATA: "+Util.formatDate(unconformity.getDate()));
	        parameters2.put("unconformitytype", messages.getText("generic.dpa.unconformity.type")+": "+messages.getText(unconformity.getType().getResourceBundleId()));
	        parameters2.put("items", messages.getText("generic.dpa.unconformity.items"));
	        parameters2.put("obstext", messages.getText("generic.dpa.uncnformity.comment"));
	        parameters2.put("obsvalue", unconformity.getComment());
	
			UnconformityDPADataSource dataSourceUn = new UnconformityDPADataSource(unconformity.getItems(),messages);
	        JasperCompileManager.compileReportToFile(AlertConstants.TEMP_DIRECTORY_DPA+"jasper/Unconformity2.jrxml", AlertConstants.TEMP_DIRECTORY_DPA+"jasper/Unconformity2.jasper");
	        FileInputStream input2 = new FileInputStream(new File(AlertConstants.TEMP_DIRECTORY_DPA+"jasper/Unconformity2.jasper"));
	
	        JasperReport jasperReport = (JasperReport)JRLoader.loadObject(input2);
	        FileOutputStream out2 = new FileOutputStream(new File(file2));
	        JasperPrint jasperPrint = JasperFillManager.fillReport(jasperReport, parameters2, dataSourceUn);
	       
	        JRPdfExporter exporter = new JRPdfExporter();
	        exporter.setParameter(JRExporterParameter.JASPER_PRINT, jasperPrint);
	        exporter.setParameter(JRExporterParameter.OUTPUT_STREAM, out2);
	        exporter.exportReport();       
	        out2.flush();
	        out2.close();
	        
	        
			files.add(file2);
			names.add(fileName2);
        }
        
    	MailSender sender = new MailSender();
		Collection bcc = new LinkedList();
		if(SecurityConstants.isProductionServer()){
			bcc.add("controle.dpa@cepadc.com");
			UserData user=sys.getUserReportFacade().findUserByPrimaryKey(sys.getUserSessionData().getFilter().getLoginName(), sys.getUserSessionData());
			bcc.add(user.getEmail());
		}
		String body = Util.toHTMLString(controlData.getString("body"));

		boolean sended = false;
		int count = 0;
		while(!sended && count < 10) {
			try {
				sender.sendImageMandrill(addressTo,
						"CEPA DataCenter", 
						AlertConstants.EMAIL_SUPPORT, 
						controlData.getString("subject"), body, files,
						names, 
						"", "", bcc,null);
				sended = true;
			}catch (Exception e) {
				e.printStackTrace();
			}
			count++; 
		}

		session.setAttribute("Msg", messages.getText("generic.sendemail.reportsended"));
    	sys.getUserSessionData().setUrl("/vehicle/VehicleCheckViewDPA.jsp?id="+data.getVehicleCheckId()+"&vehicle="+data.getVehicle().getId());
		return mapping.findForward("success");
	}

	//Se llama desde VehicleView.jsp
	public ActionForward deleteCheckListAction(ActionMapping mapping, ActionForm form, HttpServletRequest request, HttpServletResponse response) throws Throwable {
		HttpSession session = request.getSession();
        SystemAccess sys = ((SystemAccess)session.getAttribute("SystemAccess"));
        
        String checkS = null;
    	if(sys.getUserSessionData().isDriver()) {
    	    checkS = Util.checkPermission(sys,SecurityConstants.DRIVER_EDIT_VEHICLE);
    	}else {
    	    checkS = Util.checkPermission(sys,SecurityConstants.EDIT_VEHICLE);
    	}
    	
    	if(checkS!=null){
    		response.getWriter().write("false");
    		return null;
    	}
    	
    	String check=request.getParameter("check");
    	
    	if(sys.getVehicleReportFacade().validateDeleteChecklist(Integer.valueOf(check), sys.getUserSessionData())){
    		sys.getVehicleABMFacade().deleteVehicleCheck(Integer.valueOf(check), "Delete from VehicleView.jsp checklist history", sys.getUserSessionData());
    		response.getWriter().write("true");
    	}else{
    		response.getWriter().write("false");
    	}
        
        
        
		return null;
	}
    public ActionForward cancel(HttpSession session,ActionMapping mapping, ActionForm form) {
        return null;
    }
}
