package communication.driver.report;

import java.util.Date;

public interface FOSADriver {

    public Integer getCount();
    public Date getLast();
    public void setCount(Integer count);
    public void setLast(Date date);
    public Date getLastEC();
    public void setLastEC(Date date);
    public void addCount(Integer count);
	public void setLastExpiry(Date date);
	public Object getLastRadar();
	public void setLastRadar(Date date);
	public void setRadarNote(String string);
	public Object getLastInduction();
	public void setLastInduction(Date date);
	public void addLast(Date date,Object[] data);
}
