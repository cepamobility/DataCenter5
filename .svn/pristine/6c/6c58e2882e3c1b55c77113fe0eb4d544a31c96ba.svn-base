	/**
	 * Constructor
	 * @param id
	 * @param typeId
	 * @param year
	 * @param colour
	 * @param permissionNumber
	 * @param useId
	 * @param permissionExpiry
	 * @param centerCostId
	 * @param fuelId
	 * @param purchaseDate
	 * @param chasisNumber
	 * @param engineId
	 * @param tankCapacity
	 * @param tankUnitId
	 * @param abs
	 * @param airBag
	 * @param aireAcondicionado
	 * @param odometerUnitId
	 * @param corporation
