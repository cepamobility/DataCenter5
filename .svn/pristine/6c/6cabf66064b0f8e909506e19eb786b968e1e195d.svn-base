package communication.vehicle.tables;

import java.io.Serializable;
import java.util.Date;

import communication.driver.tables.DriverMainAttributes;

public class VehicleDriverListData implements Serializable {
	
	private DriverMainAttributes driver;
	private Date fromDate;
	private Date toDate;
	private static final long serialVersionUID = 1L;
	/**
	 * @return the driver
	 */
	public DriverMainAttributes getDriver() {
		return driver;
	}
	/**
	 * @param driver the driver to set
	 */
	public void setDriver(DriverMainAttributes driver) {
		this.driver = driver;
	}
	/**
	 * @return the fromDate
	 */
	public Date getFromDate() {
		return fromDate;
	}
	/**
	 * @param fromDate the fromDate to set
	 */
	public void setFromDate(Date fromDate) {
		this.fromDate = fromDate;
	}
	/**
	 * @return the toDate
	 */
	public Date getToDate() {
		return toDate;
	}
	/**
	 * @param toDate the toDate to set
	 */
	public void setToDate(Date toDate) {
		this.toDate = toDate;
	}
	
	
	public VehicleDriverListData(DriverMainAttributes driver, Date fromDate,
			Date toDate) {
		super();
		this.driver = driver;
		this.fromDate = fromDate;
		this.toDate = toDate;
	}
	
	
}
