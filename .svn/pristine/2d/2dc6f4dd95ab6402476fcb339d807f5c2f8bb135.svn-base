					<tr  class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
<%							if (driverForm.getLicenseNotExpiry() != null && driverForm.getLicenseNotExpiry().equalsIgnoreCase("on")){ %>
