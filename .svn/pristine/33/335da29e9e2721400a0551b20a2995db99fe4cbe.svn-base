			<form-property name="password" type="java.lang.String" />
			<form-property name="confirm" type="java.lang.String" />
			<form-property name="language" type="java.lang.String" />
		</form-bean>
		<form-bean name="ContractorUserCreateForm"  type="org.apache.struts.action.DynaActionForm">
			<form-property name="password" type="java.lang.String" />
			<form-property name="rePassword" type="java.lang.String" />
			<form-property name="firstName" type="java.lang.String" />
			<form-property name="lastName" type="java.lang.String" />
			<form-property name="email" type="java.lang.String" />
			<form-property name="language" type="java.lang.String" />
			<form-property name="loginname" type="java.lang.String" />
			<form-property name="type" type="java.lang.String" />
			<form-property name="contractorId" type="java.lang.String" />
