		<!-- LOGIN, ACTION DEFINITIONS -->
		<action path="/CEPARedirect" type="presentation.translator.web.user.CEPARedirectAction" name="CEPARedirect" scope="request" input="/redirect.jsp">
			<forward name="back" path="/redirect.jsp" />
			<forward name="dc4" path="/redirect.jsp?system=DC4" />
			<forward name="dc5" path="/redirect.jsp?system=DC5" />
		</action>
		<action path="/login" type="presentation.translator.web.user.LoginAction" name="LoginForm" scope="request" input="/login.jsp">
			<forward name="home" path="/translate.html" />
			<forward name="login" path="/login.jsp" />
		</action>
		<action path="/logout" type="presentation.translator.web.user.LogoutAction" name="LogoutForm" scope="request" input="/home.jsp">
			<forward name="init" path="/end.jsp" />
		</action>
		<action path="/Resetpassword" type="presentation.translator.web.user.ResetPasswordAction" name="ResetPasswordForm" scope="request" input="/resetPassword.jsp">
			<forward name="cancel" path="/login.jsp" />
			<forward name="nouser" path="/resetPassword.jsp?message=2" />
			<forward name="back" path="/resetPassword.jsp?message=1" />
			<forward name="reset" path="/resetPasswordSuccess.jsp?type=1" />
			<forward name="newuser" path="/resetPasswordSuccess.jsp?type=2" />
		</action>

		<!-- MODULE USER, ACTION DEFINITIONS -->
		<action path="/Usercreate" type="presentation.translator.web.user.CreateAction" name="UserCreateForm"  scope="request" input="/layout.jsp?refer=/create.jsp">
