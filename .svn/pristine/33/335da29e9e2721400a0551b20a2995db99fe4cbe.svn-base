<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 1.2//EN" "/WEB-INF/struts-config_1_2.dtd">

<struts-config>

	<form-beans>

		<!-- LOGIN FORM, BEAN DEFINITIONS-->

		<form-bean name="CEPARedirect" type="org.apache.struts.action.DynaActionForm">
			<form-property name="mail" type="java.lang.String" />
		</form-bean>
		<form-bean name="LoginForm" type="presentation.translator.web.user.LoginForm" />
		<form-bean name="LogoutForm" type="org.apache.struts.action.DynaActionForm" />
		<form-bean name="ResetPasswordForm" type="presentation.translator.web.user.ResetPasswordForm" />

		<!-- MODULES USER, FORM BEAN DEFINITIONS -->
		<form-bean name="BookmarkForm"  type="org.apache.struts.action.DynaActionForm">
			<form-property name="name" type="java.lang.String" />
			<form-property name="start" type="java.lang.String" />
		</form-bean>
		<form-bean name="BookmarkUpdateForm"  type="presentation.translator.web.administration.bookmark.BookmarkUpdateForm" />
		<form-bean name="BookmarkDeleteForm"  type="org.apache.struts.action.DynaActionForm"></form-bean>
		<form-bean name="UserSwitchCorporationForm"  type="org.apache.struts.action.DynaActionForm">
			<form-property name="corporation" type="java.lang.String" />
