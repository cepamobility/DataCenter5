package business.ws.client.driver;

import java.io.Serializable;
import java.util.Date;


import business.ws.client.common.WSLDivOrgData;

import communication.administration.corporation.tables.CorporationData;
import communication.administration.corporation.tables.GeoLabelData;
import communication.driver.tables.AptitudTestData;

public class WSLDriverMainAttributesData implements Serializable {

	private static final long serialVersionUID = 1L;
	
	private Integer id;
	private String firstName;
	private String lastName;
	private String country;
	private String birthDate;
	private String city;
	private String exclusionDate;
	private String divOrgItem1;
	private String divOrgItem2;
	private String divOrgItem3;
	private String divOrgItem4;
	private String corporationId;
	private String licenceExpirity;

	public WSLDriverMainAttributesData(){
		
	}

	public Integer getId() {
		return id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public String getFirstName() {
		return firstName;
	}

	public void setFirstName(String firstName) {
		this.firstName = firstName;
	}

	public String getLastName() {
		return lastName;
	}

	public void setLastName(String lastName) {
		this.lastName = lastName;
	}

	public String getCountry() {
		return country;
	}

	public void setCountry(String country) {
		this.country = country;
	}

	public String getBirthDate() {
		return birthDate;
	}

	public void setBirthDate(String birthDate) {
		this.birthDate = birthDate;
	}

	public String getCity() {
		return city;
	}

	public void setCity(String city) {
		this.city = city;
	}

	public String getExclusionDate() {
		return exclusionDate;
	}

	public void setExclusionDate(String exclusionDate) {
		this.exclusionDate = exclusionDate;
	}

	public String getDivOrgItem1() {
		return divOrgItem1;
	}

	public void setDivOrgItem1(String divOrgItem1) {
		this.divOrgItem1 = divOrgItem1;
	}

	public String getDivOrgItem2() {
		return divOrgItem2;
	}

	public void setDivOrgItem2(String divOrgItem2) {
		this.divOrgItem2 = divOrgItem2;
	}

	public String getDivOrgItem3() {
		return divOrgItem3;
	}

	public void setDivOrgItem3(String divOrgItem3) {
		this.divOrgItem3 = divOrgItem3;
	}

	public String getDivOrgItem4() {
		return divOrgItem4;
	}

	public void setDivOrgItem4(String divOrgItem4) {
		this.divOrgItem4 = divOrgItem4;
	}

	public String getCorporationId() {
		return corporationId;
	}

	public void setCorporationId(String corporationId) {
		this.corporationId = corporationId;
	}

	public String getLicenceExpirity() {
		return licenceExpirity;
	}

	public void setLicenceExpirity(String licenceExpirity) {
		this.licenceExpirity = licenceExpirity;
	}
 
	
	
}
