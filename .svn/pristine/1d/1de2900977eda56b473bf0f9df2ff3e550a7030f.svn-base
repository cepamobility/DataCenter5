<ion-view view-title="{{f}}">
    <loading></loading>
     <ion-content class="padding">
     	<button class="button button-assertive" ng-click="readyForSync()">
		  {{txt.readyForSync}}
		</button>
		<button class="button button-stable" ng-click="newDriver()">
		  {{txt.addDriver}}
		</button>
		<div class="list card">
	      <div class="item item-divider">
	      <p>{{ac.name}} -  {{txt.participants}}</p>
	       <p>{{ac.date}}</p>
	      <p>{{ac.countryName}}</p>
	          <p>{{ac.divOrg1Name}}</p>
	          <p>{{ac.divOrg2Name}}</p>
	          <p>{{ac.divOrg3Name}}</p>
	      
	      </div>
	       <ion-item class="item item-body"  ng-repeat="driver in ac.participants" type="item-text-wrap" ng-click="openDriver(driver)">
				<p>{{driver.corporationid}}</p>
				<p>{{driver.firstName}}</p>
				<p>{{driver.lastName}}</p>
				<i class="icon ion-chevron-right icon-accessory"></i>
			</ion-option-button>
	      </div>
	      
	    </div>
	  </ion-content>
</ion-view>
