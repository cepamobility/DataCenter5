		function drawFineSpeed() {
  			var data = new google.visualization.DataTable();
  			data.addColumn('string', 'MÊS');
  			data.addColumn('number', 'MULTAS');
  			data.addColumn('number', 'INFRAÇÕES');
  			data.addColumn('number', 'TOTAL');
  			data.addRows(12);
<%			for(int i = 0; i < values.length; i++) {
%>				data.setCell(<%=String.valueOf(i)%>, 0, '<%=values[i][0]%>', '<%=values[i][0]%>', {style: 'color:black;'});
				data.setCell(<%=String.valueOf(i)%>, 1, <%=values[i][1]%>, '<%=values[i][1]%>', {style: 'color:black;'});
				data.setCell(<%=String.valueOf(i)%>, 2, <%=values[i][2]%>, '<%=values[i][2]%>', {style: 'color:black;'});
				data.setCell(<%=String.valueOf(i)%>, 3, <%=values[i][3]%>, '<%=values[i][3]%>', {style: 'color:black;'});
<%			}
%>				var cssClassNames = {
					'headerRow': 'header-cell',
					'tableRow': 'cell-background',
					'oddTableRow': 'cell-background',
					'selectedTableRow': 'cell-background'};
			
			 	var options = {'title':'',
					'width':1000,
					'allowHtml': true,
					'cssClassNames': cssClassNames
				};
		 	var table = new google.visualization.Table(document.getElementById('fineSpeed'));
		  	table.draw(data, options);
		}
		function drawFineSpeedChart() {
		      var data = new google.visualization.DataTable();
		      data.addColumn('string', 'Mes');
		      data.addColumn('number', 'Multas');
 			  data.addColumn({type: 'string', role: 'annotation'});
		      data.addColumn('number', 'Velocidades');
 			  data.addColumn({type: 'string', role: 'annotation'});

		      data.addRows([
<%			for(int i = 0; i <= monthValue; i++) {
%>				['<%=values[i][0].substring(0,3)%>', <%=values[i][1]%>, '<%=values[i][1]%>', <%=values[i][2]%>, '<%=values[i][2]%>'],
<%			}
%>		     
		      ]);

		      var options = {
		        title: '',
		        'width':500,
		        'height':350,
                legend:{position: 'none'},
                backgroundColor: 'transparent',
		        colors: ['#4572A7','#93A9CF'],
		        annotations: {
			          alwaysOutside: true,
			          textStyle: {
			            fontSize: 10,
			            fontName: 'Verdana',
			            color: '#000',
			            auraColor: 'none'
			          }
		  		},
		        hAxis: {
		          title: '',
		        },
		        vAxis: {
		          title: ''
		        }
		      };

		      var chart = new google.visualization.ColumnChart(document.getElementById('fineSpeedChart'));
		      chart.draw(data, options);
		}
		function drawGPSPie() {
	        // Create the data table.
	        var data = new google.visualization.DataTable();
	        data.addColumn('string', 'Topping');
	        data.addColumn('number', 'Slices');
	        data.addRows([
	          ['Veículos com Informação', <%=String.valueOf(withGPS)%>],
	          ['Veículos sem Informação', <%=String.valueOf(withOutGPS)%>]
	        ]);
	        // Set chart options
	        var options = {'width':500,
	                       'colors':['#4572A7','#93A9CF'],
	                       chartArea:{left:30,top:0,width:'90%',height:'100%'},
	                       pieSliceText: 'none',
	   	                   pieSliceTextStyle: { color: 'white', fontName: 'Verdana', fontSize: '12' },
	                       legend:{position: 'right', textStyle: {color: '#333333', fontName: 'Verdana', fontSize: '12'}, alignment: 'center'},
	                       backgroundColor: 'transparent',
	                       'height':350};

	        // Instantiate and draw our chart, passing in some options.
	        var chart = new google.visualization.PieChart(document.getElementById('gpsPie'));
	        chart.draw(data, options);
	      }
<%			int[] driverMonthPoints = reportData.getDriverMonthPoints(monthValue);
			long value1 = Math.round(driverMonthPoints[2] * 100.0 / (driverMonthPoints[0] + driverMonthPoints[1] + driverMonthPoints[2]));
			long value2 = Math.round(driverMonthPoints[1] * 100.0 / (driverMonthPoints[0] + driverMonthPoints[1] + driverMonthPoints[2]));
			long value3 = 100 - (value1 + value2);
%>
		function drawGeneralPie() {
	        // Create the data table.
	        var data = new google.visualization.DataTable();
	        data.addColumn('string', 'Topping');
	        data.addColumn('number', 'Slices');
	        data.addRows([
	          ['Alto Risco', <%=String.valueOf(value1)%>],
	          ['Risco Moderado', <%=String.valueOf(value2)%>],
	          ['Condução Não Perigosa', <%=String.valueOf(value3)%>]
	        ]);

	        // Set chart options
	        var options = {'width':500,
	        		  	  'height':200,
	                'colors':['red','yellow','#00CC00'],
	                chartArea:{left:0,top:0,width:"90%",height:"100%"},
                    pieSliceText: 'none',
	                pieSliceTextStyle: { color: 'black', fontName: 'Verdana', fontSize: '12' },
	                legend:{position: 'right', textStyle: {color: '#333', fontName: 'Verdana', fontSize: '14'}, alignment: 'center'},
	                backgroundColor: 'transparent'};

	        // Instantiate and draw our chart, passing in some options.
	        var chart = new google.visualization.PieChart(document.getElementById('generalPie'));
	        chart.draw(data, options);
	      }
	      function drawGeneralChart() {
	    	  var data = google.visualization.arrayToDataTable([
	    	  	['Mes','Performance','Risco',   { role: 'annotation' } ],
<%		double performanceValue = Math.round(avg[0] * 100.0) / 100.0; 	
		double wrongValue = Math.round((100-performanceValue) * 100.0) / 100.0; 
%>				<%="['"+messages.getText("generic.month.12").substring(0, 3)+"',"+performanceValue+","+wrongValue+",''],"%>
<%  	for(int i = 1; i <= monthValue; i++) {
			performanceValue = Math.round(avg[i] * 100.0) / 100.0;
			wrongValue = Math.round((100-performanceValue) * 100.0) / 100.0;
%>				<%="['"+messages.getText("generic.month."+i).substring(0, 3)+"',"+performanceValue+","+wrongValue+",'']"%>
				<%=(i < 11) ? "," : ""%>
<%			}
%>	      	  			]);	 
	    	  	
	          	var view = new google.visualization.DataView(data);
		        var options = {
		  	            title: '',
		        		width: 750,
		                height: 250,
		                legend: { position: 'none' },
		                bar: { groupWidth: '75%' },
				        colors: ['#00CC00', 'red'],
			         	backgroundColor: 'transparent',
		                isStacked: true,
		              };

	            var columnchart = new google.visualization.ColumnChart(document.getElementById("generalChart"));
	            columnchart.draw(view, options);
	      }
	      function drawGeneralLine() {
	          var data = google.visualization.arrayToDataTable([
	            ['Mes', 'Performance', {type: 'string', role: 'annotation'}],
	    	  	<%="['"+messages.getText("generic.month.12").substring(0, 3)+"',"+String.valueOf(Math.round(avg[0] * 100.0) / 100.0)+",'"+String.valueOf(Math.round(avg[0] * 100.0) / 100.0)+"'],"%>
	            <%  	for(int i = 1; i <= monthValue; i++) {
	            			performanceValue = Math.round(avg[i] * 100.0) / 100.0; 
	            %>				<%="['"+messages.getText("generic.month."+i).substring(0, 3)+"',"+performanceValue+",'"+performanceValue+"']"%>
	            				<%=(i < 11) ? "," : ""%>
	            <%			}
	            %>	          ]);

	          var options = {
	        		title:'EVOLUÇÃO PERFORMANCE DE SEGURANÇA VEICULAR ',
	     			titleTextStyle: {color: '#555', fontName: 'Verdana', fontSize: '12', fontWidth: 'normal'},
		            width: 750,
		            height: 350,
		            vAxis: { viewWindow: { min: 0, max: 100 }},
		         	backgroundColor: 'transparent',
		            legend: { position: 'none' }
	          };

	          var chart = new google.visualization.LineChart(document.getElementById('generalLine'));
	          chart.draw(data, options);
	        }
			function drawTotalPerformacePie() {
			    // Create the data table.
			    var data = new google.visualization.DataTable();
			    data.addColumn('string', 'Risco');
			    data.addColumn('number', 'Valor');
			    data.addRows([
			      ['Alto Risco', <%=String.valueOf(totalPerformanceValues[2])%>],
			      ['Risco Moderado', <%=String.valueOf(totalPerformanceValues[1])%>],
			      ['Condução Não Perigosa', <%=String.valueOf(totalPerformanceValues[0])%>]
			    ]);
			
		        // Set chart options
		        var options = {'width':200,
		                       'colors':['red','yellow','#00CC00'],
		                       chartArea:{left:20,top:20,width:'90%',height:'80%'},
		                       legend:{position: 'none', textStyle: {color: '#333', fontName: 'Verdana', fontSize: '10'}, alignment: 'center'},
		                       pieSliceText: 'none',
   		   	                   pieSliceTextStyle: { color: 'black', fontName: 'Verdana', fontSize: '12' },
		                       backgroundColor: 'transparent',
		                       'height':200};
			
			    // Instantiate and draw our chart, passing in some options.
			    var chart = new google.visualization.PieChart(document.getElementById('totalperformancePie'));
			    chart.draw(data, options);
			  }
	</script>
	</head>
	<body>
      	<header id="header">
         	<section class="grid_container">
				<h1 class="customer_logo" style="background-image: url('images/main_logo_large.png');">Ecolab</h1>
            	<div class="toolbar">
               		<span class="username"><%=userSessionData.getFullName()%></span>
               		<span class="exit">
               			<a href="ecolabParameters.jsp">Voltar</a>
               			<a href="login.jsp"><%=messages.getText("generic.messages.logout")%></a>
               		</span>
            	</div>
         	</section>
      	</header>

		<form name="logout" action="./login.jsp" method="post"></form>
    	<section id="content" ng-app="app" >
			<section class="grid_container">
				<form name="assessments" action="./report_assessment.jsp" method="post">
