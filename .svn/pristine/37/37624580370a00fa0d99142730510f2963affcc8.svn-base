		function drawSpeedChart() {
<%			if(speedChart != null) {
%>
			var data = google.visualization.arrayToDataTable(<%=speedChart%>);
            var view = new google.visualization.DataView(data);
            view.setColumns([0, 1,
                             { calc: "stringify",
                               sourceColumn: 1,
                               type: "string",
                               role: "annotation" },
                             2]);

            var options = {
              title: "",
              width: 1000,
              chartArea:{left:350,top:50,width:'60%',height:'80%'},
              fontSize:10,
              fontName: 'Verdana',
              backgroundColor: 'transparent',
              height: <%=String.valueOf(Math.max(500,driversWithSpeed*50))%>,
              bars: 'horizontal',
              bar: {groupWidth: "50%"},
              legend: { position: "none" },
            };
            var chart = new google.visualization.BarChart(document.getElementById("speedchart"));
            chart.draw(view, options);
<%			}        
%>		}
		function drawFineMonthChart() {
<%			if(fines.size() > 0) {
%>
				var data = google.visualization.arrayToDataTable(<%=reportData.getFineChart(monthValue, false)%>);
	            var view = new google.visualization.DataView(data);
	            view.setColumns([0, 1,
	                             { calc: "stringify",
	                               sourceColumn: 1,
	                               type: "string",
	                               role: "annotation" },
	                             2]);

	            var options = {
	              title: "",
