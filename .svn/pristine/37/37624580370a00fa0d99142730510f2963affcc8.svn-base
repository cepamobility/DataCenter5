<%@page import="java.util.Calendar"%>
<%@page import="com.arjuna.ats.arjuna.tools.report"%>
<%@page import="com.sun.org.apache.xalan.internal.xsltc.runtime.Hashtable"%>
<%@page import="communication.datatype.tables.EcolabFineData"%>
<%@page import="communication.datatype.tables.EcolabDriverData"%>
