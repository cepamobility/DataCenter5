		function drawParametricMonthChart() {
			var data = google.visualization.arrayToDataTable(<%=reportData.getParametricMonthChart(monthValue)%>);
            var view = new google.visualization.DataView(data);
            view.setColumns([0, 1,
                             { calc: "stringify",
                               sourceColumn: 1,
                               type: "string",
                               role: "annotation" },
                             2]);

            var options = {
              title: "",
              width: 1000,
              chartArea:{left:350,top:10,width:'60%',height:'80%'},
              fontSize:10,
              fontName: 'Verdana',
              backgroundColor: 'transparent',
              height: <%=String.valueOf(reportData.getDrivers().size()*50)%>,
              bars: 'horizontal',
              bar: {groupWidth: "50%"},
              hAxis: { viewWindow: { min: 0, max: 100 }},
              legend: { position: "none" },
            };
            var chart = new google.visualization.BarChart(document.getElementById("parametricMonthChart"));
            chart.draw(view, options);
		}
