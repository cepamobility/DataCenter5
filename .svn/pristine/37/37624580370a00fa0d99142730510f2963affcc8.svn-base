%>			    						</div>
			    						<div id="columnaGral">
			    							<br>
			    							<br>
						    				<div id="gpsPie"></div>
				    					</div>
			    					</div>
		    					</div>
		    				</div>
	    				</div>
	    				<div id="analizeSheet" style="display: none; width: 1000px;">
	    					<div id="titlePage">
	    						<h1>ANÁLISES DE GESTÃO</h1>
	    					</div>
	    					<div id="general">
		    					<div id="contenidos">
			    					<div id="columnaGral">
				    					<div style="width: 500px;">
											<div class="borderLine" style="height: 600px">
												<br>
						    					<div class="generalSubtitle" style="text-align:center;">
							    					MENSAIS
						    					</div>							
					  							<div id="contenedor">
													<div id="contenidos">
														<div id="columna1">
															- <%=value3%>% dos condutores não estiveram envolvidos em condução perigosa em <%=monthStr%> de <%=year%>.
														</div>				
													</div>
													<div id="contenidos">
														<div id="columna1">
															- <%=value2%>% dos condutores foram considerados condutores de risco moderado em <%=monthStr%> <%=year%>.
														</div>							
													</div>
													<div id="contenidos">
														<div id="columna1">
															- <%=value1%>% dos condutores foram considerados condutores de alto risco em <%=monthStr%> <%=year%>.
														</div>
													</div>
												</div>							
												<br>
						    					<div class="generalSubtitle" style="text-align:center;">
													 INFRAÇÕES DE VELOCIDADE				
												</div>							
<%					String msg = "- No mês de "+monthStr+" "+year+" ";
					switch(Integer.parseInt(values[monthValue][2])) {
						case 0:
							msg += "não ocorreu Infrações de Velocidade.";
							break;
						case 1:
							msg += "ocorreu uma Infracção de Velocidade.";
							break;
						default:
							msg += "ocorreram "+values[monthValue][2]+" Infrações de Velocidade, com ";
							msg += (driversWithSpeed == 1) ? "1 motorista envolvido." : driversWithSpeed+" motoristas envolvidos.";  
							break;
					}
%>
					  							<div id="contenedor">
													<div id="contenidos">
														<div id="columna1">
															<%=msg%>				
														</div>
													</div>
												</div>
												<br>
						    					<div class="generalSubtitle" style="text-align:center;">
													COMPARATIVO MENSAL
												</div>				
					  							<div id="contenedor">
													<div id="contenidos">
														<div id="columna1">
															<%="- "+withGPS+"% dos veículos ativos da Frota possuem sistema de Monitoramento em funcionamento."%>							
														</div>
													</div>
													<div id="contenidos">
														<div id="columna1">
															<%="- "+String.valueOf(100-withGPS)+"% dos veículos ativos não possuem sistema de monitoramento."%>					
														</div>
													</div>
												</div>
												<br>
						    					<div class="generalSubtitle" style="text-align:center;">
													ANÁLISE DAS MULTAS
												</div>				
<%					msg = "- No mês de "+monthStr+" "+year+" ";
					switch(Integer.parseInt(values[monthValue][1])) {
						case 0:
							msg += "não ocorreu multa.";
							break;
						case 1:
							msg += "ocorreu uma multa.";
							break;
						default:
							msg += "ocorreram "+values[monthValue][1]+" multas, com ";
							msg += (driversWithFine == 1) ? "1 motorista envolvido neste departamento." : driversWithFine+" motoristas envolvidos neste departamento.";  
							break;
					}
%>												<div id="contenedor">
													<div id="contenidos">
														<div id="columna1">
															<%=msg%>
														</div>	
													</div>
<%				double variation1 = (monthValue == 0) ? 0.0 : Math.round((avg[monthValue] - avg[monthValue-1]) * 100.0 / avg[monthValue-1] * 100.0) / 100.0;
				double variation2 = (monthValue == 0) ? 0.0 : Math.round((Double.parseDouble(values[monthValue][1]) - Double.parseDouble(values[monthValue-1][1])) * 100.0 / Double.parseDouble(values[monthValue-1][1]) * 100.0) / 100.0;
				double variation3 = (monthValue == 0) ? 0.0 : Math.round((Double.parseDouble(values[monthValue][2]) - Double.parseDouble(values[monthValue-1][2])) * 100.0 / Double.parseDouble(values[monthValue-1][2]) * 100.0) / 100.0;
%>							
	    										</div>
	    									</div>
	    								</div>
    								</div>
    								&nbsp;
			    					<div id="columnaGral">
	    								<div style="width: 500px;">
											<div class="borderLine" style="height: 600px">
												<br>
	    										<div class="generalSubtitle" style="text-align:center;">
	    											ANUAIS
	    										</div>							
					  							<div id="contenedor">
													<div id="contenidos">
														<div id="columna1">
															<%="Variação da Performance Mensal de Segurança Veicular de "+monthStr+" de "+year+" em relação ao mês anterior :"+variation1+"%."%></p>				
														</div>	
													</div>
													<div id="contenidos">
														<div id="columna1">
															<%="Variação Infrações de Velocidade de "+monthStr+" de "+year+" em relação ao mês anterior :"+variation3+"%."%></p>				
														</div>	
													</div>
													<div id="contenidos">
														<div id="columna1">
															<%="Variação de Multas de "+monthStr+" de "+year+" em relação ao mês anterior :"+variation2+"%."%></p>				
														</div>	
													</div>
												</div>
												<br>						
												<div class="generalSubtitle" style="text-align:center;">
													STATUS DOS CONDUTORES - MÉDIA ANUAL
												</div>							
					  							<div id="contenedor">
													<div id="contenidos">
														<div id="columna1">
								  							<div id="contenedor"  style="width: 250px;">
																<div id="contenidos">
																	<div id="columna" style="width: 150px; text-align: left;">
								  										Condução Não Perigosa:
								  									</div>
																	<div id="columna2" style="background-color:#00CC00;">
			  															<%=String.valueOf(totalPerformanceValues[0])%>
			  														</div>
																</div>
																<div id="contenidos">
																	<div id="columna" style="width: 150px; text-align: left;">
								  										Risco Moderado:
								  									</div>
																	<div id="columna2" style="background-color:yellow;">
			  															<%=String.valueOf(totalPerformanceValues[1])%>
			  														</div>
																</div>
																<div id="contenidos">
																	<div id="columna" style="width: 150px; text-align: left;">
								  										Alto Risco:
								  									</div>
																	<div id="columna2" style="background-color:red;">
			  															<%=String.valueOf(totalPerformanceValues[2])%>
			  														</div>
																</div>
															</div>
  														</div>
  														<div id="columna1">
															<div id="totalperformancePie"></div>
														</div>
													</div>	
												</div>
						    				</div>
					    				</div>
				    				</div>
				    			</div>
				    		</div>
				    	</div>
	    				<div id="generalSheet" style="display: none; width: 1200px;">
	    					<div id="titlePage">
	    						<h1>TABELA DE COMANDO VEICULAR</h1>
	    					</div>
	    					<div class="borderPointed" style="width: 350px;">
	    						<p style="text-align: center;">Legenda</p>
	    						<p class="backGreen" style="height: 25px;">100 - 75 pontos = Condução não perigosa</p>
	    						<p class="backYellow" style="height: 25px;">74,99 - 50 pontos = Ricos Moderado</p>
	    						<p class="backRed" style="height: 25px;">49,99 - 0 pontos = Alto Risco</p>
	    					</div>
	    					<br>
	    					<div id="general">
		    					<div id="contenidos">
			    					<div id="columnaGral">
				    					<div style="width: 500px;">
											<div class="borderLine" style="height: 50px;">
												<br>
												<span class="generalText" style="height: 30px; vertical-align: middle;">PERFORMANCE DE SEGURANÇA VEICULAR (DEZ-<%=monthStr.toUpperCase().substring(0,3)%>):<%=String.valueOf(avg[12]) %></span>
											</div>
											<br>
											<div class="borderLine">
												<br>
												<div class="generalSubtitle" style="text-align:center;">
													VALORES TOTAIS - <%=monthStr.toUpperCase()%>
												</div>
												<br>
												<div id="contenedor">
													<div id="contenidos">
														<div id="columna1">Frota com Informação:</div>
														<div id="columna2"><%=withGPS+"%"%></div>
														&nbsp;
													</div>
													<br>
													<div id="contenidos">
														<div id="columna1">Veículos com Informação:</div>
														<div id="columna2"><%=String.valueOf(gpsVehicles[0])%></div>
														&nbsp;
													</div>
													<br>
													<div id="contenidos">
														<div id="columna1">Veículos Analisados:</div>
														<div id="columna2"><%=String.valueOf( ((Integer)gpsVehicles[0]).intValue() + ((Collection)gpsVehicles[1]).size() )%></div>
														&nbsp;
													</div>
												</div>
												<br>
												<div class="generalSubtitle" style="text-align:center;">
													EVENTOS
												</div>
												<br>
												<div id="contenedor">
													<div id="contenidos">
														<div id="columna1">Total de Infrações de Velocidade:</div>
														<div id="columna2"><%=values[monthValue][2]%></div>
														&nbsp;
													</div>
													<br>
													<div id="contenidos">
														<div id="columna1">Total de Multas:</div>
														<div id="columna2"><%=values[monthValue][1]%></div>
														&nbsp;
													</div>
												</div>
												<br>
<%			int multivehicles = reportData.getMultivehicles();
%>												<div class="generalSubtitle" style="text-align:center;">
													CONDUTORES (MENSAL)<%=(multivehicles > 0) ? "*" : ""%>
												</div>
												<br>
												<div id="contenedor">
													<div id="contenidos">
														<div id="columna1">Condução Não Perigosa:</div>
														<div id="columna2" style="background-color:#00CC00;"><%=String.valueOf(driverMonthPoints[0])%></div>
														&nbsp;
													</div>
													<br>
													<div id="contenidos">
														<div id="columna1">Risco Moderado:</div>
														<div id="columna2" style="background-color:#FFFF00;"><%=String.valueOf(driverMonthPoints[1])%></div>
														&nbsp;
													</div>
													<br>
													<div id="contenidos">
														<div id="columna1">Alto Risco:</div>
														<div id="columna2" style="background-color:#FF0000;"><%=String.valueOf(driverMonthPoints[2])%></div>
														&nbsp;
													</div>
												</div>
												<br>
<%			if(multivehicles > 0) {
				String txt = (multivehicles > 1) ? "* "+multivehicles+" Condutores ficaram responsavéis por mais de um veículo." : "* 1 condutor ficou responsável por mais de um veículo";
%>												<div class="columna" style="text-align:center;">
													<%=txt%>
												</div>
												<br>
<%			}
%>												
					    					</div>
				    					</div>
				    					<br>
				    					<br>
					    				<div id="generalPie" style="width: 500px; height: 400px;"></div>
				    				</div>
			    					<div id="columnaGral" style="width: 800px;">
					    				<div id="generalLine"></div>
					    				<div id="generalChart"></div>
					    			</div>
				    			</div>
		    				</div>
	    				</div>
	    			</fieldset>
	    		</form>
			</section>
		</section>
		<script type="text/javascript" src="scripts/json2.min.js"></script>
