	              backgroundColor: 'transparent',
	              height: <%=String.valueOf(Math.max(500,reportData.getMonthDriverFines()*50))%>,
	              bars: 'horizontal',
	              bar: {groupWidth: "50%"},
	              legend: { position: "none" },
	            };
	            var chart = new google.visualization.BarChart(document.getElementById("fineChart1"));
	            chart.draw(view, options);
<%			}        
%>		}
