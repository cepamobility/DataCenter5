    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetinsertdata"
     */
    public void fillEvents(Integer period, Integer year, Collection<Integer[]> values, UserSessionData userSessionData) throws Exception {
        try{
            FleetABM fleetABM = FleetABMUtil.getHome().create();
            FleetReport fleetReport = FleetReportUtil.getHome().create();
            Iterator<Integer[]> it = values.iterator();
            while(it.hasNext()) {
            	Integer[] value = it.next();
            	FleetDivisionDetailData detail = fleetReport.getLastDivisionValue(value[0],period,year,userSessionData);
            	boolean insert = false;
            	if(detail == null) {
            		detail = new FleetDivisionDetailData(new FleetDivisionData(value[0]));
            		insert = true;
            	} else if(detail.getPeriod().intValue() != period.intValue() || detail.getYear().intValue() != year.intValue()) {
            		detail.setVehicles(0);
            		detail.setNearmiss(0);
            		detail.setMiles(0);
            		insert = true;
            	}
        		detail.setPeriod(period);
        		detail.setYear(year);
        		detail.setAccidents(value[1]);
        		detail.setIncidents(value[2]);
        		if(insert) {
        			fleetABM.updateDetail(detail, userSessionData);
        		}else {
        			fleetABM.updateDivisionDetail(detail, userSessionData);
        		}
            }
            
        } catch (Exception e) {
        	Object[]p = {period,year,values};
            handler.handleException("fillEvents",e,userSessionData,p);
        }
    }
}
