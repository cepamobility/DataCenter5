            handler.handleException("updateOdometer",e,userSessionData,p);
        }
    }

    /**
     * @ejb.interface-method
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "driverodometer"
     */
    public void insertOwnOdometer(OdometerData odometerData, UserSessionData userSessionData) throws Exception {
        try{
            if(userSessionData == null) {
                throw new DeslogedException("insertOwnOdometer","userSessionData == null");
            }
            if(odometerData == null) {
                throw new InvalidDataException("insertOwnOdometer","detail == null");
            }
            Collection fleets = FleetReportUtil.getHome().create().findVehicleFleets(odometerData.getVehicle().getId(),userSessionData);
            Iterator it = fleets.iterator();

            FleetABMHome home = FleetABMUtil.getHome();
            FleetABM fleetABM = home.create();
            while(it.hasNext()) {
            	Integer fleetId = (Integer)it.next(); 
            	if(fleetId.intValue()  != FleetData.MONSANTO_FYFLEET_2012 && fleetId.intValue()  != FleetData.MONSANTO_FYFLEET_2013 && fleetId.intValue()  != FleetData.ALLERGAN_FLEET_2014) {
	                odometerData.setFleet(new FleetData(fleetId));
	                fleetABM.updateOdometer(odometerData,userSessionData);
            	}
            }
        } catch (Exception e) {
        	Object[] p = new Object[1];
        	p[0] = odometerData;
            handler.handleException("insertOwnOdometer",e,userSessionData,p);
        }
    }

