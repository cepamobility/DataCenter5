 *              "remote"
 * 
 * @jboss.ejb-ref-jndi jndi-name = "ejb/FleetReport" ref-name = "FleetReport"
 * 
 * @ejb.util generate="physical"
 * 
 */
public abstract class FleetABMFacadeBean  implements javax.ejb.SessionBean {

    private ExceptionHandler handler = new ExceptionHandler(FleetABMFacadeBean.class);

	/**
	 * Create method
	 * @ejb.permission role-name = "fleetdelete,fleetupdate,fleetcreate,administrator,driverfleetinsertdata,fleetinsertdata,driverodometer"
	 * @ejb.create-method
	 */
	public void ejbCreate() throws javax.ejb.CreateException {

	}
	
	/**
	 * @ejb.interface-method view-type = "remote"
	 * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,drivercreate,fleetcreate"
	 * @param data
	 * @throws Exception 
	 */
	public void fleetCreate(FleetData data,String comment,UserSessionData userRequest) throws Exception {
		
        try{	
            if(userRequest == null) {
                throw new DeslogedException("fleetCreate","userRequest = null");
            }
            if(data == null) {
                throw new InvalidDataException("fleetCreate","data = null");
            }
		
            String valid = data.validate();
            if (valid != null) {
                throw new InvalidDataException("fleetCreate",valid);
            }

            FleetABMHome home = FleetABMUtil.getHome();
            FleetABM fleetABM = home.create();		
            fleetABM.fleetCreate(data, userRequest,comment);
	
        } catch (Exception exception) {
        	Object[] parameters = new Object[2];
        	parameters[0] = data;
        	parameters[1] = comment;
            handler.handleException("driverCreate",exception,userRequest, parameters);
        } 
	}

	/**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,driverupdate,fleetupdate"
     * @param data
     * @param comment
     * @throws Exception 
     */
	public FleetDivisionData fleetDivisionAdd(FleetData data, UserSessionData userRequest, 
			FleetDivisionData fdd, String comment)
	throws Exception
	{
		  try
		  { 
			  FleetABMHome home = FleetABMUtil.getHome();
	          FleetABM fleetABM = home.create();      
	          return fleetABM.fleetDivisionAdd(data, userRequest,fdd,comment); 
		  }
		  catch (Exception exception) 
		  {
			  Object[] parameters = new Object[3];
			  parameters[0] = data;
			  parameters[1] = fdd;
			  parameters[2] = comment;
			  handler.handleException("fleeDivisionAdd",exception, userRequest,parameters);
		  } 		
		  return fdd;
	}  

    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,driverupdate,fleetupdate,fleetblockdata"
     * @param data
     * @throws Exception 
     */
	public void fleetsUpdateBlockPeriod(Collection fleetsData, UserSessionData userSessionData, 
			RegionBlockData regionBlockData) throws Exception
	{
		FleetData fleetData;
		Iterator it;
		try
		{
			// TODO: Aca validar que la fecha de bloqueo sea mayor o igual que la
			// fecha de bloqueo que ya estaba seteada, de lo contrario
			// devolver una excepcion o un error de alerta para que el usuario
			// confirme si esta seguro.
			
			it = fleetsData.iterator();
			while (it.hasNext()){
				fleetData = (FleetData)it.next();
				fleetData.setBlockMonth(regionBlockData.getBlockMonth());
				fleetData.setBlockYear(regionBlockData.getBlockYear());
			}
			FleetABMHome home = FleetABMUtil.getHome();
	        FleetABM fleetABM = home.create();      
	        fleetABM.fleetsUpdateBlockPeriod(fleetsData,userSessionData, regionBlockData);
	    
			
			
		}catch(Exception e)
		{
			Object[] parameters = new Object[2];
			parameters[0] = fleetsData;
			parameters[1] = regionBlockData;
			  handler.handleException("fleetsUpdateBlockPeriod",e, userSessionData, parameters);
		}
	}
	
    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,driverupdate,fleetupdate"
     * @param data
     * @throws Exception 
     */
    public void fleetUpdate(FleetData fleet, UserSessionData userSessionData, 
    		String comment, int action) throws Exception {
        try{    
            if(userSessionData == null) {
                throw new DeslogedException("fleetUpdate","userRequest = null");
            }
            if(fleet == null) {
                throw new InvalidDataException("fleetUpdate","data = null");
            }
        
            String valid = fleet.validate();
            if (valid != null) {
                throw new InvalidDataException("fleetUpdate",valid);
            }

            FleetABMHome home = FleetABMUtil.getHome();
            FleetABM fleetABM = home.create();      
            fleetABM.fleetUpdate(fleet, userSessionData,comment,action);
    
        } catch (Exception exception) {
        	Object [] p = new Object [3];
        	p[0] = fleet;
        	p[1] = comment;
        	p[2] = action;
            handler.handleException("fleetUpdate",exception, userSessionData, p);
        } 
    }
    
    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,fleetupdate,fleetdelete"
     * @param data
     * @throws Exception 
     */
    public void fleetExclude(String fleets,Date exclusionDate, 
    		String comment,UserSessionData userRequest) throws Exception{ 
       
    	FleetABM fleetABM = null; 
    	try{    
	        if (userRequest == null) {
	            throw new DeslogedException("Class business.fleet.FleetABMFacade(fleetUpdate), session data is empty","generic.error.deslogued");
	        }
	
	        FleetReportHome reportHome = FleetReportUtil.getHome();
	        FleetReport fleetReport = reportHome.create();	
	        FleetABMHome home = FleetABMUtil.getHome();
	        fleetABM = home.create();
	
	        StringTokenizer tokenizer = new StringTokenizer(fleets,",");
	        while(tokenizer.hasMoreTokens()) {
	            String fleetId = tokenizer.nextToken();
	            FleetData fleetData = fleetReport.findFleetByPrimaryKey(new Integer(fleetId),userRequest);
	            fleetData.setExclusionDate(exclusionDate);
	            fleetABM.fleetUpdate(fleetData, userRequest, comment, LogActions.EXCLUDE);
	        }
	    } catch (Exception exception) {
	    	Object[] p = new Object[3];
	    	p[0] = fleets;
	    	p[1] = exclusionDate;
	    	p[2] = comment;
	        handler.handleException("fleetExclude",exception, userRequest, p);
	    }
    }
    
    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,fleetdelete,fleetupdate"
     * @param data
     * @throws Exception 
     */
    public void fleetInclude(String fleets,
    		String comment,UserSessionData userRequest) throws Exception{ 
       
    	FleetABM fleetABM = null; 
    	try{    
	        if (userRequest == null) {
	            throw new DeslogedException("Class business.fleet.FleetABMFacade(fleetUpdate), session data is empty","generic.error.deslogued");
	        }
	
	        FleetReportHome reportHome = FleetReportUtil.getHome();
	        FleetReport fleetReport = reportHome.create();
	
	        FleetABMHome home = FleetABMUtil.getHome();
	        fleetABM = home.create();
	
	        StringTokenizer tokenizer = new StringTokenizer(fleets,",");
	        while(tokenizer.hasMoreTokens()) {
	            String fleetId = tokenizer.nextToken();
	            FleetData fleetData = fleetReport.findFleetByPrimaryKey(new Integer(fleetId),userRequest);
	            fleetData.setExclusionDate(null);
	            fleetABM.fleetUpdate(fleetData, userRequest, comment, LogActions.INCLUDE);
	        }
	    } catch (Exception exception) {
	    	Object[] p = new Object[2];
	    	p[0] = fleets;
	    	p[1] = comment;
	        handler.handleException("fleetInclude",exception, userRequest, p);
	    }
    }
    
    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,driverdelete"
     * @param ids
     * @param data
     * @param comment
     * @throws Exception 
     */
    public void fleetDelete(Collection ids, UserSessionData userSessionData, String comment) throws Exception {
        try{    
       
            FleetReportHome reportHome = FleetReportUtil.getHome();
            FleetReport fleetReport = reportHome.create();      
            
            FleetABMHome home = FleetABMUtil.getHome();
            FleetABM fleetABM = home.create();      
            Iterator it = ids.iterator();
            while(it.hasNext()) {
                Integer fleetId = new Integer((String)it.next());
                if(!fleetReport.validateDelete(fleetId,userSessionData)) {
                    throw new InvalidDataException("fleetDelete","fleet can't be deleted");
                }
                fleetABM.fleetDelete(fleetId, userSessionData, comment);
            }
            
    
        } catch (Exception exception) {
        	Object[] p = new Object[2];
        	p[0] = ids;
        	p[1] = comment;
            handler.handleException("fleetDelete",exception, userSessionData, p);
        } 
    }

