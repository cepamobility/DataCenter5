package communication.administration.corporation.util;

import java.io.Serializable;
import java.util.Date;

public class DPACheckListXLSFilter implements Serializable {
	
	private static final long serialVersionUID = 1L;
	
	private Date start;
	private Date end;
	private String text;
	private Boolean inspectedByMy;
	
	public DPACheckListXLSFilter(Date start,Date end, String text,Boolean inspectedByMy){
		this.start=start;
		this.end=end;
		this.text=text;
		this.inspectedByMy=inspectedByMy;
	}
	
	public Boolean getInspectedByMy() {
		return inspectedByMy;
	}

	public void setInspectedByMy(Boolean inspectedByMy) {
		this.inspectedByMy = inspectedByMy;
	}

	public String getText() {
		return text;
	}

	public void setText(String text) {
		this.text = text;
	}

	
	public Date getStart() {
		return start;
	}
	public void setStart(Date start) {
		this.start = start;
	}
	public Date getEnd() {
		return end;
	}
	public void setEnd(Date end) {
		this.end = end;
	}

	
	

}
