
<%@page import="communication.administration.dpa.UnconformityTypeDPADataType"%>
<%@page language="java"
	errorPage="../exception.jsp"
	import="java.util.*"
	import="java.util.LinkedList"
	import="business.*"
	import="business.driver.*" 
	import="communication.language.*"
	import="communication.security.*"
	import="communication.util.*"
	import="communication.administration.corporation.tables.*"
	import="communication.administration.corporation.tables.ItemData"
	import="communication.administration.user.tables.*"
	import="communication.driver.tables.*"
	import="communication.event.tables.*"
	import="communication.activity.tables.*"
	import="communication.vehicle.tables.*"
 	import="presentation.translator.web.util.*"
 	import="presentation.translator.web.driver.*"
 	import="communication.util.DateValue"
 %>
 <%! 
	
	SystemAccess sys2; 
	Text messages2;
	DriverData data; 
%>
<%
	sys2 = (SystemAccess)session.getAttribute("SystemAccess");
	messages2 = sys2.getText();
	data = (DriverData)session.getAttribute("driver");
	session.removeAttribute("driver");
	if(data != null){	
%>
<!-- Opciones -->
		<tr>
			<td width="100%" valign="top" colspan="5">
				<jsp:include  page='<%="../component/utilitybox3top.jsp?title="+messages2.getText("generic.messages.options")%>' />
				<table width="100%" class="texts1" border="0" cellpadding="0" cellspacing="0">
<%			boolean line = true;	
			line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
      			<td width="3%" class="texts1"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
      			<td width="46%">
      				<a href="" id="linkpdfscreen" class="texts"> 
	            		PDF 
	            	</a> 
	            </td>
				<%=(line) ? "</tr>" : "" %>
<%			 if(sys2.isBrasilCorporation() && !sys2.isCorporation(new int[]{CorporationData.SYNGENTA,CorporationData.SYNGENTA_BR}) && sys2.getUserSessionData().checkPermission(SecurityConstants.MODIFY_DRIVER)){
				line = !line;
%>			    <%=(!line) ? "<tr>" : "" %>							
					<td width="3%" class="texts1"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
					<td width="46%">
						<a href='layout.jsp?refer=driver/DriverLogisticForm.jsp?driverId=<%=data.getId()%>' class="texts"> 
							<%=messages2.getText("generic.messages.driverlogistic")%> 
						</a> 
					</td>
				<%=(line) ? "</tr>" : "" %>
<%			} 		
			if((sys2.getUserSessionData().checkPermission(SecurityConstants.MODIFY_DRIVER) 
				|| (sys2.getUserSessionData().isDriver() && data.getCountryName().equals(CountryData.ARGENTINA)) 	
				|| (sys2.getUserSessionData().isDriver() && sys2.getCorporationId() == CorporationData.BAYER)) && !sys2.isForestalUnified()) {
				line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
          			<td width="3%" class="texts1"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
          			<td width="46%"><a href="javascript:document.forms['edit'].submit()" class="texts"> 
		            	<%=messages2.getText("generic.messages.edit")%> </a> 
		            </td>
		            
					<%=(line) ? "</tr>" : "" %>							
<%				line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
          			<td width="2%"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12"></td>
          			<td width="49%">
          				<a href="javascript:document.forms['cancel'].submit()" class="texts">
          					<%=messages2.getText("generic.messages.cancel")%>
          				</a>
          			</td>
					<%=(line) ? "</tr>" : "" %>							
<%			}else { 
				line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
					<td width="3%"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12"></td>
					<td width="46%">
						<a href="javascript:document.forms['cancel'].submit()" class="texts">
							<%=messages2.getText("generic.messages.cancel")%>
						</a>
					</td>
					<%=(line) ? "</tr>" : "" %>							
<%			}
			if(data.getExclusionDate() != null) {
			    if(sys2.getUserSessionData().checkPermission(SecurityConstants.MODIFY_DRIVER)) {	
					line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
          			<td width="3%"  class="texts1"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
          			<td ><a href="javascript:setAction(document.forms['exclusion'],'include');deleteIFConfirm(document.forms['exclusion'],'<%=messages2.getText("generic.driver.driverdata.confirminclude")%>');" class="texts")> 
            			<%=messages2.getText("generic.driver.include")%> </a> 
            		</td>
					<%=(line) ? "</tr>" : "" %>							
<%            		if(sys2.getUserSessionData().checkPermission(SecurityConstants.DELETE_DRIVER) && !sys2.isForestalUnified()) {	
						line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
         			<td width="3%" class="texts1"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
          			<td>
          				<a href="javascript:setAction(document.forms['exclusion'],'delete');deleteIFConfirm(document.forms['exclusion'],'<%=messages2.getText("generic.driver.driverdata.confirmdelete")%>');" class="texts"> 
            				<%=messages2.getText("generic.messages.delete")%> 
            			</a> 
            		</td>
					<%=(line) ? "</tr>" : "" %>							
<%					} 
				}
			}else {
				// Si exclusiondate is null:
				
			    if(sys2.getUserSessionData().checkPermission(SecurityConstants.MODIFY_DRIVER)) {	
				line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
          			<td width="3%"  class="texts1"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
          			<td>
          				<a href="javascript:setAction(document.forms['exclusion'],'exclude');deleteIFConfirm(document.forms['exclusion'],'<%=messages2.getText("generic.driver.driverdata.confirmexclude")%>');" class="texts"> 
			            	<%=messages2.getText("generic.driver.exclude")%> 
			            </a> 
			       </td>			       			     
					<%=(line) ? "</tr>" : "" %>							
<%				}
			    
			    // Si es Forestal y tiene permiso de: Modificacion o Tests
			    if(sys2.getUserSessionData().isForest() &&
			    		(sys2.getUserSessionData().checkPermission(SecurityConstants.MODIFY_DRIVER)
			    	     || sys2.getUserSessionData().checkPermission(SecurityConstants.TESTS_DRIVER)) && !sys2.isForestalUnified()) {
					line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
		  			<td width="2%"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12"></td>
          			<td width="49%">
          				<a href='./layout.jsp?refer=driver/aptitudTest.jsp?id=<%=String.valueOf(data.getId())%>' class="texts">
          					<%=messages2.getText("driver.modify.aptitudtest")%>
          				</a>
          			</td>
					<%=(line) ? "</tr>" : "" %>							
<%				}
				if(sys2.getUserSessionData().checkPermission(SecurityConstants.DELETE_DRIVER) && !sys2.isForestalUnified()) {	
					line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
         			<td width="3%" class="texts1"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
          			<td>
          				<a href="javascript:setAction(document.forms['exclusion'],'delete');deleteIFConfirm(document.forms['exclusion'],'<%=messages2.getText("generic.driver.driverdata.confirmdelete")%>');" class="texts"> 
            				<%=messages2.getText("generic.messages.delete")%> 
            			</a> 
            		</td>
					<%=(line) ? "</tr>" : "" %>							
<%				}

				// Si es Forestal y tiene permiso de: Modificacion o Tests
				if(sys2.getUserSessionData().isForest() && !sys2.isCorporation(CorporationData.FORESTALES) &&
						(sys2.getUserSessionData().checkPermission(SecurityConstants.MODIFY_DRIVER) || sys2.getUserSessionData().checkPermission(SecurityConstants.TESTS_DRIVER))) {
					line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
		  				<td width="2%"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12"></td>
          				<td width="49%">
          					<a href='./layout.jsp?refer=driver/alcoholControl.jsp?id=<%=String.valueOf(data.getId())%>' class="texts">
          						<%=messages2.getText("driver.modify.alcoholcontrol")%>
          					</a>
          				</td>
					<%=(line) ? "</tr>" : "" %>							
<%				}else if(sys2.isCorporation(new int[] {CorporationData.MONSANTO,CorporationData.ANGLO,CorporationData.DPA}) && sys2.getUserSessionData().checkPermission(SecurityConstants.MODIFY_DRIVER)) {
					line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
		  				<td width="2%"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
	       				<td width="49%">
							<a href='./layout.jsp?refer=travel/SelectVehicleAddControlTelematic.jsp?id=<%=String.valueOf(data.getId())%>' class="texts">
								<%=messages2.getText("driver.modify.telematiccontrol")%>
							</a>            			
						</td>
					<%=(line) ? "</tr>" : "" %>	
<% 					if(sys2.isCorporation(new int[] {CorporationData.DPA})){
 						line = !line;
	%>					<%=(!line) ? "<tr>" : "" %>							
			  				<td width="2%"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
		       				<td width="49%">
								<a href="javascript:document.location.href='layout.jsp?refer=/dpa/DPAUnconformityForm.jsp?driverId=<%=data.getId()%>&mode=new&type=<%=UnconformityTypeDPADataType.TYPE_DRIVER%>&href=/driver/DriverView.jsp?id=<%=data.getId()%>';" class="texts">
									<%=messages2.getText("generic.dpa.unconformity.title")%>
								</a>            			
							</td>
						<%=(line) ? "</tr>" : "" %>	

						
						
<% 					}%>					
												
<%				}
				if(sys2.isCorporation(new int[] {CorporationData.ANGLO}) && sys2.getUserSessionData().checkPermission(SecurityConstants.MODIFY_DRIVER)) {
					line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
		  				<td width="2%"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
						 <td width="49%">
							<a href='./layout.jsp?refer=travel/SelectVehicleAddControlTelematic.jsp?id=<%=String.valueOf(data.getId())%>' class="texts">
								<%=messages2.getText("driver.modify.telematiccontrol")%>
							</a>            			
						</td>
					<%=(line) ? "</tr>" : "" %>							
<%				}
			}
			if(sys2.getCorporationId() == CorporationData.TRANSPORTES_AMERICAN) {
				line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
     				<td width="3%" class="texts1"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
      				<td>
						<a href='./layout.jsp?refer=driver/unconformities.jsp?id=<%=String.valueOf(data.getId())%>' class="texts"><%=messages2.getText("generic.driver.unconformities")%></a>            			
					</td>
					<%=(line) ? "</tr>" : "" %>							
<%			}else {
					// Si es Forestal y tiene permiso de: Modificacion o Tests
				if(sys2.getUserSessionData().isForest()  && !sys2.isCorporation(CorporationData.FORESTALES) && 
			    		(sys2.getUserSessionData().checkPermission(SecurityConstants.MODIFY_DRIVER)
						|| sys2.getUserSessionData().checkPermission(SecurityConstants.TESTS_DRIVER))) {
					line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
         				<td width="3%" class="texts1"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
          				<td>
							<a href='./layout.jsp?refer=driver/driverPrizes.jsp?id=<%=String.valueOf(data.getId())%>' class="texts"><%=messages2.getText("driver.modify.prizes")%></a>            			
						</td>
					<%=(line) ? "</tr>" : "" %>							
<%					if(sys2.getCorporationId() == CorporationData.FORESTALORIENTAL) {
						line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
		  				<td width="2%"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12"></td>
						<td width="49%"><a href='./layout.jsp?refer=driver/addProvisionalBTW.jsp?id=<%=String.valueOf(data.getId())%>' class="texts"><%=messages2.getText("driver.modify.addprovisionalbtw")%></a></td>
					<%=(line) ? "</tr>" : "" %>							
<%					}	
%>					</tr>
<%				}
			}
			if(sys2.getUserSessionData().checkPermission(SecurityConstants.MODIFY_DRIVER) && !sys2.isForestalUnified()) {
				line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
         				<td width="3%" class="texts1"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
          				<td>
							<a href="javascript:document.forms['unificate'].submit()" class="texts"><%=messages2.getText("driver.unificate")%></a>            			
						</td>	  	
					<%=(line) ? "</tr>" : "" %>							
<% 			}
			if(sys2.getUserSessionData().checkPermission(SecurityConstants.MODIFY_DRIVER) && !sys2.isForestalUnified() && data.isTemporal()) {
				line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
         				<td width="3%" class="texts1"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
          				<td>
							<a href="javascript:changeTemporal()" class="texts"><%=messages2.getText("driver.temporal.change")%></a>            			
						</td>	  	
					<%=(line) ? "</tr>" : "" %>							
<% 			}
			if(sys2.isCorporation(CorporationData.JJ)) {
				line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
         				<td width="3%" class="texts1"><img align="middle" border="0" src="./util/imgs/icon2.gif" width="12">&nbsp;</td>
          				<td>
<% 				if(data.getIdDallas()!=null && data.getIdDallas().toLowerCase().startsWith("driver.hrd.type")) {
%>							<a href="javascript:document.forms['hrd'].submit();" class="texts"><%=messages2.getText("driver.hrd.out")%></a>            			
<% 				}else {
%>							<a href="javascript:document.forms['hrd'].submit();" class="texts"><%=messages2.getText("driver.hrd.in")%></a>            			
<%				}
%>						</td>	  	
					<%=(line) ? "</tr>" : "" %>							
<% 			}
%>				</table>
				<jsp:include page="../component/utilitybox3bottom.jsp"/>
			</td>
		</tr>
		<tr>
			<jsp:include  page="../component/spaceline.jsp" />
  		</tr>
<%		}
%>  		
