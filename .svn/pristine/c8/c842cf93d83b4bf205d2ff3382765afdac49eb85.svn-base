    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,finecreate,drivercreatefine"
     * @param data
     * @throws Exception
     */
    public void fineCreate(FineDataType data,UserSessionData userSessionData) throws Exception {
    	fineCreate(data,userSessionData,false);
    }
    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,finecreate,drivercreatefine"
     * @param data
     * @throws Exception
     */
    public void fineCreate(FineDataType data,UserSessionData userSessionData,boolean withDriverData) throws Exception {
    
        if(userSessionData.isDriver()) {
            if(!data.getDriver().getId().equals(userSessionData.getDriverData().getId())) {
                throw new InvalidDataException("fineCreate","Invalid driver");
            }
        }
        EventABM eventABM=null;
        try{
            data.setStatus(new Integer(EventDataType.SUPERVISED));//cambiar el type por supervision
            eventABM=EventABMUtil.getHome().create();
            Integer id = eventABM.createFine(data,userSessionData,withDriverData);
            data.setId(id);
            if(userSessionData.isPointCorporation())
            	CorporationABMFacadeUtil.getHome().create().addFine(data, userSessionData);
        } catch (Exception e) {
        	Object[] parameters = new Object[1];
        	parameters[0] = data;
            handler.handleException("fineCreate",e,userSessionData,parameters);
        }
    }

    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,eventdelete"
     */
    public void deleteEvent(Collection events,UserSessionData userSessionData,String comment) throws Exception {
              
        EventABM eventABM=null;
        try{
            eventABM=EventABMUtil.getHome().create();
            Iterator it = events.iterator();
            while(it.hasNext()) {
            	Integer eventId = new Integer((String)it.next());
                eventABM.deleteEvent(eventId,userSessionData,comment);
                if(userSessionData.isPointCorporation()) {
                	CorporationABMFacadeUtil.getHome().create().removeEvent(eventId, userSessionData);
                }
            }            
        } catch (Exception e) {
        	Object[] parameters = new Object[2];
        	parameters[0]  = events;
        	parameters[1] = comment;
            handler.handleException("deleteEvent",e,userSessionData,parameters);
        }
    }

    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,eventsupervise,eventupdate,drivereventupdate"
     * @param data
     * @throws Exception
     */
    public void eventUpdate(EventDataType data,int type,UserSessionData userSessionData,String comment) throws Exception {
    
        Integer oldStatus = data.getStatus();
        if(userSessionData.isDriver()) {
            if(!data.getDriver().getId().equals(userSessionData.getDriverData().getId())) {
                throw new InvalidDataException("fineCreate","Invalid driver");
            }
            if(data.getStatus().intValue() != EventDataType.PENDING_SUPERVISION) {
                throw new DeslogedException("eventUpdate","Invalid action");
            }
        }else {
            data.setStatus(new Integer(type));
        }
        
        EventABM eventABM=null;
        try{
            eventABM=EventABMUtil.getHome().create();
            eventABM.updateEvent(data,userSessionData,comment);
            if(userSessionData.isPointCorporation() && oldStatus.equals(EventDataType.PENDING_SUPERVISION) && (type == EventDataType.SUPERVISED || type == EventDataType.PENDING_RECOMENDATION)) {
            	CorporationABMFacade corporationABM = CorporationABMFacadeUtil.getHome().create();
            	corporationABM.addEvent(data, userSessionData);
            } else if(userSessionData.isPointCorporation() && oldStatus.intValue() == type) {
            	CorporationABMFacadeUtil.getHome().create().updateEvent(data, userSessionData);
            }
        } catch (Exception e) {
        	Object[] parameters = new Object[3];
        	parameters[0]= data;
        	parameters[1] = type;
        	parameters[2] = comment;
        	                                 
            handler.handleException("eventUpdate",e,userSessionData,parameters);
        }
    }

    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,fineupdate,drivereventupdate"
     * @param data
     * @throws Exception
     */
    public void fineUpdate(FineDataType data,UserSessionData userSessionData) throws Exception {    
              
        if(userSessionData.isDriver()) {
            if(!data.getDriver().getId().equals(userSessionData.getDriverData().getId())) {
                throw new InvalidDataException("fineCreate","Invalid driver");
            }
            if(data.getStatus().intValue() != EventDataType.PENDING_SUPERVISION) {
                throw new DeslogedException("eventUpdate","Invalid action");
            }
        }
        EventABM eventABM=null;
        try{
            eventABM=EventABMUtil.getHome().create();
            eventABM.updateFine(data,userSessionData);
            if(userSessionData.isPointCorporation())
            	CorporationABMFacadeUtil.getHome().create().updateFine(data, userSessionData);
        } catch(Exception e){
        	Object[] parameters = new Object[1];
        	parameters[0]  = data;
            handler.handleException("fineUpdate",e,userSessionData,parameters);
        }
    }

	/**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,eventcreate,drivercreateevent"
	 * @param data
	 * @throws Exception
	 * @return Asigred Primary Key
	 */
	public void travelCreate(TravelDataType data,UserSessionData userSessionData) throws Exception {
	
		if (userSessionData == null) {
            throw new DeslogedException("travelCreate","userSessionData = null");
		}
		if (data == null) {
            throw new InvalidDataException("travelCreate","data = null");
		}
		EventABM eventABM=null;
		try{
            data.setStatus(TravelDataType.PENDING);
			eventABM=EventABMUtil.getHome().create();
			eventABM.createTravel(data,userSessionData);
         } catch (Exception e) {
        	 Object[] parameters = new Object[1];
         	 parameters[0] = data;
             handler.handleException("createTravel",e,userSessionData,parameters);
         }
	}

    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,eventdelete"
     */
    public void deleteTravel(Collection travels,UserSessionData userSessionData) throws Exception {
        if (userSessionData == null) {
            throw new DeslogedException("deleteEvent","userSessionData = null");
        }
        if (travels == null || travels.size() == 0) {
            throw new InvalidDataException("deletetravels","travels = null");
        }        
        EventABM eventABM=null;
        try{
            eventABM=EventABMUtil.getHome().create();
            Iterator it = travels.iterator();
            while(it.hasNext()) {
                eventABM.deleteTravel(new Integer((String)it.next()),userSessionData);
            }            
        } catch (Exception e) {
        	Object[] parameters = new Object[1];
        	parameters[0]  = travels;
            handler.handleException("deleteTravel",e,userSessionData,parameters);
        }
    }

    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,eventsupervise,eventupdate,drivereventupdate"
     * @param data
     * @throws Exception
     */
    public void updateTravel(TravelDataType data,UserSessionData userSessionData) throws Exception {
    
        if (userSessionData == null) {
            throw new DeslogedException("updateTravel","userSessionData = null");
        }
        if (data == null) {
            throw new InvalidDataException("updateTravel","data = null");
        }        

        try{
        	EventABM eventABM=EventABMUtil.getHome().create();
            eventABM.udpateTravel(data,userSessionData);
        } catch (Exception e) {
        	Object[] parameters = new Object[1];
        	parameters[0]= data;
        	                                 
            handler.handleException("updateTravel",e,userSessionData,parameters);
        }
    }

    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,eventsupervise,eventupdate,drivereventupdate"
     * @param data
     * @throws Exception
     */
    public void updateCheckPoints(TravelDataType data, Collection list, UserSessionData userSessionData) throws Exception {
    
        if (userSessionData == null) {
            throw new DeslogedException("updateCheckPoints","userSessionData = null");
        }
        if (data == null) {
            throw new InvalidDataException("updateCheckPoints","data = null");
        }        

        try{
        	EventABM eventABM=EventABMUtil.getHome().create();
            eventABM.udpateTravelConfirmation(data,userSessionData);
            
            Iterator it = list.iterator();
            while(it.hasNext()) {
            	CheckPointData checkPoint = (CheckPointData)it.next();
            	if(checkPoint.getId() == null) {
            		eventABM.createCheckPoint(checkPoint, data.getId(), userSessionData);
            	}else {
            		eventABM.updateCheckPoint(checkPoint, userSessionData);
            	}
            }
        } catch (Exception e) {
        	Object[] parameters = new Object[1];
        	parameters[0]= data;
        	                                 
            handler.handleException("updateCheckPoints",e,userSessionData,parameters);
        }
    }

    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,eventsupervise,eventupdate,drivereventupdate"
     * @param data
     * @throws Exception
     */
    public void closeTravel(TravelDataType data, UserSessionData userSessionData) throws Exception {
    
        if (userSessionData == null) {
            throw new DeslogedException("closeTravel","userSessionData = null");
        }
        if (data == null) {
            throw new InvalidDataException("closeTravel","data = null");
        }        

        try{
        	EventABM eventABM=EventABMUtil.getHome().create();
       		data.setStatus(TravelDataType.FINALIZED);
            eventABM.closeTravel(data,userSessionData);
            
        } catch (Exception e) {
        	Object[] parameters = new Object[1];
        	parameters[0]= data;
        	                                 
            handler.handleException("closeTravel",e,userSessionData,parameters);
        }
    }

