	/**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required" 
     * @ejb.permission role-name = "administrator,eventcreate,drivercreateevent"
	 * @param data
	 * @throws Exception
	 * @return Asigred Primary Key
	 */
	public Integer eventCreate(EventDataType data,UserSessionData userSessionData,String comment,boolean withDriverData) throws Exception {
			
        if(userSessionData.isDriver()) {
            if(!data.getDriver().getId().equals(userSessionData.getDriverData().getId())) {
                throw new InvalidDataException("eventCreate","Invalid driver");
            }
        }
        
		EventABM eventABM = null;
        Integer key = null;
		try{
            data.setStatus(new Integer(EventDataType.PENDING_SUPERVISION));
			eventABM=EventABMUtil.getHome().create();
			key = eventABM.createEvent(data,userSessionData,comment,withDriverData);
	        /*if(userSessionData.getCorporationId() == CorporationData.MONSANTO && data.getCountryId().equals(CountryData.BRASIL_ID) && SecurityConstants.isProductionServer()) {
	        	sendMonsantoEventEmail(data, userSessionData);
	        }*/
         } catch (Exception e) {
        	 Object[] parameters = new Object[2];
         	 parameters[0] = data;
         	 parameters[1] = comment;
             handler.handleException("eventCreate",e,userSessionData,parameters);
         }
         return key;
	}


    private void sendMonsantoEventEmail(EventDataType eventData, UserSessionData userSessionData) {
    	try {
	    	DriverMainAttributes driver = DriverReportUtil.getHome().create().findDriverMainData(eventData.getDriver().getId(), userSessionData);
	    	
	    	String plate = eventData.getPlate();
	    	if(eventData.getVehicle() != null) {
	    		Collection<Integer> vehicles = new LinkedList<Integer>();
	    		vehicles.add(eventData.getVehicle().getId());
	    		Collection plates = VehicleReportUtil.getHome().create().getPlates(vehicles,userSessionData);
	    		if(plates.size() > 0) {
	    			plate = (String)plates.iterator().next();
	    		}
	    	}
	    	MailSender sender = new MailSender();
	
	    	Collection to = new LinkedList();
			to.add("antonio.ferreira@tfleet.com.br"); 
			to.add("sinistro@tfleet.com.br"); 
			//to.add("marcos.k.arruda@monsanto.com"); 
			to.add("monsanto@tfleet.com.br"); 
			to.add("marianna.ferraz@tfleet.com.br"); 
			to.add("monsantobr@cepadc.com");
			
			//to.add("jrodriguez@cepadc.com");
	    	Collection bcc = new LinkedList();
	    	bcc.add("eventos.monsanto.br@gmail.com");

	    	String subject = "Novo evento ingresado";
			
			String body = "<body>"+
							"<p><span style='font-family:\"Lucida Grande\", \"Lucida Sans Unicode\",Tahoma, sans-serif';font-size:1.75em;color: #666666;'>Prezado (a),</span></p>"+
							"<p><span style='font-family:\"Lucida Grande\", \"Lucida Sans Unicode\",Tahoma, sans-serif';font-size:1.15em;color: #666666;'>Acaba de ser ingressado um novo evento no CEPA Data Center. Segue informações:</span></p>"+
							"<p>"+
							"<span style='font-family:\"Lucida Grande\", \"Lucida Sans Unicode\",Tahoma, sans-serif';font-size:1.15em;color: #666666;'>"+
							"Data: "+Util.formatDate(eventData.getDate())+"<br>"+
							"Nome Condutor: "+driver.getFirstName()+" "+driver.getLastName()+"<br>"+
							"Placa Veículo:"+plate+"<br>"+
							"Relato:"+eventData.getStory()+
							"</span>"+
							"</p>"+
							"<p>"+
							"<span style='font-family:\"Lucida Grande\", \"Lucida Sans Unicode\",Tahoma, sans-serif';font-size:1.15em;color: #666666;'>"+
							"Para mais informações entre em contato através do e-mail: <a href=\"mailto:monsantobr@cepadc.com\">monsantobr@cepadc.com</a>"+
							"</span>"+
							"</p>"+
							"<p>"+
							"<span style='font-family:\"Lucida Grande\", \"Lucida Sans Unicode\",Tahoma, sans-serif';font-size:1.75em;color: #666666;'>"+
							"Atenciosamente,"+
							"</span>"+
							"</p>"+
							"<p>"+
							"<span style='font-family:\"Lucida Grande\", \"Lucida Sans Unicode\",Tahoma, sans-serif';font-size:1.75em;color: #666666;'>"+
							"Equipe Data Center"+
							"</span>"+
							"</p>"+
							"</body>";
			
			boolean sended = false;
			int count = 0;
			while(!sended && count < 10) {
				try {
			    	String[] mailAddress = DataTypeReportUtil.getHome().create().getAvailableAddress(CorporationData.REPORTER_JJ, userSessionData); 
					String mailServer = AlertConstants.MAILSERVER; 
					if (mailAddress[0] != null && mailAddress[0].contains("cepainternational.com")){
						mailServer = AlertConstants.MAILSERVER2;
					}else if (mailAddress[0] != null && mailAddress[0].contains("cepalogistica.com")){
						mailServer = AlertConstants.MAILSERVER_INMOTION;
					}
					sended = sender.sendImage(to, 
							mailServer,
							"CEPA DataCenter", 
							mailAddress[0],
							mailAddress[1], 
							subject, Util.toHTMLString(body), new LinkedList<String>(),new LinkedList<String>(),"monsantobr@cepadc.com","CEPA DataCenter",bcc,null);
				}catch (Exception e) {
					e.printStackTrace();
				}
				count++;
			}
    	}catch (Exception e) {
    		e.printStackTrace();
    	}
	}

