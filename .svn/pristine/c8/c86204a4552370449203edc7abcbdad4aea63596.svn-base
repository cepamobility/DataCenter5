public class AccidentClasificationLevel2DataType extends GeneralDTData implements Serializable {
	
    private static final long serialVersionUID = 1L;
    protected boolean active;

    private String parent;

	public AccidentClasificationLevel2DataType(String resourceKey, String parent){
		super(resourceKey);
		this.parent=parent;
	}
	
	public AccidentClasificationLevel2DataType(String resourceKey){
		super(resourceKey);
		
	}

	

    public String getParent() {
		return parent;
	}



	public void setParent(String parent) {
		this.parent = parent;
	}



	public boolean isActive() {
        return active;       
    }


    public void setActive(boolean active) {
        this.active = active;
    }
    
}
