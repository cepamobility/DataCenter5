<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.util.tables" >
    <class name="AppFile" table="appfiles">		
        <id	column="id"	name="id"	type="java.lang.Integer">
            <generator class="sequence">
            	<param name="sequence">File_Sequence</param>
            </generator>
        </id>
        <property	name="title" type="java.lang.String" column="title"/>    	
        <property	name="subtitle" type="java.lang.String" column="subtitle"/>    	
        <property	name="description" type="text" column="description"/>    	
        <property	name="category" type="java.lang.Integer" column="category"/>    	
        <property	name="doctype" type="java.lang.Integer" column="doctype"/>    	
        <property	name="documenturl" type="text" column="documenturl"/>    	
        <property	name="documentname" type="text" column="documentname"/>    	
        <property	name="imageurl" type="text" column="imageurl"/>    	
        <property	name="imagename" type="text" column="imagename"/>    	

        <property	name="corporation" type="java.lang.Integer" column="corporation"/>    	
        <property	name="fileorder" type="java.lang.Integer" column="fileorder"/>    	
        <property	name="lng" type="java.lang.String" column="language"/>
	</class>
</hibernate-mapping>


