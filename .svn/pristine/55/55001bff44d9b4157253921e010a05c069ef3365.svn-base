							</tr>
				      		<tr>
								<jsp:include  page="../component/spaceline.jsp" />
			      			</tr>
			      			<tr>
				    			<td valign="top">
									<table width="100%" border="0" cellpadding="0" cellspacing="0">
										<jsp:include page='<%="/util/divgeo"+sys.getUserSessionData().getFilter().getGeoLevelCount()+".jsp?form=LicenseExpiryForm&consult=true"%>' />
									</table>
								</td>
							</tr>
							
							
						</table>
					</td>
    				<td width="2%">&nbsp;</td>
    				<td width="49%" valign="top">
						<table width="100%" border="0" cellpadding="0" cellspacing="0">
							<jsp:include page='<%="/util/divorg.jsp?form=TelematicControlQueryForm&consult=true" %>'/>
						</table>
					</td>
  				</tr>
				<!--  Datos de los controles telematicos -->
	      		<tr>
					<jsp:include  page="../component/spaceline.jsp" />
      			</tr>
				<tr>
					<td colspan="3">
						<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("generic.driver.telematiccontroldata")%>' />
						<table width="100%" border="0" cellpadding="0" cellspacing="0">
							
							<!-- Opcion Colores -->
							<tr class="linetwo" >
								<th align="left" colspan="2">
									<html:radio property="colorOrType" value="color" onclick="javascript:changeColorOrType('color')">
										<%=messages.getText("driver.telematiccontrol.bycolor")%>
									</html:radio>
								</th>	
								<td>&nbsp;</td>									
							</tr>
			      			<tr class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
							<tr class='linetwo' id='colorTable' style='<%= (colorOrType.equalsIgnoreCase("color")) ? "display:block":"display:none" %>' >
								<td>&nbsp;&nbsp;&nbsp;</td>
								<td width="90%" >
									<table width="100%" border="0" cellpadding="0" cellspacing="0"  >
										<tr class="linetwo" >
											<th align="left" class="specialarea" >
												<%=messages.getText("driver.telematiccontrol.color")%>
											</th>
											<td align="right" >
									        	<html:select property="color" styleClass="input" value='<%=(form == null) ? "red" : String.valueOf(form.getColor())%>'>
									        		<html:options collection="color" property="value" labelProperty="label"/>
									        	</html:select>
						          			</td>
										</tr>  
										<tr class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
									</table>
								</td>
							</tr>
			      			<tr class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
							<!-- Opcion Tipo de Eventos -->
							<tr class="linetwo" >
								<th align="left" colspan="2">
								<html:radio property="colorOrType" value="type" onclick="javascript:changeColorOrType('type')">
									<%=messages.getText("driver.telematiccontrol.byeventtype")%>
								</html:radio>
								</th>
								<td>&nbsp;</td>
							</tr>
							<tr class='linetwo' id='eventTypeTable'
								style='<%= (colorOrType.equalsIgnoreCase("type")) ? "display:block":"display:none" %>' >
								<td>&nbsp;&nbsp;&nbsp;</td>
								<td width="90%" >
									<table width="100%" border="0" cellpadding="0" cellspacing="0" >
										<tr class="linetwo" >
											<th align="left" class="specialarea" >
												<%=messages.getText("driver.telematic.type")%>
											</th>
											<td align="right" >
									        	<html:select property="type" styleClass="input" value='<%=(form == null) ? "0" : String.valueOf(form.getType())%>'>
									        		<html:option value="0"><%=messages.getText("generic.messages.select")%></html:option>
									        		
									        		<html:option value="7"><%=messages.getText("driver.telematiccontrol.excessivespeed")%></html:option>
									        		
									        		<html:option value="1"><%=messages.getText("driver.telematiccontrol.hardstart")%></html:option>
									        		<html:option value="2"><%=messages.getText("driver.telematiccontrol.hardstop")%></html:option>
									        		<html:option value="3"><%=messages.getText("driver.telematiccontrol.excesiverotation")%></html:option>
									        		<html:option value="4"><%=messages.getText("driver.telematiccontrol.baddirection")%></html:option>
									        		<html:option value="5"><%=messages.getText("driver.telematiccontrol.operational")%></html:option>
									        		<html:option value="6"><%=messages.getText("driver.telematiccontrol.rain")%></html:option>
								    	    	</html:select>
						          			</td>
										</tr>  
										<tr class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
			      						<tr class="linetwo">
											<th align="left" class="specialarea" >
												<%=messages.getText("driver.telematic.recomendation")%>
											</th>
											<td align="right">
