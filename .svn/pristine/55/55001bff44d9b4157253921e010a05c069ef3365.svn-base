								    	    		<html:option value="1"><%=messages.getText("driver.telematiccontrol.ipg")%></html:option>
								    	    		<html:option value="2"><%=messages.getText("driver.telematiccontrol.dct")%></html:option>
								    	    		<html:option value="3"><%=messages.getText("driver.telematiccontrol.dcc")%></html:option>
								    	    		<html:option value="4"><%=messages.getText("driver.telematiccontrol.atsv")%></html:option>
								        		</html:select>
						          			</td>
										</tr>  
									</table>
								</td>
							</tr>
