package communication.fleet;

import java.util.ArrayList;
import java.util.Collection;

import communication.administration.corporation.tables.PointMoveData;
import communication.report.UnconformityAction;
import communication.vehicle.tables.VehicleStatusData;


public class FleetStatusData  {

	private ArrayList<UnconformityAction> unconformities;
    private Collection<PointMoveData> moves;
    private Collection<VehicleStatusData> suspendedVehicles;
    
    
	public ArrayList<UnconformityAction> getUnconformities() {
		return unconformities;
	}
	public void setUnconformities(ArrayList<UnconformityAction> unconformities) {
		this.unconformities = unconformities;
	}
	public Collection<PointMoveData> getMoves() {
		return moves;
	}
	public void setMoves(Collection<PointMoveData> moves) {
		this.moves = moves;
	}
	public Collection<VehicleStatusData> getSuspendedVehicles() {
		return suspendedVehicles;
	}
	public void setSuspendedVehicles(Collection<VehicleStatusData> suspendedVehicles) {
		this.suspendedVehicles = suspendedVehicles;
	}
	 
    
  
}
