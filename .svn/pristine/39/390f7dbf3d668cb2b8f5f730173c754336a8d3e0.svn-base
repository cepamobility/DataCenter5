package communication.datatype.tables;

import java.io.Serializable;
import java.util.Collection;

/**
 * @author fcarriquiry
 *
 * TODO To change the template for this generated type comment go to
 * Window - Preferences - Java - Code Style - Code Templates
 */
public class DamageSchemaDataType extends GeneralDTData implements Serializable {
	
    private static final long serialVersionUID = 1L;

    private Collection damageSchemaDataTypeValues;
	
	public DamageSchemaDataType(String resourceKey, Collection damageSchemaValues) {
		super(resourceKey);
		this.damageSchemaDataTypeValues=damageSchemaValues;
	}
	
	public Collection getDamageSchemaDataTypeValues() {
		return damageSchemaDataTypeValues;
	}
}
