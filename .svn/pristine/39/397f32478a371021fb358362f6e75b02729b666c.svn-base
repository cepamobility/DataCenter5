          <td width="572">
		  <table width="100%" cellpadding="3" cellspacing="0" class="texts" align='center'>			
<% 
				item = null;
				String message = "";
				String nameAux = "";
				// Ordeno los paises Alfabeticamente:
				iter = sys.getUserSessionData().getFilter().getLastLevelItems(sys.getUserSessionData().getFilter().getGeoLevelCount(),null,null);							
				while(iter.hasNext())
				{
    					 item=(GeoItemData)iter.next();  
    					 message = messages.getText(item.getName());
    					 nameAux = item.getName();

    					 // Caso especial LAN:
    					 if (item.getName().equals("datatype.country.mx") ||
    						item.getName().equals("datatype.country.co") ||
    						item.getName().equals("datatype.country.ec") ||
    						item.getName().equals("datatype.country.gt") ||
    						item.getName().equals("datatype.country.ve") ||
    						item.getName().equals("datatype.country.pe") ||
    						item.getName().equals("datatype.country.hn")
    						){
    						 nameAux = "datatype.country.lan";
    						 message = messages.getText(nameAux);
    						 
    					 }
    					 
    					 OptionItem oi = new OptionItem(message,nameAux);    					 
    					 if (!sortCountries.contains(oi)){   					 
	    					 sortCountries.add(oi);
    					 }
    			}
				
    			Collections.sort(sortCountries);
    			if (!sortCountries.isEmpty())
    			{
    				// Muestro los paises ordenados:
	    			iter = sortCountries.iterator();
    				boolean par = true;
	    			while(iter.hasNext()){
    					 OptionItem oi = (OptionItem)iter.next();
    					 name = oi.getLabel();
						 if (oi.getValue().equals("datatype.country.lan")){
	    					 countryCode = oi.getValue().substring(oi.getValue().length()-3);    					 
						 }else{
	    					 countryCode = oi.getValue().substring(oi.getValue().length()-2);    					 
						 }
						 par = !par;
%>				
            <tr>       
              <td align='center' class='<%=(par)?"lineone":"linetwo"%>' >
              <%
              	String href1 = "layout.jsp?refer=/reports/ReportCountry.jsp?country="+countryCode+"&add="+Boolean.toString(canAddReport);
              %>
	       		<a href='<%=href1 %>' > 
              		<%=name%>
              	</a>
               </td>
            </tr>
             <% 
   					 }
   				}else{%>
   	        <tr>       
              <td align='center'>	       		
              		<%=messages.getText("generic.supportmaterial.reports.noreports")%>             
               </td>
            </tr>
    				
<% 				}%>
        </table></td>
          <td width="19" background="../datacenter/util/imgs/right_line.gif">&nbsp;</td>
