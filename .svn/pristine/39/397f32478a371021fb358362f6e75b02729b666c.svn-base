<%	
	SystemAccess sys = (SystemAccess)session.getAttribute("SystemAccess");
	Text messages = sys.getText();
	UserSessionData userSessionData;
	DataTypeAccess datatypes;
	GeoItemData item;
	String check;
	Iterator iter;
	LinkedList sortCountries = new LinkedList();
	String name="";
	String countryCode = "";
	String addReportPermission;
	boolean canAddReport = false;
	
	sys = (SystemAccess)session.getAttribute("SystemAccess");
	userSessionData = sys.getUserSessionData();
	
	//	Me fijo si tiene permisos para agregar reportes
	addReportPermission = Util.checkPermission(sys,SecurityConstants.ADD_REPORT);
	if (addReportPermission == null) {
		// Si tiene permiso para agregar reportes y viene con la opcion de agregar
		// le dejo agregar reportes
		String add = (String)request.getParameter("add");
		//System.out.println("Reports.jsp: add="+add);
		canAddReport = new Boolean(add.trim()).booleanValue();
		//System.out.println("Reports.jsp: canAddReport="+canAddReport);
	}		
	
	// J&J:
	if (sys.getUserSessionData().getFilter().getCorporationId().equals(new Integer(4)))
	{
		// Si es johnson me fijo que tenga permisos
		check = Util.checkPermission(sys,SecurityConstants.VIEW_REPORT_JOHNSON);		
		if(check != null) {
			response.sendRedirect(request.getContextPath()+check);
		}else{
			// J&J
%>
			<jsp:include  page='<%="ReportCountry.jsp?add="+Boolean.toString(canAddReport)%>' />        	
<% // 
		}
	// CEPA:
	}else if (sys.getUserSessionData().getFilter().getCorporationId().equals(new Integer(3))){
		// Si es johnson me fijo que tenga permisos
		check = Util.checkPermission(sys,SecurityConstants.VIEW_REPORT);		
		if(check != null) {
			response.sendRedirect(request.getContextPath()+check);
		}else{
			// cepa
%>
			<jsp:include  page='<%="ReportCountry.jsp?add="+Boolean.toString(canAddReport)%>' />        	
<% // 
		}
	// Monsanto
	}else if (sys.getUserSessionData().getFilter().getCorporationId().equals(new Integer(1))){
		// Si es monsanto me fijo si tengo permiso para ver reportes.
		check = Util.checkPermission(sys,SecurityConstants.VIEW_REPORT);	
	
		if(check != null) {
			response.sendRedirect(request.getContextPath()+check);
		}else{
				
			 
%>

