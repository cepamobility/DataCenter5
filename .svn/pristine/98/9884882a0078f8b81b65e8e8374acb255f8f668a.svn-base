	public static String getViewLink(CEPAActivityScheduleRegistryData  activity, String driver, SystemAccess sys) {
		String id = String.valueOf(activity.getActivity().getActivityId());
		if(activity != null && activity.getActivity() != null  && activity.getActivity().getState() != null && !activity.getActivity().getState().getResourceBundleId().equals(ActivityStateDataType.DICTADA)) {
			return "layout.jsp?refer=/activity/schedule/CEPAActivityScheduleView.jsp?id="+id;
		} else {
			String activityType = activity.getActivity().getType().getResourceBundleId();
			if(activity != null && activity.getActivity() != null && activity.getActivity().getIsOld() && !activityType.equals(COMMENTARYDRIVEOTHER)) {
				return "ActivityReportOld.do?idDriver="+driver+"&output=HTML&idActivity="+id;
			}else if (!activity.getActivity().getIsOld() && (activityType.equals(COMMENTARYDRIVEOTHER) || !activity.getActivity().getDefinition().isHaveIndividualReport())){
				String value = "layout.jsp?refer=/activity/schedule/AddCEPAActivityScheduleRegistry.jsp?idDriver="+driver+"&idActivity="+id+"&enabled=false&page=/driver/DriverView.jsp";
				if(sys.getUserSessionData().isGerente()) {
					if (activityType.equalsIgnoreCase(CEPA_SYSTEM_COURSE_1_LIVIANOS)) {
						value = "layout.jsp?refer=/activity/schedule/cdsView.jsp?idDriver="+ driver+"&idActivity="+id+"&check=40";
					} else if (activityType.equalsIgnoreCase(CEPA_SYSTEM_COURSE_1_PESADOS)
									|| activityType.equalsIgnoreCase(RECERTIFICACION_CEPA_SYSTEM)) {
						value = "layout.jsp?refer=/activity/schedule/cdsView.jsp?idDriver="+ driver+"&idActivity="+ id+"&check=35";
					} else if (activityType.equalsIgnoreCase(CEPA_SYSTEM_COURSE_2_ENTRENADORES) || 
							activityType.equalsIgnoreCase(CEPA_SYSTEM_COURSE_2_CEPA)) {
						value = "layout.jsp?refer=/activity/schedule/cdsView.jsp?idDriver="+ driver+"&idActivity="+ id+"&check=36";
					} else if (activityType.equalsIgnoreCase(CEPA_SYSTEM__LIVIANOS_PESADOS)) {
						value = "layout.jsp?refer=/activity/schedule/cdsView.jsp?idDriver="+ driver+"&idActivity="+ id+"&check=94";
					} 
				}
				if(activityType.equalsIgnoreCase(BTW_PROVISIONAL)){
					value = "ActivityProvisionalBTW.do?idDriver="+ driver+"&date="+Util.formatDate(activity.getActivity().getDate())+"&result="+activity.getNote();
				}
				return value;
			}else if(activityType.equals(COMMENTARYDRIVEARGENTINA)) {
				return "layout.jsp?refer=/activity/schedule/CommentaryDriveArgentinaView.jsp?idDriver="+driver+"&idActivity="+id+"&enabled=false";
			}else if (activityType.equals(COMMENTARYDRIVE_NOVARTIS)) { 
				return "layout.jsp?refer=/activity/schedule/cdNovartisView.jsp?idDriver="+driver+"&idActivity="+id+"&enabled=false";
			}else if (activityType.equals(COMMENTARYDRIVE_JJ2)) { 
				return "layout.jsp?refer=/activity/schedule/cdJJ2View.jsp?idDriver="+driver+"&idActivity="+id+"&enabled=false";
			}else if (activityType.equals(COMMENTARYDRIVE_RENOVATION)
					|| activity.getActivity().getType().getResourceBundleId().equals(INITIAL_FOREIGN_EVALUATION)) { 
				return "layout.jsp?refer=/activity/schedule/RenovationJJView.jsp?idDriver="+driver+"&idActivity="+id+"&enabled=false";
			}else if(activity.getActivity().hasNewReports()){ 
				return "ActivityReportVersion2.do?driver="+driver+"&type=1&activity="+id;
			}else{ 
				return "ActivityReportNew.do?idDriver="+driver+"&output=HTML&idActivity="+id;
			} 
		}
	}
	/**
	 * 
	 * @param definition
	 * @param idDriver
	 * @param idActivity
	 * @param enabled
	 * @param isEdit
	 * @param back
	 * @return
	 */
	public static String getPageToRedirect(
			CEPAActivityDefinitionData definition, String idDriver,
			String idActivity, String enabled, boolean isEdit, String back) {
		String activityType = definition.getResourceKeyName().trim();

		if (activityType.equals(COMMENTARYDRIVE) 
				|| activityType.equals(COMMENTARYDRIVE_INSTRUCTORES)
				|| activityType.equals(COMMENTARYDRIVEOTHER) 
				|| activityType.equals(COMMENTARYDRIVEOTHERSPECIAL)
				) {
			// commentarydrive para Monsanto y demas Corporaciones

			if (!isEdit) {
				return "CommentaryDriveForm.jsp?idDriver=" + idDriver
						+ "&enabled=" + enabled + "&idActivity=" + idActivity;
			} else {
				return "CommentaryDriveForm.jsp?idDriver=" + idDriver
						+ "&idActivity=" + idActivity + "&enabled=" + enabled
						+ "&page=" + back;
			}

		} else if (activityType.equals(BTW1) 
				|| activityType.equals(BTW4x4)
				|| activityType.equals(EBTW_PISTA)
				|| activityType.equals(BTW1_PRACTICO)) {
			// Si es BTW1 o BTW4x4:

			if (!isEdit) {
				return "btw1.jsp?idDriver=" + idDriver + "&idActivity="
						+ idActivity;
			} else {
				return "btw1Edit.jsp?idDriver=" + idDriver + "&idActivity="
						+ idActivity;
			}

		} else if (activityType.equals(BTW2) || activityType.equals(BTW3_ABBOTT_ANDES) || activityType.equals(BTW24x4)) {

			// Si es BTW2 o BTW2 4x4
			if (!isEdit) {
				return "btw2.jsp?idDriver=" + idDriver + "&idActivity="
						+ idActivity;
			} else {
				return "btw2Edit.jsp?idDriver=" + idDriver + "&idActivity="
						+ idActivity;
			}

		} else if (activityType.equals(EBTW)){

			// Si es ebtw
			if (!isEdit) {
				return "ebtw.jsp?idDriver=" + idDriver + "&idActivity="
				+ idActivity;
			} else {
				return "ebtw.jsp?idDriver=" + idDriver + "&idActivity="
				+ idActivity;
			}

		} else if (activityType.equals(BTW1) || activityType.equals(BTW4x4)) {

		} else if (activityType.equals(TRANINGONTHEJOB)
				|| activityType.equals(MINITRANINGONTHEJOB)
				|| activityType.equals(TDS)
				|| activityType.equals(BTW3_PRACTICO)
		) {

			// Traning on the job
			return "TranningOnTheJobForm.jsp?idDriver=" + idDriver
					+ "&idActivity=" + idActivity + "&columns=" + 3;

		} else if (activityType.equals(HRD)) {

			// HRD
			return "TranningOnTheJobForm.jsp?idDriver=" + idDriver
					+ "&idActivity=" + idActivity + "&columns=" + 3;

		} else if (activityType.equals(SPECIALDAYOFTRAINING) 
				|| activityType.equals(BTWUTILITARIOREBOQUE)
				|| activityType.equals(REBOQUE)) {

			// Jornada especial de entrenamiento
			return "TranningOnTheJobForm.jsp?idDriver=" + idDriver
					+ "&idActivity=" + idActivity + "&columns=" + 3;

		} else if (activityType.equals(EVALUACIONENCABINA) 
				|| activityType.equals(EVALUACIONINICIALCEPA)
				|| activityType.equals(EVALUACIONPLANAUTOCEPA)) {
//			return "EvaluacionCabinaForm.jsp?idDriver=" + idDriver + "&idActivity=" + idActivity + "&columns=" + 3;
			return "TranningOnTheJobForm.jsp?idDriver=" + idDriver + "&idActivity=" + idActivity + "&columns=" + 3;
		} else if (activityType.equals(ENTRENAMIENTOENCABINA2)
				|| activityType.equals(ENTRENAMIENTOENCABINA4)
				|| activityType.equals(ENTRENAMIENTOENCABINA8)
				|| activityType.equals(BTW2ONBOARD)
				|| activityType.equals(BTW2ONBOARD_V2)
				|| activityType.equals(BTW3_LIVIANOS_VIA_PUBLICA)) {

			// Evaluacion en cabina
			return "TranningOnTheJobForm.jsp?idDriver=" + idDriver
					+ "&idActivity=" + idActivity + "&columns=" + 3;

		} else if (activityType.equals(INDUCTIONTRAINING2)) {

			// Induction Training
			return "TranningOnTheJobForm.jsp?idDriver=" + idDriver
					+ "&idActivity=" + idActivity + "&columns=" + 3;

		} else if (activityType.equals(BTWONBOARD) || activityType.equals(BTWONBOARD_V2)) {

			// BTW On Board
			return "TranningOnTheJobForm.jsp?idDriver=" + idDriver
					+ "&idActivity=" + idActivity + "&columns=" + 3;

		} else if (activityType.equals(BTW3) || activityType.equals(BTW3UPDATE)
				|| activityType.equals(BTW3RENOVACION) || activityType.equals(BITREN) 
				|| activityType.equals(BITREN_UPDATE) || activityType.equals(PICKUP_REMOLQUE) || activityType.equals(BUS_HEAVY)) {

			// BTW3
			return "btw3Form.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity + "&columns=" + 3;

		} else if (activityType.equals(BTWTHAILAND)) {

			// BTW Thailand
			if (!isEdit) {
				return "BtwThailand.jsp?idDriver=" + idDriver + "&idActivity="
						+ idActivity + "&columns=" + 3 + "&enabled=" + enabled;
			} else {
				return "BtwThailand.jsp?idDriver=" + idDriver + "&idActivity="
						+ idActivity + "&columns=" + 3 + "&enabled=" + enabled
						+ "&page=" + back;
			}

		} else if (activityType.equals(HIDRO)) {

			// Hidroquímicos
			return "GenericForm.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity;

		} else if (activityType.equals(MONITORS)
				|| activityType.equals(MULTIPLICADOR_CEPA)) {

			// Monitores
			return "Monitors1.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity + "&columns=" + 1;

		} else if (activityType.equals(MONITORS2) ||
				(activityType.equals(MONITORS2_REFRESHMENT))) {

			// Monitores2
			return "MonitorsForm.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity + "&columns=" + 1;

		} else if (activityType.equals(EVALUACIONENCABINAPESADO)
				|| activityType.equals(CURSOPESADOS)
				|| activityType.equals(BTWPESADOSCONEVALUACIONENCABINA)) {

			// Si es Evaluacion en Cabina para Vehiculos Pesados:
			if (!isEdit) {
				return "CabinEvaluationHeavy.jsp?idDriver=" + idDriver
						+ "&idActivity=" + idActivity + "&columns=" + 1
						+ "&enabled=" + enabled;
			} else {
				return "CabinEvaluationHeavy.jsp?idDriver=" + idDriver
						+ "&idActivity=" + idActivity + "&columns=" + 1
						+ "&enabled=" + enabled + "&page=" + back;
			}

		} else if (activityType.equals(PRINCIPIANTE)
				|| activityType.equals(PRINCIPIANTE_REFRESH)
				|| activityType.equals(AVANZADO)) {

			// Escuela de Conduccion CEPA:
			// Formulario Principiante, Refrshement y Avanzado
			if (!isEdit) {
				return "SchoolForm.jsp?idDriver=" + idDriver + "&idActivity="
						+ idActivity + "&enabled=" + enabled;
			} else {
				return "SchoolForm.jsp?idDriver=" + idDriver + "&idActivity="
						+ idActivity + "&enabled=" + enabled + "&page=" + back;
			}

		} else if (activityType.equals(PREVENTIVO_PESADOS_2)
				|| activityType.equals(PREVENTIVO_PESADOS_4)
				|| activityType.equals(PREVENTIVO_PESADOS_8)
				|| activityType.equals(PREVENTIVO_LIVIANOS_TEORIA)
				|| activityType.equals(PREVENTIVO_MEDIANOS_TEORIA)
				||activityType.equals(PREVENTIVO_PESADOS_TEORIA)
				|| activityType.equals(PREVENTIVO_LIVIANOS_2)
				|| activityType.equals(PREVENTIVO_LIVIANOS_4)
				|| activityType.equals(PREVENTIVO_LIVIANOS_8)) {

			// Cursos: Programa Preventivo Pesados, Programa Preventivo Livianos
			return "CursoPreventivo.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity;

		} else if (activityType.equals(HEAVY1_2)
				|| activityType.equals(HEAVY3_4)
				|| activityType.equals(ADVANCED_DRIVING)
				|| activityType.equals(ELEVATORS)
				|| activityType.equals(PERSONAL_SECURITY)
				|| activityType.equals(MOTORCYCLE)
				|| activityType.equals(ACTIVITY_4X4)
				|| activityType.equals(FIRST_AID)				
				) {

			// CEPA: Otros cursos de CEPA:
			return "GenericForm.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity;

		} else if (activityType.equals(CURSO_DE_TERCEROS_COMBATE_DE_INCENDIOS) 
				|| activityType.equals(CURSO_DE_TERCEROS_PRIMEROS_AUXILIOS)){
			
			// Cursos de Terceros no dictados por CEPA: 
			return "GenericForm.jsp?idDriver=" + idDriver + "&idActivity="
			+ idActivity;

			
		} else if (activityType.equals(COMMENTARYDRIVEARGENTINA)) {

			// Curso: Commentary Drive Monsanto Argentina
			return "CommentaryDriveArgentinaForm.jsp?idDriver=" + idDriver
					+ "&enabled=" + enabled + "&idActivity=" + idActivity;

		} else if (activityType.equals(COMMENTARYDRIVEARGENTINA_NUEVO)) {

			// Curso: Commentary Drive Monsanto Argentina
			return "CDArgentinaForm.jsp?idDriver=" + idDriver
					+ "&enabled=" + enabled + "&idActivity=" + idActivity;

		} else if (activityType.equals(COMMENTARYDRIVE_NOVARTIS)) {

			if(!isEdit) {
				return "cdNovartisForm.jsp?idDriver=" + idDriver + "&enabled=" + enabled + "&idActivity=" + idActivity;
			}else {
				return "cdNovartisView.jsp?idDriver=" + idDriver + "&enabled=" + enabled + "&idActivity=" + idActivity;
			}

		} else if (activityType.equals(COMMENTARYDRIVE_JJ2)) {
			if(!isEdit) {
				return "cdJJ2Form.jsp?idDriver=" + idDriver + "&enabled=" + enabled + "&idActivity=" + idActivity;
			}else {
				return "cdJJ2View.jsp?idDriver=" + idDriver + "&enabled=" + enabled + "&idActivity=" + idActivity;
			}

		} else if (activityType.equals(COMMENTARYDRIVENALCO)) {
			if(!isEdit) {
				// Curso: Commentary Drive Argentina
				return "CommentaryDriveNalcoForm.jsp?idDriver=" + idDriver + "&enabled=" + enabled + "&idActivity=" + idActivity;
			}else {
				return "CommentaryDriveNalcoView.jsp?idDriver=" + idDriver + "&enabled=" + enabled + "&idActivity=" + idActivity;
			}

		} else if (activityType.equals(COMMENTARYDRIVEHIGHRISK)) {

			// Cursos: CommentaryDriverRisk
			return "CommentaryDriveRiskForm.jsp?idDriver=" + idDriver
					+ "&enabled=" + enabled + "&idActivity=" + idActivity;

		} else if (activityType.equals(INDUCTION_TRAINING)
				|| activityType.equals(DEMO_DIGI_CAM)
				|| activityType.equals(CHARLA_SENSIBILIZACION)
				|| activityType.equals(SOCIALIZACION_STANDARD_SEGURIDAD)				
				|| activityType.equals(SECURITY_TALK_KIDS)
				|| activityType.equals(SECURITY_TALK_PMF)
				|| activityType.equals(SECURITY_TALK)) {

			// Cursos: Induction Training, Demo Digi Cam, Security Talk
			return "simpleForm.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity;

		} else if (activityType.equals(ASSESSMENT) || activityType.equals(ELEARNINGPACK)) {

			// Cursos: Induction Training, Demo Digi Cam, Security Talk
			return "resultForm.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity;
		} else if (activityType.equals(UTV)
				|| activityType.equals(POST_ACCIDENT_TALK)) {
			return "GenericForm.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity;

		} else if (activityType.equals(RADAR)) {
			return "radar.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity;

		} else if (activityType.equals(COMMENTARYDRIVECAYACO)) {
			return "cdCayaco.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity;

		} else if (activityType.equalsIgnoreCase(TEORICO_8_HORAS_LIVIANOS)
				|| activityType.equalsIgnoreCase(TEORICO_8_HORAS_PESADOS)) {

			// Teòrico 8 horas pesados y livianos:
			return "GenericForm.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity;
		} else if (activityType.equalsIgnoreCase(CEPA_SYSTEM_COURSE_1_LIVIANOS)) {
			return "cds.jsp?check=40&idDriver=" + idDriver + "&idActivity="
					+ idActivity;
		} else if (activityType.equalsIgnoreCase(CEPA_SYSTEM__LIVIANOS_PESADOS)) {
			return "cds.jsp?check=94&idDriver=" + idDriver + "&idActivity=" + idActivity;
		} else if (activityType.equalsIgnoreCase(CEPA_SYSTEM_COURSE_1_PESADOS) 
				|| activityType.equalsIgnoreCase(RECERTIFICACION_CEPA_SYSTEM)) {

			return "cds.jsp?check=35&idDriver=" + idDriver + "&idActivity="
					+ idActivity;
		} else if (activityType.equalsIgnoreCase(CEPA_SYSTEM_COURSE_2_ENTRENADORES) || 
				activityType.equalsIgnoreCase(CEPA_SYSTEM_COURSE_2_CEPA)) {
			
			return "cds.jsp?check=36&idDriver=" + idDriver + "&idActivity="
					+ idActivity;

		} else if (activityType.equals(DANGEROUS_MATERIALS)
				|| activityType.equals(DANGEROUS_MATERIALS_RENEWAL)) {

			// Mercancias Peligrosas y Mercancias Peligrosas Renovación.
			return "DangerousMaterials.jsp?idDriver=" + idDriver + "&idActivity=" + idActivity;
			
			// return "GenericForm.jsp?idDriver=" + idDriver + "&idActivity="
			//		+ idActivity;

		} else if (activityType.equals(EBTW_TEORICO)){
			// eBTW solo Teorico
				return "GenericForm.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity;
		}else if (activityType.equals(PARKING_AND_BACKING)){

			// Parcking and Backing
			return "GenericForm.jsp?idDriver=" + idDriver + "&idActivity=" + idActivity;
		
		}else if (activityType.equalsIgnoreCase(BTW1_NEW_FORM_TABLET)
				|| activityType.equalsIgnoreCase(BTW3_VIA_PUBLICA_TABLET)
				|| activityType.equalsIgnoreCase(BTWPLUS1_TABLET)
				|| activityType.equalsIgnoreCase(TRAINING_ON_THE_JOB_TABLET)
				|| activityType.equalsIgnoreCase(TRAINING_ON_THE_JOB_4X4_TABLET)
				|| activityType.equalsIgnoreCase(SPECIALDAYOFTRAINING_TABLET)
				|| activityType.equalsIgnoreCase(BTW1ONBOARD_TABLET)
				|| activityType.equalsIgnoreCase(BTWPLUS1ONBOARD_TABLET)
				|| activityType.equalsIgnoreCase(TRANSIT_BEHAVIOUR_TABLET)
				|| activityType.equalsIgnoreCase(BTW2ONBOARD_TABLET)
				|| activityType.equalsIgnoreCase(BTWPLUS2ONBOARD_TABLET)
				|| activityType.equalsIgnoreCase(BTW1_PESADOS_ONBOARD_TABLET)
				|| activityType.equalsIgnoreCase(PHRD_TABLET)
				|| activityType.equalsIgnoreCase(BTW1_ECONOMIC_TABLET)
				|| activityType.equalsIgnoreCase(SAFE_DRIVE_TABLET)
				|| activityType.equalsIgnoreCase(TOJ_ECONOMIC_TABLET)
				|| activityType.equalsIgnoreCase(BTW4X4_ONBOARD_TABLET)
				|| activityType.equalsIgnoreCase(BTW2REFRESHONBOARD_TABLET)
				|| activityType.equalsIgnoreCase(EBTW_PISTA_TABLET)
				|| activityType.equalsIgnoreCase(EVALUACION_EN_CABINA_TABLET)){
			// TABLETS> uruguay calle F
			// Nuevo formulario de BTW1
			return "Btw1NewForm.jsp?idDriver=" + idDriver + "&idActivity=" + idActivity;
  	  
		}else if (activityType.equalsIgnoreCase(BTW2_NEW_FORM_TABLET) 
				|| activityType.equalsIgnoreCase(BTW2UPM) 
				|| activityType.equalsIgnoreCase(BTWPLUS2_TABLET)){
			// TABLETS>
			// Nuevo formulario de BTW1
			return "Btw2NewForm.jsp?idDriver=" + idDriver + "&idActivity=" + idActivity;
  	  
		
		} else if (activityType.equals(PREVENTIVO_LIVIANOS_PRACTICO)
				|| activityType.equals(PREVENTIVO_LIVIANOS_TEORICOPRACTICO)
				|| activityType.equals(PREVENTIVO_MEDIANOS_PRACTICO)
				|| activityType.equals(PREVENTIVO_PESADOS_PRACTICO)
				|| activityType.equals(PREVENTIVO_PESADOS_TEORICOPRACTICO)) {

			// Evaluacion en cabina
			return "TranningOnTheJobForm.jsp?idDriver=" + idDriver
					+ "&idActivity=" + idActivity + "&columns=" + 3;
			
		}else if (activityType.equals(COPILOT)){
			
			return "GenericForm.jsp?idDriver=" + idDriver + "&idActivity="
					+ idActivity;
		} else if (activityType.equals(COMMENTARYDRIVE_RENOVATION) || activityType.equals(INITIAL_FOREIGN_EVALUATION)) { //pablo

			   if(!isEdit) {
			    return "RenovationJJForm.jsp?idDriver=" + idDriver + "&enabled=" + enabled + "&idActivity=" + idActivity;
			   }else {
			    return "RenovationJJView.jsp?idDriver=" + idDriver + "&enabled=" + enabled + "&idActivity=" + idActivity;
			   }
		} else if (activityType.equals(REPORTERJJ_COMMENTARYDRIVE)) { //pablo
		    return "cd.jsp?idDriver=" + idDriver + "&idActivity=" + idActivity;
		} else {
		
			// Otros cursos no definidos:
			return "GenericForm.jsp?idDriver=" + idDriver + "&idActivity=" + idActivity;
		}
		// return null;
		return null;
	}

	public static boolean isForestalCommonActivity(String activity) {
		if(activity == null) {
			return false;
		}
		return activity.equals("datatype.scheduledactivitytype.btw3-renovacion") || 
		activity.equals("datatype.scheduledactivitytype.btw3-3ra-renovacion") ||
		activity.equals("datatype.scheduledactivitytype.btw3-2nda-renovacion") || 
		activity.equals("datatype.scheduledactivitytype.btwonboard2") || 
		activity.equals("datatype.scheduledactivitytype.btw2onboard2") || 
		activity.equals("datatype.scheduledactivitytype.btw2onboard") || 
		activity.equals("tablet.form.btw1.livianos") || 
		activity.equals("tablet.form.btw1onboard") || 
		activity.equals("datatype.scheduledactivitytype.btw1") || 
		activity.equals("tablet.form.btw2.livianos") || 
		activity.equals("tablet.form.btw2upm") || 
		activity.equals("datatype.scheduledactivitytype.btw2") || 
		activity.equals("datatype.scheduledactivitytype.btw3") || 
		activity.equals(DANGEROUS_MATERIALS) ||
		activity.equals("datatype.scheduledactivitytype.btw3update") || 
		activity.equals("datatype.scheduledactivitytype.bitren") || 
		activity.equals("datatype.scheduledactivitytype.bitren.update") || 
		activity.equals("datatype.scheduledactivitytype.ebtw") || 
		activity.equals("datatype.scheduledactivitytype.evaluacionencabina") || 
		activity.equals("tablet.form.evaluacionencabina") || 
		activity.equals("datatype.scheduledactivitytype.evaluacionencabinapesado") || 
		activity.equals("datatype.scheduledactivitytype.gabinetepsicotecnico") || 
		activity.equals("datatype.scheduledactivitytype.busheavy") || 
		activity.equals(CEPAActivityConstants.TRANINGONTHEJOB_PESADOS) ||
		activity.equals(CEPAActivityConstants.BTW3CUARTARENOVACION) ||
		activity.equals(CEPAActivityConstants.CLEAT) ||
		activity.equals(CEPAActivityConstants.BTW3_VIA_PUBLICA_TABLET) ||
		activity.equals("datatype.scheduledactivitytype.pesados1"); 
	}
}
