<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.vehicle.tables">
       <class name="VehicleState" table="vehiclestate">
        
	        <id	column="id"	name="id"	type="java.lang.Integer">
	            <generator class="native" />
	        </id>
	        <many-to-one name="vehicle" class="Vehicle" not-null="true"/>
	        
	        <property	name="state"	type="java.lang.String"		column="state"	not-null="true" />        
	        <property	name="stateDate"	type="java.sql.Timestamp"		column="stateDate"	not-null="true" />   
	        <property	name="hours"	type="java.lang.Integer"		column="hours"	not-null="true" />  
	        <property	name="reasonDescription"	type="java.lang.String"		column="reasonDescription"	not-null="true" />  
	        <property	name="reasonCode"	type="java.lang.Integer"		column="reasonCode"	not-null="true" />  
	        <property	name="typeOfPenalty"	type="java.lang.Integer"		column="typeOfPenalty"	not-null="true" />  

	    	<set name="history" cascade="all">
				<key column="vehicleState" not-null="true"/>
				<one-to-many class="VehicleStateHistory"/>
			</set>
    	</class>
</hibernate-mapping>
