<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">


<hibernate-mapping package="persistence.driver.tables">
	<class name="DriverUnconformity" table="driverunconformities">
		
        <id	column="id"	name="id"	type="java.lang.Integer">
            <generator class="sequence">
            	<param name="sequence">Unconformity_Sequence</param>
            </generator>
        </id>

        <property		name="date"	type="java.util.Date"		column="date"		not-null="true" />
        <many-to-one 	name="driver" class="persistence.driver.tables.Driver"	column="driver"/>
        <many-to-one 	name="type" class="persistence.datatype.tables.UnconformityType"	column="type"/>
        <property		name="observations"		type="java.lang.String"		column="observations"	 />
		
  	</class>
</hibernate-mapping>
