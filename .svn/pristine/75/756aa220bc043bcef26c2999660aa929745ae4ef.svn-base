package presentation.translator.web.vehicle;

import java.util.Calendar;
import java.util.Collection;

import org.apache.struts.action.ActionForm;

import communication.language.Text;
import communication.vehicle.tables.VehicleCheckData;
import communication.vehicle.tables.VehicleData;

/**
 * @author fperez
 */
public class CheckFormAlert extends ActionForm {

    private static final long serialVersionUID = 1L;
	
    private Integer vehiclecheck;
    private String truckdatelist;
    private String trailersdatelist;
    private String vehicleplate;
    private String emaillist; 
    private Collection trailerschecks;
    private Collection trailersplates;
    
    public CheckFormAlert() {
    }
    
    
    public Integer getVehiclecheck() {
        return vehiclecheck;
    }
    public void setVehiclecheck(Integer vehiclecheck) {
        this.vehiclecheck = vehiclecheck;
    }
    
    public Collection getTrailerschecks() {
        return trailerschecks;
    }
    public void setTrailerschecks(Collection trailerschecks) {
        this.trailerschecks = trailerschecks;
    }
    
    public String getVehicleplate() {
        return vehicleplate;
    }
    public void setVehicleplate(String vehicleplate) {
        this.vehicleplate = vehicleplate;
    }
    
    public Collection getTrailersplates() {
        return trailersplates;
    }
    public void setTrailersplates(Collection trailersplates) {
        this.trailersplates = trailersplates;
    }
    
    public String getTruckdatelist() {
        return truckdatelist;
    }


    public void setTruckdatelist(String truckdatelist) {
        this.truckdatelist = truckdatelist;
    }
    
    public String getTrailersdatelist() {
        return trailersdatelist;
    }


    public void setTrailersdatelist(String trailersdatelist) {
        this.trailersdatelist = trailersdatelist;
    }
    
    public String getEmaillist() {
        return emaillist;
    }


    public void setEmaillist(String emaillist) {
        this.emaillist = emaillist;
    }
    
    

    }
   

    
