package communication.activity.report;

import java.io.Serializable;
import java.util.ArrayList;

/**
 * @author gbenaderet
 *
 */
public class ActivityReportDataType implements Serializable {

	private ArrayList pointComment;
	private ArrayList pointItem;
	
	/**
	 * 
	 */
	public ActivityReportDataType() {
		pointComment = new ArrayList();
		pointItem = new ArrayList();
	}

	/**
	 * @param pointComment
	 * @param pointItem
	 */
	public ActivityReportDataType(ArrayList pointComment, ArrayList pointItem) {
		this.pointComment = pointComment;
		this.pointItem = pointItem;
	}

	/**
	 * @return Returns the pointComment.
	 */
	public ArrayList getPointComment() {
		return pointComment;
	}

	/**
	 * @param pointComment The pointComment to set.
	 */
	public void setPointComment(ArrayList pointComment) {
		this.pointComment = pointComment;
	}

	/**
	 * @return Returns the pointItem.
	 */
	public ArrayList getPointItem() {
		return pointItem;
	}

	/**
	 * @param pointItem The pointItem to set.
	 */
	public void setPointItem(ArrayList pointItem) {
		this.pointItem = pointItem;
	}
	
	
	
	
	
}
