package communication.administration.dpa;

import java.util.Date;
import java.util.HashSet;
import java.util.Set;

public class CorrectiveActionDPAData {
	private Integer id;
	
	private Date date;
	
	private String comment;
	
	private UnconformityDPAData unconformityDPAData;
	
	private Set<UnconformityItemDPAData> items;
	
	private Set<CorrectiveActionImageDPAData> images;
	
	public CorrectiveActionDPAData(){
		items=new HashSet<UnconformityItemDPAData>();
		images=new HashSet<CorrectiveActionImageDPAData>();
	}

	public Integer getId() {
		return id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public Date getDate() {
		return date;
	}

	public void setDate(Date date) {
		this.date = date;
	}

	public String getComment() {
		return comment;
	}

	public void setComment(String comment) {
		this.comment = comment;
	}

	public Set<UnconformityItemDPAData> getItems() {
		return items;
	}

	public void setItems(Set<UnconformityItemDPAData> items) {
		this.items = items;
	}

	public Set<CorrectiveActionImageDPAData> getImages() {
		return images;
	}

	public void setImages(Set<CorrectiveActionImageDPAData> images) {
		this.images = images;
	}

	public UnconformityDPAData getUnconformityDPAData() {
		return unconformityDPAData;
	}

	public void setUnconformityDPAData(UnconformityDPAData unconformityDPAData) {
		this.unconformityDPAData = unconformityDPAData;
	}
	
	

}
