<!-- Btw1NewForm.jsp  -->

<%!
	RequestDispatcher dispatcher; 
	boolean esMonsanto;
	String context;String pathView; String pathMsg; 
	String pathSearch;
	String pathLanguage; Text messages; SystemAccess sys;
	Integer pageNum; boolean all; int pageSize; 
	String attribute; String value;
	UserSessionData userSessionData; 
	ActivityReportFacade activityReport;
	String str1, str2, str3,col, idActivity, idDriver;
	CEPAActivityScheduleData  activityData;
	
	String enabled, url = "";
	int columns;
	DriverData driver;
	CEPAActivityScheduleRegistryData registryData;
%>
<%
	sys = (SystemAccess)session.getAttribute("SystemAccess");
	userSessionData=sys.getUserSessionData();	
	String check = Util.checkPermission(sys,SecurityConstants.CREATE_CEPASCHEDULEACTIVITYREGISTRY);	
	String check1 = Util.checkPermission(sys,SecurityConstants.CREATE_CD_ACTIVITY);		
	
	if ((check!=null) && (check1!=null)) 
	{
		response.sendRedirect(request.getContextPath()+check);
	}
	else 
	{
		messages=sys.getText();
		pathLanguage="/util/jsp/language.jsp";	
		dispatcher=request.getRequestDispatcher(pathLanguage);
		dispatcher.include(request,response);
	
		context=request.getContextPath();
		pathMsg="/util/jsp/message.jsp";
	
			
		dispatcher=request.getRequestDispatcher(pathMsg);
		dispatcher.include(request,response);

		idActivity =(String)request.getParameter("idActivity");
		if(Util.empty(idActivity)){
			idActivity=(String)session.getAttribute("id");			
		}
		// session.setAttribute("id",idActivity); 
		System.out.println("idActivity "+idActivity);
		
		idDriver = (String)request.getParameter("idDriver");
		
		if (!Util.empty(idDriver)){
			driver = sys.getDriverReportFacade().findDriverByPrimaryKey(Integer.valueOf(idDriver),sys.getUserSessionData());
		}
		System.out.println("idDriver "+idDriver);
		
		// session.setAttribute("url","activity/schedule/CEPAActivityScheduleView.jsp");
		url = "activity/schedule/CEPAActivityScheduleView.jsp";
		userSessionData.setUrl(url+"?idActivity="+idActivity+"&idDriver="+idDriver);
		
		
		// enabled: formulario editable
		enabled =(String)request.getParameter("enabled");
		if (Util.empty(enabled)){
			enabled="true";
		}else {
			if (enabled.equals("true")) {
				session.setAttribute("from","commentaryAdd");
			}
		}
		
		// Para traer Instructores:
		activityData = sys.getActivityReportFacade().
				findCEPAActivityScheduleByPrimaryKey(new Integer(idActivity),userSessionData); 
	
		
		CEPAActivityScheduleRegistryData registryData =
			(idActivity != null && idDriver != null) ? 
			sys.getActivityReportFacade().getCompleteResult(
				new Integer(idActivity),new Integer(idDriver),sys.getText(),sys.getUserSessionData()) : null;
		session.setAttribute("registryData",registryData);
		
		
%>

<html:html>
<LINK REL=StyleSheet HREF="../../util/css/estilo.css" TYPE="text/css">

<head>
<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">
</head>
<script language="JavaScript" type="text/javascript">

// 17/04/2012
function preparedCheckboxRadioParameters(form){

		var elements=form.elements;
		var length=elements.length;
		var i;
		var valueCheckboxParamList="";
		var obs = "";
		var valuePointObservationList="";
		
		var separator="<";
		for(i=0;i<length;i++){
			var element=elements[i];
			if((element.type.toLowerCase()=="checkbox") || (element.type.toLowerCase()=="radio")) {
				if(element.checked){
					if (element.value.indexOf("-") !== -1){
							// Si encuentro un - es porque es un punto-observacion
							if (valuePointObservationList  == "")
								valuePointObservationList = element.value;
							else
								valuePointObservationList = element.value + "<" + valuePointObservationList;
					}else if (element.value.indexOf("og") !== -1){
							// Observaciones Generales: og
							if (obs == "") obs = element.value;
							else obs = element.value + "<" + obs;
					}else{
							if (valueCheckboxParamList == "")
								// Si no tiene un - es porque es un item:							
								valueCheckboxParamList=element.value;
							else
								// Si no tiene un - es porque es un item:							
								valueCheckboxParamList=element.value+"<"+valueCheckboxParamList;
					}	
				}	
			} 
		
		} // FOR

		form.obsList.value = obs;
		//alert("Obs: "+obs);
		form.checkboxParamList.value = valueCheckboxParamList;
		form.pointCommentList.value = valuePointObservationList;		
		return true;
}

// Action ajustado para el formulario BTW1 Tablets
function setAction(form1,form2){
	if(preparedCheckboxRadioParameters(form1)) {
		form2.checkboxParamList.value = form1.checkboxParamList.value;
		//form2.commentaryDriveOther.value = "";
		form2.note.value = form1.note.value;
		form2.obs.value = form1.obs.value;		
		form2.obsList.value = form1.obsList.value;		
		form2.instructor.value = form1.instructor.value;	
	   	//form2.partner.value = "";	
		//form2.cepaCourse.value = form1.cepaCourse.value;	
		//form2.plate.value = "";	   
		//form2.conductionType.value = "";
		//form2.skidcar.value = "";
		form2.pointCommentList.value = form1.pointCommentList.value;
		form2.idDriver.value = '<%=idDriver%>';
		form2.idActivity.value = '<%=idActivity%>';
		form2.url.value = '<%=url%>';
		form2.submit();
	}
}

// Deshabilita algunos items del form:
// 17/04/2012
function deshabilitar(ids, form){
	var elements = form.elements;
	var length =(elements != undefined)?elements.length:0;
	var i;
	var valueCheckboxParamList="";
	var separator="<";

	var idsArray = ids.split(",");

	if (length > 0){
		for(i=0;i<length;i++){
			var element = elements[i];
			if(element.type.toLowerCase()=="checkbox")  {
	
				element.disabled = ""; // habilito el checkbox
				
				for (j = 0; j < idsArray.length; j++){
					if (element.id == idsArray[j]){
						element.disabled = "disabled"; // deshabilito el checkbox
						element.checked = ""; // saco el check
					}				
				}		
			} // fin if element type checkbox	
		}
	}
}


</script>	

<body>
<div align="center">


  
