    				// no ingresó el odómetro
    				"AND v.id NOT IN (SELECT vehicle FROM odometers WHERE period = 8 AND year = "+year+" AND fleet IN ("+fleetList+"))"+
    				
    				// y no se le envio ya una alerta hoy: 
    				
    				" AND " +
