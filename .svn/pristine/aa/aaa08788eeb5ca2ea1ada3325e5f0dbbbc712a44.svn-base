		            		System.out.println("Password incorrecto "+crypt+" "+data[0]);
		            	}else {
		                    int i = 1;
		                    user = "fleetUser"+String.valueOf(data[3])+"_"+i;
		                    cryptUser = md5.encriptar(user);
		                    found = cryptUser.equals(loginName);
		                    while(!found && i < 10) {
		                    	i++;
		                        user = "fleetUser"+String.valueOf(data[3])+"_"+i;
		                        cryptUser = md5.encriptar(user); 
		                        found = cryptUser.equals(loginName);
		                    }
		            	}
		        		if(found) {		        			
		        			if(!users.containsKey(driverId)) {
		        				String link = "https://" + AlertConstants.DC_DOMAIN + "/datacenter/home.jsp?login="+user;
		        				System.out.println(data[4]+","+data[5]+","+link);
		        				users.put(driverId, user);
		        				
		        				String login = user;
		        				PersonData person = new PersonData((String)data[4],(String)data[5],email,login);
		        				// El login para la url es el user
		        				// y para el identificador del usuario en la base de datos
		        				// hay que hacer md5(user)
		        				person.setIdCorporation((Integer)data[6]);
		        				person.setLink(link);

		        				result.add(person);
		        			}
		            	}
	                }
	    		}
    		}
    	}catch (Exception e) {
        	e.printStackTrace();
		}
    	return result;
    }
	
	
	/**
	 * Alertas de Bayer
	 * Devuelve los conductores activos de Bayer BRASIL !
	 * @param period
	 * @param year
	 * @param divGeos
	 * @param status
	 * @param fleets
	 * @return
	 * @throws Exception
	 */
	public LinkedList<PersonData> getBayerActiveDrivers() throws Exception {
    	
    	LinkedList<PersonData> result = null;
    	int status = 0; // Conductores Activos
    	
    	try {
	         
	    	String sql = "SELECT DISTINCT d.firstname,d.lastname, " +
	    			"c.resourcekey AS country,d.id AS driverId, d.email, " +
	    			"d.corporation as corporation " +
	    			"FROM " +
	    			"drivers AS d, " +
	    			"country AS c ";
	    			
	        sql += " WHERE d.country = c.id AND d.corporation =  "+CorporationData.BAYER + "" +
	        		" AND c.id = "+CountryData.BRASIL_ID.toString()+ " ";	       
	        
	        switch (status) {
	        	case VehicleData.ACTIVE:
	        		sql += " AND d.exclusionDate is null";
	        		break;
	        	case VehicleData.EXCLUDED:
	        		sql += " AND d.exclusionDate is not null";
	        		break;
	        }
	        
	        // Que no se le haya mandado una alerta hoy o NUNCA (null)a este driver:
	        // para no mandar la misma alerta el mismo dia.
	        sql += " AND ( d.alertdate is null OR date_trunc('day',d.alertdate) != date_trunc('day',CURRENT_TIMESTAMP) )";
	               
	        sql += " ORDER BY d.firstname,d.lastname";
	        
	        Session session = HibernateUtil.currentSession();
	        System.out.println("SQL: "+sql);
	        
	        SQLQuery query = session.createSQLQuery(sql);
	        query.addScalar("firstname",Hibernate.STRING); //0
	        query.addScalar("lastname",Hibernate.STRING); //1 
	        query.addScalar("country",Hibernate.STRING); //2
            query.addScalar("driverId",Hibernate.INTEGER); //3
	        query.addScalar("email",Hibernate.STRING);  // 4
	        query.addScalar("corporation",Hibernate.INTEGER); // 5
	       
	        // TODO: Max results 50
	        // query.setMaxResults(300);
            
            List list = query.list();
            if (list != null && list.size() > 0){
            	Iterator it = list.iterator();
            	result = new LinkedList<PersonData>();
            	while (it.hasNext()){
            		Object[] o = (Object[])it.next();
            		String email = (String)o[4]; 
            		if (email != null && email.trim() != ""){ 
            			PersonData person = new PersonData((String)o[0],(String)o[1],(String)o[4]);
            			person.setIdDriver((Integer)o[3]);
            			person.setIdCorporation((Integer)o[5]);
            			result.add(person);
            		}
            	}            	
            }             
    	}catch (Exception e) {
        	e.printStackTrace();
        	throw e;
		}        
    	return result;
    }
	
