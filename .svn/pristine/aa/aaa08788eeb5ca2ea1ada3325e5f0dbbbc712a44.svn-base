	/**
	 * 
	 * @param corporation
	 * @param alertId
	 * 
	 * @return
	 * @throws Exception
	 */
	private  HashSet getTo(int alertId) throws Exception {
		HashSet result = null;
		try {
			Session session = HibernateUtil.currentSession();
			Query query;
			List list = new LinkedList();
			Iterator it;
			String sql  = "SELECT distinct email, corporation, id " +
			" FROM alertto " +
			" where alert = " + alertId;
			
			query = session.createSQLQuery(sql)
				.addScalar("email",Hibernate.STRING)
				.addScalar("corporation",Hibernate.INTEGER)
				.addScalar("id",Hibernate.INTEGER);

			list = query.list();	
			if (list != null && list.size() > 0){
				it = list.iterator(); 
				result = new HashSet();
				while(it.hasNext()) {
					Object[] row = (Object[])it.next(); 
					if (row != null){
						String email = (String) row[0];
						Integer corporation = (Integer) row[1];
						Integer id = (Integer) row[2];
						AlertTo alertTo = new AlertTo(id,corporation,email);
						result.add(alertTo);
					}
				}
			}
		
		} catch (Exception e) {		
			e.printStackTrace();			
		}
		
		return result;
	}

	/**
	 * Actualiza los datos de una alerta.
	 * @param data
	 * @param comment
	 * @param userRequest
	 * @throws Exception
	 */
	public  void updateAlert(AlertData data) throws Exception {
		new LogAction("updateAlert");
		try{
			Session session = HibernateUtil.currentSession();
			Alert alert = (Alert)session.load(Alert.class,data.getAlertId());
			alert.updateAlert(data,session);
			session.update(alert);
		} catch (Exception e) {
			e.printStackTrace();
			throw e;
		}	
	}
	
	
	/**
	 * Borra una alerta.
	 * @param data
	 * @param comment
	 * @throws Exception
	 */
	// @ TransactionAttribute (TransactionAttributeType.REQUIRES_NEW)
	public void deleteAlert(AlertData data) throws Exception {
		
		try{			
			Alert alert = null; 

			Session session = HibernateUtil.currentSession();
			alert = (Alert) session.load(Alert.class, data.getAlertId());

			session.delete(alert); 
			
		}catch(Exception e){
			e.printStackTrace();

		}
		
		
	}
	
	/**
	 * Finaliza una alerta con la fecha actual, a partir de ese momento no corre mas.
	 * @param idAlert
	 * @throws Exception
	 */
	public void finishAlert(Integer idAlert) throws Exception {
		
		AlertData alertData = null;		
		try{	
			Session session = HibernateUtil.currentSession();
			
			String queryStr = " select  alert" +
				       " from Alert as alert " +
				       " where alert.enddate is null and alert.alertId ="+idAlert.intValue();
			
			Query query = session.createQuery(queryStr);
			
			List alertColl = query.list();
		    Iterator iter = alertColl.iterator();
		    Alert alert = null;
		    Date date = new Date();
		    while (iter.hasNext()) {
				alert = (Alert) iter.next();
				alertData = alert.getAlertData();
				alertData.setEnddate(date);
				updateAlert(alertData);
			}
			   
			   
		}catch(Exception e){
			e.printStackTrace();
			
		}
	}

	
	/**
	 * Devuelve una colecciòn de los conductores de "corporationid",
	 * cuya licencia expira en "daysLeft" dias.
	 * @param corporationId
	 * @param daysLeft
	 * @param onlyEquals
	 * @param countryId (si solo quiero un pais sino null)
	 * @return
	 */
	public LinkedList<PersonData> getLicenseExpiryDrivers(
			Integer corporationId, int daysLeft, boolean onlyEquals,
			Integer countryId
		) throws Exception{

		LinkedList<PersonData> result = null;
		Driver driver = null;
		Query query = null;
		
		try{
			Session session = HibernateUtil.currentSession();			
			
			// Date Format:
			String DATE_FORMAT = "yyyy-MM-dd";
			java.text.SimpleDateFormat sdf = new java.text.SimpleDateFormat(DATE_FORMAT);
			
			Calendar c = Calendar.getInstance();
			c.add(Calendar.DATE, daysLeft);
			
			System.out.println("Vencimientos menores a "+sdf.format(c.getTime()));
		
			String queryStr = "select driver from Driver as driver " +
				"where driver.corpCountry.pk.corporation.id = :corporationId and  ";
			
			
			if (!onlyEquals){
				queryStr += " driver.licenseExpiry <=  :daysLeft ";
			}else{
				// Solo igual, por ejemplo = 30, = 7, = -1(ayer) ....
				queryStr += " day(driver.licenseExpiry) = :day and " +
							" month(driver.licenseExpiry) = :month and "+
							" year(driver.licenseExpiry) = :year ";			
			}
			if (countryId != null){
				queryStr += " and driver.corpCountry.pk.country.id = :countryId ";
			}
				
			query = session.createQuery(queryStr);
			
			if (!onlyEquals){
				query.setParameter("daysLeft", c.getTime());
				query.setParameter("corporationId", corporationId);
			}else{
				query.setParameter("day", c.get(Calendar.DATE));
				query.setParameter("month", c.get(Calendar.MONTH) + 1);
				query.setParameter("year", c.get(Calendar.YEAR));
				query.setParameter("corporationId", corporationId);
			}
			if (countryId != null){
				query.setParameter("countryId", countryId);
			}
			
			List list = query.list();
			
			if (list != null && list.size() > 0){
				Iterator iter = list.iterator();
				result = new LinkedList<PersonData>();
				while (iter.hasNext()) {
					driver = (Driver) iter.next();
					PersonData person = new PersonData(driver.getFirstName(),driver.getLastName(),driver.getEmail());
					person.setLicenseExpiry(driver.getLicenseExpiry());
					person.setIdDriver(driver.getId());
					person.setIdCorporation(driver.getCorporation().getId());
					
					if (corporationId == CorporationData.BAYER){
						// si es bayer agrego los datos del supervisor:
						person.setSupervisorName(driver.getPhoneNumber());
						person.setSupervisorEmail(driver.getOfficeAddress());
					}
					
					System.out.println("LicenceExpiry:"+sdf.format(driver.getLicenseExpiry()));
					result.add(person);
					// Log:
					System.out.println("Agrego el driver para las Alertas: "+driver.getFirstName()+" "+driver.getLastName());
				}
				
				System.out.println("Cantidad de Emails a enviar:"+result.size());
			}			
			
		}catch(Exception e){
			e.printStackTrace();
			throw e;
		}	
		return result;
	}
	
	
	/**
	 * Obtiene los Drivers (de CIMSA u otra empresa) que no esten excluidos
	 * que tengan menos o igual puntos que maxPoints.
	 * 
	 * @param maxPoints
	 * @return
	 */
	public LinkedList<PersonData> getDriversWithPointsLessOrEquals(int maxPoints, Integer corporationId){
		LinkedList<PersonData> result = null;
    	try {
    		
    		// Conductores No excluidos de CIMSA 
    		Session session = HibernateUtil.currentSession();
    		
       		Query query = session.createSQLQuery(
       				"SELECT d.firstname as firstname, d.lastname as lastname, d.email as email, " +
       				"d.id as iddriver, d.points as driverpoints, " +
       				"sum(ge.points) as eventpoints, d.points - sum(ge.points) as finalpoints," +
       				"d.corporation as corporation "+
       				"FROM genericevents ge "+ 
       				"inner join drivers d on d.id = ge.driver and ge.corporation = d.corporation "+
       				"WHERE d.corporation = " + corporationId.toString() +" and d.exclusiondate is null  "+
       				"group by d.id, d.points,d.firstname, d.lastname, d.email, d.corporation "+
       				"having d.points - sum(ge.points) < " + String.valueOf(maxPoints)
       				)
       				.addScalar("firstname", Hibernate.STRING)
       				.addScalar("lastname",Hibernate.STRING)
       				.addScalar("email",Hibernate.STRING)
       				.addScalar("iddriver",Hibernate.INTEGER)
       				.addScalar("driverpoints",Hibernate.INTEGER)
       				.addScalar("eventpoints",Hibernate.INTEGER)
       				.addScalar("finalpoints",Hibernate.INTEGER)
       				.addScalar("corporation",Hibernate.INTEGER);
       		
       		List list = query.list();
       		if (list != null){
       			Iterator it = list.iterator();
       			result = new LinkedList<PersonData>();
       			while(it.hasNext()) {
       				Object[] row = (Object[])it.next();
       				String firstName = (String)row[0];
       				String lastName = (String)row[1];
       				String email = (String)row[2];
       				Integer idDriver = (Integer)row[3];
       				Integer idCorporation = (Integer) row[7];
       				PersonData person = new PersonData(firstName,lastName,email);
       				person.setIdDriver(idDriver);
       				person.setIdCorporation(idCorporation);
       				
					result.add(person);
       			}
       			System.out.println("Cantidad de Emails a enviar:"+result.size());
       		}
    		
    		
    	}catch(Exception e){
    		e.printStackTrace();
    	}
    	return result;
	}
    
   
    /**
     * Obtiene los conductores de monsanto brasil que pertenezcan a la flota
     * y que sean usuarios fleetdriver y cuya clave es dos veces la encriyptacion del login.
     * @param fleet
     * @return
     * @throws Exception
     */
    public LinkedList<PersonData> getMonsantoFleetDrivers(int fleet,String period,String year) throws Exception {
		
    	LinkedList<PersonData> result = null;
    	Hashtable users = new Hashtable();
		Session session = HibernateUtil.currentSession();
		
    	try {
    		String query = "SELECT DISTINCT u.loginname,u.password,u.email,u.driver,u.firstname," +
    				" u.lastname, u.corporationid " +
    				"FROM vehiclefleets vf " +
    				"JOIN vehicles v ON v.id = vf.vehicle " +
    				"JOIN users u ON u.driver = v.driver " +
    				"JOIN usercorporations uc ON uc.loginname = u.loginname "+  
    				"WHERE vf.id = " + fleet + " AND uc.role = 'fleetdriver' "+
    		        "AND v.id NOT IN (SELECT vehicle FROM odometers WHERE fleet = "+fleet+" AND period = " +period+" AND year = "+year+") "+

    				// y no se le envio ya una alerta hoy: 
    				
    				" AND " +
    				" ( " +
    				"	( u.alertdate IS NULL ) OR " +
    				"   ( date_trunc('day',u.alertdate) != date_trunc('day',CURRENT_TIMESTAMP) )" +
    				" )  order by u.firstname, u.lastname  ";
    		
    		SQLQuery q = session.createSQLQuery(query).addScalar("loginname", Hibernate.STRING).
    		addScalar("password", Hibernate.STRING).addScalar("email", Hibernate.STRING).
    		addScalar("driver", Hibernate.INTEGER).addScalar("firstname", Hibernate.STRING).    		
    		addScalar("lastname", Hibernate.STRING).addScalar("corporationid",Hibernate.INTEGER);
    		
    		/*
    		q.setFirstResult(1);
            q.setMaxResults(300);
            */

    		List l = q.list();
    		if (l != null && l.size() > 0){
	    		Iterator it = q.list().iterator();
	    		result = new LinkedList();
	    		MD5 md5 = new MD5();
	    		
	    		while(it.hasNext()) {
	    			
	    			Object[] data = (Object[])it.next();
	                String loginName = (String)data[0];
	                String email = (String)data[2];
	                Integer driverId = (Integer)data[3];
	                if(email != null && email.length() > 0) {
		            	String crypt = md5.encriptar(md5.encriptar(loginName));
		            	String cryptUser = null;
		            	String user = null;
		            	boolean found = false;
		        		if(!data[1].equals(crypt)) {
		            		System.out.println("Password incorrecto "+crypt+" "+data[0]);
		            	}else {
		                    int i = 1;
		                    user = "fleetUser"+String.valueOf(data[3])+"_"+i;
		                    cryptUser = md5.encriptar(user);
		                    found = cryptUser.equals(loginName);
		                    while(!found && i < 10) {
		                    	i++;
		                        user = "fleetUser"+String.valueOf(data[3])+"_"+i;
		                        cryptUser = md5.encriptar(user); 
		                        found = cryptUser.equals(loginName);
		                    }
		            	}
		        		if(found) {		        			
		        			if(!users.containsKey(driverId)) {
		        				String link = "https://" + AlertConstants.DC_DOMAIN + "/datacenter/home.jsp?login="+user;
		        				System.out.println(data[4]+","+data[5]+","+link);
		        				users.put(driverId, user);
		        				
		        				String login = user;
		        				PersonData person = new PersonData((String)data[4],(String)data[5],email,login);
		        				// El login para la url es el user
		        				// y para el identificador del usuario en la base de datos
		        				// hay que hacer md5(user)
		        				person.setIdCorporation((Integer)data[6]);
		        				person.setLink(link);
		        				person.setIdDriver(driverId);

		        				result.add(person);
		        			}
		            	}
	                }
	    		}
    		}
    	}catch (Exception e) {
        	e.printStackTrace();
		}
    	return result;
    }

    /**
	 * Obtiene los viajes para el dia de hoy para la empresa ANGLO
	 * @return LinkedList de TravelData
	 * @throws Exception
	 */
	public LinkedList<TravelAlertData> getTravelsForToday(Integer corporationId) throws Exception{
		
		LinkedList<TravelAlertData> result = null;
    	Hashtable users = new Hashtable();
		Session session = HibernateUtil.currentSession();
		
    	try {
    		String query = "SELECT firstname, lastname, t.corporation as corporation, dateleave, hourleave, state "+
    					"FROM travels t, drivers d "+
    					"WHERE t.driver = d.id and t.corporation = " + corporationId.toString()+
    					" and state IN (1,2) ";
    		
    		SQLQuery q = session.createSQLQuery(query).addScalar("firstname", Hibernate.STRING).
    		addScalar("lastname", Hibernate.STRING).addScalar("corporation", Hibernate.INTEGER).
    		addScalar("dateleave", Hibernate.DATE).addScalar("hourleave", Hibernate.TIME).    		
    		addScalar("state", Hibernate.INTEGER);
    		
    		List l = q.list();
    		if (l != null && l.size() > 0){
	    		Iterator it = q.list().iterator();
	    		result = new LinkedList<TravelAlertData>();
	    		
	    		while(it.hasNext()) {
	    			
	    			Object[] data = (Object[])it.next();
	                String firstName = (String)data[0];
	                String lastName = (String)data[1];
	                Integer corporation = (Integer)data[2];
	                Date dateLeave = (Date)data[3];
	                Time hourLeave = (Time)data[4];
	                Integer state = (Integer)data[5];
	                
	                TravelAlertData travel = new TravelAlertData(firstName,lastName,dateLeave,hourLeave,state);
	                result.add(travel);
	    		}
    		}
	                
    	}catch(Exception e){
    		e.printStackTrace();
    	}
    	return result;
	}

	/**
	 * Alertas de Lilly
	 * @param period
	 * @param year
	 * @param divGeos
	 * @param status
	 * @param fleets
	 * @return
	 * @throws Exception
	 */
	public LinkedList<PersonData> getLillyActiveDrivers(String period,String year,
    		int status,int fleetId, String fleetList) throws Exception {
    	
    	LinkedList<PersonData> result = null;
    	Hashtable users = new Hashtable();
