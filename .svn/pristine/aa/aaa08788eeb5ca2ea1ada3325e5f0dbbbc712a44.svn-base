	/**
	 * Obtiene las alertas a correrse en el día actual.
	 * @return
	 * @throws Exception
	 */
	public  LinkedList<UnconformityItemAlertDPAData> getForestalesDPAUnconformityTodayAlert() throws Exception {
		
		LinkedList<UnconformityItemAlertDPAData> result = new LinkedList<UnconformityItemAlertDPAData>();
		
		try{	
			Session session = HibernateUtil.currentSession();
			
			String queryStr=" select u.id,u.date,u.type,u.vehiclecheckid,u.driverId,i.type as iType,i.comment,i.expirity ,cd.mail,v.matricula,  "+
							" case when to_date(to_char(i.expirity , 'YYYY/MM/DD'), 'YYYY/MM/DD') = to_date(to_char(current_timestamp - 2 * interval '1 day' , 'YYYY/MM/DD'), 'YYYY/MM/DD') then 'S' else 'P' end  "+
							" from unconformityitemdpa as i INNER JOIN unconformitydpa as u on i.unconformitydpa=u.id  "+ 
							" INNER JOIN vehiclecheck as vc on vc.vehiclecheckid=u.vehiclecheckid  "+ 
							" INNER JOIN vehicles as v on vc.vehicle=v.id  "+ 
							" inner JOIN contractordata as cd on (cd.corporation=v.corporation and cd.id=v.divOrg1) "+
							" where v.corporation in (9,19,50) and  i.notify=true and i.correctiveactiondpa is null and ( to_date(to_char(i.expirity , 'YYYY/MM/DD'), 'YYYY/MM/DD') = to_date(to_char(current_timestamp , 'YYYY/MM/DD'), 'YYYY/MM/DD') )";
			
			Query query = session.createSQLQuery(queryStr);
			
			System.out.println("Alertas UnconformityDPA Forestales de Hoy: "+queryStr);
			
			List alertColl = query.list();
			if (alertColl != null && alertColl.size() > 0){
				Iterator iter = alertColl.iterator();
				while (iter.hasNext()) {
					Object[] row= (Object[]) iter.next();
					Integer idu=(Integer)row[0];
					Date date=(Date)row[1];
					String utype=(String)row[2];
					Integer vehicleid=(Integer)row[3];
					Integer driverId=(Integer)row[4];
					String iType=(String)row[5];
					String comment=(String)row[6];
					Date expirity=(Date)row[7];
					String email=(String)row[8];
					String referencia=(String)row[9];
					String re=(String)row[10];
					
					UnconformityItemAlertDPAData item=new UnconformityItemAlertDPAData();
					item.setUnconformityId(idu.toString());
					item.setComment(comment);
					item.setDate(Util.formatDate(date));
					item.setDriverId(driverId!=null?driverId.toString():"0");
					item.setVehicleId(vehicleid!=null?vehicleid.toString():"0");
					item.setExpirity(Util.formatDate(expirity));
					item.setType(iType);
					item.setUnconformityType(utype);
					item.setReferencia(referencia);
					item.setEmail(email);
					item.setFirstNotify(re.endsWith("P"));
					
					result.add(item);
				}
			}

		}catch(Exception e){
			e.printStackTrace();		
		}
		return result;
	}
	
	/**
	 * Obtiene las alertas a correrse en el día actual.
	 * @return
	 * @throws Exception
	 */
	public  LinkedList<UnconformityItemAlertDPAData> getUPMDPAUnconformityTodayAlert() throws Exception {
LinkedList<UnconformityItemAlertDPAData> result = new LinkedList<UnconformityItemAlertDPAData>();
		
		try{	
			Session session = HibernateUtil.currentSession();
			
			String queryStr="select u.id,u.date,u.type,u.vehiclecheckid,u.driverId,i.type as iType,i.comment,i.expirity ,cd.mail,v.matricula,d.resourcekey "+
							" from unconformityitemdpa as i INNER JOIN unconformitydpa as u on i.unconformitydpa=u.id   "+
							" INNER JOIN vehiclecheck as vc on vc.vehiclecheckid=u.vehiclecheckid   "+
							" INNER JOIN vehicles as v on vc.vehicle=v.id   "+
							" inner JOIN contractordata as cd on (cd.corporation=v.corporation and cd.id=v.divOrg1) "+ 
							" inner JOIN divorgitemlevel1s as d on (d.id=v.divOrg1) "+
							" where v.corporation =9  and i.correctiveactiondpa is null and ( to_date(to_char(i.expirity , 'YYYY/MM/DD'), 'YYYY/MM/DD') <= to_date(to_char(current_timestamp , 'YYYY/MM/DD'), 'YYYY/MM/DD') )" +
							"  and ( to_date(to_char(i.expirity , 'YYYY/MM/DD'), 'YYYY/MM/DD') >= to_date(to_char(u.date , 'YYYY/MM/DD'), 'YYYY/MM/DD') ) ";
			
			Query query = session.createSQLQuery(queryStr);
			
			System.out.println("Alertas UnconformityDPA UPM de Hoy: "+queryStr);
			
			List alertColl = query.list();
			if (alertColl != null && alertColl.size() > 0){
				Iterator iter = alertColl.iterator();
				while (iter.hasNext()) {
					Object[] row= (Object[]) iter.next();
					Integer idu=(Integer)row[0];
					Date date=(Date)row[1];
					String utype=(String)row[2];
					Integer vehicleid=(Integer)row[3];
					Integer driverId=(Integer)row[4];
					String iType=(String)row[5];
					String comment=(String)row[6];
					Date expirity=(Date)row[7];
					String email=(String)row[8];
					String referencia=(String)row[9];
					String div=(String)row[10];
					
					
					UnconformityItemAlertDPAData item=new UnconformityItemAlertDPAData();
					item.setUnconformityId(idu.toString());
					item.setComment(comment);
					item.setDate(Util.formatDate(date));
					item.setDriverId(driverId!=null?driverId.toString():"0");
					item.setVehicleId(vehicleid!=null?vehicleid.toString():"0");
					item.setExpirity(Util.formatDate(expirity));
					item.setType(iType);
					item.setUnconformityType(utype);
					item.setReferencia(referencia);
					item.setEmail(email);
					item.setFirstNotify(true);
					item.setDivOrgItem1(div);
					result.add(item);
				}
			}

		}catch(Exception e){
			e.printStackTrace();		
		}
		return result;
	}
	
	
	/**
	 * Cantidad de checklist por contratista
	 * @return
	 * @throws Exception
	 */
	public  ArrayList<ArrayList<String>> getLogisticContractorWeekAlert(Integer idCorporation,Integer checkName) throws Exception {
		ArrayList<ArrayList<String>> rows=new ArrayList<ArrayList<String>>();
		
		try{	
			Session session = HibernateUtil.currentSession();
			
			String queryStr="select d.resourcekey as Contratista,0 as Cantidad " +
							" from divorgitemlevel1s as d " +
							" inner join divorgs div on(d.divorg=div.id and div.corporation=(:idcorp)) " +
							" inner join contractorData as cd on (cd.id=d.id and cd.mail is not null and trim(cd.mail) <>'') " +
							" where active=true and d.active=true and d.id not in( " +
							" select v.divOrg1 " +
							" from vehiclecheck as vc " +
							" inner join vehicles as v on (vc.vehicle=v.id ) " + 
							"  where to_date(to_char(vc.date, 'YYYY-MM-DD'), 'YYYY-MM-DD') >= to_date((:sd), 'YYYY-MM-DD') and to_date(to_char(vc.date, 'YYYY-MM-DD'), 'YYYY-MM-DD')<to_date((:ed), 'YYYY-MM-DD') ) and d.active=true" +
							" union( " +
							" select d.resourcekey as Contratista,count(vc.vehicleCheckId) as Cantidad " +
							" from divorgitemlevel1s as d " +
							" inner join divorgs div on(d.divorg=div.id and div.corporation=(:idcorp)) " +
							" inner join contractorData as cd on (cd.id=d.id and cd.mail is not null and trim(cd.mail) <>'') " +
							" inner join vehiclecheck as vc on ( vc.name in ('"+checkName+"')) " +
							" inner join vehicles as v on (vc.vehicle=v.id and v.divOrg1=d.id ) " +
							" where to_date(to_char(vc.date, 'YYYY-MM-DD'), 'YYYY-MM-DD') >= to_date((:sd), 'YYYY-MM-DD') and to_date(to_char(vc.date, 'YYYY-MM-DD'), 'YYYY-MM-DD')<to_date((:ed), 'YYYY-MM-DD') and d.active=true " +
							" group by d.resourcekey " +
							" ) order by Cantidad asc, Contratista asc";
			
			Query query = session.createSQLQuery(queryStr);
			Calendar cals=Calendar.getInstance();
			cals.set(Calendar.HOUR,cals.getMinimum(Calendar.HOUR));
			cals.set(Calendar.DATE, 1);
			Calendar cale=Calendar.getInstance();
			cale.set(Calendar.DATE, cale.getMaximum(Calendar.DATE));
			query.setParameter("sd",Util.formatHSQL( cals.getTime(),0));
			query.setParameter("ed", Util.formatHSQL( cale.getTime(),1));
			query.setParameter("idcorp", idCorporation);
			
			System.out.println("Alertas Logistica Uruguay Hoy: "+queryStr);
			
			List alertColl = query.list();
			if (alertColl != null && alertColl.size() > 0){
				Iterator iter = alertColl.iterator();
				while (iter.hasNext()) {
					Object[] row= (Object[]) iter.next();
					String contractor=(String)row[0];
					BigInteger cantidad=(BigInteger)row[1];
					ArrayList<String> rowStr=new ArrayList<String>();
					rowStr.add(contractor);
					rowStr.add(cantidad.toString());
					rows.add(rowStr);
				}
			}

			
		}catch(Exception e){
			e.printStackTrace();		
		}
		return rows;
	}
	
}
