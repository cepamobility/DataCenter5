	/**
	 * Obtiene las alertas a correrse en el día actual.
	 * @return
	 * @throws Exception
	 */
	public  LinkedList<AlertData> getTodayAlert() throws Exception {
		
		LinkedList<AlertData> result = null;
		
		try{	
			Session session = HibernateUtil.currentSession();
			String queryStr = " select distinct alert " +
			   " from Alert as alert " +
		       // " where alert.lastdate >= CURRENT_DATE and alert.lastdate <= CURRENT_DATE + 1" ;
		       // Fecha finalizacion nula o mayor o igula que hoy
		       " where (alert.enddate is null or alert.enddate >= CURRENT_TIMESTAMP) " +
		       // Fecha de proximo envio no nula y menor o igual que hoy
		       " and (alert.nextdate is not null and alert.nextdate <= CURRENT_TIMESTAMP) " ;
		
			
			Query query = session.createQuery(queryStr);
			
			System.out.println("Alertas de Hoy: "+queryStr);
			
			List alertColl = query.list();
			if (alertColl != null && alertColl.size() > 0){
				Iterator iter = alertColl.iterator();
				Alert alert;
				result = new LinkedList();
				while (iter.hasNext()) {
					alert = (Alert) iter.next();
					alert.setTo(getTo(alert.getAlertId().intValue()));
					
					AlertData alertData = alert.getAlertData();
					if (!result.contains(alertData)){
						result.add(alertData);
					}
				}
			}

		}catch(Exception e){
			e.printStackTrace();		
		}
		return result;
	}
	
	/**
	 * Actualiza la fecha de la ultima alerta enviada al driver
	 * segun el email del driver y su id
	 * 
	 * // TODO, pasar esto a un Thread independiente, asi actualiza en paralelo.
	 * @param email
	 */
	@ TransactionAttribute(TransactionAttributeType.REQUIRES_NEW)
	public void getUpdateAlertDateDriverById(PersonData person){
		try{	
			 if (person != null && person.getIdDriver() != null){
				Session session = HibernateUtil.currentSession();
				
				session.beginTransaction();
				
				String queryStr = "UPDATE Driver SET alertDate = CURRENT_TIMESTAMP WHERE " +
						" id = " + person.getIdDriver() + " "; 
						// " email = '" + email + "' ";
					
				Query query = session.createQuery(queryStr);
				query.executeUpdate();
								
				session.flush();
				session.getTransaction().commit();
				
				
				System.out.println("Se actualizo el alertDate del driver "  +person.getIdDriver().toString());
			}

		}catch(Exception e){
			e.printStackTrace();		
		}
	}
	
