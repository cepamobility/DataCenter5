package communication.alert;

import java.io.Serializable;

import communication.datatype.tables.AlertTypeDataType;

public class FleetAlertReminderData implements Serializable  {
	private Integer id;
	private Integer corporation;  
    private Integer country;
	private Integer divOrg21;
	private Integer divOrg22;
	private Integer divOrg23;
	private AlertTypeDataType type;

	public FleetAlertReminderData(Integer id,AlertTypeDataType type,Integer corporation,Integer country,Integer divOrg21,Integer divOrg22,Integer divOrg23) {
		this.id=id;
		this.type =type;
		this.corporation=corporation;
		this.country=country;
		this.divOrg21=divOrg21;
		this.divOrg22=divOrg22;
		this.divOrg23=divOrg23;
		
	}
	public FleetAlertReminderData() {

	}
	
	
	public Integer getId() {
		return id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public AlertTypeDataType getType() {
		return type;
	}

	public void setType(AlertTypeDataType type) {
		this.type = type;
	}

	public Integer getCorporation() {
        return corporation;
    }
	
	public void setCorporation(Integer corporation) {
        this.corporation = corporation;
    }
	
	public Integer getCountry() {
        return country;
    }
	
	public void setCountry(Integer country) {
        this.country = country;
    }
	
	public Integer getDivOrg21() {
		return divOrg21;
	}

	public void setDivOrg21(Integer divOrg21) {
		this.divOrg21 = divOrg21;
	}
	
	public Integer getDivOrg22() {
		return divOrg22;
	}

	public void setDivOrg22(Integer divOrg22) {
		this.divOrg22 = divOrg22;
	}
	
	public Integer getDivOrg23() {
		return divOrg23;
	}

	public void setDivOrg23(Integer divOrg23) {
		this.divOrg23 = divOrg23;
	}

	

	

}
