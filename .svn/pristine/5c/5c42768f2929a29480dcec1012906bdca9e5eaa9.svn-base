package business.ws.client.common;

import java.io.Serializable;

import business.ws.client.driver.WSLDriverStatusData;
import business.ws.client.vehicle.WSLVehicleStatusData;


public class ListWSLDriverStatusDataResult implements Serializable {

	private static final long serialVersionUID = 1L;
	
	private WSLDriverStatusData[] elements;
	private int total;
	
	public ListWSLDriverStatusDataResult(){
		
	}

	public WSLDriverStatusData[] getElements() {
		return elements;
	}

	public void setElements(WSLDriverStatusData[] elements) {
		this.elements = elements;
	}

	public int getTotal() {
		return total;
	}

	public void setTotal(int total) {
		this.total = total;
	}

}
