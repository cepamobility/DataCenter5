package persistence.log.corporation;

import java.io.Serializable;
import java.util.Date;

/**
 * @author fcarriquiry
 *
 * TODO To change the template for this generated type comment go to
 * Window - Preferences - Java - Code Style - Code Templates
 */
public class CorporationCountryLogPK implements Serializable{
	
    private static final long serialVersionUID = 1L;

    private Integer countryId;
	private Integer corporationId;
	private String loginUser;
	private Date date;

	public CorporationCountryLogPK() {
	}
	
    /**
     * @param countryId
     * @param corporationId
     * @param loginUser
     * @param date
     */
    public CorporationCountryLogPK(Integer countryId, Integer corporationId,
            String loginUser, Date date) {
        this.countryId = countryId;
        this.corporationId = corporationId;
        this.loginUser = loginUser;
        this.date = date;
    }
    
    /**
     * @return Returns the corporationId.
     */
    public Integer getCorporationId() {
        return corporationId;
    }
    
    /**
     * @return Returns the countryId.
     */
    public Integer getCountryId() {
        return countryId;
    }
    
    /**
     * @return Returns the date.
     */
    public Date getDate() {
        return date;
    }
    
    /**
     * @return Returns the loginUser.
     */
    public String getLoginUser() {
        return loginUser;
    }
    
    /**
     * @param corporationId The corporationId to set.
     */
    public void setCorporationId(Integer corporationId) {
        this.corporationId = corporationId;
    }
    
    /**
     * @param countryId The countryId to set.
     */
    public void setCountryId(Integer countryId) {
        this.countryId = countryId;
    }
    
    /**
     * @param date The date to set.
     */
    public void setDate(Date date) {
        this.date = date;
    }
    
    /**
     * @param loginUser The loginUser to set.
     */
    public void setLoginUser(String loginUser) {
        this.loginUser = loginUser;
    }
}
