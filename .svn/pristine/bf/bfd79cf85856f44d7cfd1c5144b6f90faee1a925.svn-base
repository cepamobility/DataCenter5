	<%!
	ListResult col;
	Iterator iter;
	//		VehicleMainAttributes vehicle;
	VehicleData vehicle;
	int i;
	String uid;
	int pageMax;
	int contIter;
	int total;

	String division = "";
	String subdivision = "";%>
<%
	col = (ListResult) session.getAttribute("vehicleSearchList");
 	total = col.getTotal();
 	if (all) pageSize = total; // Added 4/Set/2006		
 	if (col != null && col.getElements().isEmpty()) {
 %>
				<table width="100%" border="0">
					<tr align="center">
