    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate,cepascheduleactivityregistrycreate,cepascheduleactivityregistryupdate,cepascheduleactivityview,cdactivitycreate,cdactivitymodify,driverviewowndata,jjreporter"
     */
    public CEPAActivityScheduleRegistryData getCompleteResult(
    		Integer activityId, Integer driverId, Text messages, UserSessionData userRequest) throws Exception {

        try{

            Session session = HibernateUtil.currentSession();

            String queryStr = "select registry from CEPAScheduleActivityRegistry as registry "+
			   " where registry.activity.activityId = :idActivity and registry.driver.id = :idDriver";

            Query query = session.createQuery(queryStr);
            query.setParameter("idActivity",activityId);
            query.setParameter("idDriver",driverId);

            List registryColl = query.list();
            CEPAActivityScheduleRegistryData registryData = null;
            Iterator iter = registryColl.iterator();
            CEPAScheduleActivityRegistry registry = null;
            Set<Item> items = null;
            Set<ItemValue> itemsValues = null;
            Set<PointComment> pointCommentSet = null;
            Set<PointObservationSelected> pointObsSet = null;
            Set<CEPAScheduleActivityRegistryObservationSelected> obsSelected = null;
            while (iter.hasNext()) {
            	registry = (CEPAScheduleActivityRegistry) iter.next();
                items = registry.getItemSet();
                pointCommentSet = registry.getPointCommentSet();
                itemsValues = registry.getItemValueSet();
                pointObsSet = registry.getPointObservationSelectedSet();
                obsSelected = registry.getObservationsSelected(); // Tablet
            }

            /* Items */
            Collection<ItemData> result = new LinkedList<ItemData>();
            Iterator<Item> iter2 = items.iterator();
            while (iter2.hasNext()) {
            	Item item = (Item) iter2.next();
                result.add(item.getItemData());
            }

            /* ItemsValues */
            Collection<ItemValueData> itemsValuesList = null;
            if (registry.getActivity().getType().getResourceBundleId()
        			.equals("datatype.scheduledactivitytype.commentarydriveother") ||
       			registry.getActivity().getType().getResourceBundleId()
        			.equals("datatype.scheduledactivitytype.btwthailand") ||

        		// Actividades con formulario de evaluacion en cabina (Checklist 14)
        		registry.getActivity().getType().getResourceBundleId()
        			.equals(CEPAActivityConstants.EVALUACIONENCABINAPESADO) ||
            	registry.getActivity().getType().getResourceBundleId()
        			.equals(CEPAActivityConstants.BTWPESADOSCONEVALUACIONENCABINA) ||
                	registry.getActivity().getType().getResourceBundleId()
            			.equals(CEPAActivityConstants.REPORTERJJ_SELFEVALUATION) ||
                    	registry.getActivity().getType().getResourceBundleId()
            			.equals(CEPAActivityConstants.REPORTERJJ_COMMENTARYDRIVE) ||
        		registry.getActivity().getType().getResourceBundleId()
        			.equals(CEPAActivityConstants.CURSOPESADOS) ||
        		registry.getActivity().getDefinition().getCheckList().getId().intValue() == 14 ||

       			registry.getActivity().getType().getResourceBundleId()
        			.equals(CEPAActivityConstants.AVANZADO) ||
            	registry.getActivity().getType().getResourceBundleId()
        			.equals(CEPAActivityConstants.PRINCIPIANTE) ||
            	registry.getActivity().getType().getResourceBundleId()
        			.equals(CEPAActivityConstants.PRINCIPIANTE_REFRESH) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.COMMENTARYDRIVEARGENTINA) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.COMMENTARYDRIVE_NOVARTIS) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.COMMENTARYDRIVE_JJ2) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.COMMENTARYDRIVE_RENOVATION) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.INITIAL_FOREIGN_EVALUATION) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.COMMENTARYDRIVEARGENTINA_NUEVO) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals("datatype.scheduledactivitytype.commentarydriverisk") ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals("datatype.scheduledactivitytype.commentarydrivecayaco") ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.COMMENTARYDRIVENALCO) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.CEPA_SYSTEM_COURSE_1_LIVIANOS) ||
                    registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.CEPA_SYSTEM_COURSE_1_PESADOS) ||
                    registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.CEPA_SYSTEM__LIVIANOS_PESADOS) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.CEPA_SYSTEM_COURSE_2_CEPA) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.EBTW) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.EBTW_PISTA) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.CEPA_SYSTEM_COURSE_2_ENTRENADORES) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.FEEDBACK_LINE_MANAGER) ||
                registry.getActivity().getType().getResourceBundleId()
                    .equals(CEPAActivityConstants.COMMENTARYDRIVE_INSTRUCTORES))
            {
            	itemsValuesList = new LinkedList<ItemValueData>();
            	Iterator<ItemValue> iter4 = itemsValues.iterator();
            	while (iter4.hasNext()) {
            		itemsValuesList.add(((ItemValue) iter4.next()).getItemValueData());
            	}
            }


            Collection<PointCommentData> pointCommentList = null;
            if(!registry.getActivity().getType().getResourceBundleId().equals(CEPAActivityConstants.EBTW) &&
            		!registry.getActivity().getType().getResourceBundleId().equals(CEPAActivityConstants.EBTW_PISTA)) {
	            /* PointComment */
	            if (pointCommentSet != null){
	            	if (pointCommentSet.size() > 0) {
	            		pointCommentList =  new LinkedList<PointCommentData>();
	            		Iterator<PointComment> iter3 = pointCommentSet.iterator();
	            		while (iter3.hasNext()){
	            			pointCommentList.add(((PointComment)iter3.next()).getPointCommentData());
	            		}
	            	}
	            }
            }

            /* pointObservations, 17/04/2012 Tablet */
            Collection<PointObservationSelectedData> pointObsList = null;
            if (pointObsSet != null && pointObsSet.size() > 0){
            	pointObsList = new LinkedList<PointObservationSelectedData>();
            	Iterator<PointObservationSelected> iter01 = pointObsSet.iterator();
            	while (iter01.hasNext()){
            		pointObsList.add(iter01.next().getData());
            	}
            }

            /* observationSelected, Tablets, 06/12/2012 */
            Collection<CEPAScheduleActivityRegistryObservationSelectedData> obsSelectedList = null;
            if (messages != null){
	            if (obsSelected != null && obsSelected.size() > 0){
	            	obsSelectedList = new LinkedList<CEPAScheduleActivityRegistryObservationSelectedData>();
	            	Iterator<CEPAScheduleActivityRegistryObservationSelected> iter02 = registry.getObservationsSelectedIterator();
	            	int order = 0;
	            	while (iter02.hasNext()){
	            		CEPAScheduleActivityRegistryObservationSelectedData d = iter02.next().getData();

	            		/* Añadido el  06/12/2012 */
	            		if ( d != null && d.getObservation() != null && d.getObservation().getTextReport() != null){

		            		String textReport = messages.getText(d.getObservation().getTextReport());
		            		int maxlength = 130;
		        			if (textReport != null && textReport.length() > maxlength){
		        				// Si el texto de la observacion es muy largo lo corto en dos lineas

		        				String lines = addLinebreaks(textReport,  maxlength);
		        				String text =  "   - ".concat(lines.substring(0,lines.indexOf("\n")));
		        				String text2 = textReport.substring(lines.indexOf("\n"));

		        				// Linea 1
		        				CEPAScheduleActivityRegistryObservationData obs1 = d.getObservation();
		        				obs1.setTextReport(text);
		        				d.setObservation(obs1);
		        				obsSelectedList.add(d);

		        				// Linea 2, creo un observationdata nuevo con id = {id del observation * (-1)}
		        				order++;
		        				CEPAScheduleActivityRegistryObservationData obs2 =
		        						new CEPAScheduleActivityRegistryObservationData(
		        								d.getObservation().getIdObservation() * (-1),
		        								text2, text2,
		        								d.getObservation().getObsOrder() + order);
		        				CEPAScheduleActivityRegistryObservationSelectedData selected2 =
		        						new CEPAScheduleActivityRegistryObservationSelectedData(obs2);
		        				obsSelectedList.add(selected2);

		        			}else{
		        				// Observacion en una unica linea:
		        				CEPAScheduleActivityRegistryObservationData obs1 = d.getObservation();
		        				String text = "   - ".concat(textReport);
		        				obs1.setText(text);
		        				obs1.setTextReport(text);
		        				obs1.setObsOrder(d.getObservation().getObsOrder() + order);
		        				d.setObservation(obs1);
		        				obsSelectedList.add(d);
		        			}
	            		}
	        			/* Fin añadido 06/12/2012 */
	            	}
	            }
            }

            registryData = registry.getCEPAScheduleActivityData();
           	registryData.setPointCommentSet(pointCommentList);
        	registryData.setItemValueSet(itemsValuesList);
           	registryData.setItemSet(result);
           	registryData.setInitialHr(registry.getInitialHr());
           	registryData.setInitialKm(registry.getInitialKm());
           	registryData.setFinalHr(registry.getFinalHr());
           	registryData.setFinalKm(registry.getFinalKm());
           	registryData.setClassNumber(registry.getClassNumber());

           	registryData.setPointObservations(pointObsList);
           	registryData.setObsSelected(obsSelectedList);
            return registryData;

        }catch (Exception e) {
        	Object[] parameters = {activityId,driverId, messages};
            handler.getException(e,"getCompleteResult",userRequest,parameters);
        }
        return null;
    }

    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivitycreate,cepascheduleactivityregistrycreate,cepascheduleactivityregistryupdate,cdactivitycreate,cdactivitymodify"
     */
    public boolean existsRegistry(Integer activityId, Integer driverId,UserSessionData userRequest) throws Exception {
        try{

            Session session = HibernateUtil.currentSession();

            String queryStr = "select registry from CEPAScheduleActivityRegistry as registry "+
			   " where registry.activity.activityId = :idActivity and registry.driver.id = :idDriver";

            Query query = session.createQuery(queryStr);
            query.setParameter("idActivity",activityId);
            query.setParameter("idDriver",driverId);

            return (query.list().iterator().hasNext());

        }catch (Exception e) {
        	Object[] parameters = {activityId,driverId};
            handler.getException(e,"existsRegistry",userRequest,parameters);
        }
        return false;
    }

    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivitycreate,cepascheduleactivityregistrycreate,cepascheduleactivityregistryupdate,cepascheduleactivityregistryview,cdactivitycreate,cdactivitymodify"
     */
    public CEPAActivityScheduleRegistryData getRegistry(Integer activityId, Integer driverId,UserSessionData userRequest) throws Exception {

    	try{
    		CEPAActivityScheduleRegistryData registry = null;

            Session session = HibernateUtil.currentSession();

            String queryStr = "select registry from CEPAScheduleActivityRegistry as registry "+
			   " where registry.activity.activityId = :idActivity and registry.driver.id = :idDriver";

            Query query = session.createQuery(queryStr);
            query.setParameter("idActivity",activityId);
            query.setParameter("idDriver",driverId);

            Object result = query.uniqueResult();
            if(result != null) {
            	CEPAScheduleActivityRegistry activity = (CEPAScheduleActivityRegistry)result;
            	registry = activity.getCEPAScheduleActivityData();
            }

            return (registry);

        }catch (Exception e) {
        	Object[] parameters = {activityId,driverId};
            handler.getException(e,"getRegistry",userRequest,parameters);
        }
        return null;
    }




    /**
     *
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityview,driverviewowndata"
     */
    public ActivityReportDataType getReportActivity(Integer activityId, Integer driverId, int first, int count, UserSessionData userSessionData) throws Exception {
    	ActivityReportDataType result = new ActivityReportDataType();

        Session session = HibernateUtil.currentSession();
        String queryStr = "select registry from CEPAScheduleActivityRegistry as registry "+
		   " where registry.activity.activityId = :idActivity and registry.driver.id = :idDriver";

        Query query = session.createQuery(queryStr);
        query.setParameter("idActivity",activityId);
        query.setParameter("idDriver",driverId);
        CEPAScheduleActivityRegistry registry = null;
        List registryColl = query.list();
        Set items = null;
        Set pointCommentSet = null;
        Iterator iter = registryColl.iterator();
        while (iter.hasNext()) {
        	registry = (CEPAScheduleActivityRegistry) iter.next();
            items = registry.getItemSet();
            pointCommentSet = registry.getPointCommentSet();
        }

        // Armo la lista de PointItem
        ArrayList pointItemList = new ArrayList();

        Iterator iter2 = items.iterator();
        while (iter2.hasNext()) {
           	Item item = (Item) iter2.next();
           	Point point = getPoint(registry.getActivity().getDefinition().getCheckList().getPoints(),item);
           	if (point != null){
          		pointItemList.add(new PointItemData(point.getPointData(),item.getItemData()));
           	}
        }

        if (pointItemList != null && pointItemList.size() > 0) {
        	Collections.sort(pointItemList);
        }
        result.setPointItem(pointItemList);

        // Armo la lista de PointComment
        ArrayList pointCommentList = null;
        if (pointCommentSet != null) {
        	if (pointCommentSet.size() > 0) {
        		pointCommentList =  new ArrayList();
        		Iterator iter3 = pointCommentSet.iterator();
        		while (iter3.hasNext())       		{
        			pointCommentList.add(((PointComment)iter3.next()).getPointCommentData());
        		}
        	}
         }

         if (pointCommentList != null && pointCommentList.size() > 0){
        	 Collections.sort(pointCommentList);
         }

         result.setPointComment(pointCommentList);
         return result;
    }

    /**
     *
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityview,driverviewowndata"
     */
    public ActivityReportTabletDataType getReportTabletActivity(Integer activityId, Integer driverId, int first,
    	int count, Text messages, UserSessionData userSessionData) throws Exception {

    	ActivityReportTabletDataType result = new ActivityReportTabletDataType();

        Session session = HibernateUtil.currentSession();
        String queryStr = "select registry from CEPAScheduleActivityRegistry as registry "+
		   " where registry.activity.activityId = :idActivity and registry.driver.id = :idDriver";

        Query query = session.createQuery(queryStr);
        query.setParameter("idActivity",activityId);
        query.setParameter("idDriver",driverId);
        CEPAScheduleActivityRegistry registry = null;
        List registryColl = query.list();
        Set items = null;
       // Set pointCommentSet = null;
        Set<PointObservationSelected> pointObservationSelected = null;
        Set<CEPAScheduleActivityRegistryObservationSelected> observationsSelected = null;
        Iterator iter = registryColl.iterator();
        while (iter.hasNext()) {
        	registry = (CEPAScheduleActivityRegistry) iter.next();
            items = registry.getItemSet();
            // pointCommentSet = registry.getPointCommentSet();
            pointObservationSelected = registry.getPointObservationSelectedSet();
            observationsSelected = registry.getObservationsSelected();
        }



        // Armo la lista de PointItem
        ArrayList<PointItemData> pointItemList = new ArrayList<PointItemData>();

        Integer POINT_TIPO_DE_VEHICULO = 1516; // BTW1
        Integer POINT_TIPO_DE_VEHICULO_2 = 1521; // BTW2
        Integer POINT_CAJA_DE_VELOCIDADES = 1517; // BTW1
        Integer POINT_CAJA_DE_VELOCIDADES_2 = 1523; // BTW2

        Iterator iter2 = items.iterator();
        while (iter2.hasNext()) {
           	Item item = (Item) iter2.next();
           	if (item != null){
           		Point point = getPoint(registry.getActivity().getDefinition().getCheckList().getPoints(),item);
           		if (point != null && !point.getId().equals(POINT_TIPO_DE_VEHICULO) &&
           				!point.getId().equals(POINT_TIPO_DE_VEHICULO_2) &&
           				!point.getId().equals(POINT_CAJA_DE_VELOCIDADES) &&
           				!point.getId().equals(POINT_CAJA_DE_VELOCIDADES_2)){
           			// No traigo los puntos de: Tipo de Vehiculo ni Caja de Velocidades
           			pointItemList.add(new PointItemData(point.getPointData(),item.getItemData()));
           		}
           	}
        }

        /* Agrego las observaciones como items para que se muestren luego de los items */
        Set<PointData> pointDataSet = new HashSet<PointData>();

        if (pointObservationSelected != null && pointObservationSelected.size() > 0){
        	Iterator<PointObservationSelected> iter3 = registry.getPointObservationSelectedIterator();

        	int order = 0;
        	while (iter3.hasNext()){
        		PointObservationSelected p = iter3.next();
        		if (p != null && p.getPoint() != null && p.getObservation() != null
        				&& !p.getPoint().getId().equals(POINT_TIPO_DE_VEHICULO) &&
           				!p.getPoint().getId().equals(POINT_TIPO_DE_VEHICULO_2) &&
           				!p.getPoint().getId().equals(POINT_CAJA_DE_VELOCIDADES) &&
           				!p.getPoint().getId().equals(POINT_CAJA_DE_VELOCIDADES_2)
        				){
        			// Point point = p.getPoint();
        			PointData pointData = p.getPoint().getPointData();

        			pointDataSet.add(pointData);

        			PointObservation obs = p.getObservation();

        			String textReport = messages.getText(obs.getTextReport());
        			int maxlength = 120;
        			if (textReport != null && textReport.length() > maxlength){
        				// Si el texto de la observacion es muy largo lo corto en dos lineas

        				String lines = addLinebreaks(textReport,  maxlength);

        				String text =  "   - ".concat(lines.substring(0,lines.indexOf("\n")));
        				String text2 = textReport.substring(lines.indexOf("\n"));

        				// Linea 1
        				ItemData itemData = new ItemData(obs.getIdObservation(),
        					obs.getText(),
        					text,
        					obs.getObsOrder() + 100 + order);
        				pointItemList.add(new PointItemData(p.getPoint().getPointData(), itemData));
        				pointData.getItems().add(itemData);


            			// Linea 2
        				order++;
        				ItemData itemData2 = new ItemData(obs.getIdObservation(),
        					obs.getText(),
        					text2,
        					obs.getObsOrder() + 100 + order);
        				pointItemList.add(new PointItemData(p.getPoint().getPointData(), itemData2));
        				pointData.getItems().add(itemData2);

        			}else{

        				ItemData itemData = new ItemData(obs.getIdObservation(),
        					"   - ".concat(obs.getText()),
        					"   - ".concat(textReport),
        					obs.getObsOrder() + 100 + order);
        				pointItemList.add(new PointItemData(p.getPoint().getPointData(), itemData));
        				pointData.getItems().add(itemData);
        			}


        		}
        	}
        	//Agrego para cada punto que tenga observaciones (pointDataSet) un item que tenga el texto "Observaciones"
        	// en el orden 100
        	if (!pointDataSet.isEmpty()){
        		Iterator<PointData> iter4 = pointDataSet.iterator();
        		while (iter4.hasNext()){
        			PointData p = iter4.next();
        			if (p != null){
        				ItemData itemData = new ItemData(100,"generic.activity.observations","generic.activity.observations",100);
        				pointItemList.add(new PointItemData(p, itemData));
        				p.getItems().add(itemData);
        			}
        		}
        	}
        }



        if (pointItemList != null && pointItemList.size() > 0) {
        	Collections.sort(pointItemList);
        }
        result.setPointItem(pointItemList);


         return result;
    }

    /**
     *
     * @param input
     * @param maxLineLength
     * @return
     */
    private String addLinebreaks(String input, int maxLineLength) {
        StringTokenizer tok = new StringTokenizer(input, " ");
        StringBuilder output = new StringBuilder(input.length());
        int lineLen = 0;
        while (tok.hasMoreTokens()) {
            String word = tok.nextToken()+" ";

            if (lineLen + word.length() > maxLineLength) {
                output.append("\n");
                lineLen = 0;
            }
            output.append(word);
            lineLen += word.length();
        }
        return output.toString();
    }

    public Point getPoint(Set points,Item item) {
    	Iterator iter = points.iterator();
    	boolean exists = false;
    	Point point = null;
    	while (iter.hasNext() && (!exists)) {
    		point = (Point) iter.next();
    		exists = point.getItems().contains(item);
    	}

    	return point;
    }

