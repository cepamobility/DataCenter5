     */
    public ItemData getFormItem(String pointText,String itemText,UserSessionData userRequest) throws Exception {
        try{
        	Session session = HibernateUtil.currentSession();
			String queryStr = " select items.id,items.text,items.textreport,items.itemorder,items.type " +
					"from items,point where point.id=items.point and point.text='"+pointText+"'" +
					"and items.text= '"+itemText+"' order by items.id limit 1";
			SQLQuery query = session.createSQLQuery(queryStr);
	        query.addScalar("id",Hibernate.INTEGER);
	        query.addScalar("text",Hibernate.STRING);
	        query.addScalar("textreport",Hibernate.STRING);
	        query.addScalar("itemorder",Hibernate.INTEGER);
	        query.addScalar("type",Hibernate.INTEGER);
	        Iterator it = query.list().iterator();
	        Item item=null;
	        while(it.hasNext()) {
	        	item=new Item((Object[])it.next());
	        }
	        if (item!=null)
	        	return item.getItemData();

        }catch (Exception e) {
        	Object[] parameters = {pointText,itemText};
            handler.getException(e,"getFormItem",userRequest,parameters);
        }
        return null;
    }

