            }

            DriverReportDataType driverReportDT = new DriverReportDataType((Integer)row[0],
        			(String)row[1],(String)row[2],(String)row[5],activityDate,activityDate,(String)row[3],"","","",
        			"","","","","","","","", null);
            driverReportDT.setCorporationId((String)row[9]);
            driverReportDT.setCity((String)row[10]);
            driverReportDT.setPhonenumber((String)row[11]);
            driverReportDT.setManager((String)row[12]);
            driverReportDT.setSuperviser((String)row[13]);
            driverReportDT.setEmail((String)row[15]);
            driverReportDT.setLicenseObs((String)row[14]);
            driverReportDT.setDirector(((Boolean)row[16]).booleanValue());
	      	DriverWithExpiredActivities driver = new DriverWithExpiredActivities(driverReportDT,activityType,
        			note,activityDate,(Date)row[4],divOrgLabels);

	      	if(corporationId == CorporationData.JJ || (corporationId == CorporationData.MONSANTO && third == 2)) {
	      		if(!maps.containsKey(row[0])){
	      			ids += ","+String.valueOf(row[0]);
	      			maps.put(row[0], driver);
	      		}
	      	}else {
	      		result.add(driver);
	      	}
	    }

      	if(corporationId == CorporationData.JJ) {
      		String sql = "SELECT ar.driver,ca.type FROM activityregistry ar JOIN cepaactivity ca ON ca.activityid = ar.activity WHERE ca.corporation = "+CorporationData.JJ+" AND ca.type in ('"+CEPAActivityConstants.BTW2+"','"+CEPAActivityConstants.ASSESSMENT+"','"+CEPAActivityConstants.EBTW+"','"+CEPAActivityConstants.EBTW_PISTA+"') AND ar.driver IN ("+ids+")";
      		query = session.createSQLQuery(sql).addScalar("driver", Hibernate.INTEGER).addScalar("type", Hibernate.STRING);
      		List list = query.list();
      		if(list != null && list.size() > 0) {
      			it = list.iterator();
      			while(it.hasNext()) {
      				Object[] data = (Object[])it.next();
      				DriverWithExpiredActivities driver = (DriverWithExpiredActivities)maps.get(data[0]);
      				if(data[1].equals(CEPAActivityConstants.BTW2)) {
      					driver.setBTW2();
      				}else if(data[1].equals(CEPAActivityConstants.ASSESSMENT)) {
      					driver.setBTW3();
      				}else if(data[1].equals(CEPAActivityConstants.EBTW)) {
      					driver.setEBTW();
      				}

      			}
      		}

      		Enumeration elements = maps.elements();
      		while(elements.hasMoreElements()) {
      			result.add(elements.nextElement());
      		}
      	}

      	if(corporationId == CorporationData.MONSANTO && third == 2) {
      		String sql = "SELECT ar.driver,ca.type,ca.dateexpiry FROM activityregistry ar JOIN cepaactivity ca ON ca.activityid = ar.activity WHERE ca.corporation = "+CorporationData.MONSANTO+" AND ca.type in ('"+CEPAActivityConstants.OUT_TRAINING+"','"+CEPAActivityConstants.OUT_TRAINING_LIVIANOS+"','"+CEPAActivityConstants.OUT_TRAINING_PESADOS+"') AND ar.driver IN ("+ids+") ORDER BY dateexpiry";
      		query = session.createSQLQuery(sql).addScalar("driver", Hibernate.INTEGER).addScalar("type", Hibernate.STRING).addScalar("dateexpiry", Hibernate.DATE);
      		List list = query.list();
      		if(list != null && list.size() > 0) {
      			it = list.iterator();
      			while(it.hasNext()) {
      				Object[] data = (Object[])it.next();
      				DriverWithExpiredActivities driver = (DriverWithExpiredActivities)maps.get(data[0]);
  					driver.setLastThird((String) data[1]);
  					driver.setThirdExpiry((Date) data[2]);
      			}
      		}

      		Enumeration elements = maps.elements();
      		while(elements.hasMoreElements()) {
      			result.add(elements.nextElement());
      		}
      	}
	    /*
        Date  hof= new Date();
        System.out.println("\n");
        System.out.print("Usuario:" + userRequest.getFilter().getLoginName());
        System.out.print("Tiempo Consulta Optimizada:");
        System.out.println(hof.getTime() - ho1.getTime());
        System.out.println("\n");
        */
	    return new ListResult(result,total.intValue());

    	}catch(Exception e){
        	Object[] parameters = {initialDate,lastDate, type,divOrgs,divGeos,driverType,vehicleAllowed,first,count};
    		 handler.getException(e,"driverWithExpiredActivities",userRequest,parameters);

    	}
    	return null;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Collection findCommentaryDriveLog(UserSessionData userSessionData,String fromMonth,
    		Integer fromYear, String toMonth, Integer toYear,Integer[][] divOrgs,
    		Integer[][] divGeos,int order1,int order2,int order3,int order4) throws Exception {

        Collection elements = new LinkedList();
        try{
            Session session = HibernateUtil.currentSession();

            String queryStr = "SELECT registry.driver.firstName,registry.driver.lastName,registry.driver.birthDate,";
            queryStr += "registry.activity.activityId,registry.activity.date AS activityDate,";
            queryStr += "registry.activity.city,log.pk.userId,log.pk.date,";
            queryStr += "registrylog.pk.userId,registrylog.pk.date AS driverDate ";
            String filter = userSessionData.getFilter().getReportFilter(order1,0);
            if(filter != null) {
                queryStr += ",registry.activity."+filter+",registry.activity."+userSessionData.getFilter().getReportFilter(order1,1);
            }
            filter = userSessionData.getFilter().getReportFilter(order2,0);
            if(filter != null) {
                queryStr += ",registry.activity."+filter+",registry.activity."+userSessionData.getFilter().getReportFilter(order2,1);
            }
            filter = userSessionData.getFilter().getReportFilter(order3,0);
            if(filter != null) {
                queryStr += ",registry.activity."+filter+",registry.activity."+userSessionData.getFilter().getReportFilter(order3,1);
            }
            filter = userSessionData.getFilter().getReportFilter(order4,0);
            if(filter != null) {
                queryStr += ",registry.activity."+filter+",registry.activity."+userSessionData.getFilter().getReportFilter(order4,1);
            }
            queryStr += " FROM CEPAScheduleActivityRegistry AS registry,ActivityLog AS log,ActivityRegistryLog registrylog ";
            queryStr += UtilityQuery.corporationDivisionsRestictions("registry.activity",userSessionData);
            queryStr += " AND registry.activity.activityId = log.pk.activity";
            queryStr += " AND registry.driver.id = registrylog.driver";
            queryStr += " AND registrylog.action = "+LogActions.ADDCOMMENTARYDRIVE;
            if (userSessionData.getFilter().getCorporationId().intValue() != CorporationData.MONSANTO) {
                queryStr += " AND registry.activity.type in ('" + CEPAActivityConstants.COMMENTARYDRIVEOTHER + "') ";
            }else {
                queryStr += " AND registry.activity.type in ('" + CEPAActivityConstants.COMMENTARYDRIVE + "') ";
            }
            queryStr += " AND log.action = " + LogActions.CREATE;
            queryStr += " AND (YEAR(registry.activity.date) = "+String.valueOf(fromYear)+" AND month(registry.activity.date) >= "+fromMonth+" OR year(registry.activity.date) > "+String.valueOf(fromYear)+") ";
            queryStr += " AND (YEAR(registry.activity.date) = "+String.valueOf(toYear)+" AND month(registry.activity.date) <= "+toMonth+" OR year(registry.activity.date) < "+String.valueOf(toYear)+") ";

            Query query = session.createQuery(queryStr);

            Iterator it = query.list().iterator();
            while (it.hasNext()) {
                elements.add(new CommentaryDriveLogData((Object[]) it.next()));
            }
        }catch(Exception e){
        	Object[] parameters = {fromMonth,fromYear,toMonth,toYear,divOrgs,divGeos,order1,order2,order3,order4};
            handler.getException(e,"findCommentaryDriveLog",userSessionData,parameters);
        }
        return elements;
   }

    /**
     * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,cepascheduleactivityview"
     * @param userRequest - logged user
     * @param type - type of activity
     * @param first - first index of the search to return
     * @param count - number of elements to return
     * @return result of the search
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
	 */

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityview,cepascheduleactivityregistryview"
     */
    public ListResult  driversWithoutBTW(UserSessionData userRequest,Date initialDate,Date lastDate,Integer[][] divOrgs,Integer[][] divGeos, String driverType,String[] vehicleAllowed,int first, int count) throws Exception {
        Session session = HibernateUtil.currentSession();

        Hashtable parameters = new Hashtable();

        Collection result = new LinkedList();

        String queryStr = UtilityQuery.corporationDivisionsRestictions("driver",userRequest);

        HashSet set = new HashSet();
        String divOrgStr = "";
        if(divOrgs != null && divOrgs.length > 0) {
            for(int j = 0; j < divOrgs.length; j++) {
                if(divOrgs[j] != null && divOrgs[j].length > 0) {
                	divOrgStr = "";
                    divOrgStr = " and driver.divOrg"+String.valueOf(j+1)+".id in (";
                    set = new HashSet();
                    for(int i = 0; i < divOrgs[j].length; i++) {
                    	set.add(divOrgs[j][i]); // Para evitar repetidos
                    }
                    Iterator it = set.iterator();
                    int i = 0;
                    while (it.hasNext()){
                    	String div = ((Integer)it.next()).toString();
                    	divOrgStr += div;
                        divOrgStr += (i == set.size()-1) ? ") " : ",";
                        i++;
                    }
                    queryStr += divOrgStr;
                }
            }
        }

        if(divGeos != null) {
            if(divGeos[0] != null && divGeos[0].length > 0) {
                queryStr += "and driver.corpCountry.pk.country.id in (";
                for(int i = 0; i < divGeos[0].length; i++) {
                    queryStr += divGeos[0][i];
                    queryStr += (i == divGeos[0].length-1) ? ")" : ",";
                }
            }
        }

        if (driverType.equals("generic.messages.active")) {
        	queryStr += " and driver.exclusionDate is null";
        }

        if (driverType.equals("generic.messages.excluded")) {
        	queryStr += " and driver.exclusionDate is not null";
        }
        if (vehicleAllowed != null && vehicleAllowed.length > 0 && !(vehicleAllowed.length == 1 && vehicleAllowed[0].length() == 0)) {
            queryStr += " and driver.vehicleAllowed IN (";
        	for(int i = 0; i < vehicleAllowed.length; i++) {
        		queryStr += "'"+vehicleAllowed[i]+"'";
        		if(i < vehicleAllowed.length-1)
        			queryStr += ",";
        	}
            queryStr += ") ";
        }

        String subqueryStr ="";

        // solo tomo en cuenta las actividades finalizadas
        subqueryStr += " and registry.activity.state.resourceBundleId = '" + CEPAActivityConstants.DICTADA + "'";

        String queryAuxStr = "select count(driver) " +
        		"from Driver as driver " + queryStr +
        		" and driver.id " +
        		" not in (select registry.driver.id from CEPAScheduleActivityRegistry as registry" +
        		" where registry.activity.type.resourceBundleId in (" +
        			"'" + CEPAActivityConstants.BTW1 +"'," + // BTW1
        			"'" + CEPAActivityConstants.BTW1_NEW_FORM_TABLET +"'," + // BTW1 TABLET
        			"'" + CEPAActivityConstants.BTW2 + "'," + // BTW2
        			"'" + CEPAActivityConstants.BTW2_NEW_FORM_TABLET + "'," + // BTW2 TABLET
        			"'" + CEPAActivityConstants.BTW3 + "'," + // BTW3
        			"'" + CEPAActivityConstants.BTW2SPV + "',"+ // BTW2/SPV
        			"'" + CEPAActivityConstants.BTW2UPM + "',"+ // BTW2/SPV
        			"'" + CEPAActivityConstants.BTW4x4 + "',"+ // BTW Manejo 4x4
        			"'" + CEPAActivityConstants.BTW24x4 + "',"+ // BTW2 Manejo 4x4
        			"'" + CEPAActivityConstants.BTW3UPDATE + "',"+ // BTW3 Actualizacion
        			"'" + CEPAActivityConstants.BTW3RENOVACION + "',"+
        			"'" + CEPAActivityConstants.BTWONBOARD + "',"+ // BTW on board
        			"'" + CEPAActivityConstants.BTW2ONBOARD + "',"+ // BTW on board
        			"'" + CEPAActivityConstants.BTWONBOARD_V2 + "',"+ // BTW on board
        			"'" + CEPAActivityConstants.BTW2ONBOARD_V2 + "',"+ // BTW on board
        			"'" + CEPAActivityConstants.BTW1ONBOARD_TABLET + "',"+ // BTW on board
        			"'" + CEPAActivityConstants.BTW2ONBOARD_TABLET + "',"+ // BTW on board
        			"'" + CEPAActivityConstants.HEAVY_VEHICLES_REPETITION + "',"+ // HEAVY VEHICLES REPETITION
        			"'" + CEPAActivityConstants.HIDRO + "',"+
        			"'" + CEPAActivityConstants.BTW3SEGUNDARENOVACION + "',"+
        			"'" + CEPAActivityConstants.BTW3TERCERARENOVACION + "',"+
        			"'" + CEPAActivityConstants.BTW2UPM + "',"+
        			"'" + CEPAActivityConstants.EBTW + "',"+
        			"'" + CEPAActivityConstants.OUT_TRAINING +"'"; // Curso Realizado por Terceros (Monsanto)

        if(userRequest.isCorporation(CorporationData.BAYER_MX)) {
            queryAuxStr += ",'"+CEPAActivityConstants.EBTW_TEORICO+"'";
        }
        if(userRequest.isCorporation(CorporationData.FORESTALORIENTAL)) {
            queryAuxStr += ",'"+CEPAActivityConstants.PESADOS_1+"'";
        }
        queryAuxStr += ") "+subqueryStr+ ")";

        Query queryAux = session.createQuery(queryAuxStr);
        Enumeration keys = parameters.keys();
        while(keys.hasMoreElements()) {
            String parameter = (String)keys.nextElement();
            queryAux.setParameter(parameter,parameters.get(parameter));
        }

		List activityColl = queryAux.list();
	    Iterator iter = activityColl.iterator();
	    Integer total = new Integer(0);
		while (iter.hasNext()) {
		    total = new Integer(((Long) iter.next()).intValue());
		}

	        //System.out.println("TOTAL:"+total);


	        String queryStr2 ="select driver from Driver as driver " + queryStr +
	        		" and driver.id " +
	        		"not in (select registry.driver.id from CEPAScheduleActivityRegistry as registry" +
	        		" where registry.activity.type.resourceBundleId in (" +
	        			"'" + CEPAActivityConstants.BTW1 +"'," + // BTW1
	        			"'" + CEPAActivityConstants.BTW1_NEW_FORM_TABLET +"'," + // BTW1 TABLET
	        			"'" + CEPAActivityConstants.BTW2 + "'," + // BTW2
	        			"'" + CEPAActivityConstants.BTW2_NEW_FORM_TABLET + "'," + // BTW2 TABLET
	        			"'" + CEPAActivityConstants.BTW3 + "'," + // BTW3
	        			"'" + CEPAActivityConstants.BTW2SPV + "',"+ // BTW2/SPV
	        			"'" + CEPAActivityConstants.BTW24x4 + "',"+ // BTW2 Manejo 4x4
	        			"'" + CEPAActivityConstants.BTW4x4 + "',"+ // BTW Manejo 4x4
	        			"'" + CEPAActivityConstants.BTW3UPDATE + "',"+ // BTW3 Actualizacion
	        			"'" + CEPAActivityConstants.BTW3RENOVACION + "',"+ // BTW3 Actualizacion
	        			"'" + CEPAActivityConstants.BTWONBOARD + "',"+ // BTW on board
	        			"'" + CEPAActivityConstants.BTW2ONBOARD + "',"+ // BTW on board
	        			"'" + CEPAActivityConstants.BTWONBOARD_V2 + "',"+ // BTW on board
	        			"'" + CEPAActivityConstants.BTW2ONBOARD_V2 + "',"+ // BTW on board
	        			"'" + CEPAActivityConstants.BTW1ONBOARD_TABLET + "',"+ // BTW on board
	        			"'" + CEPAActivityConstants.BTW2ONBOARD_TABLET + "',"+ // BTW on board
	        			"'" + CEPAActivityConstants.HEAVY_VEHICLES_REPETITION + "',"+ // HEAVY VEHICLES REPETITION
	        			"'" + CEPAActivityConstants.HIDRO + "', " + //Hidroquimicos
	        			"'" + CEPAActivityConstants.BTW3SEGUNDARENOVACION + "',"+
	        			"'" + CEPAActivityConstants.BTW3TERCERARENOVACION + "',"+
	        			"'" + CEPAActivityConstants.BTW2UPM + "',"+
	        			"'" + CEPAActivityConstants.EBTW + "',"+
	        			"'" + CEPAActivityConstants.OUT_TRAINING + "' "; // Curso realizado por terceros (monsanto)

	        if(userRequest.isCorporation(CorporationData.BAYER_MX)) {
	        	queryStr2 += ",'"+CEPAActivityConstants.EBTW_TEORICO+"'";
	        }
            if(userRequest.getFilter().getCorporationId().intValue() == CorporationData.FORESTALORIENTAL) {
                queryStr2 += ",'"+CEPAActivityConstants.PESADOS_1+"'";
            }
            queryStr2 += ")"+subqueryStr+ ")" + " order by driver.lastName, driver.firstName";

            Query query = session.createQuery(queryStr2);
	        keys = parameters.keys();
	        while(keys.hasMoreElements()) {
	            String parameter = (String)keys.nextElement();
	            query.setParameter(parameter,parameters.get(parameter));
	        }

            if(count != -1) {
                query.setFirstResult(first);
                query.setMaxResults(count);
            }

            List userColl = query.list();
            iter = userColl.iterator();
            userColl=null;
            while (iter.hasNext()) {
              	Driver driver = (Driver) iter.next();
                result.add(driver.getDriverReportData2("detailed"));
            }
            session.close();

            return new ListResult(result,total.intValue());

    }

   /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityview,cepascheduleactivityregistryview"
     */
    public Collection driversWithoutTOJ(UserSessionData userSessionData,Integer[][] divOrgs,Integer[][] divGeos, String driverType,String[] vehicleAllowed) throws Exception {
        Collection result = new LinkedList();
    	try {

    		Session session = HibernateUtil.currentSession();
	        Hashtable parameters = new Hashtable();

	        String sql = "select d.id, d.firstname, d.lastname, d.director, d.vehicleAllowed, d.licenseobs, cc.resourcekey as country, d1.resourcekey as div1, d2.resourcekey as div2, d3.resourcekey as div3, " +
	        		"d4.resourcekey as div4, c.date ,c.expiry";
	        sql += " from drivers d ";
	        sql += " join country cc on cc.id = d.country ";
	        sql += " join divorgitemlevel1s d1 on d1.id = d.divorg1 ";
	        sql += " join divorgitemlevel1s d3 on d3.id = d.divorg2 ";
	        sql += " join divorgitemlevel2s d2 on d2.id = d3.divorgitemlevel2 ";
	        sql += " join divorgitemlevel1s d4 on d4.id = d.divorg3 ";
	        sql += " left join (select ar.driver, max(ca.date) as date, max(ca.dateexpiry) as expiry " +
	        		"from activityregistry ar " +
	        		"join cepaactivity ca on ca.activityid = ar.activity " +
	        		"where ca.corporation = "+userSessionData.getCorporationId()+
	        		" and ca.type in ('"+CEPAActivityConstants.TRANINGONTHEJOB+"','"+CEPAActivityConstants.SPECIALDAYOFTRAINING+"') " +
	        		"group by driver) c on d.id = c.driver";
	        sql += UtilityQuery.corporationDivisionsRestictionsSQL("d", userSessionData);
	        sql += " and d.id not in (select ar.driver " +
	        		"from activityregistry ar " +
	        		"join cepaactivity ca on ca.activityid = ar.activity " +
	        		"where ca.corporation = "+userSessionData.getCorporationId()+
	        		" and ca.type in ('"+CEPAActivityConstants.TRANINGONTHEJOB+"','"+CEPAActivityConstants.SPECIALDAYOFTRAINING+"') " +
	        		"and ca.dateexpiry > NOW())";


	        HashSet set = new HashSet();
	        String divOrgStr = "";
	        if(divOrgs != null && divOrgs.length > 0) {
	            for(int j = 0; j < divOrgs.length; j++) {
	                if(divOrgs[j] != null && divOrgs[j].length > 0) {
	                	divOrgStr = "";
	                    divOrgStr = " and d.divorg"+String.valueOf(j+1)+" in (";
	                    set = new HashSet();
	                    for(int i = 0; i < divOrgs[j].length; i++) {
	                    	set.add(divOrgs[j][i]); // Para evitar repetidos
	                    }
	                    Iterator it = set.iterator();
	                    int i = 0;
	                    while (it.hasNext()){
	                    	String div = ((Integer)it.next()).toString();
	                    	divOrgStr += div;
	                        divOrgStr += (i == set.size()-1) ? ") " : ",";
	                        i++;
	                    }
	                    sql += divOrgStr;
	                }
	            }
	        }

	        if(divGeos != null) {
	            if(divGeos[0] != null && divGeos[0].length > 0) {
	            	sql += "and d.country in (";
	                for(int i = 0; i < divGeos[0].length; i++) {
	                	sql += divGeos[0][i];
	                	sql += (i == divGeos[0].length-1) ? ")" : ",";
	                }
	            }
	        }

	        if (driverType.equals("generic.messages.active")) {
	        	sql += " and d.exclusionDate is null";
	        }

	        if (driverType.equals("generic.messages.excluded")) {
	        	sql += " and d.exclusionDate is not null";
	        }
	        if (vehicleAllowed != null && vehicleAllowed.length > 0 && !(vehicleAllowed.length == 1 && vehicleAllowed[0].length() == 0)) {
	            sql += " and d.vehicleAllowed IN (";
	        	for(int i = 0; i < vehicleAllowed.length; i++) {
	        		sql += "'"+vehicleAllowed[i]+"'";
	        		if(i < vehicleAllowed.length-1)
	        			sql += ",";
	        	}
	            sql += ") ";
	        }
	        sql += " order by firstname, lastname, date desc";


	        SQLQuery query = session.createSQLQuery(sql);
	        query.addScalar("id",Hibernate.INTEGER);
	        query.addScalar("firstname",Hibernate.STRING);
	        query.addScalar("lastname",Hibernate.STRING);
	        query.addScalar("director",Hibernate.BOOLEAN);
	        query.addScalar("vehicleAllowed",Hibernate.STRING);
	        query.addScalar("licenseobs",Hibernate.STRING);
	        query.addScalar("country",Hibernate.STRING);
	        query.addScalar("div1",Hibernate.STRING);
	        query.addScalar("div2",Hibernate.STRING);
	        query.addScalar("div3",Hibernate.STRING);
	        query.addScalar("div4",Hibernate.STRING);
	        query.addScalar("date",Hibernate.DATE);
	        query.addScalar("expiry",Hibernate.DATE);

	        List userColl = query.list();
	        Iterator iter = userColl.iterator();
	        userColl=null;
	        while (iter.hasNext()) {
	        	DriverReportDataType driver = new DriverReportDataType();
	        	Object[] data = (Object[])iter.next();
	        	driver.setId((Integer)data[0]);
	        	driver.setFirstname((String)data[1]);
	        	driver.setLastname((String)data[2]);
	        	driver.setDirector(((Boolean)data[3]).booleanValue());
	        	driver.setAssignedVehicle((String)data[4]);
	        	driver.setLicenseObs((String)data[5]);
	        	driver.setCountry((String)data[6]);
	        	driver.setDivorg11((String)data[7]);
	        	driver.setDivorg21((String)data[8]);
	        	driver.setDivorg22((String)data[9]);
	        	driver.setDivorg31((String)data[10]);
	        	if(data[11] != null) {
	        		driver.setLastHRD((Date)data[11]);
	        		driver.setExpiry((Date)data[12]);
	        	}
	        	result.add(driver);
	        }
	        session.close();
    	}catch (Exception e) {
        	Object[] parameters = {divOrgs,divGeos,driverType,vehicleAllowed};
	        handler.getException(e,"driversWithoutTOJ",userSessionData,parameters);
		}
        return result;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityview,cepascheduleactivityregistryview,query"
     * @param userRequest
     * @return
     * @throws Exception
     *
     * Devuelve la lista de las CEPAAtivityDefinitionData
     * que tienen true en hasTeoricoAsistence y en hasPracticoAsistence
     */
    public ListResult getActivitiesWithTeoricoAndPracticoAsistence(
    		UserSessionData userRequest) throws Exception{
    	try{
    		Session session = HibernateUtil.currentSession();
    	 	String queryStr = "SELECT definition FROM CEPAActivityDefinition as definition " +
        		" WHERE hasTeoricoAsistence = true and hasPracticoAsistence = true";

    	 	Query queryAux = session.createQuery(queryStr);
    	 	List activityColl = queryAux.list();
		    Iterator iter = activityColl.iterator();
		    LinkedList result = new LinkedList();
			while (iter.hasNext()) {
				CEPAActivityDefinition resourceKeyName = (CEPAActivityDefinition)iter.next();
				result.add(resourceKeyName.getCEPAActivityDefinitionData());
			}
    	 	return new ListResult(result,result.size());
	    }catch (Exception e) {
        	Object[] parameters = {};
	        handler.getException(e,"getActivitiesWithTeoricoAndPracticoAsistence",userRequest,parameters);
	    }
    	return null;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityview,cepascheduleactivityregistryview,query"
     */
    public ListResult  driversBTWAssist(UserSessionData userRequest,Date initialDate,Date lastDate,Integer[][] divOrgs,Integer[][] divGeos,String driverType,	int first, int count, boolean notPracticoAsistence,boolean notTeoricoAsistence, String type, String vehicleAllowed) throws Exception {
        Session session = HibernateUtil.currentSession();
        Hashtable parameters = new Hashtable();

        Collection result = new LinkedList();
        String queryStr = UtilityQuery.corporationDivisionsRestictions("registry.driver",userRequest);

        HashSet set = new HashSet();
        String divOrgStr = "";
        if(divOrgs != null && divOrgs.length > 0) {
            for(int j = 0; j < divOrgs.length; j++) {
                if(divOrgs[j] != null && divOrgs[j].length > 0) {
                	divOrgStr = "";
                    divOrgStr = " and registry.driver.divOrg"+String.valueOf(j+1)+" in (";

                    // Limpio el Set
                    set = new HashSet();

                    for(int i = 0; i < divOrgs[j].length; i++) {
                    	set.add(divOrgs[j][i]); // Para evitar repetidos
                    }
                    Iterator it = set.iterator();
                    int i = 0;
                    while (it.hasNext()){
                    	String div = ((Integer)it.next()).toString();
                    	divOrgStr += div;
                        divOrgStr += (i == set.size()-1) ? ") " : ",";
                        i++;
                    }
                    System.out.println(divOrgStr);
                    queryStr += divOrgStr;
                }
            }
        }

        if(divGeos != null) {
            if(divGeos[0] != null && divGeos[0].length > 0) {
                queryStr += "and registry.driver.corpCountry.pk.country in (";
                for(int i = 0; i < divGeos[0].length; i++) {
                    queryStr += divGeos[0][i];
                    queryStr += (i == divGeos[0].length-1) ? ")" : ",";
                }
            }
        }

        if (driverType.equals("generic.messages.active")) {
        	queryStr += " and registry.driver.exclusionDate is null";
        }

        if (driverType.equals("generic.messages.excluded")) {
        	queryStr += " and registry.driver.exclusionDate is not null";
        }

        if (!Util.empty(vehicleAllowed) && !vehicleAllowed.equals("datatype.vehicletype.all")) {
            queryStr += " and registry.driver.vehicleAllowed = '"+vehicleAllowed+"' ";
        }

        String subqueryStr ="";

        // solo tomo en cuenta las actividades finalizadas
        subqueryStr += " and registry.activity.state = '" + CEPAActivityConstants.DICTADA + "'";

        String practico = "";
        String teorico = "";

        if (notPracticoAsistence){
        	practico = "and registry.practicoAsistence = false ";
        }

        if (notTeoricoAsistence){
        	teorico = "and registry.teoricoAsistence = false ";
        }

        String queryType = "";
        if (type.equalsIgnoreCase("datatype.scheduledactivitytype.btw")){
        	// Listo todas los tipos de BTW
        	queryType = " (" +
        			"'" + CEPAActivityConstants.BTW1 + "'," + // BTW1
        			"'" + CEPAActivityConstants.BTW2 + "'," + // BTW2
        			"'" + CEPAActivityConstants.BTW3 + "'," + // BTW3
        			"'" + CEPAActivityConstants.BTW2SPV + "',"+ // BTW2/SPV
        			"'" + CEPAActivityConstants.BTW24x4 + "',"+ // BTW2 Manejo 4x4
        			"'" + CEPAActivityConstants.BTW3RENOVACION + "',"+ // BTW3 Renovacion
        			"'" + CEPAActivityConstants.BTW3UPDATE + "', "+  // BTW3 Actualizacion

        			"'" + CEPAActivityConstants.HEAVY_VEHICLES_REPETITION + "',"+ // HEAVY VEHICLES REPETITION
        			"'" + CEPAActivityConstants.HIDRO + "', " + //Hidroquimicos
        			"'" + CEPAActivityConstants.OUT_TRAINING + "' " +// Curso realizado por terceros (monsanto)
        			") ";


        			;
        }else{
        	// Listo el tipo de Actividad seleccionado:
        	queryType = " ('"+type+"') ";
        }

        Query queryAux = session.createQuery(
        		" 	select count (registry.driver) " +
        		"	from CEPAScheduleActivityRegistry as registry" +
        				queryStr +
        		"		and " +
        		"		registry.activity.corpCountry.pk.corporation.id = " +userRequest.getFilter().getCorporationId()+" and "+
        		"		registry.activity.type in " +
        				queryType +
        				practico +
        				teorico +
        				subqueryStr +

        		// Ultimo btw:
        		"		and "+
     			" 		registry.activity.date in (" +
     			"			select max (registry2.activity.date) " +
     			"			from CEPAScheduleActivityRegistry as registry2 " +
				"			where registry2.activity.corpCountry.pk.corporation.id = "+userRequest.getFilter().getCorporationId()+
     			"				and registry2.activity.type in " + queryType +
        		"				and registry2.driver.id = registry.driver.id"+
        		"		) ");

	        Enumeration keys = parameters.keys();
	        while(keys.hasMoreElements()) {
	            String parameter = (String)keys.nextElement();
	            queryAux.setParameter(parameter,parameters.get(parameter));
	        }

			List activityColl = queryAux.list();
		    Iterator iter = activityColl.iterator();
		    Integer total = new Integer(0);
			while (iter.hasNext()) {
			    total = new Integer(((Long) iter.next()).intValue());
			}

	        //System.out.println("TOTAL:"+total);


	        Query query = session.createQuery(
	         		" 	select registry.driver, registry.activity.date, registry.activity.type " +
	        		"	from CEPAScheduleActivityRegistry as registry" +
	        				queryStr + " and "+
	        		"		registry.activity.corpCountry.pk.corporation.id = " +userRequest.getFilter().getCorporationId()+" and "+
	        		"		registry.activity.type in " +
	        				queryType
	        				+ practico
	        				+ teorico
	        				+ subqueryStr +

	        		// Ultimo btw:
               		"		and "+
	     			" 		registry.activity.date in (" +
	     			"			select max (registry2.activity.date)" +
	     			"			from CEPAScheduleActivityRegistry as registry2" +
					"			where registry2.activity.corpCountry.pk.corporation.id = "+userRequest.getFilter().getCorporationId()+
	     			"				and registry2.activity.type in " + queryType +
	        		"				and registry2.driver.id = registry.driver.id"+
	        		"		)" +
	        		" 	order by registry.driver.lastName, registry.driver.firstName ");

	        keys = parameters.keys();
	        while(keys.hasMoreElements()) {
	            String parameter = (String)keys.nextElement();
	            query.setParameter(parameter,parameters.get(parameter));
	        }

            if(count != -1) {
                query.setFirstResult(first);
                query.setMaxResults(count);
            }

            List userColl = query.list();
            iter = userColl.iterator();
            userColl=null;
            while (iter.hasNext()) {
              	Object [] row = (Object [])iter.next();
              	Driver driver = (Driver) row[0];
              	DriverReportDataType drdt = driver.getDriverReportData("detailed");
              	Date date = (Date)row[1];
              	String btwType = ((CEPAActivityType)row[2]).getResourceBundleId();
                result.add(new DriversBTWData(drdt,date,btwType));
            }
            session.close();

            return new ListResult(result,total.intValue());

    }





    /**
     * Devuelve los conductores que no hicieron la Evaluación en Cabina
     * para Vehiculos Pesados (Forestales)
     * @param userRequest - logged user
     * @param type - type of activity
     * @param first - first index of the search to return
     * @param count - number of elements to return
     * @return result of the search
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query,cepascheduleactivityview"
     */
    public ListResult driversWithOutEC(UserSessionData userRequest,
    		Date initialDate,Date lastDate,Integer[][] divOrgs,Integer[][] divGeos, int status,
    		int first, int count, String firstName, String lastName)
    throws InvalidDataException, DeslogedException,CommunicationProblemException
    {
    	String sinCurso = "datatype.scheduledactivitytype.evaluacionencabinapesado";
        Session session = HibernateUtil.currentSession();
        Hashtable parameters = new Hashtable();
        Collection result = new LinkedList();
        String queryStr = UtilityQuery.corporationDivisionsRestictions("driver",userRequest);


        HashSet set = new HashSet();
        String divOrgStr = "";
        if(divOrgs != null && divOrgs.length > 0) {
            for(int j = 0; j < divOrgs.length; j++) {
                if(divOrgs[j] != null && divOrgs[j].length > 0) {
                	divOrgStr = "";
                    divOrgStr = " and driver.divOrg"+String.valueOf(j+1)+" in (";
                    set = new HashSet();
                    for(int i = 0; i < divOrgs[j].length; i++) {
                    	set.add(divOrgs[j][i]); // Para evitar repetidos
                    }
                    Iterator it = set.iterator();
                    int i = 0;
                    while (it.hasNext()){
                    	String div = ((Integer)it.next()).toString();
                    	divOrgStr += div;
                        divOrgStr += (i == set.size()-1) ? ") " : ",";
                        i++;
                    }
                    queryStr += divOrgStr;
                }
            }
        }

        if(divGeos != null) {
            if(divGeos[0] != null && divGeos[0].length > 0) {
                queryStr += "and driver.corpCountry.pk.country in (";
                for(int i = 0; i < divGeos[0].length; i++) {
                    queryStr += divGeos[0][i];
                    queryStr += (i == divGeos[0].length-1) ? ")" : ",";
                }
            }
        }

//      Driver State: Activo
		if (status == DriverData.ACTIVE)
		{
			queryStr +=" and driver.exclusionDate is null ";
		}
		// Driver State: Excluido
		if (status == DriverData.EXCLUDED)
		{
			queryStr +=" and driver.exclusionDate is not null ";
		}
		// First Name:
		if (!Util.empty(firstName)){
			queryStr += " and lower(driver.firstName) like '%"+firstName.toLowerCase()+"%' ";
       	}
       	// Last Name:
       	if (!Util.empty(lastName)){
       		queryStr += " and lower(driver.lastName) like '%"+lastName.toLowerCase()+"%' ";
		}

        String subqueryStr ="";

        // solo tomo en cuenta las actividades finalizadas
        subqueryStr += " and registry.activity.state = '" + CEPAActivityConstants.DICTADA + "'";

        Query queryAux = session.createQuery("select count(*) " +
        		" from Driver as driver " + queryStr +
        		" and driver.id " +
        		" not in (select registry.driver.id from CEPAScheduleActivityRegistry as registry" +
        		" where registry.activity.type in ('" + sinCurso + "')"
        		+subqueryStr+ ")");

	        Enumeration keys = parameters.keys();
	        while(keys.hasMoreElements()) {
	            String parameter = (String)keys.nextElement();
	            queryAux.setParameter(parameter,parameters.get(parameter));
	        }

			List activityColl = queryAux.list();
		    Iterator iter = activityColl.iterator();
		    Integer total = new Integer(0);
			while (iter.hasNext()) {
			    total = new Integer(((Long) iter.next()).intValue());
			}


	        Query query = session.createQuery("select driver " +
	        		"from Driver as driver " + queryStr +
	        		" and driver.id " +
	        		"not in (select registry.driver.id from CEPAScheduleActivityRegistry as registry" +
	        		" where registry.activity.type in ('"+ sinCurso + "')"
	        		+subqueryStr+ ")" + " order by driver.firstName, driver.lastName");

	        keys = parameters.keys();
	        while(keys.hasMoreElements()) {
	            String parameter = (String)keys.nextElement();
	            query.setParameter(parameter,parameters.get(parameter));
	        }

            if(count != -1) {
                query.setFirstResult(first);
                query.setMaxResults(count);
            }

            List userColl = query.list();
            iter = userColl.iterator();
            userColl=null;
            while (iter.hasNext()) {
              	Driver driver = (Driver) iter.next();
                result.add(driver.getDriverReportData("simple"));
            }
            session.close();

            return new ListResult(result,total.intValue());

    }

    /**
