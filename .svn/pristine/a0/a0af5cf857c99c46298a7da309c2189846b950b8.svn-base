    public Collection<ActivityObservationData> getObservations(Integer activityId, UserSessionData userRequest) throws Exception {
        try{

            Session session = HibernateUtil.currentSession();

            String queryStr = "select log from ActivityLog as log "+
                " where log.pk.activity = (:activity) ";

            Query query = session.createQuery(queryStr);
            query.setParameter("activity",activityId);

            List userColl = query.list();
            LinkedList<ActivityObservationData> result = new LinkedList<ActivityObservationData>();
            Iterator iter = userColl.iterator();
            while (iter.hasNext()) {
            	ActivityLog log = (ActivityLog) iter.next();
                result.add(log.getActivityObservations());
            }

            return result;

        }catch (Exception e) {
        	Object[] parameters = {activityId};
            handler.getException(e,"getObservations",userRequest,parameters);
        }
        return null;
    }

    /**
