    public CheckListData findCheckList(Integer checkId,UserSessionData userSessionData) throws Exception {
        try {
            Session session = HibernateUtil.currentSession();
            CheckList check = (CheckList)session.load(CheckList.class,checkId);
            if (check!=null){
            	return check.getCheckListData(userSessionData.getCorporationId());
            }
        }catch (Exception e) {
        	Object[] parameters = {checkId};
            handler.getException(e,"findCheckList",userSessionData,parameters);
        }
        return null;
    }

