    /**
     * @ejb.permission role-name = "cepascheduleactivityviewlist,cepascheduleactivityview,administrator"
     * @ejb.interface-method
     */
    public ListResult findActivityList(String startDay,String startMonth,String startYear,String endDay,String endMonth,String endYear,
            String type,String country,String city,String state,int first,int count,UserSessionData userSessionData) throws Exception {
        ListResult listResult=null;
        try{
            String activitiesForManager = "";
            if (userSessionData.isGerente()) {
                activitiesForManager = " AND (activity.type IN ('" +  CEPAActivityConstants.COMMENTARYDRIVE + "','" + CEPAActivityConstants.COMMENTARYDRIVEOTHER+"'";
                if(userSessionData.getCorporationId() == CorporationData.JJ) {
                	activitiesForManager += ",'"+ CEPAActivityConstants.SAFE_FLEET_MULTIPLIER_SPEECH + "','"+ CEPAActivityConstants.INITIAL_FOREIGN_EVALUATION + "," + CEPAActivityConstants.COMMENTARYDRIVE_RENOVATION + "','" + CEPAActivityConstants.COMMENTARYDRIVE_JJ2 + "','" + CEPAActivityConstants.COMMENTARYDRIVEOTHERSPECIAL+"'";
                }
                if(userSessionData.getCorporationId() == CorporationData.MONTES_DE_PLATA) {
                	activitiesForManager += ",'"+ CEPAActivityConstants.COMMENTARYDRIVECAYACO+"'";
                }
                activitiesForManager += ") ";
                if(!userSessionData.checkPermission(SecurityConstants.SUPERVISE_CEPASCHEDULEACTIVITY)) {
                	activitiesForManager += "OR activity.state = '" + CEPAActivityConstants.DICTADA+"'";
                }
                if(userSessionData.checkPermission(SecurityConstants.VIEW_CEPASYSTEM_PREVISTA)) {
                	activitiesForManager += " OR (activity.type = '"+CEPAActivityConstants.CEPA_SYSTEM_COURSE_2_ENTRENADORES+"') ";
                }
                activitiesForManager += " )";
            } else if (userSessionData.getRole().getName().equals(RoleData.CDS)) {
            	activitiesForManager = " AND activity.type IN ('"+CEPAActivityConstants.CEPA_SYSTEM_COURSE_2_ENTRENADORES+"','"+CEPAActivityConstants.COMMENTARYDRIVECAYACO+"') AND activity.activityid IN (SELECT activity FROM activityregistry WHERE trim(instructor) = '"+userSessionData.getFilter().getFirstName()+" "+userSessionData.getFilter().getLastName()+"') ";
            }

            Session session = HibernateUtil.currentSession();
            String queryCountStr = "SELECT COUNT(*) AS count FROM cepaactivity AS activity "+UtilityQuery.corporationDivisionsRestictionsSQL("activity",userSessionData);
            if(Util.isDate(startDay,startMonth,startYear)) {
                queryCountStr += " AND activity.date >= '"+startYear+"-"+startMonth+"-"+startDay+"'";
            }
            if(Util.isDate(endDay,endMonth,endYear)) {
                queryCountStr += " AND date(activity.date) <= '"+endYear+"-"+endMonth+"-"+endDay+"'";
            }
            if((type != null) && (!type.equals("")) ) {
	            if(userSessionData.getCorporationId() == CorporationData.MONSANTO && type.equals(CEPAActivityConstants.COMMENTARYDRIVEARGENTINA_NUEVO)) {
	                queryCountStr += " AND activity.type IN ('"+CEPAActivityConstants.COMMENTARYDRIVEARGENTINA_NUEVO+"','"+CEPAActivityConstants.COMMENTARYDRIVEARGENTINA+"')";
	            }else {
	                queryCountStr += " AND activity.type = '"+type+"'";
	            }
            }
            if((country != null) && (!country.equals(""))) {
                queryCountStr += " AND activity.country = "+country;
            }
            if(!Util.empty(city)) {
                queryCountStr +=" AND lower(activity.city) = '"+city.toLowerCase()+"'";
            }
            if((state != null) && (!state.equals(""))) {
                queryCountStr += " AND activity.state = '"+state+"'";
            }
            queryCountStr += activitiesForManager;
            Query queryCount = session.createSQLQuery(queryCountStr).addScalar("count",Hibernate.INTEGER);
            Integer total = (Integer)queryCount.uniqueResult();

            String[] fields = userSessionData.getFilter().getFields("activity");
            String queryStr = "SELECT activity.activityid,activity.type,c.resourcekey,activity.date,activity.city,activity.state"+fields[0];
            queryStr += " FROM cepaactivity AS activity,country c" +fields[1];
            queryStr += UtilityQuery.corporationDivisionsRestictionsSQL("activity",userSessionData);
            queryStr += " AND activity.country = c.id "+fields[2];
            if(Util.isDate(startDay,startMonth,startYear)) {
                queryStr += " AND activity.date >= '"+startYear+"-"+startMonth+"-"+startDay+"'";
            }
            if(Util.isDate(endDay,endMonth,endYear)) {
                queryStr += " AND date(activity.date) <= '"+endYear+"-"+endMonth+"-"+endDay+"'";
            }
            if((type != null) && (!type.equals("")) ) {
	            if(userSessionData.getCorporationId() == CorporationData.MONSANTO && type.equals(CEPAActivityConstants.COMMENTARYDRIVEARGENTINA_NUEVO)) {
	                queryStr += " AND activity.type IN ('"+CEPAActivityConstants.COMMENTARYDRIVEARGENTINA_NUEVO+"','"+CEPAActivityConstants.COMMENTARYDRIVEARGENTINA+"')";
	            }else {
	                queryStr += " AND activity.type = '"+type+"'";
	            }
            }
            if((country != null) && (!country.equals(""))) {
                queryStr += " AND activity.country = "+country;
            }
            if(!Util.empty(city)) {
                queryStr +=" AND lower(activity.city) = '"+city.toLowerCase()+"'";
            }
            if((state != null) && (!state.equals(""))) {
                queryStr += " AND activity.state = '"+state+"'";
            }
            queryStr += activitiesForManager;
            queryStr += " ORDER BY date DESC";
            SQLQuery query = session.createSQLQuery(queryStr);
            query.addScalar("activityid",Hibernate.INTEGER);
            query.addScalar("type",Hibernate.STRING);
            query.addScalar("resourcekey",Hibernate.STRING);
            query.addScalar("date",Hibernate.DATE);
            query.addScalar("city",Hibernate.STRING);
            query.addScalar("state",Hibernate.STRING);
            StringTokenizer token = new StringTokenizer(fields[3],",");
            while(token.hasMoreTokens()) {
                query.addScalar(token.nextToken(), Hibernate.STRING);
            }

            if(count != -1) {
                if(total.intValue() < first) {
                    if(total.intValue() % count == 0) {
                        first = total.intValue() - count;
                    }else {
                        first = total.intValue() - (total.intValue() % count);
                    }
                }
                query.setFirstResult(first);
                query.setMaxResults(count);
            }

            Iterator it = query.list().iterator();
            Collection elements = new LinkedList();
            while(it.hasNext()) {
                elements.add(new ActivityListData((Object[])it.next()));
            }
            listResult = new ListResult(elements,total.intValue());
        }catch(Exception e){
        	Object[] parameters = {startDay,startMonth,startYear,endDay,endMonth,endYear,type,country,city,state,String.valueOf(first),String.valueOf(count)};
            handler.getException(e,"findCEPAScheduleActivityList",userSessionData,parameters);
        }
        return listResult;
    }

	/**
     * @ejb.permission role-name = "cepascheduleactivityviewlist,cepascheduleactivityview,administrator"
	 * @throws InvalidDataException
	 * @throws DeslogedException
	 * @throws CommunicationProblemException
	 * @ejb.interface-method
	 */

	public ListResult findCEPAScheduleActivityList(String value, UserSessionData userRequest,
		int attribute,int first,int count) throws Exception {

		ListResult listResult=null;

		try{
				Session session = HibernateUtil.currentSession();

				String queryStr = "select count(*)" +
		          "from CEPAActivity as activity" +
		           UtilityQuery.corporationDivisionsRestictions("activity",userRequest);

				// Los gerentes solo ven actividades dictadas o actividades commentary en todos los estados
				String activitiesformanager = "";
				if (userRequest.isGerente()) {
					activitiesformanager += " and (activity.type in ('" + CEPAActivityConstants.COMMENTARYDRIVE + "','" +
							CEPAActivityConstants.COMMENTARYDRIVEOTHER + "') " +
							"or activity.state = '" + CEPAActivityConstants.DICTADA + "')";
				}

				queryStr += activitiesformanager;
				Query query = getQuery(session,attribute,queryStr,value,userRequest,false);

				List activityColl = query.list();
			    Iterator iter = activityColl.iterator();
			    Integer total = new Integer(0);
				while (iter.hasNext()) {
				    total = ((Long) iter.next()).intValue();
				}

				queryStr = " select activity " +
					       " from CEPAActivity as activity " +
					       UtilityQuery.corporationDivisionsRestictions("activity",userRequest);

				/* Muestro el SQL para debuguear */
				// System.out.println("SQL:" + queryStr);

				queryStr += activitiesformanager;
				query = getQuery(session,attribute,queryStr,value,userRequest,true);

				if(count != -1) {
				    if(total.intValue() < first) {
				        if(total.intValue() % count == 0) {
					        first = total.intValue() - count;
				        }else {
				            first = total.intValue() - (total.intValue() % count);
				        }
				    }
				    query.setFirstResult(first);
				    query.setMaxResults(count);
				}

				activityColl = query.list();
			    Collection result = new LinkedList();
			    iter = activityColl.iterator();
				while (iter.hasNext()) {
					CEPAScheduleActivity activity = (CEPAScheduleActivity) iter.next();
					result.add(activity.getCEPAScheduleActivityData());
				}

				listResult = new ListResult(result, total.intValue());

		}catch(Exception e){
        	Object[] parameters = {value,String.valueOf(attribute),String.valueOf(first),String.valueOf(count)};
			handler.getException(e,"findCEPAScheduleActivityList",userRequest,parameters);
		}
		return listResult;
	}





	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "cepascheduleactivityview,administrator,driverviewowndata,hrdbrasilquery,hrdphrdquery,eventcreate,eventview,jjreporter"
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     */
    public Collection findActivityByDriver(UserSessionData userRequest,Integer driverId,boolean dictated) throws Exception {
        Collection result = new LinkedList();
        try{
        	String queryStr="";
        	Session session = HibernateUtil.currentSession();
        	boolean withoutFilter = (userRequest.getCorporationId() == CorporationData.JJ || userRequest.isForestalUnified() || userRequest.isReporterJJ());
        	if(!dictated){
        		queryStr = "SELECT activity FROM CEPAScheduleActivityRegistry AS activity ";
                if(userRequest.isDriver() || userRequest.isReporterJJ() || withoutFilter) {
                    queryStr += " WHERE activity.activity.corpCountry.pk.corporation.id = "+
                    userRequest.getFilter().getCorporationId()+" ";
                }else {
                    queryStr += UtilityQuery.corporationDivisionsRestictions("activity.activity",userRequest);
                }
            }else if (dictated){
            	queryStr = "select activity from CEPAScheduleActivityRegistry as activity ";
                if(userRequest.isDriver() || userRequest.isReporterJJ() || withoutFilter) {
                    queryStr += " WHERE activity.activity.corpCountry.pk.corporation.id = "+
                    userRequest.getFilter().getCorporationId();
                }else {
                    queryStr += UtilityQuery.corporationDivisionsRestictions("activity.activity",userRequest);
                }
                queryStr += " and activity.activity.activityId in " +
                		"(select cepaactivity.activityId from CEPAActivity as cepaactivity " +
                		"where cepaactivity.activityId = activity.activity.activityId)";
            }

            queryStr += " and activity.driver.id = (:driver))";

            Query query = session.createQuery(queryStr);
            if(userRequest.isDriver()) {
                query.setParameter("driver",userRequest.getDriverData().getId());
            }else {
                query.setParameter("driver",driverId);
            }

            Iterator iter = query.list().iterator();
            while (iter.hasNext()) {
            	CEPAScheduleActivityRegistry activity = (CEPAScheduleActivityRegistry) iter.next();
            	result.add(activity.getCEPAScheduleActivityData());
            }
        }catch (Exception e) {
        	e.printStackTrace();
        	Object[] parameters = {driverId,String.valueOf(dictated)};
			handler.getException(e,"findActivityByDriver",userRequest,parameters);
        }
        return result;
    }

	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "cepascheduleactivityview,administrator,eventview"
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     */
    public Collection findActivityByDriverForestales(UserSessionData userSessionData,Integer driverId,boolean dictated,int index,Integer originalDriver) throws Exception {
        Collection result = new LinkedList();
        try{
        	String queryStr="";
        	Session session = HibernateUtil.currentSession();
        	int[] corporations = new int[]{CorporationData.FORESTALORIENTAL,CorporationData.WEYERHAEUSER,CorporationData.MONTES_DE_PLATA};
        	String[] corporationsName = {"fosa","weyerhauser","mdp"};
    		queryStr = "SELECT activity FROM CEPAScheduleActivityRegistry AS activity ";
            queryStr += " WHERE activity.activity.corpCountry.pk.corporation.id = "+corporations[index];
            if (dictated){
                queryStr += " and activity.activity.activityId in " +
                		"(select cepaactivity.activityId from CEPAActivity as cepaactivity " +
                		"where cepaactivity.activityId = activity.activity.activityId and " +
                		"cepaactivity.state.resourceBundleId= 'datatype.scheduledactivitystate.dictada')";
            }
            queryStr += " and activity.activity.activityId not in (select "+corporationsName[index]+" from ActivityLink where pk.driver = "+originalDriver+")";
            queryStr += " and activity.driver.id = (:driver))";

            Query query = session.createQuery(queryStr);
            query.setParameter("driver",driverId);

            Iterator iter = query.list().iterator();
            while (iter.hasNext()) {
            	CEPAScheduleActivityRegistry activity = (CEPAScheduleActivityRegistry) iter.next();
            	CEPAActivityScheduleRegistryData regData = activity.getCEPAScheduleActivityData();
            	regData.setCorporation(corporations[index]);
            	result.add(regData);
            }
        }catch (Exception e) {
        	Object[] parameters = {driverId,String.valueOf(dictated)};
			handler.getException(e,"findActivityByDriver",userSessionData,parameters);
        }
        return result;
    }

    public Query getQuery(Session session, int attribute,String queryStr, String value, UserSessionData userRequest,boolean addOrder) throws Exception {
		try{

			//Check data integrity
			if (value == null) {
				throw new InvalidDataException("Class persistence.activity.ActivityReport(findActivityByLike), value name is empty",	"generic.driver.driverdata.valueempty");
			}
			if (userRequest == null) {
				throw new DeslogedException("An error has ocurred in persistence.activity.ActivityReportBean(findUserByLike), session data is empty","generic.error.deslogued");
			}

			boolean hayParametro = false;
			if (!value.equals("")) {
				switch (attribute) {
				case ActivityData.TYPE:
					queryStr += " and (activity.type = :value )";
					hayParametro = true;
					break;
				case ActivityData.STATE:
					queryStr += " and (activity.state = :value )";
					hayParametro = true;
					break;
				case ActivityData.DATE:
					queryStr += " and  ( (activity.date > :value ) OR (activity.date =:value) )";
					hayParametro = true;
					break;
				default:
					throw new InvalidDataException(
							"Class persistence.activity.ActivityReport(findActivityByLike), atttribute name is mot right",
					"generic.activity.activitydata.invalidattribute");
				}
			}

			if (addOrder) {
				queryStr += " order by activity.date ";
			}

			Query query = session.createQuery(queryStr);

			if (hayParametro) {
				query.setParameter("value",value);
			}

			return query;

		}catch (Exception e) {
        	Object[] parameters = {attribute,queryStr,value,addOrder};
			handler.getException(e,"getQuery",userRequest,parameters);
		}
		return null;
	}

	/**
	 * @throws InvalidDataException
	 * @throws DeslogedException
	 * @throws CommunicationProblemException
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,eventcreate,finecreate,cepascheduleactivityview,cepascheduleactivityupdate,cepascheduleactivityregistrycreate,cepascheduleactivityregistryupdate,cdactivitycreate,cdactivitymodify,driverviewowndata"
	 */

	public CEPAActivityScheduleData findCEPAActivityScheduleByPrimaryKey(Integer id, boolean restrictions, UserSessionData userRequest) throws Exception {
		//Check data integrity
		Session session = null;
		CEPAActivityScheduleData data = null;
		try {
			if (id != null && userRequest != null){
				session = HibernateUtil.currentSession();
                String sql = "SELECT activity FROM CEPAActivity as activity ";
                if(userRequest.isDriver()
                		|| (!restrictions && (userRequest.getCorporationId() == CorporationData.JJ || userRequest.getCorporationId() == CorporationData.FORESTALORIENTAL))
                		|| (userRequest.isContractor() && userRequest.isForestalUnified())) {
                    sql += " WHERE activity.corpCountry.pk.corporation.id = "+userRequest.getFilter().getCorporationId();
                }else {
                    sql += UtilityQuery.corporationDivisionsRestictions("activity",userRequest);
                }
                sql += " AND activity.activityId = :id";
				Query query = session.createQuery(sql);
			    query.setParameter("id", id);

	            Object result = query.uniqueResult();
	            if(result != null) {
	            	CEPAScheduleActivity activity = (CEPAScheduleActivity)result;
	            	if (activity != null){
	            		Set instructors = activity.getInstructorSet();
	            		data = activity.getCEPAScheduleActivityData();
	            	}
	            }
			}
		}catch(Exception e){
        	Object[] parameters = {id};
            handler.getException(e,"findCEPAActivityScheduleByPrimaryKey",userRequest,parameters);
		}
		return data;
	}



    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate,cepascheduleactivitydelete,cdactivitymodify,cdactivitydelete"
     */
    public List getActivities(String activities, UserSessionData userRequest) throws Exception {

        try{

            Session session = HibernateUtil.currentSession();

            String queryStr = "select activity from  CEPAActivity as activity "+
            " where activity.activityId in ("+activities+") order by activity.date";

            Query query = session.createQuery(queryStr);
            List userColl = query.list();
            List result = new LinkedList();
            Iterator iter = userColl.iterator();
            while (iter.hasNext()) {
            	/*CEPAActivity activity = (CEPAActivity) iter.next();
                result.add(activity.getCEPAActivityData());
                */
            	CEPAScheduleActivity activity = (CEPAScheduleActivity) iter.next();
                result.add(activity.getCEPAScheduleActivityData());
            }

            return result;

        }catch (Exception e) {
        	Object[] parameters = {activities};
            handler.getException(e,"getActivities",userRequest,parameters);
        }

        return null;
    }


    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityregistryupdate,cepascheduleactivityregistrydelete,cdactivitydelete,cdactivitymodify"
     */
    public List getDrivers(String drivers,UserSessionData userRequest) throws Exception {

        try{

            Session session = HibernateUtil.currentSession();
            String queryStr = "select driver from  Driver as driver "+
            " where driver.id in ("+drivers+")";

            Query query = session.createQuery(queryStr);
            List userColl = query.list();
            List result = new LinkedList();
            Iterator iter = userColl.iterator();
            while (iter.hasNext()) {
            	/*CEPAActivity activity = (CEPAActivity) iter.next();
                result.add(activity.getCEPAActivityData());
                */
            	Driver driver = (Driver) iter.next();
                result.add(driver.getDriverData());
            }

            return result;

        }catch (Exception e) {
        	Object[] parameters = {drivers};
            handler.getException(e,"getDrivers",userRequest,parameters);
        }

        return null;
    }
    /**
     * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,cepascheduleactivityview"
     * @param userRequest - logged user
     * @param type - type of activity
     * @param first - first index of the search to return
     * @param count - number of elements to return
     * @return result of the search
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
	 */
    public ListResult simpleSearch(UserSessionData userRequest, Date initialDate,Date lastDate, String type,String country,String city,String state, int first,int count) throws Exception {
    	try {
	        Session session = HibernateUtil.currentSession();

	        Hashtable parameters = new Hashtable();
	        String queryStr = UtilityQuery.corporationDivisionsRestictions("activity",userRequest);

	        //String queryStr = " where 1=1";

	        if(initialDate != null) {
	            queryStr +=" and activity.date >= (:date1)";
	            Calendar calendar1 = Calendar.getInstance();
	            calendar1.setTime(initialDate);
	            calendar1.set(Calendar.HOUR_OF_DAY,0);
	            calendar1.set(Calendar.MINUTE,0);
	            calendar1.set(Calendar.SECOND,0);
	            calendar1.set(Calendar.MILLISECOND,0);
	            parameters.put("date1",calendar1.getTime());
	        }

	        if(lastDate != null) {
	            queryStr +=" and activity.date <= (:date2)";
	            Calendar calendar2 = Calendar.getInstance();
	            calendar2.setTime(lastDate);
	            calendar2.set(Calendar.HOUR_OF_DAY,23);
	            calendar2.set(Calendar.MINUTE,59);
	            calendar2.set(Calendar.SECOND,59);
	            parameters.put("date2",calendar2.getTime());
	        }

	        if((type != null) && (!type.equals("")) ) {
	            queryStr +=" and activity.type = (:type)";
	            parameters.put("type",type);
	        }

	        if((country != null) && (!country.equals(""))) {
	            queryStr +=" and activity.corpCountry.pk.country = (:country)";
	            parameters.put("country",country);
	        }

	        if(city != null) {
	            queryStr +=" and lower(activity.city) like lower(:city)";
	            parameters.put("city","%"+city+"%");
	        }

	        if((state != null) && (!state.equals(""))) {
	            queryStr +=" and activity.state = (:state)";
	            parameters.put("state",state);
	        }


			String activitiesformanager = "";
			if (userRequest.isGerente()) {
				activitiesformanager += " and (activity.type= '" + CEPAActivityConstants.COMMENTARYDRIVE + "' " +
						"or activity.state = '" + CEPAActivityConstants.DICTADA + "')";
			}
			queryStr += activitiesformanager;

	        Query query = session.createQuery("select count(distinct activity.activityId)  from CEPAActivity as activity "+queryStr);
	        Enumeration keys = parameters.keys();
	        while(keys.hasMoreElements()) {
	            String parameter = (String)keys.nextElement();
	            query.setParameter(parameter,parameters.get(parameter));
	        }
	        List userColl = query.list();
	        Iterator iter = userColl.iterator();
	        Integer total = new Integer(0);
	        while (iter.hasNext()) {
	            total = new Integer(((Long) iter.next()).intValue());
	        }
	        queryStr += " order by activity.date";
	        query = session.createQuery("select activity from CEPAActivity as activity "+queryStr);
	        keys = parameters.keys();
	        while(keys.hasMoreElements()) {
	            String parameter = (String)keys.nextElement();
	            query.setParameter(parameter,parameters.get(parameter));
	        }
	        if(count != -1) {
	            if(total.intValue() < first) {
	                if(total.intValue() % count == 0) {
	                    first = total.intValue() - count;
	                }else {
	                    first = total.intValue() - (total.intValue() % count);
	                }
	            }
	            query.setFirstResult(first);
	            query.setMaxResults(count);
	        }
	        userColl = query.list();
	        Collection<CEPAActivityScheduleData> result = new LinkedList<CEPAActivityScheduleData>();
	        iter = userColl.iterator();
	        while (iter.hasNext()) {
	        	/*CEPAScheduleActivity activity = (CEPAScheduleActivity) iter.next();
	            result.add(activity.getCEPAActivityData());
	            */
	        	CEPAScheduleActivity activity = (CEPAScheduleActivity) iter.next();
	            result.add(activity.getCEPAScheduleActivityData());
	        }
	        session.close();

	        return new ListResult(result,total.intValue());

	    }catch (Exception e) {
	    	Object[] parameters = {initialDate,lastDate,type,country,city,state,first,count};
	        handler.getException(e,"simpleSearch",userRequest,parameters);
	    }
        return new ListResult(new LinkedList(),0);
    }

