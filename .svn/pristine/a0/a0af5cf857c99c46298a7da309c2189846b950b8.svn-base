    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate,cdactivitymodify"
     */
    public boolean existsAnyResultForActivity(Integer activityId, UserSessionData userRequest) throws Exception {

    	Collection participants = getParticipants(activityId,userRequest);

        Iterator iter = participants.iterator();
        boolean exists = false;
        while (iter.hasNext() && !exists) {
        	DriverData driver = (DriverData) iter.next();
        	exists = hasResult(activityId,driver.getId(),userRequest);
        }

    	return (exists);
    }

    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate,cdactivitymodify"
     */
    public boolean existsAnyDriverWithOutResultForActivity(Integer activityId, UserSessionData userRequest) throws Exception {

    	Collection participants = getParticipants(activityId,userRequest);

        Iterator iter = participants.iterator();

        if (participants.size() == 0) {
        	return true;
        }

        boolean exists = false;
        while (iter.hasNext() && !exists) {
        	DriverData driver = (DriverData) iter.next();
        	exists = !hasResult(activityId,driver.getId(),userRequest);
        }

    	return (exists);
    }

    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate,cdactivitymodify"
     */
    public boolean existsAnyTemporalDriverForActivity(Integer activityId, UserSessionData userRequest) throws Exception {

    	Collection participants = getParticipants(activityId,userRequest);

        Iterator iter = participants.iterator();

        if (participants.size() == 0) {
        	return true;
        }

        boolean exists = false;
        while (iter.hasNext() && !exists) {
        	DriverData driver = (DriverData) iter.next();
        	exists = driver.isTemporal();
        }

    	return (exists);
    }



    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate,cdactivitymodify"
     */
    public boolean existsCeroOrOneDriverWithOutResultForActivity(Integer activityId, UserSessionData userRequest,Integer idDriver) throws Exception {

    	Collection participants = getParticipants(activityId,userRequest);

        Iterator iter = participants.iterator();

        if (participants.size() == 0) {
        	return true;
        }

        boolean exists = false;
        int count = 0;
        while (iter.hasNext()) {
        	DriverData driver = (DriverData) iter.next();
        	exists = !hasResult(activityId,driver.getId(),userRequest) && !driver.getId().equals(idDriver);
        	if (exists) {
        		count++;
        	}
        }

    	return (count>0);
    }

