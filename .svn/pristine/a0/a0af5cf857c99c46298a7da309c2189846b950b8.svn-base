    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,activityreport"
     */
    public Collection getReportGeneralTraining(UserSessionData userRequest,Date initialDate,Date lastDate,
    		String type,String state, Integer[][] divOrgs, Integer[][] divGeos,int first,int count)

        throws InvalidDataException, DeslogedException,CommunicationProblemException {

        Session session = HibernateUtil.currentSession();

        Hashtable parameters = new Hashtable();
        String queryStr = UtilityQuery.corporationDivisionsRestictions("activity",userRequest);

        //String queryStr = " where 1=1";

        if(initialDate != null) {
            queryStr +=" and activity.date >= (:date1)";
            Calendar calendar1 = Calendar.getInstance();
            calendar1.setTime(initialDate);
            calendar1.set(Calendar.HOUR_OF_DAY,0);
            calendar1.set(Calendar.MINUTE,0);
            parameters.put("date1",calendar1.getTime());
        }

        if(lastDate != null) {
            queryStr +=" and activity.date < (:date2)";
            Calendar calendar2 = Calendar.getInstance();
            calendar2.setTime(lastDate);
            calendar2.set(Calendar.HOUR_OF_DAY,23);
            calendar2.set(Calendar.MINUTE,59);
            parameters.put("date2",calendar2.getTime());
        }

        if((type != null) && (!type.equals("")) ) {
            queryStr +=" and activity.type = (:type)";
            parameters.put("type",type);
        }

        if((state != null) && (!state.equals(""))) {
            queryStr +=" and activity.state = (:state)";
            parameters.put("state",state);
        }

        queryStr += " order by activity.date";
        Query query = session.createQuery("select count(distinct activity.activityId)  from CEPAActivity as activity "+queryStr);
        Enumeration keys = parameters.keys();
        while(keys.hasMoreElements()) {
            String parameter = (String)keys.nextElement();
            query.setParameter(parameter,parameters.get(parameter));
        }
        List userColl = query.list();
        Iterator iter = userColl.iterator();
        Integer total = new Integer(0);
        while (iter.hasNext()) {
            total = new Integer(((Long) iter.next()).intValue());
        }

        query = session.createQuery("select activity from CEPAActivity as activity "+queryStr);
        keys = parameters.keys();
        while(keys.hasMoreElements()) {
            String parameter = (String)keys.nextElement();
            query.setParameter(parameter,parameters.get(parameter));
        }
        if(count != -1) {
            if(total.intValue() < first) {
                if(total.intValue() % count == 0) {
                    first = total.intValue() - count;
                }else {
                    first = total.intValue() - (total.intValue() % count);
                }
            }
            query.setFirstResult(first);
            query.setMaxResults(count);
        }
        userColl = query.list();
        Collection result = new LinkedList();
        iter = userColl.iterator();
        while (iter.hasNext()) {
        	/*CEPAScheduleActivity activity = (CEPAScheduleActivity) iter.next();
            result.add(activity.getCEPAActivityData());
            */
        	CEPAScheduleActivity activity = (CEPAScheduleActivity) iter.next();
            result.add(activity.getCEPAScheduleActivityData());
        }
        session.close();

        return result;
    }


    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,activityreport,query"
     *
     * @param userRequest
     * @param initialDate
     * @param lastDate
     * @param divOrgs
     * @param divGeos
     * @param first
     * @param count
     * @param conductionType
     * @param countCD
     * @param driverState
     * @return ListResult
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     */
    public ListResult getReportCommentaryDrive(UserSessionData userRequest,Date initialDate, Date lastDate, Integer[][] divOrgs,Integer[][] divGeos,int first,int count,String conductionType, String countCD, int driverState,String vehicleAllowed,String type) throws Exception {
        Session session = HibernateUtil.currentSession();
        Integer total = new Integer(0);
        Collection result = new LinkedList();
    	try {
	    	String state = "datatype.scheduledactivitystate.dictada";

	        Hashtable parameters = new Hashtable();
	        StringBuffer queryStr = new StringBuffer();

	       	// From
	       	queryStr.append(" from CEPAScheduleActivityRegistry registry");

	       	// Construyo el Where de la consulta:
	       	// Permisos:
	      	queryStr.append(UtilityQuery.corporationDivisionsRestictions("registry.activity",userRequest));

	      	HashSet set = new HashSet();
	        String divOrgStr = "";
	        if(divOrgs != null && divOrgs.length > 0) {
	            for(int j = 0; j < divOrgs.length; j++) {
	                if(divOrgs[j] != null && divOrgs[j].length > 0) {
	                	divOrgStr = "";
	                    divOrgStr = " and registry.driver.divOrg"+String.valueOf(j+1)+".id in (";
	                    for(int i = 0; i < divOrgs[j].length; i++) {
	                    	set.add(divOrgs[j][i]); // Para evitar repetidos
	                    }
	                    Iterator it = set.iterator();
	                    int i = 0;
	                    while (it.hasNext()){
	                    	String div = ((Integer)it.next()).toString();
	                    	divOrgStr += div;
	                        divOrgStr += (i == set.size()-1) ? ") " : ",";
	                        i++;
	                    }
	                    queryStr.append(divOrgStr);
	                }
	            }
	        }
	        // Divisiones Geograficas
	        if(divGeos != null) {
	            if(divGeos[0] != null && divGeos[0].length > 0) {
	                queryStr.append("and registry.driver.corpCountry.pk.country.id in (");
	                for(int i = 0; i < divGeos[0].length; i++) {
	                    queryStr.append( divGeos[0][i] );
	                    queryStr.append( (i == divGeos[0].length-1) ? ")" : "," );
	                }
	            }
	        }
	      	// Fecha Inicial:
	       	if(initialDate != null) {
	       		queryStr.append(" and registry.activity.date >= (:date1)");
	       		Calendar calendar1 = Calendar.getInstance();
	       		calendar1.setTime(initialDate);
	       		calendar1.set(Calendar.HOUR_OF_DAY,0);
	       		calendar1.set(Calendar.MINUTE,0);
	       		parameters.put("date1",calendar1.getTime());
	       	}
	        // Fecha Final:
	        if(lastDate != null) {
	            queryStr.append(" and registry.activity.date < (:date2)");
	            Calendar calendar2 = Calendar.getInstance();
	            calendar2.setTime(lastDate);
	            calendar2.set(Calendar.HOUR_OF_DAY,23);
	            calendar2.set(Calendar.MINUTE,59);
	            parameters.put("date2",calendar2.getTime());
	        }
	        // Tipo de Acividad:
	        if((type != null) && (!type.equals("")) ) {
	            queryStr.append(" and registry.activity.type.resourceBundleId = (:type)");
	            parameters.put("type",type);
	        }
	        // Estado de la actividad:
	        if((state != null) && (!state.equals(""))) {
	            queryStr.append(" and registry.activity.state.resourceBundleId = (:state)");
	            parameters.put("state",state);
	        }

	        // Tipo de Conduccion comentada:
	        if(conductionType != null && !conductionType.equals("") && !conductionType.equals("0")) {
	            queryStr.append(" and registry.conductionType = (:conductionType)");
	            parameters.put("conductionType",conductionType);
	        }

	        // Driver State: Activo
	        if (driverState == DriverData.ACTIVE) {
	        	queryStr.append(" and registry.driver.exclusionDate is null");
	        }
	        // Driver State: Excluido
	        if (driverState == DriverData.EXCLUDED) {
	        	queryStr.append(" and registry.driver.exclusionDate is not null");
	        }
	        if(!Util.empty(vehicleAllowed) && !vehicleAllowed.equals("datatype.vehicletype.all")) {
	            queryStr.append(" and registry.driver.vehicleAllowed.resourceBundleId = '"+vehicleAllowed+"' ");
	        }

	        // Group By
	        queryStr.append(" group by registry.driver,registry.driver.lastName,registry.driver.firstName ");

	        // Cantidad de Commentary Drives en ese periodo
	        switch (Integer.parseInt(countCD))
	        {
	        	case 1:
	        		queryStr.append(" having count(*) = 1 ");break;
	        	case 2:
	        		queryStr.append(" having count(*) = 2 ");break;
	        	case 3:
	        		queryStr.append(" having count(*) > 2 ");break;
	        	case 12:
	        		queryStr.append(" having count(*) = 1 or count(*) = 2 ");break;
	        	case 123:
	        		queryStr.append(" having count(*) >= 1 ");break;
	        	case 23:
	        		queryStr.append(" having count(*) >= 2 ");break;
	        	default:
	        		queryStr.append(" having count(*) = 1 ");break;
	        }

	    	// Create Query
	    	Query query = session.createQuery("select sum(1) "+ queryStr.toString());
	    	// 	Seteo parametros
	    	Enumeration keys = parameters.keys();
	    	while(keys.hasMoreElements()) {
	    		String parameter = (String)keys.nextElement();
	    		query.setParameter(parameter,parameters.get(parameter));
	    	}
	    	// Corro la consulta para saber la cantidad de registros
	    	List userColl = query.list();
	    	// Determino la cantidad de registros de la consulta
	   		total = Integer.valueOf(userColl.size());
	    	System.out.println("Total de Registros de CD: "+total);

	   		// Select
	   		StringBuffer select = new StringBuffer();
	   		select.append("select registry.driver as driver,registry.driver.lastName as lastName,registry.driver.firstName as firstName, ");
	        select.append(" count(*) "); // Cantidad de Commentary Drives

	        // Order By
	        queryStr.append(" order by registry.driver.lastName, ");
	        queryStr.append(" registry.driver.firstName ");

	        query = session.createQuery(select.toString() + queryStr.toString());
	        keys = parameters.keys();
	        while(keys.hasMoreElements()) {
	            String parameter = (String)keys.nextElement();
	            query.setParameter(parameter,parameters.get(parameter));
	        }

	        if(count != -1) {
	            if(total.intValue() < first) {
	                if(total.intValue() % count == 0) {
	                    first = total.intValue() - count;
	                }else {
	                    first = total.intValue() - (total.intValue() % count);
	                }
	            }
	            query.setFirstResult(first);
	            query.setMaxResults(count);
	        }

	        Iterator iter = query.iterate();
	        while (iter.hasNext()) {
	        	Object[] obj = (Object[]) iter.next();
	        	ActivityReportCommentaryDriveDataType cd =  new ActivityReportCommentaryDriveDataType(
	        				((Driver)obj[0]).getDriverReportData2("detailed"),new Integer(((Long)obj[3]).intValue()));
	            result.add(cd);
	        }
    	}catch (Exception e) {
    		e.printStackTrace();
        	Object[] parameters = {initialDate,lastDate,divOrgs,divGeos,first,count,conductionType,countCD,driverState,vehicleAllowed,type};
			handler.getException(e, "getReportCommentaryDrive", userRequest, parameters);
		}
	    session.close();

        return new ListResult(result,total.intValue());
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,activityreport,query"
     *
     * @param userRequest
     * @param initialDate
     * @param lastDate
     * @param divOrgs
     * @param divGeos
     * @param first
     * @param count
     * @param conductionType
     * @param driverState (Activo, Excluido, Todos)
     * @return ListResult
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     */
    public ListResult getReportWithOutCommentaryDrive(UserSessionData userRequest,Date initialDate, Date lastDate, Integer[][] divOrgs,Integer[][] divGeos,int first,int count,String conductionType, int driverState, String vehicleAllowed, String type) throws Exception {
    	String state = "datatype.scheduledactivitystate.dictada";
        Session session = HibernateUtil.currentSession();
        Query query;
        List userColl;
        Collection result;
        Iterator iter;
        Hashtable parameters = new Hashtable();
        StringBuffer queryA = new StringBuffer();
        StringBuffer queryB = new StringBuffer();

        // Select datos from driver where dirverid IN (A-B)
        // donde A son todos los conductores
        // y B los conductores que tienen CD.


        // Calculo A
        queryA.append(" select driver.id ");
        queryA.append(" from Driver driver ");
      	queryA.append(UtilityQuery.corporationDivisionsRestictions("driver",userRequest));


      	HashSet set = new HashSet();
        String divOrgStr = "";
        if(divOrgs != null && divOrgs.length > 0) {
            for(int j = 0; j < divOrgs.length; j++) {
                if(divOrgs[j] != null && divOrgs[j].length > 0) {
                	divOrgStr = "";
                    divOrgStr = " and driver.divOrg"+String.valueOf(j+1)+".id in (";
                    for(int i = 0; i < divOrgs[j].length; i++) {
                    	set.add(divOrgs[j][i]); // Para evitar repetidos
                    }
                    Iterator it = set.iterator();
                    int i = 0;
                    while (it.hasNext()){
                    	String div = ((Integer)it.next()).toString();
                    	divOrgStr += div;
                        divOrgStr += (i == set.size()-1) ? ") " : ",";
                        i++;
                    }
                    System.out.println(divOrgStr);
                    queryA.append(divOrgStr);
                }
            }
        }

        // Divisiones Geograficas
        if(divGeos != null) {
            if(divGeos[0] != null && divGeos[0].length > 0) {
                queryA.append("and driver.corpCountry.pk.country.id in (");
                for(int i = 0; i < divGeos[0].length; i++) {
                    queryA.append( divGeos[0][i] );
                    queryA.append( (i == divGeos[0].length-1) ? ")" : "," );
                }
            }
        }
      	// Driver State: Activo
        if (driverState == DriverData.ACTIVE){
        	queryA.append(" and driver.exclusionDate is null");
        }
        // Driver State: Excluido
        if (driverState == DriverData.EXCLUDED){
        	queryA.append(" and driver.exclusionDate is not null");
        }
        if (!Util.empty(vehicleAllowed) && !vehicleAllowed.equals("datatype.vehicletype.all")){
            queryA.append(" and driver.vehicleAllowed.resourceBundleId = '"+vehicleAllowed+"' ");
        }
    	query = session.createQuery(queryA.toString());
      	userColl = query.list();
        iter = userColl.iterator();
        result = new LinkedList();
        while (iter.hasNext()) {
           	Integer id = (Integer) iter.next();
           	result.add(id);
        }


        // Calculo B
        queryB.append(" select registry.driver.id ");
       	queryB.append(" from CEPAScheduleActivityRegistry registry");
      	queryB.append(UtilityQuery.corporationDivisionsRestictions("registry.activity",userRequest));

      	set = new HashSet();
        divOrgStr = "";
        if(divOrgs != null && divOrgs.length > 0) {
            for(int j = 0; j < divOrgs.length; j++) {
                if(divOrgs[j] != null && divOrgs[j].length > 0) {
                	divOrgStr = "";
                    divOrgStr = " and registry.driver.divOrg"+String.valueOf(j+1)+".id in (";
                    for(int i = 0; i < divOrgs[j].length; i++) {
                    	set.add(divOrgs[j][i]); // Para evitar repetidos
                    }
                    Iterator it = set.iterator();
                    int i = 0;
                    while (it.hasNext()){
                    	String div = ((Integer)it.next()).toString();
                    	divOrgStr += div;
                        divOrgStr += (i == set.size()-1) ? ") " : ",";
                        i++;
                    }
                    queryB.append(divOrgStr);
                }
            }
        }

        // Divisiones Geograficas
        if(divGeos != null) {
            if(divGeos[0] != null && divGeos[0].length > 0) {
                queryB.append("and registry.driver.corpCountry.pk.country.id in (");
                for(int i = 0; i < divGeos[0].length; i++) {
                    queryB.append( divGeos[0][i] );
                    queryB.append( (i == divGeos[0].length-1) ? ")" : "," );
                }
            }
        }
        // Fecha Inicial:
       	if(initialDate != null) {
       		queryB.append(" and registry.activity.date >= (:date1)");
       		Calendar calendar1 = Calendar.getInstance();
       		calendar1.setTime(initialDate);
       		calendar1.set(Calendar.HOUR_OF_DAY,0);
       		calendar1.set(Calendar.MINUTE,0);
       		parameters.put("date1",calendar1.getTime());
       	}
        // Fecha final:
        if(lastDate != null) {
            queryB.append(" and registry.activity.date < (:date2)");
            Calendar calendar2 = Calendar.getInstance();
            calendar2.setTime(lastDate);
            calendar2.set(Calendar.HOUR_OF_DAY,23);
            calendar2.set(Calendar.MINUTE,59);
            parameters.put("date2",calendar2.getTime());
        }
        // Tipo de Actividad:
        if((type != null) && (!type.equals(""))){
            queryB.append(" and registry.activity.type.resourceBundleId = (:type)");
            parameters.put("type",type);
        }
        // Estado de la Actividad:
        if((state != null) && (!state.equals(""))) {
            queryB.append(" and registry.activity.state.resourceBundleId = (:state)");
            parameters.put("state",state);
        }
        // Tipo de Commentary Drive:
        if(conductionType != null && !conductionType.equals("") && !conductionType.equals("0")) {
            queryB.append(" and registry.conductionType = (:conductionType)");
            parameters.put("conductionType",conductionType);
        }
        // Driver State: Activo
        if (driverState == DriverData.ACTIVE){
        	queryB.append(" and registry.driver.exclusionDate is null");
        }
        // Driver State: Excluido
        if (driverState == DriverData.EXCLUDED){
        	queryB.append(" and registry.driver.exclusionDate is not null");
        }
        if (!Util.empty(vehicleAllowed) && !vehicleAllowed.equals("datatype.vehicletype.all")){
            queryA.append(" and registry.driver.vehicleAllowed.resourceBundleId = '"+vehicleAllowed+"' ");
        }
        queryB.append(" group by registry.driver.id ");
        query = session.createQuery(queryB.toString());
        Enumeration keys = parameters.keys();
        while(keys.hasMoreElements()) {
            String parameter = (String)keys.nextElement();
            query.setParameter(parameter,parameters.get(parameter));
        }

        userColl = query.list();
        iter = userColl.iterator();
        while (iter.hasNext()) {
           	Integer id = (Integer) iter.next();
           	result.remove(id); // Borro los que tienen CDs
        }

        // Genero la lista de ids que no tienen CD
        iter = result.iterator();
        queryA = new StringBuffer();
        while (iter.hasNext()) {
           	Integer id = (Integer) iter.next();
           	queryA.append(id.toString()+",");
        }
        queryA = new StringBuffer(queryA.toString().substring(0,queryA.toString().length()-2));

        // Create Query resultado:
       	query = session.createQuery("select sum(1) from Driver driver " +
   			"where driver.id IN ( " + queryA.toString() + " )");
       	// Corro la consulta para saber la cantidad de registros
        userColl = query.list();


       	// Determino la cantidad de registros de la consulta
        Integer total = new Integer(0);
        if (userColl != null){
        	iter = userColl.iterator();
        	while (iter.hasNext()) {
        		total = new Integer(((Long) iter.next()).intValue());
        	}
        	System.out.println("Total de Registros: "+total);
        }

       	// Select
       	StringBuffer select = new StringBuffer();
       	select.append("select driver as driver, driver.lastName as lastName, ");
        select.append("driver.firstName as firstName, ");
        select.append(" 0 "); // Cantidad de Commentary Drives

        // Order By
        StringBuffer orderBy = new StringBuffer();
        orderBy.append(" order by driver.lastName, ");
        orderBy.append(" driver.firstName ");

       	query = session.createQuery( select.toString() +
       			" from Driver driver " +
       			" where driver.id IN ( " + queryA.toString()
       			+ " ) " + orderBy.toString());

        if(count != -1) {
            if(total.intValue() < first) {
                if(total.intValue() % count == 0) {
                    first = total.intValue() - count;
                }else {
                    first = total.intValue() - (total.intValue() % count);
                }
            }
            query.setFirstResult(first);
            query.setMaxResults(count);
        }

        result = new LinkedList();
        List l = query.list();
        if (l != null){
        	iter = l.iterator();
        	while (iter.hasNext()) {
        		Object[] obj = (Object[]) iter.next();
        		ActivityReportCommentaryDriveDataType cd =  new ActivityReportCommentaryDriveDataType(((Driver)obj[0]).getDriverReportData2("detailed"),(Integer)obj[3]);
        		result.add(cd);
        	}
    	}

        // session.close();

        return new ListResult(result,total.intValue());
    }


    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public ListResult findReportList(String[] type, Integer monthFrom, Integer yearFrom, Integer monthTo, Integer yearTo, Integer[][] divOrgs, Integer[][] divGeos, String[] state, int first, int count, UserSessionData userSessionData) throws Exception {
        ListResult listResult=null;
        try{
            Session session = HibernateUtil.currentSession();

            String conditions = UtilityQuery.corporationRestrictionsSQL(divOrgs, divGeos[0], "ca", userSessionData)+
            		" and ca.date > "+Util.formatSQL(monthFrom,yearFrom, 0)+
            		" and ca.date < "+Util.formatSQL(monthTo,yearTo, 1);
            if (!((type.length == 1) && type[0].equals("generic.messages.all"))) {
            	conditions += " AND ca.type IN (";
            	for(int i = 0; i < type.length; i++) {
            		conditions += "'"+type[i]+"'";
                	if(i+1 < type.length)
                		conditions += ",";
            	}
            	conditions += ") ";

            }
            conditions += " AND ca.type NOT IN ('" + CEPAActivityConstants.COMMENTARYDRIVE + "')";
            if(state.length > 0) {
            	conditions += " AND ca.state IN (";
            	for(int i = 0; i < state.length; i++) {
            		conditions += "'"+state[i]+"'";
                	if(i+1 < state.length)
                		conditions += ",";
            	}
            	conditions += ") ";
            }

            String sql1 = "SELECT ca.activityid, COUNT(distinct ar.activityregistryid) AS c FROM cepaactivity ca"+
            		" LEFT JOIN activityregistry ar ON ca.activityid = ar.activity " + conditions + " GROUP BY activityid";
            Query q1 = session.createSQLQuery(sql1).addScalar("activityid",Hibernate.INTEGER).addScalar("c",Hibernate.INTEGER);
            Iterator it = q1.list().iterator();
            HashMap<Integer, Integer> counts = new HashMap<Integer, Integer>();
            String ids = "";
            int total2 = 0;
            while(it.hasNext()) {
            	Object[] values = (Object[])it.next();
            	counts.put((Integer)values[0], (Integer)values[1]);
            	if(ids.length() > 0)
            		ids += ",";
            	ids += String.valueOf(values[0]);
            	total2 += ((Integer)values[1]).intValue();
            }
            int total1 = counts.size();

	        if (total1 != 0){
	            String[] fields = userSessionData.getFilter().getFields("ca");
	            int[][] principalLabels = userSessionData.getFilter().getAllDivOrgs();
	            String sql2 = "SELECT ca.activityid,ca.date,ca.type,c.resourcekey,ca.state"+fields[0]+" FROM cepaactivity ca, country c " + fields[1] +
	            		 " WHERE ca.country = c.id AND activityid IN ("+ids+") " + fields[2] + " ORDER BY date DESC";
	            SQLQuery q2 = session.createSQLQuery(sql2).addScalar("activityid",Hibernate.INTEGER);
	            q2.addScalar("date",Hibernate.DATE);
	            q2.addScalar("type",Hibernate.STRING);
	            q2.addScalar("resourcekey",Hibernate.STRING);
	            q2.addScalar("state",Hibernate.STRING);
	            StringTokenizer token = new StringTokenizer(fields[3],",");
	            while(token.hasMoreTokens()) {
	                q2.addScalar(token.nextToken(), Hibernate.STRING);
	            }

	            if(count != -1) {
	                if(total1 < first) {
	                    if(total1 % count == 0) {
	                        first = total1 - count;
	                    }else {
	                        first = total1 - (total1 % count);
	                    }
	                }
	                q2.setFirstResult(first);
	                q2.setMaxResults(count);
	            }

		        Collection list = q2.list();
		        if (list != null){
		        	it = list.iterator();
		        	Collection result = new LinkedList();
		        	while (it.hasNext()) {
		        		CEPAActivityScheduleDataType activity = new CEPAActivityScheduleDataType((Object[]) it.next(), principalLabels);
		        		activity.setParticipantsCount(counts.get(activity.getId()));
		        		result.add(activity);
		        	}
		        	listResult = new ListResult(result, total1, total2);
		        }
	        }

        }catch(Exception e){
        	e.printStackTrace();
        	Object[] parameters = {type, monthFrom,yearFrom,monthTo,yearTo,divOrgs,divGeos,first,count};
            handler.getException(e,"findReportList",userSessionData,parameters);
        }
        return listResult;
    }

    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query,jjreporter"
     */
    public Object[][] getParticipantsRegistry(Integer activityId, UserSessionData userRequest) throws Exception {
        try{
            Session session = HibernateUtil.currentSession();
            String queryStr = "select registry from CEPAScheduleActivityRegistry as registry "+
               " where registry.activity.activityId = " + activityId+" order by registry.driver.firstName";

            Query query = session.createQuery(queryStr);

            List registryColl = query.list();
            Object[][] result = new Object[registryColl.size()][6];
            Iterator iter = registryColl.iterator();
            int index = 0;
            while (iter.hasNext()) {
            	CEPAScheduleActivityRegistry registry = (CEPAScheduleActivityRegistry) iter.next();
                result[index][0] = registry.getDriver().getFirstName();
                result[index][1] = registry.getDriver().getLastName();
                result[index][2] = registry.getDriver().getBirthDate();
                result[index][3] = registry.getNote();
                result[index][4] = registry.getDriver().getId();
                result[index][5] = registry.getActivity().getActivityId();
                index++;
            }

            return result;

        }catch (Exception e) {
        	Object[] parameters = {activityId};
            handler.getException(e,"getParticipantsRegistry",userRequest,parameters);
        }
        return null;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate,cepascheduleactivityregistrycreate,cepascheduleactivityregistryupdate,cepascheduleactivityview,cdactivitycreate,cdactivitymodify"
     */
    public Object[][] getParticipantsRegistryObservations(Integer activityId, UserSessionData userRequest) throws Exception {
        try{
            Session session = HibernateUtil.currentSession();

            String queryStr = "SELECT driver,obs FROM activityregistry " +
            		"WHERE activity = " +String.valueOf(activityId);
            Query query = session.createSQLQuery(queryStr).
            	addScalar("driver",Hibernate.INTEGER).
            	addScalar("obs",Hibernate.STRING);

            List registryColl = query.list();
            Object[][] result = new Object[registryColl.size()][2];
            Iterator iter = registryColl.iterator();
            int index = 0;
            while (iter.hasNext()) {
                result[index] = (Object[]) iter.next();
                index++;
            }
            return result;
        }catch (Exception e) {
        	Object[] parameters = {activityId};
            handler.getException(e,"getParticipantsRegistryObservations",userRequest,parameters);
        }
        return null;
    }

    /**
     * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,cepascheduleactivityview,cepascheduleactivitycreate,cepascheduleactivityregistrycreate,cepascheduleactivityedit,cepascheduleactivityregistryedit,cepascheduleactivityupdate,cepascheduleactivitydelete,cepascheduleactivityregistrydelete,cepascheduleactivityviewlist,cepascheduleactivityview,cepascheduleactivitysupervise,cdactivitycreate,cdactivitymodify,cdactivitydelete"
     * @param userSessionData
     * @param type
     * @throws Exception
     *
     * Devuelve la cantidad de años en que vence la actividad "type".
     * 0 significa que no vence
     * >0 cantidad de años de vencimiento
     */
    public int getTimeExpiry(String type, String country,UserSessionData userSessionData) throws Exception{
    	try{
    		if(userSessionData.isCorporation(CorporationData.SYNGENTA) &&
				(type.equals(CEPAActivityConstants.BTW1) || type.equals(CEPAActivityConstants.BTW2) || type.equals(CEPAActivityConstants.BTW3))) {
    			return 2;
    		}


    		// Si es ORICA se vence en dos a�os la actividad para estos tipos
    		if (userSessionData.getFilter().getCorporationId().
    			equals(new Integer(CorporationData.ORICA)) &&
    			(type.equals(CEPAActivityConstants.PREVENTIVO_PESADOS_TEORIA) ||
    			type.equals(CEPAActivityConstants.PREVENTIVO_PESADOS_PRACTICO) ||
    			type.equals(CEPAActivityConstants.PREVENTIVO_LIVIANOS_PRACTICO) ||
    			type.equals(CEPAActivityConstants.PREVENTIVO_LIVIANOS_TEORIA)
    			)){
    			return 2;
    		}


    		// Si es BTW3 o BTW3 Update
    		// Para las forestales (FOSA y LOS PIQUES) vence en 2 años.
    		if( (userSessionData.getFilter().getCorporationId().equals(new Integer(CorporationData.FORESTALORIENTAL))
    				|| userSessionData.getFilter().getCorporationId().equals(new Integer(CorporationData.LOSPIQUES))
    				|| userSessionData.getFilter().getCorporationId().equals(new Integer(CorporationData.FORESTALES))
    				|| userSessionData.getFilter().getCorporationId().equals(new Integer(CorporationData.MONTES_DE_PLATA)))
    				&&
    			(type.equals(CEPAActivityConstants.PESADOS_1) ||
    	    			type.equals(CEPAActivityConstants.BTW3) ||
    	    			type.equals(CEPAActivityConstants.BTW3UPDATE) ||
    	    			type.equals(CEPAActivityConstants.BTW3RENOVACION))){
    			return 2;
    		}

    		if(userSessionData.isCorporation(CorporationData.MONSANTO) && 
    				(type.equals(CEPAActivityConstants.BTW3) || type.equals(CEPAActivityConstants.OUT_TRAINING)) 
    				&& country.equals(CountryData.BRASIL_ID.toString())) {
    			return 1;
    		}

    		// Si es BTW3 o BTW3 Update
    		// tenemos que para Monsanto: vence en 1 año (asi esta en la base de datos)
    		// y para todas las demas empresas (no forestales) vence en 3 años
    		if (!userSessionData.getFilter().getCorporationId().
    			equals(new Integer(CorporationData.MONSANTO)) &&
    			(type.equals(CEPAActivityConstants.BTW3) ||
    			type.equals(CEPAActivityConstants.BTW3RENOVACION) ||
    			type.equals(CEPAActivityConstants.BTW3UPDATE))){
    			return 3;
    		}



    		// Si es Evaluacion en Cabina:
    		// Para Forestal Oriental vence en 1 año (asi esta en la base de datos)
    		// Para Otras empresas: No vence, retorna 0.
    		if (!userSessionData.getFilter().getCorporationId().
    				equals(new Integer(CorporationData.FORESTALORIENTAL)) &&
    			(type.equals(CEPAActivityConstants.EVALUACIONENCABINA) ||
    			type.equals(CEPAActivityConstants.EVALUACIONENCABINAPESADO) ||
    			type.equals(CEPAActivityConstants.CURSOPESADOS) ||
    			type.equals(CEPAActivityConstants.BTWPESADOSCONEVALUACIONENCABINA)
    			)){
    			return 0;
    		}

    		Session session = HibernateUtil.currentSession();
    		String queryStr = "Select activity from CEPAActivityDefinition as activity " +
    				" where activity.resourceKeyName ='"+type+"' ";

    		Query query = session.createQuery(queryStr);
            int result = 0;

    		Object obj = query.uniqueResult();
    		if (obj != null){
    			CEPAActivityDefinition registry = (CEPAActivityDefinition)obj;
    			result = registry.getTimeExpiry();
            }
    		return result;

    	}catch(Exception e){
        	Object[] parameters = {type};
    		handler.getException(e,"getTimeExpiry",userSessionData,parameters);
    	}
    	return 0;
    }



    /**
     * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,cepascheduleactivityview"
     * @param userSessionData
     * @return result of the search
     * @throws Exception
     *
     *  Devuelve las actividades que tienen vencimiento.
     */
    public ListResult  getActivitiesWithExpiryTime(UserSessionData userSessionData) throws Exception {
    	try{
    		Session session = HibernateUtil.currentSession();
    		String queryStr = "Select activity from CEPAActivityDefinition as activity " +
    				" where activity.timeExpiry > 0 ";

    		Query query = session.createQuery(queryStr);

            List registryColl = query.list();
            int total = registryColl.size();
            Iterator iter = registryColl.iterator();
            LinkedList result = new LinkedList();
            while (iter.hasNext()) {
             	CEPAActivityDefinition registry = (CEPAActivityDefinition) iter.next();

             	// Si es Evaluacion en Cabina:
        		// Para Forestal Oriental vence en 1 año (asi esta en la base de datos)
        		// Para Otras empresas: No vence, retorna 0.
        		if (!userSessionData.getFilter().getCorporationId().
        				equals(new Integer(CorporationData.FORESTALORIENTAL)) &&
        			(registry.getResourceKeyName().equals(CEPAActivityConstants.EVALUACIONENCABINA) ||
   					registry.getResourceKeyName().equals(CEPAActivityConstants.EVALUACIONENCABINAPESADO) ||
   					registry.getResourceKeyName().equals(CEPAActivityConstants.CURSOPESADOS) ||
   					registry.getResourceKeyName().equals(CEPAActivityConstants.BTWPESADOSCONEVALUACIONENCABINA)
        			)){

        			// No agrego Evaluacion en Cabina cuando no es FOSA porque no tiene
        			// vencimiento para empresas difernetes de FOSA.

        		}else{
        			CEPAActivityDefinitionData registryData = registry.getCEPAActivityDefinitionData();
        			result.add(registryData);
        		}
            }
            return new ListResult(result,total);

    	}catch(Exception e){
        	Object[] parameters = {};
    		handler.getException(e,"getActivitiesWithExpiryTime",userSessionData,parameters);
    	}
    	return null;

    }

    /**
     *
     * @param type
     * @param userSessionData
     * @return
     * @throws Exception
     */
    public String getCategoryForExpiry(String type, UserSessionData userSessionData) throws Exception{
    	try{
    		Session session = HibernateUtil.currentSession();
    		String queryStr = "Select activity from CEPAActivityDefinition as activity " +
    				" where activity.resourceKeyName ='"+type+"' ";

    		Query query = session.createQuery(queryStr);
            String result = null;

    		Object obj = query.uniqueResult();
    		if (obj != null){
    			CEPAActivityDefinition registry = (CEPAActivityDefinition)obj;
    			result = registry.getCategoryForExpiry();
            }
    		return result;

    	}catch(Exception e){
        	Object[] parameters = {type};
    		handler.getException(e,"getCategoryForExpiry",userSessionData,parameters);
    	}
    	return null;
    }


    String getCategoryForExpiry2(String type) {

    	String category = "";

        Session session = HibernateUtil.currentSession();

        Query query = session.createQuery("select definition.categoryForExpiry " +
        		"from CEPAActivityDefinition as definition where resourceKeyName = "+type);

        Object result = query.uniqueResult();
        if(result != null)
        	category = (String)result;
        return category;
    }

    // devuelve el activityregistry correspondiente curso con fecha de expiración más tardía del tipo pasado como parámetro
    CEPAActivityScheduleRegistryData getLastActivityRegistry(Integer driver,String type) {

        Session session = HibernateUtil.currentSession();

        String queryStr = "select registry from CEPAScheduleActivityRegistry as registry "+
		   " where registry.driver.id =" + driver + " and registry.activity.type = '"+ type +
		   "' order by registry.activity.dateExpiry DESC";

        Query query = session.createQuery(queryStr);

        List registryColl = query.list();
        Iterator iter = registryColl.iterator();
        CEPAScheduleActivityRegistry registry = null;
        CEPAActivityScheduleRegistryData registryData = null;
        if (iter.hasNext()) {
        	registry = (CEPAScheduleActivityRegistry) iter.next();
            registryData = registry.getCEPAScheduleActivityData();
        }
    	return registryData;
    }

