    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate,cepascheduleactivityview,cepascheduleactivityregistrycreate,cepascheduleactivityregistryupdate,cdactivitycreate,cdactivitymodify"
     */
    public Collection<DriverData> getParticipants(Integer activityId, UserSessionData userRequest) throws Exception {
        try{

            Session session = HibernateUtil.currentSession();
            //System.out.println("ActivityReportBean: activityId="+activityId)      ;
            String queryStr = "select registry from CEPAScheduleActivityRegistry as registry "+
			   " where registry.activity.activityId = " + activityId.toString()+ " " +
			   " order by registry.driver.firstName, registry.driver.lastName ";

            Query query = session.createQuery(queryStr);

            List registryColl = (query!= null)?query.list():null;
            LinkedList<DriverData> result = new LinkedList<DriverData>();
            if (registryColl != null){
            	Iterator iter = registryColl.iterator();
            	while (iter.hasNext()) {
            		CEPAScheduleActivityRegistry registry = (CEPAScheduleActivityRegistry) iter.next();
            		if (registry != null && registry.getDriver() != null &&
            				registry.getDriver().getDriverData() != null)
            			result.add(registry.getDriver().getDriverData());
            	}
            }

            return result;

        }catch (Exception e) {
        	Object[] parameters = {activityId};
            handler.getException(e,"getParticipants",userRequest,parameters);
        }
        return null;
    }

