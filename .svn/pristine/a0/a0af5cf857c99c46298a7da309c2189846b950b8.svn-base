    Object[] getLastActivityRegistryCategoryForExpiry2(Integer driver,String category,Date dateExpiry) {

        Session session = HibernateUtil.currentSession();

        Hashtable parameters = new Hashtable();

       String queryStr = "select registry.note,activity.type,activity.date from " +
       		"activityregistry registry,cepaactivity activity,cepaactivitydefinition definition"+
       		" where registry.driver =" + driver + " and definition.categoryForExpiry = '"+ category +
       		"' and activity.definition = definition.resourcekeyname" +
       		" and activity.dateExpiry = (:dateExpiry)";

       Calendar calendar = Calendar.getInstance();
       calendar.setTime(dateExpiry);
       calendar.set(Calendar.HOUR_OF_DAY,0);
       calendar.set(Calendar.MINUTE,0);
       calendar.set(Calendar.SECOND,0);
       calendar.set(Calendar.MILLISECOND,0);
       parameters.put("dateExpiry",calendar.getTime());

       Query query = session.createSQLQuery(queryStr)
       .addScalar("note", Hibernate.STRING)
       .addScalar("type", Hibernate.STRING)
       .addScalar("date", Hibernate.DATE);


       Enumeration keys = parameters.keys();
       while(keys.hasMoreElements()) {
           String parameter = (String)keys.nextElement();
           query.setParameter(parameter,parameters.get(parameter));
       }


        List registryColl = query.list();
        Iterator iter = registryColl.iterator();
        Object[] row = null;
        if (iter.hasNext()) {
        	row = (Object[]) iter.next();
        }
    	return row;
    }

    /**
     * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,cepascheduleactivityview"
     * @param userRequest - logged user
     * @param type - type of activity
     * @param first - first index of the search to return
     * @param count - number of elements to return
     * @return result of the search
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
	 */
    public ListResult  driverWithDeliveredActivities(UserSessionData userRequest,Date initialDate,
    		Date lastDate, String[] type,Integer[][] divOrgs,Integer[][] divGeos,
    		String driverType,String[] vehicleAllowed,int first, int count) throws Exception {

        Session session = HibernateUtil.currentSession();

        StringTokenizer str;
        String[] typeCol;
        int cont = 0;
        if (type.length == 1) {
        	str = new StringTokenizer(type[0],",");
        	typeCol = new String[str.countTokens()];
        	while (str.hasMoreTokens()) {
        		typeCol[cont] =str.nextToken();
        		cont++;
        	}
        }else {
        	typeCol = type;
        }

        Hashtable parameters = new Hashtable();

        Collection result = new LinkedList();

        String in="";
        for (int i=0;i< typeCol.length;i++) {
			in += (in.length()==0) ? "(" : ",";
			in += "'" + typeCol[i]+ "'";
        }
        in+=")";

        String queryStr = UtilityQuery.corporationDivisionsRestictions("registry.activity",userRequest);

        if((typeCol != null) && (typeCol.length > 0) ) {
        	queryStr +=" and registry.activity.type in " + in + " ";
	    }

        HashSet set = new HashSet();
        String divOrgStr = "";
        if(divOrgs != null && divOrgs.length > 0) {
            for(int j = 0; j < divOrgs.length; j++) {
                if(divOrgs[j] != null && divOrgs[j].length > 0) {
                	divOrgStr = "";
                    divOrgStr = " and registry.driver.divOrg"+String.valueOf(j+1)+" in (";
                    for(int i = 0; i < divOrgs[j].length; i++) {
                    	set.add(divOrgs[j][i]); // Para evitar repetidos
                    }
                    Iterator it = set.iterator();
                    int i = 0;
                    while (it.hasNext()){
                    	String div = ((Integer)it.next()).toString();
                    	divOrgStr += div;
                        divOrgStr += (i == set.size()-1) ? ") " : ",";
                        i++;
                    }
                    queryStr += divOrgStr;
                }
            }
        }

        if(divGeos != null) {
            if(divGeos[0] != null && divGeos[0].length > 0) {
                queryStr += "and registry.driver.corpCountry.pk.country in (";
	            for(int i = 0; i < divGeos[0].length; i++) {
	                queryStr += divGeos[0][i];
	                queryStr += (i == divGeos[0].length-1) ? ")" : ",";
	            }
	        }
        }

	    if(initialDate != null) {
	        queryStr +=" and registry.activity.date >= (:date1)";
	        Calendar calendar1 = Calendar.getInstance();
	        calendar1.setTime(initialDate);
	        calendar1.set(Calendar.HOUR_OF_DAY,0);
	        calendar1.set(Calendar.MINUTE,0);
	        calendar1.set(Calendar.SECOND,0);
	        calendar1.set(Calendar.MILLISECOND,0);
	        parameters.put("date1",calendar1.getTime());
	    }

	    if(lastDate != null) {
	        queryStr +=" and registry.activity.date <= (:date2)";
	        Calendar calendar2 = Calendar.getInstance();
	        calendar2.setTime(lastDate);
	        calendar2.set(Calendar.HOUR_OF_DAY,23);
	        calendar2.set(Calendar.MINUTE,59);
	        calendar2.set(Calendar.SECOND,59);
	        parameters.put("date2",calendar2.getTime());
	    }

        queryStr += " and registry.activity.state = '" + CEPAActivityConstants.DICTADA + "'";

        if (driverType.equals("generic.messages.active")) {
        	queryStr += " and registry.driver.exclusionDate is null";
        }else  if (driverType.equals("generic.messages.excluded")) {
        	queryStr += " and registry.driver.exclusionDate is not null";
        }

        if (vehicleAllowed != null && vehicleAllowed.length > 0 && !(vehicleAllowed.length == 1 && vehicleAllowed[0].length() == 0)) {
        	queryStr += " and registry.driver.vehicleAllowed IN (";
        	for(int i = 0; i < vehicleAllowed.length; i++) {
        		queryStr += "'"+vehicleAllowed[i]+"'";
        		if(i < vehicleAllowed.length-1)
        			queryStr += ",";
        	}
        	queryStr += ") ";
        }

	    Query queryAux = session.createQuery("SELECT COUNT(*) FROM CEPAScheduleActivityRegistry AS registry "+queryStr);
        Enumeration keys = parameters.keys();
        while(keys.hasMoreElements()) {
            String parameter = (String)keys.nextElement();
            queryAux.setParameter(parameter,parameters.get(parameter));
        }

		List activityColl = queryAux.list();
	    Iterator iter = activityColl.iterator();
	    Integer total = new Integer(0);
		while (iter.hasNext()) {
		    total = new Integer(((Long) iter.next()).intValue());
		}

        queryStr += " ORDER BY registry.driver.lastName,registry.activity.date";
        Query query = session.createQuery("SELECT registry.driver,registry.activity.type,registry.activity.date,registry.note,registry.instructor,registry.activity.city,registry.activity.theme " +
        		"FROM CEPAScheduleActivityRegistry AS registry "+queryStr);
        keys = parameters.keys();
        while(keys.hasMoreElements()) {
            String parameter = (String)keys.nextElement();
            query.setParameter(parameter,parameters.get(parameter));
        }

        if(count != -1) {
            query.setFirstResult(first);
            query.setMaxResults(count);
        }

        DriverWithDeliveredActivities driver;
        Iterator it = query.iterate();
        while (it.hasNext()) {
        	Object[] row = (Object[]) it.next();
        	String note= (String) row[3];
        	String instructor= (String) row[4];
        	String city= (String) row[5];
        	String activityType = ((CEPAActivityType)row[1]).getResourceBundleId();
        	String theme = (String) row[6];
        	Date activityDate =  (Date) row[2];
        	driver = new DriverWithDeliveredActivities(((Driver)row[0]).getDriverReportData2("detailed"),activityType,note,city,instructor,theme,activityDate);
        	result.add(driver);
        }

        return new ListResult(result,total.intValue());
    }






