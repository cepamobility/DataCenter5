    /**
     * @ejb.permission role-name = "administrator"
     * @ejb.interface-method
     */
    public Collection getCepaSystemParticipants(Integer activity, UserSessionData userSessionData) throws Exception {
        Collection participants = new LinkedList();
        try {
            Session session = HibernateUtil.currentSession();
            Query q = session.createQuery("SELECT registry FROM CepaSystemActivityRegistry registry WHERE registry.activity.id = "+String.valueOf(activity));
            Iterator list = q.list().iterator();
            while(list.hasNext()) {
                participants.add(((CepaSystemActivityRegistry)list.next()).getData(userSessionData));
            }
        }catch (Exception e) {
        	Object[] parameters = {activity};
            handler.getException(e,"getCepaSystemParticipants",userSessionData,parameters);
        }
        return participants;
    }

	/**
	 * @throws Exception
	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator"
	 */
	public ListResult findCepaSystemActivityDrivers(Hashtable parameters,int first,int count, UserSessionData userSessionData) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"findList",getClass());
	    try{
	        Session session = HibernateUtil.currentSession();

            String sql = " FROM drivers AS driver WHERE corporation = "+String.valueOf(userSessionData.getFilter().getCorporationId());
            if(parameters.containsKey("firstName") && !Util.empty((String)parameters.get("firstName"))) {
                sql += " AND lower(firstname) LIKE '%"+((String)parameters.get("firstName")).toLowerCase()+"%' ";
            }
            if(parameters.containsKey("lastName") && !Util.empty((String)parameters.get("lastName"))) {
                sql += " AND lower(lastname) LIKE '%"+((String)parameters.get("lastName")).toLowerCase()+"%' ";
            }
            if(parameters.containsKey("activityType") && !Util.empty((String)parameters.get("activityType"))) {
            	if(parameters.get("activityType").equals(ParticipantData.WITHOUT_ACTIVITY)) {
            		sql += " AND id NOT IN (SELECT driver FROM cepasystemactivityregistry) ";
            	} else if(parameters.get("activityType").equals(ParticipantData.WITH_ACTIVITY)) {
            		sql += " AND id IN (SELECT driver FROM cepasystemactivityregistry) ";
            	}
            }

	        Query query = session.createSQLQuery("SELECT COUNT(*) AS c"+sql).addScalar("c",Hibernate.INTEGER);
	        Iterator iter = query.list().iterator();
	        Integer total = (iter.hasNext()) ? (Integer) iter.next() : new Integer(0);

            query = session.createSQLQuery("SELECT id,firstname,lastname,birthdate "+sql).addScalar("id",Hibernate.INTEGER).addScalar("firstname",Hibernate.STRING).addScalar("lastname",Hibernate.STRING).addScalar("birthdate",Hibernate.DATE);
            if(count != -1) {
	            if(total.intValue() < first) {
                    first = (total.intValue() % count == 0) ? total.intValue() - count : total.intValue() - (total.intValue() % count);
		        }
		    }
		    query.setFirstResult(first);
            if(count != -1) {
                query.setMaxResults(count);
            }

            Collection<DriverMainAttributes> result = new LinkedList<DriverMainAttributes>();
            iter = query.list().iterator();
            while (iter.hasNext()) {
            	Object[] data = (Object[])iter.next();
            	DriverMainAttributes attributes = new DriverMainAttributes((Integer)data[0]);
            	attributes.setFirstName((String)data[1]);
            	attributes.setLastName((String)data[2]);
            	attributes.setBirthDate((Date)data[3]);
                result.add(attributes);
            }
            MemoryLog.getInstance().log(MemoryLog.END,"findList",getClass());
            return new ListResult(result, total.intValue());
	    }catch (Exception e) {
	    	Object[] param = {parameters,first,count};
            handler.getException(e,"findCepaSystemActivityDrivers",userSessionData,param);
        }
        return null;
	}

    /**
