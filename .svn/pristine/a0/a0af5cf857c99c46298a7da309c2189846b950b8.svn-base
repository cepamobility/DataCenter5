    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,systemaccess"
     */
    public Collection findCommentaryDriveResult(String firstName,String lastName,int status,String activityType,Date start,Date end,Integer[][] divOrgs,Integer[][] divGeos,String vehicleAllowed,UserSessionData userSessionData) throws Exception {
        Collection result = new LinkedList();
        try {
            Session session = HibernateUtil.currentSession();
            String[] fields = userSessionData.getFilter().getFields("d");
            String sqlQuery = "SELECT d.firstname,d.lastname,d.vehicleallowed,ca.date,ar.activityregistryid,ar.conductiontype,ar.obs,c.resourcekey AS country,d.licenseobs"+fields[0];
            sqlQuery += " FROM activityregistry ar,cepaactivity ca,drivers d,country c"+fields[1];
            sqlQuery += UtilityQuery.corporationDivisionsRestictionsSQL("d",userSessionData);
            sqlQuery += " AND ar.activity = ca.activityid";
            sqlQuery += " AND ar.driver = d.id AND d.country = c.id "+fields[2];
            if(!Util.empty(firstName)) {
                sqlQuery += " AND lower(d.firstname) like '%"+firstName.toLowerCase()+"%' ";
            }
            if(!Util.empty(lastName)) {
                sqlQuery += " AND lower(d.lastname) like '%"+lastName.toLowerCase()+"%' ";
            }
            switch (status) {
               case DriverData.ACTIVE:
                   sqlQuery += " AND d.exclusionDate is null ";
                   break;
               case DriverData.EXCLUDED:
                   sqlQuery += " AND d.exclusionDate is not null ";
                   break;
           }
            if(!Util.empty(vehicleAllowed) && !vehicleAllowed.equals("datatype.vehicletype.all")) {
                sqlQuery += " AND d.vehicleallowed = '"+vehicleAllowed+"' ";
            }
            HashSet set = new HashSet();
            if(divOrgs != null && divOrgs.length > 0) {
                for(int j = 0; j < divOrgs.length; j++) {
                    if(divOrgs[j] != null && divOrgs[j].length > 0) {
                        for(int i = 0; i < divOrgs[j].length; i++) {
                            set.add(divOrgs[j][i]); // Para evitar repetidos
                        }
                        Iterator it = set.iterator();
                        int i = 0;
                        sqlQuery += " AND d.divOrg"+String.valueOf(j+1)+" in (";
                        while (it.hasNext()){
                            sqlQuery += ((Integer)it.next()).toString();
                            sqlQuery += (i == set.size()-1) ? ") " : ",";
                            i++;
                        }
                    }
                }
            }
            if(divGeos != null) {
                if(divGeos[0] != null && divGeos[0].length > 0) {
                    sqlQuery += " AND d.country in (";
                    for(int i = 0; i < divGeos[0].length; i++) {
                        sqlQuery += divGeos[0][i];
                        sqlQuery += (i == divGeos[0].length-1) ? ")" : ",";
                    }
                }
            }
            if(!Util.empty(activityType)) {
                sqlQuery += " AND ar.conductiontype = '"+activityType+"' ";
            }else {
                sqlQuery += " AND ar.conductiontype IN ('generic.activity.form.commentarydrive.peerdrivewithpeer','generic.activity.form.commentarydrive.commentarydrivewithsuperior') ";
            }
            sqlQuery += " AND ca.date >= "+Util.formatSQL(start);
            sqlQuery += " AND ca.date <= "+Util.formatSQL(end);
            SQLQuery query = session.createSQLQuery(sqlQuery);
            query.addScalar("firstname",Hibernate.STRING);
            query.addScalar("lastname",Hibernate.STRING);
            query.addScalar("vehicleallowed",Hibernate.STRING);
            query.addScalar("date",Hibernate.DATE);
            query.addScalar("activityregistryid",Hibernate.INTEGER);
            query.addScalar("conductiontype",Hibernate.STRING);
            query.addScalar("obs",Hibernate.STRING);
            query.addScalar("country",Hibernate.STRING);
            query.addScalar("licenseobs",Hibernate.STRING);
            StringTokenizer token = new StringTokenizer(fields[3],",");

            while(token.hasMoreTokens()) {
                query.addScalar(token.nextToken(), Hibernate.STRING);
            }

            Hashtable maps = new Hashtable();
            String ids = "";
            Iterator it = query.list().iterator();
            while(it.hasNext()) {
                CommentaryDriveDataType data = new CommentaryDriveDataType((Object[])it.next());
                maps.put(data.getArId(),data);
                ids += String.valueOf(data.getArId()) + ",";
            }

            if(ids.length() > 0) {
                String sqlItems = "SELECT activityregistry,item FROM activityregistryitems WHERE activityregistry in ("+ids.substring(0,ids.length()-1)+") ORDER BY activityregistry";
                Query queryItems = session.createSQLQuery(sqlItems).addScalar("activityregistry",Hibernate.INTEGER).addScalar("item",Hibernate.INTEGER);
                it = queryItems.list().iterator();
                while(it.hasNext()) {
                    Object[] data = (Object[])it.next();
                    ((CommentaryDriveDataType)maps.get(data[0])).addItem((Integer)data[1]);
                }

                Enumeration elements = maps.elements();
                while(elements.hasMoreElements()) {
                    result.add(elements.nextElement());
                }
            }
        }catch (Exception e) {
        	Object[] parameters = {firstName,lastName,status,activityType,start,end,divOrgs,divGeos,vehicleAllowed};
            handler.getException(e,"findCommentaryDriveResult",userSessionData,parameters);
        }
        return result;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,systemaccess"
     */
    public Collection findCommentaryDriveRiskResult(String firstName,String lastName,int status,Date start,Date end,Integer[][] divOrgs,Integer[][] divGeos,String vehicleAllowed,UserSessionData userSessionData) throws Exception {
        Collection result = new LinkedList();
        try {
            Session session = HibernateUtil.currentSession();
            String[] fields = userSessionData.getFilter().getFields("d");
            String sqlQuery = "SELECT d.firstname,d.lastname,d.vehicleallowed,ca.date,ar.activityregistryid,ar.obs,c.resourcekey AS country,d.licenseobs"+fields[0];
            sqlQuery += " FROM activityregistry ar,cepaactivity ca,drivers d,country c"+fields[1];
            sqlQuery += UtilityQuery.corporationDivisionsRestictionsSQL("d",userSessionData);
            sqlQuery += " AND ar.activity = ca.activityid";
            sqlQuery += " AND ar.driver = d.id AND d.country = c.id "+fields[2];
            if(!Util.empty(firstName)) {
                sqlQuery += " AND lower(d.firstname) like '%"+firstName.toLowerCase()+"%' ";
            }
            if(!Util.empty(lastName)) {
                sqlQuery += " AND lower(d.lastname) like '%"+lastName.toLowerCase()+"%' ";
            }
            switch (status) {
               case DriverData.ACTIVE:
                   sqlQuery += " AND d.exclusionDate is null ";
                   break;
               case DriverData.EXCLUDED:
                   sqlQuery += " AND d.exclusionDate is not null ";
                   break;
           }
            if(!Util.empty(vehicleAllowed) && !vehicleAllowed.equals("datatype.vehicletype.all")) {
                sqlQuery += " AND d.vehicleallowed = '"+vehicleAllowed+"' ";
            }
            HashSet set = new HashSet();
            if(divOrgs != null && divOrgs.length > 0) {
                for(int j = 0; j < divOrgs.length; j++) {
                    if(divOrgs[j] != null && divOrgs[j].length > 0) {
                        for(int i = 0; i < divOrgs[j].length; i++) {
                            set.add(divOrgs[j][i]); // Para evitar repetidos
                        }
                        Iterator it = set.iterator();
                        int i = 0;
                        sqlQuery += " AND d.divOrg"+String.valueOf(j+1)+" in (";
                        while (it.hasNext()){
                            sqlQuery += ((Integer)it.next()).toString();
                            sqlQuery += (i == set.size()-1) ? ") " : ",";
                            i++;
                        }
                    }
                }
            }
            if(divGeos != null) {
                if(divGeos[0] != null && divGeos[0].length > 0) {
                    sqlQuery += " AND d.country in (";
                    for(int i = 0; i < divGeos[0].length; i++) {
                        sqlQuery += divGeos[0][i];
                        sqlQuery += (i == divGeos[0].length-1) ? ")" : ",";
                    }
                }
            }
            sqlQuery += " AND ca.type = 'datatype.scheduledactivitytype.commentarydriverisk' ";
            sqlQuery += " AND ca.date >= "+Util.formatSQL(start);
            sqlQuery += " AND ca.date <= "+Util.formatSQL(end);
            SQLQuery query = session.createSQLQuery(sqlQuery);
            query.addScalar("firstname",Hibernate.STRING);
            query.addScalar("lastname",Hibernate.STRING);
            query.addScalar("vehicleallowed",Hibernate.STRING);
            query.addScalar("date",Hibernate.DATE);
            query.addScalar("activityregistryid",Hibernate.INTEGER);
            query.addScalar("obs",Hibernate.STRING);
            query.addScalar("country",Hibernate.STRING);
            query.addScalar("licenseobs",Hibernate.STRING);
            StringTokenizer token = new StringTokenizer(fields[3],",");

            while(token.hasMoreTokens()) {
                query.addScalar(token.nextToken(), Hibernate.STRING);
            }

            Hashtable maps = new Hashtable();
            String ids = "";
            Iterator it = query.list().iterator();
            while(it.hasNext()) {
                CommentaryDriveDataType data = new CommentaryDriveDataType((Object[])it.next(),"");
                maps.put(data.getArId(),data);
                ids += String.valueOf(data.getArId()) + ",";
            }

            if(ids.length() > 0) {
                String sqlItems = "SELECT activityregistry,item,itemvalue FROM activityregistryitemsvalues WHERE activityregistry in ("+ids.substring(0,ids.length()-1)+") ORDER BY activityregistry";
                Query queryItems = session.createSQLQuery(sqlItems).addScalar("activityregistry",Hibernate.INTEGER).addScalar("item",Hibernate.INTEGER).addScalar("itemvalue",Hibernate.INTEGER);
                it = queryItems.list().iterator();
                while(it.hasNext()) {
                    Object[] data = (Object[])it.next();
                    ((CommentaryDriveDataType)maps.get(data[0])).addItem(data);
                }

                Enumeration elements = maps.elements();
                while(elements.hasMoreElements()) {
                    result.add(elements.nextElement());
                }
            }
        }catch (Exception e) {
        	Object[] parameters = {firstName,lastName,status,start,end,divOrgs,divGeos,vehicleAllowed};
            handler.getException(e,"findCommentaryDriveResult",userSessionData,parameters);
        }
        return result;
    }


    /**
     * @ejb.permission role-name = "administrator,imeseviparticipantview,imeseviactivityview"
     * @ejb.interface-method
     */
    public ListResult findCepaSystemActivities(String startDay,String startMonth,String startYear,String endDay,String endMonth,String endYear,
            String type,String country,String city,String state,int first,int count,UserSessionData userSessionData) throws Exception {
        ListResult listResult=null;
        try{

            Session session = HibernateUtil.currentSession();
            String queryCountStr = "SELECT COUNT(*) AS count FROM cepasystemactivity AS activity "+UtilityQuery.corporationDivisionsRestictionsSQL("activity",userSessionData);
            if(Util.isDate(startDay,startMonth,startYear)) {
                queryCountStr += " AND activity.date >= '"+startYear+"-"+startMonth+"-"+startDay+"'";
            }
            if(Util.isDate(endDay,endMonth,endYear)) {
                queryCountStr += " AND date(activity.date) <= '"+endYear+"-"+endMonth+"-"+endDay+"'";
            }
            if((type != null) && (!type.equals(""))) {
                queryCountStr += " AND activity.type = '"+type+"' ";
            }
            if((country != null) && (!country.equals(""))) {
                queryCountStr += " AND activity.country = "+country;
            }
            if(!Util.empty(city)) {
                queryCountStr +=" AND lower(activity.city) = '"+city.toLowerCase()+"'";
            }
            if((state != null) && (!state.equals(""))) {
                queryCountStr += " AND activity.state = '"+state+"'";
            }
            Query queryCount = session.createSQLQuery(queryCountStr).addScalar("count",Hibernate.INTEGER);
            Integer total = (Integer)queryCount.uniqueResult();

            String[] fields = userSessionData.getFilter().getFields("activity");
            String queryStr = "SELECT activity.id,activity.type,c.resourcekey,activity.date,activity.city,activity.state"+fields[0];
            queryStr += " FROM cepasystemactivity AS activity,country c" +fields[1];
            queryStr += UtilityQuery.corporationDivisionsRestictionsSQL("activity",userSessionData);
            queryStr += " AND activity.country = c.id "+fields[2];
            if(Util.isDate(startDay,startMonth,startYear)) {
                queryStr += " AND activity.date >= '"+startYear+"-"+startMonth+"-"+startDay+"'";
            }
            if(Util.isDate(endDay,endMonth,endYear)) {
                queryStr += " AND date(activity.date) <= '"+endYear+"-"+endMonth+"-"+endDay+"'";
            }
            if((type != null) && (!type.equals(""))) {
                queryStr += " AND activity.type = '"+type+"' ";
            }
            if((country != null) && (!country.equals(""))) {
                queryStr += " AND activity.country = "+country;
            }
            if(!Util.empty(city)) {
                queryStr +=" AND lower(activity.city) = '"+city.toLowerCase()+"'";
            }
            if((state != null) && (!state.equals(""))) {
                queryStr += " AND activity.state = '"+state+"'";
            }
            queryStr += " ORDER BY date DESC";
            SQLQuery query = session.createSQLQuery(queryStr);
            query.addScalar("id",Hibernate.INTEGER);
            query.addScalar("type",Hibernate.STRING);
            query.addScalar("resourcekey",Hibernate.STRING);
            query.addScalar("date",Hibernate.DATE);
            query.addScalar("city",Hibernate.STRING);
            query.addScalar("state",Hibernate.STRING);
            StringTokenizer token = new StringTokenizer(fields[3],",");
            while(token.hasMoreTokens()) {
                query.addScalar(token.nextToken(), Hibernate.STRING);
            }

            if(count != -1) {
                if(total.intValue() < first) {
                    if(total.intValue() % count == 0) {
                        first = total.intValue() - count;
                    }else {
                        first = total.intValue() - (total.intValue() % count);
                    }
                }
                query.setFirstResult(first);
                query.setMaxResults(count);
            }

            Iterator it = query.list().iterator();
            Collection elements = new LinkedList();
            while(it.hasNext()) {
                elements.add(new ActivityListData((Object[])it.next()));
            }
            listResult = new ListResult(elements,total.intValue());
        }catch(Exception e){
        	Object[] parameters = {startDay,startMonth,startYear,endDay,endMonth,endYear,type,country,city,state,first,count};
            handler.getException(e,"findCepaSystemActivities",userSessionData,parameters);
        }
        return listResult;
    }

