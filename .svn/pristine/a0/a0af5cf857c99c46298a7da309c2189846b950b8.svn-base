        return elements;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,doorcontrol"
     */
    public Date findLastActivity(Integer driver, String type, UserSessionData userSessionData) throws Exception {
    	try {
    		Session session = HibernateUtil.currentSession();
    		Query query = session.createSQLQuery("SELECT date FROM cepaactivity ca JOIN activityregistry ar ON ca.activityid = ar.activity WHERE ca.type = '"+type+"' AND ar.driver = "+String.valueOf(driver)+" ORDER BY date DESC").addScalar("date", Hibernate.DATE);
    		Iterator it = query.list().iterator();
    		if(it.hasNext()) {
    			return (Date)it.next();
    		}
    	}catch (Exception e) {
        	Object[] parameters = {driver,type};
            handler.getException(e,"findActivities",userSessionData,parameters);
		}
    	return null;
    }

	/**
	 * @throws Exception
	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
	 */
    public Collection getCepaSystemResults(Integer[] from, Integer[] to,String[] activities,Integer[] divOrgs[],Integer divGeos,UserSessionData userSessionData) throws Exception {
    	Collection list = new LinkedList();
    	try {
    		Session session = HibernateUtil.currentSession();

    		if(activities.length > 0) {
	    		String[] s = userSessionData.getFilter().getFields("d");
				String queryStr = "SELECT ca.activityid,ca.type,ca.date,d.firstname,d.lastname,ar.note,ar.obs,ari.itemvalue,p.pointorder"+s[0]+
	    			"FROM cepaactivity ca,activityregistry ar,activityregistryitemsvalues ari,drivers d,items i,point p"+s[1]+
	    			UtilityQuery.corporationDivisionsRestictionsSQL("d", userSessionData);
				queryStr += " AND ca.type IN (";
				for(int i = 0; i < activities.length; i++) {
					if(i > 0) {
						queryStr += ",";
					}
					queryStr += "'"+activities[i]+"'";
				}
				queryStr += ") ";
				queryStr += "and ca.activityid = ar.activity ";
				queryStr += "and ari.activityregistry = ar.activityregistryid ";
				queryStr += "and d.id = ar.driver ";
				queryStr += "and ari.item = i.id ";
				queryStr += "and p.id = i.point ";
				queryStr += s[2];
				queryStr += "order by date,activityid,firstname,lastname,pointorder";

				SQLQuery query = session.createSQLQuery(queryStr);
				query.addScalar("activityid", Hibernate.INTEGER);
				query.addScalar("type", Hibernate.STRING);
				query.addScalar("date", Hibernate.DATE);
				query.addScalar("firstname", Hibernate.STRING);
				query.addScalar("lastname", Hibernate.STRING);
				query.addScalar("note", Hibernate.STRING);
				query.addScalar("obs", Hibernate.STRING);
				query.addScalar("itemvalue", Hibernate.INTEGER);
				query.addScalar("pointorder", Hibernate.INTEGER);
	            StringTokenizer token = new StringTokenizer(s[3],",");
	            while(token.hasMoreTokens()) {
	                query.addScalar(token.nextToken(), Hibernate.STRING);
	            }

	            CepaSystemDataType cs = null;
	            int lastId = 0;
				Iterator it = query.list().iterator();
	    		if(it.hasNext()) {
	    			Object[] data = (Object[])it.next();
	    			if(((Integer)data[0]) != lastId) {
	    				lastId = (Integer)data[0];
	    				if(cs != null) {
	    					list.add(cs);
	    				}
	    				cs = new CepaSystemDataType(data);
	    			}else {
	    				cs.addValue(data);
	    			}
	    		}
				if(cs != null) {
					list.add(cs);
				}
    		}
    	}catch (Exception e) {
        	Object[] parameters = {from,to,activities,divOrgs,divGeos};
            handler.getException(e,"getCepaSystemResults",userSessionData,parameters);
		}
    	return list;
    }


	/**
	 * @ejb.interface-method view-type = "remote"
	 * @ejb.transaction type="Required"
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate"
	 * @param data
	 * @throws Exception
	 */
	public Collection<Integer> getActivityLink(Integer activity,UserSessionData userSession) throws Exception {
		Collection<Integer> links = new LinkedList<Integer>();
		try{
            Session session = HibernateUtil.currentSession();
    		Query query = session.createQuery("SELECT link FROM ActivityLink link WHERE link.pk.activity = "+activity);
    		List list = query.list();
    		if(list != null && list.size() > 0) {
    			Iterator it = list.iterator();
    			while(it.hasNext()) {
		            Integer[] activityLinks = ((ActivityLink)it.next()).getIds();
		            for(int i = 0; i < activityLinks.length; i++) {
		            	if(activityLinks[i] != null && !links.contains(activityLinks[i]))
		            		links.add(activityLinks[i]);
		            }
    			}
    		}
    	}catch (ObjectNotFoundException nf) {
    		return null;
    	}catch (Exception e) {
			Object[] parameters = {activity};
    		handler.getException(e,"getActivityLink",userSession,parameters);
    	}
		return links;
	}

	/**
	 * @ejb.interface-method view-type = "remote"
	 * @ejb.transaction type="Required"
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate"
	 * @param data
	 * @throws Exception
	 */
	public Integer[] getActivityLink(Integer activity,Integer driver,UserSessionData userSession) throws Exception {
		try{
            Session session = HibernateUtil.currentSession();
    		Query query = session.createQuery("SELECT link FROM ActivityLink link WHERE link.pk.activity = "+activity+" and link.pk.driver = "+driver);
    		List list = query.list();
    		if(list != null && list.size() > 0) {
    			ActivityLink link = (ActivityLink) list.iterator().next();
	            return link.getIds();
    		}
    	}catch (ObjectNotFoundException nf) {
    		return null;
    	}catch (Exception e) {
			Object[] parameters = {activity};
    		handler.getException(e,"getActivityLink",userSession,parameters);
    	}
		return null;
	}

	/**
	 * @ejb.interface-method view-type = "remote"
	 * @ejb.transaction type="Required"
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate"
	 * @param data
	 * @throws Exception
	 */
	public Integer[] getRelatedActivityLink(Integer activityId, Integer driverId, Integer[] driverLinks, UserSessionData userSessionData)  throws Exception {
		try{
            Session session = HibernateUtil.currentSession();
            String corporation = "";
            String divorg = "";
            if(driverLinks[0] != null) {
                corporation = "fosa";
                divorg = "divorg1";
            } else if(driverLinks[1] != null) {
                corporation = "weyerhauser";
                divorg = "divorg3";
            } else if(driverLinks[2] != null) {
                corporation = "mdp";
                divorg = "divorg1";
            }
    		String queryStr = "select a.fosa,a.weyerhauser,a.mdp" +
    				" from driverlinks dl " +
    				" join drivers d on dl."+corporation+" = d.id " +
    				" join cepaactivity ca on ca."+divorg+" = d."+divorg+
    				" join activitylinks a on a.fosa = ca.activityid" +
    				" where a.activity = "+activityId+" and dl.id = "+driverId;
    		Query query = session.createSQLQuery(queryStr).addScalar("fosa", Hibernate.INTEGER).addScalar("weyerhauser", Hibernate.INTEGER).addScalar("mdp", Hibernate.INTEGER);
    		List list = query.list();
    		if(list != null && list.size() > 0) {
    			Object[] data = (Object[]) list.iterator().next();
    			Integer[] values = new Integer[3];
    			for(int i = 0; i < 3; i++) {
    				values[i] = (Integer)data[i];
    			}
    			return values;
    		}
    	}catch (ObjectNotFoundException nf) {
    		return null;
    	}catch (Exception e) {
			Object[] parameters = {activityId,driverId,driverLinks};
    		handler.getException(e,"getActivityLink",userSessionData,parameters);
    	}
		return null;
	}

    /**
     * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,cepascheduleactivityview,query"
     */
	public Collection<DriverMaxExpiry> getMaxExpiry(UserSessionData userSessionData,String[] type,Integer[][] divOrgs,Integer[] divGeos,Date from, Date to,int status,String firstName,String lastName,String vehicleAllowed) throws Exception {
        HashMap<String, Integer> indexes = new HashMap<String, Integer>();
        for(int i = 0; i < type.length; i++)
        	indexes.put(type[i],new Integer(i));
		Collection<DriverMaxExpiry> lines = new LinkedList<DriverMaxExpiry>();
		try {
            Session session = HibernateUtil.currentSession();
    	    String[] s = userSessionData.getFilter().getFields("d");
            String select = "select d.id, " +
               		"d.firstName as firstname, " +
                    "d.lastName as lastname," +
                    "d.director as director,";
            if(userSessionData.isCorporation(CorporationData.JJ)) {
            	select += "d.corporationid as email,";
            }else {
            	select += "d.email as email,";
            }
            select += "d.vehicleAllowed as allowed," +
                    "d.licenseObs as licenseobs," +
               		"MAX(ca.dateExpiry) as expiry," +
               		"c.resourcekey as country, ";
            switch(userSessionData.getCorporationId()) {
            	case CorporationData.MONSANTO:
            		select += "CASE WHEN ca.type IN ('datatype.scheduledactivitytype.btw1','datatype.scheduledactivitytype.btw2','datatype.scheduledactivitytype.btw2-4x4','datatype.scheduledactivitytype.btw2onboard','datatype.scheduledactivitytype.btw2onboard2','datatype.scheduledactivitytype.btw2spv','datatype.scheduledactivitytype.btwutilitarioreboque','datatype.scheduledactivitytype.outtraininglivianos','datatype.scheduledactivitytype.outtrainingpesados','tablet.form.btw1.livianos','tablet.form.btw2.livianos','tablet.form.btw2onboard') THEN 'datatype.scheduledactivitytype.btw1' " +
            				"WHEN ca.type IN ('tablet.form.toj','tablet.form.specialdayoftraining','tablet.form.phrd','datatype.scheduledactivitytype.trainingonthejob','datatype.scheduledactivitytype.specialdayoftraining','datatype.scheduledactivitytype.hrd','datatype.scheduledactivitytype.minitrainingonthejob') THEN 'datatype.scheduledactivitytype.trainingonthejob' " +
            				"WHEN ca.type IN ('datatype.scheduledactivitytype.btw3','datatype.scheduledactivitytype.btw3update') THEN 'datatype.scheduledactivitytype.btw3' " +
            				"ELSE ca.type " +
            				"END as type, ";
	        		break;
            	case CorporationData.JJ:
            		select += "CASE WHEN ca.type IN ('tablet.form.btw1onboard','tablet.form.btw1.livianos','datatype.scheduledactivitytype.btwonboard2','datatype.scheduledactivitytype.btw1') THEN 'datatype.scheduledactivitytype.btw1' "+
            				"WHEN ca.type IN ('tablet.form.btw2onboard','datatype.scheduledactivitytype.btw2onboard2','tablet.form.btw2.livianos','datatype.scheduledactivitytype.btw2') THEN 'datatype.scheduledactivitytype.btw2' " +
            				"WHEN ca.type IN ('datatype.scheduledactivitytype.trainingonthejob','tablet.form.toj') THEN 'datatype.scheduledactivitytype.trainingonthejob' " +
            				"WHEN ca.type IN ('datatype.scheduledactivitytype.evaluacionencabina','tablet.form.evaluacionencabina') THEN 'datatype.scheduledactivitytype.evaluacionencabina' " +
            				"WHEN ca.type IN ('tablet.form.phrd','datatype.scheduledactivitytype.hrd') THEN 'datatype.scheduledactivitytype.hrd' " +
            				"ELSE ca.type " +
            				"END as type, ";
            		break;
            	/*case CorporationData.BAYER: case CorporationData.COVESTRO:
            		select += "CASE WHEN ca.type IN ('datatype.scheduledactivitytype.btw1','datatype.scheduledactivitytype.btw2','datatype.scheduledactivitytype.btw2onboard','datatype.scheduledactivitytype.btw2onboard2','datatype.scheduledactivitytype.btwonboard2', 'datatype.scheduledactivitytype.btwutilitarioreboque','tablet.form.btw1.livianos','tablet.form.btw1onboard','tablet.form.btw2.livianos','tablet.form.btw2onboard' ) THEN 'datatype.scheduledactivitytype.btw1' " +
            				"ELSE ca.type " +
            				"END as type, ";
	        		break;*/
            	default:
               		select += "ca.type as type, ";
            }
             select += "d.city as city, "+
               		"d.phoneNumber as phoneNumber "+
               		s[0]+
               		" from cepaactivity ca,activityregistry ar,drivers d,country c" + s[1];

            //restricciones de permisos
            select += UtilityQuery.filterDivs(divOrgs,divGeos,"d",userSessionData);

            //joins
            select += " and ca.activityid = ar.activity "+
               		"and d.id = ar.driver "+
               		"and ca.activityid = ar.activity  AND ca.dateexpiry IS NOT NULL "+
       		"and c.id = d.country "+s[2];

            /*tipos de actividades de la consulta
            select += " and ca.type in (";
            for(int i = 0; i < type.length; i++) {
            	if(i > 0)
            		select += ",";
        		select += "'"+type[i]+"'";
            }
            select += ") ";*/

            if(!Util.empty(firstName)) {
            	select += " AND lower(d.firstname) like '%"+firstName.toLowerCase()+"%' ";
            }
            if(!Util.empty(lastName)) {
            	select += " AND lower(d.lastname) like '%"+lastName.toLowerCase()+"%' ";
            }
            switch (status) {
               case DriverData.ACTIVE:
            	   select += " AND d.exclusionDate is null ";
                   break;
               case DriverData.EXCLUDED:
            	   select += " AND d.exclusionDate is not null ";
                   break;
           }
            if(!Util.empty(vehicleAllowed) && !vehicleAllowed.equals("datatype.vehicletype.all")) {
            	select += " AND d.vehicleallowed = '"+vehicleAllowed+"' ";
            }

            if(from != null) {
            	select += " AND ca.dateexpiry >= "+Util.formatSQL(from, 0);
            }

            if(to != null) {
            	select += " AND ca.dateexpiry < "+Util.formatSQL(to, 1);
            }

            //solo actividades dictadas
            select += " and ca.state = 'datatype.scheduledactivitystate.dictada' " +
            		" and (ar.note is null or ar.note NOT IN ('generic.activity.note.notapruved','generic.activity.note.practicepending','generic.activity.note.theoreticalpending')) " ;
            if(userSessionData.isCorporation(CorporationData.JJ)) {
            	select += "group by d.id,firstname,lastname,director,corporationid,allowed,licenseobs,c.resourcekey,type,d.city,phoneNumber,"+s[3];
            }else {
            	select += "group by d.id,firstname,lastname,director,email,allowed,licenseobs,c.resourcekey,type,d.city,phoneNumber,"+s[3];
            }
            select += " order by type,expiry desc";

            SQLQuery query = session.createSQLQuery(select);
            query.addScalar("id",Hibernate.INTEGER);
            query.addScalar("firstname",Hibernate.STRING);
            query.addScalar("lastname",Hibernate.STRING);
            query.addScalar("director",Hibernate.BOOLEAN);
            query.addScalar("email",Hibernate.STRING);
            query.addScalar("allowed",Hibernate.STRING);
            query.addScalar("licenseobs",Hibernate.STRING);
            query.addScalar("expiry",Hibernate.DATE);
            query.addScalar("country",Hibernate.STRING);
            query.addScalar("type",Hibernate.STRING);
            query.addScalar("city",Hibernate.STRING);
            query.addScalar("phoneNumber",Hibernate.STRING);
            StringTokenizer token = new StringTokenizer(s[3],",");
            while(token.hasMoreTokens()) {
                query.addScalar(token.nextToken(), Hibernate.STRING);
            }

            Iterator result = query.list().iterator();
    		HashMap<Integer,DriverMaxExpiry> values = new HashMap<Integer,DriverMaxExpiry>();
    		String ids = "0";
            while(result.hasNext()) {
            	Object[] data = (Object[])result.next();
            	if(indexes.containsKey((String)data[9])) {
	            	if(values.containsKey(data[0])) {
	            		values.get(data[0]).setMaxExpiry(indexes.get((String)data[9]),data);
	            	}else {
	            		values.put((Integer) data[0], new DriverMaxExpiry(data,type.length,indexes.get((String)data[9])));
	            		ids += ","+String.valueOf(data[0]);
	            	}
            	}
            }

            String select2 = "select d.id, " +
               		"d.firstName as firstname, " +
                    "d.lastName as lastname," +
                    "d.director as director,";
            if(userSessionData.isCorporation(CorporationData.JJ)) {
            	select2 += "d.corporationid as email,";
            }else {
            	select2 += "d.email as email,";
            }
            select2 += "d.vehicleAllowed as allowed," +
                    "d.licenseObs as licenseobs," +
               		"c.resourcekey as country, "+
                    "d.city as city, "+
               		"d.phoneNumber as phoneNumber "+
               		s[0]+
               		" from drivers d,country c" + s[1] +
               		UtilityQuery.filterDivs(divOrgs,divGeos,"d",userSessionData) +
               		" and c.id = d.country "+s[2];
            if(!Util.empty(firstName)) {
            	select2 += " AND lower(d.firstname) like '%"+firstName.toLowerCase()+"%' ";
            }
            if(!Util.empty(lastName)) {
            	select2 += " AND lower(d.lastname) like '%"+lastName.toLowerCase()+"%' ";
            }
            switch (status) {
               case DriverData.ACTIVE:
            	   select2 += " AND d.exclusionDate is null ";
                   break;
               case DriverData.EXCLUDED:
            	   select2 += " AND d.exclusionDate is not null ";
                   break;
           }
            if(!Util.empty(vehicleAllowed) && !vehicleAllowed.equals("datatype.vehicletype.all")) {
            	select2 += " AND d.vehicleallowed = '"+vehicleAllowed+"' ";
            }
            select2 += " AND d.id NOT IN ("+ids+")";
            query = session.createSQLQuery(select2);
            query.addScalar("id",Hibernate.INTEGER);
            query.addScalar("firstname",Hibernate.STRING);
            query.addScalar("lastname",Hibernate.STRING);
            query.addScalar("director",Hibernate.BOOLEAN);
            query.addScalar("email",Hibernate.STRING);
            query.addScalar("allowed",Hibernate.STRING);
            query.addScalar("licenseobs",Hibernate.STRING);
            query.addScalar("country",Hibernate.STRING);
            query.addScalar("city",Hibernate.STRING);
            query.addScalar("phoneNumber",Hibernate.STRING);
            token = new StringTokenizer(s[3],",");
            while(token.hasMoreTokens()) {
                query.addScalar(token.nextToken(), Hibernate.STRING);
            }

            result = query.list().iterator();
            while(result.hasNext()) {
            	Object[] data = (Object[])result.next();
            	if(!values.containsKey(data[0])) {
            		values.put((Integer) data[0], new DriverMaxExpiry(data));
            		ids += ","+String.valueOf(data[0]);
            	}
            }

            String selectLog = "SELECT * FROM driverlogistic WHERE driver IN ("+ids+")";
            query = session.createSQLQuery(selectLog);
            query.addScalar("driver",Hibernate.INTEGER);
            query.addScalar("activity",Hibernate.STRING);
            query.addScalar("dateLastSchedule",Hibernate.DATE);
            query.addScalar("city",Hibernate.STRING);
            query.addScalar("status",Hibernate.INTEGER);
            query.addScalar("observations",Hibernate.STRING);
            result = query.list().iterator();
            while(result.hasNext()) {
            	Object[] data = (Object[])result.next();
            	values.get(data[0]).addLogisticData(data);
            }

            lines.addAll(values.values());
    	}catch (Exception e) {
			Object[] parameters = {type,divOrgs,divGeos,status};
    		handler.getException(e,"getActivityLink",userSessionData,parameters);
		}
		return lines;
	}

    /**
     * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,systemaccess"
     */
	public boolean isInstructorActivities(UserSessionData userSessionData) throws Exception {
		try {
            Session session = HibernateUtil.currentSession();
            String select = "SELECT COUNT(*) AS c " +
            		"FROM cepaactivityinstructor cai " +
            		"JOIN cepaactivity ca ON cai.activityid = ca.activityid " +
            		"WHERE ca.corporation = "+userSessionData.getCorporationId()+
            		" AND loginname = '"+userSessionData.getFilter().getLoginName()+"'";
			return ((Integer)session.createSQLQuery(select).addScalar("c",Hibernate.INTEGER).uniqueResult()).intValue() > 0;
    	}catch (Exception e) {
			Object[] parameters = {};
    		handler.getException(e,"isInstructorActivities",userSessionData,parameters);
		}
		return false;
	}

    /**
     * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,systemaccess"
     */
	public Collection<InstructorActivity> getInstructorActivities(String instructor, int page, UserSessionData userSessionData) throws Exception {
		HashMap<Integer,InstructorActivity> activities = new HashMap<Integer,InstructorActivity>();
		try {
            Session session = HibernateUtil.currentSession();
    	    String[] s = userSessionData.getFilter().getFields("ca");
            String select = "SELECT DISTINCT cai.activityid,ca.date,ca.type,ca.state,ca.city" + s[0] +
            		" FROM cepaactivityinstructor cai,cepaactivity ca" + s[1]+
            		" WHERE cai.loginname IN ('"+instructor+"') "+
            		" AND ca.corporation = "+userSessionData.getCorporationId()+
            		" AND ca.activityid = cai.activityid " +
            		" AND ca.type LIKE '%tablet%' " + s[2] +
            		" ORDER BY ca.date DESC LIMIT 50";
            if(page > 0) {
            	select += " OFFSET "+String.valueOf(50*page);
            }
            String ids = "";
			SQLQuery q = session.createSQLQuery(select).addScalar("activityid",Hibernate.INTEGER).addScalar("date",Hibernate.DATE).addScalar("type",Hibernate.STRING).addScalar("state",Hibernate.STRING).addScalar("city",Hibernate.STRING);
            StringTokenizer token = new StringTokenizer(s[3],",");
            while(token.hasMoreTokens()) {
                q.addScalar(token.nextToken(), Hibernate.STRING);
            }

			Iterator it = q.list().iterator();
			while(it.hasNext()) {
				InstructorActivity activity = new InstructorActivity((Object[])it.next());
				ids += String.valueOf(activity.getId());
				if(it.hasNext()) {
					ids += ",";
				}
				activities.put(activity.getId(),activity);
			}

			if(activities.size() > 0) {
				String select2 = "SELECT ar.activity,ar.instructor,d.id,d.firstname,d.lastname,arl.userid,arl.date " +
						"FROM activityregistry ar " +
						"JOIN drivers d ON d.id = ar.driver " +
						"LEFT JOIN (SELECT * FROM activityregistrylog WHERE comment = 'Inserted by tablet') AS arl ON arl.registry = ar.activityregistryid " +
						"WHERE ar.activity IN ("+ids+")";
				q = session.createSQLQuery(select2).addScalar("activity",Hibernate.INTEGER).addScalar("instructor",Hibernate.STRING).addScalar("id",Hibernate.INTEGER).addScalar("firstname",Hibernate.STRING).addScalar("lastname",Hibernate.STRING).addScalar("userid",Hibernate.STRING).addScalar("date",Hibernate.DATE);
				it = q.list().iterator();
				while(it.hasNext()) {
					Object[] driver = (Object[])it.next();
					activities.get(driver[0]).addDriver(driver);
				}
			}
    	}catch (Exception e) {
			Object[] parameters = {};
    		handler.getException(e,"isInstructorActivities",userSessionData,parameters);
		}
		Collection<InstructorActivity> activityList = new LinkedList<InstructorActivity>();
		activityList.addAll(activities.values());
		Collections.sort((List<InstructorActivity>)activityList);
		return activityList;
	}

    /**
     * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,systemaccess"
     */
	public Collection<UserData> getActivityInstructors(UserSessionData userSessionData) throws Exception {
		Collection<UserData> instructors = new LinkedList<UserData>();
		try {
            Session session = HibernateUtil.currentSession();
			String s = "SELECT DISTINCT u.loginname, u.firstname, u.lastname " +
					"FROM cepaactivityinstructor cai,cepaactivity ca, users u " +
					"WHERE ca.corporation = " + userSessionData.getCorporationId() +
					" AND ca.activityid = cai.activityid " +
					"AND cai.loginname = u.loginname " +
					"AND ca.type LIKE '%tablet%' order by loginname";
			Query q = session.createSQLQuery(s).addScalar("loginname",Hibernate.STRING).addScalar("firstname",Hibernate.STRING).addScalar("lastname",Hibernate.STRING);
			Iterator it = q.list().iterator();
			while(it.hasNext()) {
				Object[] data = (Object[])it.next();
				instructors.add(new UserData((String)data[0], (String)data[1], (String)data[2], null, (String)data[0], null, 0, null, null, null));
			}
        } catch(Exception e){
			Object[] parameters = {};
    		handler.getException(e,"getActivityInstructors",userSessionData,parameters);
        }
        return instructors;
	}

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate,cepascheduleactivityregistrycreate,cepascheduleactivityregistryupdate,cepascheduleactivityview,cdactivitycreate,cdactivitymodify,driverviewowndata,jjreporter"
     */
	public HashMap<String, Integer> getMediaActivity(String type, Integer corporation, Integer country,UserSessionData userSessionData) throws Exception {
		HashMap<String, Integer> values = new HashMap<String, Integer>();
		try {
            Session session = HibernateUtil.currentSession();
			String s = "SELECT DISTINCT country, key, media FROM mediaactivity WHERE activity = '" + type +"' AND corporation = "+corporation+" AND country IN (0,"+country+") ORDER BY country DESC";
			Query q = session.createSQLQuery(s).addScalar("country",Hibernate.INTEGER).addScalar("key",Hibernate.STRING).addScalar("media",Hibernate.INTEGER);
			Iterator it = q.list().iterator();
			while(it.hasNext()) {
				Object[] data = (Object[])it.next();
				if(values.containsKey(data[1])) {
					return values;
				} else {
					values.put((String) data[1], (Integer) data[2]);
				}
			}

		} catch(Exception e){
			Object[] parameters = {type,corporation,country};
    		handler.getException(e,"getMediaActivity",userSessionData,parameters);
        }
		return values;
	}

  	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     * @throws Exception
   	 */
	public ResumeItem getActivityResume(UserSessionData userSessionData)  throws Exception {
		Calendar c = Calendar.getInstance();
		ResumeItem item = new ResumeItem("query.resume.activities");
		try {
			String sql = "SELECT c.resourcekey as country, ca.type, ar.note, count(*) " +
					"FROM cepaactivity ca " +
					"JOIN activityregistry ar ON ar.activity = ca.activityid " +
					"JOIN country c ON c.id = ca.country ";
			if(userSessionData.isCorporation(CorporationData.BAYER_MX)) {
				sql += " WHERE ca.corporation = "+CorporationData.BAYER_MX;
			}else {
				sql += UtilityQuery.corporationRestrictionsSQL(new Integer[0][0], new Integer[0], "ca", userSessionData);
			}
			sql = " AND ca.date >= '"+c.get(Calendar.YEAR)+"-01-01' " +
					"AND ca.state = 'datatype.scheduledactivitystate.dictada' " +
					"GROUP BY resourcekey, type, note";
	        Session session = HibernateUtil.currentSession();

	        SQLQuery q = session.createSQLQuery(sql);
	        q.addScalar("country", Hibernate.STRING);
	        q.addScalar("type", Hibernate.STRING);
	        q.addScalar("note", Hibernate.STRING);
	        q.addScalar("count", Hibernate.INTEGER);
	        Iterator it = q.list().iterator();
	        while(it.hasNext()) {
	        	item.addData(0,(Object[]) it.next());
	        }
        } catch(Exception e){
			Object[] p = {};
			handler.getException(e, "getDriverResume", userSessionData, p);
        }
		return item;
	}

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate,query,jjreporter"
     */
	public boolean existsTodayActivity(Integer driver, String activityType, UserSessionData userSessionData)throws Exception {
		Calendar c = Calendar.getInstance();
		ResumeItem item = new ResumeItem("Conductores en cursos a partir de "+c.get(Calendar.YEAR));
		try {
			String sql = "SELECT COUNT(*) AS c FROM activityregistry ar " +
					"JOIN cepaactivity ca ON ca.activityid = ar.activity " +
					"WHERE ca.type = '"+activityType+"' " +
					"AND ar.driver = "+driver+" AND date_trunc('day',ca.date) = "+Util.formatSQL(Calendar.getInstance());
	        Session session = HibernateUtil.currentSession();

	        SQLQuery q = session.createSQLQuery(sql);
	        q.addScalar("c", Hibernate.INTEGER);
	        return ((Integer)q.uniqueResult()).intValue() > 0;
        } catch(Exception e){
			Object[] p = {};
			handler.getException(e, "existsTodayActivity", userSessionData, p);
        }
		return false;
	}

    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivityupdate,cepascheduleactivityview,cepascheduleactivityregistrycreate,cepascheduleactivityregistryupdate,cdactivitycreate,cdactivitymodify"
     */
	public ActivityRegistryData[] getParticipantData(Integer activity, UserSessionData userSessionData) throws Exception {

		try {
			String sql = "SELECT d.id, d.firstname, d.lastname, d.temporal, ar.note, ar.obs, ar.hasresult " +
					"FROM activityregistry ar " +
					"JOIN drivers d ON d.id = ar.driver " +
					"WHERE activity = "+activity;
	        Session session = HibernateUtil.currentSession();

	        SQLQuery q = session.createSQLQuery(sql);
	        q.addScalar("id", Hibernate.INTEGER);
	        q.addScalar("firstname", Hibernate.STRING);
	        q.addScalar("lastname", Hibernate.STRING);
	        q.addScalar("temporal", Hibernate.BOOLEAN);
	        q.addScalar("note", Hibernate.STRING);
	        q.addScalar("obs", Hibernate.STRING);
	        q.addScalar("hasresult", Hibernate.BOOLEAN);

	        List list = q.list();
	        ActivityRegistryData[] registry = new ActivityRegistryData[list.size()];
	        Iterator it = list.iterator();
	        int index = 0;
	        while(it.hasNext()) {
	        	registry[index] = new ActivityRegistryData((Object[])it.next());
	        	index++;
	        }
	        return registry;
        } catch(Exception e){
			Object[] p = {};
			handler.getException(e, "getParticipantData", userSessionData, p);
        }
		return null;
	}

	/**
	 * @throws InvalidDataException
	 * @throws DeslogedException
	 * @throws CommunicationProblemException
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,eventcreate,finecreate,cepascheduleactivityview,cepascheduleactivityupdate,cepascheduleactivityregistrycreate,cepascheduleactivityregistryupdate,cdactivitycreate,cdactivitymodify,driverviewowndata"
	 */
	public Collection<ActivityAttendanceData> getAttendanceList(Integer idActivity, UserSessionData userSessionData) throws Exception {
		Collection<ActivityAttendanceData> values = new LinkedList<ActivityAttendanceData>();
		try {
			Session session = HibernateUtil.currentSession();
			String sql = "SELECT attendance FROM ActivityAttendance as attendance WHERE attendance.activity = :id";
			Query query = session.createQuery(sql);
			query.setParameter("id", idActivity);
			
			Iterator<ActivityAttendance> it = query.list().iterator();
			while(it.hasNext())
				values.add(it.next().getData());
        } catch(Exception e){
			Object[] p = {};
			handler.getException(e, "getAttendanceList", userSessionData, p);
        }
		return values;
	}
}
