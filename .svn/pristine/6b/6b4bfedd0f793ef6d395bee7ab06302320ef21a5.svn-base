package communication.external.instructors;

import java.util.ArrayList;

import org.codehaus.jackson.annotate.JsonIgnoreProperties;

@JsonIgnoreProperties(ignoreUnknown = true)
public class CorporationRestData {
	
	private Integer id;
	
	private String name;
	
	private ArrayList<DriverRestData> newDrivers;
	private ArrayList<DriverRestData> updateDrivers;
	private ArrayList<ActivityRestData> activities;
	
	
	public ArrayList<ActivityRestData> getActivities() {
		return activities;
	}
	public void setActivities(ArrayList<ActivityRestData> activities) {
		this.activities = activities;
	}
	public Integer getId() {
		return id;
	}
	public void setId(Integer id) {
		this.id = id;
	}
	public String getName() {
		return name;
	}
	public void setName(String name) {
		this.name = name;
	}
	public ArrayList<DriverRestData> getNewDrivers() {
		return newDrivers;
	}
	public void setNewDrivers(ArrayList<DriverRestData> newDrivers) {
		this.newDrivers = newDrivers;
	}
	public ArrayList<DriverRestData> getUpdateDrivers() {
		return updateDrivers;
	}
	public void setUpdateDrivers(ArrayList<DriverRestData> updateDrivers) {
		this.updateDrivers = updateDrivers;
	}
	
	

}
