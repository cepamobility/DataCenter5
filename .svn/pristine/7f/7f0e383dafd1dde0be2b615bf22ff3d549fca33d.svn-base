package communication.activity.tables;

import java.io.Serializable;
import java.util.Date;

public class ActivityObservationData implements Serializable {

    /**
	 * 
	 */
	private static final long serialVersionUID = 1L;
	private Integer activityId;
    private Date date;
    private String user;
    private Integer action;
    private String comment;

    public ActivityObservationData(Integer activityId, Date date, String user, Integer action, String comment) {
        this.activityId = activityId;
        this.date = date;
        this.user = user;
        this.action = action;
        this.comment = comment;
    }

    /**
     * @return Returns the action.
     */
    public Integer getAction() {
        return action;
    }

    /**
     * @return Returns the comment.
     */
    public String getComment() {
        return comment;
    }

    /**
     * @return Returns the date.
     */
    public Date getDate() {
        return date;
    }

    /**
     * @return Returns the driverId.
     */
    public Integer getActivityId() {
        return activityId;
    }

    /**
     * @return Returns the user.
     */
    public String getUser() {
        return user;
    }

    /**
     * @param action The action to set.
     */
    public void setAction(Integer action) {
        this.action = action;
    }

    /**
     * @param comment The comment to set.
     */
    public void setComment(String comment) {
        this.comment = comment;
    }

    /**
     * @param date The date to set.
     */
    public void setDate(Date date) {
        this.date = date;
    }

    /**
     * @param driverId The driverId to set.
     */
    public void setActivityId(Integer activityId) {
        this.activityId = activityId;
    }

    /**
     * @param user The user to set.
     */
    public void setUser(String user) {
        this.user = user;
    }

}
