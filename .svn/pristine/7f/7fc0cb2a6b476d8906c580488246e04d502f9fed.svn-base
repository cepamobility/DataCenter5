                      }else {
                          word.append(car);
                      }
                  }
                  
                  // Coloco el driver en la coleccion de drivers para insertar en la base de datos
                  if(!Util.empty(driver.getFirstName()) && !Util.empty(driver.getLastName() )){
                	  
                	  // Antes de insertarlo valido que no exista ese driver 
                	  // en la base de datos
                	  
                	  if (driverReport.existDriver(sys.getUserSessionData(),
                			driver.getFirstName(),driver.getLastName(),driver.getBirthDate())){
                		
                		  // Si existe el driver le indico al usuario que no se va a insertar
                		  // de nuevo.
                		
                		  String msg = driver.getFirstName()+ 
                		  	" "+driver.getLastName()+". ("+
                		  	messages.getText("driver.messages.upload.linenumber")+": "+lineNumber+")";
                		  notInsertedDrivers.add(msg);
                	  }else{
                		  // Si los drivers no existen los agrego:  
                		  CorporationData corp = new CorporationData(userSessionData.getFilter().getCorporationId(),null,null,null,null,null);
                		  driver.setCorporation(corp);
                		  
                          String valid = driver.validate(userSessionData);
                		  
                		  if (valid != null){
                			  System.out.println("Error: "
                            		  +driver.getFirstName()+" "+driver.getLastName()+": "+messages.getText(valid)
                            		  +" "+messages.getText("driver.messages.upload.linenumber")+" "+lineNumber);
                              session.setAttribute("Msg", "Error: "+messages.getText(valid)
                    				  +". \\n"+messages.getText("driver.messages.upload.linenumber")+" "+lineNumber);
                    	  	  return mapping.findForward("error");    
                		  }
                	      drivers.add(driver);
                	  }
                  }                  
                  lineNumber++; // incremento numero de linea del archivo 
              }            
              
             
              // Inserto los drivers:              
              DriverABMFacade driverABM = null;
              driverABM = sys.getDriverABMFacade();              
              driverABM.createDrivers(drivers,sys.getUserSessionData(),notes);
              
              // Total Drivers insertados:
              total = drivers.size();              
              // Drivers no insertados:
              result = new ListResult(notInsertedDrivers,notInsertedDrivers.size());
              
              // System.out.println("Inserte "+total+"Conductores.....");
              
          } catch (Exception e) {
              e.printStackTrace();
        	  System.out.println("Excepcion....."+e.getMessage());
        	  throw e;
          }
          
          session.setAttribute("notupload",result);
          session.setAttribute("total", (new Integer(total)).toString());        		  
          session.setAttribute("entity","driver.messages.upload");
          return mapping.findForward("success");	
    }
    
    


