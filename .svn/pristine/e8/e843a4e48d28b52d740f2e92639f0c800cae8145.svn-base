<%@page language="java" 
	errorPage="../exception.jsp" 
	import="java.util.*"
	import="business.*"
	import="business.vehicle.*"
	import="business.administration.user.*"
	import="communication.language.*"
	import="communication.security.*"
	import="communication.administration.user.tables.*"
	import="communication.vehicle.tables.*"
	import="communication.administration.corporation.tables.*"
	import="communication.vehicle.tables.*"
	import="communication.util.*"
 	import="presentation.translator.web.util.*"
 	import="presentation.translator.web.vehicle.*" 	
%>

<%@ taglib uri="/WEB-INF/struts-html.tld"
        prefix="html"
%>
<script language="JavaScript" type="text/javascript">
function submitPagination(page,all) {
	document.forms[2].all.value = all;
	document.forms[2].pageNum.value = page;
	document.forms[2].submit();
}
function setAction(form,action){
	form.action.value=action;
}
</script>

<html:html>
<%!
	RequestDispatcher dispatcher; 
	Text messages; SystemAccess sys;
	Integer pageNum; 
	boolean all; 
	int pageSize; 
	String attribute; String value;
	String nextLink;
	String next;
%>
<%
	
	sys=(SystemAccess)session.getAttribute("SystemAccess");
	String check = Util.checkPermission(sys,SecurityConstants.VIEW_VEHICLE_LIST);
	session.removeAttribute("EventForm");
	if(check!=null) {
		response.sendRedirect(request.getContextPath()+check);
	}else {

		messages=sys.getText();
	
		nextLink = request.getParameter("link");
		String url = "/vehicle/VehicleSearch.jsp?link="+nextLink;
		
		if(!Util.empty(request.getParameter("id"))) {
			nextLink += "&id="+request.getParameter("id");
			url += "&id="+request.getParameter("id");
		}   		
	
		session.setAttribute("target","VehicleSearch");
	
		boolean advanced = (request.getParameter("advanced") != null);	
		
		String status = String.valueOf(VehicleData.ALL);
		if(!Util.empty(request.getParameter("status"))) {
		    status = request.getParameter("status");
		}
		
		attribute = "matricula";		
		pageNum = new Integer(1);
		if(!advanced) {
			if(request.getParameter("pageNum")!=null){
				pageNum=new Integer(request.getParameter("pageNum"));
			}else{
				pageNum=new Integer(1);
			}
		}else{
			// Advanced Search
			if(session.getAttribute("vehicleForm") != null) {
			    pageNum=new Integer(((VehicleAdvancedSearchForm)session.getAttribute("vehicleForm")).getPageNum());
				nextLink=((VehicleAdvancedSearchForm)session.getAttribute("vehicleForm")).getNextLink();
			}else{
				if(request.getParameter("pageNum")!=null){
					pageNum=new Integer(request.getParameter("pageNum"));
				}else{
					pageNum=new Integer(1);
				}
			}
		}

		if (pageNum.intValue() < 1) pageNum = new Integer(1);
		
		if(request.getParameter("attribute")!=null){
			attribute = request.getParameter("attribute");
		}		
		value = "";		
		if(request.getParameter("value")!=null){
			value = request.getParameter("value");
		}		
		pageSize = 10;
		if(request.getParameter("pageSize")!=null){
			pageSize = Integer.parseInt(request.getParameter("pageSize"));
		}
	
		int first = 0;
		int count = pageSize;
		all=!Util.empty(request.getParameter("all")) && request.getParameter("all").equals("true");
		if(all) {
			count = -1;
		}else{
		    first=(pageNum.intValue()-1)*pageSize;				
		}	
		VehicleReportFacade vehicleReportFacade = sys.getVehicleReportFacade();
		String link = "layout.jsp?refer=/vehicle/VehicleSearch.jsp";
		if(!advanced) {
			session.setAttribute("vehicleSearchList",vehicleReportFacade.findVehicleList(attribute,value,first,count,Integer.parseInt(status),sys.getUserSessionData()));
		}		
		String title = "web.vehicle.vehiclelist.systemvehicles";
		if(request.getParameter("title") != null) {
			title = request.getParameter("title");
			url += "&url="+url;			
		}    
		session.setAttribute("url",url);
		

%>		

<script language="javascript" src='/datacenter/menu/js/driverFunctions.js' type='text/javascript' >
</script>

	<!-- VehicleSearch.jsp -->
	<LINK REL=StyleSheet HREF="../util/css/estilo.css" TYPE="text/css">
<head>
		<META http-equiv="Cache-Control" content="no-cache">
		<META http-equiv="Pragma" content="no-cache">
		<META http-equiv="Expires" content="-1">		
</head>

<body bgcolor="#FFFFFF">
	<table width="600" border="0" align="center" cellpadding="0" cellspacing="0">
		<tr class="guide1">
			<jsp:include  page='<%="../component/titlecomponent.jsp?title="+messages.getText(title)%>' />
  		</tr>
      	<tr>
			<jsp:include  page="../component/spaceline.jsp" />
      	</tr>
      	<tr>
        	<td valign="top" <%=(advanced)?"colspan=3":"width='60%'"%> >
				<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("generic.messages.search")%>' />
				<table width="100%" border="0" cellpadding="0" cellspacing="0">
					<tr>
						<td width="100%">
<%						if(advanced) { 	%>	
							<!-- Búsqueda Avanzada -->
							<jsp:include page='<%="/vehicle/advancedSearch.jsp?pageNum="+first+"&count="+count+"&link="+nextLink%>'/>
							<div align="right">
								<span class="input">
			                        <img align="middle" border="0" src="/datacenter/util/imgs/icon1.jpg" width="12"> 
									<a href='layout.jsp?refer=/vehicle/VehicleSearch.jsp?link=<%=nextLink%>&pageNum=<%=String.valueOf(pageNum)%>' class="texts">
										<%=messages.getText("generic.messages.simplesearch")%>
									</a>
								</span>
							</div>
<%						}else {		%>
							<!-- Búsqueda Simple -->
							<form name="BusquedaSimple" action="layout.jsp?refer=/vehicle/VehicleSearch.jsp" method="post">
								<table width="100%" border="0" cellpadding="0" cellspacing="0" >
									<tr>
										<td style="width:65" class="texts" align="left">
											<input type="hidden" name="pageNum" value='<%=String.valueOf(pageNum)%>'>    
											<input type="hidden" name="all" value='<%=(all) ? "all" : "" %>' > 
	   										<input type="hidden" name="link" value='<%=nextLink%>'/>	   										
											<%=messages.getText("generic.vehicle.vehicledata.registrationNumber")%>:									
										</td >
										<td align="left">	
											<input type="text" name="value" value='<%=value%>' 
											size="40" class="input">   									
	   										<input type="hidden" name="link" value='<%=nextLink%>'/>    
	   										<input type="hidden" name="pageSize" value='<%=pageSize%>'/>    											
										</td>									
								  	</tr>
								  	<tr>
								  		<td></td>
									  	<td align="left" valign="top" class="texts">										
											<!-- Activo/ Excluidos / Todos -->
											<table>
												<tr>											
													<td>
														<input type="radio" class="input2" name="status"
														value='<%=VehicleData.ACTIVE%>' <%=(Integer.parseInt(status) == VehicleData.ACTIVE) ? "checked" : ""%>>
														<span class="input2"><%=messages.getText("generic.messages.active")%></span>
													</td>
													<td>
														<input type="radio" class="input2" name="status" 
														value='<%=VehicleData.EXCLUDED%>' <%=(Integer.parseInt(status) == VehicleData.EXCLUDED) ? "checked" : ""%>>
														<span class="input2"><%=messages.getText("generic.messages.excluded")%></span>
													</td>
													<td>
														<input type="radio" class="input2" name="status" 
														value='<%=VehicleData.ALL%>' <%=(Integer.parseInt(status) == VehicleData.ALL) ? "checked" : ""%>>
														<span class="input2"><%=messages.getText("generic.messages.all.pl")%></span>
													</td>
												</tr>
											</table>
										</td>
									</tr>	
									<tr>
								   		<td height="10" colspan="3">
									  		<img src="x" width="1" height="1">
									  	</td>
 								    </tr>														  	  
									<tr>
										<td align="right" colspan="3">
										<table width="100%" border="0" cellspacing="0" cellpadding="0">
										  <tr>
											<td align="left" valign="bottom">
											<img align="middle" border="0" src="/datacenter/util/imgs/icon1.jpg" width="12">
											&nbsp;
											<a href='layout.jsp?refer=/vehicle/VehicleSearch.jsp?link=<%=nextLink%>&advanced=true&pageNum=<%=String.valueOf(pageNum)%>'
											 class="texts">
												<%=messages.getText("generic.messages.advancedsearch")%>		
											</a>											
											</td>
											<td align="right">
												<input name="button" type="button" 
												onClick="javascript:document.forms[2].submit();" 
												value='<%=messages.getText("generic.messages.search")%>' class="input"/>													
											</td>
										  </tr>
										  
										</table>					
										</td>
									</tr>
								</table>									
						  </form>	
<%					}	%>
						</td>
					</tr>
				</table>			
   				<jsp:include page="../component/utilityboxbottom.jsp"/>	
		  </td>
      	</tr>
      	<tr>
			<jsp:include  page="../component/spaceline.jsp" />
      	</tr>
      	<tr>
        	<td colspan="3">
				<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("web.vehicle.vehiclelist.systemvehicles")%>' />
				<table width='100%' border="0" align='center' cellpadding="0" cellspacing="0">
      				<tr>
        				<td width="100%">
<%!		ListResult col; 
		Iterator iter; 
		VehicleMainAttributes vehicle; 
		int i;
		String uid; 
		int pageMax; 
		int contIter; 
		int total;
%>

<%		col=(ListResult)session.getAttribute("vehicleSearchList");
		total = col.getTotal();
		if (all) pageSize = total; // Added 4/Sep/2006
		
		if(col!=null && col.getElements().isEmpty()){
%>							<!--  Dibujo Grilla -->
            				<table width="100%" border="0">
              					<tr align="center">
					                <td width='30%' class="guide2">					                
					                <%=messages.getText("generic.vehicle.vehicledata.registrationNumber")%>						            
					                </td>
					                <td width='30%'	class="guide2"><%=messages.getText("generic.vehicle.vehicledata.year")%></td>
					                <td width='30%'	class="guide2"><%=messages.getText("generic.vehicle.vehicledata.country")%></td>
              					</tr>
            				</table>
          					<%=messages.getText("generic.messages.notresult")%>
<%		}else {
			if(col!=null){
				contIter=0;
				iter=col.getElements().iterator();
				contIter=0;
%>
              					<table width="100%" border="0">
                					<tr align="center">                					
						                <td width='30%' class="guide2">
						                		<%=messages.getText("generic.vehicle.vehicledata.registrationNumber")%>
						                	
						                </td>
						                <td width='30%'	class="guide2"><%=messages.getText("generic.vehicle.vehicledata.year")%></td>
						                <td width='30%'	class="guide2"><%=messages.getText("generic.vehicle.vehicledata.country")%></td>
                					</tr>
              					</table>
              					<table name="vehicles" width="100%" >
<%				while(iter.hasNext() && (contIter<pageSize || all)){
					contIter++;
    				vehicle=(VehicleMainAttributes)iter.next();
%>
                					<tr align=center align="right" class='<%=((contIter % 2)==0) ? "lineone" : "linetwo"%>'>
	          							<td width='30%' align="right">
		              						<a href='<%=nextLink+"&vehicle="+String.valueOf(vehicle.getId())%>' > 
		              							<%=vehicle.getMatricula()%>
		              						</a>
		              						
              							</td>
						                <td width='30%' align="right"><%=vehicle.getYear()%> </td>
						                <td width='30%' align="right"><%=messages.getText(vehicle.getCountryName())%> </td>						                
                					</tr>
<%				}
%>
           					</table>
          				</td>
      				</tr>
      				<tr>
        				<td>
<%						Hashtable paginationParameters = new Hashtable();
						paginationParameters.put("attribute",attribute);
						paginationParameters.put("value",value);
						paginationParameters.put("advanced",String.valueOf(advanced));
						paginationParameters.put("status",status);
						paginationParameters.put("title",title);
						session.setAttribute("paginationParameters",paginationParameters);						
						%> 
						<jsp:include page='<%="../util/pagination2.jsp?size="+pageSize+"&num="+pageNum.intValue()+"&total="+String.valueOf(total)+"&link="+link%>' />        						
        				</td>
      				</tr>
<%			}			
		}	
%>				</table>
   				<jsp:include page="../component/utilityboxbottom.jsp"/>	
			</td>
      	</tr>
  </table>
</body>
<%	}
%>
</html:html>
