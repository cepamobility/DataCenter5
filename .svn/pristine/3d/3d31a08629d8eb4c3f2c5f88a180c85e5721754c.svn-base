    throws javax.ejb.CreateException {
    }
	
	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,eventcreate,drivercreateevent"
	 *@return Asigned Primery Key
	 */
	public Integer createEvent(EventDataType data, UserSessionData userRequest, String comment) throws Exception{
		return createEvent(data,userRequest,comment,false);
	}
	
	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,eventcreate,drivercreateevent"
	 *@return Asigned Primery Key
	 */
	public Integer createEvent(EventDataType data, UserSessionData userRequest, String comment, boolean withDriverData)	throws Exception{
		
		if (userRequest == null) {
			throw new DeslogedException("Has ocurred error in class persistence.event.EventABM(createEvent), session data is empty","generic.error.deslogued");
		}

		if (data == null) {
			throw new InvalidDataException("Has ocurred error in class persistence.event.EventABM(createEvent), user data is empty","generic.event.eventdata.isempty");
		}
		
		try{
            
            Session session = HibernateUtil.currentSession();
            
			String msg = validateCreateEvent(data);
			if(msg != null){
				throw new InvalidDataException("Has ocurred error in class persistence.event.EventABM",msg); 
			}
			
			//msg=securityValidation(itemDataSet,countryData,userRequest);		
			if(msg!=null){
				throw new InvalidDataException("Has ocurred error in class persistence.event.EventABM, security exception", msg);
			}
            
            if(userRequest.isDriver()) {
                if(!data.getDriver().getId().equals(userRequest.getDriverData().getId())) {
                    throw new InvalidDataException("createEvent","Invalid driver");
                }
            }   
            EventAbstract event = new Event(data,session,userRequest.isForest(),withDriverData);
			Integer id = (Integer) session.save(event);	
			
			
			EventLog log = new EventLog(userRequest.getFilter().getLoginName(),new Date(),LogActions.CREATE,(Event)event,comment);
            session.save(log);
            
            return id;
           
		
        } catch(Exception e){
        	Object[] p = new Object[2];
        	p[0] = data;
        	p[1] = comment;
            handler.getException(e,"createEvent",userRequest,p);
        }
        return null;
	}
	
	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,finecreate,drivercreatefine"
     *@return Asigned Primery Key
     */
    public Integer createFine(FineDataType data, UserSessionData userRequest, boolean withDriverData)
        throws CommunicationProblemException, DeslogedException, InvalidDataException{
        
                
        if(userRequest.isDriver()) {
            if(!data.getDriver().getId().equals(userRequest.getDriverData().getId())) {
                throw new InvalidDataException("createEvent","Invalid driver");
            }
        }

        try{
            
            Session session = HibernateUtil.currentSession();
                        
            EventAbstract event = new Fine(data,session,withDriverData);
            Integer fineId = (Integer)session.save(event);            
            event.setId(fineId);
            
            EventLog log = new EventLog(userRequest.getFilter().getLoginName(),new Date(),LogActions.CREATE,(Fine)event,"comment");
            session.save(log);

            return event.getId();
            
        } catch(HibernateException he){
            logger.error(logFormatting.formattingText(he,"eventCreate(EventDataType, UserSessionData)","HibernateException",userRequest.getFilter().getLoginName()), he);
            throw new CommunicationProblemException("Has ocurred error in persistence.event.eventABM, HibernateException","generic.error.hibernate");
        } catch(InvalidDataException ide){
            throw ide;
        } catch(Exception e){
            e.printStackTrace();
            logger.error(logFormatting.formattingText(e,"eventCreate(EventDataType, UserSessionData)","Exception",userRequest.getFilter().getLoginName()),e);
            throw new DCException(e);
        }
        
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,finecreate,drivercreatefine"
     *@return Asigned Primery Key
     */
    public Integer createFine(FineDataType data, UserSessionData userRequest)
        throws CommunicationProblemException, DeslogedException, InvalidDataException{
    	return createFine(data,userRequest,false);
    }
    
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,eventdelete"
     *@return Asigned Primery Key
     */
    public void deleteEvent(Integer eventId, UserSessionData userRequest, String comment)
        throws Exception{
        
        if (userRequest == null) {
            throw new DeslogedException("Has ocurred error in class persistence.event.EventABM(deleteEvent), session data is empty","generic.error.deslogued");
        }

        if (eventId == null) {
            throw new InvalidDataException("Has ocurred error in class persistence.event.EventABM(deleteEvent), event data is empty","generic.event.eventdata.isempty");
        }
        
        try{
            
            Session session = HibernateUtil.currentSession();
            EventAbstract eventAbstract = (EventAbstract)session.load(EventAbstract.class, eventId);

                     
            session.delete(eventAbstract);            
		
            EventLog log = null;
            int type = eventAbstract.getMainAttributes().getType();
            if(type == EventDataType.FINE) {
                Fine fine = (Fine)session.load(Fine.class, eventId);
                log = new EventLog(userRequest.getFilter().getLoginName(),new Date(),LogActions.DELETE,fine,"comment");
            }else {
                Event event = (Event)session.load(Event.class, eventId);
                log = new EventLog(userRequest.getFilter().getLoginName(),new Date(),LogActions.DELETE,event, comment);
            }
                 
            session.save(log);
        } catch(Exception e){
        	Object[] p = new Object[2];
        	p[0] = eventId;
        	p[1] = comment;
            handler.getException(e,"deleteEvent",userRequest,p);
        	
        }
        
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,eventsupervise,eventupdate,drivereventupdate"
     *@return Asigned Primery Key
     */
    public void updateEvent(EventDataType data, UserSessionData userRequest,String comment)
        throws Exception{
        
        if (userRequest == null) {
            throw new DeslogedException("updateEvent","generic.error.deslogued");
        }

        if (data == null) {
            throw new InvalidDataException("updateEvent","generic.event.eventdata.isempty");
        }
        
        if(userRequest.isDriver()) {
            if(!data.getDriver().getId().equals(userRequest.getDriverData().getId())) {
                throw new InvalidDataException("updateEvent","Invalid driver");
            }
            if(data.getStatus().intValue() != EventDataType.PENDING_SUPERVISION) {
                throw new DeslogedException("updateEvent","Invalid action");
            }
        }

        try{
            
            Session session = HibernateUtil.currentSession();
            
            String msg=validateCreateEvent(data);
            if(msg!=null){
                throw new InvalidDataException("Has ocurred error in class persistence.event.EventABM",msg); 
            }
            
            //Event event = (Event)session.load(Event.class, data.getId());
            Event event;
            if (userRequest.isForest() || userRequest.getCorporationId() == CorporationData.CIMSA){
            	event = new Event(data,session,true);
            }else{
            	event = new Event(data,session,false);
            }
            /* Actualizo lo damages para las Forestales 
            if (userRequest.isForest()){
            	Set setDamages = event.getEventDamages();
            	Iterator it = setDamages.iterator();
            	while (it.hasNext()){
            		EventDamage ed = (EventDamage)it.next();
            		EventDamage ed2 = (EventDamage)session.load(EventDamage.class, ed.getId());
            		if (!data.getEventDamages().contains(ed2)){
            			session.delete(ed2);
            		}
            	}            	
            }*/            
            //event.setEventData(data,session);

            
            session.update(event);            
            
            EventLog log = new EventLog(userRequest.getFilter().getLoginName(),new Date(),
            		LogActions.UPDATE,event,comment);
            session.save(log);

        } catch(Exception e){
        	Object[] p = new Object[2];
        	p[0] = data;
        	p[1] = comment;
            handler.getException(e,"updateEvent",userRequest,p);
        }
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fineupdate,drivereventupdate"
     *@return Asigned Primery Key
     */
    public void updateFine(FineDataType data, UserSessionData userRequest)
        throws Exception{
        
       
        
        if(userRequest.isDriver()) {
            if(!data.getDriver().getId().equals(userRequest.getDriverData().getId())) {
                throw new InvalidDataException("updateFine","Invalid driver");
            }
            if(data.getStatus().intValue() != EventDataType.PENDING_SUPERVISION) {
                throw new DeslogedException("updateFine","Invalid action");
            }
        }
        try{
            
            Session session = HibernateUtil.currentSession();            
                      
            Fine event = new Fine(data,session);
            session.update(event);            
            
            EventLog log = new EventLog(userRequest.getFilter().getLoginName(),new Date(),LogActions.UPDATE,event,"comment");
            session.save(log);

        } catch(Exception e){
        	Object[] p = new Object[1];
        	p[0] = data;        	
            handler.getException(e,"updateFine",userRequest,p);
        }
        
    }
    
