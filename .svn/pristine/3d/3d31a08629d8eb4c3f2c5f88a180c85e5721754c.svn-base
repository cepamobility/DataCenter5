	/**
	 * 
	 * @param itemDataSet
	 * @param countryData
	 * @param userRequest
	 * @return
	 */
	@SuppressWarnings("unused")
	private String securityValidation(Collection itemDataSet,CountryData countryData, UserSessionData userRequest){
		String resourceKey=null;
			try{
				Session session = HibernateUtil.currentSession();
				//Check country integrity 
				Corporation corporation=(Corporation)session.load(Corporation.class,userRequest.getFilter().getCorporationId());
				Country country=(Country)session.load(Country.class,countryData.getId());
				CorporationCountryPK pk=new CorporationCountryPK(country,corporation); 
				CorporationCountry corporationcountry=(CorporationCountry)session.load(CorporationCountry.class,pk);
				if(corporationcountry==null){
					resourceKey="security.messages.invalidcountry";
				}
				
				//Check DivOrg Integrity
                Map ids=new HashMap();
                Map countryIds=new HashMap();
				Iterator it=userRequest.getFilter().getGroupLines().iterator();
				while(it.hasNext()){
					GroupLineData groupLineData=(GroupLineData)it.next();
                    LabelItemData[] lids = groupLineData.getDivOrgs();
					for(int i = 0; i < lids.length;i++){
                        LabelItemData lid = lids[0];
                        Iterator it0 = lid.getItemIterator();
                        while(it0.hasNext()) {
                            ItemData itemData = (ItemData)it0.next();
                            if(itemData.getSubItems()==null){
                                ids.put(itemData.getId(),itemData.getId());
                            }else {
                                Iterator it1 = itemData.getSubItems().getItemIterator();
                                while(it1.hasNext()) {
                                    itemData = (ItemData)it1.next();
                                    if(itemData.getSubItems()==null){
                                        ids.put(itemData.getId(),itemData.getId());
                                    }else {
                                        Iterator it2 = itemData.getSubItems().getItemIterator();
                                        while(it2.hasNext()) {
                                            itemData = (ItemData)it2.next();
                                            ids.put(itemData.getId(),itemData.getId());
                                        }
                                    }
                                }
                            }
						}
                    }
                    GeoLabelData lid = groupLineData.getCountry();
                    Iterator it0 = lid.getItemIterator();
                    while(it0.hasNext()) {
                        GeoItemData itemData = (GeoItemData)it0.next();
                        if(itemData.getSubItems()==null){
                            ids.put(itemData.getId(),itemData.getId());
                        }else {
                            Iterator it1 = itemData.getSubItems().getItemIterator();
                            while(it1.hasNext()) {
                                itemData = (GeoItemData)it1.next();
                                if(itemData.getSubItems()==null){
                                    ids.put(itemData.getId(),itemData.getId());
                                }else {
                                    Iterator it2 = itemData.getSubItems().getItemIterator();
                                    while(it2.hasNext()) {
                                        itemData = (GeoItemData)it2.next();
                                        ids.put(itemData.getId(),itemData.getId());
                                    }
                                }
                            }
                        }
                    }
                }
				Iterator iter =itemDataSet.iterator();
				while(iter.hasNext() && resourceKey == null){
					ItemAttribute itemLevel1Attr=(ItemAttribute)iter.next();
					if( ids.get(itemLevel1Attr.getId()) == null){
						resourceKey="security.message.invaliddivorgitemlevel1{"+itemLevel1Attr.getId()+" "+itemLevel1Attr.getName()+"}";
					}
				}
				
				if(countryIds.get(country.getId())==null){
					resourceKey="security.message.invalidcountry";
				}
			}
			catch(HibernateException he){
				he.printStackTrace();
				resourceKey="generic.error.hibernate";
			}
			
		return resourceKey;
	}
	
	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,eventcreate,drivercreateevent"
	 *@return Asigned Primery Key
	 */
	public void createTravel(TravelDataType data, UserSessionData userSessionData) throws Exception{
		if (userSessionData == null) {
			throw new DeslogedException("createTravel","generic.error.deslogued");
		}
		if (data == null) {
			throw new InvalidDataException("createTravel","generic.event.eventdata.isempty");
		}
		try{
            Session session = HibernateUtil.currentSession();
            Travel travel = new Travel(data,session);
			session.save(travel);	
        } catch(Exception e){
        	Object[] p = new Object[1];
        	p[0] = data;
            handler.getException(e,"createTravel",userSessionData,p);
        }
	}

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,eventdelete"
     *@return Asigned Primery Key
     */
    public void deleteTravel(Integer travelId, UserSessionData userRequest) throws Exception{
        if (userRequest == null) {
            throw new DeslogedException("deleteTravel","generic.error.deslogued");
        }
        if (travelId == null) {
            throw new InvalidDataException("deleteTravel","generic.event.eventdata.isempty");
        }
        try{
            Session session = HibernateUtil.currentSession();
            Travel travel = (Travel)session.load(Travel.class, travelId);
            session.delete(travel);            
        } catch(Exception e){
        	Object[] p = new Object[1];
        	p[0] = travelId;
            handler.getException(e,"deleteTravel",userRequest,p);
        }
    }

	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,eventcreate,drivercreateevent"
	 *@return Asigned Primery Key
	 */
	public void udpateTravel(TravelDataType data, UserSessionData userSessionData) throws Exception{
		if (userSessionData == null) {
			throw new DeslogedException("createTravel","generic.error.deslogued");
		}
		if (data == null) {
			throw new InvalidDataException("createTravel","generic.event.eventdata.isempty");
		}
		try{
            Session session = HibernateUtil.currentSession();
            Travel travel = (Travel)session.load(Travel.class, data.getId());
            travel.setData(data,session);
			session.update(travel);	
        } catch(Exception e){
        	Object[] p = new Object[1];
        	p[0] = data;
            handler.getException(e,"udpateTravel",userSessionData,p);
        }
	}

	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,eventcreate,drivercreateevent"
	 *@return Asigned Primery Key
	 */
	public void udpateTravelConfirmation(TravelDataType data, UserSessionData userSessionData) throws Exception{
		if (userSessionData == null) {
			throw new DeslogedException("udpateTravelConfirmation","generic.error.deslogued");
		}
		if (data == null) {
			throw new InvalidDataException("udpateTravelConfirmation","generic.event.eventdata.isempty");
		}
		try{
            Session session = HibernateUtil.currentSession();
            Travel travel = (Travel)session.load(Travel.class, data.getId());
        	if(travel.getState() == TravelDataType.PENDING) {
        		data.setStatus(TravelDataType.STARTED);
        	}
            travel.setLeaveData(data);
			session.update(travel);	
        } catch(Exception e){
        	Object[] p = new Object[1];
        	p[0] = data;
            handler.getException(e,"udpateTravelConfirmation",userSessionData,p);
        }
	}
	
