			  	<tr>
					<td width="600" valign="top" colspan="3">
						<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("generic.driver.damageschema")%>' />
						<table width="100%" border="0" cellpadding="0" cellspacing="0">
							<tr >
								<td colspan="2" align="center" >
									<form name="vehicle" >
										<table width="100%" cellpadding="0" cellspacing="0">
											<tr>
												<td width="100%" valign="top" >
												<% // Si es forestal y tiene un vehiculo asigando
												// al evento que sea camion, cambio el dibujo:
												if (( userSessionData.isForest() &&
													vehicle != null && (
													vehicle.getType().getResourceBundleId().equals("datatype.vehicletype.truck")
													|| vehicle.getType().getResourceBundleId().equals("datatype.vehicletype.tractortrailer")
													|| vehicle.getType().getResourceBundleId().equals("datatype.vehicletype.trator")
													|| vehicle.getType().getResourceBundleId().equals("datatype.vehicletype.pickup")
													|| ( vehicle.getType().getResourceBundleId().equals("datatype.vehicletype.minivan") &&
															sys.getCorporationId() == CorporationData.CIMSA	)
													)) 
													||
													// Si es Forestal y creo un nuevo vehiculo asumo que es camion:
													( userSessionData.isForest() && 	(vehicle == null || vehicle.getType() == null ) )
													||
													// 	Si es CIMSA  y creo un nuevo vehiculo asumo que es camion (Ajuste: 17/08/2011)
													(sys.getCorporationId() == CorporationData.CIMSA)
													|| 
													// Si es PEPSICO  asumo que es camion (Ajuste: 17/08/2011)
													// Pepsico es camion solo (sin zorra)
													(sys.getCorporationId() == CorporationData.PEPSICO)
												){
													
														// Veo si tengo que mostrar un camion con zorra o solo el camion:
														
														String doubleCabinImage = ""; // camion con zorra
														String onlyTruckImage = ""; 
														String color = ""; // color del vehiculo
														if( (sys.getCorporationId() == CorporationData.CIMSA 
															&& eventDataType != null && eventDataType.isDoubleCabin()) ||
															// si es Forestal diferente de CIMSA es camion con zorra:
															(sys.getUserSessionData().isForest() &&  
															sys.getCorporationId() != CorporationData.CIMSA) ||
															// Si es diferente de CIMSA o PEPSICO, es camion con zorra:
															(sys.getCorporationId() != CorporationData.CIMSA &&
																	sys.getCorporationId() != CorporationData.PEPSICO)
																	
														){
															// Dibujo camion con zorra:
															doubleCabinImage = " style='display:block'  "; // camion con zorra
															onlyTruckImage = " style='display:none' ";
														}else{
															// Dibujo camion solo:
															doubleCabinImage = " style='display:none' ";
															onlyTruckImage = " style='display:block' "; // camion solo
														}	
													
												
%>
								<!-- Solo camion sin zorra:  -->
								<div id="onlyTruckImage"  <%=onlyTruckImage%> >
												<script type="text/javascript" language="javascript">
													if (navigator.appVersion.indexOf("MSIE")!= -1){
													// Internet Explorer
													document.write(
															'<table width="340px" border="0" cellpadding="0" cellspacing="0" background="/datacenter/util/imgs/camion_sin_zorra.jpg">' +
															'<tr>'+
																'<td id="1" align="left" valign="middle" height="20" width="100%">' +
																	'<input type="checkbox" name="damage1" <%=(eventDataType.isDamage(1)) ? "checked" : "" %>  disabled="true" />' +
																	'&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ' +
																	'<input type="checkbox" name="damage2" <%=(eventDataType.isDamage(2)) ? "checked" : "" %>  disabled="true" />' +
																	'&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;' +
																	'<input type="checkbox" name="damage3" <%=(eventDataType.isDamage(3)) ? "checked" : "" %>  disabled="true" />' +
																	'&nbsp;&nbsp;&nbsp; ' +
																	'<input type="checkbox" name="damage4" <%=(eventDataType.isDamage(4)) ? "checked" : "" %>  disabled="true" /> ' +
																	'&nbsp;&nbsp;&nbsp;' +
																	'<input type="checkbox" name="damage5" <%=(eventDataType.isDamage(5)) ? "checked" : "" %>  disabled="true" />'+
																	'&nbsp;&nbsp;&nbsp;' +
																	'<input type="checkbox" name="damage6" <%=(eventDataType.isDamage(6)) ? "checked" : "" %>  disabled="true" />' +
																	'&nbsp;&nbsp;&nbsp;' +
																	'<input type="checkbox" name="damage7" <%=(eventDataType.isDamage(7)) ? "checked" : "" %>  disabled="true" />' +
																	'&nbsp;&nbsp;&nbsp;' +
																	'<input type="checkbox" name="damage8" <%=(eventDataType.isDamage(8)) ? "checked" : "" %>  disabled="true" />' +
																'</td>' +
															'</tr>' +
															'<tr height="36">' +													
																'<td id="1" align="left" valign="middle" height="32">' +
																	'<input type="checkbox" name="damage17" <%=(eventDataType.isDamage(17)) ? "checked" : "" %>  disabled="true" />' +
																	'&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;'+
																	'<input type="checkbox" name="damage18" <%=(eventDataType.isDamage(18)) ? "checked" : "" %>  disabled="true" />' +
																	'&nbsp;&nbsp;&nbsp;'+
																	'<input type="checkbox" name="damage19" <%=(eventDataType.isDamage(19)) ? "checked" : "" %>  disabled="true" />' +
																	'&nbsp;&nbsp;' +
																	'<input type="checkbox" name="damage20" <%=(eventDataType.isDamage(20)) ? "checked" : "" %>  disabled="true" />' +
																	'&nbsp;' +
																	'<input type="checkbox" name="damage21" <%=(eventDataType.isDamage(21)) ? "checked" : "" %>  disabled="true" />' +
																	'&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;' +
																	'&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;' +
																	'&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;'+
 																	'<input type="checkbox" name="damage22" <%=(eventDataType.isDamage(22)) ? "checked" : "" %>  disabled="true" />' +
 																	'&nbsp;' +
 																	'<input type="checkbox" name="damage23" <%=(eventDataType.isDamage(23)) ? "checked" : "" %>  disabled="true" />' +
 																'</td>' +
															'</tr>' +
															'<tr>'+
																'<td id="1" align="left" valign="middle" height="20" width="100%">' +
																	'<input type="checkbox" name="damage27" <%=(eventDataType.isDamage(27)) ? "checked" : "" %>  disabled="true" />' +
																	'&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; ' +
																	'<input type="checkbox" name="damage28" <%=(eventDataType.isDamage(28)) ? "checked" : "" %>  disabled="true" />' +
																	'&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;' +
