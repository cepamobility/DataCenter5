<html:html>
<!-- EventView.jsp -->
<%!
	RequestDispatcher dispatcher; SystemAccess sys;	
	UserSessionData userSessionData; 
	Text messages; Integer driverId; String driverName; String driverLastName;
%>
<%

	try{
		
	
	EventForm form;
	sys = (SystemAccess)session.getAttribute("SystemAccess");
	if(sys == null){
		response.sendRedirect("/exception.jsp");
	}
	userSessionData = sys.getUserSessionData();
	int corporationId = userSessionData.getFilter().getCorporationId().intValue();
	String check = null;
	if(userSessionData.isDriver()) {
	    check = Util.checkPermission(sys,SecurityConstants.DRIVER_EVENT_EDIT);
	}else {
	    check = Util.checkPermission(sys,SecurityConstants.EDIT_EVENT);
	}
	if(check!=null) {
		response.sendRedirect(request.getContextPath()+check);
	}else {
		Integer eventId = null;
		if(Util.empty(request.getParameter("eventId"))) {
			eventId = (Integer)session.getAttribute("eventId");
		}else {
			eventId = new Integer(request.getParameter("eventId"));
		}
		session.setAttribute("url","event/EventView.jsp?eventId="+eventId.toString());
		EventDataType eventDataType = sys.getEventReportFacade().findEventByPrimaryKey(eventId,userSessionData);
		 
		if(eventDataType != null) {
			
			 
			form = new EventForm(eventDataType,userSessionData);
			session.setAttribute("EventForm",form);
		    DriverData driver = null;
		    driverId = new Integer(form.getDriverid());
			if(userSessionData.isDriver()) {
			    driver = userSessionData.getDriverData();
			}else {
			    driver = sys.getDriverReportFacade().findDriverByPrimaryKey(driverId,userSessionData);
			}
		
			dispatcher=request.getRequestDispatcher("/util/jsp/message.jsp");
			dispatcher.include(request,response);
			
			messages=sys.getText();
			session.setAttribute("target","EventSelectDriverList");
			VehicleData vehicle = null;

			if(session.getAttribute("Breadcrumb") != null) {
			    Hashtable parameters = new Hashtable();
			    parameters.put("id",eventDataType.getId());
			    parameters.put("name",driver.getLastName()+" "+Util.formatDate(eventDataType.getDate()));
			    ((Breadcrumb)session.getAttribute("Breadcrumb")).addItem(Breadcrumb.EVENT_EDIT,parameters);
			}
%>

<script type="text/javascript" src="./menu/js/html2canvas.min.js"></script>


<script language="JavaScript" type="text/javascript">
	function CanvasToBase64Image(canvas)
	{
		var ctx = canvas.getContext("2d");
		var dataURL = canvas.toDataURL("image/png");
		var r = dataURL;//.replace(/^data:image\/(png|jpg);base64,/, "");
		return r;
	}
	
	$(document).ready(
		function(){
			$("#linkpdfscreen").click(function(event ) {
				    event.preventDefault();
				    var sel=$("table#bevent");
				  var count = sel.length;
				  for(i=0; i<count;i++){
	  			  		html2canvas(sel[i], {
			            onrendered: function(canvas) {
			                //document.body.appendChild(canvas);
			                 fd = new FormData();
							 xhr = new XMLHttpRequest();
							 fd.append('contents', CanvasToBase64Image(canvas));
							 fd.append('id', 0);
							 xhr.open('POST', 'Copy.do',false);
							 xhr.send(fd);

							 document.location.href="ImageToPDF.do";	
				        }
			        });
				  }
				  
				 	
			  			  
				 		
			});
		}
	);

	function confirmDelete(form,msg){
		if(confirm(msg)){
			form.submit();
		}
	}
</script>
