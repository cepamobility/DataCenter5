	  			</tr>
<%
		String type = "";
		String clasification = "";
		if(sys.isCorporation(new int[]{CorporationData.MONSANTO,CorporationData.WEYERHAEUSER})) {
			if(eventDataType.getAccident() != null) {
				type = messages.getText("generic.event.accident");
				clasification = messages.getText(eventDataType.getAccident().getResourceBundleId());
			}else if(eventDataType.getIncident() != null) {
				type = messages.getText("generic.event.incident");
				clasification = messages.getText(eventDataType.getIncident().getResourceBundleId());
			}else if(eventDataType.getNearmiss() != null) {
				type = messages.getText("generic.event.nearmiss");
				clasification = messages.getText(eventDataType.getNearmiss().getResourceBundleId());
			}
		}else {
			type = (eventDataType.getAccident() != null ) ? messages.getText("generic.event.accident") :(eventDataType.getIncident()!=null)? messages.getText("generic.event.incident"):messages.getText("generic.event.nearmiss");
			clasification = (eventDataType.getAccident() != null) ? messages.getText(eventDataType.getAccident().getResourceBundleId()) :(eventDataType.getIncident() != null) ? messages.getText(eventDataType.getIncident().getResourceBundleId()):messages.getText(eventDataType.getNearmiss().getResourceBundleId());	
			if(corporationId == CorporationData.DPA) {
				if(eventDataType.getCollision().getResourceBundleId().equals("datatype.collisionclasification.incident")) {
					type = messages.getText("generic.event.incident");
				}else {
					type = messages.getText("generic.event.accident");
				}
			}
		}
		Calendar cal=Calendar.getInstance();
		cal.setTime(eventDataType.getDate());
		int year= cal.get(Calendar.DATE);
