							</tr>
<%			}
			if(observations.size() > 0) {
				Iterator itObservations = observations.iterator();
	    		boolean lineone = false;
		    	while(itObservations.hasNext()) {
    			    ObservationData observation = (ObservationData)itObservations.next();
%>							<tr align=center align="right" class='<%=(lineone) ? "lineone" : "linetwo"%>'>
	          					<td width='24%' align="right">
	              					<%=Util.formatDate(observation.getDate())%>
              					</td>
<%					switch(observation.getAction().intValue()) {
						case LogActions.CREATE:
%>						     	<td width='24%' align="right"><%=messages.getText("generic.log.create")%> </td>
<%							break;
						case LogActions.UPDATE:
%>						        <td width='24%' align="right"><%=messages.getText("generic.log.update")%> </td>
<%							break;
						case LogActions.DELETE:
%>						        <td width='24%' align="right"><%=messages.getText("generic.log.delete")%> </td>
<%							break;
					}
%>						        <td width='24%' align="right"><%=observation.getUser()%> </td>						                
						        <td width='24%' align="right"><%=(observation.getComment()==null)?"----":observation.getComment()%> </td>						                
							</tr>
<%    				lineone = !lineone;
				}
			}
%>						</table>
						<jsp:include page="../component/utilityboxbottom.jsp"/>	
					</td>
			   	</tr>
  				<tr>
					<jsp:include  page="../component/spaceline.jsp" />
			  	</tr>
<%			if(!Util.empty(eventDataType.getRecomendation())) { %>
				<tr>
					<td width="600" colspan="3">
						<%
							String pageA1 = "../component/utilityboxtop.jsp?title=" + messages.getText("generic.event.recomendation");
						%>
						<jsp:include  page='<%=pageA1 %>' />
						<table width="100%" cellpadding="0" cellspacing="0">
							<tr>
								<td width="85%" align="justify" colspan="3" class="simpleblue">
									<%=Util.formatHTML(eventDataType.getRecomendation())%>
								</td>
							</tr>
						</table>
						<jsp:include  page="../component/utilityboxbottom.jsp" />
					</td>
				</tr>
	  			<tr>
					<jsp:include  page="../component/spaceline.jsp" />
	  			</tr>
<%			}
%>	  			
				<tr>			  		
			  		<jsp:include page='EventViewOptions.jsp?eventId=<%=eventId%>' />
			  	</tr>
			  	<tr>
					<jsp:include  page='<%="../component/spaceline.jsp?colspan=3" %>'/>
			  	</tr>
			</table>
		</body>
<%		}else {
%>			<jsp:include  page='<%="/util/allowedData.jsp?message=event.error.access.event" %>'/>
<%		}
	}
	
	}catch(Exception e){
		e.printStackTrace();
	}
%>		
</html:html>
