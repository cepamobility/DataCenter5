package communication.administration.corporation;

public class CalculateImpactData  {
    
	private CalculateRetroactiveImpactData retroactiveImpactNew;
	private CalculateRetroactiveImpactData retroactiveImpactOld;
	
	public CalculateRetroactiveImpactData getRetroactiveImpactNew() {
		return retroactiveImpactNew;
	}
	public void setRetroactiveImpactNew(
			CalculateRetroactiveImpactData retroactiveImpactNew) {
		this.retroactiveImpactNew = retroactiveImpactNew;
	}
	public CalculateRetroactiveImpactData getRetroactiveImpactOld() {
		return retroactiveImpactOld;
	}
	public void setRetroactiveImpactOld(
			CalculateRetroactiveImpactData retroactiveImpactOld) {
		this.retroactiveImpactOld = retroactiveImpactOld;
	}
	
	
  
}
