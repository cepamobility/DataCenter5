package communication.external.instructors;

import java.util.ArrayList;

import org.codehaus.jackson.annotate.JsonIgnoreProperties;

@JsonIgnoreProperties(ignoreUnknown = true)
public class ActivityRestData {
	
	private Integer id;
	
	private String name;
	private Integer checklist;
	private Integer version;
	private Integer corporationId;
	private String countryName;
	private String divOrg1Name;
	private String divOrg2Name;
	private String divOrg3Name;
	private String date;
	
	
	
	private ArrayList<ChecklistObservationData> observations=new ArrayList<ChecklistObservationData>();
	
	private ArrayList<DriverRestData> participants=new ArrayList<DriverRestData>();

	
	
	public String getDate() {
		return date;
	}

	public void setDate(String date) {
		this.date = date;
	}

	public ArrayList<ChecklistObservationData> getObservations() {
		return observations;
	}

	public void setObservations(ArrayList<ChecklistObservationData> observations) {
		this.observations = observations;
	}

	public String getCountryName() {
		return countryName;
	}

	public void setCountryName(String countryName) {
		this.countryName = countryName;
	}

	public String getDivOrg1Name() {
		return divOrg1Name;
	}

	public void setDivOrg1Name(String divOrg1Name) {
		this.divOrg1Name = divOrg1Name;
	}

	public String getDivOrg2Name() {
		return divOrg2Name;
	}

	public void setDivOrg2Name(String divOrg2Name) {
		this.divOrg2Name = divOrg2Name;
	}

	public String getDivOrg3Name() {
		return divOrg3Name;
	}

	public void setDivOrg3Name(String divOrg3Name) {
		this.divOrg3Name = divOrg3Name;
	}

	public Integer getCorporationId() {
		return corporationId;
	}

	public void setCorporationId(Integer corporationId) {
		this.corporationId = corporationId;
	}

	public Integer getId() {
		return id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public String getName() {
		return name;
	}

	public void setName(String name) {
		this.name = name;
	}

	public Integer getChecklist() {
		return checklist;
	}

	public void setChecklist(Integer checklist) {
		this.checklist = checklist;
	}

	public Integer getVersion() {
		return version;
	}

	public void setVersion(Integer version) {
		this.version = version;
	}

	public ArrayList<DriverRestData> getParticipants() {
		return participants;
	}

	public void setParticipants(ArrayList<DriverRestData> participants) {
		this.participants = participants;
	}
	
	
	
}
