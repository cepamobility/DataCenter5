    public static Hashtable[] getDivOrgMap(Collection lines, int divOrgCount) {
        Hashtable[] elements = new Hashtable[9]; 
        Iterator it = lines.iterator();
        while(it.hasNext()) {
            GroupLineData groupLine = (GroupLineData)it.next();
            GeoLabelData lid = groupLine.getCountry();
            GeoItemData country = (GeoItemData)((GeoItemData)lid.getItemIterator().next()).getSubItems().getItemIterator().next();
            for(int i = 0; i < divOrgCount; i++) {
                LabelItemData lid1 = groupLine.getDivOrgs()[i];
                ItemData item1 = (ItemData)lid1.getItemIterator().next();
                ElementData element = new ElementData(item1.getId(),item1.getName());
                if(elements[i*3] == null) {
                    elements[i*3] = new Hashtable();
                }
                if(elements[i*3].containsKey(country.getId())) {
                    Collection divorgs = (Collection)elements[i*3].get(country.getId());
                    if(!contains(divorgs,element)) {
                        divorgs.add(element);
                    }
                }else {
                    Collection divorgs = new LinkedList();
                    divorgs.add(element);
                    elements[i*3].put(country.getId(),divorgs);
                }
                LabelItemData lid2 = item1.getSubItems();
                if(lid2 != null) {
                    ItemData item2 = (ItemData)lid2.getItemIterator().next();
                    element = new ElementData(item2.getId(),item2.getName());
                    if(elements[i*3+1] == null) {
                        elements[i*3+1] = new Hashtable();
                    }
                    if(elements[i*3+1].containsKey(item1.getId())) {
                        Collection divorgs = (Collection)elements[i*3+1].get(item1.getId());
                        if(!contains(divorgs,element)) {
                            divorgs.add(element);
                        }
                    }else {
                        Collection divorgs = new LinkedList();
                        divorgs.add(element);
                        elements[i*3+1].put(item1.getId(),divorgs);
                    }
                    LabelItemData lid3 = item2.getSubItems();
                    if(lid3 != null) {
                        ItemData item3 = (ItemData)lid3.getItemIterator().next();
                        element = new ElementData(item3.getId(),item3.getName());
                        if(elements[i*3+2] == null) {
                            elements[i*3+2] = new Hashtable();
                        }
                        if(elements[i*3+2].containsKey(item2.getId())) {
                            Collection divorgs = (Collection)elements[i*3+2].get(item2.getId());
                            if(!contains(divorgs,element)) {
                                divorgs.add(element);
                            }
                        }else {
                            Collection divorgs = new LinkedList();
                            divorgs.add(element);
                            elements[i*3+2].put(item2.getId(),divorgs);
                        }
                    }
                }
            }
        }
        return elements;
    }

    private static boolean contains(Collection elements, ElementData element) {
        Iterator it = elements.iterator();
        while(it.hasNext()) {
            if(((ElementData)it.next()).getId().equals(element.getId())) {
                return true;
            }
        }
        return false;
    }

