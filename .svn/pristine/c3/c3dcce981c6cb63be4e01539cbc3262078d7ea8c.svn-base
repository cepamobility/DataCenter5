package communication.report;

//

import java.io.Serializable;

/**
 * @author fcarriquiry
 */
public class JJCrashNonRecordableData implements Serializable {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;
	
	private Integer id;

	private String linelabel;
	
	private Integer count;

	private Integer countNonRecordable;
	 
	public JJCrashNonRecordableData() {
		
	}

	

	public Integer getCountNonRecordable() {
		return countNonRecordable;
	}



	public void setCountNonRecordable(Integer countNonRecordable) {
		this.countNonRecordable = countNonRecordable;
	}



	public Integer getId() {
		return id;
	}


	public void setId(Integer id) {
		this.id = id;
	}


	public String getLinelabel() {
		return linelabel;
	}


	public void setLinelabel(String linelabel) {
		this.linelabel = linelabel;
	}


	public Integer getCount() {
		return count;
	}


	public void setCount(Integer count) {
		this.count = count;
	}



	 
	 

	 
     

	 
}
