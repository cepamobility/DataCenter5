package presentation.translator.web.user;

import org.apache.struts.action.ActionForm;

import communication.administration.user.tables.UserAttributes;

/**
 * @author fcarriquiry
 * 
 * TODO To change the template for this generated type comment go to Window -
 * Preferences - Java - Code Style - Code Templates
 */
public class UserAddCorporationForm extends ActionForm {

    private static final long serialVersionUID = 1L;

    private String corporationId;
    private String loginname;
    private String firstname;
    private String newrole;
    private String rolelist;
    //private String oldrole;
    
	public UserAddCorporationForm() {	    
	}
	
	public UserAddCorporationForm (String loginname, String role) {
		newrole = role;
	}

	
	public String getCorporationId() {
		return corporationId;
	}

	public void setCorporationId(String corporationId) {
		this.corporationId = corporationId;
	}
	
	public String getLoginname() {
		return loginname;
	}

	public void setLoginname(String loginname) {
		this.loginname = loginname;
	}

	public String getFirstname() {
		return firstname;
	}

	public void setFirstname(String firstname) {
		this.firstname = firstname;
	}

	public String getNewrole() {
		return newrole;
	}

	public void setNewrole(String newrole) {
		this.newrole = newrole;
	}

	public String getRolelist() {
		return rolelist;
	}

	public void setRolelist(String rolelist) {
		this.rolelist = rolelist;
	}
 
}