<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">


<hibernate-mapping package="persistence.vehicle.tables">
	<class name="Unconformity" table="unconformities">
		
       <composite-id class="UnconformityPK" name="pk" >
       		<key-many-to-one
       			 name="vehicle"
       			 column="id"
       			 class="Vehicle"
       	 	/>
	        <key-property 	name="date"	type="java.util.Date"	column="date" />
       </composite-id>
		
        <property column="origin" name="origin" type="java.lang.String" />
        <property column="department" name="department" type="java.lang.String" />
        <property column="charge" name="charge" type="java.lang.Integer" />
        <property column="observations" name="observations" type="text" />
        <property column="contractor" name="contractor" type="java.lang.Integer" />
		
  	</class>
</hibernate-mapping>
