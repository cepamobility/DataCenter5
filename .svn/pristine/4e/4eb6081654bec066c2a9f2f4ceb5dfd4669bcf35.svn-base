package persistence.administration.corporation.tables;

import java.io.Serializable;

public class CorporationMenuExceptionPK implements Serializable {

    /**
	 * 
	 */
	private static final long serialVersionUID = 1L;
	private Integer corporation;
	private String role;
	private MenuOption menuOption;
    

    public CorporationMenuExceptionPK() {
    }

    public CorporationMenuExceptionPK(Integer corporation, String role, MenuOption menu) {
        this.corporation = corporation;
        this.menuOption = menu;
        this.role = role;
    }

    public Integer getCorporation() {
        return corporation;
    }

    public MenuOption getMenuOption() {
        return menuOption;
    }

    public void setCorporation(Integer corporation) {
        this.corporation = corporation;
    }

    public void setMenuOption(MenuOption menu) {
        this.menuOption = menu;
    }

	public String getRole() {
		return role;
	}

	public void setRole(String role) {
		this.role = role;
	}
}
