package persistence.datatype.tables;

import java.io.Serializable;

import communication.datatype.tables.GeneralDTData;

public class CEPAActivityNote  extends GeneralDataType implements Serializable {

	/**
	 * 
	 */
	private static final long serialVersionUID = 1L;

	public CEPAActivityNote(String resourcebundleid) {
		super(resourcebundleid);
	}

   public GeneralDTData getData(){
	   return new GeneralDTData(getResourceBundleId());
   }
}
