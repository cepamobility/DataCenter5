package communication.activity.tables;

public class ActivityAttendanceData {
	
	private Integer attendanceId;
	
	private Integer activity;
	private Integer divOrgItemId;
	private String firstName;
	private String lastName;
	private String ci;
	private String birthDate;
	private String sex;
	private String phone;
	private String email;
	private String city;
	private String signature;
	
	private boolean linked;
	private boolean proccessed;
	
	public ActivityAttendanceData() {
	}

	
	public ActivityAttendanceData(Integer attendanceId, Integer activity,
			Integer divOrgItemId, String firstName, String lastName, String ci,
			String birthDate, String sex, String phone, String email,
			String city, String signature, boolean linked, boolean proccessed) {
		this.attendanceId = attendanceId;
		this.activity = activity;
		this.divOrgItemId = divOrgItemId;
		this.firstName = firstName;
		this.lastName = lastName;
		this.ci = ci;
		this.birthDate = birthDate;
		this.sex = sex;
		this.phone = phone;
		this.email = email;
		this.city = city;
		this.signature = signature;
		this.linked = linked;
		this.proccessed = proccessed;
	}


	public Integer getAttendanceId() {
		return attendanceId;
	}

	public void setAttendanceId(Integer attendanceId) {
		this.attendanceId = attendanceId;
	}

	public Integer getActivity() {
		return activity;
	}

	public void setActivity(Integer activity) {
		this.activity = activity;
	}

	public Integer getDivOrgItemId() {
		return divOrgItemId;
	}

	public void setDivOrgItemId(Integer divOrgItemId) {
		this.divOrgItemId = divOrgItemId;
	}

	public String getFirstName() {
		return firstName;
	}

	public void setFirstName(String firstName) {
		this.firstName = firstName;
	}

	public String getLastName() {
		return lastName;
	}

	public void setLastName(String lastName) {
		this.lastName = lastName;
	}

	public String getCi() {
		return ci;
	}

	public void setCi(String ci) {
		this.ci = ci;
	}

	public String getBirthDate() {
		return birthDate;
	}

	public void setBirthDate(String birthDate) {
		this.birthDate = birthDate;
	}

	public String getSex() {
		return sex;
	}

	public void setSex(String sex) {
		this.sex = sex;
	}

	public String getPhone() {
		return phone;
	}

	public void setPhone(String phone) {
		this.phone = phone;
	}

	public String getEmail() {
		return email;
	}

	public void setEmail(String email) {
		this.email = email;
	}

	public String getCity() {
		return city;
	}

	public void setCity(String city) {
		this.city = city;
	}

	public boolean isLinked() {
		return linked;
	}

	public void setLinked(boolean linked) {
		this.linked = linked;
	}

	public boolean isProccessed() {
		return proccessed;
	}

	public void setProccessed(boolean proccessed) {
		this.proccessed = proccessed;
	}

	public String getSignature() {
		return signature;
	}

	public void setSignature(String signature) {
		this.signature = signature;
	}
	
	
}
