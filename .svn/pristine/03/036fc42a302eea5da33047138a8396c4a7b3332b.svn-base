<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.vehicle.tables" >
    <class name="VehiclePursuitRoute" table="vehiclepursuitroute">
		
		 <id
            column="pursuitRouteId"
            name="pursuitRouteId"
        >
            <generator class="sequence">
            	<param name="sequence">PursuitRoute_Sequence</param>
            </generator>
        </id>
        <property	name="date" type="java.util.Date" column="date"/>         
        <property	name="evaluationHour" type="java.util.Date" column="evaluationHour"/>                      
        <property	name="divorg1" type="java.lang.String" column="name"/>        
        <property	name="obs" type="java.lang.String" column="obs"/>
        <property	name="instructor" type="java.lang.String" column="instructor"/>
        <property	name="area" type="java.lang.String" column="area"/>
        
        <many-to-one name="vehicle" class="persistence.vehicle.tables.Vehicle" not-null="true" >
             <column name="vehicle"></column>
        </many-to-one>
        
        <set name="itemValueSet" table="vehiclepursuitrouteitemsvalues" cascade="all">
       		<key column="vehiclepursuitroute"></key>
       		<composite-element class="persistence.activity.tables.ItemValueStr">
       			<property name="itemValue" type="java.lang.String">
       				<column  name="itemValue" default="0"></column>
       			</property>
       			<many-to-one class="persistence.activity.tables.Item" name="item" fetch="join" />       		
       		</composite-element>
        </set>                

	 </class>

</hibernate-mapping>