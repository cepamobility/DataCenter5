	 public static String activityName(String activity) {
		 String a = activity.replace("(versión Tablets)","");
		 a = a.replace("(versão Tablets)","");
		 a = a.replace("(version Tablets)","");
		 return a;
	 }

	 public static double processMoves(Collection<PointMoveData> moves, int corporation) {
		 double total = 0;
		 Collections.sort((List)moves);
		 Iterator<PointMoveData> itMoves = moves.iterator();
		 while(itMoves.hasNext()) {
			PointMoveData move = itMoves.next();
			total +=  move.getAmount().doubleValue();
			if(total < 0)
				total = 0;
		 }
		 return total;
	 }
}
