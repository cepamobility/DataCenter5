    /**
     * Return dd-mm-yyyy
     * @param date
     * @return
     */
    public static String formatDate(Date date) {
        if(date == null) {
            return "";
        }
        Calendar calendar = Calendar.getInstance();
        calendar.setTime(date);
        return calendar.get(Calendar.DAY_OF_MONTH)+"-"+(calendar.get(Calendar.MONTH)+1)+"-"+calendar.get(Calendar.YEAR);
    }
    
    /**
     * Return dd-mm-yyyy
     * @param date
     * @return
     */
    public static String formatDateEN(Date date) {
        if(date == null) {
            return "";
        }
        Calendar calendar = Calendar.getInstance();
        calendar.setTime(date);
        return (calendar.get(Calendar.MONTH)+1)+"/"+calendar.get(Calendar.DAY_OF_MONTH)+"/"+calendar.get(Calendar.YEAR);
    }
  
    
    /**
     * Return yyyy-mm-dd
     * @param date
     * @return
     */
    public static String formatDateYYYYMMDD(Date date) {
        if(date == null) {
            return "";
        }
        Calendar calendar = Calendar.getInstance();
        calendar.setTime(date);
            
       	String month = (calendar.get(Calendar.MONTH)+1 < 10) ? 
        			"0"+ String.valueOf(calendar.get(Calendar.MONTH)+1):
        				String.valueOf(calendar.get(Calendar.MONTH)+1);
        			
        String day = (calendar.get(Calendar.DAY_OF_MONTH)+1 < 10) ? 
    			"0"+ String.valueOf(calendar.get(Calendar.DAY_OF_MONTH)+1):
    				String.valueOf(calendar.get(Calendar.DAY_OF_MONTH)+1);
    			
        return calendar.get(Calendar.YEAR)+"-"+month+"-"+day;
    }


    public static String formatHour(Time time) {
        if(time == null) {
            return "";
        }
        Calendar calendar = Calendar.getInstance();
        calendar.setTime(time);
        String minute = (calendar.get(Calendar.MINUTE) < 10) ? "0"+String.valueOf(calendar.get(Calendar.MINUTE)) : String.valueOf(calendar.get(Calendar.MINUTE)); 
        return String.valueOf(calendar.get(Calendar.HOUR_OF_DAY))+":"+minute;
    }
    
    public static ArrayList<ArrayList<String>> xlsInputStreamToArray(InputStream input) throws IOException{
    	HSSFWorkbook workbook = new HSSFWorkbook(input);
		HSSFSheet sheet = workbook.getSheetAt(0);
		ArrayList<ArrayList<String>> book=new ArrayList<ArrayList<String>>(); 
		Iterator<HSSFRow> rowIterator = sheet.rowIterator();
		while(rowIterator.hasNext()){
			HSSFRow rowXLS=rowIterator.next();
			Iterator<HSSFCell> cellIter = rowXLS.cellIterator();
			ArrayList<String> row=new ArrayList<String>();
			while(cellIter.hasNext()){
				HSSFCell cel=cellIter.next();
				row.add(cel.toString());
			}
			book.add(row);
		}
		
		return book;
    }
    
    public static ArrayList<ArrayList<String>> completeRows(ArrayList<ArrayList<String>> book) throws IOException{
    	int count=0;
    	for(ArrayList<String> row:book){
    		if(row.size()>count){
    			count=row.size();
    		}
    	}
    	for(ArrayList<String> row:book){
    		 for(int c=row.size();c<count;c++){
    			 row.add("");
    		 }
    	}
		return book;
    }

    public static String formatHour(Date time) {
        if(time == null) {
            return "";
        }
        Calendar calendar = Calendar.getInstance();
        calendar.setTime(time);
        String minute = (calendar.get(Calendar.MINUTE) < 10) ? "0"+String.valueOf(calendar.get(Calendar.MINUTE)) : String.valueOf(calendar.get(Calendar.MINUTE)); 
        return String.valueOf(calendar.get(Calendar.HOUR_OF_DAY))+":"+minute;
    }

    public static String formatHour(Integer duration) {
        if(duration == null || duration == 0) {
            return "---";
        }
        int hour = duration / 60;
        int min = duration % 60;
        String minute = (min < 10) ? "0"+String.valueOf(min) : String.valueOf(min); 
        return String.valueOf(hour)+":"+minute;
    }

    /**
     * 
     * @param date
     * @param month
     * @param year
     * @return
     */
    public static Date getDate(String date, String month, String year) {
        try {
            Calendar calendar = Calendar.getInstance();
            calendar.set(Calendar.DAY_OF_MONTH,Integer.parseInt(date));
            calendar.set(Calendar.MONTH,Integer.parseInt(month)-1);
            calendar.set(Calendar.YEAR,Integer.parseInt(year));
            
            calendar.set(Calendar.HOUR,0);
            calendar.set(Calendar.MINUTE,0);
            calendar.set(Calendar.SECOND,0);
            calendar.set(Calendar.MILLISECOND,0);
            
            return calendar.getTime();
        } catch (NumberFormatException e) {
            return null;
        }
    }
    
    public static Date getDate(String date, String month, String year, Integer hour, Integer minute) {
        try {
            Calendar calendar = Calendar.getInstance();
            calendar.set(Calendar.DATE,Integer.parseInt(date));
            calendar.set(Calendar.MONTH,Integer.parseInt(month)-1);
            calendar.set(Calendar.YEAR,Integer.parseInt(year));
            
            calendar.set(Calendar.HOUR_OF_DAY,hour);
            calendar.set(Calendar.MINUTE,minute);
            calendar.set(Calendar.SECOND,0);
            calendar.set(Calendar.MILLISECOND,0);
            
            return calendar.getTime();
        } catch (NumberFormatException e) {
            return null;
        }
    }
    
    public static Calendar getCalendar(Date slqdate) {
        try {
