    public static String checkPermission(SystemAccess systemAccess,String label) {
    	if(systemAccess==null){
			return "/home.jsp";
		}
		if(!systemAccess.getUserSessionData().checkPermission(label)){
			return "/error.jsp";
		}
    	return null;
    }
    
