	public static String borrarForestales(String contractor) {
		contractor = contractor.replaceAll("(FOSA)", "");
		contractor = contractor.replaceAll("(MDP)", "");
		contractor = contractor.replaceAll("(WY)", "");
		contractor = contractor.replaceAll("(FOSA,WY)", "");
		contractor = contractor.replaceAll("(FOSA,MDP)", "");
		contractor = contractor.replaceAll("(FOSA,WY,MDP)", "");
		return contractor;
	}

	public static String formatCorporationId(DriverData driver) {
		String corporationId = driver.getCorporationId();
		if(driver.getCorporation().getId().intValue() == CorporationData.FORESTALES
				|| driver.getCorporation().getId().intValue() == CorporationData.FORESTALORIENTAL
				|| driver.getCorporation().getId().intValue() == CorporationData.MONTES_DE_PLATA
				|| driver.getCorporation().getId().intValue() == CorporationData.WEYERHAEUSER) {
			switch(corporationId.length()) {
				case 7:
					corporationId = corporationId.substring(0, 3) + "." + corporationId.substring(3, 6) + "-" + corporationId.substring(6);
					break;
				case 8:
					corporationId = corporationId.substring(0, 1) + "." + corporationId.substring(1, 4) + "." + corporationId.substring(4,7) + "-" + corporationId.substring(7);
					break;
			}
		}
		return corporationId;
	}

	public static boolean afterOrEqual(Integer fromMonth, Integer fromYear, Integer toMonth, Integer toYear) {
		if(fromMonth.intValue() == toMonth.intValue() && fromYear.intValue() == toYear.intValue())
			return true;
		Calendar c1 = getCalendar(fromMonth, fromYear);
		Calendar c2 = getCalendar(toMonth, toYear);
		return c2.after(c1);
	}

	private static Calendar getCalendar(Integer month, Integer year) {
		Calendar c1 = Calendar.getInstance();
		c1.set(Calendar.MONTH, month-1);
		c1.set(Calendar.YEAR, year);
		return c1;
	}

	public static Calendar getCalendar(String day, String month, String year) {
        try {
            Calendar calendar = Calendar.getInstance();
            calendar.set(Calendar.DAY_OF_MONTH,Integer.parseInt(day));
            calendar.set(Calendar.MONTH,Integer.parseInt(month)-1);
            calendar.set(Calendar.YEAR,Integer.parseInt(year));
            return calendar;
        } catch (NumberFormatException e) {
            return null;
        }
	}

	public static Integer toKms(Integer miles) {
		double m = miles.doubleValue();
		double k = m * KMS_TO_MILES;
		String kms = String.valueOf(Math.round(k));
		return new Integer(kms);
	}

	
	 public static byte[] toByteArray(InputStream is) throws IOException{
	    	ByteArrayOutputStream buffer = new ByteArrayOutputStream();

	    	int nRead;
	    	byte[] data = new byte[16384];

	    	while ((nRead = is.read(data, 0, data.length)) != -1) {
	    	  buffer.write(data, 0, nRead);
	    	}

	    	buffer.flush();

	    	return buffer.toByteArray();
	    }
	 
	 public static void fileToOutputStream(File file, OutputStream out) throws IOException{
	    	out.write(toByteArray(new FileInputStream(file)));
	    	out.flush();
	    	out.close();
	    }


	public static Integer toMiles(Integer kms) {
		double k = kms.doubleValue();
		double m = k / KMS_TO_MILES;
		String miles = String.valueOf(Math.round(m));
		return new Integer(miles);
	}
	
