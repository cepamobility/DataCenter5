	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,query"
	 */
	public Object[][] getUncoformities(Integer fromMonth, Integer fromYear,
			Integer toMonth, Integer toYear, Integer status,
			Integer[][] divOrgs, Integer[] divGeos,
			UserSessionData userSessionData) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "getUnconformities",
				getClass());
		try {
			Session session = HibernateUtil.currentSession();
			String sql = "SELECT d.id,d.firstname,d.lastname,du.date,ut.resourcebundleid,du.observations FROM driverunconformities du "
					+ "JOIN unconformitytypes ut ON du.type = ut.id "
					+ "JOIN drivers d ON du.driver = d.id ";

			sql += UtilityQuery.corporationDivisionsRestictionsSQL("d",
					userSessionData);

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						sql += " AND d.divorg" + String.valueOf(j + 1)
								+ " IN (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							sql += String.valueOf(it.next());
							sql += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
					}
				}
			}

			if (divGeos != null) {
				if (divGeos.length > 0) {
					sql += "AND d.country IN (";
					for (int i = 0; i < divGeos.length; i++) {
						sql += divGeos[i];
						sql += (i == divGeos.length - 1) ? ") " : ",";
					}
				}
			}

			if (fromMonth != null && fromYear != null) {
				sql += " AND date >= '"
						+ Util.getDate(String.valueOf(fromYear), String
								.valueOf(fromMonth), 0) + "' ";
			}
			if (toMonth != null && toYear != null) {
				sql += " AND date <= '"
						+ Util.getDate(String.valueOf(toYear), String
								.valueOf(toMonth), 1) + "' ";
			}
			switch (status) {
			case DriverData.ACTIVE:
				sql += "AND d.exclusionDate IS NULL ";
				break;
			case DriverData.EXCLUDED:
				sql += "AND d.exclusionDate IS NOT NULL ";
				break;
			}
			sql += "ORDER BY firstname,lastname,date";
			Query q = session.createSQLQuery(sql).addScalar("id",
					Hibernate.INTEGER).addScalar("firstname", Hibernate.STRING)
					.addScalar("lastname", Hibernate.STRING).addScalar("date",
							Hibernate.DATE).addScalar("resourcebundleid",
							Hibernate.STRING).addScalar("observations",
							Hibernate.STRING);
			List list = q.list();
			Object[][] data = new Object[list.size()][6];
			Iterator it = list.iterator();
			int i = 0;
			while (it.hasNext()) {
				data[i] = (Object[]) it.next();
				i++;
			}
			return data;
		} catch (Exception e) {
			Object[] p = { fromMonth, fromYear, toMonth, toYear, status,
					divOrgs, divGeos };
			handler.getException(e, "getUnconformities", userSessionData, p);
		}
		MemoryLog.getInstance().log(MemoryLog.END, "getUnconformities",
				getClass());
		return new Object[0][0];
	}

	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,query"
	 */
	public Hashtable getDriverPoints(UserSessionData userSessionData)
			throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "getDriverPoints",
				getClass());
		Hashtable hash = new Hashtable();
		try {
			Session session = HibernateUtil.currentSession();
			String sql = "select driver, d.points, sum(points) as p from genericevents ge, drivers d where ge.driver = d.id and corporation = "
					+ String.valueOf(userSessionData.getFilter()
							.getCorporationId()) + " group by driver";

			Query q = session.createSQLQuery(sql).addScalar("driver",
					Hibernate.INTEGER).addScalar("points", Hibernate.INTEGER)
					.addScalar("p", Hibernate.INTEGER);
			List list = q.list();
			if (list != null) {
				Iterator it = list.iterator();
				while (it.hasNext()) {
					Object[] data = (Object[]) it.next();
					hash.put(data[0], (Integer) data[1] - (Integer) data[2]);
				}
			}
		} catch (Exception e) {
			Object[] p = {};
			handler.getException(e, "getDriverPoints", userSessionData, p);
		}
		MemoryLog.getInstance().log(MemoryLog.END, "getDriverPoints",
				getClass());
		return hash;
	}

