	/**
	 * Obtiene la entidad csv que tiene la informacion vinculada a la
	 * actualizacion masiva de conductores o vehiculos.
	 *
	 * @ejb.permission role-name =
	 *                 "administrator,driverupdatebatch,vehicleupdatebatch"
	 * @ejb.interface-method
	 */
	public CsvEntityData findCsvEntityByPrimaryKey(Integer idCsv,
			UserSessionData userRequest) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START,
				"findCsvEntityByPrimaryKey", getClass());

		if (idCsv == null) {
			throw new InvalidDataException("findCsvEntityByPrimaryKey",
					"idCsv = null");
		}
		if (userRequest == null) {
			throw new DeslogedException("findCsvEntityByPrimaryKey",
					"session is null");
		}
		try {
			String sql = "SELECT csv FROM CsvEntity AS csv "
					+ "WHERE csv.idCsv = :id ";

			Query query = HibernateUtil.currentSession().createQuery(sql);
			query.setParameter("id", idCsv);

			Object result = query.uniqueResult();
			if (result != null) {
				return ((CsvEntity) result).getCsvEntityData();
			}
		} catch (Exception e) {
			Object[] parameters = { idCsv };
			handler.getException(e, "findCsvEntityByPrimaryKey", userRequest,
					parameters);
		}
		MemoryLog.getInstance().log(MemoryLog.END, "findCsvEntityByPrimaryKey",
				getClass());
		return null;
	}

