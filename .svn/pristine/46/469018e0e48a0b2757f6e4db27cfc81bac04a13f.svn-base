	public ResumeItem getDriverResume(UserSessionData userSessionData)  throws Exception {
		ResumeItem item = new ResumeItem("query.resume.drivers");
		try {
			String[] s = userSessionData.getFilter().getPrincipalFields("d",userSessionData.getFilter().getPrincipalCount());
			String sql = "SELECT c.resourcekey AS c "+s[0]+", count(*) AS count" +
						" FROM drivers d, country c"+s[1]+
						" WHERE corporation = "+userSessionData.getCorporationId()+" AND exclusiondate IS NULL AND c.id = d.country "+s[2]+
						" GROUP BY c,"+s[3];
	        Session session = HibernateUtil.currentSession();

	        SQLQuery q = session.createSQLQuery(sql);
	        q.addScalar("c", Hibernate.STRING);
			StringTokenizer token = new StringTokenizer(s[3], ",");
			while (token.hasMoreTokens()) {
				q.addScalar(token.nextToken(), Hibernate.STRING);
			}
	        q.addScalar("count", Hibernate.INTEGER);
	        Iterator it = q.list().iterator();
	        while(it.hasNext()) {
	        	item.addData(0,(Object[]) it.next());
	        }
        } catch(Exception e){
			Object[] p = {};
			handler.getException(e, "getDriverResume", userSessionData, p);
        }
		return item;
	}

	/**
     * @ejb.permission role-name ="administrator,driverview"
     * @ejb.interface-method
     */
    public ArrayList<AnualPlanData> getAnualPlan(Integer driver, UserSessionData userSessionData) throws Exception {
        ArrayList<AnualPlanData> result=new ArrayList<AnualPlanData>();
        try {
            Session session = HibernateUtil.currentSession();
            Calendar cal=Calendar.getInstance();

            Query q = session.createQuery("SELECT ap FROM AnualPlan AS ap WHERE ap.driver.id = "+driver+" and ap.year="+cal.get(Calendar.YEAR)+" ORDER BY ap.dateStart ASC");
            List list = q.list();
            Iterator iter=list.iterator();
            while(iter.hasNext()){
                result.add(((AnualPlan)iter.next()).getData(userSessionData));
            }
        } catch (Exception e) {
            Object[] p = {driver};
            handler.getException(e, "getAnualPlan", userSessionData, p);
        }
        return result;
    }

    /**
     * @ejb.permission role-name ="administrator,driverview"
     * @ejb.interface-method
     */
    public ReportPlanData getReportPlan(Integer driver, UserSessionData userSessionData) throws Exception {
        ReportPlanData result=new ReportPlanData(0);

        try {
            result.setMitigationPlan(getMitigationPlan(driver, userSessionData));
            result.setAnualPlans(getAnualPlan(driver, userSessionData));
        } catch (Exception e) {
            Object[] p = {driver};
            handler.getException(e, "getReportPlan", userSessionData, p);
        }
        return result;
