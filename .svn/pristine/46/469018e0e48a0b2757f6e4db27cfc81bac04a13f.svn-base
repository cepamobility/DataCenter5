	/**
	 * @ejb.permission role-name ="administrator,drivereventview,driveredit,driverupdate,eventcreate,finecreate,driverviewowndata,drivertests,usercreate,doorcontrol,driverbayerdata,jjreporter"
	 * @ejb.interface-method
	 */
	public DriverData findDriverByPrimaryKey(Integer id, UserSessionData userRequest) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "findDriverByPrimaryKey", getClass());
		if (id == null) {
			throw new InvalidDataException("findDriverByPrimaryKey",
					"id = null");
		}
		if (userRequest == null) {
			throw new DeslogedException("findDriverByPrimaryKey",
					"session is null");
		}
		try {
			String sql = "SELECT driver FROM Driver AS driver ";
            if(userRequest.getCorporationId() == CorporationData.FORESTALES) {
				sql += " WHERE id = :id ";
            }else {
				if (userRequest.isDriver() || userRequest.isReporterJJ()) {
					sql += " where driver.corpCountry.pk.corporation.id = "	+ userRequest.getFilter().getCorporationId();
				} else {
					sql += UtilityQuery.corporationDivisionsRestictions("driver", userRequest);
				}
				sql += " AND id = :id ";
            }
			Query query = HibernateUtil.currentSession().createQuery(sql);
			query.setParameter("id", id);
			Object result = query.uniqueResult();
			if (result != null) {
				return ((Driver) result).getDriverData();
			}
		} catch (Exception e) {
			Object[] parameters = { id };
			handler.getException(e, "findDriverByPrimaryKey", userRequest,
					parameters);
		}
		MemoryLog.getInstance().log(MemoryLog.END, "findDriverByPrimaryKey",
				getClass());
		return null;
	}

