			query.setParameter("id", id);
			Object result = query.uniqueResult();
			if (result != null) {
				return ((Driver) result).getDriverData();
			}
		} catch (Exception e) {
			Object[] parameters = { id };
			handler.getException(e, "getDriver", userRequest, parameters);
		}
		return null;
	}

	/**
	 * @ejb.permission role-name ="administrator,driveredit"
	 * @ejb.interface-method
	 */
	public DriverLogisticData getDriverLogistic(Integer driverId, String activity, UserSessionData userRequest) throws Exception {
		if (driverId == null) {
			throw new InvalidDataException("getDriverLogistic", "driverId = null");
		}
		if (userRequest == null) {
			throw new DeslogedException("getDriverLogistic", "session is null");
		}
		try {
			Query query = HibernateUtil.currentSession().createQuery("SELECT l FROM DriverLogistic AS l WHERE l.pk.driver.id = :id AND l.pk.activity.resourceBundleId = :activity");
			query.setParameter("id", driverId);
			query.setParameter("activity", activity);
			Object result = query.uniqueResult();
			if (result != null) {
				return ((DriverLogistic) result).getData();
			}
		} catch (Exception e) {
			Object[] parameters = { driverId };
			handler.getException(e, "getDriverLogistic", userRequest, parameters);
		}
		return null;
	}

	/**
	 * @ejb.permission role-name ="administrator,driveredit"
	 * @ejb.interface-method
	 */
	public Collection<String> getAvailableDriverLogistic(Integer driverId, UserSessionData userRequest) throws Exception {
		if (driverId == null) {
			throw new InvalidDataException("getAvailableDriverLogistic", "driverId = null");
		}
		if (userRequest == null) {
			throw new DeslogedException("getAvailableDriverLogistic", "session is null");
		}
		try {
			Query query = HibernateUtil.currentSession().createSQLQuery("select * from activitytypebycorporation where corporationid = "+userRequest.getCorporationId()+" and resourcebundleid not in (select activity from driverlogistic where driver = "+driverId+")").addScalar("resourcebundleid",Hibernate.STRING);
			return query.list();
		} catch (Exception e) {
			Object[] parameters = { driverId };
			handler.getException(e, "getAvailableDriverLogistic", userRequest, parameters);
		}
		return new LinkedList();
	}

	/**
	 * @ejb.permission role-name ="administrator,driveredit"
	 * @ejb.interface-method
	 */
	public Collection<DriverLogisticData> getDriverLogisticList(Integer driverId, UserSessionData userRequest) throws Exception {
		Collection<DriverLogisticData> list = new LinkedList<DriverLogisticData>();
		if (driverId == null) {
			throw new InvalidDataException("getDriverLogistic", "driverId = null");
		}
		if (userRequest == null) {
			throw new DeslogedException("getDriverLogistic", "session is null");
		}
		try {
			Query query = HibernateUtil.currentSession().createQuery("SELECT l FROM DriverLogistic AS l WHERE l.pk.driver.id = :id");
			query.setParameter("id", driverId);
			Iterator it = query.list().iterator();
			while(it.hasNext()) {
				list.add(((DriverLogistic) it.next()).getData());
			}
		} catch (Exception e) {
			Object[] parameters = { driverId };
			handler.getException(e, "getDriverLogistic", userRequest, parameters);
		}
		return list;
	}



