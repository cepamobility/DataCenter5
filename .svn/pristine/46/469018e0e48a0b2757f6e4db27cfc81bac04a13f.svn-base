					sqlQueryData += " AND date <= '"
							+ Util.getDate((String) parameters
									.get("toYearEvent"), (String) parameters
									.get("toMonthEvent"), 1) + "'";
				}
				sqlQueryData += "))";

				SQLQuery queryData = session.createSQLQuery(sqlQueryData);
				queryData.addScalar("driver", Hibernate.INTEGER);
				queryData.addScalar("date", Hibernate.DATE);
				queryData.addScalar("type", Hibernate.STRING);
				queryData.addScalar("clasification", Hibernate.STRING);
				queryData.addScalar("result", Hibernate.STRING);
				queryData.addScalar("story", Hibernate.STRING);
				queryData.addScalar("evitability", Hibernate.STRING);
				queryData.addScalar("recomendation", Hibernate.STRING);
				queryData.addScalar("observations", Hibernate.STRING);

				Iterator values = queryData.list().iterator();
				HistoryDataType last = null;
				while (values.hasNext()) {
					Object[] data = (Object[]) values.next();
					drivers.get(data[0]).addEvent(data);
				}
			}
			Enumeration elements = drivers.elements();
			while (elements.hasMoreElements()) {
				result.add(elements.nextElement());
			}

		} catch (Exception e) {
			Object[] p = new Object[parameters.size()];
			Enumeration pEnum = parameters.elements();
			int i = 0;
			while (pEnum.hasMoreElements()) {
				p[i] = pEnum.nextElement();
				i++;
			}
			handler.getException(e, "getHistoryDrivers", userSessionData, p);
		}

		return new ListResult(result, total);
	}

