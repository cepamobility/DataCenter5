		try{

			Session session = HibernateUtil.currentSession();
			String select=" select t from TelematicControl as t ";
			String where=" where t.driver.corpCountry.pk.corporation.id="+userSessionData.getFilter().getCorporationId()+" and ";
			if(filter.getStart()!=null){
				where+=" t.date >= (:start)";
			}else{
				where+=" 1=1 ";
			}
			where+=" and ";
			if(filter.getEnd()!=null){
				where+=" t.date <= (:end)";
			}else{
				where+=" 1=1 ";
			}
			where+=" and ";
			if(filter.getText()!=null && filter.getText().trim().length()>0){
				where+=" ( lower(t.driver.firstName) like (:text) or lower(t.driver.lastName) like (:text) )";
			}else{
				where+=" 1=1 ";
			}

			Query query=session.createQuery(select+where);
			if(filter.getStart()!=null){
				query.setParameter("start", Util.floorDate(filter.getStart()));
			}
			if(filter.getEnd()!=null){
				query.setParameter("end", Util.topDate(filter.getEnd()));
