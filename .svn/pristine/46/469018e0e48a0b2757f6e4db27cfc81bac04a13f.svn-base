						xlsRow.addCell(telematicControl.getOccurrences()!=null?telematicControl.getOccurrences().toString():"");

						sheetWeekWork.add(xlsRow);
						break;

				}
			}


			ExcelGenerator.generatorCellXLSNoStyle(sheetSpeed, messages.getText("driver.telematiccontrol.excessivespeed"),
					sheetFreeTime,messages.getText("driver.telematiccontrol.freetime"),
					sheetWhorkHours,messages.getText("driver.telematiccontrol.workhours"),
					sheetInserticialReport, messages.getText("driver.telematiccontrol.interst|itialreport"),
					sheet24Hour,messages.getText("driver.telematiccontrol.24hourworeport"),
					sheetWeekWork,messages.getText("driver.telematiccontrol.weekwork"),frenadaBrusca,"Freada brusca",
					arrancadaBrusca,"Arrancada Brusca",
					output);

		} catch (Exception e) {
			handler.getException(e, "exportTelematicControlDPA", userSessionData, null);
		}
