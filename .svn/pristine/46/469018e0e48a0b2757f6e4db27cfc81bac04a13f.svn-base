	/**
	 * @ejb.permission role-name ="administrator,driveredit,driverviewowndata"
	 * @ejb.interface-method
	 */
	public Collection<TelematicControlData> findTelematicControls(String firstName, String lastName, Date from, Date to, int type, int status, Integer[][] divOrgs, Integer[][] divGeos,UserSessionData userSessionData) throws Exception {
		Collection<TelematicControlData> list = new LinkedList<TelematicControlData>();
		if (userSessionData == null) {
			throw new DeslogedException("findTelematicControls", "session is null");
		}
		try {
			String sql = "SELECT d.id AS driver,d.firstname, d.lastname, d1.resourcekey AS dpto, t.date, t.time, t.type, t.observations, t.speed, t.duration, t.garage, t.statuscomment " +
					"FROM telematiccontrols t " +
					"JOIN drivers d on d.id = t.driver " +
					"JOIN divorgitemlevel1s d1 on d1.id = d.divorg1 " +
					UtilityQuery.filterDivs(divOrgs, divGeos[0], "d", userSessionData);
			if(firstName != null && firstName.trim().length() > 0) {
				sql += " AND LOWER(TRIM(d.firstname)) LIKE '%"+firstName.toLowerCase()+"%' ";
			}
			if(lastName != null && lastName.trim().length() > 0) {
				sql += " AND LOWER(TRIM(d.lastname)) LIKE '%"+lastName.toLowerCase()+"%' ";
			}
			switch (status) {
				case DriverData.ACTIVE:
					sql += " AND d.exclusionDate IS NULL ";
					break;
				case DriverData.EXCLUDED:
					sql += " AND d.exclusionDate IS NOT NULL ";
					break;
			}
			if(type == TelematicControlData.TYPE_EXCESSIVE_SPEED || type == TelematicControlData.TYPE_NIGTH_DRIVE) {
				sql += " AND t.type = "+type;
			}
			if(from != null) {
				sql += " AND t.date >= "+Util.formatSQL(from);
			}
			if(to != null) {
				sql += " AND t.date <= "+Util.formatSQL(to);
			}
			sql += " ORDER BY date DESC";
			SQLQuery query = HibernateUtil.currentSession().createSQLQuery(sql);
			query.addScalar("driver", Hibernate.INTEGER);
			query.addScalar("firstname", Hibernate.STRING);
			query.addScalar("lastname", Hibernate.STRING);
			query.addScalar("dpto", Hibernate.STRING);
			query.addScalar("date", Hibernate.DATE);
			query.addScalar("time", Hibernate.STRING);
			query.addScalar("type", Hibernate.INTEGER);
			query.addScalar("observations", Hibernate.STRING);
			query.addScalar("speed", Hibernate.INTEGER);
			query.addScalar("duration", Hibernate.STRING);
			query.addScalar("garage", Hibernate.STRING);
			query.addScalar("statuscomment", Hibernate.STRING);
			Iterator it = query.list().iterator();
			while (it.hasNext()) {
				list.add(new TelematicControlData((Object[])it.next()));
			}
		} catch (Exception e) {
			Object[] parameters = {firstName,lastName,type,divOrgs,divGeos};
			handler.getException(e, "findTelematicControls", userSessionData, parameters);
		}
		return list;
	}

	/**
	 * @throws Exception
	 * @ejb.permission role-name ="administrator,driveredit,driverviewowndata"
	 * @ejb.interface-method
	 */
	public ArrayList<TelematicControlSendMailData> findTelematicControlsSendMail(Date start, Date end,UserSessionData userSessionData) throws Exception{
		ArrayList<TelematicControlSendMailData> list=new ArrayList<TelematicControlSendMailData>();
		try {
			String querySTR="select tc.id from TelematicControlSendMail  as tc where ";


			if(start!=null){
				querySTR+=" to_date(to_char(tc.date, 'YYYY-MM-DD'), 'YYYY-MM-DD') >= to_date(("+Util.formatSQLFull(start,0)+"), 'YYYY-MM-DD') and ";
			}else{
				querySTR+=" 1=1 and ";
			}

			if(end!=null){
				querySTR+=" to_date(to_char(tc.date, 'YYYY-MM-DD'), 'YYYY-MM-DD') < to_date(("+Util.formatSQLFull(end,1)+"), 'YYYY-MM-DD')";
			}else{
				querySTR+=" 1=1 ";
			}

			/*
			if(start!=null){
				querySTR=querySTR.replace("#start",Util.formatSQL(start,0));
			}
			if(end!=null){
				querySTR=querySTR.replace("#end",Util.formatSQL(end,1));
			}*/


			Query query = HibernateUtil.currentSession().createSQLQuery(querySTR);

			Iterator it = query.list().iterator();
			String idsIN="0";
			while (it.hasNext()) {
				idsIN+=",";
				Integer id=(Integer)it.next();
				idsIN+=id;
			}

			query= HibernateUtil.currentSession().createQuery("select tc from TelematicControlSendMail  as tc where tc.id in ("+idsIN+") order by tc.date asc");
			it = query.list().iterator();
			while (it.hasNext()) {
				list.add(((TelematicControlSendMail)it.next()).getData(userSessionData));
			}
		} catch (Exception e) {
			Object[] parameters = { start,end };
			handler.getException(e, "findTelematicControlsSendMail", userSessionData,
					parameters);
		}

		return list;
	}


	/**
	 * @ejb.permission role-name ="administrator,driveredit,driverviewowndata"
	 * @ejb.interface-method
	 */
	public Collection<TelematicControlData> findTelematicControls(
			Integer year,Integer monthstart,Integer monthend, UserSessionData userSessionData) throws Exception {
		Collection<TelematicControlData> list = new LinkedList<TelematicControlData>();

		if (userSessionData == null) {
			throw new DeslogedException("findTelematicControls",
					"session is null");
		}
		try {
			String sql = "SELECT control FROM TelematicControl AS control WHERE driver is not null and  date >= (:dateStart) and date <= (:dateEnd) and control.status='Ativo' ORDER by date desc";
			Query query = HibernateUtil.currentSession().createQuery(sql);

			Calendar calendar1 = Calendar.getInstance();
			calendar1.set(Calendar.DAY_OF_MONTH, 1);
			calendar1.set(Calendar.MONTH,  (monthstart-1) );
			calendar1.set(Calendar.YEAR, year.intValue());
			calendar1.set(Calendar.HOUR_OF_DAY, 0);
			calendar1.set(Calendar.MINUTE, 0);
			calendar1.set(Calendar.SECOND,0);
			query.setParameter("dateStart", calendar1.getTime());

			calendar1 = Calendar.getInstance();

			calendar1.set(Calendar.DAY_OF_MONTH, calendar1.getActualMaximum(Calendar.DAY_OF_MONTH));
			calendar1.set(Calendar.MONTH,  (monthend-1));
			calendar1.set(Calendar.YEAR, year.intValue());
			calendar1.set(Calendar.HOUR_OF_DAY, 0);
			calendar1.set(Calendar.MINUTE, 0);
			calendar1.set(Calendar.SECOND,0);
			query.setParameter("dateEnd", calendar1.getTime());

			Iterator it = query.list().iterator();
			while (it.hasNext()) {
				list.add(((TelematicControl) it.next())
						.getData(userSessionData));
			}
		} catch (Exception e) {
			Object[] parameters = {  };
			handler.getException(e, "findTelematicControls", userSessionData,
					parameters);
		}
		return list;
	}


	/**
	 * @ejb.permission role-name ="administrator,driveredit,driverviewowndata"
	 * @ejb.interface-method
	 */
	public Collection<DriverData> findDriversDPAPontos(
			Integer year,Integer monthend, UserSessionData userSessionData) throws Exception {
		List<DriverData> list = new LinkedList<DriverData>();

		if (userSessionData == null) {
			throw new DeslogedException("findTelematicControls",
					"session is null");
		}
		try {
			String sql = "SELECT control FROM TelematicControl AS control WHERE driver is not null and  date >= (:dateStart) and date <= (:dateEnd)  ORDER by date desc";
			Query query = HibernateUtil.currentSession().createQuery(sql);
			HashMap<Integer,DriverData> map=new HashMap<Integer, DriverData>();

			Calendar calendar1 = Calendar.getInstance();
			calendar1.set(Calendar.DAY_OF_MONTH, 1);
			calendar1.set(Calendar.MONTH,  (11) );
			calendar1.set(Calendar.YEAR, monthend<11?year.intValue()-1:year);
			calendar1.set(Calendar.HOUR_OF_DAY, 0);
			calendar1.set(Calendar.MINUTE, 0);
			calendar1.set(Calendar.SECOND,0);
			query.setParameter("dateStart", calendar1.getTime());

			calendar1 = Calendar.getInstance();
			calendar1.set(Calendar.DAY_OF_MONTH, 1);
			calendar1.set(Calendar.MONTH,  (monthend-1));
			calendar1.set(Calendar.YEAR, year.intValue());
			calendar1.set(Calendar.HOUR_OF_DAY, 0);
			calendar1.set(Calendar.MINUTE, 0);
			calendar1.set(Calendar.SECOND,0);
			query.setParameter("dateEnd", calendar1.getTime());

			Iterator it = query.list().iterator();
			while (it.hasNext()) {
				TelematicControl telec=(TelematicControl) it.next();
				TelematicControlData telecData= telec.getData(userSessionData);
				if(!map.containsKey(telecData.getDriver().getId())){
					map.put(telecData.getDriver().getId(), telecData.getDriver());
					DriverData data=map.get(telecData.getDriver().getId());
					data.setPoints(0);
				}

				DriverData data=map.get(telecData.getDriver().getId());
				Integer p=0;
				try{
					p=Integer.valueOf(telecData.getPoint());
				}catch(Throwable th){

				}
				data.setPoints(data.getPoints()+p);
			}

			Comparator<DriverData> comparator = new Comparator<DriverData>() {
			    public int compare(DriverData c1, DriverData c2) {
			        return  c2.getPoints().compareTo(c1.getPoints());
			    }
			};


			list.addAll(map.values());
			Collections.sort(list, comparator);


		} catch (Exception e) {
			Object[] parameters = {  };
			handler.getException(e, "findDriversDPAPontos", userSessionData,
					parameters);
		}
		return list;
	}

	/**
