	public DriverData findDriverByIdDallas(String idDallas,
			UserSessionData userRequest) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "findDriverByIdDallas",
				getClass());
		try {
			if (idDallas != null && !idDallas.trim().equals("")
					&& userRequest != null) {
				String sql = "SELECT driver FROM Driver AS driver ";
				sql += UtilityQuery.corporationDivisionsRestictions("driver",
						userRequest);
				sql += " AND iddallas = :iddallas ";
				Query query = HibernateUtil.currentSession().createQuery(sql);
				query.setParameter("iddallas", idDallas);
				Object result = query.uniqueResult();
				if (result != null) {
					return ((Driver) result).getDriverData();
				}
			}
		} catch (Exception e) {
			Object[] parameters = { idDallas };
			handler.getException(e, "findDriverByIdDallas", userRequest,
					parameters);
		}
		MemoryLog.getInstance().log(MemoryLog.END, "findDriverByIdDallas",
				getClass());
		return null;
	}

	/**
	 * @ejb.permission role-name ="administrator,driveredit,driverupdate,eventcreate,finecreate,driverviewowndata,drivertests,usercreate,doorcontrol"
	 * @ejb.interface-method
	 * @param idDriver
	 * @param date
	 * @param type
	 * @return
	 * @throws Exception
	 *
	 *             Verifica si existe o no un control telematico para el
	 *             conductor idDriver en esa fecha date y de ese tipo type.
	 */
	public boolean existTelematicControl(Integer idDriver, Date date,
			Integer type, UserSessionData userRequest) throws Exception {

		MemoryLog.getInstance().log(MemoryLog.START, "existTelematicControl",
				getClass());

		if (idDriver == null)
			throw new InvalidDataException("existTelematicControl", "id = null");

		try {
			// TODO GUS: TRUNCAR LA FECHA porque se repiten controles telematicos con diferente hora
			Date date2 = date;
			if (date != null ) {
				Calendar calendar1 = Calendar.getInstance();
				calendar1.setTime(date);
				calendar1.set(Calendar.HOUR_OF_DAY, 0);
				calendar1.set(Calendar.MINUTE, 0);
				calendar1.set(Calendar.SECOND,0);
				date2 = calendar1.getTime();
			}

			String sql = "SELECT control FROM TelematicControl AS control "
					+ "WHERE driver.id = :iddriver  AND date = :date AND type = :type ";
			Query query = HibernateUtil.currentSession().createQuery(sql);
			query.setParameter("iddriver", idDriver);
			query.setParameter("date", date2);
			query.setParameter("type", type);

			List<TelematicControl> resultList = (List<TelematicControl>) query
					.list();
			if (resultList != null && resultList.size() > 0) {
				Iterator it = resultList.iterator();
				TelematicControlData control = ((TelematicControl) it.next())
						.getData(userRequest);
				if (control != null)
					return true;
			}

		} catch (Exception e) {
			Object[] parameters = { idDriver, date, type };
			handler.getException(e, "existTelematicControl", userRequest,
					parameters);
		}
		MemoryLog.getInstance().log(MemoryLog.END, "existTelematicControl",
				getClass());
		return false;
	}

	/**
	 * @ejb.permission role-name ="administrator,driveredit,driverupdate,eventcreate,finecreate,driverviewowndata,drivertests,usercreate,doorcontrol,dpachecklist"
	 * @ejb.interface-method
	 */
	public Collection findDriverByCorporationId(String corporationId, UserSessionData userRequest) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "findDriverByCorporationId", getClass());
		if (corporationId == null) {
			throw new InvalidDataException("findDriverByCorporationId","id = null");
		}
		if (userRequest == null) {
			throw new DeslogedException("findDriverByCorporationId","session null");
		}
		Collection values = new LinkedList();
		try {
			String sql = "SELECT driver FROM Driver AS driver ";
			if (userRequest.isDriver()) {
				sql += " where driver.corpCountry.pk.corporation.id = " + userRequest.getFilter().getCorporationId();
			} else {
				sql += UtilityQuery.corporationDivisionsRestictions("driver", userRequest);
			}
			if(corporationId != null)
				sql += " AND corporationId = :id ";
			Query query = HibernateUtil.currentSession().createQuery(sql);
			if(corporationId != null)
				query.setParameter("id", corporationId);
			List drivers = query.list();
			if (drivers != null) {
				Iterator driversIt = drivers.iterator();
				while (driversIt.hasNext()) {
					values.add(((Driver) driversIt.next()).getDriverData());
				}
			}
		} catch (Exception e) {
			Object[] parameters = { corporationId };
			handler.getException(e, "findDriverByCorporationId", userRequest, parameters);
		}
		MemoryLog.getInstance().log(MemoryLog.END, "findDriverByPrimaryKey", getClass());
		return values;
	}

	/**
	 * @throws Exception
	 * @ejb.permission role-name ="administrator,driveredit,driverupdate,eventcreate,finecreate,driverviewowndata,drivertests,usercreate,doorcontrol,eventupload"
	 * @ejb.interface-method
	 */
	public ListResult findDriversByNameCorporationAndBirthdate(
			String firstname, String lastname, Integer idCorporation,
			Date birthdate, UserSessionData userRequest) throws Exception {

		MemoryLog.getInstance().log(MemoryLog.START,
				"findDriverByNameCorporationAndBirthdate", getClass());
		if (userRequest == null) {
			throw new DeslogedException("findDriverByCorporationId",
					"session is null");
		}
		ListResult result = null;
		Collection<DriverData> drivers = null;

		try {
			Session session = HibernateUtil.currentSession();

			String sql = "SELECT driver FROM Driver AS driver ";
			sql += " WHERE driver.corpCountry.pk.corporation.id = "
					+ idCorporation;
			sql += " AND trim(driver.firstName) = '" + firstname + "' ";
			sql += " AND trim(driver.lastName) = '" + lastname + "' ";
			if (birthdate != null) {
				sql += " AND driver.birthDate = :birthdate ";
			}

			Query query = session.createQuery(sql);

			if (birthdate != null) {
				query.setParameter("birthdate", birthdate);
			}

			List list = query.list();
			if (list != null & list.size() > 0) {
				Iterator it = list.iterator();
				drivers = new LinkedList<DriverData>();
				while (it.hasNext()) {
					Driver d = (Driver) it.next();
					drivers.add(d.getDriverData());
				}
				result = new ListResult(drivers, drivers.size());
			}

			return result;

		} catch (Exception e) {
			Object[] parameters = { firstname, lastname, idCorporation,
					birthdate };
			handler.getException(e, "findDriversByNameCorporationAndBirthdate",
					userRequest, parameters);
		}
		MemoryLog.getInstance().log(MemoryLog.END,
				"findDriversByNameCorporationAndBirthdate", getClass());
		return null;
	}

	/**
	 * @throws Exception
	 * @ejb.permission role-name ="administrator,driveredit,driverupdate,eventcreate,finecreate,driverviewowndata,drivertests,usercreate,doorcontrol,eventupload"
	 * @ejb.interface-method
	 */
	public Collection findDriversByFullName(String fullname, UserSessionData userSessionData) throws Exception {
		if (userSessionData == null) {
			throw new DeslogedException("findDriversByFullName","session is null");
		}
		Collection<DriverData> drivers = null;

		try {
			Session session = HibernateUtil.currentSession();

			String sql = "SELECT driver FROM Driver AS driver ";
			sql += " WHERE driver.corpCountry.pk.corporation.id = "
					+ userSessionData.getCorporationId();
			sql += " AND driver.firstName || ' ' || driver.lastName = '" + fullname + "' ";
			Query query = session.createQuery(sql);

			List list = query.list();
			if (list != null & list.size() > 0) {
				Iterator it = list.iterator();
				drivers = new LinkedList<DriverData>();
				while (it.hasNext()) {
					Driver d = (Driver) it.next();
					drivers.add(d.getDriverData());
				}
			}
			return drivers;

		} catch (Exception e) {
			Object[] parameters = { fullname };
			handler.getException(e, "findDriversByFullName", userSessionData, parameters);
		}
		return null;
	}

	/**
	 * @throws Exception
	 * @ejb.permission role-name ="administrator,driveredit,driverupdate,eventcreate,finecreate,driverviewowndata,drivertests,usercreate,doorcontrol,eventupload"
	 * @ejb.interface-method
	 */
	public ListResult findByMainData(String firstname, String lastname,
			Date birthdate, UserSessionData userSessionData) throws Exception {

		if (userSessionData == null) {
			throw new DeslogedException("findByMainData", "session is null");
		}
		ListResult result = null;
		Collection<DriverData> drivers = new LinkedList<DriverData>();

		try {
			Session session = HibernateUtil.currentSession();

			String sql = "SELECT id,exclusiondate FROM drivers ";
			sql += " WHERE corporation = "
					+ String.valueOf(userSessionData.getFilter()
							.getCorporationId());
			sql += " AND LOWER(TRIM(firstname)) = '" + firstname.toLowerCase() + "' ";
			sql += " AND LOWER(TRIM(lastname)) = '" + lastname.toLowerCase() + "' ";
			if (birthdate != null) {
				sql += " AND DATE(birthdate) = " + Util.formatSQL(birthdate);
			}
			sql += " ORDER BY exclusiondate desc";

			Query query = session.createSQLQuery(sql).addScalar("id",
					Hibernate.INTEGER).addScalar("exclusiondate",
							Hibernate.DATE);

			List list = query.list();
			if (list != null & list.size() > 0) {
				Iterator it = list.iterator();
				if (it.hasNext()) {
					Object[] daa = (Object[])it.next();
					drivers.add(new DriverData((Integer) daa[0]));
				}
				result = new ListResult(drivers, drivers.size());
			}

			return result;

		} catch (Exception e) {
			Object[] parameters = { firstname, lastname, birthdate };
			handler.getException(e, "findByMainData", userSessionData,
					parameters);
		}
		return null;
	}

	/**
	 * @ejb.permission role-name ="administrator,driveredit,driverupdate,eventcreate,finecreate,driverviewowndata,drivertests,cepascheduleactivityregistrycreate,drivercreateevent,query"
	 * @ejb.interface-method
	 */
	public DriverMainAttributes findDriverMainData(Integer id,
			UserSessionData userRequest) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "findDriverMainData",
				getClass());
		DriverMainAttributes attributes = null;

		if (id == null)
			return null;

		if (userRequest == null) {
			throw new DeslogedException("findDriverMainData", "session is null");
		}
		try {
			String sql = (userRequest.getCorporationId() == CorporationData.FORESTALES) ? "SELECT firstname,lastname FROM drivers WHERE id = " + String.valueOf(id) : "SELECT firstname,lastname FROM drivers d " + UtilityQuery.corporationDivisionsRestictionsSQL("d", userRequest) + " AND id = " + String.valueOf(id);
			SQLQuery query = HibernateUtil.currentSession().createSQLQuery(sql);
			query.addScalar("firstname", Hibernate.STRING);
			query.addScalar("lastname", Hibernate.STRING);
			Object[] result = (Object[]) query.uniqueResult();
			if (result != null) {
				attributes = new DriverMainAttributes(id);
				attributes.setFirstName((String) result[0]);
				attributes.setLastName((String) result[1]);
			}
		} catch (Exception e) {
			Object[] parameters = { id };
			handler.getException(e, "findDriverMainData", userRequest,
					parameters);
		}
		MemoryLog.getInstance().log(MemoryLog.END, "findDriverMainData",
				getClass());
		return attributes;
	}

	/**
	 * @ejb.permission role-name ="administrator,driveredit,driverupdate,eventcreate,finecreate,driverviewowndata,drivertests,driverupload"
	 * @ejb.interface-method
	 */
	public boolean existDriver(UserSessionData userRequest, String firstName,
			String lastName, Date birthday) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "existDriver", getClass());
		try {
			Format dateFormat = new SimpleDateFormat("yyyy-MM-dd");
			Session session = HibernateUtil.currentSession();
			SQLQuery query = session
					.createSQLQuery(
							"SELECT count(*) as count FROM drivers WHERE "
									+ " firstname = '"
									+ firstName
									+ "' AND lastname = '"
									+ lastName
									+ "' AND date_trunc('day',birthdate) = date_trunc('day', timestamp '"
									+ dateFormat.format(birthday) + "') AND corporation = "+userRequest.getCorporationId())
					.addScalar("count", Hibernate.INTEGER);
			Object result = query.uniqueResult();
			if (result != null) {
				return (((Integer) result).intValue() > 0);
			}
		} catch (Exception e) {
			Object[] parameters = { firstName, lastName, birthday };
			handler.getException(e, "existDriver", userRequest, parameters);
		}
		MemoryLog.getInstance().log(MemoryLog.END, "existDriver", getClass());
		return false;
	}

	/**
	 * @ejb.permission role-name =
	 *                 "administrator,driveredit,driverupdate,eventcreate,
	 *                 finecreate,driverviewowndata,drivertests,driverupload,
	 *                 uploadcdcimsa"
	 * @ejb.interface-method
	 *
	 *                       Devuelve el id del driver si existe o null en caso
	 *                       contrario.
	 */
	public Integer existDriverByCorporationId(UserSessionData userRequest,
			String firstName, String lastName, String corporationUserId,
			Integer corporationId) throws Exception {

		MemoryLog.getInstance().log(MemoryLog.START,
				"existDriverByCorporationId", getClass());
		try {

			String sql = "SELECT id FROM drivers WHERE " + " corporation = "
					+ corporationId + " and lower(trim(firstname)) = lower('"
					+ firstName.trim()
					+ "') AND lower(trim(lastname)) = lower('"
					+ lastName.trim() + "') ";
			if (corporationUserId != null) {
				sql += " AND trim(corporationid) = '"
						+ corporationUserId.trim() + "' ";
			}

			Session session = HibernateUtil.currentSession();
			SQLQuery query = session.createSQLQuery(sql).addScalar("id",
					Hibernate.INTEGER);
			Object result = query.uniqueResult();
			if (result != null) {
				return (Integer) result;
			}
		} catch (Exception e) {
			Object[] parameters = { firstName, lastName, corporationId };
			handler.getException(e, "existDriverByCorporationId", userRequest,
					parameters);
		}
		MemoryLog.getInstance().log(MemoryLog.END,
				"existDriverByCorporationId", getClass());
		return null;
	}

	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name ="administrator,driverview,driversearch,cepascheduleactivityregistrycreate,cepascheduleactivityregistryupdate"
	 */
	public ListResult findList(String value, String corporationId, UserSessionData userRequest,
			int attribute, int first, int count, int status,int temporal) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "findList", getClass());
		try {
			Session session = HibernateUtil.currentSession();
			String queryStr = "select count(*) from Driver as driver "
					+ UtilityQuery.corporationDivisionsRestictions("driver",
							userRequest);

			Query query = getQuery(session, attribute, queryStr, value, corporationId,
					userRequest, status, temporal, null);
			List list = query.list();
			Integer total = new Integer(0);
			Iterator iter = null;

			if (list != null && list.size() > 0) {
				iter = list.iterator();
				total = (iter.hasNext()) ? new Integer(((Long) iter.next())
						.intValue()) : new Integer(0);
			}

			queryStr = "select driver from  Driver as driver "
					+ UtilityQuery.corporationDivisionsRestictions("driver",
							userRequest);

			String orderby = " firstname, lastname asc ";
			query = getQuery(session, attribute, queryStr, value, corporationId, userRequest, status, temporal, orderby);
			if (count != -1) {
				if (total.intValue() < first) {
					first = (total.intValue() % count == 0) ? total.intValue()
							- count : total.intValue()
							- (total.intValue() % count);
				}
			}
			query.setFirstResult(first);
			if (count != -1) {
				query.setMaxResults(count);
			}

			Collection<DriverMainAttributes> result = new LinkedList<DriverMainAttributes>();
			list = query.list();
			if (list != null && list.size() > 0) {
				iter = list.iterator();
				while (iter.hasNext()) {
					result.add(((Driver) iter.next())
							.getPrincipalAttributes(userRequest));
				}
			}
			MemoryLog.getInstance().log(MemoryLog.END, "findList", getClass());
			return new ListResult(result, total.intValue());

		} catch (Exception e) {
			Object[] parameters = { value, attribute, first, count, status };
			handler.getException(e, "findList", userRequest, parameters);
		}
		return null;
	}

	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,query"
	 */
	public DriverMainAttributes getDriverMainAttributes(Integer idDriver,
			UserSessionData userRequest) throws Exception {
		try {
			Session session = HibernateUtil.currentSession();
			String queryStr = (userRequest.getCorporationId() == CorporationData.FORESTALES) ? "select driver from  Driver as driver where driver.id = " + idDriver : "select driver from  Driver as driver "
					+ UtilityQuery.corporationDivisionsRestictions("driver", userRequest) + " and driver.id = " + idDriver;

			Query query = session.createQuery(queryStr);

			Driver driver = (Driver) query.uniqueResult();
			if (driver != null) {
				return driver.getPrincipalAttributes(userRequest);
			}

			return null;
		} catch (Exception e) {
			Object[] parameters = { idDriver };
			handler.getException(e, "getDriverMainAttribute", userRequest,
					parameters);
		}
		return null;
	}

	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name ="administrator,driverview,driversearch,cepascheduleactivityregistrycreate,cepascheduleactivityregistryupdate"
	 */
	public ListResult findCDSList(String value, UserSessionData userRequest,
			int attribute, int first, int count, int status) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "findList", getClass());
		try {
			Session session = HibernateUtil.currentSession();
			String queryStr = "SELECT COUNT(*) FROM CEPAScheduleActivityRegistry AS registry "
					+ UtilityQuery.corporationDivisionsRestictions(
							"registry.driver", userRequest);

			switch (attribute) {
			case FIRST_OR_LAST_NAME:
				queryStr += " and (lower(registry.driver.firstName) like lower(:value) OR lower(registry.driver.lastName) like lower(:value))";
				value = "%" + value + "%";
				break;
			default:
				throw new InvalidDataException("getQuery",
						"invalid attribute name");
			}
			switch (status) {
			case DriverData.ACTIVE:
				queryStr += " and registry.driver.exclusionDate is null";
				break;
			case DriverData.EXCLUDED:
				queryStr += " and registry.driver.exclusionDate is not null";
				break;
			}

			queryStr += " AND registry.activity.type.resourceBundleId IN ('"
					+ CEPAActivityConstants.CEPA_SYSTEM_COURSE_1_LIVIANOS
					+ "','"
					+ CEPAActivityConstants.CEPA_SYSTEM_COURSE_1_PESADOS
					+ "') AND registry.note = '"
					+ CEPAActivityNoteDataType.APRUVED + "' ";

			Query query = session.createQuery(queryStr);
			if (value.endsWith("%"))
				query.setParameter("value", value);
			else
				query.setParameter("value", new Integer(value));

			Iterator iter = query.list().iterator();
			Integer total = (iter.hasNext()) ? new Integer(((Long) iter.next())
					.intValue()) : new Integer(0);

			queryStr = "SELECT driver FROM CEPAScheduleActivityRegistry AS registry  "
					+ UtilityQuery.corporationDivisionsRestictions(
							"registry.driver", userRequest);

			switch (attribute) {
			case FIRST_OR_LAST_NAME:
				queryStr += " and (lower(registry.driver.firstName) like lower(:value) OR lower(registry.driver.lastName) like lower(:value))";
				break;
			default:
				throw new InvalidDataException("getQuery",
						"invalid attribute name");
			}
			switch (status) {
			case DriverData.ACTIVE:
				queryStr += " and registry.driver.exclusionDate is null";
				break;
			case DriverData.EXCLUDED:
				queryStr += " and registry.driver.exclusionDate is not null";
				break;
			}

			queryStr += " AND registry.activity.type.resourceBundleId IN ('"
					+ CEPAActivityConstants.CEPA_SYSTEM_COURSE_1_LIVIANOS
					+ "','"
					+ CEPAActivityConstants.CEPA_SYSTEM_COURSE_1_PESADOS
					+ "') AND registry.note = '"
					+ CEPAActivityNoteDataType.APRUVED + "' ";

			query = session.createQuery(queryStr);
			query.setParameter("value", value);

			if (count != -1) {
				if (total.intValue() < first) {
					first = (total.intValue() % count == 0) ? total.intValue()
							- count : total.intValue()
							- (total.intValue() % count);
				}
			}
			query.setFirstResult(first);
			if (count != -1) {
				query.setMaxResults(count);
			}

			Collection<DriverMainAttributes> result = new LinkedList<DriverMainAttributes>();
			iter = query.list().iterator();
			while (iter.hasNext()) {
				result.add(((Driver) iter.next())
						.getPrincipalAttributes(userRequest));
			}
			MemoryLog.getInstance().log(MemoryLog.END, "findList", getClass());
			return new ListResult(result, total.intValue());
		} catch (Exception e) {
			Object[] parameters = { value, attribute, first, count, status };
			handler.getException(e, "findList", userRequest, parameters);
		}
		return null;
	}

	private Query getQuery(Session session, int attribute, String queryStr,
			String value, String corporationId, UserSessionData userRequest, int status, int temporal,
			String orderby) throws Exception {
		try {
			if (value == null) {
				throw new InvalidDataException("getQuery", "value = null");
			}
			if (userRequest == null) {
				throw new DeslogedException("getQuery", "session = null");
			}
			switch (attribute) {
			case FIRST_OR_LAST_NAME_OR_CORP_ID:
				queryStr += " and (lower(firstname) like lower(:value) OR lower(lastname) like lower(:value) OR lower(corporationId) like lower(:value))";
				value = "%" + value + "%";
				break;
			case FIRST_OR_LAST_NAME:
				queryStr += " and (lower(firstname) like lower(:value) OR lower(lastname) like lower(:value))";
				value = "%" + value + "%";
				break;
			case ID:
				queryStr += " and driver.id IN (" + value + ") ";
				break;
			default:
				throw new InvalidDataException("getQuery",
						"invalid attribute name");
			}
			switch (status) {
				case DriverData.ACTIVE:
					queryStr += " and exclusionDate is null";
					break;
				case DriverData.EXCLUDED:
					queryStr += " and exclusionDate is not null";
					break;
			}
			switch (temporal) {
				case DriverData.ONLY_TEMPORAL:
					queryStr += " and temporal = 't'";
					break;
				case DriverData.ONLY_NOT_TEMPORAL:
					queryStr += " and temporal = 'f'";
					break;
			}
			if(corporationId != null && corporationId.trim().length() > 0) {
				queryStr += " and lower(trim(corporationid)) = '"+corporationId.toLowerCase()+"'";
			}
			if (orderby != null) {
				queryStr += " order by " + orderby;
			}
			Query query = session.createQuery(queryStr);
			if (attribute != ID) {
				if (value.endsWith("%"))
					query.setParameter("value", value);
				else
					query.setParameter("value", new Integer(value));
			}

			return query;
		} catch (Exception e) {
			Object[] parameters = { attribute, queryStr, value, status };
			handler.getException(e, "getQuery", userRequest, parameters);
		}
		return null;
	}

	/**
	 * @ejb.interface-method Advanced search of drivers, includes the most
	 *                       important parameters to find
	 * @param userRequest
	 *            - logged user
	 * @param id
	 *            - id of driver
	 * @param firstName
	 *            - first name of driver
	 * @param lastName
	 *            - last name of driver
	 * @param birthDate
	 *            - birth date of driver
	 * @param divOrgs
	 *            - collection of div org that the driver is associated
	 * @param divGeo
	 *            - country and geographic division that the driver is
	 *            associated
	 * @param first
	 *            - first index of the search to return
	 * @param count
	 *            - number of elements to return
	 * @return result of the search
	 * @throws Exception
	 * @ejb.permission role-name = "administrator,driverview"
	 */
	public ListResult advancedSearch(UserSessionData userRequest, String id,
			String firstName, String lastName, Date birthDate,
			Integer[][] divOrgs, Integer[][] divGeos, int first, int count,
			int status, int temporal) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "advancedSearch",
				getClass());
		try {
			Session session = HibernateUtil.currentSession();
			String queryStr = UtilityQuery.corporationDivisionsRestictions(
					"driver", userRequest);
			if (id != null) {
				queryStr += " and driver.corporationId = '"+id+"'";
			}
			if (firstName != null) {
				queryStr += " and lower(driver.firstName) like '%" + firstName.toLowerCase() + "%'";
			}
			if (lastName != null) {
				queryStr += " and lower(driver.lastName) like '%" + lastName.toLowerCase() + "%'";
			}
			if (birthDate != null) {
				queryStr += " and driver.birthDate <= "+Util.formatSQL(birthDate, 0);
				queryStr += " and driver.birthDate >= "+Util.formatSQL(birthDate, 1);
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = "";
						divOrgStr = " and driver.divOrg"
								+ String.valueOf(j + 1) + " in (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]);
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						queryStr += divOrgStr;
					}
				}
			}

			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					queryStr += "and driver.corpCountry.pk.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						queryStr += divGeos[0][i];
						queryStr += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
				if (divGeos[1] != null && divGeos[1].length > 0) {
					queryStr += "and driver.geoLevel1 in (";
					for (int i = 0; i < divGeos[1].length; i++) {
						queryStr += divGeos[1][i];
						queryStr += (i == divGeos[1].length - 1) ? ")" : ",";
					}
				}
			}
			switch (status) {
				case DriverData.ACTIVE:
					queryStr += " and driver.exclusionDate is null";
					break;
				case DriverData.EXCLUDED:
					queryStr += " and driver.exclusionDate is not null";
					break;
			}
			switch (temporal) {
				case DriverData.ONLY_TEMPORAL:
					queryStr += " and driver.temporal = 't'";
					break;
				case DriverData.ONLY_NOT_TEMPORAL:
					queryStr += " and driver.temporal = 'f'";
					break;
			}
			Query query = session
					.createQuery("select count(distinct driver.id)  from Driver as driver "
							+ queryStr);
			System.out.println("consulta drivers advanced --> select count(distinct driver.id)  from Driver as driver " + queryStr);
			List userColl = query.list();
			Iterator iter = userColl.iterator();
			Integer total = new Integer(0);
			while (iter.hasNext()) {
				total = new Integer(((Long) iter.next()).intValue());
			}
			query = session
					.createQuery("select distinct driver from Driver as driver "
							+ queryStr);
			if (count != -1) {
				if (total.intValue() < first) {
					if (total.intValue() % count == 0) {
						first = total.intValue() - count;
					} else {
						first = total.intValue() - (total.intValue() % count);
					}
				}
				query.setFirstResult(first);
				query.setMaxResults(count);
			}
			userColl = query.list();
			Collection result = new LinkedList();
			iter = userColl.iterator();
			while (iter.hasNext()) {
				Driver driver = (Driver) iter.next();
				result.add(driver.getPrincipalAttributes(userRequest));
			}
			session.close();
			MemoryLog.getInstance().log(MemoryLog.END, "advancedSearch",
					getClass());
			return new ListResult(result, total.intValue());
		} catch (Exception e) {
			Object[] parameters = { id, firstName, lastName, birthDate,
					divOrgs, divGeos, first, count, status };
			handler.getException(e, "advancedSearch", userRequest, parameters);
		}
		return null;
	}

	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverupdate,administrator"
	 */
	public List getDrivers(String drivers, UserSessionData userRequest) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "getDrivers", getClass());
		try {
			Session session = HibernateUtil.currentSession();

			String queryStr = "select driver from  Driver as driver ";
			if(drivers != null)
				queryStr += UtilityQuery.corporationDivisionsRestictions("driver",userRequest) + " and driver.id in (" + drivers + ")";

			Query query = session.createQuery(queryStr);
			List userColl = query.list();
			List result = new LinkedList();
			Iterator iter = userColl.iterator();
			while (iter.hasNext()) {
				Driver driver = (Driver) iter.next();
				result.add(driver.getPrincipalAttributes(userRequest));
			}

			MemoryLog.getInstance()
					.log(MemoryLog.END, "getDrivers", getClass());
			return result;

		} catch (Exception e) {
			Object[] parameters = { drivers };
			handler.getException(e, "getDrivers", userRequest, parameters);
		}
		return null;
	}

	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverview,administrator,driverviewowndata"
	 */
	public Collection getObservations(Integer driverId,
			UserSessionData userRequest) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "getObservations",
				getClass());
		try {
			SQLQuery query = HibernateUtil.currentSession().createSQLQuery(
					"SELECT date,userid,action,comment FROM driverlog WHERE driver = "
							+ String.valueOf(driverId)+" order by date desc");
			query.addScalar("date", Hibernate.DATE);
			query.addScalar("userid", Hibernate.STRING);
			query.addScalar("action", Hibernate.INTEGER);
			query.addScalar("comment", Hibernate.STRING);

			List userColl = query.list();
			List<ObservationData> result = new LinkedList<ObservationData>();
			Iterator iter = userColl.iterator();
			while (iter.hasNext()) {
				Object[] data = (Object[]) iter.next();
				result.add(new ObservationData(driverId, (Date) data[0],
						(String) data[1], (Integer) data[2], (String) data[3]));
			}

			MemoryLog.getInstance().log(MemoryLog.END, "getObservations",
					getClass());
			return result;
		} catch (Exception e) {
			Object[] parameters = { driverId };
			handler.getException(e, "getObservations", userRequest, parameters);
		}
		return null;
	}

	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverview,administrator"
	 */
	public ListResult getReportDrivers(String name, String status,
			Integer[][] divOrgs, Integer[][] divGeos, int first, int count,
			UserSessionData userSessionData, String accidents,
			String incidents, String fines, String accidentsCount,
			String incidentsCount, String finesCount, String type)
			throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "getReportDrivers",
				getClass());
		try {
			Session session = HibernateUtil.currentSession();

			Hashtable parameters = new Hashtable();
			String queryStr = UtilityQuery.corporationDivisionsRestictions(
					"driver", userSessionData);
			// int pages=0;

			if (name != null) {
				queryStr += " and (lower(firstname) like lower(:name) OR lower(lastname) like lower(:name))";
				parameters.put("name", "%" + name + "%");
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = "";
						divOrgStr = " and driver.divOrg"
								+ String.valueOf(j + 1) + " in (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos

							// divOrgStr += divOrgs[j][i];
							// divOrgStr += (i == divOrgs[j].length-1) ? ") " :
							// ",";
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						// System.out.println(divOrgStr);
						queryStr += divOrgStr;
					}
				}
			}
			/* Modificacion de DivOrgs para Performance */

			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					queryStr += "and driver.corpCountry.pk.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						queryStr += divGeos[0][i];
						queryStr += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
				if (divGeos[1] != null && divGeos[1].length > 0) {
					queryStr += "and driver.geoLevel1 in (";
					for (int i = 0; i < divGeos[1].length; i++) {
						queryStr += divGeos[1][i];
						queryStr += (i == divGeos[1].length - 1) ? ")" : ",";
					}
				}
			}
			switch (Integer.parseInt(status)) {
			case DriverData.ACTIVE:
				queryStr += " and exclusionDate = null";
				break;
			case DriverData.EXCLUDED:
				queryStr += " and exclusionDate != null";
				break;
			}

			if (!fines.equals("0")) {
				if (fines.equals("1")) {
					queryStr += " and driver.id in (select event.driver.id from Fine as event where event.driver.id = driver.id and event.status <> 1 )";
				} else if (fines.equals("2")) {
					queryStr += " and "
							+ finesCount
							+ " <= (select count(*) from Fine as event where event.driver.id = driver.id and event.status <> 1 )";
				} else if (fines.equals("3")) {
					queryStr += " and driver.id not in (select event.driver.id from Fine as event where event.driver.id = driver.id and event.status <> 1 )";
				}
			}
			if (!accidents.equals("0")) {
				if (accidents.equals("1")) {
					queryStr += " and driver.id in (select event.driver.id from Event as event where event.driver.id = driver.id and event.accident is not null and event.status <> 1 )";
				} else if (accidents.equals("2")) {
					queryStr += " and "
							+ accidentsCount
							+ " <= (select count(*) from Event as event where event.driver.id = driver.id and event.accident is not null and event.status <> 1 )";
					// parameters.put("accidentsCount",
					// Integer.getInteger(accidentsCount));
				} else if (accidents.equals("3")) {
					queryStr += " and driver.id not in (select event.driver.id from Event as event where event.driver.id = driver.id and event.accident is not null and event.status <> 1 )";
				}
			}
			if (!incidents.equals("0")) {
				if (incidents.equals("1")) {
					queryStr += " and driver.id in (select event.driver.id from Event as event where event.driver.id = driver.id and event.incident is not null and event.status <> 1 )";
				} else if (incidents.equals("2")) {
					queryStr += " and "
							+ incidentsCount
							+ " <= (select count(*) from Event as event where event.driver.id = driver.id and event.incident is not null and event.status <> 1 )";
					// parameters.put("incidentsCount",
					// Integer.getInteger(incidentsCount));
				} else if (incidents.equals("3")) {
					queryStr += " and driver.id not in (select event.driver.id from Event as event where event.driver.id = driver.id and event.incident is not null and event.status <> 1 )";
				}
			}

			Query query1 = session
					.createQuery("select count(driver) from Driver as driver "
							+ queryStr);
			Enumeration keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query1.setParameter(parameter, parameters.get(parameter));
			}
			Integer total = (Integer) query1.uniqueResult();

			queryStr += " order by lastname";
			Query query2 = session
					.createQuery("select distinct driver from Driver as driver "
							+ queryStr);
			keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query2.setParameter(parameter, parameters.get(parameter));
			}
			if (count != -1) {
				query2.setFirstResult(first);
				query2.setMaxResults(count);
			}
			Collection result = new LinkedList();
			List userColl = query2.list();
			Iterator iter = userColl.iterator();
			userColl = null;
			while (iter.hasNext()) {
				Driver driver = (Driver) iter.next();
				result.add(driver.getDriverReportData(type));
			}
			session.close();

			MemoryLog.getInstance().log(MemoryLog.END, "getReportDrivers",
					getClass());
			return new ListResult(result, total.intValue());
		} catch (Exception e) {
			Object[] parameters = { name, status, divOrgs, divGeos, first,
					count, accidents, incidents, fines, accidentsCount,
					incidentsCount, finesCount, type };
			handler.getException(e, "getReportDrivers", userSessionData,
					parameters);
		}
		return null;
	}

	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverview,administrator"
	 */
	public ListResult getDriversWithoutBpsRegistry(String name, String status,
			Integer[][] divOrgs, Integer[][] divGeos, int first, int count,
			UserSessionData userSessionData, String type) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START,
				"getDriversWithoutBpsRegistry", getClass());
		try {
			Session session = HibernateUtil.currentSession();

			Hashtable parameters = new Hashtable();
			String queryStr = UtilityQuery.corporationDivisionsRestictions(
					"driver", userSessionData);
			// int pages=0;

			if (name != null) {
				queryStr += " and (lower(firstname) like lower(:name) OR lower(lastname) like lower(:name))";
				parameters.put("name", "%" + name + "%");
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = "";
						divOrgStr = " and driver.divOrg"
								+ String.valueOf(j + 1) + " in (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos

							// divOrgStr += divOrgs[j][i];
							// divOrgStr += (i == divOrgs[j].length-1) ? ") " :
							// ",";
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						// System.out.println(divOrgStr);
						queryStr += divOrgStr;
					}
				}
			}
			/* Modificacion de DivOrgs para Performance */
			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					queryStr += "and driver.corpCountry.pk.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						queryStr += divGeos[0][i];
						queryStr += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
				if (divGeos[1] != null && divGeos[1].length > 0) {
					queryStr += "and driver.geoLevel1 in (";
					for (int i = 0; i < divGeos[1].length; i++) {
						queryStr += divGeos[1][i];
						queryStr += (i == divGeos[1].length - 1) ? ")" : ",";
					}
				}
			}
			switch (Integer.parseInt(status)) {
			case DriverData.ACTIVE:
				queryStr += " and exclusionDate = null";
				break;
			case DriverData.EXCLUDED:
				queryStr += " and exclusionDate != null";
				break;
			}

			queryStr += " and bpsregistry is null";

			Query query1 = session
					.createQuery("select count(driver) from Driver as driver "
							+ queryStr);
			Enumeration keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query1.setParameter(parameter, parameters.get(parameter));
			}
			Integer total = (Integer) query1.uniqueResult();

			queryStr += " order by lastname";
			Query query2 = session
					.createQuery("select distinct driver from Driver as driver "
							+ queryStr);
			keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query2.setParameter(parameter, parameters.get(parameter));
			}
			if (count != -1) {
				query2.setFirstResult(first);
				query2.setMaxResults(count);
			}
			Collection result = new LinkedList();
			List userColl = query2.list();
			Iterator iter = userColl.iterator();
			userColl = null;
			while (iter.hasNext()) {
				Driver driver = (Driver) iter.next();
				result.add(driver.getDriverReportData(type));
			}
			session.close();

			MemoryLog.getInstance().log(MemoryLog.END,
					"getDriversWithoutBpsRegistry", getClass());
			return new ListResult(result, total.intValue());
		} catch (Exception e) {
			Object[] parameters = { name, status, divOrgs, divGeos, first,
					count, type };
			handler.getException(e, "getDriversWithoutBpsRegistry",
					userSessionData, parameters);
		}
		return null;
	}

	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "resetpassword"
	 */
	public DriverData findDriverByEmail(String email,
			UserSessionData userSessionData) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "findDriverByEmail",
				getClass());
		Session session = null;
		DriverData data = null;
		if (email == null) {
			throw new InvalidDataException("findDriverByEmail", "email = null");
		}
		if (userSessionData == null) {
			throw new DeslogedException("findDriverByEmail",
					"userSessionData = null");
		}
		try {
			session = HibernateUtil.currentSession();
			Query query = session
					.createQuery("select driver from Driver as driver where lower(driver.email) = lower(:email) ");
			query.setParameter("email", email);
			Object result = query.uniqueResult();
			if (result != null) {
				Driver driver = (Driver) result;
				data = driver.getDriverData();
			}
		} catch (Exception e) {
			Object[] parameters = { email };
			handler.getException(e, "findDriverByEmail", userSessionData,
					parameters);
		}
		MemoryLog.getInstance().log(MemoryLog.END, "findDriverByEmail",
				getClass());
		return data;
	}

	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverview,administrator"
	 */
	public ListResult getDriverLicenseExpiry(String frommonth,
			Integer fromYear, String tomonth, Integer toYear,
			Integer[][] divOrgs, Integer[][] divGeos, String firstname,
			String lastname, String status, int first, int count,
			UserSessionData userSessionData) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "getDriverLicenseExpiry",
				getClass());
		try {
			Session session = HibernateUtil.currentSession();
			Hashtable parameters = new Hashtable();
			Collection result = new LinkedList();
			String queryStr = UtilityQuery.corporationDivisionsRestictions(
					"driver", userSessionData);
			if (firstname != null) {
				queryStr += " and lower(driver.firstName) like lower(:firstname)";
				parameters.put("firstname", "%" + firstname + "%");
			}
			if (lastname != null) {
				queryStr += " and lower(driver.lastName) like lower(:lastname)";
				parameters.put("lastname", "%" + lastname + "%");
			}

			queryStr += " and driver.licenseExpiry is not null ";

			if (status.equals("expiry")) {
				queryStr += " and driver.licenseExpiry < (:currentDate)";
				Calendar calendar = Calendar.getInstance();
				parameters.put("currentDate", calendar.getTime());
			} else if (status.equals("prevista")) {
				queryStr += " and driver.licenseExpiry >= (:currentDate)";
				Calendar calendar = Calendar.getInstance();
				parameters.put("currentDate", calendar.getTime());
			}

			if (!Util.empty(frommonth) && fromYear != null) {
				queryStr += " and driver.licenseExpiry >= (:date1)";
				Calendar calendar1 = Calendar.getInstance();
				calendar1.set(Calendar.DAY_OF_MONTH, 1);
				calendar1.set(Calendar.MONTH, Integer.parseInt(frommonth) - 1);
				calendar1.set(Calendar.YEAR, fromYear.intValue());
				calendar1.set(Calendar.HOUR_OF_DAY, 0);
				calendar1.set(Calendar.MINUTE, 0);
				calendar1.set(Calendar.SECOND,0);
				parameters.put("date1", calendar1.getTime());
			}

			if (!Util.empty(tomonth) && toYear != null) {
				queryStr += " and driver.licenseExpiry < (:date2)";
				Calendar calendar1 = Calendar.getInstance();
				calendar1.set(Calendar.DAY_OF_MONTH, 1);
				calendar1.set(Calendar.MONTH, Integer.parseInt(tomonth));
				calendar1.set(Calendar.YEAR, toYear.intValue());
				calendar1.set(Calendar.HOUR_OF_DAY, 0);
				calendar1.set(Calendar.MINUTE, 0);
				calendar1.set(Calendar.SECOND,0);
				parameters.put("date2", calendar1.getTime());
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = "";
						divOrgStr = " and driver.divOrg"
								+ String.valueOf(j + 1) + " in (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos

							// divOrgStr += divOrgs[j][i];
							// divOrgStr += (i == divOrgs[j].length-1) ? ") " :
							// ",";
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						// System.out.println(divOrgStr);
						queryStr += divOrgStr;
					}
				}
			}

			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					queryStr += "and driver.corpCountry.pk.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						queryStr += divGeos[0][i];
						queryStr += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
			}
			queryStr += " and driver.exclusionDate = null ";

			Query queryAux = session.createQuery("select count(*) "
					+ "from Driver as driver " + queryStr);

			Enumeration keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				queryAux.setParameter(parameter, parameters.get(parameter));
			}

			List activityColl = queryAux.list();
			Iterator iter = activityColl.iterator();
			Integer total = new Integer(0);
			while (iter.hasNext()) {
				total = new Integer(((Long) iter.next()).intValue());
			}

			Query query = session.createQuery("select distinct driver "
					+ " from Driver as driver " + queryStr
					+ " order by driver.firstName, driver.lastName ");

			keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query.setParameter(parameter, parameters.get(parameter));
			}

			if (count != -1) {
				if (total.intValue() < first) {
					if (total.intValue() % count == 0) {
						first = total.intValue() - count;
					} else {
						first = total.intValue() - (total.intValue() % count);
					}
				}
				query.setFirstResult(first);
				query.setMaxResults(count);
			}

			List userColl = query.list();
			iter = userColl.iterator();

			while (iter.hasNext()) {
				Driver driver = (Driver) iter.next();
				result.add(driver.getDriverData());
			}

			session.close();

			MemoryLog.getInstance().log(MemoryLog.END,
					"getDriverLicenseExpiry", getClass());
			return new ListResult(result, total.intValue());

		} catch (Exception e) {
			Object[] parameters = { frommonth, fromYear, tomonth, toYear,
					divOrgs, divGeos, firstname, lastname, status, first, count };
			handler.getException(e, "getDriverLicenseExpiry", userSessionData,
					parameters);
		}
		return null;
	}

