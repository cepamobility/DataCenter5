			frenadaBruscaHeader.add(CellXLS.getCell(messages.getText("driver.telematic.occurrences")));

			frenadaBrusca.add(frenadaBruscaHeader);


			Iterator iter=query.list().iterator();
			while(iter.hasNext()){
				TelematicControl telematicControl=(TelematicControl) iter.next();

				ListCellXLS xlsRow=new ListCellXLS();

				Query query2=session.createQuery("select d from DivOrgItemLevel1 as d where d.id="+telematicControl.getDriver().getDivOrg1().getId());

				DivOrgItemLevel1 divOrg=(DivOrgItemLevel1) query2.uniqueResult();
				xlsRow.addCell(telematicControl.getId().toString());
				xlsRow.addCell(divOrg.getDivOrgItemLevel2().getDivOrgItemLevel3().getResourceKey());

				xlsRow.addCell(divOrg.getDivOrgItemLevel2().getResourceKey());

				xlsRow.addCell(divOrg.getResourceKey());
				xlsRow.addCell(telematicControl.getDriver().getFirstName()+" "+telematicControl.getDriver().getLastName());
				xlsRow.addCell(telematicControl.getDriver().getExclusionDate()!=null?Util.formatDate(telematicControl.getDriver().getExclusionDate()):"Ativo");
				xlsRow.addCell(telematicControl.getVehicle()!=null?telematicControl.getVehicle().getMatricula():"");

				switch(telematicControl.getType()){
					case TelematicControlData.TYPE_EXCESSIVE_SPEED:
						xlsRow.addCell(telematicControl.getSpeed()!=null?telematicControl.getSpeed().toString():"");
						xlsRow.addCell("80 km/h");
						xlsRow.addCell(telematicControl.getDate()!=null?Util.formatDate(telematicControl.getDate()):"");
						xlsRow.addCell(TelematicControlData.getDPAPointLabel(telematicControl.getPoint()));
						xlsRow.addCell(telematicControl.getStatus());
						xlsRow.addCell(telematicControl.getStatusComment());
						xlsRow.addCell(telematicControl.getTime()!=null?telematicControl.getTime():"");
						xlsRow.addCell(telematicControl.getDuration()!=null?telematicControl.getDuration():"");
						xlsRow.addCell(telematicControl.getLimitExceededRain()!=null && telematicControl.getLimitExceededRain()==1?messages.getText("generic.messages.yes"):messages.getText("generic.messages.no"));
						xlsRow.addCell(telematicControl.getGarage()!=null?telematicControl.getGarage():"");
