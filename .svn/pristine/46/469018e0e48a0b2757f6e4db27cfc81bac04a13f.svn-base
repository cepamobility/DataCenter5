	/**
	 * @ejb.permission role-name ="administrator,driveredit,driverupdate,eventcreate,finecreate,driverviewowndata,drivertests,cepascheduleactivityregistrycreate,query"
	 * @ejb.interface-method
	 */
	public DriverMainAttributes findDriverForestalData(Integer id, int divorg, UserSessionData userRequest) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "findDriverForestalData", getClass());
		DriverMainAttributes attributes = null;

		if (id == null)
			return null;

		if (userRequest == null) {
			throw new DeslogedException("findDriverForestalData", "session is null");
		}
		try {
			String sql = "SELECT firstname,lastname,corporationid,div.resourcekey,exclusiondate FROM drivers d JOIN divorgitemlevel1s div ON div.id = d.divorg"+divorg+" WHERE d.id = " + String.valueOf(id);
			SQLQuery query = HibernateUtil.currentSession().createSQLQuery(sql);
			query.addScalar("firstname", Hibernate.STRING);
			query.addScalar("lastname", Hibernate.STRING);
			query.addScalar("corporationid", Hibernate.STRING);
			query.addScalar("resourcekey", Hibernate.STRING);
			query.addScalar("exclusiondate", Hibernate.DATE);
			Object[] result = (Object[]) query.uniqueResult();
			if (result != null) {
				attributes = new DriverMainAttributes(id);
				attributes.setFirstName((String) result[0]);
				attributes.setLastName((String) result[1]);
				attributes.setDivOrgItem2((String) result[2]);
				attributes.setDivOrgItem1((String) result[3]);
				attributes.setExclusionDate((Date) result[4]);
			}
		} catch (Exception e) {
			Object[] parameters = { id };
			handler.getException(e, "findDriverForestalData", userRequest, parameters);
		}
		MemoryLog.getInstance().log(MemoryLog.END, "findDriverForestalData", getClass());
		return attributes;
	}

	/**
	 * @ejb.permission role-name ="administrator,driveredit,driverupdate,eventcreate,finecreate,driverviewowndata,drivertests,cepascheduleactivityregistrycreate,query"
	 * @ejb.interface-method
	 */
	public String getDriverTransporterKey(Integer id, UserSessionData userSessionData) throws Exception {
		String str = "";
		if (id == null)
			return null;

		if (userSessionData == null) {
			throw new DeslogedException("getDriverTransporterKey", "session is null");
		}
		try {
			String sql = "SELECT d1.divorg1 AS fosa,d2.divorg3 AS wy,d3.divorg1 AS mdp FROM driverlinks dl " +
					"left join drivers d1 on dl.fosa = d1.id " +
					"left join drivers d2 on dl.weyerhauser = d2.id " +
					"left join drivers d3 on dl.mdp = d3.id WHERE dl.id = " + String.valueOf(id);
			SQLQuery query = HibernateUtil.currentSession().createSQLQuery(sql);
			query.addScalar("fosa", Hibernate.INTEGER);
			query.addScalar("wy", Hibernate.INTEGER);
			query.addScalar("mdp", Hibernate.INTEGER);
			Object[] result = (Object[]) query.uniqueResult();
			if (result != null) {
				str += (result[0] == null) ? "-;" : String.valueOf(result[0]) + ";";
				str += (result[1] == null) ? "-;" : String.valueOf(result[1]) + ";";
				str += (result[2] == null) ? "-" : String.valueOf(result[2]);
			}
		} catch (Exception e) {
			Object[] parameters = { id };
			handler.getException(e, "getDriverTransporterKey", userSessionData, parameters);
		}
		return str;
	}

	/**
	 * @ejb.permission role-name ="administrator,driverview"
	 * @ejb.interface-method
	 */
	public List getAllDriverCorporation(UserSessionData userSessionData) throws Exception {
		try {
			String[] s = userSessionData.getFilter().getFields("d");
			String sql = "SELECT d.id, d.firstname, d.lastname, c.resourcekey AS country"+s[0]+" FROM drivers d, country c " + s[1]+
					" WHERE temporal = 'f' AND exclusiondate IS NULL AND corporation = "+userSessionData.getCorporationId()+" AND c.id = d.country"+s[2]+
					" ORDER BY firstname,lastname";
			SQLQuery query = HibernateUtil.currentSession().createSQLQuery(sql);
			query.addScalar("id",Hibernate.INTEGER);
			query.addScalar("firstname",Hibernate.STRING);
			query.addScalar("lastname",Hibernate.STRING);
			query.addScalar("firstname",Hibernate.STRING);
			query.addScalar("country",Hibernate.STRING);
			StringTokenizer token = new StringTokenizer(s[3], ",");
			while (token.hasMoreTokens()) {
				query.addScalar(token.nextToken(), Hibernate.STRING);
			}
			return query.list();
		} catch (Exception e) {
			handler.getException(e, "getAllDriverCorporation", userSessionData, null);
		}
		return new LinkedList();
	}


	/**
	 * @throws Exception
	 * @ejb.permission role-name ="administrator,query"
	 * @ejb.interface-method
	 */
	public Collection getDriverInsertedLog(String firstName, String lastName, Date from, Date to, Integer[][] divOrgs, Integer[][] divGeos, int status, UserSessionData userSessionData) throws Exception {
		try{
			String[] s = userSessionData.getFilter().getFields("d");
			String sql = "SELECT d.id, d.firstname, d.lastname, d.director, dl.date,dl.userid, c.resourcekey AS country"+s[0]+" FROM drivers d, country c, driverlog dl " + s[1];
			sql += UtilityQuery.corporationRestrictionsSQL(divOrgs, divGeos[0], "d", userSessionData) + " AND d.country = c.id AND dl.driver = d.id AND dl.action = "+LogActions.CREATE + s[2];
			if(!Util.empty(firstName))
				sql += " AND LOWER(d.firstname) like '%"+firstName.toLowerCase()+"%'";
			if(!Util.empty(firstName))
				sql += " AND LOWER(d.lastname) like '%"+lastName.toLowerCase()+"%'";
			if(from != null)
				sql += " AND date_trunc('day', dl.date) >= "+Util.formatSQL(from,0);
			if(to != null)
				sql += " AND date_trunc('day', dl.date) < "+Util.formatSQL(to,1);
			switch(status) {
				case DriverData.ACTIVE:
					sql += " AND d.exclusiondate IS NULL ";
					break;
				case DriverData.EXCLUDED:
					sql += " AND d.exclusiondate IS NOT NULL ";
					break;
			}
			sql += " ORDER BY date";
			SQLQuery query = HibernateUtil.currentSession().createSQLQuery(sql);
			query.addScalar("id", Hibernate.INTEGER);
			query.addScalar("firstname", Hibernate.STRING);
			query.addScalar("lastname", Hibernate.STRING);
			query.addScalar("director", Hibernate.BOOLEAN);
			query.addScalar("date", Hibernate.DATE);
			query.addScalar("userid", Hibernate.STRING);
			query.addScalar("country", Hibernate.STRING);
			StringTokenizer token = new StringTokenizer(s[3], ",");
			while (token.hasMoreTokens()) {
				query.addScalar(token.nextToken(), Hibernate.STRING);
			}
			return query.list();
        } catch(Exception e){
        	Object[] p = {firstName,lastName,from,to,divOrgs,divGeos,status};
            handler.getException(e,"getDriverInsertedLog",userSessionData,null);
        }
		return null;
	}

	/**
	 * @throws Exception
	 * @ejb.permission role-name ="administrator,query"
	 * @ejb.interface-method
	 */
	public Collection<DetailedDriverReportDataType> getClosedDrivers(Integer period, Integer year, int status, Integer country, UserSessionData userSessionData) throws Exception {
		Collection<DetailedDriverReportDataType> listResult = new LinkedList<DetailedDriverReportDataType>();
		Session session = HibernateUtil.currentSession();
		Query q = session.createQuery("SELECT d FROM ClosedDriver d WHERE d.corporation = "+userSessionData.getCorporationId());
		List list = q.list();
		if(list != null) {
			Iterator it = list.iterator();
			while(it.hasNext())
				listResult.add(((ClosedDriver)it.next()).getData());

		}
		return listResult;
	}

	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,query"
	 */
	public ListResult getPointHistory(String firstname, String lastname, int status, Integer[][] divOrgs, Integer[][] divGeos, int first, int count, String operation, UserSessionData userSessionData) throws Exception {

		Integer total = new Integer(0);
		Collection<HistoryPointDataType> result = new LinkedList<HistoryPointDataType>();
		String table = null;

		try {

			switch (userSessionData.getFilter().getCorporationId()) {
				case CorporationData.JJ:
					table = "historyDriversJJ";
					break;
				case CorporationData.BAYER:case CorporationData.NALCO:case CorporationData.SYNGENTA: case CorporationData.DOW: case CorporationData.BAYER_MX:
				case CorporationData.ECOLAB:
					table = "driverHistory";
					break;
				default:
					table = "historyDriversMon";
			}

			Session session = HibernateUtil.currentSession();

			String restrictions = "";
			if (!Util.empty(firstname)) {
				restrictions += " and LOWER(d.firstname) like '%"
						+ firstname.toLowerCase() + "%' ";
			}

			if (!Util.empty(lastname)) {
				restrictions += " and LOWER(d.lastname) like '%"
						+ lastname.toLowerCase() + "%' ";
			}

			switch (status) {
			case DriverData.ACTIVE:
				restrictions += " and d.exclusionDate is null ";
				break;
			case DriverData.EXCLUDED:
				restrictions += " and d.exclusionDate is not null ";
				break;
			}

			String corpRestrictions = UtilityQuery.corporationRestrictionsSQL( divOrgs, divGeos[0], "d", userSessionData);
			String endSQL =  "FROM drivers d " +
					"JOIN pointaccount p ON p.reference = d.id "+
					"JOIN " + table + " dh ON dh.driver = d.id "
					+ corpRestrictions + " " + restrictions
					+ " AND p.type = 1";
			if(operation != null) {
				endSQL += " AND p.total " + operation;
			}

			String sqlQueryTotal = "SELECT COUNT(*) as total "+endSQL;
			Query queryTotal = session.createSQLQuery(sqlQueryTotal).addScalar("total", Hibernate.INTEGER);
			total = (Integer) queryTotal.uniqueResult();

			String ids = "";
			if (total > 0) {
				String sqlQueryId = "SELECT d.id as id " + endSQL + " order by firstname,lastname";
				Query queryId = session.createSQLQuery(sqlQueryId).addScalar("id", Hibernate.INTEGER);
				if (count != -1) {
					queryId.setFirstResult(first);
					queryId.setMaxResults(count);
				}
				Iterator it = queryId.list().iterator();
				while (it.hasNext()) {
					ids += String.valueOf(it.next()) + ",";
				}
			}

			if (!(count != -1 && ids.length() == 0)) {
				String[] s = userSessionData.getFilter().getFields("d");
				String sqlQueryData = "SELECT d.id,d.firstname,d.lastname,d.birthdate,d.exclusiondate,d.contract,d.corporationid, "
						+ " dh.date, dh.type, dh.clasification, dh.result,c.resourcekey as country,dh.id as reference,p.total as points"
						+ s[0]
						+ " FROM drivers d,country c,pointaccount p, "
						+ table + " dh"
						+ s[1]
						+ " "
						+ corpRestrictions
						+ " AND d.id = dh.driver"
						+ s[2]
						+ " AND d.id = p.reference "
						+ " AND p.type = 1"
						+ " AND d.country = c.id ";
				sqlQueryData += " AND d.id IN (0," + ids.substring(0, ids.length() - 1) + ") ";
				sqlQueryData += " ORDER BY d.firstname, d.lastname, date, type ";
				SQLQuery queryData = session.createSQLQuery(sqlQueryData);
				queryData.addScalar("id", Hibernate.INTEGER);
				queryData.addScalar("firstname", Hibernate.STRING);
				queryData.addScalar("lastname", Hibernate.STRING);
				queryData.addScalar("birthdate", Hibernate.DATE);
				queryData.addScalar("exclusiondate", Hibernate.DATE);
				queryData.addScalar("contract", Hibernate.STRING);
				queryData.addScalar("corporationid", Hibernate.STRING);
				queryData.addScalar("date", Hibernate.DATE);
				queryData.addScalar("type", Hibernate.STRING);
				queryData.addScalar("clasification", Hibernate.STRING);
				queryData.addScalar("result", Hibernate.STRING);
				queryData.addScalar("country", Hibernate.STRING);
				queryData.addScalar("reference", Hibernate.INTEGER);
				queryData.addScalar("points", Hibernate.DOUBLE);
				StringTokenizer token = new StringTokenizer(s[3], ",");
				while (token.hasMoreTokens()) {
					queryData.addScalar(token.nextToken(), Hibernate.STRING);
				}

				Iterator values = queryData.list().iterator();
				HashMap<String,HistoryPointDataType> mapHistory = new HashMap<String, HistoryPointDataType>();
				HashMap<Integer,Object[]> drivers = new HashMap<Integer,Object[]>();
				while (values.hasNext()) {
					Object[] data = (Object[]) values.next();
					if(!drivers.containsKey(data[0])) {
						drivers.put((Integer)data[0], data);
					}
					HistoryPointDataType history = new HistoryPointDataType(data);
					String key = history.getKey();
					if(!mapHistory.containsKey(key)) {
						mapHistory.put(key, history);
					}
				}

				String sqlMoves = "SELECT pa.reference AS driver, pm.reference AS ref, pm.amount, pd.id as definition, pd.category, pd.type " +
						"FROM pointmoves pm " +
						"JOIN pointaccount pa ON pa.id = pm.account	" +
						"JOIN pointsdefinitions pd ON pd.id = pm.definition	" +
						"WHERE pa.type = 1 AND pa.reference IN (0," + ids.substring(0, ids.length() - 1) + ")";
				SQLQuery queryMoves = session.createSQLQuery(sqlMoves);
				queryMoves.addScalar("driver", Hibernate.INTEGER);
				queryMoves.addScalar("ref", Hibernate.STRING);
				queryMoves.addScalar("amount", Hibernate.DOUBLE);
				queryMoves.addScalar("definition", Hibernate.INTEGER);
				queryMoves.addScalar("category", Hibernate.INTEGER);
				queryMoves.addScalar("type", Hibernate.STRING);
				values = queryMoves.list().iterator();
				while (values.hasNext()) {
					Object[] data = (Object[]) values.next();
					String key = data[0] + "-" + data[1];
					Double amount = (Double) data[2];
					Integer definition = (Integer) data[3];
					Integer category = (Integer) data[4];
					String description = (String) data[5];
					if(category == 0 || category == 4) {
						HistoryPointDataType history = new HistoryPointDataType(drivers.get(data[0]),amount,definition,category,description, userSessionData.getCorporationId());
						mapHistory.put(key, history);
					}else {
						if(mapHistory.containsKey(key)) {
							mapHistory.get(key).setPoints(amount);
							mapHistory.get(key).setDefinition(definition);
						}
					}
				}
				result.addAll(mapHistory.values());
			}
		} catch (Exception e) {
			Object[] parameters = { firstname, lastname, status, divOrgs, divGeos, first, count };
			handler.getException(e, "getHistoryDrivers", userSessionData, parameters);
		}
		return new ListResult(result, total);
	}

	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,query"
	 */
	public ListResult getPointHistory(Integer period, Integer year, String firstname, String lastname, int status, Integer[][] divOrgs, Integer[][] divGeos, int first, int count, String operation, UserSessionData userSessionData) throws Exception {

		Integer total = new Integer(0);
		Collection<HistoryPointDataType> result = new LinkedList<HistoryPointDataType>();
		String table = null;

		try {

			switch (userSessionData.getFilter().getCorporationId()) {
				case CorporationData.JJ:
					table = "historyDriversJJ";
					break;
				case CorporationData.BAYER:case CorporationData.NALCO:case CorporationData.SYNGENTA: case CorporationData.DOW: case CorporationData.BAYER_MX:
				case CorporationData.ECOLAB:
					table = "driverHistory";
					break;
				default:
					table = "historyDriversMon";
			}

			Session session = HibernateUtil.currentSession();

			String restrictions = "";
			if (!Util.empty(firstname)) {
				restrictions += " and LOWER(d.firstname) like '%"
						+ firstname.toLowerCase() + "%' ";
			}

			if (!Util.empty(lastname)) {
				restrictions += " and LOWER(d.lastname) like '%"
						+ lastname.toLowerCase() + "%' ";
			}

			switch (status) {
			case DriverData.ACTIVE:
				restrictions += " and d.exclusionDate is null ";
				break;
			case DriverData.EXCLUDED:
				restrictions += " and d.exclusionDate is not null ";
				break;
			}

			String corpRestrictions = UtilityQuery.corporationRestrictionsSQL( divOrgs, divGeos[0], "d", userSessionData);
			String endSQL =  "FROM drivers d " +
					"JOIN driverpointhistory p ON p.id = d.id "+
					 corpRestrictions + " " + restrictions
					+ " AND p.period = "+period+" AND p.year = "+year ;
			if(operation != null) {
				endSQL += " AND p.total " + operation;
			}

			String sqlQueryTotal = "SELECT COUNT(*) as total "+endSQL;
			Query queryTotal = session.createSQLQuery(sqlQueryTotal).addScalar("total", Hibernate.INTEGER);
			total = (Integer) queryTotal.uniqueResult();

			String ids = "";
			if (total > 0) {
				String sqlQueryId = "SELECT DISTINCT d.id, d.firstname,d.lastname " + endSQL + " order by firstname,lastname";
				Query queryId = session.createSQLQuery(sqlQueryId).addScalar("id", Hibernate.INTEGER).addScalar("firstname", Hibernate.STRING).addScalar("lastname", Hibernate.STRING);
				if (count != -1) {
					queryId.setFirstResult(first);
					queryId.setMaxResults(count);
				}
				Iterator it = queryId.list().iterator();
				while (it.hasNext()) {
					Object[] data = (Object[])it.next();
					ids += String.valueOf(data[0]) + ",";
				}
			}

			if (!(count != -1 && ids.length() == 0)) {
				String[] s = userSessionData.getFilter().getFields("d");
				String sqlQueryData = "SELECT d.id,d.firstname,d.lastname,d.birthdate,d.exclusiondate,d.contract,d.corporationid, "
						+ " dh.date, dh.type, dh.clasification, dh.result,c.resourcekey as country,dh.id as reference,p.total as points"
						+ s[0]
						+ " FROM drivers d JOIN country c on d.country = c.id JOIN driverpointhistory p ON p.id = d.id "
						+ "LEFT OUTER JOIN " + table + " dh ON dh.driver = d.id"
						+ s[1]
						+ " "
						+ corpRestrictions
						+ s[2]
						+ " AND p.period = "+period+" AND p.year = "+year;
				sqlQueryData += " AND d.id IN (0," + ids.substring(0, ids.length() - 1) + ") ";
				sqlQueryData += " ORDER BY d.firstname, d.lastname, date, type ";
				SQLQuery queryData = session.createSQLQuery(sqlQueryData);
				queryData.addScalar("id", Hibernate.INTEGER);
				queryData.addScalar("firstname", Hibernate.STRING);
				queryData.addScalar("lastname", Hibernate.STRING);
				queryData.addScalar("birthdate", Hibernate.DATE);
				queryData.addScalar("exclusiondate", Hibernate.DATE);
				queryData.addScalar("contract", Hibernate.STRING);
				queryData.addScalar("corporationid", Hibernate.STRING);
				queryData.addScalar("date", Hibernate.DATE);
				queryData.addScalar("type", Hibernate.STRING);
				queryData.addScalar("clasification", Hibernate.STRING);
				queryData.addScalar("result", Hibernate.STRING);
				queryData.addScalar("country", Hibernate.STRING);
				queryData.addScalar("reference", Hibernate.INTEGER);
				queryData.addScalar("points", Hibernate.DOUBLE);
				StringTokenizer token = new StringTokenizer(s[3], ",");
				while (token.hasMoreTokens()) {
					queryData.addScalar(token.nextToken(), Hibernate.STRING);
				}

				Iterator values = queryData.list().iterator();
				HashMap<String,HistoryPointDataType> mapHistory = new HashMap<String, HistoryPointDataType>();
				HashMap<Integer,Object[]> drivers = new HashMap<Integer,Object[]>();
				while (values.hasNext()) {
					Object[] data = (Object[]) values.next();
					if(!drivers.containsKey(data[0])) {
						drivers.put((Integer)data[0], data);
					}
					HistoryPointDataType history = new HistoryPointDataType(data);
					String key = history.getKey();
					if(!mapHistory.containsKey(key)) {
						mapHistory.put(key, history);
					}
				}

				String sqlMoves = "SELECT pm.id AS driver, pm.movereference AS ref, pm.amount, pd.id as definition, pd.category, pd.type " +
						"FROM driverpointmovehistory pm " +
						"JOIN pointsdefinitions pd ON pd.id = pm.definition	" +
						"WHERE pm.period = "+period+" AND pm.year = "+year+" AND pm.id IN (0," + ids.substring(0, ids.length() - 1) + ")";
				SQLQuery queryMoves = session.createSQLQuery(sqlMoves);
				queryMoves.addScalar("driver", Hibernate.INTEGER);
				queryMoves.addScalar("ref", Hibernate.STRING);
				queryMoves.addScalar("amount", Hibernate.DOUBLE);
				queryMoves.addScalar("definition", Hibernate.INTEGER);
				queryMoves.addScalar("category", Hibernate.INTEGER);
				queryMoves.addScalar("type", Hibernate.STRING);
				values = queryMoves.list().iterator();
				while (values.hasNext()) {
					Object[] data = (Object[]) values.next();
					String key = data[0] + "-" + data[1];
					Double amount = (Double) data[2];
					Integer definition = (Integer) data[3];
					Integer category = (Integer) data[4];
					String description = (String) data[5];
					if(category == 0 || category == 4) {
						if(drivers.containsKey(data[0])) {
							HistoryPointDataType history = new HistoryPointDataType(drivers.get(data[0]),amount,definition,category,description, userSessionData.getCorporationId());
							mapHistory.put(key, history);
						}
					}else {
						if(mapHistory.containsKey(key)) {
							mapHistory.get(key).setPoints(amount);
							mapHistory.get(key).setDefinition(definition);
						}
					}
				}
				result.addAll(mapHistory.values());
			}
		} catch (Exception e) {
			e.printStackTrace();
			Object[] parameters = { firstname, lastname, status, divOrgs, divGeos, first, count };
			handler.getException(e, "getHistoryDrivers", userSessionData, parameters);
		}
		return new ListResult(result, total);
	}

	/**
	 * @ejb.permission role-name ="administrator,query"
	 * @ejb.interface-method
	 */
	public Collection<DriverMainAttributes> findDriversByDivisions(Integer[][] divOrgs, Integer[] divGeos, UserSessionData userSessionData) throws Exception {
		return findDriversByDivisions(divOrgs,divGeos,DriverData.ALL,userSessionData);
	}

	/**
	 * @ejb.permission role-name ="administrator,query"
	 * @ejb.interface-method
	 */
	public Collection<DriverMainAttributes> findDriversByDivisions(Integer[][] divOrgs, Integer[] divGeos, int status, UserSessionData userSessionData) throws Exception {
		Collection<DriverMainAttributes> attributes = new LinkedList<DriverMainAttributes>();
		if (userSessionData == null) {
			throw new DeslogedException("findDriversByDivisions", "session is null");
		}
		try {
			String sql = "SELECT id,firstname,lastname FROM drivers d "+UtilityQuery.filterDivs(divOrgs, divGeos, "d", userSessionData);
			if(status == DriverData.ACTIVE) {
				sql += " AND exclusiondate IS NULL";
			} else if(status == DriverData.EXCLUDED) {
				sql += " AND exclusiondate IS NOT NULL";
			}
			SQLQuery query = HibernateUtil.currentSession().createSQLQuery(sql);
			query.addScalar("id", Hibernate.INTEGER);
			query.addScalar("firstname", Hibernate.STRING);
			query.addScalar("lastname", Hibernate.STRING);
			Iterator it  = query.list().iterator();
			while (it.hasNext()) {
				Object[] result = (Object[]) it.next();
				DriverMainAttributes attribute = new DriverMainAttributes((Integer) result[0]);
				attribute.setFirstName((String) result[1]);
				attribute.setLastName((String) result[2]);
				attributes.add(attribute);
			}
		} catch (Exception e) {
			Object[] parameters = {divOrgs,divGeos};
			handler.getException(e, "findDriversByDivisions", userSessionData, parameters);
		}
		return attributes;
	}

	/**
	 * @throws Exception
	 * @ejb.permission role-name ="administrator,query"
	 * @ejb.interface-method
	 */
	public Collection getEcolabSpeeds(Integer year, Integer dpto, Integer distrit, UserSessionData userSessionData) throws Exception {
		try {
			String sql = "SELECT d.id, EXTRACT(month FROM date) AS month, COUNT(*) AS c " +
					"FROM telematiccontrols tc " +
					"JOIN drivers d ON d.id = tc.driver " +
					"WHERE d.corporation = "+userSessionData.getCorporationId()+
/*Cambio ecolab dic*/					" AND date >= '"+String.valueOf(year-1)+"-12-01' AND date < '"+String.valueOf(year)+"-12-01'";
/*Cambio ecolab ene					" AND date >= '"+String.valueOf(year)+"-01-01' AND date < '"+String.valueOf(year+1)+"-01-01'"+*/
			if(dpto != null)
				sql += " AND d.divorg1 = "+dpto;
			if(distrit != null)
				sql += " AND d.divorg2 = "+distrit;
			sql += " AND tc.type = "+TelematicControlData.TYPE_EXCESSIVE_SPEED+
					" GROUP BY d.id, month";
			SQLQuery query = HibernateUtil.currentSession().createSQLQuery(sql);
			query.addScalar("id", Hibernate.INTEGER);
			query.addScalar("month", Hibernate.INTEGER);
			query.addScalar("c", Hibernate.INTEGER);
			return query.list();
		} catch (Exception e) {
			Object[] p = {year,dpto};
			handler.getException(e, "getEcolabSpeeds", userSessionData, null);
		}
		return null;

	}

	/**
	 * @throws Exception
	 * @ejb.permission role-name ="administrator,driverview"
	 * @ejb.interface-method
	 */
	public Integer[][] getDriverPointHistory(Integer driver, UserSessionData userSessionData) throws Exception {
		try {
			SQLQuery query = HibernateUtil.currentSession().createSQLQuery("SELECT period, year, total, level FROM driverpointhistory WHERE id = "+driver+" ORDER BY year DESC, period DESC");
			query.addScalar("period", Hibernate.INTEGER);
			query.addScalar("year", Hibernate.INTEGER);
			query.addScalar("total", Hibernate.DOUBLE);
			query.addScalar("level", Hibernate.INTEGER);
			List list = query.list();
			Integer[][] values = new Integer[list.size()][4];
			int index = 0;
			Iterator it = list.iterator();
			while(it.hasNext()) {
				Object[] data = (Object[]) it.next();
				for(int i = 0; i < data.length; i++)
					values[index][i] = (i == 2) ? ((Double)data[i]).intValue() : (Integer)data[i];
				index++;
			}
			return values;
		} catch (Exception e) {
			Object[] p = {driver};
			handler.getException(e, "getDriverPointHistory", userSessionData, null);
		}
		return null;
	}

	  /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "query,administration"
     */
	public void driverRiskAdvanceToXLS(Calendar from, Calendar to, Integer[][] divOrgs, Integer[][] divGeos, String firstName,String lastName, int status, Text messages, UserSessionData userSessionData, OutputStream output) throws Exception {

		try {
	        Session session = HibernateUtil.currentSession();

	        int fromMonth = from.get(Calendar.MONTH)+1;
	        int fromYear = from.get(Calendar.YEAR);

	        int toMonth = to.get(Calendar.MONTH)+1;
	        int toYear = to.get(Calendar.YEAR);

	        Hashtable<Integer, DriverPointHistoryData> values = new Hashtable<Integer, DriverPointHistoryData>();

	        Hashtable<String,Integer> index = new Hashtable<String,Integer>();


	        ArrayList<Object> header=new ArrayList<Object>();
	        header.add(messages.getText("generic.driver.driverdata.corporationid"));
	        header.add(messages.getText("generic.driver.driverdata.firstname"));
	        header.add(messages.getText("generic.driver.driverdata.lastname"));
	        int indexValue = 0;
	        while(fromYear < toYear || (fromYear == toYear && fromMonth <= toMonth)){
		        header.add(messages.getText("generic.shortmonth."+fromMonth)+"/"+fromYear);
	        	index.put(fromMonth+"-"+fromYear, new Integer(indexValue));
	        	fromMonth++;
	        	if(fromMonth == 13) {
	        		fromMonth = 1;
	        		fromYear++;
	        	}
	        	indexValue++;
	        }

	        String sql = "SELECT d.id, d.corporationid, d.firstname, d.lastname, dph.period, dph.year, dph.total, dph.level " +
	        		"FROM drivers d " +
	        		"JOIN driverpointhistory dph ON dph.id = d.id " +
	        		UtilityQuery.corporationRestrictionsSQL(divOrgs, divGeos[0], "d", userSessionData);
	        if(!Util.empty(firstName)) {
	        	sql += " AND LOWER(TRIM(d.firstname)) LIKE '%"+firstName.toLowerCase()+"%'";
	        }
	        if(!Util.empty(lastName)) {
	        	sql += " AND LOWER(TRIM(d.lastname)) LIKE '%"+lastName.toLowerCase()+"%'";
	        }
			switch (status) {
				case DriverData.ACTIVE:
					sql += " and d.exclusionDate is null";
					break;
				case DriverData.EXCLUDED:
					sql += " and d.exclusionDate is not null";
					break;
			}
			sql += " AND ((dph.year > "+from.get(Calendar.YEAR)+") OR (dph.year = "+from.get(Calendar.YEAR)+" AND dph.period >= "+String.valueOf(from.get(Calendar.MONTH)+1)+")) ";
			sql += " AND ((dph.year < "+to.get(Calendar.YEAR)+") OR (dph.year = "+to.get(Calendar.YEAR)+" AND dph.period <= "+String.valueOf(to.get(Calendar.MONTH)+1)+")) ";

	        SQLQuery query= session.createSQLQuery(sql);
	        query.addScalar("id",Hibernate.INTEGER);
	        query.addScalar("corporationid",Hibernate.STRING);
	        query.addScalar("firstname",Hibernate.STRING);
	        query.addScalar("lastname",Hibernate.STRING);
	        query.addScalar("period",Hibernate.INTEGER);
	        query.addScalar("year",Hibernate.INTEGER);
	        query.addScalar("total",Hibernate.DOUBLE);
	        query.addScalar("level",Hibernate.INTEGER);


	        Iterator iter= query.list().iterator();
	        while(iter.hasNext()) {
	        	Object[] data = (Object[]) iter.next();
	        	if(values.containsKey(data[0])) {
	        		values.get(data[0]).addValue(data, index);
	        	}else {
	        		values.put((Integer)data[0],new DriverPointHistoryData(data, index));
	        	}
	        }
	        ArrayList<ArrayList<Object>> page=new ArrayList<ArrayList<Object>>();
	        page.add(header);

	        Enumeration<DriverPointHistoryData> points = values.elements();
	        while(points.hasMoreElements()){
	        	page.add(points.nextElement().getLine());
	        }

	        ExcelGenerator.generatorObjectXLS(page, "Risk Advance", output);

		} catch (Exception e) {
			Object[] p = {};
			handler.getException(e, "dpaExportCheckListToXLS", userSessionData, p);
		}

	}

