            query.addScalar("divV6", Hibernate.STRING);
            query.addScalar("divV7", Hibernate.STRING);
            query.addScalar("divV8", Hibernate.STRING);
            query.addScalar("divV9", Hibernate.STRING);
            query.addScalar("permissionexpiry", Hibernate.DATE);
            query.addScalar("chasisnumber", Hibernate.STRING);
            query.addScalar("engine", Hibernate.STRING);
            query.addScalar("firstname", Hibernate.STRING);
            query.addScalar("lastname", Hibernate.STRING);
            query.addScalar("divD1", Hibernate.STRING);
            query.addScalar("divD2", Hibernate.STRING);
            query.addScalar("divD3", Hibernate.STRING);
            query.addScalar("divD4", Hibernate.STRING);
            query.addScalar("divD5", Hibernate.STRING);
            query.addScalar("divD6", Hibernate.STRING);
            query.addScalar("divD7", Hibernate.STRING);
            query.addScalar("divD8", Hibernate.STRING);
            query.addScalar("divD9", Hibernate.STRING);
            query.addScalar("birthdate", Hibernate.DATE);
            query.addScalar("sex", Hibernate.STRING);
            query.addScalar("city", Hibernate.STRING);
            query.addScalar("licenseexpiry", Hibernate.DATE);
            query.addScalar("officeaddress", Hibernate.STRING);
            query.addScalar("email", Hibernate.STRING);
            query.addScalar("personaladdress", Hibernate.STRING);
            query.addScalar("corporationid", Hibernate.STRING);
            query.addScalar("licensenumber", Hibernate.STRING);
            query.addScalar("inclusiondate", Hibernate.DATE);
            query.addScalar("employee", Hibernate.BOOLEAN);
            query.addScalar("licensenotexpiry", Hibernate.STRING);
            query.addScalar("superviser", Hibernate.STRING);
            query.addScalar("manager", Hibernate.STRING);
            query.addScalar("idDallas", Hibernate.STRING);

        	ArrayList<Object> header = new ArrayList<Object>();
        	header.add(messages.getText("generic.vehicle.vehicledata.registrationNumber"));
        	header.add(messages.getText("generic.vehicle.vehicledata.trade"));
        	header.add(messages.getText("generic.vehicle.vehicledata.model"));
        	header.add(messages.getText("generic.vehicle.vehicledata.year"));
        	for(int i = 0; i < 6; i++)
        		header.add(messages.getText("divorg.bayer_mx.org_"+i));
        	header.add(messages.getText("divorg.bayer_mx.champion"));
        	header.add(messages.getText("divorg.bayer_mx.monitor"));
        	header.add(messages.getText("divorg.bayer_mx.manager"));
        	header.add(messages.getText("generic.vehicle.vehicledata.permissionExpiryDate"));
        	header.add(messages.getText("generic.vehicle.vehicledata.chasisNumber"));
        	header.add(messages.getText("generic.vehicle.vehicledata.engine"));
        	header.add(messages.getText("generic.driver.driverdata.firstname"));
        	header.add(messages.getText("generic.driver.driverdata.lastname"));
        	for(int i = 0; i < 6; i++)
        		header.add(messages.getText("divorg.bayer_mx.org_"+i));
        	header.add(messages.getText("divorg.bayer_mx.champion"));
        	header.add(messages.getText("divorg.bayer_mx.monitor"));
        	header.add(messages.getText("divorg.bayer_mx.manager"));
        	header.add(messages.getText("generic.driver.driverdata.birthdate"));
        	header.add(messages.getText("generic.driver.driverdata.sex"));
        	header.add(messages.getText("generic.driver.driverdata.city"));
        	header.add(messages.getText("generic.driver.driverdata.licenseexpiry"));
        	header.add(messages.getText("generic.driver.driverdata.officeaddress"));
        	header.add(messages.getText("generic.driver.driverdata.email"));
        	header.add(messages.getText("generic.driver.driverdata.personaladdress"));
        	header.add(messages.getText("generic.driver.driverdata.corporationid"));
        	header.add(messages.getText("generic.driver.driverdata.licensenumber"));
        	header.add(messages.getText("generic.driver.driverdata.startdate"));
        	header.add(messages.getText("generic.driver.driverdata.employee"));
        	header.add(messages.getText("generic.driver.driverdata.licensenotexpiry"));
        	header.add(messages.getText("generic.driver.driverdata.superviser"));
        	header.add(messages.getText("generic.driver.driverdata.manager"));
        	header.add(messages.getText("generic.driver.driverdata.iddallas"));
    		sheet.add(header);

            List list = query.list();
            Iterator it = list.iterator();
			boolean insert = false;
			while(it.hasNext()) {
            	ArrayList<Object> line = new ArrayList<Object>();
            	Object[] data = (Object[])it.next();
            	for(int i = 0; i < 42; i++) {
            		switch(i) {
            			case 3:
            				if(data[i] == null) {
            					insert = true;
            	        		Object[] dataValues = new Object[3];
            	        		dataValues[0] = "";
        	        			dataValues[1] = new Short(new HSSFColor.RED().getIndex());
        	        			dataValues[2] = new Short(new HSSFColor.WHITE().getIndex());
            	        		line.add(dataValues);
            				}else {
            					line.add(String.valueOf(data[i]));
            				}
            				break;
            			case 13: case 27: case 30: case 36:
            				if(data[i] == null) {
            					insert = true;
            	        		Object[] dataValues = new Object[3];
            	        		dataValues[0] = "";
        	        			dataValues[1] = new Short(new HSSFColor.RED().getIndex());
        	        			dataValues[2] = new Short(new HSSFColor.WHITE().getIndex());
            	        		line.add(dataValues);
            				}else {
            					line.add(Util.formatDate((Date)data[i]));
            				}
            				break;
            			case 37:
            				if(data[i] == null) {
            					insert = true;
            	        		Object[] dataValues = new Object[3];
            	        		dataValues[0] = "";
        	        			dataValues[1] = new Short(new HSSFColor.RED().getIndex());
        	        			dataValues[2] = new Short(new HSSFColor.WHITE().getIndex());
            	        		line.add(dataValues);
            				}else {
            					if(((Boolean)data[i]).booleanValue()) {
	            					line.add(messages.getText("generic.messages.yes"));
	            				}else {
	            					line.add(messages.getText("generic.messages.no"));
	            				}
        					}
            				break;
            			default:
            				String value = (String)data[i];
            				if(Util.empty(value)) {
            					insert = true;
            	        		Object[] dataValues = new Object[3];
            	        		dataValues[0] = "";
        	        			dataValues[1] = new Short(new HSSFColor.RED().getIndex());
        	        			dataValues[2] = new Short(new HSSFColor.WHITE().getIndex());
            	        		line.add(dataValues);
            				}else {
            					if(i == 28)
            						line.add(messages.getText(value));
            					else
            						line.add(value);
            				}
            				break;
            		}
            	}
            	if(insert)
            		sheet.add(line);
            }
    	} catch (Exception e) {
            Object[] p = {};
            handler.getException(e, "emptyFields", userSessionData, p);
        }
		return sheet;
    }

   /**
    * @ejb.permission role-name ="administrator,query"
    * @ejb.interface-method
    */
  	public Collection<Object[]> getPendingActivities(String[] mitigation, String[] anual, int status, Calendar from, Calendar to, Integer[][] divOrgs, Integer[] divGeos, UserSessionData userSessionData) throws Exception {
  		Collection<Object[]> values = new LinkedList<Object[]>();
  		try {
  			String[] s = userSessionData.getFilter().getFields("d");
  			String corpRestrictions = UtilityQuery.corporationRestrictionsSQL( divOrgs, divGeos, "d", userSessionData);
            Session session = HibernateUtil.currentSession();
 			boolean doMitigation = (mitigation == null || mitigation.length == 0) ? (anual == null || anual.length == 0) : true;
  			boolean doAnual = (anual == null || anual.length == 0) ? (mitigation == null || mitigation.length == 0) : true;
  			String sql1 = null;
  			String sql2 = null;
  			if(doMitigation) {
  				sql1 = "SELECT d.id, d.firstname, d.lastname, mpa.activity, 'MITIGATION' AS type, mp.expiry"+s[0]+
  						" FROM mitigationplanactivities mpa, mitigationplans mp, drivers d "+s[1]+
  						corpRestrictions + s[2] +
  						" AND mp.id = mpa.id" +
  						" AND mp.driver = d.id" +
  						" AND done = 'f' AND mp.status = 0 ";
  				if(mitigation != null &&  mitigation.length > 0) {
  					sql1 += " AND activity IN (0";
  					for(int i = 0; i < mitigation.length; i++) {
  						sql1 += ","+mitigation[i];
  					}
  					sql1 += ")";
  				}
  				switch (status) {
					case DriverData.ACTIVE:
						sql1 += " AND d.exclusiondate is null";
						break;
					case DriverData.EXCLUDED:
						sql1 += " AND d.exclusiondate is not null";
						break;
				}
  				if(from != null) {
  					sql1 += " AND mp.expiry >= "+Util.formatSQL(from);
  				}
  				if(to != null) {
  					sql1 += " AND mp.expiry <= "+Util.formatSQL(to);
  				}
 			}
  			if(doAnual) {
  				sql2 = "SELECT d.id, d.firstname, d.lastname, ap.type AS activity, 'ANUAL' AS type, ap.expiry"+s[0]+
  						" FROM anualplans ap, drivers d "+s[1]+
  						corpRestrictions + s[2] +
  						" AND ap.driver = d.id" +
  						" AND ap.status != 2 ";
  				if(anual != null &&  anual.length > 0) {
  					sql2 += " AND ap.type IN (0";
  					for(int i = 0; i < anual.length; i++) {
  						sql2 += ","+anual[i];
  					}
  					sql2 += ")";
  				}
  				switch (status) {
					case DriverData.ACTIVE:
						sql2 += " AND d.exclusiondate is null";
						break;
					case DriverData.EXCLUDED:
						sql2 += " AND d.exclusiondate is not null";
						break;
				}
  				if(from != null) {
  					sql2 += " AND ap.expiry >= "+Util.formatSQL(from);
  				}
  				if(to != null) {
  					sql2 += " AND ap.expiry <= "+Util.formatSQL(to);
  				}
  			}
			String sql = null;
			if(sql1 != null) {
				sql = sql1;
				if(sql2 != null) {
					sql += " UNION ("+sql2+") ";
				}
			}else {
				sql = sql2;
			}
			if(sql != null) {
  				sql += " ORDER BY expiry, firstname, lastname";
				SQLQuery queryData = session.createSQLQuery(sql);
				queryData.addScalar("id", Hibernate.INTEGER);
				queryData.addScalar("firstname", Hibernate.STRING);
				queryData.addScalar("lastname", Hibernate.STRING);
				StringTokenizer token = new StringTokenizer(s[3], ",");
				while (token.hasMoreTokens()) {
					queryData.addScalar(token.nextToken(), Hibernate.STRING);
				}
				queryData.addScalar("activity", Hibernate.STRING);
				queryData.addScalar("type", Hibernate.STRING);
				queryData.addScalar("expiry", Hibernate.DATE);
				values.addAll(queryData.list());
 			}
  		} catch (Exception e) {
            Object[] p = {mitigation,anual,status,from,to,divOrgs,divGeos};
            handler.getException(e, "getPendingActivities", userSessionData, p);
        }
  		return values;
   	}

    /**
     * @ejb.permission role-name ="administrator,query"
     * @ejb.interface-method
     */
 	public Collection getMitigationPlans(String firstName, String lastName, String corporationId, int status, Integer[][] divOrgs, Integer[] divGeos, UserSessionData userSessionData) throws Exception {
  		Collection<Object[]> values = new LinkedList<Object[]>();
  		try {
  			String[] s = userSessionData.getFilter().getFields("d");
  			String corpRestrictions = UtilityQuery.corporationRestrictionsSQL( divOrgs, divGeos, "d", userSessionData);
            Session session = HibernateUtil.currentSession();
  			String sql1 = "SELECT d.id, d.corporationid, d.firstname, d.lastname, mp.type, mp.advance, mp.date, mp.expiry, pa.total "+s[0]+
  						" FROM mitigationplans mp, drivers d, pointaccount pa "+s[1]+
  						corpRestrictions + s[2] +
  						" AND mp.driver = d.id AND pa.type = 1 AND pa.reference = d.id " +
  						" AND mp.id IN (SELECT id FROM (SELECT driver, MAX(id) as id, MAX(expiry) FROM mitigationplans GROUP BY driver) c) ";
			switch (status) {
				case DriverData.ACTIVE:
					sql1 += " AND d.exclusiondate is null";
					break;
				case DriverData.EXCLUDED:
					sql1 += " AND d.exclusiondate is not null";
					break;
			}
	        if(!Util.empty(firstName)) {
	        	sql1 += " AND LOWER(TRIM(d.firstname)) LIKE '%"+firstName.toLowerCase()+"%'";
	        }
	        if(!Util.empty(lastName)) {
	        	sql1 += " AND LOWER(TRIM(d.lastname)) LIKE '%"+lastName.toLowerCase()+"%'";
	        }
	        if(!Util.empty(corporationId)) {
	        	sql1 += " AND LOWER(TRIM(d.corporationid)) LIKE '%"+corporationId.toLowerCase()+"%'";
	        }
			sql1 += " ORDER BY firstname, lastname";
			SQLQuery queryData = session.createSQLQuery(sql1);
			queryData.addScalar("id", Hibernate.INTEGER);
			queryData.addScalar("corporationid", Hibernate.STRING);
			queryData.addScalar("firstname", Hibernate.STRING);
			queryData.addScalar("lastname", Hibernate.STRING);
			queryData.addScalar("type", Hibernate.INTEGER);
			queryData.addScalar("advance", Hibernate.INTEGER);
			queryData.addScalar("date", Hibernate.DATE);
			queryData.addScalar("expiry", Hibernate.DATE);
			queryData.addScalar("total", Hibernate.INTEGER);
			StringTokenizer token = new StringTokenizer(s[3], ",");
			while (token.hasMoreTokens()) {
				queryData.addScalar(token.nextToken(), Hibernate.STRING);
			}
			values.addAll(queryData.list());

 		} catch (Exception e) {
            Object[] p = {firstName, lastName, status, corporationId, divOrgs, divGeos};
            handler.getException(e, "getMitigationPlans", userSessionData, p);
        }
  		return values;
  	}

    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "vehicleedit,vehicleupdate,administration"
     */
	public Collection getVehicleMaintenances(Integer driver, UserSessionData userSessionData) throws Exception {
		Collection maintenances = new LinkedList();
		try {
	        Session session = HibernateUtil.currentSession();

	        String queryStr = "SELECT vm FROM VehicleMaintenance vm WHERE vm.driver.id = "+String.valueOf(driver);
	        Query query = session.createQuery(queryStr);

	        Iterator it = query.list().iterator();
	        while(it.hasNext()) {
	        	maintenances.add(((VehicleMaintenance)it.next()).getData());
	        }
		} catch (Exception e) {
			Object[] p = {driver};
			handler.getException(e, "getVehicleMaintenances", userSessionData, p);
		}
		return maintenances;
	}
}