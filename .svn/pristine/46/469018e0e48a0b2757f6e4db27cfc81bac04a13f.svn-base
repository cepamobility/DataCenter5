	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverview,administrator"
	 */
	public ListResult getTelematicControlQuery(Integer fromday,
			Integer frommonth, Integer fromYear, Integer today,
			Integer tomonth, Integer toYear, Integer[][] divOrgs,
			Integer[][] divGeos, String firstname, String lastname,
			String idDallas, Integer type, Integer recomendation,

			String status, int first, int count, UserSessionData userSessionData)
			throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START,
				"getTelematicControlQuery", getClass());
		try {
			Session session = HibernateUtil.currentSession();
			Hashtable parameters = new Hashtable();
			Collection result = new LinkedList();
			String queryStr = UtilityQuery.corporationDivisionsRestictions(
					"tc.driver", userSessionData);
			if (firstname != null) {
				queryStr += " and lower(tc.driver.firstName) like lower(:firstname) ";
				parameters.put("firstname", "%" + firstname + "%");
			}
			if (lastname != null) {
				queryStr += " and lower(tc.driver.lastName) like lower(:lastname) ";
				parameters.put("lastname", "%" + lastname + "%");
			}
			if (idDallas != null && !idDallas.trim().equalsIgnoreCase("")) {
				queryStr += " and lower(tc.driver.idDallas) like lower(:idDallas)";
				parameters.put("idDallas", "%" + idDallas + "%");
			}

			if (type != null && type.intValue() != 0) {
				queryStr += " and tc.type = :type ";
				parameters.put("type", type);
			}

			if (recomendation != null && recomendation.intValue() != 0) {
				queryStr += " and tc.recomendation = :recomendation ";
				parameters.put("recomendation", recomendation);
			}

			switch (Integer.parseInt(status)) {
			case DriverData.ACTIVE:
				queryStr += " and tc.driver.exclusionDate is null";
				break;
			case DriverData.EXCLUDED:
				queryStr += " and tc.driver.exclusionDate is not null";
				break;
			}

			if (frommonth != null && fromYear != null && fromday != null) {
				queryStr += " and tc.date >= (:date1)";
				Calendar calendar1 = Calendar.getInstance();
				calendar1.set(Calendar.DAY_OF_MONTH, fromday.intValue());
				calendar1.set(Calendar.MONTH, frommonth.intValue() - 1);
				calendar1.set(Calendar.YEAR, fromYear.intValue());
				calendar1.set(Calendar.HOUR_OF_DAY, 0);
				calendar1.set(Calendar.MINUTE, 0);
				calendar1.set(Calendar.SECOND,0);
				parameters.put("date1", calendar1.getTime());
			}

			if (tomonth != null && today != null && toYear != null) {
				queryStr += " and tc.date <= (:date2)";
				Calendar calendar1 = Calendar.getInstance();
				calendar1.set(Calendar.DAY_OF_MONTH, today.intValue());
				calendar1.set(Calendar.MONTH, tomonth.intValue());
				calendar1.set(Calendar.YEAR, toYear.intValue());
				calendar1.set(Calendar.HOUR_OF_DAY, 0);
				calendar1.set(Calendar.MINUTE, 0);
				calendar1.set(Calendar.SECOND,0);
				parameters.put("date2", calendar1.getTime());
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = "";
						divOrgStr = " and tc.driver.divOrg"
								+ String.valueOf(j + 1) + " in (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						// System.out.println(divOrgStr);
						queryStr += divOrgStr;
					}
				}
			}

			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					queryStr += "and tc.driver.corpCountry.pk.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						queryStr += divGeos[0][i];
						queryStr += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
			}
			// queryStr += " and tc.driver.exclusionDate = null ";

			Query queryAux = session.createQuery("select count(*) "
					+ "from TelematicControl  as tc " + queryStr);

			Enumeration keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				queryAux.setParameter(parameter, parameters.get(parameter));
			}

			List activityColl = queryAux.list();
			Iterator iter = activityColl.iterator();
			Integer total = new Integer(0);
			while (iter.hasNext()) {
				total = new Integer(((Long) iter.next()).intValue());
			}

			Query query = session
					.createQuery("select distinct tc, tc.driver,  tc.driver.firstName, tc.driver.lastName "
							+ " from TelematicControl as tc "
							+ queryStr
							+ " order by tc.driver.firstName, tc.driver.lastName ");

			keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query.setParameter(parameter, parameters.get(parameter));
			}

			if (count != -1) {
				if (total.intValue() < first) {
					if (total.intValue() % count == 0) {
						first = total.intValue() - count;
					} else {
						first = total.intValue() - (total.intValue() % count);
					}
				}
				query.setFirstResult(first);
				query.setMaxResults(count);
			}

			List userColl = query.list();
			iter = userColl.iterator();

			while (iter.hasNext()) {
				Object[] obj = (Object[]) iter.next();
				TelematicControl tc = (TelematicControl) obj[0];
				Driver driver = (Driver) obj[1];
				// Driver driver = (Driver) session.load(Driver.class,
				// tc.getDriver().getId());
				tc.setDriver(driver);
				result.add(tc.getData(userSessionData));
			}

			session.close();

			MemoryLog.getInstance().log(MemoryLog.END,
					"getTelematicControlQuery", getClass());
			return new ListResult(result, total.intValue());

		} catch (Exception e) {
			Object[] parameters = { fromday, frommonth, fromYear, today,
					tomonth, toYear, divOrgs, divGeos, firstname, lastname,
					idDallas, type, recomendation, status, first, count };
			handler.getException(e, "getTelematicControlQuery",
					userSessionData, parameters);
		}
		return null;
	}

	/**
	 * Obtiene los conductores con sus controles telematicos filtrado por color
	 * y en formato detallado (indicando cuales son los filtros que generan el
	 * color). Tipos de Eventos: SOLO DE VELOCIDAD Color: Solo Amarillo o Rojo
	 *
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverview,administrator"
	 */
	public ListResult getTelematicControlQueryByColor(Integer fromday,
			Integer frommonth, Integer fromYear, Integer today,
			Integer tomonth, Integer toYear, Integer[][] divOrgs,
			Integer[][] divGeos, String firstname, String lastname,
			String corporationId, String status, int first, int count, String color,
			UserSessionData userSessionData) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START,
				"getTelematicControlQueryByColor", getClass());
		try {

			Session session = HibernateUtil.currentSession();
			Hashtable parameters = new Hashtable();
			Collection result = new LinkedList();

			String queryStr = UtilityQuery.corporationDivisionsRestictions(
					"tc.driver", userSessionData);
			if (firstname != null) {
				queryStr += " and lower(tc.driver.firstName) like lower(:firstname) ";
				parameters.put("firstname", "%" + firstname + "%");
			}
			if (lastname != null) {
				queryStr += " and lower(tc.driver.lastName) like lower(:lastname) ";
				parameters.put("lastname", "%" + lastname + "%");
			}
			if (corporationId != null && !corporationId.trim().equalsIgnoreCase("")) {
				queryStr += " and lower(tc.driver.corporationId) like lower(:corporationId)";
				parameters.put("corporationId", "%" + corporationId + "%");
			}

			if (!color.equalsIgnoreCase(TelematicControlData.COLOR_GREEN)) {
				// Tipos de eventos de VELOCIDAD
				queryStr += " and tc.type = "
					+ TelematicControlData.TYPE_EXCESSIVE_SPEED + "  ";
			}

			switch (Integer.parseInt(status)) {
			case DriverData.ACTIVE:
				queryStr += " and tc.driver.exclusionDate is null";
				break;
			case DriverData.EXCLUDED:
				queryStr += " and tc.driver.exclusionDate is not null";
				break;
			}

			if (frommonth != null && fromYear != null && fromday != null) {
				queryStr += " and tc.date >= (:date1)";
				Calendar calendar1 = Calendar.getInstance();
				calendar1.set(Calendar.DAY_OF_MONTH, fromday.intValue());
				calendar1.set(Calendar.MONTH, frommonth.intValue() - 1);
				calendar1.set(Calendar.YEAR, fromYear.intValue());
				calendar1.set(Calendar.HOUR_OF_DAY, 0);
				calendar1.set(Calendar.MINUTE, 0);
				calendar1.set(Calendar.SECOND,0);
				parameters.put("date1", calendar1.getTime());
			}

			if (tomonth != null && today != null && toYear != null) {
				queryStr += " and tc.date <= (:date2)";
				Calendar calendar1 = Calendar.getInstance();
				calendar1.set(Calendar.DAY_OF_MONTH, today.intValue());
				calendar1.set(Calendar.MONTH, tomonth.intValue());
				calendar1.set(Calendar.YEAR, toYear.intValue());
				calendar1.set(Calendar.HOUR_OF_DAY, 0);
				calendar1.set(Calendar.MINUTE, 0);
				calendar1.set(Calendar.SECOND,0);
				parameters.put("date2", calendar1.getTime());
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = "";
						divOrgStr = " and tc.driver.divOrg"
								+ String.valueOf(j + 1) + " in (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						queryStr += divOrgStr;
					}
				}
			}

			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					queryStr += "and tc.driver.corpCountry.pk.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						queryStr += divGeos[0][i];
						queryStr += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
			}

			// El idDallas no puede ser NULO para los controles telematicos
			//queryStr += " and tc.driver.idDallas is not null and tc.driver.idDallas != '' ";

			if (color.equalsIgnoreCase(TelematicControlData.COLOR_RED)) {
				// ROJO

				// si el color seleccionado es rojo, tengo en cuenta
				// 4 o + ocurrencias entre 121 a 130
				// o Una o mas ocurrencias iguales o superiores a 131 km/h �
				queryStr += " and ( (tc.occurrences >= 4 and tc.speed >= 121 and tc.speed <= 130 and tc.limitExceeded > 0) or " +
						" (tc.occurrences >= 1 and tc.speed >= 131 and tc.limitExceeded > 0) )";


				// groupByStr += " group by tc.driver.id having count(*) > 3 ";
			} else if (color
					.equalsIgnoreCase(TelematicControlData.COLOR_YELLOW)) {
				// AMARILLO
				// 3 o menos ocurrencias entre 121 a 130
				// 4 o + ocurrencias entre 101 e 120 km/h bajo lluvia

				queryStr += " and ( (tc.occurrences >= 1 and tc.occurrences <= 3 and tc.speed >= 121 and tc.speed <= 130 and tc.limitExceeded > 0) or " +
						" (tc.occurrences >= 4 and tc.speed >= 101 and tc.limitExceededRain > 0) )";  // and tc.limitExceededRain <= 120 )"; menor que 120 no pongo, porque si es 121 es infraccion igual pero esta fuera de rango.
				// groupByStr += " group by tc.driver.id having count(*) between 1 and 3 ";
			} else if (color
					.equalsIgnoreCase(TelematicControlData.COLOR_GREEN)) {
				// AMARILLO
				// 3 o menos ocurrencias entre 121 a 130
				// 4 o + ocurrencias entre 101 e 120 km/h bajo lluvia

				queryStr += " and tc.color = '"+TelematicControlData.COLOR_GREEN+"'";  // color verde";
			}
			// Contador total
			System.out.println("select count(*) "+ "from TelematicControl  as tc " + queryStr);
			Query queryAux = session
					.createQuery("select count(*) "
							+ "from TelematicControl  as tc " + queryStr );


			Enumeration keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				queryAux.setParameter(parameter, parameters.get(parameter));
			}

			List activityColl = queryAux.list();
			Iterator iter = activityColl.iterator();
			Integer total = new Integer(0);
			while (iter.hasNext()) {
				total = new Integer(((Long) iter.next()).intValue());
			}

			if (total.intValue() > 0) {

				// Consulta
				Query query = session
						.createQuery("select distinct tc, tc.driver,  tc.driver.firstName, tc.driver.lastName "
								+ " from TelematicControl as tc "
								+ queryStr
								+ " order by tc.driver.firstName, tc.driver.lastName ");

				keys = parameters.keys();
				while (keys.hasMoreElements()) {
					String parameter = (String) keys.nextElement();
					query.setParameter(parameter, parameters.get(parameter));
				}

				if (count != -1) {
					if (total.intValue() < first) {
						if (total.intValue() % count == 0) {
							first = total.intValue() - count;
						} else {
							first = total.intValue()
									- (total.intValue() % count);
						}
					}
					query.setFirstResult(first);
					query.setMaxResults(count);
				} // end if count != -1

				List userColl = query.list();
				Iterator iter2 = userColl.iterator();

				while (iter2.hasNext()) {
					Object[] obj = (Object[]) iter2.next();
					TelematicControl tc = (TelematicControl) obj[0];
					Driver driver = (Driver) obj[1];
					// Driver driver = (Driver) session.load(Driver.class,
					// tc.getDriver().getId());
					tc.setDriver(driver);
					tc.setColor(color);
					/*if(obj[2] != null) {
						tc.setVehicle((Vehicle)obj[2]);
					}*/
					result.add(tc.getData(userSessionData));
				}
			}

			session.close();

			MemoryLog.getInstance().log(MemoryLog.END,
					"getTelematicControlQueryByColor", getClass());
			return new ListResult(result, total.intValue());

		} catch (Exception e) {
			Object[] parameters = { fromday, frommonth, fromYear, today,
					tomonth, toYear, divOrgs, divGeos, firstname, lastname,
					corporationId, status, first, count };
			handler.getException(e, "getTelematicControlQueryByColor",
					userSessionData, parameters);
		}
		return null;
	}

	/**
	 * Obtiene los conductores con su color únicamente (segun el comportamient
	 * telematico del período) Tipos de Eventos: SOLO DE VELOCIDAD Color: Solo
	 * VERDE
	 *
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverview,administrator"
	 */
	public ListResult getTelematicControlQueryByColorGreen(Integer fromday,
			Integer frommonth, Integer fromYear, Integer today,
			Integer tomonth, Integer toYear, Integer[][] divOrgs,
			Integer[][] divGeos, String firstname, String lastname,
			String idDallas, String status, int first, int count, String color,
			UserSessionData userSessionData) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START,
				"getTelematicControlQueryByColorGreen", getClass());
		try {

			Session session = HibernateUtil.currentSession();
			Hashtable parameters = new Hashtable();
			Collection result = new LinkedList();


			String queryStrTC = "";
			String queryStr = UtilityQuery.corporationDivisionsRestictions(
					"driver", userSessionData);

			if (firstname != null) {
				queryStr += " and lower(driver.firstName) like lower(:firstname) ";
				parameters.put("firstname", "%" + firstname + "%");
			}
			if (lastname != null) {
				queryStr += " and lower(driver.lastName) like lower(:lastname) ";
				parameters.put("lastname", "%" + lastname + "%");
			}
			if (idDallas != null && !idDallas.trim().equalsIgnoreCase("")) {
				queryStr += " and lower(driver.corporationId) like lower(:idDallas)";
				parameters.put("idDallas", "%" + idDallas + "%");
			}

			switch (Integer.parseInt(status)) {
			case DriverData.ACTIVE:
				queryStr += " and driver.exclusionDate = null";
				break;
			case DriverData.EXCLUDED:
				queryStr += " and driver.exclusionDate != null";
				break;
			}

			if (frommonth != null && fromYear != null && fromday != null) {
				queryStrTC += " and tc.date >= (:date1)";
				Calendar calendar1 = Calendar.getInstance();
				calendar1.set(Calendar.DAY_OF_MONTH, fromday.intValue());
				calendar1.set(Calendar.MONTH, frommonth.intValue() - 1);
				calendar1.set(Calendar.YEAR, fromYear.intValue());
				calendar1.set(Calendar.HOUR_OF_DAY, 0);
				calendar1.set(Calendar.MINUTE, 0);
				calendar1.set(Calendar.SECOND,0);
				parameters.put("date1", calendar1.getTime());
			}

			if (tomonth != null && today != null && toYear != null) {
				queryStrTC += " and tc.date <= (:date2)";
				Calendar calendar1 = Calendar.getInstance();
				calendar1.set(Calendar.DAY_OF_MONTH, today.intValue());
				calendar1.set(Calendar.MONTH, tomonth.intValue());
				calendar1.set(Calendar.YEAR, toYear.intValue());
				calendar1.set(Calendar.HOUR_OF_DAY, 0);
				calendar1.set(Calendar.MINUTE, 0);
				calendar1.set(Calendar.SECOND,0);
				parameters.put("date2", calendar1.getTime());
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = "";
						divOrgStr = " and driver.divOrg"
								+ String.valueOf(j + 1) + " in (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						// System.out.println(divOrgStr);
						queryStr += divOrgStr;
					}
				}
			}

			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					queryStr += " and driver.corpCountry.pk.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						queryStr += divGeos[0][i];
						queryStr += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
			}

			// Tipos de eventos de VELOCIDAD
			queryStrTC += " and tc.color = '"+TelematicControlData.COLOR_GREEN+"'"; // amarillo en lluvia

			/**
			 * select d.firstname, d.lastname, d.iddallas, d.id as idriver from
			 * drivers d where d.corporation = 1 and d.iddallas is not null and
			 * d.iddallas != '' and d.id not in ( select tc2.driver from
			 * telematiccontrols tc2 where d.id = tc2.driver and (tc2.type = 7)
			 * and date between '2012-06-01' and '2012-06-30'
			 * );
			 */

			// Contador total
			Query queryAux = session.createQuery("select  count(*) "
					+ " from Driver  as driver " + queryStr
					+ " and driver.id IN (  "
					+ "select tc.driver.id from TelematicControl as tc where "
					+ " tc.driver.id = driver.id " + queryStrTC + " ) ");

			Enumeration keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				queryAux.setParameter(parameter, parameters.get(parameter));
			}

			List activityColl = queryAux.list();
			Iterator iter = activityColl.iterator();
			Integer total = new Integer(0);
			while (iter.hasNext()) {
				total = new Integer(((Long) iter.next()).intValue());
			}

			if (total.intValue() > 0) {
				// Consulta
				Query query = session
						.createQuery("select distinct driver "
								+ " from Driver as driver   "
								+ queryStr
								+ " and driver.id IN (  "
								+ " select tc.driver.id from TelematicControl as tc where "
								+ " tc.driver.id = driver.id "
								+ queryStrTC
								+ " ) "
								+ " order by driver.firstName, driver.lastName ");

				keys = parameters.keys();
				while (keys.hasMoreElements()) {
					String parameter = (String) keys.nextElement();
					query.setParameter(parameter, parameters.get(parameter));
				}

				if (count != -1) {
					if (total.intValue() < first) {
						if (total.intValue() % count == 0) {
							first = total.intValue() - count;
						} else {
							first = total.intValue()
									- (total.intValue() % count);
						}
					}
					query.setFirstResult(first);
					query.setMaxResults(count);
				} // end if count != -1

				List userColl = query.list();
				iter = userColl.iterator();

				while (iter.hasNext()) {
					Object obj = (Object) iter.next();
					if (obj != null) {
						Driver driver = (Driver) obj;
						if (driver != null) {
							TelematicControl tc = new TelematicControl();
							// Driver driver = (Driver)
							// session.load(Driver.class,
							// tc.getDriver().getId());
							tc.setDriver(driver);
							tc.setColor(color);
							result.add(tc.getData(userSessionData));
						}
					}
				}
			}

			session.close();

			MemoryLog.getInstance().log(MemoryLog.END,
					"getTelematicControlQueryByColorGreen", getClass());
			return new ListResult(result, total.intValue());

		} catch (Exception e) {
			Object[] parameters = { fromday, frommonth, fromYear, today,
					tomonth, toYear, divOrgs, divGeos, firstname, lastname,
					idDallas, status, first, count, color };
			handler.getException(e, "getTelematicControlQueryByColorGreen",
					userSessionData, parameters);
		}
		return null;
	}



	/**
	 * Devuelve un ListResult con una Collection de DriverReportDataType y el
	 * total de conductores HRD.
	 *
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "hrdphrdquery,administrator"
	 */
	public ListResult getHRDDrivers(Integer frommonth, Integer fromYear,
			Integer tomonth, Integer toYear, Integer[][] divOrgs,
			Integer[][] divGeos, String firstname, String lastname, int status,
			int first, int count, UserSessionData userSessionData)
			throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "getHRDDrivers",
				getClass());
		try {
			Session session = HibernateUtil.currentSession();
			Query query;
			String sqlQuery = "";
			Iterator it;
			List list = new LinkedList();
			ListResult listResult;

			// Me fijo si hay datos cargados en el PHRD:

			sqlQuery = "SELECT distinct config, value "
					+ "FROM configurations " + "WHERE config = 'hrd' ";

			if (sqlQuery != "") {
				query = session.createSQLQuery(sqlQuery).addScalar("config",
						Hibernate.STRING).addScalar("value", Hibernate.STRING);
				list = query.list();
			}

			if (!list.isEmpty()) {
				it = list.iterator();
				while (it.hasNext()) {
					Object[] row = (Object[]) it.next();
					if (row != null) {
						String config = (String) row[0];
						String value = (String) row[1];
						if (value != null && config != null
								&& config.trim().equals("hrd")
								&& value.trim().equals("true")) {
							return hrdQuery(frommonth, fromYear, tomonth,
									toYear, divOrgs, divGeos, firstname,
									lastname, status, first, count,
									userSessionData);
						}
					}
				}
			}
			listResult = new ListResult(new LinkedList(), -1);
			MemoryLog.getInstance().log(MemoryLog.END, "getHRDDrivers",
					getClass());
			return listResult;

		} catch (Exception e) {
			Object[] parameters = { frommonth, fromYear, tomonth, toYear,
					divOrgs, divGeos, firstname, lastname, status, first, count };
			handler.getException(e, "getHRDDrivers", userSessionData,
					parameters);
		}
		return new ListResult(new LinkedList(), 0);
	}

	private ListResult hrdQuery(Integer frommonth, Integer fromYear,
			Integer tomonth, Integer toYear, Integer[][] divOrgs,
			Integer[][] divGeos, String firstname, String lastname, int status,
			int first, int count, UserSessionData userSessionData)
			throws Exception {
		try {
			Session session = HibernateUtil.currentSession();
			ListResult listResult;
			Hashtable idsHrdConditions = new Hashtable();
			Hashtable hasEvitableEvents = new Hashtable();
			Collection result = new LinkedList();
			Query query;
			String sqlQuery = "";
			List cant;
			List list = new LinkedList();
			Iterator it;
			Integer total;
			total = new Integer(0);
			Date ultimaActualizacion = Calendar.getInstance().getTime();

			// Consulta:
			sqlQuery = " SELECT DISTINCT dp.id as id, dp.cond as cond, dp.date as date, dp.evitability"
					+ " FROM drivershrd dp, drivers d "
					+ " WHERE dp.id = d.id "
					+ " and  d.corporation = "
					+ userSessionData.getFilter().getCorporationId();

			// First Name:
			if (!Util.empty(firstname)) {
				sqlQuery += " and d.firstName like '%" + firstname + "%' ";
			}
			// Last Name:
			if (!Util.empty(lastname)) {
				sqlQuery += " and d.lastName like '%" + lastname + "%' ";
			}
			// divisiones Organizacionales para Driver
			/*
			 * if(divOrgs != null && divOrgs.length > 0) { for(int j = 0; j <
			 * divOrgs.length; j++) { if(divOrgs[j] != null && divOrgs[j].length
			 * > 0) { sqlQuery += " and d.divOrg"+String.valueOf(j+1)+" in (";
			 * for(int i = 0; i < divOrgs[j].length; i++) { sqlQuery +=
			 * divOrgs[j][i]; sqlQuery += (i == divOrgs[j].length-1) ? ") " :
			 * ","; } } } }
			 */

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = "";
						divOrgStr = " and d.divOrg" + String.valueOf(j + 1)
								+ " in (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos

							// divOrgStr += divOrgs[j][i];
							// divOrgStr += (i == divOrgs[j].length-1) ? ") " :
							// ",";
						}
						it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						// System.out.println(divOrgStr);
						sqlQuery += divOrgStr;
					}
				}
			}
			/* Modificacion de DivOrgs para Performance */

			// Divisiones Geograficas para Driver
			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					sqlQuery += " and d.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						sqlQuery += divGeos[0][i];
						sqlQuery += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
			}
			// Driver State: Activo
			if (status == DriverData.ACTIVE) {
				sqlQuery += " and d.exclusionDate is null ";
			}
			// Driver State: Excluido
			if (status == DriverData.EXCLUDED) {
				sqlQuery += " and d.exclusionDate is not null ";
			}
			if (sqlQuery != "") {
				query = session.createSQLQuery(sqlQuery).addScalar("id",
						Hibernate.INTEGER).addScalar("cond", Hibernate.STRING)
						.addScalar("date", Hibernate.DATE).addScalar("evitability", Hibernate.INTEGER);

				list = query.list();
				session.flush();
			}
			String driversIds = "";

			if (!list.isEmpty()) {
				it = list.iterator();
				while (it.hasNext()) {
					Object[] row = (Object[]) it.next();
					if (row != null) {
						Integer id = (Integer) row[0];
						String cond = (String) row[1];
						ultimaActualizacion = (Date) row[2];
						Integer evitability = (Integer) row[3];
						if (id != null && cond != null && cond != "") {
							if (idsHrdConditions.containsKey(id)) {
								// Si un driver cumple varias condiciones del
								// HRD
								// las pongo todas en el string
								cond = (String) idsHrdConditions.get(id) + " "
										+ cond;
							} else {
								driversIds += id.toString() + ",";
							}
							// En el hash guardo idDriver, CondicionesHRD:
							idsHrdConditions.put(id, cond);
							hasEvitableEvents.put(id,evitability);
						}
					}
				}
				if (driversIds.length() != 0) {
					driversIds = driversIds.substring(0, driversIds.length() - 1);
				} else {
					driversIds = "";
				}

				// Si tengo drivers, entonces traigo la info de los mismos:
				if (driversIds != "") {
					String activities = "'" + CEPAActivityConstants.HRD + "'";
					Hashtable hrdActivities = (userSessionData.getCorporationId() == CorporationData.JJ) ?
							getLastHRD(driversIds, activities, session)
							: new Hashtable();

					sqlQuery = "SELECT count(*) FROM Driver as driver WHERE driver.id IN (" + driversIds + ") ";

					// Paginacion:
					query = session.createQuery(sqlQuery);

					// Corro la consulta para saber la cantidad de registros
					cant = query.list();
					it = cant.iterator();
					// Determino la cantidad de registros de la consulta
					while (it.hasNext()) {
						total = new Integer(((Long) it.next()).intValue());
						break;
					}
					if (total == null)
						total = new Integer(0);
					// System.out.println("Total de Registros: "+total);

					if (total.intValue() > 0) {
						sqlQuery = "SELECT driver FROM Driver as driver WHERE "
								+ " driver.id IN (" + driversIds + ") "
								+ " order by driver.firstName, driver.lastName";
						query = session.createQuery(sqlQuery);

						// Paginacion:
						if (count != -1) {
							if (total.intValue() < first) {
								if (total.intValue() % count == 0) {
									first = total.intValue() - count;
								} else {
									first = total.intValue()
											- (total.intValue() % count);
								}
							}
							query.setFirstResult(first);
							query.setMaxResults(count);
						}

						list = query.list();
						if (!list.isEmpty()) {
							it = list.iterator();
							if (result == null)
								result = new LinkedList();
							while (it.hasNext()) {
								Driver driver = (Driver) it.next();
								if (driver != null) {
									// Me traigo el driver con sus datos y las
									// condiciones
									// HRD que tenga:
									DriverReportDataType drdt = driver.getDriverHRDData((String) idsHrdConditions.get(driver.getId()));
									drdt.setEvitability((Integer)hasEvitableEvents.get(driver.getId()));
									drdt.setLastUpdate(ultimaActualizacion);
									if (hrdActivities.containsKey(driver.getId())) {
										drdt.setLastHRD((Date) hrdActivities.get(driver.getId()));
									}
									if (drdt != null) {
										result.add(drdt);
									}
								}
							}
						}
					}
				}
			}

			listResult = new ListResult(result, total.intValue());
			return listResult;
		} catch (Exception e) {
			Object[] parameters = { frommonth, fromYear, tomonth, toYear,
					divOrgs, divGeos, firstname, lastname, status, first, count };
			handler.getException(e, "hrdQuery", userSessionData, parameters);
		}
		return new ListResult(new LinkedList(), 0);
	}

	/**
	 * Devuelve un ListResult con una Colleccion con los DriverReportDataType y
	 * el total de conductores HRD con los Criterios CEPA.
	 *
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "hrdbrasilquery,hrdphrdquery,administrator"
	 */
	public ListResult getDetailedHRDDrivers(Integer frommonth,
			Integer fromYear, Integer tomonth, Integer toYear,
			Integer[][] divOrgs, Integer[][] divGeos, String firstname,
			String lastname, int status, int first, int count,
			UserSessionData userSessionData) throws Exception {

		MemoryLog.getInstance().log(MemoryLog.START, "getDetailedHRDDrivers",
				getClass());
		try {
			Session session = HibernateUtil.currentSession();
			Query query;
			String sqlQuery = "";
			Iterator it;
			List list = new LinkedList();
			ListResult listResult;

			sqlQuery = "SELECT distinct config, value "
					+ "FROM configurations " + "WHERE config = 'hrd' ";

			if (sqlQuery != "") {
				query = session.createSQLQuery(sqlQuery).addScalar("config",
						Hibernate.STRING).addScalar("value", Hibernate.STRING);
				list = query.list();
			}

			if (!list.isEmpty()) {
				it = list.iterator();
				while (it.hasNext()) {
					Object[] row = (Object[]) it.next();
					if (row != null) {
						String config = (String) row[0];
						String value = (String) row[1];
						if (value != null && config != null
								&& config.trim().equals("hrd")
								&& value.trim().equals("true")) {
							return hrdDetailedQuery(frommonth, fromYear,
									tomonth, toYear, divOrgs, divGeos,
									firstname, lastname, status, first, count,
									userSessionData);
						}
					}
				}
			}
			listResult = new ListResult(new LinkedList(), -1);
			MemoryLog.getInstance().log(MemoryLog.END, "getDetailedHRDDrivers",
					getClass());
			return listResult;

		} catch (Exception e) {
			Object[] parameters = { frommonth, fromYear, tomonth, toYear,
					divOrgs, divGeos, firstname, lastname, status, first, count };
			handler.getException(e, "getDetailedHRDDrivers", userSessionData,
					parameters);
		}
		return new ListResult(new LinkedList(), 0);
	}

	/**
	 *
	 * @param frommonth
	 * @param fromYear
	 * @param tomonth
	 * @param toYear
	 * @param divOrgs
	 * @param divGeos
	 * @param firstname
	 * @param lastname
	 * @param status
	 * @param first
	 * @param count
	 * @param userSessionData
	 * @return
	 * @throws Exception
	 */
	private ListResult hrdDetailedQuery(Integer frommonth, Integer fromYear,
			Integer tomonth, Integer toYear, Integer[][] divOrgs,
			Integer[][] divGeos, String firstname, String lastname, int status,
			int first, int count, UserSessionData userSessionData)
			throws Exception {
		try {
			Session session = HibernateUtil.currentSession();
			ListResult listResult;
			Hashtable idsHrdConditions = new Hashtable();
			Collection result = new LinkedList();
			Query query;
			String sqlQuery = "";
			List cant;
			Iterator it;
			List list = new LinkedList();
			Integer total;
			total = new Integer(0);
			Date ultimaActualizacion = Calendar.getInstance().getTime();

			// Consulta:
			sqlQuery = " SELECT DISTINCT dp.id as id, dp.cond as cond, dp.date as date"
					+ " FROM drivershrd dp, drivers d "
					+ " WHERE dp.id = d.id "
					+ " and  d.corporation = "
					+ userSessionData.getFilter().getCorporationId();

			// First Name:
			if (!Util.empty(firstname)) {
				sqlQuery += " and d.firstName like '%" + firstname + "%' ";
			}
			// Last Name:
			if (!Util.empty(lastname)) {
				sqlQuery += " and d.lastName like '%" + lastname + "%' ";
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = "";
						divOrgStr = " and d.divOrg" + String.valueOf(j + 1)
								+ " in (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos
						}
						it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						// System.out.println(divOrgStr);
						sqlQuery += divOrgStr;
					}
				}
			}

			// Divisiones Geograficas para Driver
			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					sqlQuery += " and d.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						sqlQuery += divGeos[0][i];
						sqlQuery += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
			}
			// Driver State: Activo
			if (status == DriverData.ACTIVE) {
				sqlQuery += " and d.exclusionDate is null ";
			}
			// Driver State: Excluido
			if (status == DriverData.EXCLUDED) {
				sqlQuery += " and d.exclusionDate is not null ";
			}
			if (sqlQuery != "") {
				query = session.createSQLQuery(sqlQuery).addScalar("id",
						Hibernate.INTEGER).addScalar("cond", Hibernate.STRING)
						.addScalar("date", Hibernate.DATE);

				list = query.list();
			}
			String driversIds = "";

			if (!list.isEmpty()) {
				it = list.iterator();
				while (it.hasNext()) {
					Object[] row = (Object[]) it.next();
					if (row != null) {
						Integer id = (Integer) row[0];
						String cond = (String) row[1];
						ultimaActualizacion = (Date) row[2];
						if (id != null && cond != null && cond != "") {
							if (idsHrdConditions.containsKey(id)) {
								// Si un driver cumple varias condiciones del
								// HRD
								// las pongo todas en el string
								cond = (String) idsHrdConditions.get(id) + " "
										+ cond;
							} else {
								driversIds += id.toString() + ",";
							}
							// En el hash guardo idDriver, CondicionesHRD:
							idsHrdConditions.put(id, cond);
						}
					}
				}
				if (driversIds.length() != 0) {
					driversIds = driversIds.substring(0,
							driversIds.length() - 1);
				} else {
					driversIds = "";
				}

				// Si tengo drivers HRD, entonces traigo la info de los mismos:
				if (driversIds != "") {
					sqlQuery = "SELECT count(*) FROM Driver as driver WHERE "
							+ " driver.id IN (" + driversIds + ") ";

					// Paginacion:
					query = session.createQuery(sqlQuery);

					// Corro la consulta para saber la cantidad de registros
					cant = query.list();
					it = cant.iterator();
					// Determino la cantidad de registros de la consulta
					while (it.hasNext()) {
						total = new Integer(((Long) it.next()).intValue());
						break;
					}
					if (total == null)
						total = new Integer(0);
					// System.out.println("Total de Registros: "+total);

					if (total.intValue() > 0) {

						sqlQuery = "SELECT driver FROM Driver as driver WHERE "
								+ " driver.id IN (" + driversIds + ") " +
								// " and driver.corporationId = " +
								// userSessionData.getFilter().getCorporationId()+
								" order by driver.firstName, driver.lastName";
						query = session.createQuery(sqlQuery);

						// Paginacion:
						if (count != -1) {
							if (total.intValue() < first) {
								if (total.intValue() % count == 0) {
									first = total.intValue() - count;
								} else {
									first = total.intValue()
											- (total.intValue() % count);
								}
							}
							query.setFirstResult(first);
							query.setMaxResults(count);
						}

						list = query.list();
						driversIds = "";
						Hashtable hashDrivers = new Hashtable();
						if (!list.isEmpty()) {
							it = list.iterator();
							if (result == null)
								result = new LinkedList();

							while (it.hasNext()) {
								Driver driver = (Driver) it.next();
								if (driver != null) {
									// Me traigo el driver con sus datos y las
									// condiciones
									// HRD que tenga, junto con todo su
									// historial:

									DetailedDriverHRDDataType drdt = new DetailedDriverHRDDataType(
											driver
													.getDriverHRDData((String) idsHrdConditions
															.get(driver.getId())));
									drdt.setLastUpdate(ultimaActualizacion);
									driversIds += driver.getId().toString()
											+ ",";

									if (drdt != null) {
										hashDrivers.put(driver.getId(), drdt);
										result.add(drdt);
									}
								}
							}
						}
						if (driversIds.length() != 0) {
							driversIds = driversIds.substring(0, driversIds
									.length() - 1);
						} else {
							driversIds = "";
						}
						if (driversIds != "") {
							// Cargo los historicos de todos los drivers que
							// traigo:

							sqlQuery = "SELECT driver, date, type, clasification, result  "
									+ " FROM historyHRD, Drivers d  "
									+ " WHERE "
									+ " driver IN ("
									+ driversIds
									+ ") "
									+ " and  d.id = driver "
									+ " ORDER BY d.firstname, d.lastname, date, type; ";

							query = session.createSQLQuery(sqlQuery);
							query = session.createSQLQuery(sqlQuery).addScalar(
									"driver", Hibernate.INTEGER).addScalar(
									"date", Hibernate.STRING).addScalar("type",
									Hibernate.STRING).addScalar(
									"clasification", Hibernate.STRING)
									.addScalar("result", Hibernate.STRING);
							list = query.list();
							if (!list.isEmpty()) {
								it = list.iterator();
								while (it.hasNext()) {
									Object[] row = (Object[]) it.next();
									if (row != null) {
										Integer id = (Integer) row[0];
										String date = (String) row[1];
										String type = (String) row[2];
										String clasification = (String) row[3];
										String historyResult = (String) row[4];

										if (hashDrivers.containsKey(id)) {
											DetailedDriverHRDDataType driver = new DetailedDriverHRDDataType(
													(DetailedDriverHRDDataType) hashDrivers
															.get(id));
											DriverHistoryDataType dhdt = new DriverHistoryDataType(
													date, type, clasification,
													historyResult);
											driver.setHistory(dhdt);
											result.add(driver);
										}
									}
								}
							}
						}
					}
				}
			}
			listResult = new ListResult(result, total.intValue());
			return listResult;
		} catch (Exception e) {
			Object[] parameters = { frommonth, fromYear, tomonth, toYear,
					divOrgs, divGeos, firstname, lastname, status, first, count };
			handler.getException(e, "hrdDetailedQuery", userSessionData,
					parameters);
		}
		return new ListResult(new LinkedList(), 0);
	}

	/**
	 *
	 * @param divOrgs
	 * @param divGeos
	 * @param firstname
	 * @param lastname
	 * @param status
	 * @param first
	 * @param count
	 * @param avoidables
	 * @param userSessionData
	 * @return
	 * @throws Exception
	 */
	private ListResult hrdMonsantoQuery(Integer[][] divOrgs,
			Integer[][] divGeos, String firstname, String lastname, int status,
			int first, int count, boolean avoidables, String hrdTable,
			UserSessionData userSessionData) throws Exception {

		if (!avoidables) {
			hrdTable += "2";
		}
		Integer total = 0;
		Collection list = new LinkedList();
		try {
			Session session = HibernateUtil.currentSession();
			String activities = "'"
					+ CEPAActivityConstants.COMMENTARYDRIVEHIGHRISK + "'";
			String driversIds = "SELECT id FROM " + hrdTable;
			Hashtable hrdActivities = (userSessionData.getCorporationId() == CorporationData.MONSANTO) ? getLastHRD(
					driversIds, activities, session)
					: new Hashtable();

			Date lastUpdate = Calendar.getInstance().getTime();

			String where = "WHERE d.corporation = "
					+ userSessionData.getFilter().getCorporationId();

			if (!Util.empty(firstname)) {
				where += " AND LOWER(d.firstName) LIKE '%"
						+ firstname.toLowerCase() + "%' ";
			}
			if (!Util.empty(lastname)) {
				where += " and LOWER(d.lastName) LIKE '%"
						+ lastname.toLowerCase() + "%' ";
			}

			HashSet set = new HashSet();
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						where += " AND d.divorg" + String.valueOf(j + 1)
								+ " IN (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]);
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							where += ((Integer) it.next()).toString();
							where += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
					}
				}
			}

			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					where += " AND d.country IN (";
					for (int i = 0; i < divGeos[0].length; i++) {
						where += divGeos[0][i];
						where += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
			}

			switch (status) {
			case DriverData.ACTIVE:
				where += " AND d.exclusionDate IS NULL ";
				break;
			case DriverData.EXCLUDED:
				where += " AND d.exclusionDate IS NOT NULL ";
				break;
			}

			String sqlCount = "SELECT COUNT(DISTINCT d.id) AS count FROM drivers d JOIN "
					+ hrdTable + " dhm ON dhm.id = d.id ";
			SQLQuery query = session.createSQLQuery(sqlCount + where);
			query.addScalar("count", Hibernate.INTEGER);
			total = (Integer) query.uniqueResult();

			Hashtable drivers = new Hashtable();
			String ids = "";
			String sqlDrivers = "SELECT DISTINCT d.id,d.firstname,d.lastname,c.resourcekey AS country,d1.resourcekey AS div1,"
					+ "d2.resourcekey AS div2,d3.resourcekey AS div3,dhm.conditional,d4.resourcekey AS div4,v.id AS vehicle, v.matricula "
					+ "FROM drivers d "
					+ "JOIN "
					+ hrdTable
					+ " dhm ON dhm.id = d.id "
					+ "JOIN divorgitemlevel1s d4 ON d4.id = d.divorg1 "
					+ "JOIN divorgitemlevel1s d2 ON d2.id = d.divorg2 "
					+ "JOIN divorgitemlevel2s d1 ON d1.id = d2.divorgitemlevel2 "
					+ "JOIN divorgitemlevel1s d3 ON d3.id = d.divorg3 "
					+ "JOIN country c ON c.id = d.country "
					+ "LEFT JOIN vehicles v ON v.driver = d.id ";
			query = session.createSQLQuery(sqlDrivers + where
					+ "ORDER BY lastname,firstname");
			query.addScalar("id", Hibernate.INTEGER);
			query.addScalar("firstname", Hibernate.STRING);
			query.addScalar("lastname", Hibernate.STRING);
			query.addScalar("country", Hibernate.STRING);
			query.addScalar("div1", Hibernate.STRING);
			query.addScalar("div2", Hibernate.STRING);
			query.addScalar("div3", Hibernate.STRING);
			query.addScalar("conditional", Hibernate.BOOLEAN);
			query.addScalar("div4", Hibernate.STRING);
			query.addScalar("vehicle", Hibernate.INTEGER);
			query.addScalar("matricula", Hibernate.STRING);
			if (count != -1) {
				if (total.intValue() < first) {
					if (total.intValue() % count == 0) {
						first = total.intValue() - count;
					} else {
						first = total.intValue() - (total.intValue() % count);
					}
				}
				query.setFirstResult(first);
				query.setMaxResults(count);
			}
			Iterator it = query.list().iterator();
			while (it.hasNext()) {
				Object[] data = (Object[]) it.next();
				DriverReportDataType drdt = new DriverReportDataType();
				drdt.setId((Integer) data[0]);
				drdt.setLastUpdate(lastUpdate);
				drdt.setFirstname((String) data[1]);
				drdt.setLastname((String) data[2]);
				drdt.setCountry((String) data[3]);
				drdt.setDivorg22((String) data[4]);
				drdt.setDivorg23((String) data[5]);
				drdt.setDivorg32((String) data[6]);
				drdt.setConditional((Boolean) data[7]);
				drdt.setDivorg11((String) data[8]);
				drdt.setVehicleId((Integer) data[9]);
				drdt.setVehiclePlate((String) data[10]);
				if (hrdActivities.containsKey(data[0])) {
					drdt.setLastHRD((Date) hrdActivities.get(data[0]));
				}
				drivers.put(drdt.getId(), drdt);
				ids += String.valueOf(drdt.getId());
				if (it.hasNext()) {
					ids += ",";
				}
			}

			if (ids.length() > 0) {
				query = session.createSQLQuery(
						"SELECT id,cond FROM " + hrdTable + " WHERE id IN ("
								+ ids + ")").addScalar("id", Hibernate.INTEGER)
						.addScalar("cond", Hibernate.STRING);
				it = query.list().iterator();
				while (it.hasNext()) {
					Object[] data = (Object[]) it.next();
					((DriverReportDataType) drivers.get(data[0]))
							.addCond((String) data[1]);
				}
			}

			Enumeration hrds = drivers.elements();
			while (hrds.hasMoreElements()) {
				list.add(hrds.nextElement());
			}
			Collections.sort((List) list);
		} catch (Exception e) {
			e.printStackTrace();
		}
		return new ListResult(list, total);
	}

	/**
	 * Devuelve un ListResult con una Colleccion con los DriverReportDataType y
	 * el total de conductores HRD con los Criterios de Monsnato Brasil.
	 *
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "hrdbrasilquery,hrdphrdquery,administrator"
	 */
	public ListResult getHRDMonsantoARDrivers(Integer[][] divOrgs,
			Integer[][] divGeos, String firstname, String lastname, int status,
			int first, int count, String type, boolean avoidables,
			UserSessionData userSessionData) throws Exception {
		ListResult listResult;
		try {
			Session session = HibernateUtil.currentSession();
			List list = new LinkedList();
			String hrdTable = "drivershrdmonar";
			String historyHRDTable = "historyHRDMonar";

			Query query = session
					.createSQLQuery(
							"SELECT distinct config, value FROM configurations WHERE config = 'hrdmonar'")
					.addScalar("config", Hibernate.STRING).addScalar("value",
							Hibernate.STRING);
			list = query.list();

			if (!list.isEmpty()) {
				Iterator it = list.iterator();
				while (it.hasNext()) {
					Object[] row = (Object[]) it.next();
					if (row != null) {
						String config = (String) row[0];
						String value = (String) row[1];
						if (value != null && config != null
								&& config.trim().equals("hrdmonar")
								&& value.trim().equals("true")) {
							if (type.equals(DriverData.RESUMED)) {
								return hrdMonsantoQuery(divOrgs, divGeos,
										firstname, lastname, status, first,
										count, avoidables, hrdTable,
										userSessionData);
							} else {
								return getDetailedHRDMonsanto(
										divOrgs,
										divGeos,
										firstname,
										lastname,
										status,
										first,
										count,
										type
												.equals(DriverData.DETAILED_HRD_EVENTS),
										avoidables, hrdTable, historyHRDTable,
										userSessionData);
							}
						}
					}
				}
			}
			listResult = new ListResult(new LinkedList(), -1);
		} catch (Exception e) {
			Object[] parameters = { divOrgs, divGeos, firstname, lastname,
					status, first, count, type, avoidables };
			handler.getException(e, "getDetailedHRDMonARDrivers",
					userSessionData, parameters);
			listResult = new ListResult(new LinkedList(), 0);
		}
		return listResult;
	}

	/**
	 * Devuelve un ListResult con una Colleccion con los DriverReportDataType y
	 * el total de conductores HRD con los Criterios de Monsnato Brasil.
	 *
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "hrdbrasilquery,hrdphrdquery,administrator"
	 */
	public ListResult getHRDMonsantoDrivers(Integer[][] divOrgs,
			Integer[][] divGeos, String firstname, String lastname, int status,
			int first, int count, String type, boolean avoidables,
			UserSessionData userSessionData) throws Exception {
		ListResult listResult;
		try {
			Session session = HibernateUtil.currentSession();

			List list = new LinkedList();
			String hrdTable = "drivershrdmon";
			String historyHRDTable = "historyHRDMon";
			Query query = session
					.createSQLQuery(
							"SELECT distinct config, value FROM configurations WHERE config = 'hrdmon'")
					.addScalar("config", Hibernate.STRING).addScalar("value",
							Hibernate.STRING);
			list = query.list();

			if (!list.isEmpty()) {
				Iterator it = list.iterator();
				while (it.hasNext()) {
					Object[] row = (Object[]) it.next();
					if (row != null) {
						String config = (String) row[0];
						String value = (String) row[1];
						if (value != null && config != null
								&& config.trim().equals("hrdmon")
								&& value.trim().equals("true")) {
							if (type.equals(DriverData.RESUMED)) {
								return hrdMonsantoQuery(divOrgs, divGeos,
										firstname, lastname, status, first,
										count, avoidables, hrdTable,
										userSessionData);
							} else {
								return getDetailedHRDMonsanto(
										divOrgs,
										divGeos,
										firstname,
										lastname,
										status,
										first,
										count,
										type
												.equals(DriverData.DETAILED_HRD_EVENTS),
										avoidables, hrdTable, historyHRDTable,
										userSessionData);
							}
						}
					}
				}
			}
			listResult = new ListResult(new LinkedList(), -1);
		} catch (Exception e) {
			Object[] parameters = { divOrgs, divGeos, firstname, lastname,
					status, first, count, type, avoidables };
			handler.getException(e, "getDetailedHRDMonDrivers",
					userSessionData, parameters);
			listResult = new ListResult(new LinkedList(), 0);
		}
		return listResult;
	}

	/**
	 *
	 * @param divOrgs
	 * @param divGeos
	 * @param firstname
	 * @param lastname
	 * @param status
	 * @param first
	 * @param count
	 * @param onlyHRD
	 * @param avoidables
	 * @param hrdTable
	 * @param userSessionData
	 * @return
	 * @throws Exception
	 */
	private ListResult getDetailedHRDMonsanto(Integer[][] divOrgs,
			Integer[][] divGeos, String firstname, String lastname, int status,
			int first, int count, boolean onlyHRD, boolean avoidables,
			String hrdTable, String historyHRDTable,
			UserSessionData userSessionData) throws Exception {

		if (!avoidables) {
			hrdTable += "2";
		}

		try {
			Session session = HibernateUtil.currentSession();
			String activities = "'"
					+ CEPAActivityConstants.COMMENTARYDRIVEHIGHRISK + "'";
			String driversIds = "SELECT id FROM " + hrdTable;
			Hashtable hrdActivities = (userSessionData.getCorporationId() == CorporationData.MONSANTO) ? getLastHRD(
					driversIds, activities, session)
					: new Hashtable();
			activities = "'" + CEPAActivityConstants.TRANINGONTHEJOB + "','"
					+ CEPAActivityConstants.SPECIALDAYOFTRAINING + "'";
			Hashtable hrdTOJ = (userSessionData.getCorporationId() == CorporationData.MONSANTO) ? getLastHRD(
					driversIds, activities, session)
					: new Hashtable();

			Date lastUpdate = Calendar.getInstance().getTime();

			String where = "WHERE d.corporation = "
					+ userSessionData.getFilter().getCorporationId();

			if (!Util.empty(firstname)) {
				where += " AND LOWER(d.firstName) LIKE '%"
						+ firstname.toLowerCase() + "%' ";
			}
			if (!Util.empty(lastname)) {
				where += " and LOWER(d.lastName) LIKE '%"
						+ lastname.toLowerCase() + "%' ";
			}

			HashSet set = new HashSet();
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						where += " AND d.divorg" + String.valueOf(j + 1)
								+ " IN (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]);
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							where += ((Integer) it.next()).toString();
							where += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
					}
				}
			}

			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					where += " AND d.country IN (";
					for (int i = 0; i < divGeos[0].length; i++) {
						where += divGeos[0][i];
						where += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
			}

			switch (status) {
			case DriverData.ACTIVE:
				where += " AND d.exclusionDate IS NULL ";
				break;
			case DriverData.EXCLUDED:
				where += " AND d.exclusionDate IS NOT NULL ";
				break;
			}

			String sqlCount = "SELECT COUNT(DISTINCT d.id) AS count FROM drivers d JOIN "
					+ hrdTable + " dhm ON dhm.id = d.id ";
			SQLQuery query = session.createSQLQuery(sqlCount + where);
			query.addScalar("count", Hibernate.INTEGER);
			Integer total = (Integer) query.uniqueResult();

			Hashtable drivers = new Hashtable();
			String ids = "";
			String sqlDrivers = "SELECT DISTINCT d.id,d.firstname,d.lastname,c.resourcekey AS country,d1.resourcekey AS div1,"
					+ "d2.resourcekey AS div2,d3.resourcekey AS div3,dhm.conditional,d4.resourcekey AS div4,v.id AS vehicle, v.matricula "
					+ "FROM drivers d "
					+ "JOIN "
					+ hrdTable
					+ " dhm ON dhm.id = d.id "
					+ "JOIN divorgitemlevel1s d4 ON d4.id = d.divorg1 "
					+ "JOIN divorgitemlevel1s d2 ON d2.id = d.divorg2 "
					+ "JOIN divorgitemlevel2s d1 ON d1.id = d2.divorgitemlevel2 "
					+ "JOIN divorgitemlevel1s d3 ON d3.id = d.divorg3 "
					+ "JOIN country c ON c.id = d.country "
					+ "LEFT JOIN vehicles v ON v.driver = d.id ";
			query = session.createSQLQuery(sqlDrivers + where
					+ "ORDER BY lastname,firstname");
			query.addScalar("id", Hibernate.INTEGER);
			query.addScalar("firstname", Hibernate.STRING);
			query.addScalar("lastname", Hibernate.STRING);
			query.addScalar("country", Hibernate.STRING);
			query.addScalar("div1", Hibernate.STRING);
			query.addScalar("div2", Hibernate.STRING);
			query.addScalar("div3", Hibernate.STRING);
			query.addScalar("conditional", Hibernate.BOOLEAN);
			query.addScalar("div4", Hibernate.STRING);
			query.addScalar("vehicle", Hibernate.INTEGER);
			query.addScalar("matricula", Hibernate.STRING);
			if (count != -1) {
				if (total.intValue() < first) {
					if (total.intValue() % count == 0) {
						first = total.intValue() - count;
					} else {
						first = total.intValue() - (total.intValue() % count);
					}
				}
				query.setFirstResult(first);
				query.setMaxResults(count);
			}
			Iterator it = query.list().iterator();
			while (it.hasNext()) {
				Object[] data = (Object[]) it.next();
				DetailedDriverHRDDataType drdt = new DetailedDriverHRDDataType();
				drdt.setId((Integer) data[0]);
				drdt.setLastUpdate(lastUpdate);
				drdt.setFirstname((String) data[1]);
				drdt.setLastname((String) data[2]);
				drdt.setCountry((String) data[3]);
				drdt.setDivorg22((String) data[4]);
				drdt.setDivorg23((String) data[5]);
				drdt.setDivorg32((String) data[6]);
				drdt.setConditional((Boolean) data[7]);
				drdt.setDivorg11((String) data[8]);
				drdt.setVehicleId((Integer) data[9]);
				drdt.setVehiclePlate((String) data[10]);
				if (hrdActivities.containsKey(data[0])) {
					drdt.setLastHRD((Date) hrdActivities.get(data[0]));
				}
				if (hrdActivities.containsKey(data[0])) {
					drdt.setLastTOJ((Date) hrdTOJ.get(data[0]));
				}
				drivers.put(drdt.getId(), drdt);
				ids += String.valueOf(drdt.getId());
				if (it.hasNext()) {
					ids += ",";
				}
			}

			Collection hrds = new LinkedList();
			if (ids.length() > 0) {
				query = session.createSQLQuery(
						"SELECT id,cond FROM " + hrdTable + " WHERE id IN ("
								+ ids + ")").addScalar("id", Hibernate.INTEGER)
						.addScalar("cond", Hibernate.STRING);
				it = query.list().iterator();
				while (it.hasNext()) {
					Object[] data = (Object[]) it.next();
					((DetailedDriverHRDDataType) drivers.get(data[0]))
							.addCond((String) data[1]);
				}

				if (onlyHRD) {
					String sql = "SELECT dhm.id,h1.date AS date1,h1.type AS type1,h1.clasification AS clas1,h1.result AS result1"
							+ ",h2.date AS date2,h2.type AS type2,h2.clasification AS clas2,h2.result As result2,event1id,event2id  "
							+ "FROM "
							+ hrdTable
							+ " dhm "
							+ "LEFT JOIN "
							+ historyHRDTable
							+ " h1 ON h1.id = event1id "
							+ "LEFT JOIN "
							+ historyHRDTable
							+ " h2 ON h2.id = event2id "
							+ " WHERE dhm.id IN ("
							+ ids + ")";
					query = session.createSQLQuery(sql);
					query.addScalar("id", Hibernate.INTEGER);
					query.addScalar("date1", Hibernate.STRING);
					query.addScalar("type1", Hibernate.STRING);
					query.addScalar("clas1", Hibernate.STRING);
					query.addScalar("result1", Hibernate.STRING);
					query.addScalar("date2", Hibernate.STRING);
					query.addScalar("type2", Hibernate.STRING);
					query.addScalar("clas2", Hibernate.STRING);
					query.addScalar("result2", Hibernate.STRING);
					query.addScalar("event1id", Hibernate.INTEGER);
					query.addScalar("event2id", Hibernate.INTEGER);

					it = query.list().iterator();
					Collection added = new LinkedList();
					while (it.hasNext()) {
						Object[] data = (Object[]) it.next();
						boolean add = true;
						if (data[2] != null
								&& !data[2].equals("generic.event.fine")
								&& !data[2].equals("generic.event.incident")
								&& !data[2].equals("generic.event.accident")) {
							add = false;
						}
						if (data[6] != null
								&& !data[6].equals("generic.event.fine")
								&& !data[6].equals("generic.event.incident")
								&& !data[6].equals("generic.event.accident")) {
							add = false;
						}
						if (add) {
							Integer id = (Integer) data[0];
							DetailedDriverHRDDataType drdt = (DetailedDriverHRDDataType) drivers
									.get(id);
							if (data[1] != null) {
								DriverHistoryDataType history = new DriverHistoryDataType();
								history.setDate((String) data[1]);
								history.setType((String) data[2]);
								history.setClasification((String) data[3]);
								history.setResult((String) data[4]);
								String key = String.valueOf(id) + "-"
										+ String.valueOf(data[9]);
								if (!added.contains(key)) {
									added.add(key);
									hrds.add(new DetailedDriverHRDDataType(
											drdt, history));
								}
							}
							if (data[5] != null) {
								DriverHistoryDataType history = new DriverHistoryDataType();
								history.setDate((String) data[5]);
								history.setType((String) data[6]);
								history.setClasification((String) data[7]);
								history.setResult((String) data[8]);
								String key = String.valueOf(data[0]) + "-"
										+ String.valueOf(data[10]);
								if (!added.contains(key)) {
									added.add(key);
									hrds.add(new DetailedDriverHRDDataType(
											drdt, history));
								}
							}
						}
					}
				} else {
					query = session
							.createSQLQuery("SELECT driver,date,type,clasification,result "
									+ "FROM "
									+ historyHRDTable
									+ " WHERE driver IN (" + ids + ")");
					query.addScalar("driver", Hibernate.INTEGER);
					query.addScalar("date", Hibernate.STRING);
					query.addScalar("type", Hibernate.STRING);
					query.addScalar("clasification", Hibernate.STRING);
					query.addScalar("result", Hibernate.STRING);
					it = query.list().iterator();
					while (it.hasNext()) {
						Object[] data = (Object[]) it.next();
						DetailedDriverHRDDataType drdt = (DetailedDriverHRDDataType) drivers
								.get(data[0]);
						DriverHistoryDataType history = new DriverHistoryDataType();
						history.setDate((String) data[1]);
						history.setType((String) data[2]);
						history.setClasification((String) data[3]);
						history.setResult((String) data[4]);
						hrds.add(new DetailedDriverHRDDataType(drdt, history));
					}
				}
				Collections.sort((List) hrds);
			}
			return new ListResult(hrds, total);
		} catch (Exception e) {
			Object[] parameters = { divOrgs, divGeos, firstname, lastname,
					status, first, count, onlyHRD, avoidables };
			handler.getException(e, "hrdMonDetailedQuery", userSessionData,
					parameters);
		}
		return null;
	}

	/**
	 * Devuelve un ListResult con una Colleccion con los DriverReportDataType y
	 * el total de conductores PHRD.
	 *
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "hrdphrdquery,administrator"
	 */
	public ListResult getPHRDDrivers(Integer frommonth, Integer fromYear,
			Integer tomonth, Integer toYear, Integer[][] divOrgs,
			Integer[][] divGeos, String firstname, String lastname, int status,
			int first, int count, UserSessionData userSessionData)
			throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "getPHRDDrivers",
				getClass());
		try {
			Session session = HibernateUtil.currentSession();

			int corporationId = userSessionData.getFilter().getCorporationId()
					.intValue();
			// Me fijo si hay datos cargados en el PHRD:
			boolean heavy = corporationId == CorporationData.FORESTALORIENTAL
					|| corporationId == CorporationData.KLABIN
					|| corporationId == CorporationData.YOLI;
			String type = (heavy) ? "phrdpesados" : "phrd";
			String sqlQuery = "SELECT distinct config, value FROM configurations WHERE config = '"
					+ type + "'";

			List list = new LinkedList();
			if (sqlQuery != "") {
				Query query = session.createSQLQuery(sqlQuery).addScalar(
						"config", Hibernate.STRING).addScalar("value",
						Hibernate.STRING);
				list = query.list();
			}

			if (!list.isEmpty()) {
				Iterator it = list.iterator();
				while (it.hasNext()) {
					Object[] row = (Object[]) it.next();
					if (row != null) {
						String config = (String) row[0];
						String value = (String) row[1];
						if (value != null && config != null
								&& config.trim().equals(type)
								&& value.trim().equals("true")) {
							return phrdQuery(frommonth, fromYear, tomonth,
									toYear, divOrgs, divGeos, firstname,
									lastname, status, first, count,
									userSessionData);
						}
					}
				}
			}

		} catch (Exception e) {
			Object[] parameters = { divOrgs, divGeos, firstname, lastname,
					status, first, count };
			handler.getException(e, "getPHRDDrivers", userSessionData,
					parameters);
		}
		MemoryLog.getInstance()
				.log(MemoryLog.END, "getPHRDDrivers", getClass());
		return new ListResult(new LinkedList(), -1);
	}

	/**
	 * Metodo privado que invoca getPHRDDrivers para traer los Drivers PHRD
	 * cuando el FLAG de phrd esta en true.
	 *
	 * @param frommonth
	 * @param fromYear
	 * @param tomonth
	 * @param toYear
	 * @param divOrgs
	 * @param divGeos
	 * @param firstname
	 * @param lastname
	 * @param status
	 * @param first
	 * @param count
	 * @param userSessionData
	 * @return
	 * @throws Exception
	 */
	private ListResult phrdQuery(Integer frommonth, Integer fromYear,
			Integer tomonth, Integer toYear, Integer[][] divOrgs,
			Integer[][] divGeos, String firstname, String lastname, int status,
			int first, int count, UserSessionData userSessionData)
			throws Exception {
		try {
			Session session = HibernateUtil.currentSession();
			/* Por si viene un parametro indicando que condicion cumplir */
			Hashtable idsPhrdConditions = new Hashtable();
			Collection result = new LinkedList();
			Integer total = new Integer(0);
			Date ultimaActualizacion = Calendar.getInstance().getTime();

			int corporationId = userSessionData.getFilter().getCorporationId()
					.intValue();
			boolean heavy = corporationId == CorporationData.FORESTALORIENTAL
					|| corporationId == CorporationData.KLABIN
					|| corporationId == CorporationData.YOLI;
			String type = (heavy) ? "driversphrdpesados" : "driversPhrd";
			// Consulta:
			String sqlQuery = " SELECT DISTINCT dp.id as id, dp.cond as cond, dp.date as date FROM "
					+ type
					+ " dp, drivers d "
					+ " WHERE dp.id = d.id AND d.corporation = "
					+ userSessionData.getFilter().getCorporationId();

			// First Name:
			if (!Util.empty(firstname)) {
				sqlQuery += " AND d.firstName LIKE '%" + firstname + "%' ";
			}
			// Last Name:
			if (!Util.empty(lastname)) {
				sqlQuery += " AND d.lastName LIKE '%" + lastname + "%' ";
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = "";
						divOrgStr = " AND d.divOrg" + String.valueOf(j + 1)
								+ " in (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						sqlQuery += divOrgStr;
					}
				}
			}
			/* Modificacion de DivOrgs para Performance */

			// Divisiones Geograficas para Driver
			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					sqlQuery += " AND d.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						sqlQuery += divGeos[0][i];
						sqlQuery += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
			}
			// Driver State: Activo
			if (status == DriverData.ACTIVE) {
				sqlQuery += " AND d.exclusionDate IS null ";
			}
			// Driver State: Excluido
			if (status == DriverData.EXCLUDED) {
				sqlQuery += " AND d.exclusionDate IS not null ";
			}
			if (sqlQuery != "") {
				Query query = session.createSQLQuery(sqlQuery).addScalar("id",
						Hibernate.INTEGER).addScalar("cond", Hibernate.STRING)
						.addScalar("date", Hibernate.DATE);

				List list = query.list();
				session.flush();
				String driversIds = "";

				if (!list.isEmpty()) {
					Iterator it = list.iterator();
					while (it.hasNext()) {
						Object[] row = (Object[]) it.next();
						if (row != null) {
							Integer id = (Integer) row[0];
							String cond = (String) row[1];
							ultimaActualizacion = (Date) row[2];
							if (id != null && cond != null && cond != "") {
								if (idsPhrdConditions.containsKey(id)) {
									// Si un driver cumple varias condiciones
									// del PHRD
									// las pongo todas en el string
									cond = (String) idsPhrdConditions.get(id)
											+ " " + cond;
									idsPhrdConditions.remove(id);
								}
								// En el hash guardo idDriver, CondicionesHRD:
								idsPhrdConditions.put(id, cond);
							}
						}
					}
					// System.out.println("Total de Registros: "+idsPhrdConditions.size());

					/*
					 * Solo me quedo con los drivers cuyo score sea mayor o
					 * igual a 5:
					 */
					it = idsPhrdConditions.keySet().iterator();
					while (it.hasNext()) {
						Integer key = (Integer) it.next();
						if (key != null && idsPhrdConditions.containsKey(key)) {
							int score = (heavy) ? getPhrdHeavyScore((String) idsPhrdConditions
									.get(key))
									: getPhrdScore((String) idsPhrdConditions
											.get(key));
							if (score < 5) {
								// Elimino los drivers que no sean PHRD de la
								// lista:
								it.remove();
							} else {
								// Creo una lista de los drivers PHRD:
								driversIds += key.toString() + ",";
							}
						}
					}

					if (driversIds.length() != 0) {
						driversIds = driversIds.substring(0, driversIds
								.length() - 1);
					} else {
						driversIds = "";
					}

					// Si tengo drivers, entonces traigo la info de los mismos:
					if (driversIds != "") {

						String activities = "'" + CEPAActivityConstants.HRD
								+ "'";
						Hashtable phrdActivities = (corporationId == CorporationData.JJ) ? getLastHRD(
								driversIds, activities, session)
								: new Hashtable();

						sqlQuery = "SELECT count(*) FROM Driver as driver WHERE driver.id IN ("
								+ driversIds + ") ";

						// Paginacion:
						query = session.createQuery(sqlQuery);

						// Corro la consulta para saber la cantidad de registros
						it = query.list().iterator();
						// Determino la cantidad de registros de la consulta
						total = (it.hasNext()) ? new Integer(((Long) it.next())
								.intValue()) : new Integer(0);

						if (total.intValue() > 0) {
							sqlQuery = "SELECT distinct driver FROM Driver AS driver WHERE  driver.id IN ("
									+ driversIds
									+ ") ORDER BY driver.firstName, driver.lastName";
							query = session.createQuery(sqlQuery);

							// Paginacion:
							if (count != -1) {
								if (total.intValue() < first) {
									if (total.intValue() % count == 0) {
										first = total.intValue() - count;
									} else {
										first = total.intValue()
												- (total.intValue() % count);
									}
								}
								query.setFirstResult(first);
								query.setMaxResults(count);
							}

							list = query.list();
							if (!list.isEmpty()) {
								it = list.iterator();
								while (it.hasNext()) {
									Driver driver = (Driver) it.next();
									if (driver != null) {
										// Me traigo el driver con sus datos y
										// las condiciones
										// HRD que tenga:
										String cond = (String) idsPhrdConditions
												.get(driver.getId());
										DriverReportDataType drdt = driver
												.getDriverPHRDData(cond);
										drdt.setLastUpdate(ultimaActualizacion);
										if (phrdActivities.containsKey(driver
												.getId())) {
											drdt
													.setLastHRD((Date) phrdActivities
															.get(driver.getId()));
										}
										if (drdt != null) {
											result.add(drdt);
										}
									}
								}
							}
						}

					}
				}
			}

			return new ListResult(result, total.intValue());
		} catch (Exception e) {
			Object[] parameters = { divOrgs, divGeos, firstname, lastname,
					status, first, count };
			handler.getException(e, "phrdQuery", userSessionData, parameters);
		}
		return new ListResult(new LinkedList(), 0);

	}

	private Hashtable getLastHRD(String driversIds, String activities,
			Session session) throws Exception {
		Hashtable phrdActivities = new Hashtable();
		String sqlQuery = "SELECT ar.driver,ca.date FROM cepaactivity ca JOIN activityregistry ar ON ca.activityid = ar.activity "
				+ "WHERE ar.driver in ("
				+ driversIds
				+ ") AND ca.type IN ("
				+ activities + ") ORDER BY driver, date DESC";
		Query query = session.createSQLQuery(sqlQuery).addScalar("driver",
				Hibernate.INTEGER).addScalar("date", Hibernate.DATE);
		Iterator itActivies = query.list().iterator();
		while (itActivies.hasNext()) {
			Object[] data = (Object[]) itActivies.next();
			if (!phrdActivities.containsKey(data[0])) {
				phrdActivities.put(data[0], data[1]);
			}
		}
		return phrdActivities;
	}

	/**
	 * Dado el string de condiciones de PHRD de un driver calcula el Score PHRD
	 * del driver.
	 *
	 * @return
	 */
	private int getPhrdScore(String conditions) {
		if (conditions == null)
			return 0;

		int score = 0;
		if (conditions.contains(DriverReportDataType.COND1))
			score += 3;
		if (conditions.contains(DriverReportDataType.COND2))
			score += 2;
		if (conditions.contains(DriverReportDataType.COND3))
			score += 3;
		if (conditions.contains(DriverReportDataType.COND4))
			score += 2;
		if (conditions.contains(DriverReportDataType.COND5))
			score += 4;
		if (conditions.contains(DriverReportDataType.COND6))
			score += 2;
		if (conditions.contains(DriverReportDataType.COND7))
			score += 5;

		return score;
	}

	/**
	 * Dado el string de condiciones de PHRD de un driver calcula el Score PHRD
	 * del driver.
	 *
	 * @return
	 */
	private int getPhrdHeavyScore(String conditions) {
		if (conditions == null)
			return 0;

		int score = 0;
		if (conditions.contains(DriverReportDataType.COND1))
			score += 3;
		if (conditions.contains(DriverReportDataType.COND2))
			score += 2;
		if (conditions.contains(DriverReportDataType.COND3))
			score += 4;
		if (conditions.contains(DriverReportDataType.COND4))
			score += 2;
		if (conditions.contains(DriverReportDataType.COND5))
			score += 5;
		return score;
	}

	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverview,administrator"
	 */
	public ListResult getDriversTest(String firstName, String lastName,
			int status, Integer fromMonth, Integer fromYear, Integer toMonth,
			Integer toYear, Integer[][] divOrgs, Integer[][] divGeos,
			UserSessionData userSessionData) throws Exception {

		try {
			Session session = HibernateUtil.currentSession();

			Hashtable parameters = new Hashtable();
			String queryStr = UtilityQuery.corporationDivisionsRestictions(
					"driver", userSessionData);

			if (firstName != null) {
				queryStr += " and lower(firstname) like lower(:firstname)";
				parameters.put("firstname", "%" + firstName + "%");
			}
			if (lastName != null) {
				queryStr += " and lower(lastname) like lower(:name)";
				parameters.put("lastname", "%" + lastName + "%");
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = " and driver.divOrg"
								+ String.valueOf(j + 1) + " in (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						queryStr += divOrgStr;
					}
				}
			}
			/* Modificacion de DivOrgs para Performance */
			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					queryStr += "and driver.corpCountry.pk.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						queryStr += divGeos[0][i];
						queryStr += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
				if (divGeos[1] != null && divGeos[1].length > 0) {
					queryStr += "and driver.geoLevel1 in (";
					for (int i = 0; i < divGeos[1].length; i++) {
						queryStr += divGeos[1][i];
						queryStr += (i == divGeos[1].length - 1) ? ")" : ",";
					}
				}
			}

			if (status != DriverData.ALL) {
				if (status == DriverData.ACTIVE) {
					queryStr += " AND driver.exclusionDate IS NULL ";
				} else {
					queryStr += " AND driver.exclusionDate IS NOT NULL ";
				}
			}

			if ((fromMonth != null && fromYear != null)
					|| (toMonth != null && toYear != null)) {

				String auxSQL = "SELECT DISTINCT id FROM aptitudtests WHERE ";
				boolean restriction = false;
				if (fromMonth != null && fromYear != null) {
					auxSQL += "  expiry > "
							+ Util.formatSQL(fromMonth, fromYear, 0);
					restriction = true;
				}
				if (toMonth != null && toYear != null) {
					if (restriction) {
						auxSQL += " AND ";
					}
					auxSQL += "  expiry < "
							+ Util.formatSQL(toMonth, toYear, 1);
					restriction = true;
				}

				Query auxQuery = session.createSQLQuery(auxSQL).addScalar("id",
						Hibernate.INTEGER);
				Iterator auxIt = auxQuery.list().iterator();
				String ids = "";
				while (auxIt.hasNext()) {
					ids += String.valueOf(auxIt.next());
					if (auxIt.hasNext()) {
						ids += ",";
					}
				}

				if (ids.length() > 0) {
					queryStr += " AND driver.id IN (" + ids + ") ";

				}
			}

			Query query1 = session
					.createQuery("select count(driver) from Driver as driver "
							+ queryStr);
			Enumeration keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query1.setParameter(parameter, parameters.get(parameter));
			}
			Integer total = new Integer(((Long) query1.uniqueResult())
					.intValue());

			queryStr += " order by lastname";
			Query query2 = session
					.createQuery("select distinct driver from Driver as driver "
							+ queryStr);
			keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query2.setParameter(parameter, parameters.get(parameter));
			}

			Collection result = new LinkedList();
			List userColl = query2.list();
			Iterator iter = userColl.iterator();
			userColl = null;
			while (iter.hasNext()) {
				result.add(new AptitudTestReportDataType((Driver) iter.next()));
			}
			session.close();

			MemoryLog.getInstance().log(MemoryLog.END, "getDriversTest",
					getClass());
			return new ListResult(result, total.intValue());
		} catch (Exception e) {
			Object[] parameters = { firstName, lastName, status, fromMonth,
					fromYear, toMonth, toYear, divOrgs, divGeos };
			handler.getException(e, "getDriversTest", userSessionData,
					parameters);
		}
		return null;
	}

	/**
	 * @throws Exception
