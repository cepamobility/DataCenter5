		        List list2 = q2.list();
		        if(list2.size() > 0) {
		        	return ((MitigationPlan)list.iterator().next()).getData(userSessionData);
		        }	
	        }
		} catch (Exception e) {
			Object[] p = {driver};
			handler.getException(e, "getMitigationPlan", userSessionData, p);
		}
		return null;
	}

	/**
	 * @ejb.permission role-name ="administrator,driverview"
	 * @ejb.interface-method
	 */
	public DriverPointList getDriverPointResume(UserSessionData userSessionData) throws Exception {
		DriverPointList list = new DriverPointList();
		try {
	        Session session = HibernateUtil.currentSession();

	        String sql = "SELECT d.id, d.firstname, d.lastname, pa.total, mp.advance, mp.expiry	" +
	        		"FROM drivers d	" +
	        		"JOIN pointaccount pa ON pa.reference = d.id " +
	        		"LEFT JOIN mitigationplans mp ON mp.driver = d.id " +
	        		UtilityQuery.corporationRestrictionsSQL(new Integer[0][0], new Integer[0], "d", userSessionData) +
	        		"AND pa.type = 1 " +
	        		"ORDER BY mp.id DESC, firstname, lastname";
	        SQLQuery q = session.createSQLQuery(sql);
	        q.addScalar("id", Hibernate.INTEGER);
	        q.addScalar("firstname", Hibernate.STRING);
	        q.addScalar("lastname", Hibernate.STRING);
	        q.addScalar("total", Hibernate.DOUBLE);
	        q.addScalar("advance", Hibernate.INTEGER);
	        q.addScalar("expiry", Hibernate.DATE);
	        Iterator it = q.list().iterator();
	        Collection<Integer> ids = new LinkedList<Integer>();
	        while(it.hasNext()) {
	        	Object[] data = (Object[]) it.next();
	        	if(!ids.contains(data[0])) {
	        		list.addData(new Object[]{data[0], data[1] + " " + data[2], data[4], data[5]}, ((Double)data[3]).doubleValue());
	        		ids.add((Integer)data[0]);
	        	}
	        }
		} catch (Exception e) {
			Object[] p = {};
			handler.getException(e, "getDriverPointResume", userSessionData, p);
		}
		return list;
	}

