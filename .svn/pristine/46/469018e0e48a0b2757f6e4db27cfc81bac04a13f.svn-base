	        Query q = session.createQuery("SELECT mp FROM MitigationPlan AS mp WHERE mp.status = "+MitigationPlanData.PENDING+" AND mp.driver.id = "+driver+" ORDER BY mp.date DESC");
	        List list = q.list();
