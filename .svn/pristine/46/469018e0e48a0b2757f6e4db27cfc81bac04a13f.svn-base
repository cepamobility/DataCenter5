					parameters);
		}
		return null;
	}

	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name =
	 *                 "administrator,driveredit,drivervehicleedit,driverecreate,driverupdate"
	 * @param id
	 *            - a driver id
	 * @param registrationNumber
	 *            - registrationNumber of vehicle
	 * @param country
	 *            - country of vehicle
	 * @return boolean
	 * @throws DeslogedException
	 * @throws CommunicationProblemException
	 *
	 *             Verifica si ese idDallas no pertenece a otro conductor
	 *             diferente al pasado como parametro para esa corporacion
	 */
	public boolean idCorporationExist(String idDriver, String idCorporation, UserSessionData userSessionData) throws Exception {
		try {
			if (idCorporation != null && !idCorporation.trim().equalsIgnoreCase("")) {
				Session session = HibernateUtil.currentSession();
				String sql = "SELECT count(*) AS c FROM drivers WHERE corporation = "+userSessionData.getCorporationId()+" AND LOWER(TRIM(corporationid)) = '"+idCorporation.toLowerCase()+"'";
				if(idDriver != null && !idDriver.trim().equalsIgnoreCase("")) {
					sql += " AND id != "+idDriver;
				}
				Query query = session.createSQLQuery(sql).addScalar("c", Hibernate.INTEGER);
				Object uniqueResult = query.uniqueResult();
				if (uniqueResult != null) {
					return ((Integer)uniqueResult).intValue() > 0;
				}
			}
		} catch (Exception e) {
			Object[] parameters = { idDriver, idCorporation };
			handler.getException(e, "idCorporationExist", null, parameters);
		}
		return false;
	}

	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name =
	 *                 "administrator,driverupdate,vehicleupdate,drivervehicleupdate"
	 * @param data
	 * @throws Exception
	 */
	public boolean hasChangedDivisions(Integer vehicleId, Integer[] divOrgs,
			UserSessionData userSessionData) throws Exception {
		boolean result = false;
		try {
			String sql = "SELECT COUNT(*) AS count FROM drivers WHERE id = "
					+ vehicleId;
			for (int i = 0; i < 3; i++) {
				if (divOrgs[i] != 0) {
					sql += " AND divorg" + String.valueOf(i + 1) + " = "
							+ divOrgs[i];
				}
			}
			Session session = HibernateUtil.currentSession();
			Query q = session.createSQLQuery(sql).addScalar("count",
					Hibernate.INTEGER);
			Integer count = (Integer) q.uniqueResult();
			result = count == 0;
		} catch (Exception e) {
			Object[] p = { vehicleId, divOrgs };
			handler.getException(e, "hasChangedDivisions", userSessionData, p);
		}
		return result;
	}

	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,driverupdate,drivertests"
	 */
	public boolean existsAptitudTest(Integer driverId, String date,
			UserSessionData userSessionData) throws Exception {
		try {
			Session session = HibernateUtil.currentSession();
			Date dateObj = new Date(Long.parseLong(date));
			Query q = session.createSQLQuery(
					"SELECT COUNT(*) AS c FROM aptitudtests WHERE id = "
							+ driverId + " AND date = "
							+ Util.formatSQLHour(dateObj, 0)).addScalar("c",
					Hibernate.INTEGER);
			return ((Integer) q.uniqueResult()).intValue() > 0;
		} catch (Exception e) {
			Object[] parameters = { driverId, date };
			handler.getException(e, "existsAptitudTest", userSessionData,
					parameters);
		}
		return false;
	}

	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,jjreporter"
	 */
	public Collection findDriverReport(Hashtable parameters,
			UserSessionData userSessionData) throws Exception {
		Collection drivers = new LinkedList();
		try {
			Session session = HibernateUtil.currentSession();
			String query = "SELECT id,firstname,lastname,corporationid,email FROM drivers WHERE corporation = "
					+ userSessionData.getCorporationId();
			if (parameters.containsKey("id")) {
				query += " AND id = " + parameters.get("id");
			}
			if (parameters.containsKey("firstName")) {
				query += " AND LOWER(firstName) LIKE '%"
						+ ((String) parameters.get("firstName")).toLowerCase()
						+ "%'";
			}
			if (parameters.containsKey("lastName")) {
				query += " AND LOWER(lastName) LIKE '%"
						+ ((String) parameters.get("lastName")).toLowerCase()
						+ "%'";
			}
			if (parameters.containsKey("email")) {
				query += " AND LOWER(email) = '"
						+ ((String) parameters.get("email")).toLowerCase()
						+ "'";
			}
			if (parameters.containsKey("corporationId")) {
				query += " AND LOWER(corporationId) = '"
						+ ((String) parameters.get("corporationId"))
								.toLowerCase() + "'";
			}

			Query q = session.createSQLQuery(query).addScalar("id",
					Hibernate.INTEGER).addScalar("firstname", Hibernate.STRING)
					.addScalar("lastname", Hibernate.STRING).addScalar(
							"corporationid", Hibernate.STRING).addScalar(
							"email", Hibernate.STRING);
			Iterator it = q.list().iterator();
			while (it.hasNext()) {
				Object[] data = (Object[]) it.next();
				DriverData driver = new DriverData((Integer) data[0]);
				driver.setFirstName((String) data[1]);
				driver.setLastName((String) data[2]);
				driver.setCorporationId((String) data[3]);
				driver.setEmail((String) data[4]);
				drivers.add(driver);
			}
		} catch (Exception e) {
			handler.getException(e, "findDriverReport", userSessionData, null);
		}
		return drivers;
	}

