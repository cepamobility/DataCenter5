	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,query"
	 */
	public Collection getDriverAccessLog(String corporationId,
			String contratists, Date start, Date end, Integer access,
			UserSessionData userSessionData) throws Exception {
		Collection accessList = new LinkedList();
		try {
			Session session = HibernateUtil.currentSession();
			String sql = "SELECT d.firstname,d.lastname,d.corporationid,div.resourcekey,da.userid,da.date,da.access "
					+ "FROM driveraccess da JOIN drivers d ON d.id = da.driver JOIN divorgitemlevel1s div ON div.id = da.contratist "
					+ "WHERE d.corporation = "
					+ userSessionData.getFilter().getCorporationId();
			if (!Util.empty(corporationId)) {
				sql += " AND d.corporationid = '" + corporationId + "'";
			}
			if (access != -1) {
				sql += " AND da.access = " + access;
			}
			if (!Util.empty(contratists)) {
				sql += " AND da.contratist IN (" + contratists + ") ";
			}
			if (start != null) {
				sql += " AND da.date > " + Util.formatSQLHour(start, 0);
			}
			if (end != null) {
				sql += " AND da.date < " + Util.formatSQLHour(end, 1);
			}
			SQLQuery q = session.createSQLQuery(sql);
			q.addScalar("firstname", Hibernate.STRING);
			q.addScalar("lastname", Hibernate.STRING);
			q.addScalar("corporationid", Hibernate.STRING);
			q.addScalar("resourcekey", Hibernate.STRING);
			q.addScalar("userid", Hibernate.STRING);
			q.addScalar("date", Hibernate.DATE);
			q.addScalar("access", Hibernate.INTEGER);
			Iterator it = q.list().iterator();
			while (it.hasNext()) {
				accessList.add(new DriverAccessLogData((Object[]) it.next()));
			}
		} catch (Exception e) {
			Object[] p = { corporationId, contratists, start, end, access };
			handler.getException(e, "getDriverAccessLog", userSessionData, p);
		}
		return accessList;
	}

