			}

			if (lastName != null) {
				queryStr += "  AND lower(test.pk.driver.lastName) like lower(:lastName)";
				parameters.put("lastName", "%" + lastName + "%");
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = " and test.pk.driver.divOrg"
								+ String.valueOf(j + 1) + " in (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos

							// divOrgStr += divOrgs[j][i];
							// divOrgStr += (i == divOrgs[j].length-1) ? ") " :
							// ",";
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						// System.out.println(divOrgStr);
						queryStr += divOrgStr;
					}
				}
			}
			/* Modificacion de DivOrgs para Performance */
			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					queryStr += "and test.pk.driver.corpCountry.pk.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						queryStr += divGeos[0][i];
						queryStr += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
				if (divGeos[1] != null && divGeos[1].length > 0) {
					queryStr += "and test.pk.driver.geoLevel1 in (";
					for (int i = 0; i < divGeos[1].length; i++) {
						queryStr += divGeos[1][i];
						queryStr += (i == divGeos[1].length - 1) ? ")" : ",";
					}
				}
			}

			queryStr += " AND (EXTRACT(YEAR FROM test.pk.date) = '"
					+ String.valueOf(fromYear)
					+ "' AND EXTRACT(MONTH FROM test.pk.date) >= '" + fromMonth
					+ "' OR EXTRACT(YEAR FROM test.pk.date) > '"
					+ String.valueOf(fromYear) + "') ";
			queryStr += " AND (EXTRACT(YEAR FROM test.pk.date) = '"
					+ String.valueOf(toYear)
					+ "' AND EXTRACT(MONTH FROM test.pk.date) <= '" + toMonth
					+ "' OR EXTRACT(YEAR FROM test.pk.date) < '"
					+ String.valueOf(toYear) + "') ";

			if (status != DriverData.ALL) {
				if (status == DriverData.ACTIVE) {
					queryStr += " AND test.pk.driver.exclusionDate IS NULL ";
				} else {
					queryStr += " AND test.pk.driver.exclusionDate IS NOT NULL ";
				}
			}

			queryStr += " ORDER BY test.pk.date";
			Query query2 = session
					.createQuery("SELECT test FROM AptitudTest as test "
							+ queryStr);
			Enumeration keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query2.setParameter(parameter, parameters.get(parameter));
			}
			Collection result = new LinkedList();
			List userColl = query2.list();
			Iterator iter = userColl.iterator();
			userColl = null;
			while (iter.hasNext()) {
				result.add(new AptitudTestReportDataType((AptitudTest) iter
						.next()));
			}
			session.close();

			return new ListResult(result, result.size());
		} catch (Exception e) {
			Object[] parameters = { firstName, lastName, status, fromMonth,
					fromYear, toMonth, toYear, divOrgs, divGeos };
			handler.getException(e, "getDriverAptitutTests", userSessionData,
					parameters);
		}
		return null;
	}

	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverview,administrator"
	 */
	public ListResult getDriversAlcoholControls(String name, String status,
			String type, String controlResult, Integer[][] divOrgs,
			Integer[][] divGeos, int first, int count,
			UserSessionData userSessionData) throws Exception {
		try {
			Session session = HibernateUtil.currentSession();

			Hashtable parameters = new Hashtable();
			String queryStr = UtilityQuery.corporationDivisionsRestictions(
					"driver", userSessionData);
			// int pages=0;

			if (name != null) {
				queryStr += " and (lower(firstname) like lower(:name) OR lower(lastname) like lower(:name))";
				parameters.put("name", "%" + name + "%");
			}
			/* Modificacion de DivOrgs para Performance */
			/*
			 * if(divOrgs != null && divOrgs.length > 0) { for(int j = 0; j <
			 * divOrgs.length; j++) { if(divOrgs[j] != null && divOrgs[j].length
			 * > 0) { queryStr +=
			 * " and driver.divOrg"+String.valueOf(j+1)+" in ("; for(int i = 0;
			 * i < divOrgs[j].length; i++) { queryStr += divOrgs[j][i]; queryStr
			 * += (i == divOrgs[j].length-1) ? ") " : ","; } } } }
			 */

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = "";
						divOrgStr = " and driver.divOrg"
								+ String.valueOf(j + 1) + " in (";
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos

							// divOrgStr += divOrgs[j][i];
							// divOrgStr += (i == divOrgs[j].length-1) ? ") " :
							// ",";
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						// System.out.println(divOrgStr);
						queryStr += divOrgStr;
					}
				}
			}
			/* Modificacion de DivOrgs para Performance */
			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					queryStr += "and driver.corpCountry.pk.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						queryStr += divGeos[0][i];
						queryStr += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
				if (divGeos[1] != null && divGeos[1].length > 0) {
					queryStr += "and driver.geoLevel1 in (";
					for (int i = 0; i < divGeos[1].length; i++) {
						queryStr += divGeos[1][i];
						queryStr += (i == divGeos[1].length - 1) ? ")" : ",";
					}
				}
			}
			Calendar c = Calendar.getInstance();
			c.add(Calendar.YEAR, -1);
			if (Integer.parseInt(controlResult) != DriverData.ALL) {
				queryStr += " and id in (select control.pk.driver from AlcoholControl control where control.pk.date > (:date) and control.result = (:result))";
				parameters.put("date", c.getTime());
				parameters.put("result", controlResult);
			} else if (Integer.parseInt(type) == DriverData.NOT_EXPIRED) {
				queryStr += " and id in (select control.pk.driver from AlcoholControl control where control.pk.date > (:date))";
				parameters.put("date", c.getTime());
			} else if (Integer.parseInt(type) == DriverData.EXPIRED) {
				queryStr += " and id not in (select control.pk.driver from AlcoholControl control where control.pk.date > (:date))";
				parameters.put("date", c.getTime());
			}

			Query query1 = session
					.createQuery("select count(driver) from Driver as driver "
							+ queryStr);
			Enumeration keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query1.setParameter(parameter, parameters.get(parameter));
			}
			Integer total = new Integer(((Long) query1.uniqueResult())
					.intValue());

			queryStr += " order by lastname";
			Query query2 = session
					.createQuery("select distinct driver from Driver as driver "
							+ queryStr);
			keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query2.setParameter(parameter, parameters.get(parameter));
			}
			if (count != -1) {
				query2.setFirstResult(first);
				query2.setMaxResults(count);
			}
			Collection result = new LinkedList();
			List userColl = query2.list();
			Iterator iter = userColl.iterator();
			userColl = null;
			while (iter.hasNext()) {
				result.add(new AlcoholControlReportDataType((Driver) iter
						.next()));
			}
			session.close();

			return new ListResult(result, total.intValue());
		} catch (Exception e) {
			Object[] parameters = { name, status, type, controlResult, divOrgs,
					divGeos, first, count };
			handler.getException(e, "getDriversAlcoholControls",
					userSessionData, parameters);
		}
		return null;
	}

	/**
	 * Consulta de Drivers y Eventos detallada con datos de vehiculos asociados.
	 *
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverview,administrator"
	 */
	public ListResult getDetailedReportDriversWithVehicles(
			Hashtable inputParameters, Integer[][] divOrgs,
			Integer[][] divGeos, int first, int count,
			UserSessionData userSessionData) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "getForestReportDrivers",
				getClass());
		try {
			Session session = HibernateUtil.currentSession();

			Hashtable parameters = new Hashtable();
			String queryStr = UtilityQuery.corporationDivisionsRestictions(
					"driver", userSessionData);
			int pages = 0;

			if (inputParameters.containsKey("name")
					&& !Util.empty((String) inputParameters.get("name"))) {
				queryStr += " and (lower(firstname) like lower(:name) OR lower(lastname) like lower(:name))";
				parameters.put("name", "%" + inputParameters.get("name") + "%");
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = "";
						divOrgStr = " and driver.divOrg"
								+ String.valueOf(j + 1) + " in (";
						set.clear();
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos

						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						// System.out.println(divOrgStr);
						queryStr += divOrgStr;
					}
				}
			}
			/* Modificacion de DivOrgs para Performance */
			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					queryStr += "and driver.corpCountry.pk.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						queryStr += divGeos[0][i];
						queryStr += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}

				if (userSessionData.getCorporationId() != CorporationData.WEYERHAEUSER && userSessionData.getCorporationId() != CorporationData.ALLERGAN) {
					if (divGeos[1] != null && divGeos[1].length > 0) {
						queryStr += "and driver.geoLevel1 in (";
						for (int i = 0; i < divGeos[1].length; i++) {
							queryStr += divGeos[1][i];
							queryStr += (i == divGeos[1].length - 1) ? ")"
									: ",";
						}
					}
				}
			}
			if (inputParameters.containsKey("status")
					&& !Util.empty((String) inputParameters.get("status"))) {
				switch (Integer
						.parseInt((String) inputParameters.get("status"))) {
				case DriverData.ACTIVE:
					queryStr += " and exclusionDate = null";
					break;
				case DriverData.EXCLUDED:
					queryStr += " and exclusionDate != null";
					break;
				}
			}

			/* Vehiculos Asignados */
			if (inputParameters.containsKey("withVehicles")
					&& !Util
							.empty((String) inputParameters.get("withVehicles"))) {
				switch (Integer.parseInt((String) inputParameters
						.get("withVehicles"))) {
				case DriverData.WITH_VEHICLES: // Con Vehiculos Asignados (1 o
												// +)
					queryStr += " and "
							+ " (select count(*) from Vehicle as vehicle where vehicle.driver.id = driver.id "
							+ " and vehicle.exclusionDate IS NULL) >= 1 ";
					break;
				case DriverData.WITHOUT_VEHICLES: // Sin Vehiculo Asignado
					queryStr += "and driver.id NOT IN ("
							+ " SELECT vehicle.driver.id FROM Vehicle as vehicle "
							+ " WHERE vehicle.driver.id = driver.id ) ";
					break;
				default: // Todos, con o sin vehiculo asignado.
					// No agrego nada a la consulta
					break;
				}
			}

			if (inputParameters.containsKey("fines")
					&& !Util.empty((String) inputParameters.get("fines"))) {
				String fines = (String) inputParameters.get("fines");
				if (!fines.equals("0")) {
					if (fines.equals("1")) {
						queryStr += " and driver.id in (select event.driver.id from Fine as event where event.driver.id = driver.id and event.status <> 1 )";
					} else if (fines.equals("2")) {
						queryStr += " and "
								+ inputParameters.get("fineCount")
								+ " <= (select count(*) from Fine as event where event.driver.id = driver.id and event.status <> 1 )";
					} else if (fines.equals("3")) {
						queryStr += " and driver.id not in (select event.driver.id from Fine as event where event.driver.id = driver.id and event.status <> 1 )";
					}
				}
			}
			if (inputParameters.containsKey("accidents")
					&& !Util.empty((String) inputParameters.get("accidents"))) {
				String accidents = (String) inputParameters.get("accidents");
				if (!accidents.equals("0")) {
					if (accidents.equals("1")) {
						queryStr += " and driver.id in (select event.driver.id from Event as event where event.driver.id = driver.id and event.accident is not null and event.status <> 1 )";
					} else if (accidents.equals("2")) {
						queryStr += " and "
								+ inputParameters.get("accidentCount")
								+ " <= (select count(*) from Event as event where event.driver.id = driver.id and event.accident is not null and event.status <> 1 )";
						// parameters.put("accidentsCount",
						// Integer.getInteger(accidentsCount));
					} else if (accidents.equals("3")) {
						queryStr += " and driver.id not in (select event.driver.id from Event as event where event.driver.id = driver.id and event.accident is not null and event.status <> 1 )";
					}
				}
			}
			if (inputParameters.containsKey("incidents")
					&& !Util.empty((String) inputParameters.get("incidents"))) {
				String incidents = (String) inputParameters.get("incidents");
				if (!incidents.equals("0")) {
					if (incidents.equals("1")) {
						queryStr += " and driver.id in (select event.driver.id from Event as event where event.driver.id = driver.id and event.incident is not null and event.status <> 1 )";
					} else if (incidents.equals("2")) {
						queryStr += " and "
								+ inputParameters.get("incidentCount")
								+ " <= (select count(*) from Event as event where event.driver.id = driver.id and event.incident is not null and event.status <> 1 )";
						// parameters.put("incidentsCount",
						// Integer.getInteger(incidentsCount));
					} else if (incidents.equals("3")) {
						queryStr += " and driver.id not in (select event.driver.id from Event as event where event.driver.id = driver.id and event.incident is not null and event.status <> 1 )";
					}
				}
			}

			if (userSessionData.isForest()
					&& userSessionData.getFilter().getCorporationId()
							.intValue() != CorporationData.KLABIN) {

				String bps = (String) inputParameters.get("bps");
				if (bps.equals("yes")) {
					queryStr += " and bpsregistry is not null";
				} else if (bps.equals("no")) {
					queryStr += " and bpsregistry is null";
				}

				String apt = (String) inputParameters.get("aptitudResult");
				String type = (String) inputParameters.get("aptitudStatus");
				if (Integer.parseInt(apt) == DriverData.APT) {
					queryStr += " and id in (select test.pk.driver from AptitudTest test where test.expiry > (:dateTest) and test.apt = 't')";
					parameters
							.put("dateTest", Calendar.getInstance().getTime());
				} else if (Integer.parseInt(apt) == DriverData.NOT_APT) {
					queryStr += " and id not in (select test.pk.driver from AptitudTest test where test.expiry > (:dateTest) and test.apt = 't')";
					parameters
							.put("dateTest", Calendar.getInstance().getTime());
				} else if (Integer.parseInt(type) == DriverData.NOT_EXPIRED) {
					queryStr += " and id in (select test.pk.driver from AptitudTest test where test.expiry > (:dateTest))";
					parameters
							.put("dateTest", Calendar.getInstance().getTime());
				} else if (Integer.parseInt(type) == DriverData.EXPIRED) {
					queryStr += " and id not in (select test.pk.driver from AptitudTest test where test.expiry > (:dateTest))";
					parameters
							.put("dateTest", Calendar.getInstance().getTime());
				}

				String controlResult = (String) inputParameters
						.get("alcoholResult");
				type = (String) inputParameters.get("alcoholStatus");
				Calendar c = Calendar.getInstance();
				c.add(Calendar.YEAR, -1);
				if (Integer.parseInt(controlResult) != DriverData.ALL) {
					queryStr += " and id in (select control.pk.driver from AlcoholControl control where control.pk.date > (:dateControl) and control.result = (:result))";
					parameters.put("dateControl", c.getTime());
					parameters.put("result", controlResult);
				} else if (Integer.parseInt(type) == DriverData.NOT_EXPIRED) {
					queryStr += " and id in (select control.pk.driver from AlcoholControl control where control.pk.date > (:dateControl))";
					parameters.put("dateControl", c.getTime());
				} else if (Integer.parseInt(type) == DriverData.EXPIRED) {
					queryStr += " and id not in (select control.pk.driver from AlcoholControl control where control.pk.date > (:dateControl))";
					parameters.put("dateControl", c.getTime());
				}

				if (Integer.parseInt((String) inputParameters
						.get("postiveAlcohol")) == DriverData.ANY_POSITIVE) {
					queryStr += " and id in (select control.pk.driver from AlcoholControl control where control.result = "
							+ DriverData.POSITIVE + ")";
				} else if (Integer.parseInt((String) inputParameters
						.get("postiveAlcohol")) == DriverData.WITHOUT_POSITIVE) {
					queryStr += " and id not in (select control.pk.driver from AlcoholControl control where control.result = "
							+ DriverData.POSITIVE + ")";
				}
			}

			Query query1 = session
					.createQuery("select count(driver) from Driver as driver "
							+ queryStr);
			Enumeration keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query1.setParameter(parameter, parameters.get(parameter));
			}
			Integer total = new Integer(((Long) query1.uniqueResult())
					.intValue());

			queryStr += " order by lastname, firstname ";
			Query query2 = session
					.createQuery("select distinct driver from Driver as driver "
							+ queryStr);
			keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query2.setParameter(parameter, parameters.get(parameter));
			}
			if (count != -1) {
				query2.setFirstResult(first);
				query2.setMaxResults(count);
			}
			Collection resultDrivers = new LinkedList();
			Collection result = new LinkedList();
			Hashtable<Integer, DetailedDriverReportWithVehiclesDataType> hashResult = new Hashtable<Integer, DetailedDriverReportWithVehiclesDataType>();
			Hashtable<Integer, Integer> hashOdometers = new Hashtable<Integer, Integer>();
			String idsVehicles = "";

			DetailedDriverReportWithVehiclesDataType dd = null;
			List userColl = query2.list();
			if (userColl != null && userColl.size() > 0) {
				Iterator iter = userColl.iterator();
				userColl = null;
				String idsDrivers = "";
				while (iter.hasNext()) {
					Driver d = (Driver) iter.next();
					if (d != null && d.getId() != null) {
						if (idsDrivers != "") {
							idsDrivers = idsDrivers.concat(","
									+ d.getId().toString());
						} else {
							idsDrivers = d.getId().toString();
						}
						dd = d.getDetailedDriverReportWithVehiclesData();
						if (dd != null) {
							hashResult.put(d.getId(), dd);
							resultDrivers.add(dd); // todos los drivers
													// consultados
						}
					}
				}

				/*
				 * Para cada driver traigo todos sus vehiculos asociados en una
				 * única consulta
				 */
				String corporation = new Integer(userSessionData
						.getCorporationId()).toString();
				queryStr = "select distinct vehicle from Vehicle as vehicle where corporation = "
						+ corporation
						+ " and vehicle.driver.id in ("
						+ idsDrivers
						+ ") and vehicle.exclusionDate IS NULL "
						+ "order by vehicle.driver.id ";
				query2 = session.createQuery(queryStr);
				result = new LinkedList();

				List userColl2 = query2.list();
				if (userColl2 != null && userColl2.size() > 0) {

					// Obtengo los idsVehicles para buscar el odometro de cada
					// uno
					iter = userColl2.iterator();
					while (iter.hasNext()) {
						Vehicle v = (Vehicle) iter.next();
						VehicleData vehicleData = v.getVehicleData();
						if (vehicleData != null && vehicleData.getId() != null) {
							if (idsVehicles != "") {
								idsVehicles = idsVehicles.concat(","
										+ vehicleData.getId().toString());
							} else {
								idsVehicles = vehicleData.getId().toString();
							}
						}
					}

					// Traigo los odometros de los vehiculos:
					String sql2 = "SELECT vehicle,odometer "
							+ "FROM odometers WHERE vehicle IN (" + idsVehicles
							+ ")" + " ORDER BY vehicle, year DESC,period DESC";
					Query q2 = session.createSQLQuery(sql2).addScalar(
							"vehicle", Hibernate.INTEGER).addScalar("odometer",
							Hibernate.INTEGER);
					Iterator it = q2.list().iterator();
					while (it.hasNext()) {
						Object[] data = (Object[]) it.next();
						if (data != null
								&& data[0] != null
								&& data[1] != null
								&& !hashOdometers
										.containsKey((Integer) data[0])) {
							hashOdometers.put((Integer) data[0],
									(Integer) data[1]);
						}
					}

					// Genero los objetos DetailedDriverReportWithVehicles
					iter = userColl2.iterator();
					while (iter.hasNext()) {
						Vehicle v = (Vehicle) iter.next();
						VehicleData vehicleData = v.getVehicleData();
						if (vehicleData != null) {
							dd = null;
							dd = hashResult
									.get(vehicleData.getDriver().getId());
							Integer odometer = hashOdometers.get(vehicleData
									.getId());
							DetailedDriverReportWithVehiclesDataType ddNew = new DetailedDriverReportWithVehiclesDataType(
									dd);
							ddNew.setVehicleData(vehicleData);
							ddNew.setLastOdometer(odometer);
							result.add(ddNew); // agrego driver y 1 vehiculo
												// asociado.
							resultDrivers.remove(dd); // saco el driver que
														// tiene vehiculo
														// asociado
						}
					}
				}

				// Agrego los drivers que estan en resultDrivers y no estan en
				// result ( o sea
				// los drivers que no tienen vehiculo asociado
				// resultDrivers.removeAll(result); // dejo en resultDrivers
				// solo los que no tienen vehiculo asociado
				result.addAll(resultDrivers); // agrego al resultado de los
												// drivers con vehiculos los
												// dirvers que no tienen
												// vehiculo

			} // fin if userColl != null
			session.close();

			MemoryLog.getInstance().log(MemoryLog.END,
					"getDetailedReportDriversWithVehicles", getClass());
			return new ListResult(result, total.intValue());
		} catch (Exception e) {
			Object[] parameters = { inputParameters, divOrgs, divGeos, first,
					count };
			handler.getException(e, "getDetailedReportDriversWithVehicles",
					userSessionData, parameters);
		}
		return null;

	}

	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverview,administrator"
	 */
	public ListResult getForestReportDrivers(Hashtable inputParameters,
			Integer[][] divOrgs, Integer[][] divGeos, int first, int count,
			UserSessionData userSessionData) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "getForestReportDrivers",
				getClass());
		try {
			Session session = HibernateUtil.currentSession();

			Hashtable parameters = new Hashtable();
			String queryStr = UtilityQuery.corporationDivisionsRestictions(
					"driver", userSessionData);
			int pages = 0;

			if (inputParameters.containsKey("name")
					&& !Util.empty((String) inputParameters.get("name"))) {
				queryStr += " and (lower(firstname) like lower(:name) OR lower(lastname) like lower(:name))";
				parameters.put("name", "%" + inputParameters.get("name") + "%");
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						divOrgStr = "";
						divOrgStr = " and driver.divOrg"
								+ String.valueOf(j + 1) + " in (";
						set.clear();
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]); // Para evitar repetidos

						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						// System.out.println(divOrgStr);
						queryStr += divOrgStr;
					}
				}
			}
			/* Modificacion de DivOrgs para Performance */
			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					queryStr += "and driver.corpCountry.pk.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						queryStr += divGeos[0][i];
						queryStr += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}

				if (userSessionData.getCorporationId() != CorporationData.WEYERHAEUSER && userSessionData.getCorporationId() != CorporationData.ALLERGAN) {
					if (divGeos[1] != null && divGeos[1].length > 0) {
						queryStr += "and driver.geoLevel1 in (";
						for (int i = 0; i < divGeos[1].length; i++) {
							queryStr += divGeos[1][i];
							queryStr += (i == divGeos[1].length - 1) ? ")"
									: ",";
						}
					}
				}
			}
			if (inputParameters.containsKey("status")
					&& !Util.empty((String) inputParameters.get("status"))) {
				switch (Integer
						.parseInt((String) inputParameters.get("status"))) {
				case DriverData.ACTIVE:
					queryStr += " and exclusionDate = null";
					break;
				case DriverData.EXCLUDED:
					queryStr += " and exclusionDate != null";
					break;
				}
			}

			/* Vehiculos Asignados */
			if (inputParameters.containsKey("withVehicles")
					&& !Util
							.empty((String) inputParameters.get("withVehicles"))) {
				switch (Integer.parseInt((String) inputParameters
						.get("withVehicles"))) {
				case DriverData.WITH_VEHICLES: // Con Vehiculos Asignados (1 o
												// +)
					queryStr += " and "
							+ " (select count(*) from Vehicle as vehicle where vehicle.driver.id = driver.id and vehicle.exclusionDate IS NULL) >= 1 ";
					break;
				case DriverData.WITHOUT_VEHICLES: // Sin Vehiculo Asignado
					queryStr += " and driver.id NOT IN ("
							+ " SELECT vehicle.driver.id FROM Vehicle as vehicle "
							+ " WHERE vehicle.driver.id = driver.id ) ";
					break;
				// Todos, con o sin vehiculo asignado.
				// No agrego nada a la consulta

				}
			}

			if (inputParameters.containsKey("fines")
					&& !Util.empty((String) inputParameters.get("fines"))) {
				String fines = (String) inputParameters.get("fines");
				if (!fines.equals("0")) {
					if (fines.equals("1")) {
						queryStr += " and driver.id in (select event.driver.id from Fine as event where event.driver.id = driver.id and event.status <> 1 )";
					} else if (fines.equals("2")) {
						queryStr += " and "
								+ inputParameters.get("fineCount")
								+ " <= (select count(*) from Fine as event where event.driver.id = driver.id and event.status <> 1 )";
					} else if (fines.equals("3")) {
						queryStr += " and driver.id not in (select event.driver.id from Fine as event where event.driver.id = driver.id and event.status <> 1 )";
					}
				}
			}
			if (inputParameters.containsKey("accidents")
					&& !Util.empty((String) inputParameters.get("accidents"))) {
				String accidents = (String) inputParameters.get("accidents");
				if (!accidents.equals("0")) {
					if (accidents.equals("1")) {
						queryStr += " and driver.id in (select event.driver.id from Event as event where event.driver.id = driver.id and event.accident is not null and event.status <> 1 )";
					} else if (accidents.equals("2")) {
						queryStr += " and "
								+ inputParameters.get("accidentCount")
								+ " <= (select count(*) from Event as event where event.driver.id = driver.id and event.accident is not null and event.status <> 1 )";
						// parameters.put("accidentsCount",
						// Integer.getInteger(accidentsCount));
					} else if (accidents.equals("3")) {
						queryStr += " and driver.id not in (select event.driver.id from Event as event where event.driver.id = driver.id and event.accident is not null and event.status <> 1 )";
					}
				}
			}
			if (inputParameters.containsKey("incidents")
					&& !Util.empty((String) inputParameters.get("incidents"))) {
				String incidents = (String) inputParameters.get("incidents");
				if (!incidents.equals("0")) {
					if (incidents.equals("1")) {
						queryStr += " and driver.id in (select event.driver.id from Event as event where event.driver.id = driver.id and event.incident is not null and event.status <> 1 )";
					} else if (incidents.equals("2")) {
						queryStr += " and "
								+ inputParameters.get("incidentCount")
								+ " <= (select count(*) from Event as event where event.driver.id = driver.id and event.incident is not null and event.status <> 1 )";
						// parameters.put("incidentsCount",
						// Integer.getInteger(incidentsCount));
					} else if (incidents.equals("3")) {
						queryStr += " and driver.id not in (select event.driver.id from Event as event where event.driver.id = driver.id and event.incident is not null and event.status <> 1 )";
					}
				}
			}

			if (userSessionData.isForest()
					&& userSessionData.getFilter().getCorporationId()
							.intValue() != CorporationData.KLABIN) {

				String bps = (String) inputParameters.get("bps");
				if (bps.equals("yes")) {
					queryStr += " and bpsregistry is not null";
				} else if (bps.equals("no")) {
					queryStr += " and bpsregistry is null";
				}

				String apt = (String) inputParameters.get("aptitudResult");
				String type = (String) inputParameters.get("aptitudStatus");
				if (Integer.parseInt(apt) == DriverData.APT) {
					queryStr += " and id in (select test.pk.driver from AptitudTest test where test.expiry > (:dateTest) and test.apt = 't')";
					parameters
							.put("dateTest", Calendar.getInstance().getTime());
				} else if (Integer.parseInt(apt) == DriverData.NOT_APT) {
					queryStr += " and id not in (select test.pk.driver from AptitudTest test where test.expiry > (:dateTest) and test.apt = 't')";
					parameters
							.put("dateTest", Calendar.getInstance().getTime());
				} else if (Integer.parseInt(type) == DriverData.NOT_EXPIRED) {
					queryStr += " and id in (select test.pk.driver from AptitudTest test where test.expiry > (:dateTest))";
					parameters
							.put("dateTest", Calendar.getInstance().getTime());
				} else if (Integer.parseInt(type) == DriverData.EXPIRED) {
					queryStr += " and id not in (select test.pk.driver from AptitudTest test where test.expiry > (:dateTest))";
					parameters
							.put("dateTest", Calendar.getInstance().getTime());
				}

				String controlResult = (String) inputParameters
						.get("alcoholResult");
				type = (String) inputParameters.get("alcoholStatus");
				Calendar c = Calendar.getInstance();
				c.add(Calendar.YEAR, -1);
				if (Integer.parseInt(controlResult) != DriverData.ALL) {
					queryStr += " and id in (select control.pk.driver from AlcoholControl control where control.pk.date > (:dateControl) and control.result = (:result))";
					parameters.put("dateControl", c.getTime());
					parameters.put("result", controlResult);
				} else if (Integer.parseInt(type) == DriverData.NOT_EXPIRED) {
					queryStr += " and id in (select control.pk.driver from AlcoholControl control where control.pk.date > (:dateControl))";
					parameters.put("dateControl", c.getTime());
				} else if (Integer.parseInt(type) == DriverData.EXPIRED) {
					queryStr += " and id not in (select control.pk.driver from AlcoholControl control where control.pk.date > (:dateControl))";
					parameters.put("dateControl", c.getTime());
				}

				if (Integer.parseInt((String) inputParameters
						.get("postiveAlcohol")) == DriverData.ANY_POSITIVE) {
					queryStr += " and id in (select control.pk.driver from AlcoholControl control where control.result = "
							+ DriverData.POSITIVE + ")";
				} else if (Integer.parseInt((String) inputParameters
						.get("postiveAlcohol")) == DriverData.WITHOUT_POSITIVE) {
					queryStr += " and id not in (select control.pk.driver from AlcoholControl control where control.result = "
							+ DriverData.POSITIVE + ")";
				}
			}

			Query query1 = session
					.createQuery("select count(driver) from Driver as driver "
							+ queryStr);
			Enumeration keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query1.setParameter(parameter, parameters.get(parameter));
			}
			Integer total = new Integer(((Long) query1.uniqueResult())
					.intValue());

			queryStr += " order by lastname";
			Query query2 = session
					.createQuery("select distinct driver from Driver as driver "
							+ queryStr);
			keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query2.setParameter(parameter, parameters.get(parameter));
			}
			if (count != -1) {
				query2.setFirstResult(first);
				query2.setMaxResults(count);
			}
			Collection result = new LinkedList();
			List userColl = query2.list();
			Iterator iter = userColl.iterator();
			userColl = null;
			while (iter.hasNext()) {
				result.add(((Driver) iter.next())
						.getDriverReportData((String) inputParameters
								.get("type")));
			}
			session.close();

			MemoryLog.getInstance().log(MemoryLog.END,
					"getForestReportDrivers", getClass());
			return new ListResult(result, total.intValue());
		} catch (Exception e) {
			Object[] parameters = { inputParameters, divOrgs, divGeos, first,
					count };
			handler.getException(e, "getForestReportDrivers", userSessionData,
					parameters);
		}
		return null;
	}

	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,query"
	 */
	public ListResult getHistoryDrivers(String firstname, String lastname,
			int status, Integer[][] divOrgs, Integer[][] divGeos, int first,
			int count, UserSessionData userSessionData) throws Exception {

		Integer total = new Integer(0);
		Collection result = new LinkedList();
		String table = null;

		try {

			switch (userSessionData.getFilter().getCorporationId()) {
				case CorporationData.JJ:
					table = "historyDriversJJ";
					break;
				case CorporationData.BAYER: case CorporationData.MONTES_DE_PLATA: case CorporationData.BAYER_MX:
				case CorporationData.NALCO:case CorporationData.SYNGENTA: case CorporationData.SYNGENTA_BR: case CorporationData.DOW:
				case CorporationData.ECOLAB:
					table = "driverHistory";
					break;
				default:
					table = "historyDriversMon";
			}

			Session session = HibernateUtil.currentSession();
			Date ultimaActualizacion = Calendar.getInstance().getTime();

			String restrictions = "";
			if (!Util.empty(firstname)) {
				restrictions += " and LOWER(d.firstname) like '%"
						+ firstname.toLowerCase() + "%' ";
			}

			if (!Util.empty(lastname)) {
				restrictions += " and LOWER(d.lastname) like '%"
						+ lastname.toLowerCase() + "%' ";
			}

			switch (status) {
			case DriverData.ACTIVE:
				restrictions += " and d.exclusionDate is null ";
				break;
			case DriverData.EXCLUDED:
				restrictions += " and d.exclusionDate is not null ";
				break;
			}
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					HashSet set = new HashSet();
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]);
						}
						Iterator it = set.iterator();
						int i = 0;
						restrictions += " and d.divorg" + String.valueOf(j + 1)
								+ " in (";
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							restrictions += (i == set.size() - 1) ? div + ") "
									: div + ",";
							i++;
						}
					}
				}
			}
			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					restrictions += "and d.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						restrictions += (i == divGeos[0].length - 1) ? divGeos[0][i]
								+ ")"
								: divGeos[0][i] + ",";
					}
				}
			}

			String sqlQueryTotal = "SELECT COUNT(*) as total FROM drivers d "
					+ UtilityQuery.corporationDivisionsRestictionsSQL("d",
							userSessionData) + restrictions
					+ " AND d.id IN (SELECT driver FROM " + table + ")";
			Query queryTotal = session.createSQLQuery(sqlQueryTotal).addScalar(
					"total", Hibernate.INTEGER);
			total = (Integer) queryTotal.uniqueResult();

			String ids = "";
			if (count != -1) {
				String sqlQueryId = "SELECT id as id FROM drivers d "
						+ UtilityQuery.corporationDivisionsRestictionsSQL("d",
								userSessionData) + restrictions
						+ " AND d.id IN (SELECT driver FROM " + table
						+ ") order by firstname,lastname";
				Query queryId = session.createSQLQuery(sqlQueryId).addScalar(
						"id", Hibernate.INTEGER);
				if (count != -1) {
					queryId.setFirstResult(first);
					queryId.setMaxResults(count);
				}
				Iterator it = queryId.list().iterator();
				while (it.hasNext()) {
					ids += String.valueOf(it.next()) + ",";
				}
			}

			if (!(count != -1 && ids.length() == 0)) {
				String[] s = userSessionData.getFilter().getFields("d");
				String sqlQueryData = "SELECT d.id,d.firstname,d.lastname,d.birthdate,d.exclusiondate,d.contract,d.corporationid, "
						+ " dh.date, dh.id as reference, dh.type, dh.clasification, dh.result,c.resourcekey as country"
						+ s[0]
						+ " FROM drivers d,country c,"
						+ table
						+ " dh"
						+ s[1]
						+ " "
						+ UtilityQuery.corporationDivisionsRestictionsSQL("d",
								userSessionData)
						+ " AND d.id = dh.driver"
						+ s[2]
						+ " AND d.country = c.id "
						+ " AND dh.corporation = "
						+ String.valueOf(userSessionData.getFilter()
								.getCorporationId()) + " ";
				if (count != -1) {
					sqlQueryData += " AND d.id IN (0,"
							+ ids.substring(0, ids.length() - 1) + ") ";
				} else {
					sqlQueryData += restrictions;
				}
				sqlQueryData += " ORDER BY d.firstname, d.lastname, date, type ";
				SQLQuery queryData = session.createSQLQuery(sqlQueryData);
				queryData.addScalar("id", Hibernate.INTEGER);
				queryData.addScalar("firstname", Hibernate.STRING);
				queryData.addScalar("lastname", Hibernate.STRING);
				queryData.addScalar("birthdate", Hibernate.DATE);
				queryData.addScalar("exclusiondate", Hibernate.DATE);
				queryData.addScalar("contract", Hibernate.STRING);
				queryData.addScalar("corporationid", Hibernate.STRING);
				queryData.addScalar("date", Hibernate.STRING);
				queryData.addScalar("reference", Hibernate.INTEGER);
				queryData.addScalar("type", Hibernate.STRING);
				queryData.addScalar("clasification", Hibernate.STRING);
				queryData.addScalar("result", Hibernate.STRING);
				queryData.addScalar("country", Hibernate.STRING);
				StringTokenizer token = new StringTokenizer(s[3], ",");
				while (token.hasMoreTokens()) {
					queryData.addScalar(token.nextToken(), Hibernate.STRING);
				}

				Iterator values = queryData.list().iterator();
				HistoryDataType last = null;
				while (values.hasNext()) {
					HistoryDataType history = new HistoryDataType(
							(Object[]) values.next(), ultimaActualizacion);
					if (last == null) {
						last = history;
						result.add(history);
					} else {
						if (!last.equals(history)) {
							last = history;
							result.add(history);
						}
					}
				}
			}
		} catch (Exception e) {
			Object[] parameters = { firstname, lastname, status, divOrgs,
					divGeos, first, count };
			handler.getException(e, "getHistoryDrivers", userSessionData,
					parameters);
		}
		return new ListResult(result, total);
	}

	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverview,administrator"
	 */
	public ListResult getFOSAReportDrivers(
			Hashtable<String, String> inputParameters, Integer[][] divOrgs,
			Integer[][] divGeos, int first, int count,
			UserSessionData userSessionData) throws Exception {
		MemoryLog.getInstance().log(MemoryLog.START, "getFOSAReportDrivers",
				getClass());
		try {
			Session session = HibernateUtil.currentSession();

			Hashtable result = new Hashtable();
			Hashtable<String, Object> parameters = new Hashtable<String, Object>();
			String queryStr = UtilityQuery.corporationDivisionsRestictions(
					"driver", userSessionData);

			if (inputParameters.containsKey("firstName")
					&& !Util.empty((String) inputParameters.get("firstName"))) {
				queryStr += " AND LOWER(firstName) LIKE LOWER(:firstName) ";
				parameters.put("firstName", "%"
						+ inputParameters.get("firstName") + "%");
			}
			if (inputParameters.containsKey("lastName")
					&& !Util.empty((String) inputParameters.get("lastName"))) {
				queryStr += " AND LOWER(lastName) LIKE LOWER(:lastName) ";
				parameters.put("lastName", "%"
						+ inputParameters.get("lastName") + "%");
			}
			if (inputParameters.containsKey("corporationId")
					&& !Util.empty((String) inputParameters
							.get("corporationId"))) {
				queryStr += " AND corporationId = (:corporationId) ";
				parameters.put("corporationId", inputParameters
						.get("corporationId"));
			}
			if (inputParameters.containsKey("birthDate")) {
				Format dateFormat = new SimpleDateFormat("yyyy-MM-dd");
				queryStr += " AND birthDate = '"
						+ dateFormat.format(inputParameters.get("birthDate"))
						+ "' ";
			}

			HashSet set = new HashSet();
			String divOrgStr = "";
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					if (divOrgs[j] != null && divOrgs[j].length > 0
							&& !(divOrgs[j].length == 1 && divOrgs[j][0] == 0)) {
						divOrgStr = "";
						divOrgStr = " and driver.divOrg"
								+ String.valueOf(j + 1) + " in (";
						set.clear();
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]);
						}
						Iterator it = set.iterator();
						int i = 0;
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							divOrgStr += div;
							divOrgStr += (i == set.size() - 1) ? ") " : ",";
							i++;
						}
						queryStr += divOrgStr;
					}
				}
			}

			/* Modificacion de DivOrgs para Performance */
			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0
						&& !(divGeos[0].length == 1 && divGeos[0][0] == 0)) {
					queryStr += "and driver.corpCountry.pk.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						queryStr += divGeos[0][i];
						queryStr += (i == divGeos[0].length - 1) ? ")" : ",";
					}
				}
			}
			if (inputParameters.containsKey("status")
					&& !Util.empty((String) inputParameters.get("status"))) {
				switch (Integer
						.parseInt((String) inputParameters.get("status"))) {
				case DriverData.ACTIVE:
					queryStr += " and exclusionDate = null";
					break;
				case DriverData.EXCLUDED:
					queryStr += " and exclusionDate != null";
					break;
				}
			}

			if (inputParameters.containsKey("fines")
					&& !Util.empty((String) inputParameters.get("fines"))) {
				String fines = (String) inputParameters.get("fines");
				if (!fines.equals("0")) {
					if (fines.equals("1")) {
						queryStr += " and driver.id in (select event.driver.id from Fine as event where event.driver.id = driver.id and event.status <> 1 )";
					} else if (fines.equals("2")) {
						queryStr += " and "
								+ inputParameters.get("fineCount")
								+ " <= (select count(*) from Fine as event where event.driver.id = driver.id and event.status <> 1 )";
					} else if (fines.equals("3")) {
						queryStr += " and driver.id not in (select event.driver.id from Fine as event where event.driver.id = driver.id and event.status <> 1 )";
					}
				}
			}
			if (inputParameters.containsKey("accidents")
					&& !Util.empty((String) inputParameters.get("accidents"))) {
				String accidents = (String) inputParameters.get("accidents");
				if (!accidents.equals("0")) {
					if (accidents.equals("1")) {
						queryStr += " and driver.id in (select event.driver.id from Event as event where event.driver.id = driver.id and event.accident is not null and event.status <> 1 )";
					} else if (accidents.equals("2")) {
						queryStr += " and "
								+ inputParameters.get("accidentCount")
								+ " <= (select count(*) from Event as event where event.driver.id = driver.id and event.accident is not null and event.status <> 1 )";
					} else if (accidents.equals("3")) {
						queryStr += " and driver.id not in (select event.driver.id from Event as event where event.driver.id = driver.id and event.accident is not null and event.status <> 1 )";
					}
				}
			}
			if (inputParameters.containsKey("incidents")
					&& !Util.empty((String) inputParameters.get("incidents"))) {
				String incidents = (String) inputParameters.get("incidents");
				if (!incidents.equals("0")) {
					if (incidents.equals("1")) {
						queryStr += " and driver.id in (select event.driver.id from Event as event where event.driver.id = driver.id and event.incident is not null and event.status <> 1 )";
					} else if (incidents.equals("2")) {
						queryStr += " and "
								+ inputParameters.get("incidentCount")
								+ " <= (select count(*) from Event as event where event.driver.id = driver.id and event.incident is not null and event.status <> 1 )";
					} else if (incidents.equals("3")) {
						queryStr += " and driver.id not in (select event.driver.id from Event as event where event.driver.id = driver.id and event.incident is not null and event.status <> 1 )";
					}
				}
			}

			if (userSessionData.isForest()
					&& userSessionData.getFilter().getCorporationId()
							.intValue() != CorporationData.KLABIN) {

				String bps = (String) inputParameters.get("bps");
				if (bps != null && bps.equals("yes")) {
					queryStr += " and bpsregistry is not null";
				} else if (bps.equals("no")) {
					queryStr += " and bpsregistry is null";
				}

				String apt = (String) inputParameters.get("aptitudResult");
				String type = (String) inputParameters.get("aptitudStatus");
				if (apt != null && Integer.parseInt(apt) == DriverData.APT) {
					queryStr += " and id in (select test.pk.driver from AptitudTest test where test.expiry > (:dateTest) and test.apt = 't')";
					parameters
							.put("dateTest", Calendar.getInstance().getTime());
				} else if (apt != null
						&& Integer.parseInt(apt) == DriverData.NOT_APT) {
					queryStr += " and id not in (select test.pk.driver from AptitudTest test where test.expiry > (:dateTest) and test.apt = 't')";
					parameters
							.put("dateTest", Calendar.getInstance().getTime());
				} else if (type != null
						&& Integer.parseInt(type) == DriverData.NOT_EXPIRED) {
					queryStr += " and id in (select test.pk.driver from AptitudTest test where test.expiry > (:dateTest))";
					parameters
							.put("dateTest", Calendar.getInstance().getTime());
				} else if (type != null
						&& Integer.parseInt(type) == DriverData.EXPIRED) {
					queryStr += " and id not in (select test.pk.driver from AptitudTest test where test.expiry > (:dateTest))";
					parameters
							.put("dateTest", Calendar.getInstance().getTime());
				}

				String controlResult = (String) inputParameters
						.get("alcoholResult");
				type = (String) inputParameters.get("alcoholStatus");
				Calendar c = Calendar.getInstance();
				c.add(Calendar.YEAR, -1);
				if (controlResult != null
						&& Integer.parseInt(controlResult) != DriverData.ALL) {
					queryStr += " and id in (select control.pk.driver from AlcoholControl control where control.pk.date > (:dateControl) and control.result = (:result))";
					parameters.put("dateControl", c.getTime());
					parameters.put("result", controlResult);
				} else if (type != null
						&& Integer.parseInt(type) == DriverData.NOT_EXPIRED) {
					queryStr += " and id in (select control.pk.driver from AlcoholControl control where control.pk.date > (:dateControl))";
					parameters.put("dateControl", c.getTime());
				} else if (type != null
						&& Integer.parseInt(type) == DriverData.EXPIRED) {
					queryStr += " and id not in (select control.pk.driver from AlcoholControl control where control.pk.date > (:dateControl))";
					parameters.put("dateControl", c.getTime());
				}

				String postiveAlcohol = (String) inputParameters
						.get("postiveAlcohol");
				if (postiveAlcohol != null
						&& Integer.parseInt(postiveAlcohol) == DriverData.ANY_POSITIVE) {
					queryStr += " and id in (select control.pk.driver from AlcoholControl control where control.result = "
							+ DriverData.POSITIVE + ")";
				} else if (postiveAlcohol != null
						&& Integer.parseInt(postiveAlcohol) == DriverData.WITHOUT_POSITIVE) {
					queryStr += " and id not in (select control.pk.driver from AlcoholControl control where control.result = "
							+ DriverData.POSITIVE + ")";
				}
			}

			Query query1 = session
					.createQuery("select count(driver) from Driver as driver "
							+ queryStr);
			Enumeration keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query1.setParameter(parameter, parameters.get(parameter));
			}
			Integer total = new Integer(((Long) query1.uniqueResult())
					.intValue());

			queryStr += " order by lastname";
			Query query2 = session
					.createQuery("SELECT DISTINCT driver FROM Driver AS driver "
							+ queryStr);
			keys = parameters.keys();
			while (keys.hasMoreElements()) {
				String parameter = (String) keys.nextElement();
				query2.setParameter(parameter, parameters.get(parameter));
			}
			if (count != -1) {
				query2.setFirstResult(first);
				query2.setMaxResults(count);
			}
			List userColl = query2.list();
			Iterator iter = userColl.iterator();
			userColl = null;
			String ids = "";
			while (iter.hasNext()) {
				Driver driver = (Driver) iter.next();
				ids += (ids.length() == 0) ? String.valueOf(driver.getId())
						: "," + String.valueOf(driver.getId());
				FOSADriver fosaDriver = (FOSADriver) driver
						.getFOSADriverReportData((String) inputParameters
								.get("type"));
				result.put(driver.getId(), fosaDriver);

				Object[][] provisionals = getProvisionalBTW(driver.getId(),
						userSessionData);
				if (provisionals.length > 0) {
					fosaDriver.setCount(1);
					fosaDriver.setLast((Date) provisionals[0][0]);
					if (provisionals[0][1]
							.equals(CEPAActivityConstants.APRUVED)) {
						Calendar c = Calendar.getInstance();
						c.setTime((Date) provisionals[0][0]);
						c.add(Calendar.YEAR, 2);
						fosaDriver.setLastExpiry(c.getTime());
					} else {
						fosaDriver.setLastExpiry(null);
					}
				}
			}

			if (ids.length() > 0) {
				String activities = "'" + CEPAActivityConstants.PESADOS_1
						+ "','" + CEPAActivityConstants.BTW3 + "','"
						+ CEPAActivityConstants.BTW3UPDATE + "','"
						+ CEPAActivityConstants.BTW3RENOVACION + "'";
				activities += ",'" + CEPAActivityConstants.BTW1 + "','"
						+ CEPAActivityConstants.BTW1_NEW_FORM_TABLET + "','"
						+ CEPAActivityConstants.BTW2 + "','"
						+ CEPAActivityConstants.BTW2_NEW_FORM_TABLET + "','"
						+ CEPAActivityConstants.BTW3SEGUNDARENOVACION + "','"
						+ CEPAActivityConstants.BTW3TERCERARENOVACION + "','"
						+ CEPAActivityConstants.BTW3CUARTARENOVACION + "'";
				activities += ",'"
						+ CEPAActivityConstants.EVALUACIONENCABINAPESADO
						+ "','" + CEPAActivityConstants.EVALUACIONENCABINA
						+ "'";
				if (userSessionData.getCorporationId() == CorporationData.WEYERHAEUSER) {
					activities += ",'" + CEPAActivityConstants.RADAR + "','"
							+ CEPAActivityConstants.INDUCTION_TRAINING + "'";
				}
				String sqlCount = "SELECT ar.driver,ca.type,count(*) as count, max(ca.date) as date, max(ca.dateexpiry) as dateexpiry,ar.note "
						+ "FROM activityregistry ar "
						+ "JOIN cepaactivity ca ON ca.activityid = ar.activity "
						+ "WHERE ca.type IN ("
						+ activities
						+ ") "
						+ "AND ar.driver IN ("
						+ ids
						+ ") AND ca.statE = 'datatype.scheduledactivitystate.dictada' GROUP BY driver,type,note ORDER BY date DESC";
				Query q = session.createSQLQuery(sqlCount).addScalar("driver",
						Hibernate.INTEGER).addScalar("type", Hibernate.STRING)
						.addScalar("count", Hibernate.INTEGER).addScalar(
								"date", Hibernate.DATE).addScalar("dateexpiry",
								Hibernate.DATE).addScalar("note",
								Hibernate.STRING);
				Iterator it = q.list().iterator();
				while (it.hasNext()) {
					Object[] data = (Object[]) it.next();
					FOSADriver fosaDriver = (FOSADriver) result.get(data[0]);
					if (data[1].equals(CEPAActivityConstants.PESADOS_1)
							|| data[1].equals(CEPAActivityConstants.BTW1)
							|| data[1].equals(CEPAActivityConstants.BTW1_NEW_FORM_TABLET)
							|| data[1].equals(CEPAActivityConstants.BTW2)
							|| data[1].equals(CEPAActivityConstants.BTW2_NEW_FORM_TABLET)
							|| data[1].equals(CEPAActivityConstants.BTW3UPDATE)
							|| data[1].equals(CEPAActivityConstants.BTW3RENOVACION)
							|| data[1].equals(CEPAActivityConstants.BTW3SEGUNDARENOVACION)
							|| data[1].equals(CEPAActivityConstants.BTW3TERCERARENOVACION)
							|| data[1].equals(CEPAActivityConstants.BTW3CUARTARENOVACION)
							|| data[1].equals(CEPAActivityConstants.BTW3)) {

						if (fosaDriver.getCount() != null) {
							fosaDriver.setCount((Integer) data[2]
									+ fosaDriver.getCount());
						} else {
							fosaDriver.setCount((Integer) data[2]);
						}
						fosaDriver.addLast((Date) data[3], data);
					} else if (data[1].equals(CEPAActivityConstants.RADAR)) {
						if (fosaDriver.getLastRadar() == null) {
							fosaDriver.setLastRadar((Date) data[3]);
							fosaDriver.setRadarNote((String) data[5]);
						}
					} else if (data[1]
							.equals(CEPAActivityConstants.INDUCTION_TRAINING)) {
						if (fosaDriver.getLastInduction() == null) {
							fosaDriver.setLastInduction((Date) data[3]);
						}
					} else {
						if (fosaDriver.getLastEC() == null) {
							fosaDriver.setLastEC((Date) data[3]);
						}
					}
				}
			}

			session.close();

			Enumeration enumDriver = result.elements();
			Collection drivers = new LinkedList();
			while (enumDriver.hasMoreElements()) {
				drivers.add(enumDriver.nextElement());
			}

			MemoryLog.getInstance().log(MemoryLog.END, "getFOSAReportDrivers",
					getClass());
			return new ListResult(drivers, total.intValue());
		} catch (Exception e) {
			Object[] parameters = { inputParameters, divOrgs, divGeos, first,
					count };
			handler.getException(e, "getFOSAReportDrivers", userSessionData,
					parameters);
		}
		return null;
	}

	private boolean dateEquals(Date date1, Date date2) {
		Calendar d1 = Calendar.getInstance();
		d1.setTime(date1);
		Calendar d2 = Calendar.getInstance();
		d2.setTime(date2);
		return (d1.get(Calendar.YEAR) == d2.get(Calendar.YEAR)
				&& d1.get(Calendar.MONTH) == d2.get(Calendar.MONTH) && d1
				.get(Calendar.DATE) == d2.get(Calendar.DATE));
	}

	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name =
	 *                 "administrator,driveredit,eventcreate,finecreate,driverupdate,drivertests"
	 */
	public Collection getDriverUnconformities(Integer driver,
			UserSessionData userSessionData) throws Exception {
		Collection unconformities = new LinkedList();
		try {
			Session session = HibernateUtil.currentSession();
			String sql = "SELECT u FROM Unconformity "
					+ UtilityQuery.corporationDivisionsRestictions(
							"u.pk.driver", userSessionData);
			Query q = session.createQuery(sql);
			Iterator it = q.list().iterator();
			while (it.hasNext()) {
				unconformities.add(((Unconformity) it.next()).getData());
			}
		} catch (Exception e) {
			Object[] parameters = { driver };
			handler.getException(e, "getDriverUnconformities", userSessionData,
					parameters);
		}
		return unconformities;
	}

	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,query"
	 */
	public ListResult getCombinedHistory(Hashtable parameters, int first,
			int count, UserSessionData userSessionData) throws Exception {
		Integer total = new Integer(0);
		Collection result = new LinkedList();
		String eventClasification = "";
		try {
			Session session = HibernateUtil.currentSession();
			Date ultimaActualizacion = Calendar.getInstance().getTime();

			String restrictions = "";
			if (parameters.containsKey("firstName")) {
				restrictions += " and LOWER(d.firstname) like '%"
						+ ((String) parameters.get("firstName")).toLowerCase()
						+ "%' ";
			}
			if (parameters.containsKey("lastName")) {
				restrictions += " and LOWER(d.lastname) like '%"
						+ ((String) parameters.get("lastName")).toLowerCase()
						+ "%' ";
			}

			switch (Integer.parseInt((String) parameters.get("status"))) {
			case DriverData.ACTIVE:
				restrictions += " and d.exclusionDate is null ";
				break;
			case DriverData.EXCLUDED:
				restrictions += " and d.exclusionDate is not null ";
				break;
			}

			Integer[][] divOrgs = (Integer[][]) parameters.get("divorgs");
			if (divOrgs != null && divOrgs.length > 0) {
				for (int j = 0; j < divOrgs.length; j++) {
					HashSet set = new HashSet();
					if (divOrgs[j] != null && divOrgs[j].length > 0) {
						for (int i = 0; i < divOrgs[j].length; i++) {
							set.add(divOrgs[j][i]);
						}
						Iterator it = set.iterator();
						int i = 0;
						restrictions += " and d.divorg" + String.valueOf(j + 1)
								+ " in (";
						while (it.hasNext()) {
							String div = ((Integer) it.next()).toString();
							restrictions += (i == set.size() - 1) ? div + ") "
									: div + ",";
							i++;
						}
					}
				}
			}
			Integer[][] divGeos = (Integer[][]) parameters.get("divgeos");
			if (divGeos != null) {
				if (divGeos[0] != null && divGeos[0].length > 0) {
					restrictions += " AND d.country in (";
					for (int i = 0; i < divGeos[0].length; i++) {
						restrictions += (i == divGeos[0].length - 1) ? divGeos[0][i]
								+ ")"
								: divGeos[0][i] + ",";
					}
				}
			}

			String in = "";
			String notIn = "";

			if (Integer.parseInt((String) parameters.get("activities")) == 0) {
				notIn += " SELECT DISTINCT driver FROM driverHistory WHERE corporation = "
						+ userSessionData.getFilter().getCorporationId()
						+ " AND type IN ('web.activity.view','driver.history.commentarydrive') ";
			} else {
				in += " SELECT DISTINCT driver FROM driverHistory WHERE corporation = "
						+ userSessionData.getFilter().getCorporationId()
						+ " AND type IN ('web.activity.view','driver.history.commentarydrive') ";
				if (parameters.containsKey("activityType")) {
