    /**
     * @ejb.permission role-name ="administrator,driverview"
     * @ejb.interface-method
     */
    public ArrayList<ReportPlanData> getGlobalReportPlan(String search,int order,UserSessionData userSessionData) throws Exception {
        ArrayList<ReportPlanData> result=new ArrayList<ReportPlanData>();

        try {

            if(search!=null){
                search=search.toUpperCase();
            }
            Session session = HibernateUtil.currentSession();
            String corpRestrictions = UtilityQuery.corporationDivisionsRestictionsSQL("d", userSessionData);
            Calendar cal=Calendar.getInstance();
            Query querySQL=session.createSQLQuery("select d.id as id,d.firstName as firstName,d.lastName as lastName from drivers as d "+corpRestrictions+(search!=null && search.trim().length()>0?(" and (d.firstName like '%"+search+"%' or d.lastName like '%"+search+"%')"):(""))+" and ( d.id in ( select driver from anualplans where year="+cal.get(Calendar.YEAR)+") or d.id in(select driver from mitigationplans))").addScalar("id",Hibernate.INTEGER).addScalar("firstName",Hibernate.STRING).addScalar("lastName",Hibernate.STRING);

            Iterator<Object[]> iterDriverId=querySQL.list().iterator();
            while(iterDriverId.hasNext()){
                Object[] row=iterDriverId.next();
                Integer driverId=(Integer) row[0];
                String firstName=(String) row[1];
                String lastName=(String) row[2];
                ReportPlanData data=new ReportPlanData(order);
                DriverData dataDriver=new DriverData();
                dataDriver.setId(driverId);
                dataDriver.setFirstName(firstName);
                dataDriver.setLastName(lastName);
                data.setDriverData(dataDriver);
                data.setAnualPlans(getAnualPlan(driverId, userSessionData));
                data.setMitigationPlan(getMitigationPlan(driverId, userSessionData));
                result.add(data);
            }


        } catch (Exception e) {
            Object[] p = {};
            handler.getException(e, "getGlobalReportPlan", userSessionData, p);
        }
        return result;
    }

    /**
     * @ejb.permission role-name ="administrator,query"
     * @ejb.interface-method
     */
   public ArrayList emptyFields(Text messages,UserSessionData userSessionData) throws Exception {
		ArrayList<ArrayList<Object>> sheet = new ArrayList<ArrayList<Object>>();
    	try {
            Session session = HibernateUtil.currentSession();
            String corpRestrictionsD = UtilityQuery.corporationDivisionsRestictionsSQL("d", userSessionData);
            String corpRestrictionsV = UtilityQuery.corporationDivisionsRestictionsSQL("v", userSessionData);

            String sql1 = "select matricula, trade, model, year, v1.resourcekey AS divV1, v2.resourcekey AS divV2, v3.resourcekey AS divV3, " +
