					"join divorgitemlevel3s v9 on v9.id = v8.divorgitemlevel3 " +
					corpRestrictionsV + " and v.exclusiondate IS NULL AND v.driver IS NULL";
            String sql3 = "select NULL AS matricula, NULL AS trade, NULL AS model, NULL AS year, NULL AS divV1, " +
            		"NULL AS divV2, NULL AS divV3, " +
            		"NULL AS divV4, NULL AS divV5, NULL AS divV6, NULL AS divV7, " +
            		"NULL AS divV8, NULL AS divV9" +
            		",NULL AS permissionexpiry, NULL AS chasisnumber, NULL AS engine, firstname, lastname, " +
            		"d1.resourcekey AS divD1, d2.resourcekey AS divD2, d3.resourcekey AS divD3, d4.resourcekey AS divD4, " +
            		"d5.resourcekey AS divD5, d6.resourcekey AS divD6, d7.resourcekey AS divD7, d8.resourcekey AS divD8, " +
            		"d9.resourcekey AS divD9, birthdate, sex, city,licenseexpiry, officeaddress, email, personaladdress, " +
            		"corporationid, licensenumber, d.inclusiondate, " +
            		"employee, licensenotexpiry, superviser, manager, idDallas " +
					"from drivers d " +
					"join divorgitemlevel1s d1 on d1.id = d.divorg1 " +
					"join divorgitemlevel2s d2 on d2.id = d1.divorgitemlevel2 " +
					"join divorgitemlevel3s d3 on d3.id = d2.divorgitemlevel3 " +
					"join divorgitemlevel1s d4 on d4.id = d.divorg2 " +
					"join divorgitemlevel2s d5 on d5.id = d4.divorgitemlevel2 " +
					"join divorgitemlevel3s d6 on d6.id = d5.divorgitemlevel3 " +
					"join divorgitemlevel1s d7 on d7.id = d.divorg3 " +
					"join divorgitemlevel2s d8 on d8.id = d7.divorgitemlevel2 " +
					"join divorgitemlevel3s d9 on d9.id = d8.divorgitemlevel3 " +
					corpRestrictionsD + " and exclusiondate is null and d.id not in (select driver from vehicles where corporation = 73 and exclusiondate is null and driver is not null)";
            SQLQuery query = session.createSQLQuery(sql1 + " UNION ("+sql2+") UNION ("+sql3+")");
            query.addScalar("matricula", Hibernate.STRING);
            query.addScalar("trade", Hibernate.STRING);
            query.addScalar("model", Hibernate.STRING);
            query.addScalar("year", Hibernate.INTEGER);
            query.addScalar("divV1", Hibernate.STRING);
