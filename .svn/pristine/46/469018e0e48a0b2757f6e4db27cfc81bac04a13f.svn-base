	/**
	 * @ejb.permission role-name ="administrator,driveredit,driverupdate,eventcreate,finecreate,driverviewowndata,drivertests,usercreate,doorcontrol,driverbayerdata,jjreporter"
	 * @ejb.interface-method
	 */
	public Collection<String> getManagerMonitor(Integer driver, UserSessionData userSessionData)  throws Exception {
		Collection<String> values = new LinkedList<String>();
		try {
	        Session session = HibernateUtil.currentSession();

	        Query q = session.createSQLQuery("select d1.resourcekey as manager, d2.resourcekey as monitor from drivers d " +
	        		"join divorgitemlevel1s d1 on d1.id = d.divorg3 " +
	        		"join divorgitemlevel2s d2 on d2.id = d1.divorgitemlevel2 " +
	        		"where d.id = "+driver).addScalar("manager", Hibernate.STRING).addScalar("monitor", Hibernate.STRING);
	        Iterator it = q.list().iterator();
	        while(it.hasNext()) {
	        	Object[] data = (Object[]) it.next();
	        	for(int i = 0; i < data.length; i++) {
	    	        Query q2 = session.createSQLQuery("select email from drivers where corporation = 73 and trim(lower(firstname || ' ' || lastname)) = '" +String.valueOf(data[i]).toLowerCase()+"'").addScalar("email",Hibernate.STRING);
	    	        Iterator it2 = q2.list().iterator();
	    	        if(it2.hasNext())
	    	        	values.add(it2.next().toString());
	        	}
	        }
		} catch (Exception e) {
			Object[] p = {};
			handler.getException(e, "getManagerMonitor", userSessionData, p);
		}
		return values;
	}

