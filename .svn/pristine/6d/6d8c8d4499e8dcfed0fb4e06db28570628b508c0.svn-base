<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.fleet.tables" >
	<class name="RegionBlock" table="regionblock">
	       
        <composite-id class="RegionBlockPK" name="id">
	        <key-property	name="regionId"	type="java.lang.Integer"	column="regionId"/>
	        <key-property	name="userId"	type="java.lang.String"		column="userid"/>
	        <key-property	name="date"		type="java.util.Date"		column="date"/>
        </composite-id>

        <property 	name="corporationId"	type="java.lang.Integer"	column="corporationId" not-null="true"/>
		<property 	name="regionName"	type="java.lang.String"		column="regionName" />

       	<property name="blockMonth" type="java.lang.Integer" not-null="true">
       		<column name="blockMonth" default="1"/>
       	</property>
       	<property name="blockYear" type="java.lang.Integer" not-null="true"	>
       		<column name="blockYear" default="1998"	/>
       	</property>
	    <property 	name="comment"	type="java.lang.String"	column="comment" />

    </class>
</hibernate-mapping>
