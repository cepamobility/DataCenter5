package communication.alert;

import java.io.Serializable;

public class ContractorDataData implements Serializable{

	private Integer id;
	private Integer corporation;
	private String mail;
	private String mail2;
	private Integer state;

    public ContractorDataData(Integer id) {
    	this.id = id;
      
     }
    
    public ContractorDataData(Integer id, Integer corporation, String mail, Integer state) {
    	this.id = id;
        this.corporation = corporation;
        this.mail = mail;
        this.state = state;
     }
    
    
    /**
	 * @return Returs the id
	 */
	public Integer getId() {
		return id;
	}
	
	/**
	 * @return Returs the corporation
	 */
	public Integer getCorporation() {
		return corporation;
	}
	
	/**
	 * @return Returs the mail
	 */
	public String getMail() {
		return mail;
	}
	/**
	 * @return Returs the state
	 */
	public Integer getState() {
		return state;
	}
	
	/**
	 * @param id The id to set.
	 */
	public void setId(Integer id) {
		this.id = id;
	}
	
	/**
	 * @param corporation The corporation to set.
	 */
	public void setCorporation(Integer corporation) {
		this.corporation = corporation;
	}
	
	/**
	 * @param mail The mail to set.
	 */
	public void setMail(String mail) {
		this.mail = mail;
	}
	
	/**
	 * @param state The state to set.
	 */
	public void setState(Integer state) {
		this.state = state;
	}

	/**
	 * @return the mail2
	 */
	public String getMail2() {
		return mail2;
	}

	/**
	 * @param mail2 the mail2 to set
	 */
	public void setMail2(String mail2) {
		this.mail2 = mail2;
	}
	
	
	
	
	/*public int compareTo(Object anotheritem){
    	ContractorDataData another = (ContractorDataData)anotheritem;
    	return order.compareTo(another.getOrder());
      }*/
    
}
