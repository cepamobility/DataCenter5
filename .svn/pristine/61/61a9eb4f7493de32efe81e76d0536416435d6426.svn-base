<%@page import="presentation.translator.web.driver.DPATelematicControlListForm"%>
<%@page import="communication.driver.report.DPATelematicControlFilter"%>
<%@page import="communication.datatype.DataTypeConstants"%>
<%@page import="communication.driver.tables.TelematicControlData"%>
<%@page import="persistence.driver.tables.TelematicControl"%>
<%@page language="java" 
	errorPage="../exception.jsp" 
	import="business.*"
	import="business.activity.*"
	import="business.administration.user.*"
	import="communication.language.*"
	import="communication.security.*"
	import="communication.administration.user.tables.*"
	import="communication.vehicle.tables.*"
	import="communication.util.*"
 	import="presentation.translator.web.util.*"
 	import="presentation.translator.web.activity.schedule.*" 	
 	import="presentation.translator.web.vehicle.*"
 	import="communication.administration.user.*" 	
 	import="communication.datatype.tables.ActivityTypeDataType"
	import="business.vehicle.VehicleReportFacade"
	import="java.util.*"	
	import="org.apache.struts.action.DynaActionForm"
	import="communication.activity.tables.*"
%>
<%@ taglib uri="/WEB-INF/struts-html.tld"
        prefix="html"
%>
<%!
	RequestDispatcher dispatcher; 
	Text messages; SystemAccess sys;
	UserSessionData userSessionData; 
	VehicleCheckData vehicleCheck;
	TelematicControlData telematicControl;
	VehicleData vehicleData;
	String idReferido;
	String mode;
	String id;	
%>
<%
	sys = (SystemAccess)session.getAttribute("SystemAccess");
	userSessionData=sys.getUserSessionData();	

	
	
	String check = Util.checkPermission(sys,SecurityConstants.VIEW_DRIVER_LIST);
	
	
	if (check!=null) { 
		response.sendRedirect(request.getContextPath()+check);	
	}else {
		messages=sys.getText();
	
		dispatcher=request.getRequestDispatcher("/util/jsp/message.jsp");
		dispatcher.include(request,response);

		DPATelematicControlListForm form=new DPATelematicControlListForm();
								 
		if(request.getAttribute("DPATelematicControlListForm")!=null){
			form=(DPATelematicControlListForm) request.getAttribute("DPATelematicControlListForm");
		}else if(session.getAttribute("DPATelematicControlListForm")!=null){
			form=(DPATelematicControlListForm) session.getAttribute("DPATelematicControlListForm");
		}
		
		session.setAttribute("DPATelematicControlListForm", form);
%>	

<%@page import="business.vehicle.VehicleReportFacadeBean"%>

<html:html>

<LINK REL=StyleSheet HREF="../util/css/estilo.css" TYPE="text/css">

<head>
	<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">
</head>

<body>
	 
	<center>
	<html:form action="/DPATelematicControlList" styleId="DPATelematicControlList" >
		
		<table width="768" border="0" cellspacing="0" cellpadding="0">  
			<tr class="guide1">
			<%
				String page14 = "../component/titlecomponent.jsp?title="+messages.getText("generic.driver.telematiccontrol");
			%>
				<jsp:include  page='<%=page14 %>' />
  			</tr>
      		<tr>
				<jsp:include  page="../component/spaceline.jsp" />
  			</tr>
		<tr> 
			<td height="40" colspan="3" valign="middle">
<%
		String page13 = "../component/utilityboxtop.jsp?title="+messages.getText("driver.telematiccontrol.data");
				%>
				<jsp:include  page='<%=page13 %>' />
				<table width="100%" height="60" border="0" cellpadding="0" cellspacing="0">
   	 				<tr> 
       					<td width="50%" align="left" class="texts">        
   							<%= messages.getText("generic.messages.datestart")%><%=" ( "+messages.getText("generic.messages.dateformat")+" ) "%>
						</td>
						<td width="50%" align="right" class="linetwo">
							
							<html:text style="width:30;"   property="startDay" styleClass="input"  />&nbsp;/&nbsp;                
							<html:text style="width:30;"  property="startMonth" styleClass="input"  />&nbsp;/&nbsp; 
							<html:text style="width:60;"  property="startYear" styleClass="input"  />&nbsp;         
						</td>
   					</tr>
   					<tr> 
       					<td width="50%" align="left" class="texts">        
   							<%= messages.getText("generic.messages.dateend")%><%=" ( "+messages.getText("generic.messages.dateformat")+" ) "%>
						</td>
						<td width="50%" align="right" class="linetwo">
							
							<html:text style="width:30;" property="endDay" styleClass="input"  />&nbsp;/&nbsp;                
							<html:text style="width:30;"   property="endMonth" styleClass="input"  />&nbsp;/&nbsp; 
							<html:text style="width:60;"   property="endYear" styleClass="input"  />&nbsp;         
						</td>
   					</tr>
   					<tr><td colspan=2>&nbsp</td></tr>
   					<tr > 
       					<td width="50%" align="left" class="texts">        
   							<%= messages.getText("driver.telematic.driver")%>
						</td>
						<td width="50%" align="right" class="linetwo">
						 <html:text style=""   property="text" styleClass="input"  />
						</td>
   					</tr>
   					<tr><td colspan=2>&nbsp</td></tr>
   					<tr><td colspan=2 align="right"><input name="button2" type="button" onclick="DPATelematicControlList.submit();" value='<%=messages.getText("generic.messages.search")%>' class="input"/></td></tr>
				</table>
				
				<jsp:include  page="../component/utilityboxbottom.jsp" />
			</td>
		</tr>  
      	<tr>
			<jsp:include  page="../component/spaceline.jsp" />
  		</tr>
  		              
	</table>
	</html:form>
	</center>
	</body>
	
</html:html>
<%
	}
%>
