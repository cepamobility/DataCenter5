		body += "<tr height=\"12\" style=\"min-height:12.0pt\">";
		body += "<td height=\"12\" style=\"min-height:12.0pt\"><b><font size=\"4\"><br></font></b></td><td></td>";
		body += "<td></td>";
		body += "</tr>";
		body += "<tr height=\"12\" style=\"min-height:12.0pt\">";
		body += "<td height=\"12\" style=\"min-height:12.0pt\"><br></td></tr></tbody></table><br>";
		body += "<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"655\" style=\"font-size:14px;border-collapse:collapse;width:655pt\">";
		body += "<colgroup><col width=\"655\" style=\"width:555pt\">";
		body += "</colgroup><tbody><tr height=\"20\" style=\"min-height:20.0pt\">";
		body += "<td height=\"20\" width=\"655\" style=\"min-height:20.0pt;width:655pt\"><font size=\"2\"><b><font color=\""+green+"\">Pontua&ccedil;&atilde;o Baixa ";
		body += "- 2.00 a 4.25</font></b><span><b><font color=\""+green+"\">&nbsp;</font></b>&nbsp; </span><font color=\""+yellow+"\"><b>Pontua&ccedil;&atilde;o M&eacute;dia - de";
		body += " 4.25 a 6.50</b></font><span>&nbsp;</span></font><b><font color=\""+red+"\" size=\"2\">Pontua&ccedil;&atilde;o Alta - 6.50 a ";
		body += "10.0 (oportunidade de melhoria)</font><br><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Helvetica\"><font color=\"#232323\"><br></font></div>";
		body += "<div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Helvetica\"><font color=\"#232323\">Quanto maior for a pontua&ccedil;&atilde;o, maior tamb&eacute;m ser&aacute; a sua oportunidade de melhoria.&nbsp;</font></div></b></td></tr></tbody></table>";
		body += "<span style=\"border-collapse:collapse\"><b><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Helvetica;display:inline!important\">";
		body += "<font color=\"#232323\">Assim, a pior pontua&ccedil;&atilde;o que voc&ecirc; pode obter ser&aacute; 10.0. Isso indica que voc&ecirc; que voc&ecirc; atribuiu a menor pontua&ccedil;&atilde;o poss&iacute;vel para os itens que s&atilde;o considerados como extremamente importantes.</font></div></b></span><span style=\"font-size:16px\">";
		body += "<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"655\" style=\"border-collapse:collapse;width:555pt\"></table></span><span style=\"border-collapse:collapse\"><b><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Helvetica;display:inline!important\">";
		body += "<font color=\"#232323\">A melhor pontua&ccedil;&atilde;o poss&iacute;vel &eacute; 2.0 e indicar&aacute; que voc&ecirc; atribuiu a maior pontua&ccedil;&atilde;o para itens considerados importantes de acordo com a opini&atilde;o dos especialistas.</font></div></b></span><span style=\"font-size:16px\"></span><b></b></font>";
		body += "<br><br><div><span style=\"border-collapse:collapse\">";
		body += "<font face=\"Calibri\"><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 10px/normal Helvetica\">1 - <b>ATITUDE: </b>Deixar-se afetar negativamente por mudan&ccedil;as nas condi&ccedil;&otilde;es de tr&acirc;nsito, press&otilde;es de hor&aacute;rios, distra&ccedil;&otilde;es, problemas pessoais etc...</div>";
		body += "<div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 10px/normal Helvetica\">2 - <b>MANUTEN&ccedil;&atilde;O</b>: Cuidados com as condi&ccedil;&otilde;es do ve&iacute;culo ( manuten&ccedil;&atilde;o, limpeza, itens de seguran&ccedil;a, revis&otilde;es tec...)</div>";
		body += "<div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 10px/normal Helvetica\">3 - <b>SA&Iacute;DA: </b>Preocupa&ccedil;&atilde;o com procedimentos de seguran&ccedil;a antes de sair com o ve&iacute;culo ( ajustes dos espelhos, ajuste do assento, revis&atilde;o do itiner&aacute;rio etc...)</div>";
		body += "<div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 10px/normal Helvetica\">4 - <b>CRUZAMENTOS: </b>Redobrar os cuidados nos cruzamentos tais como : Reduzir previamente a velocidade, n&atilde;o entrar sem os devidos cuidados mesmo com o sinal no verde, sinalizar as inten&ccedil;&otilde;es para outros motoristas etc...&nbsp;</div>";
		body += "<div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 10px/normal Helvetica\">5 - <b>ESTACIONAMENTO</b>: Estacionar em locais seguros, de r&eacute; ( sempre que poss&iacute;vel ), observar movimenta&ccedil;&otilde;es antes de sair.</div>";
		body += "<div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 10px/normal Helvetica\">6 - <b>ESPA&Ccedil;AMENTO</b>: Observar dist&acirc;ncia de seguimento ( regra dos 2 ou 4 segundos ), cuidados com os pontos-cegos, posicionar-se corretamente nas faixas, evitar freadas bruscas, ter sempre rotas de escape etc...</div>";
		body += "<div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 10px/normal Helvetica\">7 - <b>GERAL: </b>Obedecer as regras de tr&acirc;nsito, evitar dirigir cansado, com sono, n&atilde;o comer ou mexer em nada ao&nbsp;dirigir, estar sempre preparado para quaisquer emereg&ecirc;ncias, sinalizar sempre as inten&ccedil;&otilde;es etc...</div>";
		body += "<div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 10px/normal Helvetica\">8 - <b>PERCEP&Ccedil;&Atilde;O</b>: Observar tudo ao redor ( frente, atr&aacute;s, de lado ), aten&ccedil;&atilde;o Ã s manobras de outros motoristas, verificar os espelhos retrovisores a cada 5 - 7 segundos, aten&ccedil;&atilde;o aos ve&iacute;culos colados atr&aacute;s e com o tr&acirc;nsito Ã  frente. &nbsp; &nbsp;</div>";
		body += "</font></span></div>";
		
		body += getFooter(opGroup,isMedical);
		return body;
	}

    private String getFooter(String opGroup, boolean isMedical) {
		String footer = "<br><br><div><span style=\"border-collapse:collapse\">";
		if(isMedical) {
			footer += "<font face=\"Calibri\"><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 18px/normal Helvetica\">Equipe SAFE Fleet</div>";
			footer += "</font></span></div>";
			footer += "<p><img src=\"cid:figura1\" alt=\"\"></p>";
		} else {
			footer += "<font face=\"Calibri\"><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 18px/normal Helvetica\">Equipe SAFE Fleet</div>";
			footer += "<div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 16px/normal Helvetica\">"+opGroup+"Brasil</div>";
			footer += "</font></span></div>";
		}
		return footer;
	}

	private String createManagerBody(String manager,String driver,String[] results, String opGroup, boolean isMedical) {
    	
    	double total = 0;
    	for(int i = 0; i < results.length;  i++) {
    		total += Double.parseDouble(results[i]);
    	}
    	total = total / 8.0;
    	total = Math.round(total * Math.pow(10,2)) / Math.pow(10,2);
    	String green = "#355724";
    	String yellow = "#FFC000";
    	String red = "red";
    	String extra = "";

    	
		String body = "";
