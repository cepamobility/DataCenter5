			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">&nbsp;</span>";
			body += "</div>";
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">";
			body += "		&Eacute; muito importante que voc&ecirc; observe os itens que foram identificados como oportunidades de melhoria ";
			body += "		para que voc&ecirc; possa cada vez mais aperfei&ccedil;oar suas habilidades como motorista.";
			body += "	</span>";
			body += "</div>";
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">&nbsp;</span>";
			body += "</div>";
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">";
			body += "		Se voc&ecirc; recebeu tamb&eacute;m algum registro de reconhecimento, &eacute; um bom sinal para que voc&ecirc; continue dirigindo ";
			body += "		sempre de forma preventiva. Assim voc&ecirc; estar&aacute; se prevenindo para evitar acidentes dirigindo a servi&ccedil;o da Cia."; 
			body += "		ou particularmente com seus familiares";
			body += "	</span>";
			body += "</div>";
			body += "<div class=\"yj6qo\"></div>";
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\" class=\"adL\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">&nbsp;</span>";
			body += "</div>";
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\" class=\"adL\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">&nbsp;</span></div>";
			body += "</div>";		
			body += getFooter(opGroup, isMedical);
		}
		return body;
    }

	private String createSelfEvaluationBody(String name,String[] results, String opGroup, boolean isMedical) {
    	
    	double total = 0;
    	for(int i = 0; i < results.length;  i++) {
    		total += Double.parseDouble(results[i]);
    	}
    	total = total / 8.0;
    	total = Math.round(total * Math.pow(10,2)) / Math.pow(10,2);
    	String green = "#355724";
    	String yellow = "#FFC000";
    	String red = "red";
    	String extra = "";
		String body = "";
		body += "<p>";
		body += "	<div style=\"margin:0in 0in 0.0001pt;font-size:12pt;font-family:'Times New Roman',serif\">";
		body += "		<span lang=\"PT-BR\" style=\"font-size:16pt\">Prezado "+name+"</span>";
		body += "	</div>";
		body += "	<div style=\"margin:0in 0in 0.0001pt;font-size:12pt;font-family:'Times New Roman',serif\">";
		body += "		<span lang=\"PT-BR\" style=\"font-size:16pt\">&nbsp;</span>";
		body += "	</div>";
		body += "	<div style=\"margin:0in 0in 0.0001pt;font-size:12pt;font-family:'Times New Roman',serif\">";
		body += "		<span lang=\"PT-BR\" style=\"font-size:16pt\">";
		body += "			Segue abaixo o resumo do seu Exerc&iacute;cio de Auto Avalia&ccedil;&atilde;o como Motorista que tamb&eacute;m foi ";
		body += "			enviado ao gerente que voc&ecirc; indicou como seu superior imediato.<br>";
		body += "			Os resultados dessa atividade foram registrados no CEPA - Data Center, ";
		body += "			para consulta e&nbsp; acompanhamento nas pr&oacute;ximas avalia&ccedil;&otilde;es.";
		body += "		</span>";
		body += "	</div>";
		body += "	<div style=\"margin:0in 0in 0.0001pt;font-size:12pt;font-family:'Times New Roman',serif\">";
		body += "		<span lang=\"PT-BR\" style=\"font-size:16pt\">";
		body += "			Para maior efic&aacute;cia dessa atividade, recomendamos que reveja os itens com pontua&ccedil;&otilde;es que indiquem ";
		body += "			'oportunidades de melhoria' e estabele&ccedil;a um Plano de A&ccedil;&atilde;o devidamente alinhado com sua chefia ";
		body += "			para contribuir com seu aprimoramento como motorista.";
		body += "		</span>";
		body += "	</div>";
		body += "	<div style=\"margin:0in 0in 0.0001pt;font-size:12pt;font-family:'Times New Roman',serif\">";
		body += "		<span lang=\"PT-BR\" style=\"font-size:16pt\">";
		body += "			Esse Plano de A&ccedil;&atilde;o ser&aacute; muito importante para aprimorar seu desempenho na preven&ccedil;&atilde;o dos acidentes de tr&acirc;nsito.";
		body += "			<br>Recomendamos que o Plano de A&ccedil;&atilde;o seja o mais simples poss&iacute;vel, porem com foco nas &aacute;reas que realmente ";
		body += "			indiquem a necessidade da mudan&ccedil;a de seu comportamento na dire&ccedil;&atilde;o.";
		body += "		</span>";
		body += "	</div>";
		body += "	<div style=\"margin:0in 0in 0.0001pt;font-size:12pt;font-family:'Times New Roman',serif\">";
		body += "		<span lang=\"PT-BR\" style=\"font-size:16pt\">&nbsp;</span>";
		body += "	</div>";
		body += "	<div style=\"margin:0in 0in 0.0001pt;font-size:12pt;font-family:'Times New Roman',serif\">";
		body += "		<span lang=\"PT-BR\" style=\"font-size:16pt\">";
		body += "			Esperamos continuar contando com sua participa&ccedil;&atilde;o ativa nas diversas atividades do Programa Safe Fleet.";
		body += "		</span>";
		body += "	</div>";
		body += "	<div style=\"margin:0in 0in 0.0001pt;font-size:12pt;font-family:'Times New Roman',serif\">";
		body += "		<span lang=\"PT-BR\" style=\"color:rgb(31,73,125)\">&nbsp;</span>";
		body += "	</div>";
		body += "</p>";
		body += "<p><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal 'Lucida Grande'\">";
		body += "<span style='font-size:16px'><font face='Calibri'><b>COMO INTERPRETAR AS SUAS PONTUA&ccedil;&otilde;ES EM CADA CATEGORIA</b></font></span></div></p>";
		body += "<font face=\"Calibri\">";
		body += "<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"678\" style=\"border-collapse:collapse;width:678pt\">";
		body += "<colgroup><col width=\"219\" style=\"width:219pt\">";
		body += "<col width=\"193\" style=\"width:193pt\">";
		body += "<col width=\"216\" style=\"width:216pt\">";
		body += "</colgroup><tbody><tr height=\"17\" style=\"min-height:17.25pt\">";
		body += " <td height=\"17\" width=\"219\" style=\"min-height:17.25pt;width:219pt\"></td>";
		body += " <td width=\"193\" style=\"width:193pt\"></td>";
		body += " <td width=\"216\" style=\"width:216pt\"></td>";
		body += "</tr>";
		body += "<tr height=\"16\" style=\"min-height:16.75pt\">";
		body += "<td height=\"16\" style=\"min-height:16.75pt\"><b><font size=\"4\">Categoria</font></b></td>";
		body += "<td></td>";
		body += "<td><b><font size=\"4\">Pontua&ccedil;&atilde;o</font></b></td>";
		body += "</tr>";
		body += "<tr height=\"16\" style=\"min-height:16.75pt\">";
		body += "<td height=\"16\" style=\"min-height:16.75pt\"><b><font size=\"4\">Total</font></b></td>";
		body += "<td></td>";
		String color = "";
		extra = "";
		if(total <= 4.25) {
			color = green;
		} else if(total <= 6.5) {
			color = yellow;
		} else {
			color = red;
			extra = " ( oportunidade de melhoria )";
		}
		body += "<td><b><font size=\"4\" color=\""+color+"\">"+String.valueOf(total)+extra+"</font></b></td>";
		body += "</tr>";
		body += "<tr height=\"16\" style=\"min-height:16.75pt\">";
		body += "<td height=\"16\" style=\"min-height:16.75pt\"><b><font size=\"4\">1 - Atitude</font></b></td>";
		body += "<td></td>";
		color = "";
		extra = "";
		if(Double.parseDouble(results[0]) <= 4.25) {
			color = green;
		} else if(Double.parseDouble(results[0]) <= 6.5) {
			color = yellow;
		} else {
			color = red;
			extra = " ( oportunidade de melhoria )";
		}
		body += "<td><b><font size=\"4\" color=\""+color+"\">"+results[0]+extra+"</font></b></td>";
		body += "</tr>";
		body += "<tr height=\"16\" style=\"min-height:16.75pt\">";
		body += "<td height=\"16\" colspan=\"2\" style=\"min-height:16.75pt\"><b><font size=\"4\">2";
		body += "- Manuten&ccedil;&atilde;o</font></b></td>";
		color = "";
		extra = "";
		if(Double.parseDouble(results[1]) <= 4.25) {
			color = green;
		} else if(Double.parseDouble(results[1]) <= 6.5) {
			color = yellow;
		} else {
			color = red;
			extra = " ( oportunidade de melhoria )";
		}
		body += "<td><b><font size=\"4\" color=\""+color+"\">"+results[1]+extra+"</font></b></td>";
		body += "</tr>";
		body += "<tr height=\"16\" style=\"min-height:16.75pt\">";
		body += "<td height=\"16\" style=\"min-height:16.75pt\"><b><font size=\"4\">3 - Cuidados antes de sair</font></b></td>";
		body += "<td></td>";
		color = "";
		extra = "";
		if(Double.parseDouble(results[2]) <= 4.25) {
			color = green;
		} else if(Double.parseDouble(results[2]) <= 6.5) {
			color = yellow;
		} else {
			color = red;
			extra = " ( oportunidade de melhoria )";
		}
		body += "<td><b><font size=\"4\" color=\""+color+"\">"+results[2]+extra+"</font></b></td>";
		body += "</tr>";
		body += "<tr height=\"16\" style=\"min-height:16.75pt\">";
		body += "<td height=\"16\" colspan=\"2\" style=\"min-height:16.75pt\"><b><font size=\"4\">4";
