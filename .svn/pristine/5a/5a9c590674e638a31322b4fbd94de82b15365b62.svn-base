public class ReportRegistryAction extends AbstractAction {

		
	public ActionForward action(ActionMapping mapping, ActionForm form, HttpServletRequest request, HttpServletResponse response) throws Exception {
		
        HttpSession session = request.getSession();
        SystemAccess sys = ((SystemAccess)session.getAttribute("SystemAccess"));
		UserSessionData userSessionData = sys.getUserSessionData();
		Text messages = sys.getText();
		boolean reporterjjmx = userSessionData.getFilter().getLoginName().equals(SecurityConstants.LOGIN_REPORTERJJ_MX);
		
		DynaActionForm formData = (DynaActionForm) form;	
		ActivityReportFacade activityReport = sys.getActivityReportFacade();

		String activityType = formData.getString("activity");
		String email = formData.getString("email");
		String emailManager = formData.getString("managerEmail");
		String managerName = formData.getString("managerName");
		Collection to = new LinkedList();
		Collection manager = new LinkedList();
    	if(sys.isCorporation(CorporationData.BAYER_MX)) {
	        if(activityReport.existsTodayActivity(userSessionData.getDriverData().getId(), activityType, userSessionData)) {
	        	return mapping.findForward("cancel_bayermx");
	        }
    	}

    	DriverData driver = sys.getDriverReportFacade().findDriverByPrimaryKey(userSessionData.getDriverData().getId(),userSessionData);

        int checkListId = (activityType.equals(CEPAActivityConstants.REPORTERJJ_SELFEVALUATION)) ? CheckListData.REPORTERJJ_SELF_EVALUATION : CheckListData.COMMENTARY_DRIVE_JJ2;
		CheckListData checkList = activityReport.findCheckList(checkListId, userSessionData);

		Date activityDate = Calendar.getInstance().getTime(); 
		if(activityType.equals(CEPAActivityConstants.REPORTERJJ_COMMENTARYDRIVE)) {
			activityDate = Util.getDate(formData.getString("date"), formData.getString("month"), formData.getString("year"));
			if(activityDate == null) {
				activityDate = Calendar.getInstance().getTime();
			}
		}

        Collection itemValueSet = new LinkedList();
        Collection<PointCommentData> pointObs = new LinkedList<PointCommentData>();
        Iterator points = checkList.getSortPoints();
        HashMap values = new HashMap();
        String errors = "";
        int index = 1;
        boolean[] pdfs = {false,false,false,false,false,false,false,false,false,false,false};
        String[] pdfFiles = {"1_Antecipando_Riscos.pdf","2_Colisoes_em_Marcha_a_Re.pdf","3_Distancia.pdf","4_Faixa_de_Circulacao.pdf","5_Manutencao.pdf","6_Planejamento.pdf","7_Sinalizacao.pdf","8_Velocidade.pdf","9_Uso_dos_Comandos.pdf","10_Atitude.pdf","11_Estacionamento.pdf"};
        while(points.hasNext()) {
        	PointData point = (PointData)points.next();
        	Iterator itemsIt = point.getSortItems();
            while(itemsIt.hasNext()) {
                ItemData item = (ItemData)itemsIt.next();
                String insertedValue = request.getParameter("item-"+String.valueOf(item.getId()));
                if(!Util.isNumber(insertedValue) || insertedValue.equals("-1")) {
                	if(errors.length() > 0) {
                		errors += ",";
                	}
                	errors += String.valueOf(index);
                }else {
            		int val = Integer.parseInt(insertedValue);
                	if(activityType.equals(CEPAActivityConstants.REPORTERJJ_COMMENTARYDRIVE)) {
                		if((item.getId() == 9520 || item.getId() == 9521 || item.getId() == 9524 || item.getId() == 9525) && val == 2) {
                			pdfs[0] = true;
                		}
                		if((item.getId() == 9523 || item.getId() == 9527 || item.getId() == 9528 || item.getId() == 9529) && val == 2) {
                			pdfs[2] = true;
                		}
                		if((item.getId() == 9526 || item.getId() == 9531 || item.getId() == 9532) && val == 2) {
                			pdfs[3] = true;
                		}
                		if(point.getId() == 1560 && val == 2) {
                			pdfs[4] = true;
                		}
                		if(point.getId() == 1561 && val == 2) {
                			pdfs[5] = true;
                		}
                		if((item.getId() == 9530 || item.getId() == 9533) && val == 2) {
                			pdfs[6] = true;
                		}
                		if((item.getId() == 9517 || item.getId() == 9519) && val == 2) {
                			pdfs[7] = true;
                		}
                		if((point.getId() == 1562 && val == 2) || (item.getId() == 9522 && val == 2)) {
                			pdfs[8] = true;
                		}
                		if(((item.getId() == 9518 || item.getId() == 9534) && val == 2) || (point.getId() == 1565 && val == 2)) {
                			pdfs[9] = true;
                		}
                		if(point.getId() == 1564 && val == 2) {
                			pdfs[10] = true;
                		}
                	}else {
                		if((isIn(item.getId(),new int[]{9127,9128,9136,9136,9139,9157}) && val < 3)  || (isIn(item.getId(),new int[]{9129,9130,9140,9145,9151,9155,9156,9158,9160}) && val > 2)) {
                			pdfs[0] = true;
                		}
                		if(item.getId() == 9133 && val > 2) {
                    		pdfs[1] = true;
                    	}
                		if(isIn(item.getId(),new int[]{9134,9135,9144}) && val > 2) {
                			pdfs[2] = true;
                		}
                		if(isIn(item.getId(),new int[]{9138,9142,9150}) && val > 2) {
                			pdfs[3] = true;
                		}
                		if(isIn(item.getId(),new int[]{9115,9116,9117,9118,9119,9120,9124}) && val > 2) {
                			pdfs[4] = true;
                		}
                		if(isIn(item.getId(),new int[]{9125,9147}) && val < 3) {
                			pdfs[5] = true;
                		}
                		if(isIn(item.getId(),new int[]{9132,9146,9152}) && val > 2) {
                			pdfs[6] = true;
                		}
                		if((isIn(item.getId(),new int[]{9110}) && val < 3)  || (isIn(item.getId(),new int[]{9126,9141,9153}) && val > 2)) {
                			pdfs[7] = true;
                		}
                		if((isIn(item.getId(),new int[]{9137,9154}) && val < 3)  || (isIn(item.getId(),new int[]{9121,9122,9123,9149,9159}) && val > 2)) {
                			pdfs[8] = true;
                		}
                		if((isIn(item.getId(),new int[]{9111,9112,9114,9148}) && val < 3)  || (isIn(item.getId(),new int[]{9108,9109,9113,9143}) && val > 2)) {
                			pdfs[9] = true;
                		}
                		if(item.getId() == 9131 && val > 2) {
                			pdfs[10] = true;
                		}
                	}
                	values.put("i"+item.getId(), insertedValue);
                    itemValueSet.add(new ItemValueData(item,new Integer(insertedValue)));
                }
                index++;
            }
            String pointObsText = request.getParameter("point-"+String.valueOf(point.getId()));
            if(!Util.empty(pointObsText)) {
            	pointObs.add(new PointCommentData(point,pointObsText));
            	values.put("p"+point.getId(), pointObsText);
            }
        }


		if(Util.empty(driver.getEmail())) {
			if(Util.empty(email) || !Util.checkEmail(email)) {
	        	userSessionData.setValue(values);
	        	session.setAttribute("Msg",messages.getText("generic.alert.invalidemail"));
				return (activityType.equals(CEPAActivityConstants.REPORTERJJ_SELFEVALUATION)) ? mapping.findForward("back1") : mapping.findForward("back2");
			}else {
				to.add(email);
			}
		}else {
			if(Util.empty(email)) {
				to.add(driver.getEmail());
			}else {
				if(!Util.checkEmail(email)) {
		        	userSessionData.setValue(values);
		        	session.setAttribute("Msg",messages.getText("generic.alert.invalidemail"));
					return (activityType.equals(CEPAActivityConstants.REPORTERJJ_SELFEVALUATION)) ? mapping.findForward("back1") : mapping.findForward("back2");
				}else {
					to.add(email);
				}
			}
		}
		if(Util.empty(emailManager) || !Util.checkEmail(emailManager)) {
        	userSessionData.setValue(values);
        	session.setAttribute("Msg","Email de Gerente incorrecto");
			return (activityType.equals(CEPAActivityConstants.REPORTERJJ_SELFEVALUATION)) ? mapping.findForward("back1") : mapping.findForward("back2");
		}else {
			manager.add(emailManager);
		}

		if(errors.length() > 0) {
        	userSessionData.setValue(values);
			session.setAttribute("Msg",messages.getText("reporterjj.commentarydrive.errorfields")+" "+errors);
			return (activityType.equals(CEPAActivityConstants.REPORTERJJ_SELFEVALUATION)) ? mapping.findForward("back1") : mapping.findForward("back2");
        }else {
			DivOrgAttribute[] divOrgs = userSessionData.getFilter().getDivOrgsAttrs();
	        Collection list = new LinkedList();
	        Iterator it = driver.getDivOrgsIterator();
	        DivOrgData opGroup = (DivOrgData)it.next();
	        Integer opGroupId = ((communication.administration.corporation.tables.ItemData)opGroup.getDivOrgLevels().getItemIterator().next()).getId();
	        boolean isMedical = false;
	        String opGroupDescription = "";
	        switch(opGroupId) {
	        	case 300022:
	        		opGroupDescription = "Pharma ";
	        		break;
	        	case 300051:
	        		Integer franchiseId = ((communication.administration.corporation.tables.ItemData)opGroup.getDivOrgLevels().getItemIterator().next()).getId();
	        		if(franchiseId == 300999) {
		        		opGroupDescription = "Vision Care ";	        			
	        		}else {
		        		opGroupDescription = "Medical ";
		        		if(driver.getCountryName().equals(CountryData.BRASIL)) {
