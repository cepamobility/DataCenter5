		body += "	</span>";
		body += "</p>";
		body += "<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"655\" style=\"font-size:14px;border-collapse:collapse;width:655pt\">";
		body += "<colgroup><col width=\"655\" style=\"width:555pt\">";
		body += "</colgroup><tbody><tr height=\"20\" style=\"min-height:20.0pt\">";
		body += "<td height=\"20\" width=\"655\" style=\"min-height:20.0pt;width:655pt\"><font size=\"2\"><b><font color=\""+green+"\">Pontua&ccedil;&atilde;o Baixa ";
		body += "- 2.00 a 4.25</font></b><span><b><font color=\""+green+"\">&nbsp;</font></b>&nbsp; </span><font color=\""+yellow+"\"><b>Pontua&ccedil;&atilde;o M&eacute;dia - de";
		body += " 4.25 a 6.50</b></font><span>&nbsp;</span></font><b><font color=\""+red+"\" size=\"2\">Pontua&ccedil;&atilde;o Alta - 6.50 a ";
		body += "10.0 (oportunidade de melhoria)</font><br><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Helvetica\"><font color=\"#232323\"><br></font></div>";
		body += "</b></td></tr></tbody></table>";		
		body += "<table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" width=\"904\" style=\"width:678pt;border-collapse:collapse\">";
		body += "	<tr style=\"min-height:12.75pt\">";
		body += "		<td width=\"315\" style=\"width:236.45pt;padding:0in;min-height:12.75pt\"></td>";
		body += "		<td width=\"278\" style=\"width:208.35pt;padding:0in;min-height:12.75pt\"></td>		";
		body += "		<td width=\"311\" style=\"width:233.2pt;padding:0in;min-height:12.75pt\"></td>";
		body += "	</tr>";
		body += "	<tr style=\"min-height:12pt;min-height:16.75pt\">";
		body += "		<td style=\"padding:0in;min-height:12pt;min-height:16.75pt\">";
		body += "			<p class=\"MsoNormal\" style=\"margin:0in 0in 10pt;line-height:17px;font-size:11pt;font-family:Calibri,sans-serif\">";
		body += "				<b>";
		body += "					<span style=\"font-size:13.5pt;line-height:20px\">Categoria</span>";
		body += "				</b>";
		body += "				<span style=\"font-size:12pt;line-height:18px;font-family:'Times New Roman',serif\"></span>";
		body += "			</p>";
		body += "		</td>";
		body += "		<td style=\"padding:0in;min-height:12pt\"></td>";
		body += "		<td style=\"padding:0in;min-height:12pt\">";
		body += "			<p class=\"MsoNormal\" style=\"margin:0in 0in 10pt;line-height:17px;font-size:11pt;font-family:Calibri,sans-serif\">";
		body += "				<b>";
		body += "					<span style=\"font-size:13.5pt;line-height:20px\">Pontua&ccedil;&atilde;o</span>";
		body += "				</b>";
		body += "				<span style=\"font-size:12pt;line-height:18px;font-family:'Times New Roman',serif\"></span>";
		body += "			</p>";
		body += "		</td>";
		body += "	</tr>";

		String color = "";
		extra = "";
		if(total <= 4.25) {
			color = green;
		} else if(total <= 6.5) {
			color = yellow;
		} else {
			color = red;
			extra = " ( oportunidade de melhoria )";
		}
		body += "	<tr style=\"min-height:12pt;min-height:16.75pt\">";
		body += "		<td style=\"padding:0in;min-height:12pt;min-height:16.75pt\">";
		body += "			<p class=\"MsoNormal\" style=\"margin:0in 0in 10pt;line-height:17px;font-size:11pt;font-family:Calibri,sans-serif\">";
		body += "				<b>";
		body += "					<span style=\"font-size:13.5pt;line-height:20px\">Total</span>";
		body += "				</b>";
		body += "				<span style=\"font-size:12pt;line-height:18px;font-family:'Times New Roman',serif\"></span>";
		body += "			</p>";
		body += "		</td>";
		body += "		<td style=\"padding:0in;min-height:12pt\"></td>";
		body += "		<td style=\"padding:0in;min-height:12pt\">";
		body += "			<p class=\"MsoNormal\" style=\"margin:0in 0in 10pt;line-height:17px;font-size:11pt;font-family:Calibri,sans-serif\">";
		body += "				<b>";
		body += "					<span style=\"font-size:13.5pt;line-height:20px;color:"+color+"\">"+total+extra+"</span>";
		body += "				</b>";
		body += "				<span style=\"font-size:12pt;line-height:18px;font-family:'Times New Roman',serif\"></span>";
		body += "			</p>";
		body += "		</td>";
		body += "	</tr>";
		
		String[] texts = {"1 - Atitude","2- Manuten&ccedil;&atilde;o","3 - Cuidados antes de sair","4- Cruzamentos","5- Estacionamento","6- Espa&ccedil;o de seguran&ccedil;a","7 - Geral","8- Percep&ccedil;&atilde;o"};
		for(int i = 0; i < 8; i++) {
			color = "";
			extra = "";
			if(Double.parseDouble(results[i]) <= 4.25) {
				color = green;
			} else if(Double.parseDouble(results[i]) <= 6.5) {
