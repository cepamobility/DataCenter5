			body += "	</tr>";
		}
		body += "</table>";
		body += getFooter(opGroup, isMedical);
		return body;
	}

    public ActionForward cancel(HttpSession session,ActionMapping mapping, ActionForm form) {
    	SystemAccess sys = (SystemAccess)session.getAttribute("SystemAccess");
    	if(sys.isCorporation(CorporationData.BAYER_MX)) {
        	return mapping.findForward("cancel_bayermx");
    	}
        if(sys.getUserSessionData().getLenguage().equals("es")) {
        	return mapping.findForward("cancelar");
        }else {
        	return mapping.findForward("cancel");
        }
    }    

    private boolean isMedical(DivOrgData opGroup) {
    	Integer franchiseId = ((communication.administration.corporation.tables.ItemData)opGroup.getDivOrgLevels().getItemIterator().next()).getId();
		if(franchiseId != 300999) {
			return true;
		}
		return true;
    }
}
