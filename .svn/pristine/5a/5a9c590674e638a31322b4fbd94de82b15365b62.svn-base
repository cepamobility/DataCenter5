	        	case 300000:
	        		franchiseId = ((communication.administration.corporation.tables.ItemData)opGroup.getDivOrgLevels().getItemIterator().next()).getId();
	        		if(franchiseId == 300002) {
		        		opGroupDescription = "Vision Care ";	        			
	        		}else {
	        			opGroupDescription = "Consumer ";
	        		}
	        		break;
	        }
	        list.add(opGroup);
	        list.add((DivOrgData)it.next());
	        if(sys.isCorporation(CorporationData.BAYER_MX))
	        	list.add((DivOrgData)it.next());
	
