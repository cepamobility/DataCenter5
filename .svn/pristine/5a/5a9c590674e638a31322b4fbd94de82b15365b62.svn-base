									mailServer,
									"CEPA DataCenter", 
									mailAddress[0],
									mailAddress[1], 
									"Auto-avaliaÃ§Ã£o como Motorista", body, files,
									names, 
									"", "", bcc);
							}
						}catch (Exception e) {
							
						}
						sended = true;
						count++;
					}
					body = createManagerBody(managerName,driver.getFirstName()+" "+driver.getLastName(),((SelfEvaluationData)data).getResults(), opGroupDescription, isMedical);
					sended = false;
