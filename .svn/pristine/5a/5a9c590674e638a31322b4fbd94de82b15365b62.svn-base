    private boolean isIn(Integer id, int[] ids) {
    	for(int i = 0; i < ids.length; i++) {
    		if(id == ids[i]) {
    			return true;
    		}
    	}
    	return false;
	}

	private String createCommentaryDriveBody(String name, String opGroup, boolean isMedical, UserSessionData userSessionData, boolean rv) {
		String body = "";
		body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\">";
		body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">"+name+"</span>";
		body += "</div>";
		if(userSessionData.getLenguage().equals("es")) {
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">&nbsp;</span>";
			body += "</div>";
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">";
			if(rv) {
				body += "		Est&aacute; recibiendo copia del feedback de su multiplicador relacionado con la actividad 'Revisi&oacute;n Vehicular' y 'Conducci&oacute;n Comentada'.";
			} else {
				body += (userSessionData.isCorporation(CorporationData.BAYER_MX)) ? "		Est&aacute; recibiendo copia del feedback de su monitor relacionado con la actividad 'Conducci&oacute;n Comentada'." : "		Est&aacute; recibiendo copia del feedback de su multiplicador relacionado con la actividad 'Conducci&oacute;n Comentada'.";
			}
			body += "	</span>";
			body += "</div>";
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">&nbsp;</span>";
			body += "</div>";
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">";
			body += "		En caso de tener observaciones u oportunidades de mejora en los puntos evaluados, es muy importante que usted" ;
			body += " adopte la acci&oacute;n correctiva del caso, perfeccionando cada d&iacute;a su habilidad y h&aacute;bitos en la conducci&oacute;n.";
			body += "	</span>";
			body += "</div>";
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">&nbsp;</span>";
			body += "</div>";
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">";
			body += "		<b>Su participaci&oacute;n ha sido muy valiosa, gracias.</b>";
			body += "	</span>";
			body += "</div>";
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\" class=\"adL\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">&nbsp;</span></div>";
			body += "</div>";		
			body += "<br><br><div><span style=\"border-collapse:collapse\">";
			if(userSessionData.isCorporation(CorporationData.JJ)) {
				body += "<font face=\"Calibri\"><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 18px/normal Helvetica\"><b>Equipo SAFE Fleet</b></div>";
			}else if(userSessionData.isCorporation(CorporationData.BAYER_MX)) {
				body += "<font face=\"Calibri\"><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 18px/normal Helvetica\"><b>Programa ROAD Safety Bayer</b></div>";
			}else {
				body += "<font face=\"Calibri\"><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 18px/normal Helvetica\"><b>Equipo CEPA</b></div>";
			}
			body += "</font></span></div>";		
		}else {
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">&nbsp;</span>";
			body += "</div>";
			body += "<div style=\"margin:0in 0in 0.0001pt;font-size:11pt;font-family:Calibri,sans-serif\">";
			body += "	<span lang=\"PT-BR\" style=\"font-size:14pt\">";
