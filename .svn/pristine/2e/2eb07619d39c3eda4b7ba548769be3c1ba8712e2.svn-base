	 */
	public void ejbCreate() throws CreateException {	}

	
	/**
	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetview,driverfleetinsertdata,fleetinsertdata"
	 * @return Collection of UserData
	 * @throws Exception
	 */
	public ListResult findFleetList(String name,int type,int first,int count,	
			UserSessionData userSessionData,int status) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"findFleetList",getClass());
        ListResult listResult = null;
    	try{
    		FleetReportHome fleetHome = FleetReportUtil.getHome();
    		FleetReport fleetReport = fleetHome.create();
            listResult = fleetReport.findList(name,type,first,count,userSessionData,status);
    	}catch (Exception e) {
    		Object[] p = new Object[5];
    		p[0] = name;
    		p[1] = type;
    		p[2] = first;
    		p[3] = count;
    		p[4] = status;
            handler.handleException("findFleetList",e,userSessionData,p);
    	}
        MemoryLog.getInstance().log(MemoryLog.END,"findFleetList",getClass());
    	return listResult;
	}
	
