            return fleetReport.countFleetsWithVehicle(vehicleId,userSessionData);
    	}catch (Exception e) {
    		Object[] p = new Object[1];
    		p[0] = vehicleId;
            handler.handleException("countFleetsWithVehicle",e,userSessionData,p);
