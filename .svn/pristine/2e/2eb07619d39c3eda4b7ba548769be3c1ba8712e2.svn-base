    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public ApmkData getOdometerValues(int[] orders, int[] from, int[] to, Integer[][] divOrgs, Integer[] divGeos, UserSessionData userSessionData) throws Exception {
    	ApmkData data = new ApmkData();
    	try {
	    	Collection list = FleetReportUtil.getHome().create().getOdometerValues(orders, from, to, divOrgs, divGeos, userSessionData);
	    	Iterator it = list.iterator();
	    	while(it.hasNext()) {
	    		data.addLine((Object[]) it.next(),0);
	    	}
    	}catch (Exception e) {
        	Object[] p = {};
            handler.handleException("getDriverLinks",e,userSessionData,p);
    	}
    	return data;
    }
