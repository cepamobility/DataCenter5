    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverodometer"
     */
    public String[] findVehicleOdometerValues(VehicleData data,String period,
    		String year,UserSessionData userSessionData) throws Exception {
        
    	MemoryLog.getInstance().log(MemoryLog.START,"findVehicleOdometerValues",this.getClass());
        String[] result = {"","","","","","","","","",""};
        
        try {
            
        	FleetReport fleetReport = FleetReportUtil.getHome().create(); 
            Collection lastValues = fleetReport.findVehicleOdometers(String.valueOf(data.getId()),period,year,userSessionData);
            Iterator it = lastValues.iterator();
            boolean next = true;
            String type = "";
            if(it.hasNext() && next) {
                Object[] odometerData = (Object[])it.next();
                Hashtable hash = fleetReport.getVehicleOdometerType(data.getId(),userSessionData);  
                String key = data.getCountryId()+"-"+data.getDivOrgId(0)+"-"+data.getDivOrgId(1)+"-"+data.getDivOrgId(2);
                type = (hash.containsKey(key)) ? (String)hash.get(key) : (String)hash.elements().nextElement();
                if(((Integer)odometerData[1]).intValue() == Integer.parseInt(period) && ((Integer)odometerData[2]).intValue() == Integer.parseInt(year)) {
                    result[0] = String.valueOf(odometerData[0]);
                    result[1] = String.valueOf(odometerData[3]);
                    result[2] = String.valueOf(odometerData[4]);
                    result[8] = (String) odometerData[6];
                    result[9] = (odometerData[5] == null) ? null : String.valueOf(odometerData[5]);
                    if(it.hasNext()) {
                        odometerData = (Object[])it.next();
                        result[3] = String.valueOf(odometerData[0]);
                        result[4] = String.valueOf(odometerData[1]);
                        result[5] = String.valueOf(odometerData[2]);
                    }
                }else {
                    result[3] = String.valueOf(odometerData[0]);
                    result[4] = String.valueOf(odometerData[1]);
                    result[5] = String.valueOf(odometerData[2]);
                    next = false;
                }
            }
            if(result[0] != null && result[0].length() > 0 && result[3] != null && result[3].length() > 0) {
            	if(type.equals("datatype.distanceunit.miles")) {
            		result[6] = String.valueOf(Integer.parseInt(result[0]) - Integer.parseInt(result[3]));
            		result[7] = String.valueOf((int)(Integer.parseInt(result[6]) * Util.KMS_TO_MILES));
            	}else {
            		result[7] = String.valueOf(Integer.parseInt(result[0]) - Integer.parseInt(result[3]));
            		result[6] = String.valueOf((int)(Integer.parseInt(result[7]) / Util.KMS_TO_MILES));
            	}
            }
        }catch(Exception e) {
        	
    		Object[] p = new Object[3];
        	p[0] = data;
        	p[1] = period;
        	p[2] = year;
            handler.handleException("findVehicleOdometerValues",e,userSessionData,p);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"findVehicleOdometerValues",this.getClass());
        return result;
    }

