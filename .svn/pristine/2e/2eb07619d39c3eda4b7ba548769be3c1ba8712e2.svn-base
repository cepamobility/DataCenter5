    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetinsertdata"
     */
    public HashMap<String, Integer> getIndividualMiles(Integer fleetId, Integer period, Integer year,UserSessionData userSessionData) throws Exception {
    	HashMap<String,  Integer> values = new HashMap<String, Integer>();
    	try {
    		Integer prePeriod = period-1;
    		Integer preYear = year;
    		if(prePeriod == 0) {
    			prePeriod = 12;
    			preYear--;
    		}
	    	values = FleetReportUtil.getHome().create().getIndividualMiles(fleetId, prePeriod, preYear, period, year, userSessionData);
    	}catch (Exception e) {
        	Object[] p = {fleetId,period,year};
            handler.handleException("getIndividualMiles",e,userSessionData,p);
    	}
    	return values;
    } 

    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetinsertdata"
     */
    public HashMap<String, Integer> getIndividualMilesByQuarter(Integer fleetId, Integer quarter, Integer year,UserSessionData userSessionData) throws Exception {
    	HashMap<String,  Integer> values = new HashMap<String, Integer>();
    	try {
    		for(int i =  0; i < 3; i++) {
    			Integer period = quarter - i;
	    		Integer prePeriod = period-1;
	    		Integer preYear = year;
	    		if(prePeriod == 0) {
	    			prePeriod = 12;
	    			preYear--;
	    		}
	    		HashMap<String,  Integer> periodValues = FleetReportUtil.getHome().create().getIndividualMiles(fleetId, prePeriod, preYear, period, year, userSessionData);
	    		Iterator keyIt = periodValues.keySet().iterator();
	    		while(keyIt.hasNext()) {
	    			String key = (String)keyIt.next();
	    			if(values.containsKey(key)) {
    					values.put(key, new Integer(values.get(key).intValue() + periodValues.get(key).intValue()));
	    			}else {
	    				values.put(key, periodValues.get(key));
	    			}
	    		}
    		}
    	}catch (Exception e) {
        	Object[] p = {fleetId,quarter,year};
            handler.handleException("getIndividualMilesByQuarter",e,userSessionData,p);
    	}
    	return values;
    } 

