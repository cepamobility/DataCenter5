        if (userSessionData == null) {
            throw new DeslogedException("findFleetDetail","userSessionData = null");
        }
        try{            
            FleetReportHome home = FleetReportUtil.getHome();
            FleetReport fleetReport = home.create();
            return fleetReport.findFleetDetail(fleetId,period,year,userSessionData);
        } catch(Exception e){
        	Object[] p = new Object[3];
    		p[0] =  fleetId;
    		p[1] = period;
    		p[2] = year;
            handler.handleException("findFleetDetail",e,userSessionData,p);
        }
        return null;
    }
    
