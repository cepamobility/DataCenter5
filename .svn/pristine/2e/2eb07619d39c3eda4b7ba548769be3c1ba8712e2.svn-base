    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetedit,driverfleetinsertdata,fleetinsertdata,fleetblockdata"
     */
    public Collection getBlockPeriods(UserSessionData userSessionData) throws Exception {
    	LinkedList regions;
    	HashSet regionsNames;
    	GroupLineData groupLineData;
    	GeoLabelData lid;
    	GeoItemData item;
    	Iterator it;
    	try{
   			/* Get Corporation's Regions: */
     	   	/* We asumm that the corporation has two levels */
     	   	/* and the first one is the region and the second one is the country */
     	   	/* we iterate on the groups to create the corporation's regions collection*/
     	   	regions = new LinkedList();
     	    regionsNames = new HashSet(); // Is used to avoid repeated regions 
     	    it = userSessionData.getFilter().getGroupLines().iterator();	    
     	    while (it.hasNext()) 
     	    {
             	groupLineData = (GroupLineData)it.next();  
     	        lid = groupLineData.getCountry();
     	        item = (GeoItemData)lid.getItemIterator().next();	        
     	        if (!regionsNames.contains(item.getName())){
     		        regionsNames.add(item.getName());
     		        regions.add(item); // LinkedList con los ids de las regiones	        
     	        }
     	    }  
            FleetReportLocalHome local = FleetReportUtil.getLocalHome();
            FleetReportLocal fleetReportLocal = local.create();
            return fleetReportLocal.getBlockPeriods(userSessionData, regions);
         } catch(Exception e){
             handler.handleException("getBlockPeriods",e,userSessionData,null);
         }
         return null;
    }
    
