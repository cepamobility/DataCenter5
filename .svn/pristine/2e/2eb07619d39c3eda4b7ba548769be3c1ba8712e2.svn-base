     */
    public ReportKmLtrData getKmLtrReport(String periodFrom, Integer yearFrom, 
    		String periodTo, Integer yearTo, Integer[][] divOrgs, 
    		Integer[] divGeos, UserSessionData userSessionData,Text messages) throws Exception {
        try{            
            FleetReportHome home = FleetReportUtil.getHome();
            FleetReport fleetReport = home.create();
            Collection data = new LinkedList();

            Hashtable periods = fleetReport.getReportIndividualFuel(periodFrom,yearFrom,periodTo,yearTo,divOrgs,divGeos,userSessionData);
            Enumeration en = periods.keys();
            String prePeriod = getPreviousPeriod(new Integer(periodFrom),yearFrom);
            int[][] principal = userSessionData.getFilter().getPrincipalDivOrgs();
            while(en.hasMoreElements()) {
                String key = (String)en.nextElement();
                if(!key.equals(prePeriod)) {
                    Hashtable vehicles = (Hashtable)periods.get(key);
                    Enumeration en2 = vehicles.elements();
                    while(en2.hasMoreElements()) {
                        Object[] dataV = (Object[])en2.nextElement();
                        VehicleData vehicle = (VehicleData)dataV[0];
                        String divOrg1Name = null;
                        Integer divOrg1Id = null;
                        if(principal[0][0] != 0) {
                            divOrg1Name = vehicle.getData(principal[0][0],principal[0][1]);    
                            divOrg1Id = vehicle.getIdData(principal[0][0],principal[0][1]);
                        }
                        String divOrg2Name = null;
                        Integer divOrg2Id = null;
                        if(principal[1][0] != 0) {
                            divOrg2Name = vehicle.getData(principal[1][0],principal[1][1]);    
                            divOrg2Id = vehicle.getIdData(principal[1][0],principal[1][1]);
                        }
                        String divOrg3Name = null;
                        Integer divOrg3Id = null;
                        if(principal[2][0] != 0) {
                            divOrg3Name = vehicle.getData(principal[2][0],principal[2][1]);    
                            divOrg3Id = vehicle.getIdData(principal[2][0],principal[2][1]);
                        }
                        String divOrg4Name = messages.getText(vehicle.getCountryName());
                        Integer divOrg4Id = vehicle.getCountryId();
                        int miles = (((Integer)dataV[2]).intValue() == 0 || ((Integer)dataV[1]).intValue() == 0) ? 0 : ((Integer)dataV[2]).intValue() - ((Integer)dataV[1]).intValue();
                        KmLtrFuelData klData = new KmLtrFuelData(vehicle.getId(),divOrg1Id,divOrg1Name,divOrg2Id,divOrg2Name,divOrg3Id,divOrg3Name,divOrg4Id,divOrg4Name,new Integer(miles),(Integer)dataV[3],(String)dataV[4],vehicle.getType().getResourceBundleId(),vehicle.getMatricula(),vehicle.getTrade().getResourceBundleId(),vehicle.getModel()); 
                        Iterator it = data.iterator();
                        boolean find = false;
                        while(it.hasNext() && !find) {
                            KmLtrFuelData element = (KmLtrFuelData)it.next();
                            if(element.equalsData(klData)) {
                                element.addData(klData);
                                find = true;
                            }
                        }
                        if(!find) {
                            data.add(klData);
                        }
                    }
                }
            }

            return new ReportKmLtrData(data,messages);
            
        } catch(Exception e){
        	Object[] p = new Object[7];
        	p[0] = periodFrom;
        	p[1] = yearFrom;
        	p[2] = periodTo;
        	p[3] = yearTo;
        	p[4] = divOrgs;
        	p[5] = divGeos;
        	p[6] = messages;
            handler.handleException("getKmLtrReport",e,userSessionData,p);
        }
        return null;
    }
    
