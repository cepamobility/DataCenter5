    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public ReportAPMMData getReportAPMM(String periodFrom, Integer yearFrom, String periodTo, 
    		Integer yearTo, Integer[][] divOrgs, Integer[] divGeos, int order1, 
    		int order2, int order3, int order4, int fleets, UserSessionData userSessionData,Text messages) throws Exception {
        try{            
            FleetReportHome home = FleetReportUtil.getHome();
            FleetReport fleetReport = home.create();
            
            Collection data = new LinkedList();
            
        	Integer monthCount = new Integer((12 - Integer.parseInt(periodFrom) + 1) + 
        			((yearTo.intValue() - yearFrom.intValue() - 1) * 12) + Integer.parseInt(periodTo));
            if(fleets == 0 || fleets == 1) {
            	data = fleetReport.getReportAPMM(periodFrom, yearFrom, periodTo, yearTo,  divOrgs, 
            			divGeos, order1, order2, order3, order4, userSessionData, messages);
            }
           
            boolean isMiles = true; 
            if(fleets == 0 || fleets == 2) {
	            Hashtable periods = fleetReport.getReportIndividualAPMMByDivision(periodFrom,yearFrom,periodTo,
	            		yearTo,divOrgs,divGeos,userSessionData);
	           
	            // Solo para J&J:
	            if (userSessionData.getFilter().getCorporationId()==CorporationData.JJ){
	            	EventReportHome eventHome = EventReportUtil.getHome();
	            	EventReport eventReport = eventHome.create();
	            	Iterator itInjuries = eventReport.getInjuriesCount(periodFrom,yearFrom,periodTo,yearTo,order1, order2,
	            			order3, order4, divOrgs, divGeos , userSessionData).iterator();                    
	            	while(itInjuries.hasNext()) {
	            		EventInjuriesData injuryData = (EventInjuriesData)itInjuries.next();
	            		Iterator it = data.iterator();
	            		while(it.hasNext()) {
	            			APMMByDivisionData element = (APMMByDivisionData)it.next();
	            			if(element.equalDivisions(injuryData)) {
	            				element.setInjuries(injuryData.getInjuriesCount());
	            			}
	            		}
	            	}
	            } // fin if J&J
            
	            Enumeration en = periods.keys();
	            String prePeriod = getPreviousPeriod(new Integer(periodFrom),yearFrom);
               // Hashtable preVehicles = (Hashtable)periods.get(prePeriod); 
	            /*if(periods.size() > 0 && !periods.containsKey(prePeriod)) {
	                throw new InvalidDataException("getReportMileage","invalid_month");
	            }*/
	            
	            int[][] principal = userSessionData.getFilter().getPrincipalDivOrgs();
                Hashtable fleetDivisions = fleetReport.getFleetDivisionsData(null, userSessionData);
	            while(en.hasMoreElements()) {
	                String key = (String)en.nextElement();
	                if(!key.equals(prePeriod)) {
	                    Hashtable vehicles = (Hashtable)periods.get(key); 
	                    Enumeration en2 = vehicles.elements();
	                    
	                    while(en2.hasMoreElements()) {
	                        Object[] dataV = (Object[])en2.nextElement();
	                        VehicleData vehicle = (VehicleData)dataV[0];
	                       // if(preVehicles.containsKey(vehicle.getId())) {
		                        String divOrg1Name = null;
		                        Integer divOrg1Id = null;
		                        switch(order1) {
		                            case 3:
		                                divOrg1Name = messages.getText(vehicle.getCountryName());
		                                divOrg1Id = vehicle.getCountryId();
		                                break;
		                            case 0:case 1:case 2:
		                                divOrg1Name = vehicle.getData(principal[order1][0],principal[order1][1]);    
		                                divOrg1Id = vehicle.getIdData(principal[order1][0],principal[order1][1]);    
		                                break;
		                        }
		                        String divOrg2Name = null;
		                        Integer divOrg2Id = null;
		                        switch(order2) {
		                            case 3:
		                                divOrg2Name = messages.getText(vehicle.getCountryName());
		                                divOrg2Id = vehicle.getCountryId();
		                                break;
		                            case 0:case 1:case 2:
		                                divOrg2Name = vehicle.getData(principal[order2][0],principal[order2][1]);    
		                                divOrg2Id = vehicle.getIdData(principal[order2][0],principal[order2][1]);    
		                                break;
		                        }
		                        String divOrg3Name = null;
		                        Integer divOrg3Id = null;
		                        switch(order3) {
		                            case 3:
		                                divOrg3Name = messages.getText(vehicle.getCountryName());
		                                divOrg3Id = vehicle.getCountryId();
		                                break;
		                            case 0:case 1:case 2:
		                                divOrg3Name = vehicle.getData(principal[order3][0],principal[order3][1]);    
		                                divOrg3Id = vehicle.getIdData(principal[order3][0],principal[order3][1]);    
		                                break;
		                        }
		                        String divOrg4Name = null;
		                        Integer divOrg4Id = null;
		                        switch(order4) {
		                            case 3:
		                                divOrg4Name = messages.getText(vehicle.getCountryName());
		                                divOrg4Id = vehicle.getCountryId();
		                                break;
		                            case 0:case 1:case 2:
		                                divOrg4Name = vehicle.getData(principal[order4][0],principal[order4][1]);    
		                                divOrg4Id = vehicle.getIdData(principal[order4][0],principal[order4][1]);    
		                                break;
		                        }
		                    	
	
		                        int miles = (((Integer)dataV[2]).intValue() == 0 || ((Integer)dataV[1]).intValue() == 0) ? 0 : 
		                        			((Integer)dataV[2]).intValue() - ((Integer)dataV[1]).intValue();
		                        
		                        
		                        isMiles = !(fleetDivisions.containsKey(dataV[5]) && fleetDivisions.get(dataV[5]).equals("datatype.distanceunit.kilometers"));
		                        
		                    	// Si la flota tiene como unidad de distancia kilometros, paso sus valors a millas:
		                    	/*if(fleetDivisions.containsKey(dataV[5]) && fleetDivisions.get(dataV[5]).equals("datatype.distanceunit.kilometers")) {
		                    		miles = Integer.parseInt(String.valueOf(Math.round(Double.parseDouble(String.valueOf(miles)) / Util.KMS_TO_MILES)));
		                    	}*/
		                    	
		                    	System.out.println(miles);
		                        // TODO GUS
		                    	APMMByDivisionData apmm = new APMMByDivisionData(divOrg1Id,divOrg1Name,
			                        		divOrg2Id,divOrg2Name,divOrg3Id,divOrg3Name,divOrg4Id,divOrg4Name,
			                        		new Integer(miles),(Integer)dataV[3],(Integer)dataV[4],(Integer)dataV[6],monthCount.intValue()); 
		                       // Este apmm siempre tiene 1 vehiculo que es el que traigo en el registro dataV:
		                    	apmm.setTotalVehicles(1,FleetData.MONTHLY);
		                    	apmm.setMonthCount(key);
		                    	/*
		                    	if (data.isEmpty()){
		                        	// Seteo el numero de vehiculos en 1 la primera vez
		                        	// porque el primer vehiculo no pasa por el while siguiente
		                        	// si el data esta vacio.                        	
		                        	apmm.setTotalVehicles(1,FleetData.MONTHLY);
		                        }	
		                        */                        
		                      
		                        Iterator it = data.iterator();	                        
	
		                        boolean find = false;
		                        while(it.hasNext() && !find) {
		                            APMMByDivisionData element = (APMMByDivisionData)it.next();
		                            if(element.equalsData(apmm)) {
		                            	// Si apmm tiene las mismas divisiones que el elemento del data
		                            	// agrego al data el vehiculo nuevo
		                                element.addData(apmm,vehicle.getId());
		                                element.setMonthCount(key);
		                                find = true;
		                            }
		                        }
		                        
		                        /*
		                         * Si no encontre este vehicuo en data, entonces lo agrego.
		                         * Si data es vacio, find es false y agrego el vehiculo que esta en el apmm (que si no paso por el while es 1)
		                         */
		                        if(!find) {                        	
		                            data.add(apmm);
		                        }
	                    //    }
	                    }
	                }
	            }
            }
            
            
            return new ReportAPMMData(data,monthCount,order1,order2,order3,order4, isMiles);
            
        } catch(Exception e){
        	
        	e.printStackTrace();
        	Object[] p = new Object[11];
    		p[0] = periodFrom;
    		p[1] = yearFrom;
    		p[2] = periodTo;
    		p[3] = yearTo;
