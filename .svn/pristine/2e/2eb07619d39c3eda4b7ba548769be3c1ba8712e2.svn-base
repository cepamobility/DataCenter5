    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public ReportNewAPMMByPeriodData getNewReportAPMMByPeriod(String periodFrom, 
    		Integer yearFrom, String periodTo, Integer yearTo, Integer[][] divOrgs, 
    		Integer[] divGeos, int type, int order1, int order2, int order3, 
    		int order4, Text messages, int includes, UserSessionData userSessionData) throws Exception {
        try{     
            
            FleetReportHome home = FleetReportUtil.getHome();
            FleetReport fleetReport = home.create();
            Collection apmms = new LinkedList();
            
            if(includes == 0 || includes == 1) {
	            Collection list = fleetReport.getNewReportAPMMByPeriod(periodFrom, yearFrom, periodTo, yearTo,  divOrgs, divGeos, type, order1, order2, order3, order4, userSessionData);
	            if (list != null){
		            Iterator it = list.iterator();
		            while(it.hasNext()) {
		                Object[] dataObj = (Object[])it.next();
		                APMMData apmm = new APMMData(dataObj,Integer.parseInt(periodFrom), yearFrom.intValue(), Integer.parseInt(periodTo), yearTo.intValue(), order1, order2, order3, order4, messages);
		                Iterator itAPMM = apmms.iterator();
		                boolean find = false;
		                while(itAPMM.hasNext() && !find) {
		                    APMMData data = (APMMData)itAPMM.next();
		                    if(data.equalDivisions(apmm)) {
		                        find = true;
		                        data.addData(new APMMDataPeriod(dataObj));
		                    }
		                }
		                if(!find) {
		                    apmms.add(apmm);
		                }
		            }
	            }
            }

            if(includes == 0 || includes == 2) {
	            Hashtable periods = fleetReport.getNewReportAPMMByPeriodIndividual(periodFrom, yearFrom, periodTo, yearTo,  divOrgs, divGeos, type, userSessionData);
	            String prePeriod = getPreviousPeriod(new Integer(periodFrom),yearFrom);
	            if(periods.size() > 0 && !periods.containsKey(prePeriod)) {
	                throw new InvalidDataException("getReportMileage","invalid_month");
	            }
	            Enumeration en = periods.keys();
	            while(en.hasMoreElements()) {
	                String key = (String)en.nextElement();
	                if(!key.equals(prePeriod)) {
	                    Hashtable vehicles = (Hashtable)periods.get(key);
	                    Enumeration en2 = vehicles.elements();
	                    while(en2.hasMoreElements()) {
	                        Object[] dataV = (Object[])en2.nextElement();
	                        Integer miles = new Integer(((Integer)dataV[2]).intValue() - ((Integer)dataV[1]).intValue());
	                        APMMData apmmData = new APMMData(key,(VehicleData)dataV[0],miles,(Integer)dataV[3],Integer.parseInt(periodFrom), yearFrom.intValue(), Integer.parseInt(periodTo), yearTo.intValue(), userSessionData, order1, order2, order3, order4, messages);
	                        Iterator it = apmms.iterator();
	                        boolean find = false;
	                        while(it.hasNext() && !find) {
	                            APMMData element = (APMMData)it.next();
	                            if(element.equalDivisions(apmmData)) {
	                                StringTokenizer token = new StringTokenizer(key,"/");
	                                APMMDataPeriod period = new APMMDataPeriod(new Integer(token.nextToken()),new Integer(token.nextToken()),miles,(Integer)dataV[3]);
	                                element.addData(period);
	                                find = true;
	                            }
	                        }
	                        if(!find) {
	                            apmms.add(apmmData);
	                        }
	                    }
	                }
	            }
            }
            
            int periodCount = (yearTo.intValue() < yearFrom.intValue()) ? 0 : (12 - Integer.parseInt(periodFrom) + 1) + ((yearTo.intValue() - yearFrom.intValue() - 1) * 12) + Integer.parseInt(periodTo);
            return new ReportNewAPMMByPeriodData(apmms,periodCount);
        } catch(Exception e){
        	
        	Object[] p = new Object[12];
        	p[0] = periodFrom;
        	p[1] = yearFrom;
        	p[2] = periodTo;
        	p[3] = yearTo;
        	p[4] = divOrgs;
        	p[5] = divGeos;
        	p[6] = type;
        	p[7] = order1;
        	p[8] = order2;
        	p[9] = order3;
        	p[10] = order4;
        	p[11] = messages;      	
        	
            handler.handleException("getNewReportAPMMByPeriod",e,userSessionData,p);
        }
        return null;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public ReportNewAPMMByPeriodData getAcumulatedReportAPMMByPeriod(String periodFrom, 
    		Integer yearFrom, String periodTo, Integer yearTo, Integer[][] divOrgs, 
    		Integer[] divGeos, int type, int order1, int order2, 
    		int order3, int order4, Text messages, int includes, UserSessionData userSessionData) throws Exception {
        try{     
            
            Collection apmms = new LinkedList();
            FleetReportHome home = FleetReportUtil.getHome();
            FleetReport fleetReport = home.create();

            if(includes == 0 || includes == 1) {
	            Collection list = fleetReport.getNewReportAPMMByPeriod(periodFrom, yearFrom, periodTo, yearTo,  divOrgs, divGeos, type, order1, order2, order3, order4, userSessionData);
	            Iterator it = list.iterator();
	            while(it.hasNext()) {
	                Object[] dataObj = (Object[])it.next();
	                APMMAcumulatedData apmm = new APMMAcumulatedData(dataObj,Integer.parseInt(periodFrom), yearFrom.intValue(), Integer.parseInt(periodTo), yearTo.intValue(), order1, order2, order3, order4, messages);
	                Iterator itAPMM = apmms.iterator();
	                boolean find = false;
	                while(itAPMM.hasNext() && !find) {
	                    APMMAcumulatedData data = (APMMAcumulatedData)itAPMM.next();
	                    if(data.equalDivisions(apmm)) {
	                        find = true;
	                        data.addData(new APMMDataPeriod(dataObj));
	                    }
	                }
	                if(!find) {
	                    apmms.add(apmm);
	                }
	            }
            }
            
            if(includes == 0 || includes == 2) {
	            Hashtable periods = fleetReport.getNewReportAPMMByPeriodIndividual(periodFrom, yearFrom, periodTo, yearTo,  divOrgs, divGeos, type, userSessionData);
	            String prePeriod = getPreviousPeriod(new Integer(periodFrom),yearFrom);
	            if(periods.size() > 0 && !periods.containsKey(prePeriod)) {
	                throw new InvalidDataException("getAcumulatedReportAPMMByPeriod","invalid_month");
	            }
	            Enumeration en = periods.keys();
	            while(en.hasMoreElements()) {
	                String key = (String)en.nextElement();
	                if(!key.equals(prePeriod)) {
	                    Hashtable vehicles = (Hashtable)periods.get(key);
	                    Enumeration en2 = vehicles.elements();
	                    while(en2.hasMoreElements()) {
	                        Object[] dataV = (Object[])en2.nextElement();
	                        Integer miles = new Integer(((Integer)dataV[2]).intValue() - ((Integer)dataV[1]).intValue());
	                        APMMAcumulatedData apmmData = new APMMAcumulatedData(key,(VehicleData)dataV[0],miles,(Integer)dataV[3],Integer.parseInt(periodFrom), yearFrom.intValue(), Integer.parseInt(periodTo), yearTo.intValue(),userSessionData,order1,order2,order3,order4,messages);
	                        Iterator it = apmms.iterator();
	                        boolean find = false;
	                        while(it.hasNext() && !find) {
	                            APMMAcumulatedData element = (APMMAcumulatedData)it.next();
	                            if(element.equalDivisions(apmmData)) {
	                                StringTokenizer token = new StringTokenizer(key,"/");
	                                APMMDataPeriod period = new APMMDataPeriod(new Integer(token.nextToken()),new Integer(token.nextToken()),miles,(Integer)dataV[3]);
	                                element.addData(period);
	                                find = true;
	                            }
	                        }
	                        if(!find) {
	                            apmms.add(apmmData);
	                        }
	                    }
	                }
	            }
            }
            
            int periodCount = (yearTo.intValue() < yearFrom.intValue()) ? 0 : (12 - Integer.parseInt(periodFrom) + 1) + ((yearTo.intValue() - yearFrom.intValue() - 1) * 12) + Integer.parseInt(periodTo);
            return new ReportNewAPMMByPeriodData(apmms,periodCount);
        } catch(Exception e){
        	Object[] p = new Object[11];
        	p[0] = periodFrom;
        	p[1] = yearFrom;
        	p[2] = periodTo;
        	p[3] = yearTo;
        	p[4] = divOrgs;
        	p[5] = divGeos;
        	p[6] = type;
        	p[7] = order1;
        	p[8] = order2;
        	p[9] = order3;
        	p[10] = order4;
        	
            handler.handleException("getAcumulatedReportAPMMByPeriod",e,userSessionData,p);
        }
        return null;
    }

