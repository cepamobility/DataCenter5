 * 
 * @ejb.ejb-ref ejb-name = "FleetReport" 
 * 				ref-name = "ejb/FleetReport" 
 * 				view-type = "remote"
 * 
 * @ejb.ejb-ref ejb-name = "FleetReport" 
 * 				ref-name = "ejb/FleetReportLocal" 
 * 				view-type = "local"
 * 				link = "FleetReport" 
 * 
 * @jboss.ejb-ref-jndi jndi-name = "ejb/FleetReport" 
 * 						ref-name = "FleetReport"
 *  
 * @ejb.ejb-ref ejb-name = "EventReport" 
 * 				ref-name = "ejb/EventReport" 
 * 				view-type = "remote"
 * 				link = "EventReport"
 * 
 * @ejb.ejb-ref ejb-name = "EventReport" 
 * 				ref-name = "ejb/EventReportLocal" 
 * 				view-type = "local"
 * 				link = "EventReport"
 * 
 * @jboss.ejb-ref-jndi jndi-name = "ejb/EventReport" 
 * 				ref-name = "EventReport"
 *  
 * @ejb.ejb-ref ejb-name = "DriverReport" 
 * 				ref-name = "ejb/DriverReport" 
 * 				view-type = "remote"
 * 				link = "DriverReport"
 * 
 * @ejb.ejb-ref ejb-name = "DriverReport" 
 * 				ref-name = "ejb/DriverReportLocal" 
 * 				view-type = "local"
 * 				link = "DriverReport"
 * 
 * @jboss.ejb-ref-jndi jndi-name = "ejb/DriverReport" 
 * 				ref-name = "DriverReport"
 * @ejb.util generate="physical"
 *  
 */
public abstract class FleetReportFacadeBean implements SessionBean {

    private ExceptionHandler handler = new ExceptionHandler(FleetReportFacadeBean.class);
    public static final double KMS_TO_MILES = 1.609344;
	
	/**
	 * Default create method
	 * @throws CreateException
	 * @ejb.create-method
