    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query" 
     */
    public Collection kmByTrade(String frommonth, String fromyear, String tomonth, 
    		String toyear, String plate, int i, Integer[][] divOrgs, 
    		Integer[][] divGeos, UserSessionData userSessionData) throws Exception {
        try {
            if (userSessionData == null) {
                throw new DeslogedException("kmByTrade","userSessionData = null");
            }
            
            Collection list = FleetReportUtil.getHome().create().kmByTradeNew(frommonth,fromyear,tomonth,toyear,plate,i,divOrgs,divGeos,userSessionData);
            Iterator it = list.iterator();
            Hashtable values = new Hashtable();
            while(it.hasNext()) {
            	Object[] data = (Object[])it.next();
            	if(values.containsKey(data[12])) {
            		((KmByTradeDataType)values.get(data[12])).sumData(data);
            	}else {
            		values.put(data[12], new KmByTradeDataType(data,Integer.parseInt(frommonth),Integer.parseInt(fromyear)));
            	}
            }
            
            list = FleetReportUtil.getHome().create().kmByTradeInstitutional(frommonth,fromyear,tomonth,toyear,plate,i,divOrgs,divGeos,userSessionData);
            it = list.iterator();
            while(it.hasNext()) {
            	Object[] data = (Object[])it.next();
            	try {
                	if(values.containsKey(data[8])) {
                		((KmByTradeDataType)values.get(data[8])).sumData2(data);
                	}else {
                		values.put(data[8], new KmByTradeDataType(Integer.parseInt(frommonth),Integer.parseInt(fromyear),data));
                	}
            	}catch (Exception e) {
					e.printStackTrace();
				}
            }
            
            Collection valueList = new LinkedList();
            Enumeration enumeration = values.elements();
            while(enumeration.hasMoreElements()) {
            	valueList.add(enumeration.nextElement());
            }
            return valueList;
        } catch (Exception e) {
        	Object[] p = new Object[8];
        	p[0] = frommonth;
        	p[1] = fromyear;
        	p[2] = tomonth;
        	p[3] = toyear;
        	p[4] = plate;
        	p[5] = i;
        	p[6] = divOrgs;
        	p[7] = divGeos;
        	
            handler.handleException("kmByTrade", e, userSessionData, p);
        }
        return null;
    }

