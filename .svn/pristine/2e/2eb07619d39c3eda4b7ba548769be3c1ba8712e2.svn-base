    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public ReportIndividualConsumedFuelData getIndividualConsumedFuel(String periodFrom, 
    		Integer yearFrom, String periodTo, Integer yearTo, Integer[][] divOrgs, 
    		Integer[] divGeos, int order1, int order2, int order3, int order4,
    		UserSessionData userSessionData,Text messages) throws Exception {
        try{            
            FleetReportHome home = FleetReportUtil.getHome();
            FleetReport fleetReport = home.create();
            Collection data = new LinkedList();

            Hashtable periods = fleetReport.getReportIndividualFuel(periodFrom,yearFrom,periodTo,yearTo,divOrgs,divGeos,userSessionData);
            Enumeration en = periods.keys();
            String prePeriod = getPreviousPeriod(new Integer(periodFrom),yearFrom);
            int[][] principal = userSessionData.getFilter().getPrincipalDivOrgs();
            while(en.hasMoreElements()) {
                String key = (String)en.nextElement();
                if(!key.equals(prePeriod)) {
                    Hashtable vehicles = (Hashtable)periods.get(key);
                    Enumeration en2 = vehicles.elements();
                    while(en2.hasMoreElements()) {
                        Object[] dataV = (Object[])en2.nextElement();
                        VehicleData vehicle = (VehicleData)dataV[0];
                        String divOrg1Name = null;
                        Integer divOrg1Id = null;
                        switch(order1) {
                            case 3:
                                divOrg1Name = messages.getText(vehicle.getCountryName());
                                divOrg1Id = vehicle.getCountryId();
                                break;
                            case 0:case 1:case 2:
                                divOrg1Name = vehicle.getData(principal[order1][0],principal[order1][1]);    
                                divOrg1Id = vehicle.getIdData(principal[order1][0],principal[order1][1]);    
                                break;
                        }
                        String divOrg2Name = null;
                        Integer divOrg2Id = null;
                        switch(order2) {
                            case 3:
                                divOrg2Name = messages.getText(vehicle.getCountryName());
                                divOrg2Id = vehicle.getCountryId();
                                break;
                            case 0:case 1:case 2:
                                divOrg2Name = vehicle.getData(principal[order2][0],principal[order2][1]);    
                                divOrg2Id = vehicle.getIdData(principal[order2][0],principal[order2][1]);    
                                break;
                        }
                        String divOrg3Name = null;
                        Integer divOrg3Id = null;
                        switch(order3) {
                            case 3:
                                divOrg3Name = messages.getText(vehicle.getCountryName());
                                divOrg3Id = vehicle.getCountryId();
                                break;
                            case 0:case 1:case 2:
                                divOrg3Name = vehicle.getData(principal[order3][0],principal[order3][1]);    
                                divOrg3Id = vehicle.getIdData(principal[order3][0],principal[order3][1]);    
                                break;
                        }
                        String divOrg4Name = null;
                        Integer divOrg4Id = null;
                        switch(order4) {
                            case 3:
                                divOrg4Name = messages.getText(vehicle.getCountryName());
                                divOrg4Id = vehicle.getCountryId();
                                break;
                            case 0:case 1:case 2:
                                divOrg4Name = vehicle.getData(principal[order4][0],principal[order4][1]);    
                                divOrg4Id = vehicle.getIdData(principal[order4][0],principal[order4][1]);    
                                break;
                        }
                        int miles = (((Integer)dataV[2]).intValue() == 0 || 
                                ((Integer)dataV[1]).intValue() == 0) ? 0 : 
                                    ((Integer)dataV[2]).intValue() - ((Integer)dataV[1]).intValue();
                        IndividualConsumedFuelData apmm = new IndividualConsumedFuelData(divOrg1Id,divOrg1Name,
                                divOrg2Id,divOrg2Name,divOrg3Id,divOrg3Name,divOrg4Id,divOrg4Name,
                                new Integer(miles),(Integer)dataV[3],(String)dataV[4],vehicle.getType().getResourceBundleId(),vehicle.getId()); 
                        Iterator it = data.iterator();
                        boolean find = false;
                        while(it.hasNext() && !find) {
                            IndividualConsumedFuelData element = (IndividualConsumedFuelData)it.next();
                            if(element.equalsData(apmm)) {
                                element.addData(apmm,vehicle.getId());
                                find = true;
                            }
                        }
                        if(!find) {
                            data.add(apmm);
                        }
                    }
                }
            }

            return new ReportIndividualConsumedFuelData(data,messages);
            
        } catch(Exception e){
        	
        	Object[] p = new Object[11];
        	p[0] = periodFrom;
        	p[1] = yearFrom;
        	p[2] = periodTo;
        	p[3] = yearTo;
        	p[4] = divOrgs;
        	p[5] = divGeos;
        	p[6] = order1;
        	p[7] = order2;
        	p[8] = order3;
        	p[9] = order4;
        	p[10] = messages;
            handler.handleException("getIndividualConsumedFuel",e,userSessionData,p);
        }
        return null;
    }

    /**
     * @ejb.interface-method
