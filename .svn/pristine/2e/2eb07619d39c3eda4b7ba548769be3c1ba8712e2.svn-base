    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverodometer"
     */
    public Collection checkUploadOdometers(Collection values, String fleet, int period, int year, UserSessionData userSessionData) throws Exception {
    	Collection result = new LinkedList();
    	try {
    		FleetReport fleetReport = FleetReportUtil.getHome().create();
    		
    		Iterator valuesIt = values.iterator();
    		while(valuesIt.hasNext()) {
    			String[] newOdometer = (String[])valuesIt.next();
    			String idDallas = newOdometer[0];
    			String plate = newOdometer[1];
    			int newOdometerValue = Integer.parseInt(newOdometer[2]);
    			OdometerFileData odometerData = new OdometerFileData(idDallas,plate,newOdometerValue);
    			Object[] vehicle = fleetReport.getFleetVehicle(plate,fleet,userSessionData);
    			if(vehicle == null) {
					odometerData.setError(OdometerFileData.NOT_EXISTS);
    			}else {
    				odometerData.setDriverData(vehicle);
    				if(!((String)vehicle[4]).trim().equalsIgnoreCase(idDallas.trim())) {
    					DriverReport driverReport = DriverReportUtil.getHome().create();
    					DriverData newDriver = driverReport.findDriverByIdDallas(idDallas, userSessionData);
    					odometerData.setNewDriverId(newDriver.getId());
    					odometerData.setNewDriverName(newDriver);
    				}
    	    		Collection odometers = fleetReport.getOdometerValues((Integer)vehicle[0],fleet,userSessionData);
    	    		Iterator odometersIt = odometers.iterator();
    	    		boolean cont = true;
	    			while(odometersIt.hasNext() && cont) {
	    				Object[] data = (Object[])odometersIt.next();
	    				int insertedOdometer = ((Integer)data[0]).intValue();
	    				int insertedPeriod = ((Integer)data[1]).intValue();
	    				int insertedYear = ((Integer)data[2]).intValue();
	    				int comparation = comparePeriod(period,year,insertedPeriod,insertedYear);
	    				switch(comparation) {
	    					case -1:
    							odometerData.setLastData(insertedOdometer,insertedPeriod,insertedYear);
	    						if(insertedOdometer > newOdometerValue) {
	    							odometerData.setError(OdometerFileData.ERROR_PREV);
	    							odometerData.setInsertedData(insertedOdometer,insertedPeriod,insertedYear);
	    							cont = false;
	    						}
	    						break;
	    					case 0:
	    						if(insertedOdometer != newOdometerValue) {
	    							odometerData.setError(OdometerFileData.WARNING);
	    							odometerData.setInsertedData(insertedOdometer,insertedPeriod,insertedYear);
	    						}else {
	    							cont = false;
	    						}
	    						break;
	    					case 1:
	    						if(insertedOdometer < newOdometerValue) {
	    							odometerData.setError(OdometerFileData.ERROR_POST);
	    							odometerData.setInsertedData(insertedOdometer,insertedPeriod,insertedYear);
	    						}
    							cont = false;
	    						break;
	    				}
    				}
    			}
    			result.add(odometerData);
    		}
    	} catch (Exception e) {
        	Object[] p = {values,fleet,period,year};
            handler.handleException("checkUploadOdometers",e,userSessionData,p);
    	}
    	return result;
    }


	private int comparePeriod(int period1, int year1, int period2,int year2) {
		if(year1 < year2) {
			return -1;
		}else if(year1 > year2) {
			return 1;
		}else {
			if(period1 < period2) {
				return -1;
			}else if(period1 > period2) {
				return 1;
			}else {
				return 0;
			}			
		}
	}

    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverodometer"
     */
    public String getVehicleOdometerType(Integer vehicle,UserSessionData userSessionData) throws Exception {
    	try {
	    	FleetReport fleetReport = FleetReportUtil.getHome().create();
	    	Hashtable hash = fleetReport.getVehicleOdometerType(vehicle, userSessionData);
	    	Enumeration elements = hash.elements();
	    	while(elements.hasMoreElements()) {
	    		String value = (String)elements.nextElement();
	    		if(value != null && value.length() > 0) {
	    			return value;
	    		}
	    	}
    	}catch (Exception e) {
        	Object[] p = {vehicle};
            handler.handleException("getVehicleOdometerType",e,userSessionData,p);
    	}
    	return "datatype.distanceunit.kilometers";
    }

