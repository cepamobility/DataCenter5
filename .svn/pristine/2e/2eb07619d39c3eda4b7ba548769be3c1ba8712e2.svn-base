    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public ReportMileageData getReportMileage(String fromMonth, Integer fromYear, 
    		String toMonth, Integer toYear, String fleets, 
    		UserSessionData userSessionData,int monthCount) throws Exception {
        
    	try{            
            FleetReportHome home = FleetReportUtil.getHome();
            FleetReport fleetReport = home.create();
            Collection list = (Collection) fleetReport.getReportMileage(fromMonth,fromYear,toMonth,toYear,fleets,userSessionData);
            Iterator it = list.iterator();
            Collection data = new LinkedList();
            while(it.hasNext()) {
                data.add(new FleetMileage((Object[])it.next()));
            }
            Hashtable periods = fleetReport.getReportIndividualMileage(fromMonth,fromYear,toMonth,toYear,fleets,userSessionData);
            if(periods.size() > 0) {
            	Hashtable fleetDivisions = fleetReport.getFleetDivisionsData(fleets, userSessionData);
	            Enumeration en = periods.keys();
	            while(en.hasMoreElements()) {
	                String key = (String)en.nextElement();
	                if(inRange(key,Integer.parseInt(fromMonth),fromYear.intValue(),Integer.parseInt(toMonth),toYear.intValue())) {
	                    Hashtable vehicles = (Hashtable)periods.get(key);
	                    Enumeration en2 = vehicles.elements();
	                    while(en2.hasMoreElements()) {
	                        Object[] dataV = (Object[])en2.nextElement();
	                        FleetMileage mileage = new FleetMileage(key,(VehicleData)dataV[0],(Integer)dataV[1],(Integer)dataV[2],(Integer)dataV[3],(Integer)dataV[4],(Integer)dataV[6], fleetDivisions,(Integer)dataV[5], userSessionData);
	                        it = data.iterator();
	                        boolean find = false;
	                        while(it.hasNext() && !find) {
	                            FleetMileage element = (FleetMileage)it.next();
	                            if(element.equalsData(mileage)) {
	                                element.addData(mileage);
	                                find = true;
	                            }
	                        }
	                        if(!find) {
	                            data.add(mileage);
	                        }
	                    }
	                }
	            }
            }
            
            EventReportHome eventHome = EventReportUtil.getHome();
            EventReport eventReport = eventHome.create();
            it = eventReport.getEventCost(fromMonth,fromYear,toMonth,toYear,fleets,userSessionData).iterator();
            while(it.hasNext()) {
                EventCostData costData = (EventCostData)it.next();
                Iterator mileageIt = data.iterator();
                while(mileageIt.hasNext()) {
                    FleetMileage element = (FleetMileage)mileageIt.next();
                    if(element.equalDivisions(costData)) {
                        element.setAccidentCost(new Integer(element.getAccidentCost().intValue()+costData.getAccidentCost().intValue()));
                        element.setIncidentCost(new Integer(element.getIncidentCost().intValue()+costData.getIncidentCost().intValue()));
                        element.setNearmissCost(new Integer(element.getNearmissCost().intValue()+costData.getNearmissCost().intValue()));
                    }
                }
            }
            ReportMileageData report = new ReportMileageData(data,monthCount,userSessionData); 
            return report;
        } catch(Exception e){
        	
        	e.printStackTrace();
    		Object [] p = new Object[6];
        	p[0] = fromMonth;
        	p[1] = fromYear;
        	p[2] = toMonth;
        	p[3] = toYear;
        	p[4] = fleets;
        	p[5] = monthCount;
            handler.handleException("getReportMileage",e,userSessionData,p);
        }
        return null;
    }
    
    private boolean inRange(String key, int fromMonth, int fromYear, int toMonth, int toYear) {
    	StringTokenizer tokenizer = new StringTokenizer(key,"/");
    	int month = Integer.parseInt(tokenizer.nextToken());
    	int year = Integer.parseInt(tokenizer.nextToken());
    	if(year > toYear || (year == toYear && month > toMonth)) {
        	return false;
    	}
    	if(year < fromYear || (year == fromYear && month < fromMonth)) {
        	return false;
    	}
    	return true;
	}


	/**
     * 
     * @param period
     * @param year
     * @return
     */
    private String getPreviousPeriod(Integer period, Integer year) {
        if(String.valueOf(period).equals("1")) {
            period = new Integer(12);
            year = new Integer(year.intValue() - 1);
        }else {
            period = new Integer(period.intValue() - 1);
        }
        return String.valueOf(period)+"/"+String.valueOf(year);
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public ReportMileageData getReportMileageTotal(String fromMonth, Integer fromYear, 
    		String toMonth, Integer toYear, String fleets, 
    		UserSessionData userSessionData, int monthCount) throws Exception {
    	
        try{            
            FleetReportHome home = FleetReportUtil.getHome();
            FleetReport fleetReport = home.create();
            Iterator it = fleetReport.getReportMileageTotal(fromMonth,fromYear,toMonth,toYear,fleets,userSessionData).iterator();
            Collection data = new LinkedList();
            int months = (12 - Integer.parseInt(fromMonth) + 1) + ((toYear.intValue() - fromYear.intValue() - 1) * 12) + Integer.parseInt(toMonth);
            while(it.hasNext()) {
                FleetMileageTotal total = new FleetMileageTotal((Object[])it.next(),months);
                Iterator it2 = data.iterator();
                boolean find = false;
                while(it2.hasNext() && !find) {
                    FleetMileageTotal element = (FleetMileageTotal)it2.next();
                    if(element.equalsData(total)) {
                        element.addData(total);
                        find = true;
                    }
                }
                if(!find) {
                    data.add(total);
                }
            }
            Hashtable periods = fleetReport.getReportIndividualMileage(fromMonth,fromYear,toMonth,toYear,fleets,userSessionData);
            if(periods.size() > 0) {
	        	Hashtable fleetDivisions = fleetReport.getFleetDivisionsData(fleets, userSessionData);
	            Enumeration en = periods.keys();
	            String prePeriod = getPreviousPeriod(new Integer(fromMonth),fromYear);
	            while(en.hasMoreElements()) {
	                String key = (String)en.nextElement();
	                if(!key.equals(prePeriod)) {
	                    Hashtable vehicles = (Hashtable)periods.get(key);
	                    Enumeration en2 = vehicles.elements();
	                    while(en2.hasMoreElements()) {
	                        Object[] dataV = (Object[])en2.nextElement();
	                        FleetMileageTotal total = new FleetMileageTotal(key,(VehicleData)dataV[0],(Integer)dataV[1],(Integer)dataV[2],(Integer)dataV[3],(Integer)dataV[4],(Integer)dataV[6],months, fleetDivisions,(Integer)dataV[5],userSessionData);
	                        it = data.iterator();
	                        boolean find = false;
	                        while(it.hasNext() && !find) {
	                            FleetMileageTotal element = (FleetMileageTotal)it.next();
	                            if(element.equalsData(total)) {
	                                element.addData(total);
	                                find = true;
	                            }
	                        }
	                        if(!find) {
	                            data.add(total);
	                        }
	                    }
	                }
	            }
            }
            EventReportHome eventHome = EventReportUtil.getHome();
            EventReport eventReport = eventHome.create();
            it = eventReport.getEventTotalCost(fromMonth,fromYear,toMonth,toYear,fleets,userSessionData).iterator();
            while(it.hasNext()) {
                EventCostData costData = (EventCostData)it.next();
                Iterator mileageIt = data.iterator();
                while(mileageIt.hasNext()) {
                    FleetMileage element = (FleetMileage)mileageIt.next();
                    if(element.equalDivisions(costData)) {
                        element.setAccidentCost(new Integer(element.getAccidentCost().intValue()+costData.getAccidentCost().intValue()));
                        element.setIncidentCost(new Integer(element.getIncidentCost().intValue()+costData.getIncidentCost().intValue()));
                        element.setNearmissCost(new Integer(element.getNearmissCost().intValue()+costData.getNearmissCost().intValue()));
                    }
                }
            }
            return new ReportMileageData(data,monthCount,userSessionData);
        
        } catch(Exception e){
        	e.printStackTrace();
            Object[] p = new Object[6];
            p[0] = fromMonth;
            p[1] = fromYear;
            p[2] = toMonth;
            p[3] = toYear;
            p[4] = fleets;
            p[5] = monthCount;
            handler.handleException("getReportMileageTotal",e,userSessionData,p);
        }
        return null;
    }
    
