    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverodometer"
     */
    public Hashtable getFleetLastTwoOdometerValues(String fleet,String period,String year,UserSessionData userSessionData) throws Exception {
    	Hashtable result = new Hashtable();
    	Hashtable hash = new Hashtable();
    	try {
    		FleetReport fleetReport = FleetReportUtil.getHome().create();
    		Collection vehicles = fleetReport.getVehiclesByFleet(new Integer(fleet), userSessionData);
    		if(vehicles != null && vehicles.size() > 0) {
    			Iterator it = vehicles.iterator();
    			while(it.hasNext()) {
    				Object[] data = (Object[])it.next();
    				Object[] newData = {data[0],data[1],null,null,null,null,null,null};
    				hash.put(data[0], newData);
    			}
    			
    			Collection periodOdometers = fleetReport.getOdometers(fleet, period, year, 0, userSessionData);
        		if(periodOdometers != null && periodOdometers.size() > 0) {
        			it = periodOdometers.iterator();
        			while(it.hasNext()) {
        				Object[] data = (Object[])it.next();
        				if(hash.containsKey(data[0])) {
        					Object[] odometerData = (Object[])hash.get(data[0]);
        					odometerData[2] = data[1];
        					odometerData[4] = data[4];
        					odometerData[5] = data[5];
        				}
        			}
        		}
        		
        		Collection lastOdometers = fleetReport.getOdometers(fleet, period, year, -1, userSessionData);
        		if(lastOdometers != null && lastOdometers.size() > 0) {
        			it = lastOdometers.iterator();
        			while(it.hasNext()) {
        				Object[] data = (Object[])it.next();
        				if(hash.containsKey(data[0])) {
        					Object[] odometerData = (Object[])hash.get(data[0]);
        					odometerData[3] = data[1];
        					odometerData[6] = data[2];
        					odometerData[7] = data[3];
        				}
        			}
        		}
    		}
    		
    		Enumeration elements = hash.elements();
    		while(elements.hasMoreElements()) {
    			Object[] data = (Object[])elements.nextElement();
    			result.put(data[1], data);
    		}
    	}catch (Exception e) {
        	Object[] p = {fleet,period,year};
            handler.handleException("getFleetLastTwoOdometerValues", e, userSessionData, p);
		}
    	return result;
    }
    
