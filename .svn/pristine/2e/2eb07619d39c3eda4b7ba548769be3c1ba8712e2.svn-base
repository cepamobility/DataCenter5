    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public ReportAPMMByPeriodData getReportAPMMByPeriod(String periodFrom, Integer yearFrom, 
    		String periodTo, Integer yearTo, Integer[][] divOrgs, Integer[][] divGeos, 
    		int first, int count, Text messages, UserSessionData userSessionData) throws Exception {
        try{            
            FleetReportHome home = FleetReportUtil.getHome();
            FleetReport fleetReport = home.create();
            Collection list = fleetReport.getReportAPMMByPeriod(periodFrom, yearFrom, periodTo, yearTo,  divOrgs, divGeos, first, count, userSessionData);
            Iterator it = list.iterator();

            Hashtable unitChart = new Hashtable(); 
            Hashtable divisionChart = new Hashtable(); 
            Hashtable subdivisionChart = new Hashtable(); 

            Hashtable units = new Hashtable();
            while(it.hasNext()) {
                Object[] data = (Object[])it.next();
                String key1 = (data[2] == null || data.equals("")) ? "0" : String.valueOf(data[2]);
                String key2 = String.valueOf(data[4]);
                Object[] row = {data[3],data[5],data[7],data[0],data[1]};
                if(units.containsKey(key1)) {
                    Hashtable divisions = (Hashtable)units.get(key1);
                    if(divisions.containsKey(key2)) {
                        Collection rows = (Collection)divisions.get(key2);
                        rows.add(row);
                    }else {
                        Collection rows = new LinkedList();
                        rows.add(row);
                        divisions.put(key2,rows);
                    }
                }else {
                    Hashtable divisions = new Hashtable();
                    Collection rows = new LinkedList();
                    rows.add(row);
                    divisions.put(key2,rows);
                    units.put(key1,divisions);
                }
                if(unitChart.containsKey(key1)) {
                    Object[] column = (Object[])unitChart.get(key1);
                    column[1] = new Integer(((Integer)data[0]).intValue() + ((Integer)column[1]).intValue()); 
                    column[2] = new Integer(((Integer)data[1]).intValue() + ((Integer)column[2]).intValue()); 
                }else {
                    Object[] column = {data[3],data[0],data[1]};
                    unitChart.put(key1,column);
                }
                if(divisionChart.containsKey(key2)) {
                    Object[] column = (Object[])divisionChart.get(key2);
                    column[1] = new Integer(((Integer)data[0]).intValue() + ((Integer)column[1]).intValue()); 
                    column[2] = new Integer(((Integer)data[1]).intValue() + ((Integer)column[2]).intValue()); 
                }else {
                    Object[] column = {data[5],data[0],data[1]};
                    divisionChart.put(key2,column);
                }
                if(subdivisionChart.containsKey(data[6])) {
                    Object[] column = (Object[])subdivisionChart.get(data[6]);
                    column[1] = new Integer(((Integer)data[0]).intValue() + ((Integer)column[1]).intValue()); 
                    column[2] = new Integer(((Integer)data[1]).intValue() + ((Integer)column[2]).intValue()); 
                }else {
                    Object[] column = {data[7],data[0],data[1]};
                    subdivisionChart.put(data[6],column);
                }
            }
            Object[][] result = new Object[list.size()][5];
            Enumeration en = units.keys();
            int index = 0;
            while(en.hasMoreElements()) {
                Hashtable divisions = (Hashtable)units.get(en.nextElement());
                Enumeration en2 = divisions.elements();
                while(en2.hasMoreElements()) {
                    Iterator rows = ((Collection)en2.nextElement()).iterator();
                    while(rows.hasNext()) {
                        result[index] = (Object[])rows.next();
                        index++;
                    }
                }
            }
            return new ReportAPMMByPeriodData(result,unitChart,divisionChart,subdivisionChart);
       
        } catch(Exception e){
        	Object[] p = new Object[9];
        	p[0] = periodFrom;
        	p[1] = yearFrom;
        	p[2] = periodTo;
        	p[3] = yearTo;
        	p[4] = divOrgs;
        	p[5] = divGeos;
        	p[6] = first;
        	p[7] = count;
        	p[8] = messages;
            handler.handleException("getReportAPMMByPeriod",e,userSessionData,p);
        }
        return null;
    }

