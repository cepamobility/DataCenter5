    /**
     * 
     * @param row
     * @param result
     */
    @SuppressWarnings("unused")
	private void updateDataAccident(Object[] row, Object[] result) {
        String consequence = (String) result[3];
        if(consequence.equals("datatype.fleetconsequences.materialdamage")) {
            row[1] = new Integer(((Integer)row[1]).intValue() + ((Integer)result[0]).intValue());
        }else if(consequence.equals("datatype.fleetconsequences.injuredemployee")) {
            row[2] = new Integer(((Integer)row[2]).intValue() + ((Integer)result[0]).intValue());
        }else if(consequence.equals("datatype.fleetconsequences.injuredothers")) {
            row[4] = new Integer(((Integer)row[4]).intValue() + ((Integer)result[0]).intValue());
        }else if(consequence.equals("datatype.fleetconsequences.deceasedemployee")) {
            row[5] = new Integer(((Integer)row[5]).intValue() + ((Integer)result[0]).intValue());
        }else if(consequence.equals("datatype.fleetconsequences.injuredall")) {
            row[2] = new Integer(((Integer)row[2]).intValue() + ((Integer)result[0]).intValue());
            row[4] = new Integer(((Integer)row[4]).intValue() + ((Integer)result[0]).intValue());
        }else if(consequence.equals("datatype.fleetconsequences.deceasedothers")) {
            row[7] = new Integer(((Integer)row[7]).intValue() + ((Integer)result[0]).intValue());
        }else if(consequence.equals("datatype.fleetconsequences.decesaedall")) {
            row[5] = new Integer(((Integer)row[5]).intValue() + ((Integer)result[0]).intValue());
            row[7] = new Integer(((Integer)row[7]).intValue() + ((Integer)result[0]).intValue());
        }
        row[8] = new Integer(((Integer)row[8]).intValue() + ((Integer)result[0]).intValue());
        row[9] = new Integer(((Integer)row[9]).intValue() + ((Integer)result[1]).intValue());
    }

