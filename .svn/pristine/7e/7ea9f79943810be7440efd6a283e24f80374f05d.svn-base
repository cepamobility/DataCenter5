
<%@page language="java" 
    errorPage="../exception.jsp"
	import="business.*"
	import="business.datatype.*"
	import="business.vehicle.*"
	import="java.util.*"
	import="presentation.translator.web.util.*"
	import="presentation.translator.web.event.*"
	import="communication.event.tables.*"
	import="communication.driver.tables.*"
	import="communication.language.*"
	import="communication.datatype.*"
	import="communication.datatype.tables.*"
	import="communication.driver.tables.*"
	import="communication.administration.corporation.tables.*"
	import="communication.administration.user.*"
	import="communication.vehicle.tables.*"
	import="communication.security.*"
	import="communication.activity.tables.CEPAActivityScheduleRegistryData"
	import="communication.activity.tables.CEPAActivityConstants"
%>

<%@ taglib uri="/WEB-INF/struts-html.tld"
        prefix="html"
%>

<%!
	RequestDispatcher dispatcher; SystemAccess sys;	String context;
	String pathLanguage=null; 
	Text messages=null; 
	Integer driverId=null; 
	String driverName=null; 
	String driverLastName=null;
	NewEventForm eventForm=null;
	EventDataType eventDataType=null;
	UserSessionData userSessionData=null;
	String action=null;
	String formName=null;
	Integer eventId=null;
	int corporationId=0;
	VehicleData vehicle = null;
%>
<%

	

	sys = (SystemAccess)session.getAttribute("SystemAccess");
	if(sys == null){
		response.sendRedirect("/exception.jsp");
	}


	userSessionData = sys.getUserSessionData();
	messages = sys.getText();
	corporationId = sys.getUserSessionData().getFilter().getCorporationId().intValue();
	String check = null;
	String type = request.getParameter("type");
	
	if(sys.getUserSessionData().isDriver()) {
		if(type.equals("supervise")) {
			check = "/error.jsp";
		}else if(type.equals("edit")) {
		    check = Util.checkPermission(sys,SecurityConstants.DRIVER_MODIFY_EVENT);
		}else {
		    check = Util.checkPermission(sys,SecurityConstants.DRIVER_CREATE_EVENT);
		}
	}else {
		if(type.equals("supervise")) {
			check = Util.checkPermission(sys,SecurityConstants.SUPERVISE_EVENT);
		}else if(type.equals("edit")) {
			check = Util.checkPermission(sys,SecurityConstants.MODIFY_EVENT);
		}else {
		    check = Util.checkPermission(sys,SecurityConstants.CREATE_EVENT);
		}
	}
	
	
	if(check != null) {
		response.sendRedirect(request.getContextPath()+check);
	}else {
		
		String accidentCollision="";
		context = request.getContextPath();
		dispatcher = request.getRequestDispatcher("/util/jsp/message.jsp");
		dispatcher.include(request,response);
	
		messages = sys.getText();
	
		OptionItem emptyObject = new OptionItem(messages.getText("generic.messages.select"),"");
		OptionItem noDataObject = new OptionItem(messages.getText("generic.messages.nodata"),"generic.messages.nodata");
		OptionItem noApplyObject = new OptionItem(messages.getText("generic.messages.notapply"),"generic.messages.notapply");
		DriverData driver = null;
		
		if(type.equals("edit") || type.equals("supervise")) {
			
		    if(Util.empty(request.getParameter("eventId"))) {
			    eventId = (Integer)session.getAttribute("eventId");
		    }else {
			    eventId = new Integer(request.getParameter("eventId"));
		    }
			eventDataType = sys.getEventReportFacade().findEventByPrimaryKey(eventId,sys.getUserSessionData());
			 
			if(type.equals("edit")) {
				eventForm = new NewEventForm(eventDataType,userSessionData);				
			    formName = "NewEventForm";
				session.setAttribute(formName,eventForm);
			    action = "/NewEventupdate";
			    if(eventForm.getCollision().equals("datatype.collisionclasification.incident")){
			    	if(eventForm.getClasification()==null)
			    		accidentCollision="disabled"; 	
			    }
			    	
			}else {
			    formName = "NewEventSuperviseForm";
				eventForm = new NewEventSuperviseForm(eventDataType,sys.getUserSessionData());
				session.setAttribute(formName,eventForm);
			    action = "/NewEventsupervise";
			    if(eventForm.getCollision()!=null && eventForm.getCollision().equals("datatype.collisionclasification.incident")){
			    	if(eventForm.getClasification()==null)
			    		accidentCollision="disabled"; 	
			    }
			}
			if(sys.getUserSessionData().isDriver()) {
			    driver = sys.getUserSessionData().getDriverData();
			    driverId = driver.getId();
			}else {
			    driverId = new Integer(eventForm.getDriverid());
			    driver = sys.getDriverReportFacade().findDriverByPrimaryKey(driverId,sys.getUserSessionData());
			}
		}else {
			
			// Event Create
			eventDataType=null;
			formName = "NewEventForm";
		    action = "/NewEventcreate";
		    if((session.getAttribute("NewEventForm") != null)&&
		    	((request.getParameter("vehicle")==null) || (!request.getParameter("vehicle").equals("-1")))) {
		    	
			    eventForm = (NewEventForm)session.getAttribute("NewEventForm");
				
			    if(sys.getUserSessionData().isDriver()) {
				    driver = sys.getUserSessionData().getDriverData();
				    driverId = driver.getId();
				}else {
					
				    driverId = new Integer(eventForm.getDriverid());
				    driver = sys.getDriverReportFacade().findDriverByPrimaryKey(driverId,sys.getUserSessionData());
				}
			}else {
				if(sys.getUserSessionData().isDriver()) {
				    driver = sys.getUserSessionData().getDriverData();
				    driverId = driver.getId();
				}else {
				    driverId = new Integer(request.getParameter("id"));
				    driver = sys.getDriverReportFacade().findDriverByPrimaryKey(driverId,sys.getUserSessionData());
				}
			    eventForm = new NewEventForm(driver);
				session.setAttribute("NewEventForm",eventForm);
			}	    
			if((request.getParameter("vehicle") != null)&&(!request.getParameter("vehicle").equals("-1"))) {
			    eventForm.setVehicleId(request.getParameter("vehicle"));
			}
			if(eventForm.getClasification()==null){
		    	accidentCollision="disabled";
			}
		}
		if(!Util.empty(eventForm.getDriverid())) {
			if(sys.getUserSessionData().isDriver()) {
				session.setAttribute("url","/event/NewEventCreate.jsp?type="+type+"&vehicle="+String.valueOf(eventForm.getVehicleId()));
			}else {
				session.setAttribute("url","/event/NewEventCreate.jsp?type="+type+"&id="+String.valueOf(driverId)+"&vehicle="+String.valueOf(eventForm.getVehicleId()));
			}
	
			session.setAttribute("url","/event/NewEventCreate.jsp?type="+type+"id="+String.valueOf(driverId)+"&vehicle="+String.valueOf(eventForm.getVehicleId()));
	
			DataTypeUtil dataTypeUtil = new DataTypeUtil(sys);

			session.setAttribute("years",dataTypeUtil.getYears(1990,Calendar.getInstance().get(Calendar.YEAR)+1));
			session.setAttribute("generic",dataTypeUtil.getYesNo(true,true));
			session.setAttribute("genericDriver",dataTypeUtil.getYesNo(true,false));
			session.setAttribute("noandnodata",dataTypeUtil.getNoAndNoData());
			session.setAttribute("vehicleType",dataTypeUtil.getVehicleType(false,false,false));
			if(sys.isCorporation(CorporationData.SYNGENTA_BR)) {
		        Collection zoneDataTypes = new LinkedList();
		        zoneDataTypes.add(new OptionItem(messages.getText("generic.messages.select"),""));
		        zoneDataTypes.add(new OptionItem(messages.getText("datatype.zone.highway"),"datatype.zone.highway"));
		        zoneDataTypes.add(new OptionItem(messages.getText("datatype.zone.populatedrural"),"datatype.zone.populatedrural"));
		        zoneDataTypes.add(new OptionItem(messages.getText("datatype.zone.urban"),"datatype.zone.urban"));   
				session.setAttribute("zones",zoneDataTypes);
				
				Collection consequencesDataType = new LinkedList();
				consequencesDataType.add(new OptionItem(messages.getText("datatype.consequence.safe"),"datatype.consequence.safe"));
				consequencesDataType.add(new OptionItem(messages.getText("datatype.consequence.injured"),"datatype.consequence.injured"));
				consequencesDataType.add(new OptionItem(messages.getText("datatype.consequence.fatalities"),"datatype.consequence.fatalities"));
				session.setAttribute("consequences",consequencesDataType);

			}else {
				session.setAttribute("zones",dataTypeUtil.getDataType(DataTypeConstants.ZONE,true,false,false));
			}
			session.setAttribute("factorType",dataTypeUtil.getDataType(DataTypeConstants.NEW_ACCIDENT_FACTORS,true,false,false));
			session.setAttribute("behaviourType",dataTypeUtil.getDataType(DataTypeConstants.NEW_VEHICLE_BEHAVIOUR,true,false,false));
			session.setAttribute("climates",dataTypeUtil.getDataType(DataTypeConstants.CLIMATE,true,true,true));
			session.setAttribute("lightings",dataTypeUtil.getDataType(DataTypeConstants.LIGHTING,true,true,true));
			session.setAttribute("ways",dataTypeUtil.getDataType(DataTypeConstants.WAY,true,true,true));
			session.setAttribute("directions",dataTypeUtil.getDataType(DataTypeConstants.CIRCULATIONDIRECTION,true,true,true));

			if(sys.isBrasilCorporation()) {
		        Collection dataTypes = new LinkedList();
		        dataTypes.add(new OptionItem(messages.getText("generic.messages.select"),""));
		        dataTypes.add(new OptionItem(messages.getText("generic.messages.nodata"),"generic.messages.nodata"));
		        dataTypes.add(new OptionItem(messages.getText("datatype.trafficcontrols.lights"),"datatype.trafficcontrols.lights"));
		        dataTypes.add(new OptionItem(messages.getText("datatype.trafficcontrols.none"),"datatype.trafficcontrols.none"));
		        dataTypes.add(new OptionItem(messages.getText("datatype.trafficcontrols.other"),"datatype.trafficcontrols.other"));
		        dataTypes.add(new OptionItem(messages.getText("datatype.trafficcontrols.police"),"datatype.trafficcontrols.police"));
		        dataTypes.add(new OptionItem(messages.getText("datatype.trafficcontrols.roadsigns"),"datatype.trafficcontrols.roadsigns"));
				session.setAttribute("controls",dataTypes);
			}else {
				session.setAttribute("controls",dataTypeUtil.getDataType(DataTypeConstants.TRAFFIC_CONTROLS,true,true,true));
			}
			
			session.setAttribute("pavements",dataTypeUtil.getDataType(DataTypeConstants.PAVEMENT,true,true,true));
			session.setAttribute("conditions",dataTypeUtil.getDataType(DataTypeConstants.CONDITIONROUT,true,true,true));
			session.setAttribute("trades",dataTypeUtil.getTradeDataType(true));
		
			if(sys.isCorporation(CorporationData.SYNGENTA_BR)) {
				Collection eventSyngentaType = new LinkedList();
				eventSyngentaType.add(new OptionItem("Típico", "Típico"));				
				eventSyngentaType.add(new OptionItem("Trajeto", "Trajeto"));				
				eventSyngentaType.add(new OptionItem("Lazer", "Lazer"));				
				eventSyngentaType.add(new OptionItem("Almoço", "Almoço"));				
				eventSyngentaType.add(new OptionItem("N/A", "N/A"));				
				session.setAttribute("eventSyngentaType",eventSyngentaType);
			}
			
			Collection pedestrianActions = new LinkedList();
			pedestrianActions.add(emptyObject);				
			pedestrianActions.add(new OptionItem(messages.getText("driver.pedestrian.cross.intersection"),"driver.pedestrian.cross.intersection"));				
			pedestrianActions.add(new OptionItem(messages.getText("driver.pedestrian.cross.otherplace"),"driver.pedestrian.cross.otherplace"));				
			pedestrianActions.add(new OptionItem(messages.getText("driver.pedestrian.cross.out"),"driver.pedestrian.out"));				
			pedestrianActions.add(new OptionItem(messages.getText("driver.pedestrian.cross.other"),"driver.pedestrian.other"));				
			if (sys.getCorporationId() == CorporationData.PEPSICO){
				pedestrianActions.add(new OptionItem(messages.getText("driver.pedestrian.cross.stayon"),"driver.pedestrian.cross.stayon"));
			}
			session.setAttribute("pedestrianActions",pedestrianActions);
				
			Collection hitrunOthers = new LinkedList();
			hitrunOthers.add(emptyObject);                
			hitrunOthers.add(noDataObject);                
			hitrunOthers.add(new OptionItem(messages.getText("driver.hitrun.no"),"driver.hitrun.no"));
			hitrunOthers.add(new OptionItem(messages.getText("driver.hitrun.yes.known"),"driver.hitrun.yes.known"));
			hitrunOthers.add(new OptionItem(messages.getText("driver.hitrun.yes.unknown"),"driver.hitrun.yes.unknown"));
			session.setAttribute("hitrunOther",hitrunOthers);
		
			/* 	if (sys.getCorporationId() == CorporationData.PEPSICO){
				LinkedList distractorsOptions = new LinkedList();
				distractorsOptions.add(emptyObject);
				distractorsOptions.add(noDataObject);
				distractorsOptions.add(new OptionItem(messages.getText("driver.distractors.handhelp"),"driver.distractors.handhelp"));
				distractorsOptions.add(new OptionItem(messages.getText("driver.distractors.eating"),"driver.distractors.eating"));
				distractorsOptions.add(new OptionItem(messages.getText("driver.distractors.drinking"),"driver.distractors.drinking"));
				distractorsOptions.add(new OptionItem(messages.getText("driver.distractors.smoking"),"driver.distractors.smoking"));
				distractorsOptions.add(new OptionItem(messages.getText("driver.distractors.radio"),"driver.distractors.radio"));
				distractorsOptions.add(new OptionItem(messages.getText("driver.distractors.others"),"driver.distractors.others"));
				Collections.sort(distractorsOptions);
				session.setAttribute("distractorsOptions",distractorsOptions);
			}		*/
			
			Collection cellular = new LinkedList();
			if(!sys.isCorporation(CorporationData.BAYER_MX)) {
				cellular.add(emptyObject);				
				cellular.add(noDataObject);
				cellular.add(noApplyObject);
				cellular.add(new OptionItem(messages.getText("driver.cellular.no"),"driver.cellular.no"));
				cellular.add(new OptionItem(messages.getText("driver.cellular.yes.freehand"),"driver.cellular.yes.freehand"));
				cellular.add(new OptionItem(messages.getText("driver.cellular.yes.normal"),"driver.cellular.yes.normal"));
			}else {
				cellular.add(noDataObject);
				cellular.add(new OptionItem(messages.getText("event.gravity.fatality"),"event.gravity.fatality"));
				cellular.add(new OptionItem(messages.getText("event.gravity.permanent.incapacity"),"event.gravity.permanent.incapacity"));
				cellular.add(new OptionItem(messages.getText("event.gravity.parcial.incapacity"),"event.gravity.parcial.incapacity"));
				cellular.add(new OptionItem(messages.getText("event.gravity.noincapacity"),"event.gravity.noincapacity"));
			}
			session.setAttribute("cellulars",cellular);
			
			Collection selfbelt = new LinkedList();
			selfbelt.add(emptyObject);
			selfbelt.add(noDataObject);
			selfbelt.add(noApplyObject);
			selfbelt.add(new OptionItem(messages.getText("generic.messages.yes"),"generic.messages.yes"));
			selfbelt.add(new OptionItem(messages.getText("generic.messages.no"),"generic.messages.no"));
			if(sys.getCorporationId() == CorporationData.CIMSA) {
				selfbelt.add(new OptionItem(messages.getText("generic.messages.missing"),"generic.messages.missing"));
			}
			session.setAttribute("selfbelt",selfbelt);
			
			Collection speedunits = new LinkedList();
			speedunits.add(emptyObject);				
			speedunits.add(new OptionItem(messages.getText("driver.speedunits.metres"),"1"));
			speedunits.add(new OptionItem(messages.getText("driver.speedunits.milles"),"2"));
			session.setAttribute("speedunits",speedunits);

			Collection drives = new LinkedList();
			drives.add(emptyObject);				
			drives.add(new OptionItem(messages.getText("event.whodrives.driver"),"event.whodrives.driver"));
			drives.add(new OptionItem(messages.getText("event.whodrives.auxiliar"),"event.whodrives.auxiliar"));
			session.setAttribute("drives",drives);
	
%>

<!-- Para deshabilitar y habilitar todos los checks en CIMSA. Librería JQuery -->
<script type="text/javascript" src="./menu/js/jquery-latest.js">
</script>
   
<script language="javascript" src='./menu/js/driverFunctions.js' type='text/javascript' >
</script>

<script language="javascript" src='./menu/js/refactors.js' type='text/javascript' >
</script>

<script language="javascript" src='./menu/js/eventFunctions.js' type='text/javascript' >
</script>

	<script type='text/javascript' >


		<%
		
			//Si es anterior al 2016 se manda a editar en EventCreate2.jsp
			if(type.equals("edit") || type.equals("supervise")) {
			
			    if(eventDataType!=null){
					Calendar cal=Calendar.getInstance();
	            	cal.set(Calendar.MONTH, 0);
	            	cal.set(Calendar.DATE,1);
	            	cal.set(Calendar.YEAR,2016);
	            	cal.set(Calendar.HOUR,0);
	            	cal.set(Calendar.MINUTE,0);
	            	cal.set(Calendar.SECOND,0);
	            	cal.set(Calendar.MILLISECOND,0);
	            	Calendar cal2=Calendar.getInstance();
	            	if(cal2.compareTo(cal)<0){
	            		%><%="document.location.href='layout.jsp?refer=/event/EventCreate2.jsp?type="+type+"&eventId="+eventId+"'"%><%
	            	}
				}
			}
		%>
	
		function existEvent() {
			var form = document.forms['<%=formName%>'];
			var id = '<%=(type.equals("edit") || type.equals("supervise")) ? String.valueOf(eventId) : "0"%>';
			var driver = '<%=String.valueOf(driverId)%>';
			var vehicleId = '<%=(Util.empty(eventForm.getVehicleId())) ? "0" : eventForm.getVehicleId()%>';
			var vehicleplate = '';
			if(vehicleId == '0') {
				vehicleplate = form.vehicleplate.value;
			}
			if(vehicleId == '0' && vehicleplate == '') {
				alert('generic.event.eventdata.vehicle.plateEmpty');
			} else if(form.date.value == '' || isNaN(form.date.value)
					|| form.month.value == '' || isNaN(form.month.value)
					|| form.year.value == '' || isNaN(form.year.value)) {
				alert('generic.event.eventdata.dateinvalid');
			} else if(form.clasificationType.value == '' || form.clasification ==undefined ||  form.clasification.value == '') {
				alert('generic.event.eventdata.clasificationSelect');
			}else {
				$.getJSON("event/existEvent.jsp?id="+id+"&driver="+driver+"&vehicle="+vehicleId+"&plate="+vehicleplate+"&date="+form.date.value+"&month="+form.month.value+"&year="+form.year.value+"&eventtype="+form.clasificationType.value+"&type="+form.clasification.value,
						function(data) {
							if(data.result) {
								var r = confirm('event.error.alreadyexists');
								if(r) {
									form.submit();
								}
							}else {
								form.submit();
							}
						}
				);
			}
		}


		function changeHandle(combo){
			if($(combo).attr("value").indexOf('texto')>-1){
				$("#handleTextDiv").show();
			}else{
				$("#handleTextDiv").hide();
				$("#handleText").attr('value','');
			}
		}

		function changePrincipalFactor(combo){
			if($(combo).attr("value").indexOf('texto')>-1){
				$("#principalFactorTextDiv").show();
			}else{
				$("#principalFactorTextDiv").hide();
				$("#principalFactorText").attr('value','');
			}
		}

		function changeBehaviourTypeI(combo,i){
			if($(combo).attr("value").indexOf('texto')>-1){
				$("#behaviourTypeTextDiv"+i).show();
			}else{
				$("#behaviourTypeTextDiv"+i).hide();
				$("#behaviourTypeText"+i).attr('value','');
			}
		}

		function changePrincipalFactorI(combo,i){
			if($(combo).attr("value").indexOf('texto')>-1){
				$("#principalFactorTextDiv"+i).show();
			}else{
				$("#principalFactorTextDiv"+i).hide();
				$("#principalFactorText"+i).attr('value','');
			}
		}

		$(document).ready(
			function(){

				$("#clasificationText").hide();
				
				var radios="";
				$("div[tag='newclasification'][p='first']").each(
					function(){
<%						if(!sys.isCorporation(CorporationData.SYNGENTA_BR)) {	
%>						radios+="<br/>";
<%						} else {
%>						radios+="&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;";
<%						}
%>						radios+="<input type='radio' tag='radiolevel1' name='clasification1' value='"+$(this).attr("value")+"'>"+$(this).attr("text")+"</input>";
					}
				);	

				$("#clasificationlevel1").html(radios);
				$("#clasificationlevel2,#clasificationlevel3,#clasificationlevel4").html('');

				$("input[tag='radiolevel1']").each(
					function(){
						$(this).click(
							function(){
								$("#clasificationText").hide();
								var parent=$(this).attr("value");
								var radios="";
								$("div[tag='newclasification'][p='"+parent+"']").each(
									function(){
										radios+="<br/>"+"<input type='radio' tag='radiolevel2' name='clasification2' value='"+$(this).attr("value")+"'>"+$(this).attr("text")+"</input>";
									}
								);

								$("#clasificationlevel2").html(radios);
								$("#clasificationlevel3,#clasificationlevel4").html('');
								$("#clasificationText").hide().attr("value",'');
								
								$("input[tag='radiolevel2']").each(
										function(){
											$(this).click(
												function(){
													$("#clasificationText").hide();
													var parent=$(this).attr("value");
													var radios="";
													$("div[tag='newclasification'][p='"+parent+"']").each(
														function(){
															radios+="<br/>"+"<input type='radio' tag='radiolevel3' name='clasification3' value='"+$(this).attr("value")+"'>"+$(this).attr("text")+"</input>";
														}
													);

													$("#clasificationlevel3").html(radios);
													$("#clasificationlevel4").html('');
													$("#clasificationText").hide().attr("value",'');
													
													$("input[tag='radiolevel3']").each(
															function(){
																$(this).click(
																	function(){
																		$("#clasificationText").hide();
																		var parent=$(this).attr("value");
																		var radios="";
																		var texto='';
																		$("div[tag='newclasification'][p='"+parent+"']").each(
																			function(){
																				var aux=$(this).attr("value");
																				if(aux.indexOf('texto')>-1){
																					texto=aux;
																				}
																				radios+="<br/>"+"<input type='radio' tag='radiolevel4' name='clasification4' value='"+$(this).attr("value")+"'>"+$(this).attr("text")+"</input>";
																			}
																		);
																		$("#clasificationlevel4").html(radios);

																		if(texto!=''){
																			$("input[value='"+texto+"'][tag='radiolevel4']").change(
																					function(){
																						if($(this).is(":checked")){
																							$("#clasificationText").show();
																						} 
																					}
																				);
																			$("input[value!='"+texto+"'][tag='radiolevel4']").change(
																					function(){
																						if($(this).is(":checked")){
																							$("#clasificationText").hide().attr("value",'');
																						}	
																					}
																			);																		
																	    }

																		$("input[tag='radiolevel4']").change(
																				function(){
																					if($(this).is(":checked")){
																						$("#clasification").attr("value",$(this).attr("value"));
																					}	
																				}
																		);		
																		 

																		if($("input[tag='radiolevel4']").length==1){
																			$("input[tag='radiolevel4']")[0].click();
																		}
																	}
																);
															}
														);

													
													if($("input[tag='radiolevel3']").length==1){
														$("input[tag='radiolevel3']")[0].click();
													}
													
												}
											);
										}
									);
								if($("input[tag='radiolevel2']").length==1){
									$("input[tag='radiolevel2']")[0].click();
								}
								
							}
						);
					}
				);

<%			if(sys.isCorporation(CorporationData.SYNGENTA_BR)) {
%>				var prefix = 'syngenta';
<%			}else {
%>				var prefix = 'general';
<%			}													
%>				
				
				$("input[tag='radiolevel1']").each(
					function(){
						$(this).change(
							function(){
								if($(this).is(":checked")){
									if($(this).attr('value')==prefix+'.eventdata.accidentclasification1'){
										$("#clasificationType").attr("value",0);
									}else if($(this).attr('value')==prefix+'.eventdata.accidentclasification2'){
										$("#clasificationType").attr("value",1);
									}else if($(this).attr('value')==prefix+'.eventdata.accidentclasification3'){
										$("#clasificationType").attr("value",2);
									}
										
								}
							}	
						);
					}
				);
				if($("input[tag='radiolevel1']").length==1){
					$("input[tag='radiolevel1']")[0].click();
				}
				
				$("div[tag='clasificationsel1']").each(
					function(){
						$("input[tag='radiolevel1'][value='"+$(this).attr("value")+"']")[0].click();
						if($(this).attr('value')==prefix+'.eventdata.accidentclasification1'){
							$("#clasificationType").attr("value",0);
						}else if($(this).attr('value')==prefix+'.eventdata.accidentclasification2'){
							$("#clasificationType").attr("value",1);
						}else if($(this).attr('value')==prefix+'.eventdata.accidentclasification3'){
							$("#clasificationType").attr("value",2);
						}
						$("div[tag='clasificationsel2']").each(
							function(){
								$("input[tag='radiolevel2'][value='"+$(this).attr("value")+"']")[0].click();
								$("div[tag='clasificationsel3']").each(
									function(){
										$("input[tag='radiolevel3'][value='"+$(this).attr("value")+"']")[0].click();
										$("div[tag='clasificationsel']").each(
											function(){
												$("input[tag='radiolevel4'][value='"+$(this).attr("value")+"']")[0].click();
												$("div[tag='clasificationseltext']").each(
													function(){
														$("#clasificationText").attr('value',$(this).attr("value"));
													}
												);
												
											}
										);
									}
								);
							}
						);
					}
				);


				//CL CEPA
				$("#clasificationCEPAText").hide();
				
				var radios="";
				$("div[tag='newclasification'][p='first']").each(
					function(){
						radios+="<br/>"+"<input type='radio' tag='radiolevelcepa1' name='clasificationCEPA1' value='"+$(this).attr("value")+"'>"+$(this).attr("text")+"</input>";
					}
				);	

				$("#clasificationlevelCEPA1").html(radios);
				$("#clasificationlevelCEPA2,#clasificationlevelCEPA3,#clasificationlevelCEPA4").html('');

				$("input[tag='radiolevelcepa1']").each(
					function(){
						$(this).click(
							function(){
								$("#clasificationCEPAText").hide();
								var parent=$(this).attr("value");
								var radios="";
								$("div[tag='newclasification'][p='"+parent+"']").each(
									function(){
										radios+="<br/>"+"<input type='radio' tag='radiolevelcepa2' name='clasificationCEPA2' value='"+$(this).attr("value")+"'>"+$(this).attr("text")+"</input>";
									}
								);

								$("#clasificationlevelCEPA2").html(radios);
								$("#clasificationlevelCEPA3,#clasificationlevelCEPA4").html('');
								$("#clasificationCEPAText").hide().attr("value",'');
								
								$("input[tag='radiolevelcepa2']").each(
										function(){
											$(this).click(
												function(){
													$("#clasificationCEPAText").hide();
													var parent=$(this).attr("value");
													var radios="";
													$("div[tag='newclasification'][p='"+parent+"']").each(
														function(){
															radios+="<br/>"+"<input type='radio' tag='radiolevelcepa3' name='clasificationCEPA3' value='"+$(this).attr("value")+"'>"+$(this).attr("text")+"</input>";
														}
													);

													$("#clasificationlevelCEPA3").html(radios);
													$("#clasificationlevelCEPA4").html('');
													$("#clasificationCEPAText").hide().attr("value",'');
													
													$("input[tag='radiolevelcepa3']").each(
															function(){
																$(this).click(
																	function(){
																		$("#clasificationCEPAText").hide();
																		var parent=$(this).attr("value");
																		var radios="";
																		var texto='';
																		$("div[tag='newclasification'][p='"+parent+"']").each(
																			function(){
																				var aux=$(this).attr("value");
																				if(aux.indexOf('texto')>-1){
																					texto=aux;
																				}
																				radios+="<br/>"+"<input type='radio' tag='radiolevelcepa4' name='clasificationCEPA4' value='"+$(this).attr("value")+"'>"+$(this).attr("text")+"</input>";
																			}
																		);
																		$("#clasificationlevelCEPA4").html(radios);

																		if(texto!=''){
																			$("input[value='"+texto+"'][tag='radiolevelcepa4']").change(
																					function(){
																						if($(this).is(":checked")){
																							$("#clasificationCEPAText").show();
																						} 
																					}
																				);
																			$("input[value!='"+texto+"'][tag='radiolevelcepa4']").change(
																					function(){
																						if($(this).is(":checked")){
																							$("#clasificationCEPAText").hide().attr("value",'');
																						}	
																					}
																			);																		
																	    }

																		/*$("input[tag='radiolevel4']").change(
																				function(){
																					if($(this).is(":checked")){
																						$("#clasification").attr("value",$(this).attr("value"));
																					}	
																				}
																		);*/		
																		 

																		if($("input[tag='radiolevelcepa4']").length==1){
																			$("input[tag='radiolevelcepa4']")[0].click();
																		}
																	}
																);
															}
														);

													
													if($("input[tag='radiolevelcepa3']").length==1){
														$("input[tag='radiolevelcepa3']")[0].click();
													}
													
												}
											);
										}
									);
								if($("input[tag='radiolevelcepa2']").length==1){
									$("input[tag='radiolevelcepa2']")[0].click();
								}
								
							}
						);
					}
				);

				if($("input[tag='radiolevelcepa1']").length==1){
					$("input[tag='radiolevelcepa1']")[0].click();
				}
				
				$("div[tag='clasificationselcepa1']").each(
					function(){
						$("input[tag='radiolevelcepa1'][value='"+$(this).attr("value")+"']")[0].click();
						
						$("div[tag='clasificationselcepa2']").each(
							function(){
								$("input[tag='radiolevelcepa2'][value='"+$(this).attr("value")+"']")[0].click();
								$("div[tag='clasificationselcepa3']").each(
									function(){
										$("input[tag='radiolevelcepa3'][value='"+$(this).attr("value")+"']")[0].click();
										$("div[tag='clasificationselcepa']").each(
											function(){
												$("input[tag='radiolevelcepa4'][value='"+$(this).attr("value")+"']")[0].click();
												$("div[tag='clasificationselcepatext']").each(
													function(){
														$("#clasificationCEPAText").attr('value',$(this).attr("value"));
													}
												);
												
											}
										);
									}
								);
							}
						);
					}
				);
			}
		);
	</script>
		
	<html:form action='<%=action%>' >
	
	<%
			String prefix = (sys.isCorporation(CorporationData.SYNGENTA_BR)) ? "syngenta" : "general";
			Collection colAccindentLevel1=sys.getDataTypeReportFacade().findAllClasificationLevel(sys.getUserSessionData(), DataTypeConstants.ACCIDENT_CLASIFICATION_LEVEL1,prefix);
			Iterator iterAccidentLevel1=colAccindentLevel1.iterator();
			while(iterAccidentLevel1.hasNext()){
				AccidentClasificationLevel1DataType datatType1=(AccidentClasificationLevel1DataType)iterAccidentLevel1.next();
				%><%="<div style='display:none;visibility:hidden;' tag='newclasification' p='first' value='"+datatType1.getResourceBundleId()+"' text='"+messages.getText(datatType1.getResourceBundleId())+"'></div>"%><%
				Collection colAccidentLevel2=sys.getDataTypeReportFacade().findAllClasificationLevel(sys.getUserSessionData(), DataTypeConstants.ACCIDENT_CLASIFICATION_LEVEL2,datatType1.getResourceBundleId());
				Iterator iterAccidentLevel2=colAccidentLevel2.iterator();
				while(iterAccidentLevel2.hasNext()){
					AccidentClasificationLevel2DataType datatType2=(AccidentClasificationLevel2DataType)iterAccidentLevel2.next();
					%><%="<div style='display:none;visibility:hidden;' tag='newclasification' p='"+datatType1.getResourceBundleId()+"' value='"+datatType2.getResourceBundleId()+"' text='"+messages.getText(datatType2.getResourceBundleId())+"'></div>"%><%
					Collection colAccidentLevel3=sys.getDataTypeReportFacade().findAllClasificationLevel(sys.getUserSessionData(), DataTypeConstants.ACCIDENT_CLASIFICATION_LEVEL3,datatType2.getResourceBundleId());
					Iterator iterAccidentLevel3=colAccidentLevel3.iterator();
					while(iterAccidentLevel3.hasNext()){
						AccidentClasificationLevel3DataType datatType3=(AccidentClasificationLevel3DataType)iterAccidentLevel3.next();
						%><%="<div style='display:none;visibility:hidden;' tag='newclasification' p='"+datatType2.getResourceBundleId()+"' value='"+datatType3.getResourceBundleId()+"' text='"+messages.getText(datatType3.getResourceBundleId())+"'></div>"%><%
						Collection colAccidentLevel4=sys.getDataTypeReportFacade().findAllClasificationLevel(sys.getUserSessionData(), DataTypeConstants.ACCIDENT_CLASIFICATION_LEVEL4,datatType3.getResourceBundleId());
						Iterator iterAccidentLevel4=colAccidentLevel4.iterator();
						while(iterAccidentLevel4.hasNext()){
							AccidentClasificationLevel4DataType datatType4=(AccidentClasificationLevel4DataType)iterAccidentLevel4.next();
							%><%="<div style='display:none;visibility:hidden;' tag='newclasification' p='"+datatType3.getResourceBundleId()+"' value='"+datatType4.getResourceBundleId()+"' text='"+messages.getText(datatType4.getResourceBundleId())+"'></div>"%><%
						}

					}
				}
			}
			
			if(eventDataType!=null){
				%> <%="<div style='display:none;visibility:hidden;' tag='clasificationsel1' value='"+eventDataType.getClasificationName(1)+"'></div>"%><%
				%> <%="<div style='display:none;visibility:hidden;' tag='clasificationsel2' value='"+eventDataType.getClasificationName(2)+"'></div>"%><%
				%> <%="<div style='display:none;visibility:hidden;' tag='clasificationsel3' value='"+eventDataType.getClasificationName(3)+"'></div>"%><%
				%> <%="<div style='display:none;visibility:hidden;' tag='clasificationsel' value='"+eventDataType.getClasificationName(4)+"'></div>"%><%
				%> <%="<div style='display:none;visibility:hidden;' tag='clasificationseltext' value='"+eventDataType.getClasificationText()+"'></div>"%><%
				if(eventDataType.getClasificationCEPAName(1)!=null && eventDataType.getClasificationCEPAName(1).trim().length()>0){ 
				%> <%="<div style='display:none;visibility:hidden;' tag='clasificationselcepa1' value='"+eventDataType.getClasificationCEPAName(1)+"'></div>"%><%
				}
				if(eventDataType.getClasificationCEPAName(2)!=null && eventDataType.getClasificationCEPAName(2).trim().length()>0){ 
				%> <%="<div style='display:none;visibility:hidden;' tag='clasificationselcepa2' value='"+eventDataType.getClasificationCEPAName(2)+"'></div>"%><%
				}
				if(eventDataType.getClasificationCEPAName(3)!=null && eventDataType.getClasificationCEPAName(3).trim().length()>0){ 
				%> <%="<div style='display:none;visibility:hidden;' tag='clasificationselcepa3' value='"+eventDataType.getClasificationCEPAName(3)+"'></div>"%><%
				}
				if(eventDataType.getClasificationCEPAName(4)!=null && eventDataType.getClasificationCEPAName(4).trim().length()>0){ 
				%> <%="<div style='display:none;visibility:hidden;' tag='clasificationselcepa' value='"+eventDataType.getClasificationCEPAName(4)+"'></div>"%><%
				}
				if(eventDataType.getClasificationCEPAText()!=null && eventDataType.getClasificationCEPAText().trim().length()>0){ 
				%> <%="<div style='display:none;visibility:hidden;' tag='clasificationselcepatext' value='"+eventDataType.getClasificationCEPAText()+"'></div>"%><%
				}
			}
			
			
		%>
		
