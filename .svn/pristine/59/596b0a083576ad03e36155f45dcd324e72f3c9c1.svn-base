package business.ws.client.vehicle;

import java.io.Serializable;

public class WSLVehicleCheckData implements Serializable{

	 private static final long serialVersionUID = 1L;
	
	 private Integer id;
	 private String date;
	 private Integer result;
	 private Integer divOrgItem1;
	 private Integer divOrgItem2;
	 private Integer divOrgItem3;
	 
	 
	public Integer getId() {
		return id;
	}
	public void setId(Integer id) {
		this.id = id;
	}
	public String getDate() {
		return date;
	}
	public void setDate(String date) {
		this.date = date;
	}
	public Integer getResult() {
		return result;
	}
	public void setResult(Integer result) {
		this.result = result;
	}
	public Integer getDivOrgItem1() {
		return divOrgItem1;
	}
	public void setDivOrgItem1(Integer divOrgItem1) {
		this.divOrgItem1 = divOrgItem1;
	}
	public Integer getDivOrgItem2() {
		return divOrgItem2;
	}
	public void setDivOrgItem2(Integer divOrgItem2) {
		this.divOrgItem2 = divOrgItem2;
	}
	public Integer getDivOrgItem3() {
		return divOrgItem3;
	}
	public void setDivOrgItem3(Integer divOrgItem3) {
		this.divOrgItem3 = divOrgItem3;
	}
		
}
