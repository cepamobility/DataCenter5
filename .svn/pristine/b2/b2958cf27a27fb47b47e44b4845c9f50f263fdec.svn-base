<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.util.tables" >
    <class name="AppDevice" table="appdevices">		
        <id	column="id"	name="id"	type="java.lang.Integer">
            <generator class="sequence">
            	<param name="sequence">Device_Sequence</param>
            </generator>
        </id>
        <property	name="appId" type="java.lang.String" column="appid"/>    	
        <property	name="deviceToken" type="java.lang.String" column="devicetoken"/>    	
        <property	name="status" type="java.lang.Integer" column="status"/>    	
   	</class>
</hibernate-mapping>


