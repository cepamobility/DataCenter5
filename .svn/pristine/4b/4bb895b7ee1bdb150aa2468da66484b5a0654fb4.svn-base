<%@page language="java" 
	errorPage="exception.jsp" 
	import="java.util.*"
	import="business.*"
	import="business.vehicle.*"
	import="business.administration.user.*"
	import="communication.language.*"
	import="communication.security.*"
	import="communication.administration.user.tables.*"
	import="communication.vehicle.tables.*"
	import="communication.fleet.tables.*"
	import="communication.vehicle.tables.*"
	import="communication.util.*"
 	import="presentation.translator.web.util.*"
 	import="presentation.translator.web.vehicle.*" 	
 	import="communication.administration.user.*" 	
%>

<%@ taglib uri="/WEB-INF/struts-html.tld"
        prefix="html"
%>

<%@page import="communication.administration.corporation.tables.CorporationData"%>
<%@page import="communication.driver.tables.DriverData"%>
<%@page import="communication.administration.corporation.tables.CountryData"%>
<%@page import="business.datatype.DataTypeReportFacade"%>


<%@page import="communication.datatype.DataTypeConstants"%>
<%@page import="communication.datatype.tables.SexDataType"%><html xmlns="http://www.w3.org/1999/xhtml">
	<head>
		<LINK REL=StyleSheet HREF="../util/css/estilo.css" TYPE="text/css">
	 	<title> CEPA International</title>
		<META http-equiv="Cache-Control" content="no-cache">
		<META http-equiv="Pragma" content="no-cache">
		<style type="text/css">
<!--	body {
			margin-left: 0px;
			margin-top: 0px;
			margin-right: 0px;
			margin-bottom: 0px;
		}
		.contain {
			width: 100%; 
			height: 100%;
		}
 -->
		</style>
	</head>

<%!
	Text messages; 
	SystemAccess sys;
	String attribute; 
	String value;
	UserSessionData userSessionData; 
%>
<%
	sys=(SystemAccess)session.getAttribute("SystemAccess");
	int corporationId = sys.getCorporationId();
	userSessionData=sys.getUserSessionData();
	DriverData driver = userSessionData.getDriverData();
	String check = Util.checkPermission(sys,SecurityConstants.JJ_REPORTER);
	if(check!=null) {
		response.sendRedirect(request.getContextPath()+check);
	}else {
		session.setAttribute("url","reporterjj/new.jsp");
		messages=sys.getText();
		
		DataTypeReportFacade dtReportFacade = sys.getDataTypeReportFacade();			
		Iterator iter = dtReportFacade.findAll(DataTypeConstants.SEX, sys.getUserSessionData()).iterator();
		Collection sexs = new LinkedList();
		while(iter.hasNext()) {
			String value = ((SexDataType)iter.next()).getResourceBundleId();
			sexs.add(new OptionItem(messages.getText(value),value));
		}
		request.setAttribute("sexs",sexs);
%>		
	<body>
	 	<table width="100%" height="90" border="0" cellpadding="0" cellspacing="0" class="default">
		 	<form name="logout" action="login.jsp" method="post">
	 		</form>
		 	<form name="cancel" action="reporter.jsp" method="post">
	 		</form>
  			<tr>
    			<td colspan="2">
					<table width="100%" border="0" cellspacing="0" cellpadding="0" valign="top">
      					<tr>
        					<td><jsp:include  page='<%="../topMenu.jsp?home=true&reporter=true" %>'/></td>
      					</tr>
    				</table>	
    			</td><!--end the top�s table -->
  			</tr>
  		</table>
  		<br>
  		<br>	
		<table width="600" border="0" align="center" cellpadding="0" cellspacing="0">
			<tr class="guide1"> 
		    	<jsp:include  page='<%="../component/titlecomponent.jsp?title="+messages.getText("reporerjj.step1")%>' />
			</tr>
		  	<tr> 
	  			<jsp:include  page="../component/spaceline.jsp" />
		  	</tr>
			<tr> 
	  			<td colspan="3"> 
		    		<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("reporerjj.identifydriver")%>' /> 
					<html:form action="/ReportJJDriverCreate">
						<table width="100%" border="0" align='center' cellpadding="0" cellspacing="0">
	   						<tr  class="linetwo">
	       						<th align="left"> <%=messages.getText("generic.driver.driverdata.firstname")%></th>
	        					<td align="right"><html:text property="firstName" size="50" styleClass="input"/></td>
	     					</tr>
	   						<tr class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
	   						<tr class="linetwo">
	       						<th align="left"><%=messages.getText("generic.driver.driverdata.lastname")%></th>
			        			<td align="right"><html:text property="lastName" size="50" styleClass="input"/></td>
	   						</tr>
	   						<tr class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
	   						<tr class="linetwo">
        						<th align="left"> <%=messages.getText("generic.driver.driverdata.birthdate")%><span class="required">*</span></th>
	       						<td align="right" class="linetwo">
	       							<jsp:include  page='<%="../component/dateComponent.jsp?index=1&day=birthDate&month=birthMonth&year=birthYear&form=DriverCreateForm" %>' />
			          			</td>
							</tr>
	   						<tr class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
							<tr  class="linetwo">
		        				<th align="left" > <%=messages.getText("generic.driver.driverdata.sex")%><span class="required">*</span></th>
		       					<td align="right">
			      					<html:select property="sex" styleClass="input" style="width:120;" >
										<html:options collection="sexs" property="value" labelProperty="label"/>
				  					</html:select>   
								</td>
		    				</tr>
	   						<tr class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
	   						<tr class="linetwo">
	       						<th align="left"><%=messages.getText("generic.driver.driverdata.email")%></th>
			        			<td align="right"><html:text property="email" size="50" styleClass="input"/></td>
	   						</tr>
	   						<tr class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
							<tr class="linetwo">
		        				<th align="left" > <%=messages.getText("generic.driver.driverdata.corporationid")%></th>
		        				<td align="right"><html:text property="corporationId" size="50" styleClass="input"/></td>
		      				</tr>
	   						<tr class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
			  				<tr>
	  						  	<td height="18" colspan="3" valign="top">
	          						<div align="right">
										<html:submit styleClass="input" value='<%=messages.getText("generic.messages.save")%>' />
										<html:cancel styleClass="input" value='<%=messages.getText("generic.messages.save")%>' />
							  		</div>          
							  	</td>
				  			</tr>
						</table>			
					</html:form>			
	    			<jsp:include page="../component/utilityboxbottom.jsp"/>
		      	</td>	
		  	</tr>
		  	<tr> 
		    	<jsp:include  page="../component/spaceline.jsp" />
		  	</tr>
		</table>		
	</body>
<%	}
%>		
</html>
