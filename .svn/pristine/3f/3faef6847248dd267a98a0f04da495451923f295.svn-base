<%@ page language="java"
    errorPage="exception.jsp"
	import="presentation.translator.web.user.*"	
	import="presentation.translator.web.util.*"	
	import="java.net.*"
	import="communication.security.*"
	import="java.io.File"
	import="java.io.FileReader"
	import="java.io.IOException"
	import="java.io.BufferedReader"
	
%>

<%@ taglib uri="/WEB-INF/struts-html.tld"
        prefix="html"
%>


<%@page import="communication.util.MD5"%><html:html>
<%! RequestDispatcher dispatcher; String context; String pathMsg; String pathGarbagecolector;
	String userName; String password; String sessionExpired;
%>

<%	userName="";
	password = "";
	sessionExpired="";
	context=request.getContextPath();
	pathMsg="/util/jsp/message.jsp";
	pathGarbagecolector="/util/jsp/garbagecolector.jsp";
	
	dispatcher=request.getRequestDispatcher(pathMsg);
	dispatcher.include(request,response);
	
	dispatcher=request.getRequestDispatcher(pathGarbagecolector);
	dispatcher.include(request,response);
	if(!Util.empty(request.getParameter("session"))) {
		sessionExpired=request.getParameter("session");
	}
    if(!Util.empty(request.getParameter("user"))) {
	    userName = request.getParameter("user");
		if(!Util.empty(request.getParameter("password"))) {
		    password = request.getParameter("password");
		}
	}else if(!Util.empty(request.getParameter("reporter"))) {
		MD5 md5 = new MD5();
		userName = (request.getParameter("reporter").equals("cc_argentina") || request.getParameter("reporter").equals("cond_comentada_la")) ? "fd0f2f9703d45c16b2ec17cbc61bad63" : request.getParameter("reporter");
	    password = md5.encriptar(userName);
	}else if(!Util.empty(request.getParameter("login"))) {
		MD5 md5 = new MD5();
		userName = md5.encriptar(request.getParameter("login"));
	    password = md5.encriptar(userName);
	}else if(!Util.empty(request.getParameter("recomendation"))) {
		MD5 md5 = new MD5();
		userName = md5.encriptar("recomendation");
	    password = md5.encriptar(userName);
	}
	
%>

	<head>
		<title> CEPA </title>

		<script>
      		function funcaoBotaoEnter(parametro){
        		javascript:document.forms[0].submit();      
      		}
      		function sub(language){
	      		document.forms[0].j_username.style.display = 'none';
	      		document.forms[0].j_password.style.display = 'none';
	      		document.forms[0].username2.style.display = 'block';
	      		document.forms[0].password2.style.display = 'block';
	      		document.forms[0].j_username.value = 'resetpassword';
	      		document.forms[0].j_password.value = 'resetPassword';	
	      		//document.forms[0].language.value = language; 
				// Prueba:
	      		//alert (document.forms[0].language.value);     		
        		javascript:document.forms[0].submit();      
      		}
      		function enter(user,password){
	      		document.forms[0].j_username.value = user;
	      		document.forms[0].j_password.value = password;
        		javascript:document.forms[0].submit();      
      		}
		</script>
		<script>
			if (parent.frames.length)
				parent.location.href= self.location;
		</script>
		
		<link href='<%=context+"/util/css/estilo.css"%>' rel="stylesheet" type="text/css">
		<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"><style type="text/css">
		
		<!--
		body {
			background-color: #DDDDDD;
		}
		-->
		</style>
	</head>

	<body <%=(!Util.empty(userName) && !Util.empty(password)) ? "onload=enter('"+userName+"','"+password+"')" : "" %>>
		<form name="loginForm" method="post" action="j_security_check" onSubmit="return enc()" onKeyPress="">
			<table width="709" height="386" border="0" align="center" cellpadding="0" cellspacing="0"  class="tablelogin2">
			  	<tr>
    				<td height="100" colspan="3">&nbsp;</td>
	  			</tr>
<%		if(Util.empty(userName) && Util.empty(password)) {
%>	
  				<tr>
    				<td width="352"height="24" align="right" class="txtlogin">Login</td>
    				<td width="5"></td>
    				<td width="352">
    					<input type="text" name="j_username" size="20" class="input" onKeyPress="if ((window.event ? event.keyCode : event.which) == 13) { funcaoBotaoEnter(this.value); }"/>
    					<input type="text" name="username2" size="20" class="input" style="display:none;"/>
    				</td>
  				</tr>
  				<tr>
    				<td width="352" height="24" align="right" class="txtlogin">Password</td>
    				<td></td>
    				<td width="352">
    					<input type="password" name="j_password" size="20" class="input" onKeyPress="if ((window.event ? event.keyCode : event.which) == 13) { funcaoBotaoEnter(this.value); }"/>
    					<input type="password" name="password2" size="20" class="input" style="display:none;">
    				</td>
  				</tr>
   				<tr>
    				<td height="5" colspan="3"><img src="x" width="1" height="1"></td>
  				</tr>
   				<tr>
    				<td height="19" colspan="3" align="center" class="cursor">
    					<a href="#" onclick="javascript:document.forms[0].submit()">
    						<html:img src='<%=context+"/util/imgs/botlogin.gif"%>' height="22" width="62" border='0' />
    					</a> 
    				</td>
  				</tr>
  				<tr>
    				<td height="28" colspan="3" align="center" class="cursor"></td>
  				</tr>
  				<tr>
    				<td height="25" colspan="3" align="center" class="msglogin">
    					<input type="hidden" name="language" value="es" id="language" />
    					<div align="center">
    					<table width="82%" border="0">
    						<tr>
    							<td  width="1%"></td>
    							<td valign="top" align="left" class="msglogin" width="32%">
    						Si usted olvidó su contraseña o desea activarla usando la herramenta de Primer Acceso, <a href="javascript:sub('es')" ><strong><u>cliquee aqui</u></strong></a><u>.</u>
    							</td>
    							<td  width="2%"></td>
    							<td valign="top" align="left" class="msglogin" width="32%">
    						Se voce esqueceu sua password ou deseja ativa-la usando a ferramenta de Primeiro Acesso, <a href="javascript:sub('pt')" ><strong><u>clique aqui</u></strong></a><u>.</u>
    							</td>
    							<td  width="2%"></td>
    							<td valign="top" align="left" class="msglogin" width="31%">
    						If you forgot your password or have received instructions to activate your password using First Access Tool <a href="javascript:sub('en')" ><strong><u>click here</u></strong></a><u>.</u>
    							</td>
    						</tr>
    					</table>
          				</div>
          			</td>
  				</tr>
  				
  		<%	
  			if (sessionExpired.equals("1")){
		%>			
				<tr>
					<td height="35" colspan="3" align="center" class="msglogin">
    					<div align="center">
    						<table width="75%">
    							<tr><td colspan="3" height="5"></td></tr>
    							<tr>
  									<td colspan="3" align="center" class="msglogin"><FONT COLOR="blue"><strong>Esta Sessão Foi Encerrada. Se Deseja Reingressar ao Sistema, Por Favor Ingresse Novamente Seu Nome de Usuário e Senha.</strong></FONT></td>
  								</tr>
  								<tr>
  									<td colspan="3" align="center" class="msglogin"><FONT COLOR="blue"><strong>Your Session has Expired. Please Input Your Username and Password Again if you Would Like to Enter the System.</strong></FONT></td>
  								</tr>	
  							</table>
  						</div>
  					</td>
  				</tr>
 <% 	
 			} 
 %> 
 <%
 			// Mensajes de Mantenimiento:
 			try{
 				File file = new File(SecurityConstants.DATACENTER5_WAR_DIRECTORY+"mantenimiento.txt");
 				FileReader input = new FileReader(file); 				
 		        BufferedReader br = new BufferedReader(input);
 				
 				String line;   // String that holds current file line
 				// Read first line
 				line = br.readLine();
 				if (line != null){
 			    	%>
 			    
 			    <tr>
					<td height="35" colspan="3" align="center" class="msglogin">
					<div align="center">
						<table width="75%">
							<tr>
								<td colspan="3" height="5"></td>
							</tr>
							<tr>
								<td colspan="3" align="center" class="msglogin">
									<FONT COLOR="red"><strong>
					<%
					// dis.available() returns 0 if the file does not have more lines.
	 			    while (line != null) {

	 			      // this statement reads the line from the file and print it 			        
	 			    %> 
	 			        <%=line%>
	 			    <%
	 			   		line = br.readLine();
	 			    }
					%>			
									</strong></FONT>
								</td>
							</tr>
						</table>
  					</div>
  					</td>
  				</tr>
 			    
 			    	<%
 			    }
		      	// dispose all the resources after using them.		      	
 				br.close();	      	
 			      		
 			}catch(Exception e){
 				System.out.println("No hay archivo de mantenimiento");
 			}          
 			 
 %>
 
 
 				
<%		}else {
%>
  				<tr>
    				<td width="352"height="24" align="right" class="txtlogin">Loading DataCenter5</td>
    				<td width="5">
		    			<input type="hidden" name="j_username"/>
		  				<input type="hidden" name="j_password"/>
    				</td>
    				<td width="352">&nbsp;</td>
  				</tr>
  				<tr>
    				<td height="25" colspan="3" align="center" class="msglogin">
    				</td>
    			</tr>
<%		}
%>  				
  				<tr>
    				<td height="13" colspan="3"></td>
  				</tr>
  				<tr>
    				<td colspan="3">

   					</td>
  				</tr>
			</table>



    	<%
    		// IP dc5.cepasafedrive.com:
    		// IP cepadc.com: 
			InetAddress inetAddress = InetAddress.getLocalHost();
			String ip = inetAddress.getHostAddress();
			// System.out.println("Server IP: "+ip);
			String host_name = "dc5.cepasafedrive.com";
			if (ip.equalsIgnoreCase(SecurityConstants.CEPADC_PRODUCTION_IP)){
				host_name="cepadc.com";
			}
			
		%>

 			<!--  Nuevo Certificado -->
	    	<table width="80" align="center" border="0" cellpadding="2" cellspacing="0" title="Click to Verify - This site chose Thawte SSL for secure e-commerce and confidential communications.">
				<tr>
					<td width="80" align="center" valign="top">
						<script type="text/javascript" src="https://seal.thawte.com/getthawteseal?host_name=<%=host_name%>&amp;size=L&amp;lang=en">
						</script>
					</td>
				</tr>
				<tr>
					<td  align="center" valign="top">
						<a href="https://www.thawte.com/digital-certificates/" target="_blank" style="color:#000000; text-decoration:none; font:bold 10px arial,sans-serif; text-align:center; margin:0px; padding:0px;">ABOUT SSL CERTIFICATES</a>
					</td>
				<td width="155">&nbsp;</td>
				</tr>
			</table>   	
    		<!--  Fin Nuevo Certificado -->

</form>
	</body>
</html:html>


