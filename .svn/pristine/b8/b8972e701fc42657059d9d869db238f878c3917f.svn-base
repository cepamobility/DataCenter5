%>						
									<a href="<%=link%>" class="texts">
										<%=messages.getText("generic.messages.delete")%>
									</a>	
								</td>
					<%=(line) ? "</tr>" : "" %>							
<%				
				}
				if(sys.getUserSessionData().isDriver() && sys.getCorporationId() != CorporationData.BAYER) {
