								</td>
					<%=(line) ? "</tr>" : "" %>							
<%				}
				if(sys.getUserSessionData().checkPermission(SecurityConstants.SUPERVISE_EVENT) && (fineData.getStatus().intValue() != EventDataType.SUPERVISED)) {	
					line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
