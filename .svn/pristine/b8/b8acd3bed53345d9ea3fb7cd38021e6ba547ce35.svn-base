<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.vehicle.tables">
    <class name="CheckListTransporterLink" table="checklisttransporterlinks">

        <id	column="id"	name="id" type="java.lang.Integer">
            <generator class="assigned">
            </generator>
        </id>


        <property name="corporation" type="java.lang.Integer" column="corporation" />
        <property name="fosa" type="java.lang.Integer" column="fosa" />
        <property name="mdp" type="java.lang.Integer" column="mdp" />
        
    </class>
</hibernate-mapping>
