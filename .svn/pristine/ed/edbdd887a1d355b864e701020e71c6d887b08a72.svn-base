    private int getValue(int[] values) {
        switch(getDivOrgLevel(values[0]-1)) {
            case 1:
                return (values[0]-1)*3+3;
            case 2:
                if(values[1] == 1) {
                    return (values[0]-1)*3+2;
                }else {
                    return (values[0]-1)*3+3;
                }
            case 3:
                return (values[0]-1)*3+values[1];
        }
        return 0;
    }

    public Collection getCorporationGroupLines() {
        return corporationGroupLines;
    }

    public void setCorporationGroupLines(Collection corporationGroupLines) {
        this.corporationGroupLines = corporationGroupLines;
    }

    /**
     * Devuelve true si la empresa logueada es una forestal
     * @return
     */
    public boolean isForest() {

        return (corporationId.intValue() == CorporationData.FORESTALORIENTAL) ||
        		(corporationId.intValue() == CorporationData.ENCE) ||
        		(corporationId.intValue() == CorporationData.COLONVADE ||
        		(corporationId.intValue() == CorporationData.LOSPIQUES) ||
                (corporationId.intValue() == CorporationData.KLABIN) ||
                (corporationId.intValue() == CorporationData.DEMO_FORESTAL) ||
                (corporationId.intValue() == CorporationData.CEPA_PESADOS) ||
                (corporationId.intValue() == CorporationData.CIMSA) ||
                (corporationId.intValue() == CorporationData.TRANSPORTES_AMERICAN) ||
                (corporationId.intValue() == CorporationData.ANGLO) ||
                (corporationId.intValue() == CorporationData.YOLI) ||
                (corporationId.intValue() == CorporationData.MONTES_DE_PLATA) ||
                (corporationId.intValue() == CorporationData.FORESTALES)
                ) ;
        //return corporationId.intValue() == CorporationData.DEMO;
        //return false;
    }

    /**
     * Devuelve la cantidad de Principal DivOrgs que se muestran.
     * @return
     */
    public int getPrincipalCount(){
    	int count = 0;
    	if (principalDivOrgs[0][0] != 0 && principalDivOrgs[0][1] != 0){
    		count ++;
        	if (principalDivOrgs[1][0] != 0 && principalDivOrgs[1][1] != 0){
        		count ++;
            	if (principalDivOrgs[2][0] != 0 && principalDivOrgs[2][1] != 0){
            		count ++;
                	if (principalDivOrgs[3][0] != 0 && principalDivOrgs[3][1] != 0){
                		count ++;
                	}
            	}
        	}
    	}
    	return count;
    }

    public LabelItemData getLabelItemData(int divOrg,Integer id) {
        Iterator it = corporationGroupLines.iterator();
        while(it.hasNext()) {
            GroupLineData line = (GroupLineData) it.next();
            LabelItemData lid = line.getDivOrgs()[divOrg];
            switch(getDivOrgLevel(divOrg)) {
                case 1:
                    ItemData item = new ItemData(id);
                    Collection items = new LinkedList();
                    items.add(item);
                    return new LabelItemData(lid.getId(),lid.getName(),items,lid.getShowLevel());
                case 2:
                    item = (ItemData)((ItemData)lid.getItemIterator().next()).getSubItems().getItemIterator().next();
                    if(item.getId().intValue() == id.intValue()) {
                        return lid;
                    }
                    break;
                case 3:
                    item = (ItemData)((ItemData)((ItemData)lid.getItemIterator().next()).getSubItems().getItemIterator().next()).getSubItems().getItemIterator().next();
                    if(item.getId().intValue() == id.intValue()) {
                        return lid;
                    }
                    break;
            }
        }
        return null;
    }

    public String getRoot(int divOrg,Integer id) {
        Iterator it = groupLines.iterator();
        while(it.hasNext()) {
            GroupLineData line = (GroupLineData) it.next();
            LabelItemData lid = line.getDivOrgs()[divOrg];
            ItemData item1 = (ItemData)lid.getItemIterator().next();
            if(item1.getId().equals(id)) {
                return item1.getName();
            }else {
                if(item1.getSubItems() != null) {
                    ItemData item2 = (ItemData)item1.getSubItems().getItemIterator().next();
                    if(item2.getId().equals(id)) {
                        return item1.getName()+"/"+item2.getName();
                    }else {
                        if(item2.getSubItems() != null) {
                            ItemData item3 = (ItemData)item2.getSubItems().getItemIterator().next();
                            if(item3.getId().equals(id)) {
                                return item1.getName()+"/"+item2.getName()+"/"+item3.getName();
                            }
                        }
                    }
                }
            }
        }
        return null;
    }

    public String getCountry(Integer id, Text messages) {
        Iterator it = groupLines.iterator();
        while(it.hasNext()) {
            GroupLineData line = (GroupLineData) it.next();
            GeoLabelData lid = line.getCountry();
            GeoItemData item1 = (GeoItemData)lid.getItemIterator().next();
            if(item1.getId().equals(id)) {
                return messages.getText(item1.getName());
            }else {
                if(item1.getSubItems() != null) {
                	GeoItemData item2 = (GeoItemData)item1.getSubItems().getItemIterator().next();
                    if(item2.getId().equals(id)) {
                        return item1.getName()+"/"+messages.getText(item2.getName());
                    }else {
                        if(item2.getSubItems() != null) {
                        	GeoItemData item3 = (GeoItemData)item2.getSubItems().getItemIterator().next();
                            if(item3.getId().equals(id)) {
                                return item1.getName()+"/"+item2.getName()+"/"+messages.getText(item3.getName());
                            }
                        }
                    }
                }
            }
        }
        return null;
    }

    public Integer getCorporationType() {
		return corporationType;
	}

	public void setCorporationType(Integer corporationType) {
