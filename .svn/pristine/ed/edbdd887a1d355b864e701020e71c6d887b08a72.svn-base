    public String[] getLastLevelLabels() {
        String[] labels = new String[divOrgLabels.length];
        for(int i = 0; i < divOrgLabels.length; i++) {
            if(divOrgLabels[0].length > 3) {
                labels[i] = divOrgLabels[0][2].getName();
            }else if(divOrgLabels[0].length > 2) {
                labels[i] = divOrgLabels[0][1].getName();
            }else {
                labels[i] = divOrgLabels[0][0].getName();
            }
        }
        return labels;
    }

    public String[] getLevelLabels() {
        // String[] st = new String[3];
    	String[] st = new String[getDivOrgCount()];
        // for(int i = 0; i < 3; i++) {
        for (int i = 0; i < getDivOrgCount(); i++){
            if(divOrgs[i] != null) {
                st[i] = divOrgs[i].getName();
            }
        }
        return st;
    }

    public String[] getLevelNames(Text messages) {
    	String[] st = new String[getPrincipalCount()+1];
        String[] labels = getDivOrgLabels();
        for(int i = 0; i < getPrincipalCount(); i++) {
            st[i] = labels[(principalDivOrgs[i][0]-1)*3+principalDivOrgs[i][1]-1];
        }
        st[getPrincipalCount()]="corporation.country";
        return st;
    }



    public String[] getDivOrgLabels() {
        String[] labels = new String[9];
        for(int i = 0; i < divOrgLabels.length; i++) {
            for(int j = 0; j < divOrgLabels[i].length; j++) {
                if(divOrgLabels[i][j] != null) {
                    labels[i*3+j] = divOrgLabels[i][j].getName();
                }
            }
        }
        return labels;
    }

    public int getDivOrgCount(){
        return divOrgCount;
    }

    public void setDivOrgCount(int divOrgCount) {
