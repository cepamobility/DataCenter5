                                    ids.add(item.getId());
                                    leaves += ","+String.valueOf(item.getId());
                                }
                            }else {
                                if(level1 != null) {
                                    item = (GeoItemData)item.getSubItems().getItemIterator().next();
                                    if(item.getId().equals(level2)) {
                                        if(!ids.contains(item.getId()) && (parameters.size() == 0 || parameters.contains(item.getId()))) {
                                            ids.add(item.getId());
                                            leaves += ","+String.valueOf(item.getId());
                                        }
                                    }
                                }
                            }
                        }
                    }else {
                        if(item.getSubItems() == null) {
                            if(!ids.contains(item.getId()) && (parameters.size() == 0 || parameters.contains(item.getId()))) {
                                ids.add(item.getId());
                                leaves += ","+String.valueOf(item.getId());
                            }
                        }else {
                            if(level1 != null) {
                                item = (GeoItemData)item.getSubItems().getItemIterator().next();
                                if(item.getId().equals(level2)) {
                                    if(!ids.contains(item.getId()) && (parameters.size() == 0 || parameters.contains(item.getId()))) {
                                        ids.add(item.getId());
                                        leaves += ","+String.valueOf(item.getId());
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        return leaves;
    }

