    public int getDivOrgLevel(int i) {
        if(i >= 0 && i < divOrgLabels.length)
            return divOrgLabels[i].length;
        return -1;
    }

    public String[] getDivOrgLeaves() {
        String[] leaves = {"0","0","0"};
        Iterator it = groupLines.iterator();
        Collection[] ids = {new LinkedList(),new LinkedList(),new LinkedList()};
        while(it.hasNext()) {
            GroupLineData line = (GroupLineData) it.next();
            LabelItemData[] lids = line.getDivOrgs();
            for(int i = 0; i < lids.length; i++) {
                LabelItemData lid = lids[i];
                if(lid != null) {
                    ItemData item = (ItemData)lid.getItemIterator().next();
                    if(item.getSubItems() == null) {
                        if(!ids[i].contains(item.getId())) {
                            ids[i].add(item.getId());
                            leaves[i] += ","+String.valueOf(item.getId());
                        }
                    }else {
                        item = (ItemData)item.getSubItems().getItemIterator().next();
                        if(item.getSubItems() == null) {
                            if(!ids[i].contains(item.getId())) {
                                ids[i].add(item.getId());
                                leaves[i] += ","+String.valueOf(item.getId());
                            }
                        }else {
                            item = (ItemData)item.getSubItems().getItemIterator().next();
                            if(!ids[i].contains(item.getId())) {
                                ids[i].add(item.getId());
                                leaves[i] += ","+String.valueOf(item.getId());
                            }
                        }
                    }
                }
            }
        }
        return leaves;
    }

    public String[] getDivOrgLeaves(HashSet<Integer>[] parameters) {
        String[] leaves = {"0","0","0"};
        Iterator it = groupLines.iterator();
        Collection[] ids = {new LinkedList(),new LinkedList(),new LinkedList()};
        while(it.hasNext()) {
            GroupLineData line = (GroupLineData) it.next();
            LabelItemData[] lids = line.getDivOrgs();
            for(int i = 0; i < lids.length; i++) {
                LabelItemData lid = lids[i];
                if(lid != null) {
                    ItemData item = (ItemData)lid.getItemIterator().next();
                    if(item.getSubItems() == null) {
                        if(!ids[i].contains(item.getId()) && (parameters[i].size() == 0 || parameters[i].contains(item.getId()))) {
                            ids[i].add(item.getId());
                            leaves[i] += ","+String.valueOf(item.getId());
                        }
                    }else {
                        item = (ItemData)item.getSubItems().getItemIterator().next();
                        if(item.getSubItems() == null) {
                            if(!ids[i].contains(item.getId()) && (parameters[i].size() == 0 || parameters[i].contains(item.getId()))) {
                                ids[i].add(item.getId());
                                leaves[i] += ","+String.valueOf(item.getId());
                            }
                        }else {
                            item = (ItemData)item.getSubItems().getItemIterator().next();
                            if(!ids[i].contains(item.getId()) && (parameters[i].size() == 0 || parameters[i].contains(item.getId()))) {
                                ids[i].add(item.getId());
                                leaves[i] += ","+String.valueOf(item.getId());
                            }
                        }
                    }
                }
            }
        }
        return leaves;
    }

