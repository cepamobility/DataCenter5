public class Filter implements Serializable {

    private static final long serialVersionUID = 1L;

    public static final int USER = 1;
    public static final int CORPORATION = 2;

    private String loginName;
    private String firstName;
    private String lastName;
    private String encriptPassword;



	private Integer corporationId;
	private String corporationName;
    private int divOrgCount;
    DivOrgAttribute[] divOrgs;
    LabelItemAttribute[][] divOrgLabels;
    GeoLabelAttributes[] divGeoLabels;

    private Collection groupLines;
    private int[][] principalDivOrgs;
    private Collection corporationGroupLines;

    private Integer corporationType;

    public Filter(String loginName,Integer corporationId, Integer corporationType) {
        this.corporationId=corporationId;
        this.loginName=loginName;
        this.corporationType = corporationType;
    }

	public Filter(String loginName,Integer corporationId,int divOrgCount,
			DivOrgAttribute[] divOrgs,LabelItemAttribute[][] divOrgLabels,
			GeoLabelAttributes[] divGeoLabels,Collection groupLines,
			String firstName,String lastName) {
	    this.corporationId=corporationId;
		this.loginName=loginName;
		this.firstName=firstName;
	    this.lastName=lastName;
        this.divOrgCount = divOrgCount;
        this.divOrgs = divOrgs;
        this.divOrgLabels = divOrgLabels;
        principalDivOrgs = new int[4][2];
        for(int i = 0; i < divOrgLabels.length; i++) {
            LabelItemAttribute[] lids = divOrgLabels[i];
            for(int j = 0; j < lids.length; j++) {
                if(lids[j] != null) {
                    if(lids[j].getShowLevel().intValue() > 0) {
                        principalDivOrgs[lids[j].getShowLevel().intValue()-1][0] = i+1;
                        principalDivOrgs[lids[j].getShowLevel().intValue()-1][1] = j+1;
                    }
                }
            }
        }
        this.divGeoLabels = divGeoLabels;
        this.groupLines = groupLines;
	}

