    }

    public Collection getGroupLines() {
        return groupLines;
    }

    public ItemData getDivOrgItem(int divOrg, int level, Integer id) {
        return getDivOrgItem(divOrg,level,id,USER);
    }

    public ItemData getDivOrgItem(int divOrg, int level, Integer id, int data) {
        Iterator it = (data == USER) ? groupLines.iterator() : corporationGroupLines.iterator();
        while(it.hasNext()) {
            GroupLineData line = (GroupLineData) it.next();
            LabelItemData lid = line.getDivOrgs()[divOrg];
            for(int i = 0; i < level-1; i++) {
                lid = ((ItemData)lid.getItemIterator().next()).getSubItems();
            }
            Iterator it2 = lid.getItemIterator();
            while(it2.hasNext()) {
                ItemData item = (ItemData)it2.next();
                if(item.getId().equals(id)) {
                    return item;
                }
            }
        }
        return null;
    }

    public String[] getDivGeoLabels() {
        String[] labels = new String[3];
        for(int i = 0; i < divGeoLabels.length; i++) {
            labels[i] = divGeoLabels[i].getResourceKey();
        }
        return labels;
    }

    public GeoItemData getDivGeoItem(int level, Integer id) {
        return getDivGeoItem(level,id,USER);
    }

    public GeoItemData getDivGeoItem(int level, Integer id, int data) {
        Iterator it = (data == USER) ? groupLines.iterator() : corporationGroupLines.iterator();
        while(it.hasNext()) {
            GroupLineData line = (GroupLineData) it.next();
            GeoLabelData lid = line.getCountry();
            for(int i = 0; i < level-1; i++) {
                lid = ((GeoItemData)lid.getItemIterator().next()).getSubItems();
            }
            Iterator it2 = lid.getItemIterator();
            while(it2.hasNext()) {
                GeoItemData item = (GeoItemData)it2.next();
                if(item.getId().equals(id)) {
                    return item;
                }
            }
        }
        return null;
    }

    public GeoLabelData getDivGeoLabelData(int level,int data) {
        Iterator it = (data == USER) ? groupLines.iterator() : corporationGroupLines.iterator();
        while(it.hasNext()) {
            GroupLineData line = (GroupLineData) it.next();
            GeoLabelData lid = line.getCountry();
            for(int i = 0; i < level-1; i++) {
                lid = ((GeoItemData)lid.getItemIterator().next()).getSubItems();
            }
            return lid;
       }
        return null;
    }

    public int getGeoLevelCount() {
        return divGeoLabels.length;
