    public String getDivOrgLeaves(int index, Integer level1, Integer level2) {
        String leaves = "0";
        Iterator it = groupLines.iterator();
        while(it.hasNext()) {
            GroupLineData line = (GroupLineData) it.next();
            LabelItemData lid = line.getDivOrgs()[index];
            if(lid != null) {
                leaves += ",";
                ItemData item = (ItemData)lid.getItemIterator().next();
                if(item.getSubItems() == null) {
                    leaves += String.valueOf(item.getId());
                }else {
                    item = (ItemData)item.getSubItems().getItemIterator().next();
                    if(level1 != null) {
                        if(item.getId().equals(level1)) {
                            if(item.getSubItems() == null) {
                                leaves += String.valueOf(item.getId());
                            }else {
                                if(level1 != null) {
                                    item = (ItemData)item.getSubItems().getItemIterator().next();
                                    if(item.getId().equals(level2)) {
                                        leaves += String.valueOf(item.getId());
                                    }
                                }
                            }
                        }
                    }else {
                        if(item.getSubItems() == null) {
                            leaves += String.valueOf(item.getId());
                        }else {
                            if(level1 != null) {
                                item = (ItemData)item.getSubItems().getItemIterator().next();
                                if(item.getId().equals(level2)) {
                                    leaves += String.valueOf(item.getId());
                                }
                            }
                        }
                    }
                }
            }
        }
        return leaves;
    }

    public Iterator getLastLevelItems(int index, int divOrg, String level1, String level2) {
        return getLastLevelItems(index,divOrg,level1,level2,USER);
    }

    public Iterator getLastLevelItems(int index, int divOrg, String level1, String level2, int data) {
        Collection items = new LinkedList();
        Iterator it = (data == USER) ? groupLines.iterator() : corporationGroupLines.iterator();
        while(it.hasNext()) {
            GroupLineData groupLine = (GroupLineData)it.next();
            LabelItemData lid = groupLine.getDivOrgs()[divOrg];
            switch(index) {
                case 1:
                    Iterator it2 = lid.getItemIterator();
                    while(it2.hasNext()) {
                        items.add(it2.next());
                    }
                    break;
                case 2:
                    it2 = lid.getItemIterator();
                    while(it2.hasNext()) {
                        ItemData item = (ItemData)it2.next();
                        if(level1 == null) {
                            Iterator it3 = item.getSubItems().getItemIterator();
                            while(it3.hasNext()) {
                                items.add(it3.next());
                            }
                        }else {
                            if(Integer.parseInt(level1) == item.getId().intValue() && item.getSubItems() != null) {
                                Iterator it3 = item.getSubItems().getItemIterator();
                                while(it3.hasNext()) {
                                    items.add(it3.next());
                                }
                            }
                        }
                    }
                    break;
                case 3:
                    it2 = lid.getItemIterator();
                    while(it2.hasNext()) {
                        ItemData item = (ItemData)it2.next();
                        if(level1 == null) {
                            Iterator it3 = item.getSubItems().getItemIterator();
                            while(it3.hasNext()) {
                                item = (ItemData)it3.next();
                                if(level2 == null) {
                                    Iterator it4 = item.getSubItems().getItemIterator();
                                    while(it4.hasNext()) {
                                        items.add(it4.next());
                                    }
                                }else {
                                    if(Integer.parseInt(level2) == item.getId().intValue()) {
                                        Iterator it4 = item.getSubItems().getItemIterator();
                                        while(it4.hasNext()) {
                                            items.add(it4.next());
                                        }
                                    }
                                }
                            }
                        }else {
                            if(Integer.parseInt(level1) == item.getId().intValue()) {
                                Iterator it3 = item.getSubItems().getItemIterator();
                                while(it3.hasNext()) {
                                    item = (ItemData)it3.next();
                                    if(level2 == null) {
                                        Iterator it4 = item.getSubItems().getItemIterator();
                                        while(it4.hasNext()) {
                                            items.add(it4.next());
                                        }
                                    }else {
                                        if(Integer.parseInt(level2) == item.getId().intValue()) {
                                            Iterator it4 = item.getSubItems().getItemIterator();
                                            while(it4.hasNext()) {
                                                items.add(it4.next());
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    break;
            }
        }
        Collections.sort((List)items);
        return items.iterator();
    }

    /**Llama a getLastLevelItems y le elimina los repetidos **/
    public Iterator getLevelItems(int index, int divOrg, String level1, String level2, int data) {

        Iterator it = getLastLevelItems(index,divOrg,level1,level2,data);
        HashMap<Integer, ItemData> aux=new HashMap<Integer, ItemData>();
        while(it.hasNext()) {
            ItemData item=(ItemData)it.next();
            if(!aux.containsKey(item.getId())){
            	aux.put(item.getId(), item);
            }
        }
        Collection itemsAux=aux.values();
        List items=new ArrayList<ItemData>(itemsAux);
        Collections.sort(items);
        return items.iterator();
    }

    public Hashtable getCountryMap(int type,int index) {
        Hashtable items = new Hashtable();
        Iterator it = (type == USER) ? groupLines.iterator() : corporationGroupLines.iterator();
        while(it.hasNext()) {
            GroupLineData groupLine = (GroupLineData)it.next();
            GeoLabelData lid = groupLine.getCountry();
            switch(index) {
                case 2:
                    GeoItemData item1 = (GeoItemData)lid.getItemIterator().next();
                    GeoItemData item2 = (GeoItemData)item1.getSubItems().getItemIterator().next();
                    String[] st = {item2.getName(),String.valueOf(item2.getId())};
                    if(items.containsKey(item1.getId())) {
                        Collection countries = (Collection)items.get(item1.getId());
                        if(!contains(countries,st[1])) {
                            countries.add(st);
                        }
                    }else {
                        Collection countries = new LinkedList();
                        countries.add(st);
                        items.put(item1.getId(),countries);
                    }
                    break;
            }
        }
        return items;
    }

    private boolean contains(Collection elements,String element) {
        Iterator it = elements.iterator();
        while(it.hasNext()) {
            if(((String[])it.next())[1].equals(element)) {
                return true;
            }
        }
        return false;
    }

    public Iterator getLastLevelItems(int index, String level1, String level2) {
        return getLastLevelItems(index,level1,level2,USER);
    }

    public Iterator getLastLevelItems(int index, String level1, String level2,int data) {
        Collection items = new LinkedList();
        Collection ids = new LinkedList();
        Iterator it = (data == USER) ? groupLines.iterator() : corporationGroupLines.iterator();
        while(it.hasNext()) {
            GroupLineData groupLine = (GroupLineData)it.next();
            GeoLabelData lid = groupLine.getCountry();
            switch(index) {
                case 2:
                    Iterator it2 = lid.getItemIterator();
                    while(it2.hasNext()) {
                        GeoItemData item = (GeoItemData)it2.next();
                        if(level1 == null) {
                            Iterator it3 = item.getSubItems().getItemIterator();
                            while(it3.hasNext()) {
                                GeoItemData item2 = (GeoItemData)it3.next();
                                if(!ids.contains(item2.getId())) {
                                    ids.add(item2.getId());
                                    items.add(item2);
                                }
                            }
                        }else {
                            if(Integer.parseInt(level1) == item.getId().intValue()) {
                                Iterator it3 = item.getSubItems().getItemIterator();
                                while(it3.hasNext()) {
                                    GeoItemData item2 = (GeoItemData)it3.next();
                                    if(!ids.contains(item2.getId())) {
                                        ids.add(item2.getId());
                                        items.add(item2);
                                    }
                                }
                            }
                        }
                    }
                    break;
                case 3:
                    it2 = lid.getItemIterator();
                    while(it2.hasNext()) {
                        GeoItemData item = (GeoItemData)it2.next();
                        if(level1 == null) {
                            Iterator it3 = item.getSubItems().getItemIterator();
                            while(it3.hasNext()) {
                                item = (GeoItemData)it3.next();
                                Iterator it4 = item.getSubItems().getItemIterator();
                                while(it4.hasNext()) {
                                    items.add(it4.next());
                                }
                            }
                        }else {
                            if(Integer.parseInt(level1) == item.getId().intValue()) {
                                Iterator it3 = item.getSubItems().getItemIterator();
                                while(it3.hasNext()) {
                                    item = (GeoItemData)it3.next();
                                    if(level2 == null) {
                                        Iterator it4 = item.getSubItems().getItemIterator();
                                        while(it4.hasNext()) {
                                            items.add(it4.next());
                                        }
                                    }else {
                                        if(Integer.parseInt(level2) == item.getId().intValue()) {
                                            Iterator it4 = item.getSubItems().getItemIterator();
                                            while(it4.hasNext()) {
                                                items.add(it4.next());
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    break;
            }
        }
        Collections.sort((List)items);
        return items.iterator();
    }

    public GeoItemData getItem(Integer id) {
        Iterator it = groupLines.iterator();
        while(it.hasNext()) {
            GeoItemData item = (GeoItemData)((GroupLineData) it.next()).getCountry().getItemIterator().next();
            if(item.getId().equals(id)) {
                return item;
            }
        }
        return null;
    }

    public Iterator getCountries() {
        List<GeoItemData> countries = new LinkedList();
        Iterator it = groupLines.iterator();
        while(it.hasNext()) {
            GeoItemData item = (GeoItemData)((GroupLineData) it.next()).getCountry().getItemIterator().next();
            while(item.getSubItems() != null) {
                item = (GeoItemData)item.getSubItems().getItemIterator().next();
            }
            if(!countries.contains(item)) {
                countries.add(item);
            }
        }
        Collections.sort(countries);
        return countries.iterator();
    }

    public String getString(int index, int type) {
        String string = null;
        int[] data = principalDivOrgs[index];
        int divOrg = data[0];
        int level = data[1];

        if(divOrg > 0) {
            string = "divOrg"+divOrg;
            int length = getDivOrgLevel(divOrg-1);
            switch(length) {
                case 2:
                    if(level == 1) {
                        string += ".divOrgItemLevel2";
                    }
                    break;
                case 3:
                    if(level == 1) {
                        string += ".divOrgItemLevel2.divOrgItemLevel3";
                    }
                    if(level == 2) {
                        string += ".divOrgItemLevel2";
                    }
                    break;
            }
            if(type == 0) {
                string += ".id";
            }else {
                string += ".resourceKey";
            }
        }
        return string;
    }

    public String getReportFilter(int index, int type) {
    	if (index==3&&type==1){
    		return "corpCountry.pk.country.resourceKey";
    	}else if (index==3&&type==0){
    		return "corpCountry.pk.country.id";
    	}else if (index < 4){
    		return getString(index,type);
    	}else return null;
    }

    public String get2IndexString(int index, int type) {
        String string = null;
        int[] data = principalDivOrgs[index];
        int divOrg = data[0];
        int level = data[1];
        if(divOrg > 0) {
            string = "divOrg"+divOrg;
            int length = getDivOrgLevel(divOrg-1);
            switch(length) {
                case 1:
                    string += "1";
                    break;
                case 2:
                    if(level == 1) {
                        string += "2";
                    }else {
                        string += "1";
                    }
                    break;
                case 3:
                    if(level == 1) {
                        string += "3";
                    }else if(level == 2) {
                        string += "2";
                    }else {
                        string += "1";
                    }
                    break;
            }
            if(type == 0) {
                string += ".id";
            }else {
                string += ".resourceKey";
            }
        }
        return string;
    }

    public int[][] getPrincipalDivOrgs() {
        return principalDivOrgs;
    }

    public String[] getPrincipalLabels(){
        //String[] st = new String[3];
    	String [] st = new String[getPrincipalCount()];
        String[] labels = getDivOrgLabels();
        // for(int i = 0; i < 3; i++) {
        for (int i = 0; i < getPrincipalCount(); i ++)
        {
            st[i] = labels[(principalDivOrgs[i][0]-1)*3+principalDivOrgs[i][1]-1];
        }
        return st;
    }



    public String[] getAllElements(int type) {
        Collection sts = new LinkedList();
        sts.add(get2IndexString(0,type));
        sts.add(get2IndexString(1,type));
        sts.add(get2IndexString(2,type));
        for(int i = 0; i < getDivOrgCount(); i++) {
            for(int j = 0; j < getDivOrgLevel(i); j++) {
                String s = get2IndexElement(i+1,j+1,type);
                if(s != null) {
                    if(!sts.contains(s)) {
                        sts.add(s);
                    }
                }
            }
        }
        return (String[])sts.toArray(new String[0]);
    }

    private String get2IndexElement(int divOrg, int level, int type) {
        String string = null;
        if(divOrg > 0) {
            string = "divOrg"+divOrg;
            int length = getDivOrgLevel(divOrg-1);
            switch(length) {
                case 1:
                    switch(level) {
                        case 1:
                            string += "1";
                            break;
                        case 2:case 3:
                            return null;
                    }
                    break;
                case 2:
                    switch(level) {
                        case 1:
                            string += "2";
                            break;
                        case 2:
                            string += "1";
                            break;
                        case 3:
                            return null;
                    }
                    break;
                case 3:
                    switch(level) {
                        case 1:
                            string += "3";
                            break;
                        case 2:
                            string += "2";
                            break;
                        case 3:
                            string += "1";
                            break;
                    }
                    break;
            }
            if(type == 0) {
                string += ".id";
            }else {
                string += ".resourceKey";
            }
        }
        return string;
    }

    public int[][] getAllDivOrgs(){
        Collection sts = new LinkedList();
        sts.add(principalDivOrgs[0]);
        if (!(principalDivOrgs[1][0] == 0 && principalDivOrgs[1][1] == 0)){
        	sts.add(principalDivOrgs[1]);
        }
        if (!(principalDivOrgs[2][0] == 0 && principalDivOrgs[2][1] == 0)){
        	sts.add(principalDivOrgs[2]);
        }
        if (!(principalDivOrgs[3][0] == 0 && principalDivOrgs[3][1] == 0)){
        	sts.add(principalDivOrgs[3]);
        }

        for(int i = 0; i < getDivOrgCount(); i++) {
            for(int j = 0; j < getDivOrgLevel(i); j++) {
                if(!((principalDivOrgs[0][0] == i+1 && principalDivOrgs[0][1] == j+1)
                   || (principalDivOrgs[1][0] == i+1 && principalDivOrgs[1][1] == j+1)
                   || (principalDivOrgs[2][0] == i+1 && principalDivOrgs[2][1] == j+1)
                   || (principalDivOrgs[3][0] == i+1 && principalDivOrgs[3][1] == j+1))) {
                    int[] s = {i+1,j+1};
                    sts.add(s);
                }
            }
        }
        return (int[][])sts.toArray(new int[0][0]);
       }

    public String[] getOrderDivOrgLabels() {
        String[] labels = new String[9];
        int index = (corporationId.intValue() == CorporationData.MONSANTO) ? 4 : 3;
        for(int i = 0; i < divOrgLabels.length; i++) {
            for(int j = 0; j < divOrgLabels[i].length; j++) {
                if(divOrgLabels[i][j] != null) {
                    if(divOrgLabels[i][j].getShowLevel().intValue() == 0) {
                        labels[index] = divOrgLabels[i][j].getName();
                        index++;
                    }else {
                        labels[divOrgLabels[i][j].getShowLevel().intValue()-1] =
                        	divOrgLabels[i][j].getName();
                    }
                }
            }
        }
        return labels;
    }

    /**
     *
     * @param field
     * @return
     */
    public String[] getFields(String field) {
    	return getFields(field,-1);
    }

    /**
     *
     * @param field
     * @return
     */
    public String[] getFields(String field, int length) {
        String[] s = {"","","",""};
        int[][] index = getAllDivOrgs();
        int len = 0;
        if(length == -1) {
	        len = index.length;
	        if(corporationId.intValue() == CorporationData.MONSANTO) {
	        	len = 4;
	        }else if(corporationId.intValue() == CorporationData.NALCO
	        		|| corporationId.intValue() == CorporationData.ANGLO) {
	            len = 4;
	        }
        }else {
        	len = length;
        }
        for(int i = 0; i < len; i++) {
            int[] values = index[i];
            String value = String.valueOf(getValue(values));
            if(!value.equals("0")) {
                s[0] += ",d"+value+".resourcekey as div"+value;
                s[3] += (s[3].length() == 0) ? "div"+value : ",div"+value;
                switch(getDivOrgLevel(values[0]-1)) {
                    case 1:
                        s[1] += ",divorgitemlevel1s as d"+value;
                        break;
                    case 2:
                        if(values[1] == 1) {
                            s[1] += ",divorgitemlevel2s as d"+value;
                        }else {
                            s[1] += ",divorgitemlevel1s as d"+value;
                        }
                        break;
                    case 3:
                        switch(values[1]) {
                            case 1:
                                s[1] += ",divorgitemlevel3s as d"+value;
                                break;
                            case 2:
                                s[1] += ",divorgitemlevel2s as d"+value;
                                break;
                            case 3:
                                s[1] += ",divorgitemlevel1s as d"+value;
                                break;
                        }
                        break;
                }
                switch(Integer.parseInt(value)) {
                    case 1:
                        s[2] += " and "+field+".divorg1 = d3.id and d3.divorgitemlevel2 = d2.id and d2.divorgitemlevel3 = d1.id ";
                        break;
                    case 2:
                        s[2] += " and "+field+".divorg1 = d3.id and d3.divorgitemlevel2 = d2.id ";
                        break;
                    case 3:
                        s[2] += " and "+field+".divorg1 = d3.id ";
                        break;
                    case 4:
                        s[2] += " and "+field+".divorg2 = d6.id and d6.divorgitemlevel2 = d5.id and d5.divorgitemlevel3 = d4.id ";
                        break;
                    case 5:
                        s[2] += " and "+field+".divorg2 = d6.id and d6.divorgitemlevel2 = d5.id ";
                        break;
                    case 6:
                        s[2] += " and "+field+".divorg2 = d6.id ";
                        break;
                    case 7:
                        s[2] += " and "+field+".divorg3 = d9.id and d9.divorgitemlevel2 = d8.id and d8.divorgitemlevel3 = d7.id ";
                        break;
                    case 8:
                        s[2] += " and "+field+".divorg3 = d9.id and d9.divorgitemlevel2 = d8.id ";
                        break;
                    case 9:
                        s[2] += " and "+field+".divorg3 = d9.id ";
                        break;
                }
            }
        }
        return s;
    }

    /**
     *
     * @param field
     * @return
     */
    public String[] getPrincipalFields(String field, int length) {
        String[] s = {"","","",""};
        int[][] index = getAllDivOrgs();
        int len = 0;
        if(length == -1) {
	        len = index.length;
	        if(corporationId.intValue() == CorporationData.MONSANTO) {
	        	len = 4;
	        }else if(corporationId.intValue() == CorporationData.NALCO
	        		|| corporationId.intValue() == CorporationData.ANGLO) {
	            len = 4;
	        }
        }else {
        	len = length;
        }
        for(int i = 0; i < len; i++) {
            int[] values = index[i];
            String value = String.valueOf(getValue(values));
            if(!value.equals("0")) {
                s[0] += ",d"+value+".resourcekey as div"+value;
                s[3] += (s[3].length() == 0) ? "div"+value : ",div"+value;
                switch(getDivOrgLevel(values[0]-1)) {
                    case 1:
                        if(!s[1].contains("d"+value)) {
                        	s[1] += ",divorgitemlevel1s as d"+value;
                        }
                        break;
                    case 2:
                        if(values[1] == 1) {
                            if(!s[1].contains("d"+value)) {
	                            s[1] += ",divorgitemlevel2s as d"+value;
	                            if(!s[1].contains("d"+String.valueOf(Integer.parseInt(value)+1))) {
	                                s[1] += ",divorgitemlevel1s as d"+String.valueOf(Integer.parseInt(value)+1);
	                            }
                            }
                        }else {
                            if(!s[1].contains("d"+value)) {
                            	s[1] += ",divorgitemlevel1s as d"+value;
                            }
                        }
                        break;
                    case 3:
                        switch(values[1]) {
                            case 1:
                                if(!s[1].contains("d"+value)) {
	                                s[1] += ",divorgitemlevel3s as d"+value;
	                                if(!s[1].contains("d"+String.valueOf(Integer.parseInt(value)+1))) {
	                                    s[1] += ",divorgitemlevel2s as d"+String.valueOf(Integer.parseInt(value)+1);
	                                }
	                                if(!s[1].contains("d"+String.valueOf(Integer.parseInt(value)+2))) {
	                                    s[1] += ",divorgitemlevel1s as d"+String.valueOf(Integer.parseInt(value)+2);
	                                }
                                }
                                break;
                            case 2:
                                if(!s[1].contains("d"+value)) {
                                	s[1] += ",divorgitemlevel2s as d"+value;
	                                if(!s[1].contains("d"+String.valueOf(Integer.parseInt(value)+1))) {
	                                    s[1] += ",divorgitemlevel1s as d"+String.valueOf(Integer.parseInt(value)+1);
	                                }
                                }
                                break;
                            case 3:
                                if(!s[1].contains("d"+value)) {
                                	s[1] += ",divorgitemlevel1s as d"+value;
                                }
                                break;
                        }
                        break;
                }
                switch(Integer.parseInt(value)) {
                    case 1:
                        s[2] += " and "+field+".divorg1 = d3.id and d3.divorgitemlevel2 = d2.id and d2.divorgitemlevel3 = d1.id ";
                        break;
                    case 2:
                        s[2] += " and "+field+".divorg1 = d3.id and d3.divorgitemlevel2 = d2.id ";
                        break;
                    case 3:
                        s[2] += " and "+field+".divorg1 = d3.id ";
                        break;
                    case 4:
                        s[2] += " and "+field+".divorg2 = d6.id and d6.divorgitemlevel2 = d5.id and d5.divorgitemlevel3 = d4.id ";
                        break;
                    case 5:
                        s[2] += " and "+field+".divorg2 = d6.id and d6.divorgitemlevel2 = d5.id ";
                        break;
                    case 6:
                        s[2] += " and "+field+".divorg2 = d6.id ";
                        break;
                    case 7:
                        s[2] += " and "+field+".divorg3 = d9.id and d9.divorgitemlevel2 = d8.id and d8.divorgitemlevel3 = d7.id ";
                        break;
                    case 8:
                        s[2] += " and "+field+".divorg3 = d9.id and d9.divorgitemlevel2 = d8.id ";
                        break;
                    case 9:
                        s[2] += " and "+field+".divorg3 = d9.id ";
                        break;
                }
            }
        }
        return s;
    }

    /**
     *
     * @param field
     * @return
     */
    public String[] getFields(int[] index, String field) {
        String[] s = {"","","",""};
        boolean[] inserted = {false,false,false,false,false,false,false,false,false,false};
        for(int i = 0; i < index.length; i++) {
            int value = index[i];
            s[2] += "id"+value+",div"+value+",";
            switch(value) {
            	case 0:
                    s[0] += "d"+value+".id as id"+value+",d"+value+".resourcekey as div"+value+",";
                    s[1] += " JOIN country as d0 ON d0.id = "+field+".country";
                    s[3] += "d"+value+".id,d"+value+".resourcekey,";
                    inserted[0] = true;
                    break;
                case 1:
                    s[0] += "d3.id as id"+value+",d3.resourcekey as div"+value+",";
                	if(!inserted[3]) {
                		s[1] += " JOIN divorgitemlevel1s as d1 ON "+field+".divorg1 = d1.id";
                		inserted[3] = true;
                	}
                	if(!inserted[2]) {
                		s[1] += " JOIN divorgitemlevel2s as d2 ON d1.divorgitemlevel2 = d2.id ";
                		inserted[2] = true;
                	}
                	if(!inserted[1]) {
                		s[1] += " JOIN divorgitemlevel3s as d3 ON d2.divorgitemlevel3 = d3.id ";
                		inserted[1] = true;
                	}
                    s[3] += "d3.id,d3.resourcekey,";
                    break;
                case 2:
                    s[0] += "d2.id as id"+value+",d2.resourcekey as div"+value+",";
                	if(!inserted[3]) {
                		s[1] += " JOIN divorgitemlevel1s as d1 ON "+field+".divorg1 = d1.id";
                		inserted[3] = true;
                	}
                	if(!inserted[2]) {
                		s[1] += " JOIN divorgitemlevel2s as d2 ON d1.divorgitemlevel2 = d2.id ";
                		inserted[2] = true;
                	}
                    s[3] += "d2.id,d2.resourcekey,";
                    break;
                case 3:
                    s[0] += "d1.id as id"+value+",d1.resourcekey as div"+value+",";
                	if(!inserted[3]) {
                		s[1] += " JOIN divorgitemlevel1s as d1 ON "+field+".divorg1 = d1.id";
                		inserted[3] = true;
                	}
                    s[3] += "d1.id,d1.resourcekey,";
                    break;
                case 4:
                    s[0] += "d6.id as id"+value+",d6.resourcekey as div"+value+",";
                	if(!inserted[6]) {
                		s[1] += " JOIN divorgitemlevel1s as d4 ON "+field+".divorg2 = d4.id";
                		inserted[6] = true;
                	}
                	if(!inserted[5]) {
                		s[1] += " JOIN divorgitemlevel2s as d5 ON d4.divorgitemlevel2 = d5.id ";
                		inserted[5] = true;
                	}
                	if(!inserted[4]) {
                		s[1] += " JOIN divorgitemlevel3s as d6 ON d5.divorgitemlevel3 = d6.id ";
                		inserted[4] = true;
                	}
                    s[3] += "d6.id,d6.resourcekey,";
                    break;
                case 5:
                    s[0] += "d5.id as id"+value+",d5.resourcekey as div"+value+",";
                	if(!inserted[6]) {
                		s[1] += " JOIN divorgitemlevel1s as d4 ON "+field+".divorg2 = d4.id";
                		inserted[6] = true;
                	}
                	if(!inserted[5]) {
                		s[1] += " JOIN divorgitemlevel2s as d5 ON d4.divorgitemlevel2 = d5.id ";
                		inserted[5] = true;
                	}
                    s[3] += "d5.id,d5.resourcekey,";
                    break;
                case 6:
                    s[0] += "d4.id as id"+value+",d4.resourcekey as div"+value+",";
                	if(!inserted[6]) {
                		s[1] += " JOIN divorgitemlevel1s as d4 ON "+field+".divorg2 = d4.id";
                		inserted[6] = true;
                	}
                    s[3] += "d4.id,d4.resourcekey,";
                    break;
                case 7:
                    s[0] += "d9.id as id"+value+",d9.resourcekey as div"+value+",";
                	if(!inserted[9]) {
                		s[1] += " JOIN divorgitemlevel1s as d7 ON "+field+".divorg3 = d7.id";
                		inserted[9] = true;
                	}
                	if(!inserted[10]) {
                		s[1] += " JOIN divorgitemlevel2s as d8 ON d7.divorgitemlevel2 = d8.id ";
                		inserted[10] = true;
                	}
                	if(!inserted[11]) {
                		s[1] += " JOIN divorgitemlevel3s as d9 ON d8.divorgitemlevel3 = d9.id ";
                		inserted[11] = true;
                	}
                    s[3] += "d9.id,d9.resourcekey,";
                    break;
                case 8:
                    s[0] += "d8.id as id"+value+",d8.resourcekey as div"+value+",";
                	if(!inserted[9]) {
                		s[1] += " JOIN divorgitemlevel1s as d7 ON "+field+".divorg3 = d7.id";
                		inserted[9] = true;
                	}
                	if(!inserted[10]) {
                		s[1] += " JOIN divorgitemlevel2s as d8 ON d7.divorgitemlevel2 = d8.id ";
                		inserted[10] = true;
                	}
                    s[3] += "d8.id,d8.resourcekey,";
                    break;
                case 9:
                    s[0] += "d7.id as id"+value+",d7.resourcekey as div"+value+",";
                	if(!inserted[9]) {
                		s[1] += " JOIN divorgitemlevel1s as d7 ON "+field+".divorg3 = d7.id";
                		inserted[9] = true;
                	}
                    s[3] += "d7.id,d7.resourcekey,";
                    break;
            }
        }
        return s;
    }

    /**
