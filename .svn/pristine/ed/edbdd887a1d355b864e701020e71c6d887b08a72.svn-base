    public Collection<ItemData> getDivOrgLeaves(int divOrg) {
    	Collection<ItemData> values = new LinkedList<ItemData>();
    	Collection<Integer> ids = new LinkedList<Integer>();
        Iterator it = groupLines.iterator();
        while(it.hasNext()) {
            GroupLineData line = (GroupLineData) it.next();
            LabelItemData[] lids = line.getDivOrgs();
            LabelItemData lid = null;
            for(int i = 0; i < lids.length && i < divOrg ; i++) {
                lid = lids[i];
            }
            if(lid != null) {
                ItemData item = (ItemData)lid.getItemIterator().next();
                if(item.getSubItems() == null) {
                    if(!ids.contains(item.getId())) {
                        ids.add(item.getId());
                        values.add(item);
                    }
                }else {
                    item = (ItemData)item.getSubItems().getItemIterator().next();
                    if(item.getSubItems() == null) {
                        if(!ids.contains(item.getId())) {
                            ids.add(item.getId());
                            values.add(item);
                        }
                    }else {
                        item = (ItemData)item.getSubItems().getItemIterator().next();
                        if(!ids.contains(item.getId())) {
                            ids.add(item.getId());
                            values.add(item);
                        }
                    }
                }
            }
        }
        return values;
    }

    public Collection<Integer> getDivGeoLeavesCollection(Integer level1, Integer level2) {
        Collection<Integer> ids = new LinkedList<Integer>();
        Iterator it = groupLines.iterator();
        while(it.hasNext()) {
            GroupLineData line = (GroupLineData) it.next();
            GeoLabelData lid = line.getCountry();
            if(lid != null) {
                GeoItemData item = (GeoItemData)lid.getItemIterator().next();
                if(item.getSubItems() == null) {
                    if(!ids.contains(item.getId())) {
                        ids.add(item.getId());
                    }
                }else {
                    item = (GeoItemData)item.getSubItems().getItemIterator().next();
                    if(level1 != null) {
                        if(item.getId().equals(level1)) {
                            if(item.getSubItems() == null) {
                                if(!ids.contains(item.getId())) {
                                    ids.add(item.getId());
                                }
                            }else {
                                if(level1 != null) {
                                    item = (GeoItemData)item.getSubItems().getItemIterator().next();
                                    if(item.getId().equals(level2)) {
                                        if(!ids.contains(item.getId())) {
                                            ids.add(item.getId());
                                        }
                                    }
                                }
                            }
                        }
                    }else {
                        if(item.getSubItems() == null) {
                            if(!ids.contains(item.getId())) {
                                ids.add(item.getId());
                            }
                        }else {
                            if(level1 != null) {
                                item = (GeoItemData)item.getSubItems().getItemIterator().next();
                                if(item.getId().equals(level2)) {
                                    if(!ids.contains(item.getId())) {
                                        ids.add(item.getId());
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        return ids;
    }

