    public String[] getFields2(int[] index, String field) {
        String[] s = {"","","",""};
        boolean[] inserted = {false,false,false,false,false,false,false,false,false,false};
        for(int i = 0; i < index.length; i++) {
            int value = index[i];
            s[0] += ",d"+value+".id as id"+value+",d"+value+".resourcekey as div"+value;
            s[3] += "id"+value+",div"+value+",";
            switch(value) {
            	case 0:
                    s[1] += ",country as d"+value;
                    s[2] += " and "+field+".country = c.id ";
                    inserted[0] = true;
                case 1:
                	if(!inserted[3]) {
                		s[1] += ",divorgitemlevel1s as d1";
                        s[2] += " and "+field+".divorg1 = d1.id";
