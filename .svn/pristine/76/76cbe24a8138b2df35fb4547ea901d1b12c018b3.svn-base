package persistence.administration.corporation.tables;

import java.io.Serializable;
import java.util.Date;

/**
 * @author fcarriquiry
 * 
 */
public class ContractorPoint implements Serializable {

    private static final long serialVersionUID = 1L;

    private Integer id;
    private Integer contractor;
    private Integer driver;
    private Integer move;
    private Double amount;
	private Date date;

	
	public ContractorPoint() {
	}

	public ContractorPoint(Integer id, Integer contractor, Integer driver, Integer move, Double amount, Date date) {
		super();
		this.id = id;
		this.contractor = contractor;
		this.driver = driver;
		this.move = move;
		this.amount = amount;
		this.date = date;
	}

	public Integer getId() {
		return id;
	}
	
	public void setId(Integer id) {
		this.id = id;
	}
	
	public Integer getContractor() {
		return contractor;
	}
	
	public void setContractor(Integer contractor) {
		this.contractor = contractor;
	}
	
	public Integer getDriver() {
		return driver;
	}
	
	public void setDriver(Integer driver) {
		this.driver = driver;
	}
	
	public Integer getMove() {
		return move;
	}
	
	public void setMove(Integer move) {
		this.move = move;
	}
	
	public Double getAmount() {
		return amount;
	}
	
	public void setAmount(Double amount) {
		this.amount = amount;
	}
	
	public Date getDate() {
		return date;
	}
	
	public void setDate(Date date) {
		this.date = date;
	}

}