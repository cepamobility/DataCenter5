package persistence.datatype.tables;

import communication.datatype.tables.GeneralDTData;
import communication.datatype.tables.PopulationGroupDataType;

/**
 * @author jrodriguez
 */
public class PopulationGroup extends GeneralDataType {

	public PopulationGroup() {
		super();
	}


	public PopulationGroup(String id) {
		super(id);
	}

	/* (non-Javadoc)
	 * @see persistence.datatype.tables.GeneralDataType#getData()
	 */
	public GeneralDTData getData() {
		return new PopulationGroupDataType(resourceBundleId);
	}
	
	

}
