    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required"
     * @ejb.permission role-name = "administrator"
     */
    public void configurate(Collection accidentIn, Collection incidentIn, Collection finesIn, UserSessionData userSessionData) throws Exception {
        try{
            if (userSessionData == null) {
                throw new DeslogedException("configurate","session = null");
            }

            DataTypeReport dataType = DataTypeReportUtil.getHome().create();
            DataTypeABM dataTypeABM = DataTypeABMUtil.getHome().create();

            Collection corporationAccidents = dataType.findAll(userSessionData,DataTypeConstants.ACCIDENT_CLASIFICATION);
            Iterator itNew = accidentIn.iterator();
            while(itNew.hasNext()) {
                AccidentClasificationDataType accident = (AccidentClasificationDataType)itNew.next();
                if(corporationAccidents.contains(accident)) {
                    corporationAccidents.remove(accident);
                    itNew.remove();
                }
            }
            updateDataTypes(dataTypeABM,accidentIn,corporationAccidents,DataTypeConstants.OLD_ACCIDENT_CLASIFICATION,userSessionData);

            Collection corporationIncidents = dataType.findAll(userSessionData,DataTypeConstants.INCIDENT_CLASIFICATION);
            itNew = incidentIn.iterator();
            while(itNew.hasNext()) {
                IncidentClasificationDataType incident = (IncidentClasificationDataType)itNew.next();
                if(corporationIncidents.contains(incident)) {
                    corporationIncidents.remove(incident);
                    itNew.remove();
                }
            }
            updateDataTypes(dataTypeABM,incidentIn,corporationIncidents,DataTypeConstants.OLD_INCIDENT_CLASIFICATION,userSessionData);

            Collection corporationFines = dataType.findAll(userSessionData,DataTypeConstants.FINE_QUALIFY);
            itNew = finesIn.iterator();
            while(itNew.hasNext()) {
                FineQualifyDataType fine = (FineQualifyDataType)itNew.next();
                if(corporationFines.contains(fine)) {
                    corporationFines.remove(fine);
                    itNew.remove();
                }
            }
            updateDataTypes(dataTypeABM,finesIn,corporationFines,DataTypeConstants.OLD_FINE_QUALIFY,userSessionData);

        }catch (Exception e) {

        	Object[] parameters = new Object[3];
        	parameters[0] = accidentIn;
        	parameters[1] = incidentIn;
        	parameters[2] = finesIn;
            handler.handleException("configurate",e,userSessionData,parameters);
        }
    }

    /**
     *
     * @param datatype
     * @param add
     * @param remove
     * @param type
     * @param userSessionData
     * @throws Exception
     */
    private void updateDataTypes(DataTypeABM datatype,Collection add,Collection remove,int type,UserSessionData userSessionData) throws Exception {
    	try{
	        Iterator itAdd = add.iterator();
	        while(itAdd.hasNext()) {
	            datatype.add(((GeneralDTData)itAdd.next()).getResourceBundleId(),type,userSessionData);
	        }
	        Iterator itRemove = remove.iterator();
	        while(itRemove.hasNext()) {
	            datatype.delete(((GeneralDTData)itRemove.next()).getResourceBundleId(),type,userSessionData);
	        }
    	}catch (Exception e){
    		Object[] parameters = new Object[4];
        	parameters[0] = datatype;
        	parameters[1] = add;
        	parameters[2] = remove;
        	parameters[3] = type;
            handler.handleException("configurate",e,userSessionData,parameters);
    	}
    }

    /**
     * @ejb.interface-method view-type = "remote"
     * @ejb.transaction type="Required"
     * @ejb.permission role-name = "administrator,corporationmodify"
     */
	public void configurateMenu(Collection items,UserSessionData userSessionData)	throws Exception{

		if (userSessionData == null) {
			throw new DeslogedException("configurateMenu","userSessionData = null");
		}
		if (items == null) {
			throw new InvalidDataException("configurateMenu","corporation = null");
		}
		try {
		Iterator it = items.iterator();
		CorporationABMHome home = CorporationABMUtil.getHome();
		CorporationABM crpABM=null;
		crpABM = home.create();
		crpABM.deleteCorporationMenuItems(userSessionData);
		while(it.hasNext()){
			Integer item=(Integer)it.next();
			crpABM.corporationMenuCreate(item,userSessionData);
		}

		}catch (Exception e) {
			Object[] parameters = new Object[1];
			parameters[0] = items;
            handler.handleException("configurateMenu",e,userSessionData,parameters);
        }

	}

