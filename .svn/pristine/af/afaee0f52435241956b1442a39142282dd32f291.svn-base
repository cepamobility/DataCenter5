   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,dpachecklist,systemaccess"
   	 *
   	 *  reasonCode:
   	 *  -1:Para estado ACTIVO sin penalizacion
   	 *     0: OTROS FO (Ej: documentación)
     *     1: CEPA-Puntos
     *     2: CEPA-No Conformidad
     *
     *  typeOfPenalty:
     *  -1:Para estado ACTIVO sin penalizacion
   	 *     0: Indeterminada
     *     1: Por tiempo
     *
     * @throws Exception
     *
   	 */
   	public WSResultData suspendedPlate(String plateIn,Integer hours,String reasonDescription,Integer reasonCode,String dateHourStartPenalty,Integer typeOfPenalty, UserSessionData userSession)  throws Exception{
   		WSResultData result=new WSResultData(0,"OK");
   		try{
   			return CorporationABMUtil.getHome().create().suspendedPlate(plateIn, hours, reasonDescription, reasonCode, dateHourStartPenalty, typeOfPenalty, userSession);
   		} catch (Exception e) {
   			e.printStackTrace();
			Object[] parameters = {plateIn,hours,reasonDescription,reasonCode,dateHourStartPenalty,typeOfPenalty};
    		handler.handleException("suspendedPlate",e,userSession,parameters);
    		result.setCode(1);
    		StringWriter errors = new StringWriter();
    		e.printStackTrace(new PrintWriter(errors));
    		result.setDescription(errors.toString());
		}

   		return result;
   	}

