   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,dpachecklist"
   	 * Create driver account
     * @throws Exception
   	 */
   	public  void newSeguimientoRuta(VehicleData vehicle,CheckListData checklistData,VehicleCheckData vehicleCheckData,UserSessionData userSession) throws Exception{
   		try{

   			if(userSession.isCorporation(CorporationData.FORESTALORIENTAL) && PointAccountData.UPM_POINTS){

   				CorporationReport corpoReport=CorporationReportUtil.getHome().create();
   				CorporationABM corpABM =CorporationABMUtil.getHome().create();
   				VehicleStateData state= corpABM.getOrCreateVehicleStateData(vehicle);
   				if(state.getState().equals(VehicleStateData.ACTIVE)){
   	   				PointAccountData account= CorporationReportUtil.getHome().create().getPointAccount(2, vehicle.getId(), userSession);

   	   				Double accountPoints=account.getTotal();
   	   				Double totalLessPoints=0d;
   	   				ArrayList<String> failure=new ArrayList<String>();

   	   				Iterator<PointData> points = checklistData.getSortPoints();
   	   				while(points.hasNext()) {
   	   					PointData point = (PointData)points.next();
   	   					Iterator items = point.getSortItems();
   	   					if(items.hasNext()) {
   	   						communication.activity.tables.ItemData item = (communication.activity.tables.ItemData)items.next();
   	   						int value = -1;
   	   						if(vehicleCheckData != null) {
   	   							String checkValue = vehicleCheckData.getValueFromItem(item.getId()).trim();
   	   							value = (checkValue == null || !checkValue.equals("2")) ? -1 : 2;
   	   						}
   	   						if(value==2){
   	   							PointsDefinitionData definition= corpoReport.getPointsDefinitions(PointsDefinitionData.SEG_ROUTE, item.getId().toString(), userSession);
   	   							if(definition!=null && definition.getAmount()>0){

   	   								PointMoveData moveData=new PointMoveData();
   	   								moveData.setAmount(-definition.getAmount());
   	   								Calendar cal=SecurityConstants.getNow(userSession.getCorporationId());
   	   								moveData.setDate(cal);
   	   								moveData.setDefinition(definition.getId());
   	   								moveData.setAccount(account.getId());
   	   								moveData.setActualTotal(account.getTotal());
   	   								moveData.setAmount(-definition.getAmount());
   	   								moveData.setReference(item.getId().toString());
   	   								moveData.setDescription(definition.getDescription());
   	   								corpABM.savePointMove(moveData, userSession);

   	   								account.setTotal(account.getTotal()-definition.getAmount());
   	   								failure.add(definition.getDescription());

   	   								totalLessPoints+=definition.getAmount();
   	   							}
   	   						}
   	   					}
   	   				}

   	   				corpABM.savePointAccount(account, userSession);
   	   				//Si tuvo puntos negativos se notifica nuevo estado contable
   	   				if(failure.size()>0){
   	   					pointNotify(VehicleStateData.REASON_CODE_POINTS, "las fallas detectadas en Seguimientos en Ruta realizados por CEPA International",  account, vehicle, totalLessPoints, userSession);
   	   				}

   				}//SINO SE IGNORA EL SEGUIMIENTO
   			}else if(userSession.isCorporation(CorporationData.MONTES_DE_PLATA)){

   				Calendar cal=SecurityConstants.getNow(userSession.getCorporationId());
   				String ci=MDPService.getCI(vehicle.getMatricula(), cal);
   				if(ci!=null){
   	   				DriverReport driverReport=DriverReportUtil.getHome().create();
   	   	   			Collection drivers=driverReport.findDriverByCorporationId(ci, userSession);
   	   	   			DriverData driverData=null;
   	   	   			if(drivers.size()==1){
   	   	   				driverData=(DriverData)drivers.iterator().next();
   	   	   				PointAccountData account= CorporationReportUtil.getHome().create().getPointAccount(1, driverData.getId(), userSession);
   	   	   				CorporationABM corpABM =CorporationABMUtil.getHome().create();
   	   	   				CorporationReport corpoReport=CorporationReportUtil.getHome().create();

		   	   	   		Double accountPoints=account.getTotal();
		   				Double totalLessPoints=0d;
		   				ArrayList<String> failure=new ArrayList<String>();

		   				Iterator<PointData> points = checklistData.getSortPoints();
		   				while(points.hasNext()) {
		   					PointData point = (PointData)points.next();
		   					Iterator items = point.getSortItems();
		   					if(items.hasNext()) {
		   						communication.activity.tables.ItemData item = (communication.activity.tables.ItemData)items.next();
		   						int value = -1;
		   						if(vehicleCheckData != null) {
		   							String checkValue = vehicleCheckData.getValueFromItem(item.getId()).trim();
		   							value = (checkValue == null || !checkValue.equals("2")) ? -1 : 2;
		   						}
		   						if(value==2){
		   							PointsDefinitionData definition= corpoReport.getPointsDefinitions(PointsDefinitionData.SEG_ROUTE_MDP, item.getId().toString(), userSession);
		   							if(definition!=null && definition.getAmount()>0){

		   								PointMoveData moveData=new PointMoveData();
		   								moveData.setAmount(-definition.getAmount());
		   								cal=SecurityConstants.getNow(userSession.getCorporationId());
		   								moveData.setDate(cal);
		   								moveData.setDefinition(definition.getId());
		   								moveData.setAccount(account.getId());
		   								moveData.setActualTotal(account.getTotal());
		   								moveData.setAmount(-definition.getAmount());
		   								moveData.setReference(item.getId().toString());
		   								moveData.setDescription(definition.getDescription());
		   								corpABM.savePointMove(moveData, userSession);

		   								account.setTotal(account.getTotal()-definition.getAmount());
		   								failure.add(definition.getDescription());

		   								totalLessPoints+=definition.getAmount();
		   							}
		   						}
		   					}
		   				}

		   				corpABM.savePointAccount(account, userSession);

   	   	   			}else{
   	   	   				System.out.println("CorporationABMFacade.newSeguimientoRuta: No se determina conductor en DC, CI "+ci);
   	   	   			}
   				}else{
   	   				System.out.println("CorporationABMFacade.newSeguimientoRuta: No se determina conductor en MDP para placa "+vehicle.getMatricula());
   				}


   			}

     	} catch (Exception e) {
     		e.printStackTrace();
			Object[] parameters = {vehicle,checklistData};
    		handler.handleException("newSeguimientoRuta",e,userSession,parameters);
    	}
   	}

   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,pointconfupdate"
   	 *
     * @throws Exception
     *
   	 */
   	public void savePointMove(PointMoveData moveData, UserSessionData userSession) throws Exception{
   		try{
   			if(userSession.isCorporation(CorporationData.FORESTALORIENTAL)){
   				CorporationReport corporationReport = CorporationReportUtil.getHome().create();
   				CorporationABM corpABM=CorporationABMUtil.getHome().create();
   				PointAccountData account=corporationReport.getPointAccount(moveData.getAccount(), userSession);
   				VehicleData vehicleData=VehicleReportUtil.getHome().create().findVehicleByPrimaryKey(Integer.valueOf(account.getReference()), userSession);
   				moveData.setActualTotal(account.getTotal());
   				account.setTotal(moveData.getAmount()+account.getTotal());

   				CorporationABMUtil.getHome().create().savePointMove(moveData, userSession);
   				CorporationABMUtil.getHome().create().savePointAccount(account, userSession);

   				//pointNotify(VehicleStateData.REASON_CODE_POINTS, " un ajuste manual ", account, vehicleData, -moveData.getAmount(), userSession);

   				if(moveData.getAmount()<0){
   	   				ArrayList<FringeData> fringers=corporationReport.getFringes(userSession);
   	   				FringeData fringer=null;
   	   				for(FringeData fringerAux:fringers){
   	   					if(account.getTotal()<fringerAux.getAmount() && (account.getTotal()+(-moveData.getAmount()))>=fringerAux.getAmount() ){
   	   						fringer=fringerAux;
   	   						break;
   	   					}
   	   				}
   	   				if(fringer!=null){
   	   					SimpleDateFormat format=new SimpleDateFormat("dd/MM/yyyy HH:mm:ss");
   	   					corpABM.suspendedPlate(vehicleData.getMatricula(), Integer.valueOf(fringer.getTime()), "Sistema de puntos", VehicleStateData.REASON_CODE_POINTS, format.format(new Date()), VehicleStateData.TYPEOFPENALTY_CODE_TIME, userSession);
   	   				}
   				}
   			}

   		} catch (Exception e) {
   			Object[] parameters = {};
    		handler.handleException("activePlate",e,userSession,parameters);

    	}
   	}

   	private void pointNotify(int reasonCode, String principalCause,PointAccountData account,VehicleData vehicle,Double totalLessPoints,UserSessionData userSession) throws Exception {
		 //IF por corporacion y segun sea el caso se notifica de una forma o otra
		if(userSession.isCorporation(CorporationData.FORESTALORIENTAL)){
			pointNotifyFOSA(reasonCode, principalCause, account, vehicle, totalLessPoints, userSession);
		}

	}

   	private void pointNotifyFOSA(int reasonCode, String principalCause,PointAccountData account,VehicleData vehicle,Double totalLessPoints,UserSessionData userSession) throws Exception {
   		CorporationReport corpReport=CorporationReportUtil.getHome().create();

        DataTypeReport dataType = DataTypeReportUtil.getHome().create();
		HashMap<String,CorporationConfigData> configs= corpReport.getCorporationConfig(CorporationData.FORESTALORIENTAL, userSession);

		ArrayList<FringeData> fringers=corpReport.getFringes(userSession);
		FringeData fringer=null;
		for(FringeData fringerAux:fringers){
			if(account.getTotal()<fringerAux.getAmount() && (account.getTotal()+totalLessPoints)>=fringerAux.getAmount() ){
				fringer=fringerAux;
				break;
			}
		}

		//Se notifica siempre al contratista.
		VehicleReport vehicleReport=VehicleReportUtil.getHome().create();

		String contractorMail=vehicleReport.getContractorDataMail(vehicle.getDivOrgIds()[0], userSession);
		contractorMail = contractorMail.replaceAll(";", ",");

		Collection addressTo = new LinkedList();
		Collection bcc = new LinkedList();

		//Esto se usa para debug del sistema, si se inserta la propiedad se recibe un mail con cada movimiento }
		//para poder hacer debug y ver como va respondiendo
		if(SecurityConstants.isProductionServer() && configs.containsKey("points_vehicle_mdp")){
			//addressTo.add("fcarriquiry@cepasafedrive.com");
		}

		String body="";
		body= "Estimado Contratista, le informamos que se descontaron "+totalLessPoints+" puntos al veh&iacute;culo matr&iacute;cula "+vehicle.getMatricula()+"<br/>"+
			  " Dicho descuento fue realizado por "+principalCause+" el d&iacute;a de hoy.<br/>"+
			  " El veh&iacute;culo queda con "+account.getTotal()+" puntos.<br/>";

		String sms= "Se descontaron "+totalLessPoints+" puntos a matricula "+vehicle.getMatricula()+" "+", el vehiculo queda con "+account.getTotal()+" puntos. Atentamente CEPA-FO";


		if(configs.containsKey("points_alert_sms") && configs.get("points_alert_sms").getValue().equalsIgnoreCase("si") ){
			//SMSSender.send("FOSAPoints", account.getId().toString(), "099395558", sms);
		}

		String subject="CEPA - FOSA - Notificación Puntos";
		MailSender sender = new MailSender();
		boolean sended = false;
		int count = 0;
		while(!sended && count < 10 && (addressTo.size()+bcc.size())>0 ) {
			try {
				sended = sender.sendImageMandrill(addressTo, AlertConstants.DIGITAL_SIGNATURE_FOSA, AlertConstants.EMAIL_MICA, subject, business.alert.handler.Util.getCompleteHTMLMail(body,AlertConstants.DIGITAL_SIGNATURE_FOSA, AlertConstants.EMAIL_MICA), new LinkedList<String>(), new LinkedList<String>(), AlertConstants.EMAIL_MICA, AlertConstants.DIGITAL_SIGNATURE_FOSA, bcc, null);
			}catch (Exception e) {
				e.printStackTrace();
			}
			count++;
		}

		if(fringer!=null){
			//Paso una franja tiene que detenerse, se avisa a fosa

			    CorporationABM corpABM =CorporationABMUtil.getHome().create();

			    SimpleDateFormat format=new SimpleDateFormat("dd/MM/yyyy HH:mm:ss");

			    corpABM.suspendedPlateFOSAAsync(vehicle.getId(),totalLessPoints, account.getTotal(), vehicle.getMatricula(), Integer.valueOf(fringer.getTime()), reasonCode==VehicleStateData.REASON_CODE_POINTS?"Sistema de puntos":"No conformidades", reasonCode, format.format(new Date()), reasonCode==VehicleStateData.REASON_CODE_POINTS?VehicleStateData.TYPEOFPENALTY_CODE_TIME:VehicleStateData.TYPEOFPENALTY_CODE_INDETERMINATE, userSession);

				body= "El veh&iacute;culo matr&iacute;cula "+vehicle.getMatricula()+" de el contratista "+((DivOrgData)vehicle.getDivOrgs().iterator().next()).getLabel()+" <br/>"+
					  " se debe detener por "+fringer.getTime()+"hs por estar por debajo de "+fringer.getAmount()+" puntos. <br/>";

				subject="CEPA - FOSA - Notificación Detención por puntos";
				sender = new MailSender();
				sended = false;
				count = 0;
				addressTo = new LinkedList();

				String notificationMails=configs.get("points_vehicle_fosa_notification_mails").getValue();
				if(SecurityConstants.isProductionServer()){
					if(notificationMails!=null && notificationMails.trim().length()>0){
						String[] aux=notificationMails.split(",");
						for(int i =0; i<aux.length;i++){
							addressTo.add(aux[i]);
						}
					}
				}
				while(!sended && count < 10 && (addressTo.size()+bcc.size())>0 ) {
					try {
				    	sended = sender.sendImageMandrill(addressTo, AlertConstants.DIGITAL_SIGNATURE_FOSA, AlertConstants.EMAIL_MICA, subject, business.alert.handler.Util.getCompleteHTMLMail(body,AlertConstants.DIGITAL_SIGNATURE_FOSA,AlertConstants.EMAIL_MICA), new LinkedList<String>(), new LinkedList<String>(), AlertConstants.EMAIL_MICA, AlertConstants.DIGITAL_SIGNATURE_FOSA, bcc, null);
					}catch (Exception e) {
						e.printStackTrace();
					}
					count++;
				}

				//Aca llamamos al ws de ellos, en principio al nuestro mismo.
		}
   	}


   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,systemaccess"
   	 *
     * @throws Exception
     *
   	 */
   	public void saveMobilTrackEvent(MobilTrackEventData data, UserSessionData userSession)throws Exception{
   		try{
   			if(data.getVelGps()>120){
   				return;
   			}
   			CorporationABM corpABM =CorporationABMUtil.getHome().create();
   			VehicleReport vehicleReport =VehicleReportUtil.getHome().create();
   			VehicleData vehicle=vehicleReport.findVehicleByPlateInCorporation(data.getMatricula().toUpperCase().trim().replaceAll(" ", ""), userSession);
   			if(vehicle!=null){
   				data.setVehicle(vehicle.getId());
   			}else{
   				System.out.println("CorporationABMFacade.saveMobilTrackEvent: MT: No existe vehiculo matricula "+data.getMatricula()+" se descarta el evento "+data.getdEvento()+" - "+data.getFechaHora());
   			}
   			Long idEvent=corpABM.saveMobilTrackEvent(data, userSession);
   			//Verificar si existe el vehiculo y cargarlo.
   			if(vehicle!=null && PointAccountData.UPM_POINTS){
   				//Buscar la cuenta del vehiculo.
   	   			//Actualizar los puntos.
   	   			//Ver si pasa franjas.
   	   			//Notificar.
   				VehicleStateData state= corpABM.getOrCreateVehicleStateData(vehicle);
   				if(state.getState().equals(VehicleStateData.ACTIVE)){
   					CorporationReport corpoReport=CorporationReportUtil.getHome().create();
   	   				PointAccountData account= CorporationReportUtil.getHome().create().getPointAccount(2, vehicle.getId(), userSession);

   	   				Double totalLessPoints=0d;
   	   				ArrayList<String> failure=new ArrayList<String>();

   	   				String defPoint=data.getdEvento().contains("2") && data.getdEvento().contains("Exceso") &&!data.getdEvento().contains("zona")?PointsDefinitionData.FOSA_SPEED_2:"";

   	   				defPoint=data.getdEvento().contains("1") && data.getdEvento().toLowerCase().contains("exceso") &&!data.getdEvento().toLowerCase().contains("zona") ? PointsDefinitionData.FOSA_SPEED : defPoint;
   	   				defPoint=data.getdEvento().toLowerCase().contains("ingreso") && data.getdEvento().toLowerCase().contains("prohibida") && data.getdEvento().toLowerCase().contains("zona") ? PointsDefinitionData.FOSA_SPEED_PROHIBIDA : defPoint;
   	   			    defPoint=data.getdEvento().toLowerCase().contains("exceso") && data.getdEvento().toLowerCase().contains("velocidad") && data.getdEvento().toLowerCase().contains("zona") ? PointsDefinitionData.FOSA_SPEED_ZONA : defPoint;

   	   				PointsDefinitionData definition= corpoReport.getPointsDefinitions(defPoint, "0", userSession);
   					if(definition!=null && definition.getAmount()>0){
   						System.out.println("MT:Se usa definicion de puntos "+definition.getId()+"-"+definition.getDescription()+" Evento:"+data.getMatricula()+"-"+data.getdEvento()+"-"+data.getFechaHora());
   						PointMoveData moveData=new PointMoveData();
   						moveData.setAmount(-definition.getAmount());
   						moveData.setDate(data.getFechaHora());
   						moveData.setDefinition(definition.getId());
   						moveData.setAccount(account.getId());
   						moveData.setAmount(-definition.getAmount());
   						moveData.setActualTotal(account.getTotal());
   						moveData.setReference(idEvent.toString());
   						moveData.setDescription(data.getdEvento());

   						corpABM.savePointMove(moveData, userSession);

   						account.setTotal(account.getTotal()-definition.getAmount());
   						failure.add(definition.getDescription());

   						totalLessPoints+=definition.getAmount();
   					}else{
   						System.out.println("MT:No se encontro definicion de puntos "+data.getMatricula()+"-"+data.getdEvento()+"-"+data.getFechaHora());
   					}

   	   				corpABM.savePointAccount(account, userSession);
   	   				//Si tuvo puntos negativos se notifica nuevo estado contable
   	   				if(failure.size()>0){
   	   					pointNotify(VehicleStateData.REASON_CODE_POINTS, " un exceso de velocidad detectado por MobilTrack ",  account, vehicle, totalLessPoints, userSession);
   	   				}
   				}else{
   					//SINO SE IGNORA EL EVENTO
   					System.out.println("MT:Se descarta el evento porque su estado no es activo "+data.getMatricula()+"-"+data.getdEvento()+"-"+data.getFechaHora());
   				}
   			}

   		}catch (Exception e) {
			Object[] parameters = {data};
    		handler.handleException("saveMobilTrackEvent",e,userSession,parameters);
    	}
   	}

	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,systemaccess"
   	 *
     * @throws Exception
     *
   	 */
   	public void saveEasyTrackEvent(EasyTrackEventData data, UserSessionData userSession)throws Exception{
   		try{
   			if(data.getVelGps()<=90){
   				return;
   			}

   			CorporationABM corpABM =CorporationABMUtil.getHome().create();
   			VehicleReport vehicleReport =VehicleReportUtil.getHome().create();
   			VehicleData vehicle=vehicleReport.findVehicleByPlateInCorporation(data.getMatricula().toUpperCase().trim().replaceAll(" ", ""), userSession);
   			if(vehicle!=null){
   				data.setVehicle(vehicle.getId());
   			}else{
   				System.out.println("CorporationABMFacade.saveEasyTrackEvnent: No existe vehiculo matricula "+data.getMatricula());
   			}
   			DriverReport driverReport=DriverReportUtil.getHome().create();
   			Collection drivers=driverReport.findDriverByCorporationId(data.getCi(), userSession);
   			DriverData driverData=null;
   			if(drivers.size()==1){
   				driverData=(DriverData)drivers.iterator().next();
   				data.setDriver(driverData.getId());
   			}else{
   				System.out.println("CorporationABMFacade.saveEasyTrackEvent: No se determina conductor, CI "+data.getCi());
   			}
   			Long idEvent=corpABM.saveEasyTrackEvent(data, userSession);

   			if(data.getDriver()!=null && data.getDriver()>0){
   				CorporationReport corpoReport=CorporationReportUtil.getHome().create();
   				PointAccountData account= CorporationReportUtil.getHome().create().getPointAccount(1, data.getDriver(), userSession);
   				Double actualTotal=account.getTotal();
   				Double accountPoints=account.getTotal();
   				Double totalLessPoints=0d;
   				ArrayList<String> failure=new ArrayList<String>();

   				PointsDefinitionData definition= corpoReport.getPointsDefinitions(data.getVelGps()>100?PointsDefinitionData.MDP_SPEED_2:PointsDefinitionData.MDP_SPEED, "0", userSession);
   				if(definition!=null && definition.getAmount()>0){

   					PointMoveData moveData=new PointMoveData();
   					moveData.setAmount(-definition.getAmount());
   					moveData.setDate(data.getFechaHora());
   					moveData.setDefinition(definition.getId());
   					moveData.setAccount(account.getId());
   					moveData.setAmount(-definition.getAmount());
   					moveData.setActualTotal(account.getTotal());
   					moveData.setReference(idEvent.toString());
   					moveData.setDescription(definition.getDescription());

   					corpABM.savePointMove(moveData, userSession);

   					account.setTotal(account.getTotal()-definition.getAmount());
   					failure.add(definition.getDescription());

   					totalLessPoints+=definition.getAmount();
   				}

   				corpABM.savePointAccount(account, userSession);
				pointNotifyMDP(actualTotal, account.getTotal(),driverData, userSession);

   			}

   		}catch (Exception e) {
   			e.printStackTrace();
			Object[] parameters = {data};
    		handler.handleException("saveEasyTrackEvent",e,userSession,parameters);
    	}
   	}



   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,systemaccess"
   	 *
     * @throws Exception
     *
   	 */
   	public void pointNotifyMDP(Double totalAnt, Double actualTotal,DriverData driver, UserSessionData userSession) {
		// TODO Auto-generated method stub
   		String franja="";
   		if(totalAnt>80 && actualTotal<80 && actualTotal> 60){
   			//Puntaje amarillo entre 80 y 60 puntos  - Envía email al Monitor de la empresa contratista
   			franja="Amarilla";
   		}else if(totalAnt>60 && actualTotal<60 && actualTotal> 40){
   			//Puntaje naranja entre 60 y 40 puntos – Envía email al monitor de la empresa contratista + mail responsable de la empresa + responsable de MDP
   			franja="Naranja";
   		}else if( totalAnt>40 && actualTotal<40){
   			//Puntaje rojo menor a 40 puntos – Envía email al monitor de la empresa contratista + mail responsable de la empresa + responsable de MDP / además solicitará una “acción correctiva” que deberá ser definido por contratista asignado.
   			franja="Roja";
   		}
   		if(franja.length()>0){
   			String body="";
   		   	body= "El conductor "+driver.getFirstName()+" "+driver.getLastName()+" "+driver.getCorporationId()+" se encuentra en la franja "+franja+", sus puntos son "+actualTotal;

   			Collection addressTo=new ArrayList<String>();
   			//addressTo.add("fcarriquiry@cepasafedrive.com");

   			String subject="CEPA - MDP - Notificación Puntos";

   			boolean sended = false;
   			int count = 0;
   			while(!sended && count < 10 && addressTo.size()>0 ) {
   				try {
   					sended =MailSender.sendMailMandrill( business.alert.handler.Util.getCompleteHTMLMail(body,AlertConstants.DIGITAL_SIGNATURE_FOSA,
   									AlertConstants.EMAIL_MICA), subject, AlertConstants.EMAIL_MICA, addressTo, new ArrayList<String>(),  new ArrayList<String>());
   				}catch (Exception e) {
   					e.printStackTrace();
   				}
   				count++;
   			}
   		}
	}

	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,drivercreate,finecreate,drivercreatefine,cepascheduleactivityupdate"
   	 * Create driver account
     * @throws Exception
   	 */
	public void addMoves(PointAccountData driverAccount, Collection<PointMoveData> moves, UserSessionData userSessionData) throws Exception {
		CorporationABM corpABM = CorporationABMUtil.getHome().create();
		CorporationReport corpReport = CorporationReportUtil.getHome().create();
		Collections.sort((List)moves);
		Iterator<PointMoveData> itMoves = moves.iterator();
		double sum = 0;
		while(itMoves.hasNext()) {
			PointMoveData move = itMoves.next();
			move.setAccount(driverAccount.getId());
			if(!corpReport.existPointMove(move,userSessionData)) {
				sum += move.getAmount().doubleValue();
				move.setAccount(driverAccount.getId());
				corpABM.savePointMove(move,userSessionData);
			}
		}
		if(userSessionData.isCorporation(new int[]{CorporationData.BAYER_MX,CorporationData.MONTES_DE_PLATA})) {
			Collection<PointMoveData> baseMoves = corpReport.getPointMoves(driverAccount.getId(), userSessionData);
			baseMoves.addAll(moves);
			Collections.sort((List)baseMoves);
			sum = (userSessionData.isCorporation(CorporationData.MONTES_DE_PLATA)) ? 100.0 : 0.0;
			Iterator<PointMoveData> it = baseMoves.iterator();
			while(it.hasNext()) {
				sum += it.next().getAmount();
				if(sum < 0)
					sum = 0.0;
				if(userSessionData.isCorporation(CorporationData.MONTES_DE_PLATA) && sum > 100)
					sum = 100.0;
			}
			driverAccount.setTotal(sum);
			corpABM.savePointAccount(driverAccount, userSessionData);
		} else {
			if(sum != 0) {
				driverAccount.sum(sum, userSessionData.getCorporationId());
				corpABM.savePointAccount(driverAccount, userSessionData);
			}
		}
	}

   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,drivercreate,finecreate,drivercreatefine"
   	 * Create driver account
     * @throws Exception
   	 */
	public void removeMove(PointAccountData driverAccount, PointMoveData move, UserSessionData userSessionData) throws Exception {
   		try{
			CorporationABM corpABM = CorporationABMUtil.getHome().create();
			corpABM.removeMove(move,userSessionData);
			if(userSessionData.isCorporation(new int[] {CorporationData.BAYER_MX, CorporationData.MONTES_DE_PLATA})) {
				Collection<PointMoveData> baseMoves = CorporationReportUtil.getHome().create().getPointMoves(driverAccount.getId(), userSessionData);
				Collections.sort((List)baseMoves);
				double sum = (userSessionData.isCorporation(CorporationData.MONTES_DE_PLATA)) ? 100.0 : 0.0;
				Iterator<PointMoveData> it = baseMoves.iterator();
				while(it.hasNext()) {
					PointMoveData moveData = it.next();
					if(moveData.getId().intValue() != move.getId().intValue()) {
						sum += moveData.getAmount();
						if(sum < 0)
							sum = 0.0;
						if(userSessionData.isCorporation(CorporationData.MONTES_DE_PLATA) && sum > 100)
							sum = 100.0;
					}
				}
				driverAccount.setTotal(sum);
				corpABM.savePointAccount(driverAccount, userSessionData);
			} else {
				driverAccount.sum(move.getAmount()*-1, userSessionData.getCorporationId());
				corpABM.savePointAccount(driverAccount, userSessionData);
			}
     	} catch (Exception e) {
			Object[] parameters = {driverAccount,move};
    		handler.handleException("removeMove",e,userSessionData,parameters);
    	}
	}

