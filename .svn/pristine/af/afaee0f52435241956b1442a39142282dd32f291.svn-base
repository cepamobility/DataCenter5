  	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,drivercreate"
   	 * Create driver account
     * @throws Exception
   	 */
	public void addDriver(DriverData driver, UserSessionData userSessionData) throws Exception {
		Collection<PointMoveData> moves = new LinkedList<PointMoveData>();
		PointAccountData driverAccount = saveDriverAccount(driver.getId(), driver.getCorporation().getId(), userSessionData);

		CorporationReportFacade corporationReport = CorporationReportFacadeUtil.getHome().create();
		String[] keys = {PointsDefinitionData.AGE,PointsDefinitionData.LICENSE_AGE_LESS,PointsDefinitionData.LICENSE_AGE_BETWEEN,PointsDefinitionData.COMPANY_AGE_LESS};
		HashMap<String,PointsDefinitionData> definitions = corporationReport.getPointsDefinition(keys,driver.getCorporation().getId(),userSessionData);
		if(definitions != null && definitions.size() > 0) {
			if(definitions.containsKey(PointsDefinitionData.AGE) && driver.getBirthDate() != null) {
				PointsDefinitionData definitionData = definitions.get(PointsDefinitionData.AGE);
				if(Integer.parseInt(definitionData.getReference()) > driver.getAge()) {
					moves.add(new PointMoveData(definitionData,Calendar.getInstance(),Util.formatDate(driver.getBirthDate())));
				}
			}
			if(definitions.containsKey(PointsDefinitionData.COMPANY_AGE_LESS) && driver.getInclusionDate() != null) {
				PointsDefinitionData definitionData = definitions.get(PointsDefinitionData.COMPANY_AGE_LESS);
				if(Integer.parseInt(definitionData.getReference()) > driver.getComapanyAge()) {
					moves.add(new PointMoveData(definitionData,Calendar.getInstance(),Util.formatDate(driver.getInclusionDate())));
				}
			}
			if(driver.getLicenseGet() != null) {
				int licenseAge = driver.getLicenseAge();
				boolean added = false;
				if(definitions.containsKey(PointsDefinitionData.LICENSE_AGE_LESS)) {
					PointsDefinitionData definitionData = definitions.get(PointsDefinitionData.LICENSE_AGE_LESS);
					if(Integer.parseInt(definitionData.getReference()) > licenseAge) {
						moves.add(new PointMoveData(definitionData,Calendar.getInstance(),Util.formatDate(driver.getLicenseGet())));
						added = true;
					}
				}
				if(!added && definitions.containsKey(PointsDefinitionData.LICENSE_AGE_BETWEEN)) {
					PointsDefinitionData definitionData = definitions.get(PointsDefinitionData.LICENSE_AGE_BETWEEN);
					StringTokenizer tokenizer = new StringTokenizer(definitionData.getReference(),",");
					int min = Integer.parseInt(tokenizer.nextToken());
					int max = Integer.parseInt(tokenizer.nextToken());
					if(min <= licenseAge && licenseAge <= max) {
						moves.add(new PointMoveData(definitionData,Calendar.getInstance(),Util.formatDate(driver.getLicenseGet())));
					}
				}
			}
		}
		if(moves.size() > 0) {
			addMoves(driverAccount, moves, userSessionData);
		}
	}

  	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,finecreate,drivercreatefine"
   	 * Create driver account
     * @throws Exception
   	 */
	public void addFine(FineDataType fine, UserSessionData userSessionData) throws Exception {
		Collection<PointMoveData> moves = new LinkedList<PointMoveData>();

		CorporationReport corporationReport = CorporationReportUtil.getHome().create();
		PointAccountData driverAccount = corporationReport.getPointAccount(PointAccountData.DRIVER, fine.getDriver().getId(), userSessionData);
		PointsDefinitionData definition = corporationReport.getPointsDefinitions(PointsDefinitionData.FINE, fine.getQualify().getResourceBundleId(), userSessionData);
		if(definition != null) {
			definition.pound(fine.getAge(),userSessionData.getCorporationId());
			Calendar c = Calendar.getInstance();
			c.setTime(fine.getDate());
			moves.add(new PointMoveData(definition,c,String.valueOf(fine.getId())));
			if(userSessionData.isCorporation(CorporationData.BAYER_MX)) {
				PointMoveData price = corporationReport.eventAward(fine.getDate(), driverAccount.getId(), userSessionData);
				if(price != null) {
					moves.add(price);
				}
			}
		}
		if(moves.size() > 0) {
			addMoves(driverAccount, moves, userSessionData);
		}
	}

  	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,finecreate,drivercreatefine"
   	 * Create driver account
     * @throws Exception
   	 */
	public void updateFine(FineDataType fine, UserSessionData userSessionData) throws Exception {
		CorporationReport corporationReport = CorporationReportUtil.getHome().create();
		PointAccountData driverAccount = corporationReport.getPointAccount(PointAccountData.DRIVER, fine.getDriver().getId(), userSessionData);
		PointsDefinitionData definition = corporationReport.getPointsDefinitions(PointsDefinitionData.FINE, fine.getQualify().getResourceBundleId(), userSessionData);
		PointMoveData move = corporationReport.getPointMove(driverAccount.getId(),String.valueOf(fine.getId()),null,userSessionData);
		Calendar c = Calendar.getInstance();
		c.setTime(fine.getDate());
		if(move == null) {
			if(definition != null) {
				Collection<PointMoveData> moves = new LinkedList<PointMoveData>();
				definition.pound(fine.getAge(),userSessionData.getCorporationId());
				moves.add(new PointMoveData(definition,c,String.valueOf(fine.getId())));
				addMoves(driverAccount, moves, userSessionData);
			}
		}else {
			if(definition == null) {
				removeMove(driverAccount,move,userSessionData);
			}else if (definition.getId().intValue() != move.getDefinition().intValue()){
				removeMove(driverAccount,move,userSessionData);
				Collection<PointMoveData> moves = new LinkedList<PointMoveData>();
				definition.pound(fine.getAge(),userSessionData.getCorporationId());
				moves.add(new PointMoveData(definition,c,String.valueOf(fine.getId())));
				addMoves(driverAccount, moves, userSessionData);
			}
		}
	}

