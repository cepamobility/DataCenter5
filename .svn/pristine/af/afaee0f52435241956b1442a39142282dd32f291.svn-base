	/**
     * @ejb.interface-method
     * @ejb.transaction type="Required"
     * @ejb.permission role-name = "administrator,corporationmodify"
     * Deletes organizational division items
     * @param currentUser - Data of the logged user
     * @param data - Data of the corporation
     * @param divOrgId - Id of the orgnanizational division that contains the item
     * @param deletedItems - List of items to delete
     * @param level - Level of the items
     * @throws InvalidDataException
     * @throws CommunicationProblemException
     * @throws DeslogedException
     * @throws RemoteException
	 */
	public void corporationDeleteItem(CorporationData data,Integer divOrgId, Hashtable deletedItems,
			int level,UserSessionData userSessionData)	throws Exception {
		if (userSessionData == null) {
			throw new DeslogedException("corporationDeleteItem","userSessionData = null");
		}
		if (data == null) {
			throw new InvalidDataException("corporationDeleteItem","data = null");
		}
		CorporationABM corporationABM=null;
		try {

		    CorporationABMHome home = CorporationABMUtil.getHome();
	        corporationABM = home.create();

		    Corporation corporation = corporationABM.loadCorporation(data.getId(),userSessionData);
            Iterator it = corporation.getDivOrgSet().iterator();
            while(it.hasNext()) {
                DivOrg divOrg = (DivOrg)it.next();
                if(divOrg.getId().equals(divOrgId)) {
                    Iterator it2 = divOrg.getItemLevel1Set().iterator();
                    while(it2.hasNext()) {
                        DivOrgItemLevel1  itemLevel1 = (DivOrgItemLevel1)it2.next();
                        switch(level) {
                            case 1:
                                if(deletedItems.containsKey(itemLevel1.getId())) {
                                    String message = corporationABM.validateDeleteItem(itemLevel1.getId(),1);
                                    if(message == null) {
                                        it2.remove();
                                        itemLevel1.setDivOrg(null);
                                        if(itemLevel1.getDivOrgItemLevel2() != null) {
                                            DivOrgItemLevel2 itemLevel2 = itemLevel1.getDivOrgItemLevel2();
                                            itemLevel1.setDivOrgItemLevel2(null);
                                            deleteGarbage(divOrg,itemLevel2.getId(),2,corporationABM,userSessionData);
                                            if(itemLevel2.getDivOrgItemLevel3() != null) {
                                                DivOrgItemLevel3 itemLevel3 = itemLevel2.getDivOrgItemLevel3();
                                                deleteGarbage(divOrg,itemLevel3.getId(),3,corporationABM,userSessionData);
                                            }
                                        }
                                    }else {
                                        throw new InvalidDataException("corporationDeleteItem",message);
                                    }
                                }
                                break;
                            case 2:
                                if(itemLevel1.getDivOrgItemLevel2() != null) {
                                    DivOrgItemLevel2  itemLevel2 = itemLevel1.getDivOrgItemLevel2();
                                    if(deletedItems.containsKey(itemLevel2.getId())) {
                                        String message = corporationABM.validateDeleteItem(itemLevel1.getId(),1);
                                        if(message == null) {
	                                        it2.remove();
	                                        itemLevel1.setDivOrg(null);
	                                        itemLevel1.setDivOrgItemLevel2(null);
	                                        deleteGarbage(divOrg,itemLevel2.getId(),2,corporationABM,userSessionData);
                                        }else {
                                            throw new InvalidDataException("corporationDeleteItem",message);
                                        }
                                    }
                                    if(itemLevel2.getDivOrgItemLevel3() != null) {
                                        DivOrgItemLevel3  itemLevel3 = itemLevel2.getDivOrgItemLevel3();
                                        deleteGarbage(divOrg,itemLevel3.getId(),3,corporationABM,userSessionData);
                                    }
                                }
                                break;
                            case 3:
                                if(itemLevel1.getDivOrgItemLevel2() != null) {
                                    DivOrgItemLevel2  itemLevel2 = itemLevel1.getDivOrgItemLevel2();
                                    if(itemLevel2.getDivOrgItemLevel3() != null) {
                                        DivOrgItemLevel3  itemLevel3 = itemLevel2.getDivOrgItemLevel3();
	                                    if(deletedItems.containsKey(itemLevel3.getId())) {
                                            String message = corporationABM.validateDeleteItem(itemLevel1.getId(),1);
                                            if(message == null) {
		                                        it2.remove();
		                                        itemLevel1.setDivOrg(null);
		                                        itemLevel1.setDivOrgItemLevel2(null);
		                                        deleteGarbage(divOrg,itemLevel2.getId(),2,corporationABM,userSessionData);
		                                        deleteGarbage(divOrg,itemLevel3.getId(),3,corporationABM,userSessionData);
	                                        }else {
                                                throw new InvalidDataException("corporationDeleteItem",message);
	                                        }
	                                    }
                                    }
                                }
                                break;
                        }
                    }
                }
            }

            corporationABM.logChanges(userSessionData,LogActions.UPDATE);

        } catch (Exception e) {
        	Object[] parameters = new Object[4];
        	parameters[0] = data;
        	parameters[1] = divOrgId;
        	parameters[2] = deletedItems;
        	parameters[3] = level;
            handler.handleException("corporationDeleteItem",e,userSessionData,parameters);
        }
	}

    /**
     * Deletes the organizational divisions items that has not any children
     * @param divOrg organizational divisions
     * @param itemId item to delete if hasn't children
     * @param level level of the item
     * @param corporationABM Bean of persistence
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @throws RemoteException
     */
	private void deleteGarbage(DivOrg divOrg, Integer itemId, int level,
			CorporationABM corporationABM,UserSessionData userSessionData) throws Exception {

		try{
		    Iterator it = divOrg.getItemLevel1Set().iterator();
		    boolean found = false;
		    while(it.hasNext() && !found) {
		        DivOrgItemLevel1 itemLevel1 = (DivOrgItemLevel1)it.next();
		        if(level == 2) {
		            if(itemLevel1.getDivOrgItemLevel2().getId().equals(itemId)) {
		                found = true;
		            }
		        }else {
		            if(itemLevel1.getDivOrgItemLevel2().getDivOrgItemLevel3().getId().equals(itemId)) {
		                found = true;
		            }
		        }
		    }
		    if(!found) {
		        if(level == 2) {
		            corporationABM.deleteItemLevel(userSessionData,itemId,2);
		        }else {
		            corporationABM.deleteItemLevel(userSessionData,itemId,3);
		        }
		    }
		} catch (Exception e) {
        	Object[] parameters = new Object[4];
        	parameters[0] = divOrg;
        	parameters[1] = itemId;
        	parameters[2] = level;
        	parameters[3] = corporationABM;
            handler.handleException("deleteGarbage",e,userSessionData,parameters);
        }
	}

    /**
     * @ejb.interface-method
     * @ejb.transaction type="Required"
     * @ejb.permission role-name = "administrator,corporationmodify"
     * Modifies the states of items of an organizational division of a corporation
     * @param data Data of the corporation
     * @param divOrgId id of the organizational division
     * @param deletedItemslist of item to modify
     * @param level level of the items
     * @throws InvalidDataException
     * @throws CommunicationProblemException
     * @throws DeslogedException
     */
	public void corporationUpdateItem(CorporationData data,Integer divOrgId, Hashtable deletedItems,
			int level,UserSessionData userSessionData) throws Exception {
		if (userSessionData == null) {
			throw new DeslogedException("corporationUpdateItem","userSessionData = null");
		}
		if (data == null) {
			throw new InvalidDataException("corporationUpdateItem","data = null");
		}
		CorporationABM corporationABM=null;
		try {

			CorporationABMHome home = CorporationABMUtil.getHome();
			corporationABM = home.create();

			DivOrgData divOrgData = data.getDivOrgData(divOrgId.intValue());
			if(divOrgData != null) {
			    Iterator it = divOrgData.getDivOrgLevels().getItems().iterator();
			    while(it.hasNext()) {
			        ItemData item = (ItemData)it.next();
			        if(level == 1 || (item.getSubItems() == null)) {
			            if(deletedItems.containsKey(item.getId())) {
			                item.modifyActive();
			            }
			        }else{
					    Iterator it2 = item.getSubItems().getItems().iterator();
					    while(it2.hasNext()) {
					        ItemData item2 = (ItemData)it2.next();
					        if(level == 2 || (item2.getSubItems() == null)) {
					            if(deletedItems.containsKey(item2.getId())) {
					                item2.modifyActive();
					            }
					        }else{
							    Iterator it3 = item2.getSubItems().getItems().iterator();
							    while(it3.hasNext()) {
							        ItemData item3 = (ItemData)it3.next();
						            if(deletedItems.containsKey(item3.getId())) {
						                item3.modifyActive();
							        }
							    }
					        }
					    }
			        }
			    }

                corporationABM.corporationUpdate(data, userSessionData);
			}

        } catch (Exception e) {
        	Object[] parameters = new Object[4];
			parameters[0] = data;
        	parameters[1] = divOrgId;
        	parameters[2] = deletedItems;
        	parameters[3] = level;
            handler.handleException("corporationUpdateItem",e,userSessionData,parameters);
		}
	}

    /**
     * @ejb.interface-method
     * @ejb.transaction type="Required"
     * @ejb.permission role-name = "administrator,corporationmodify"
     * Deletes a geographic division item of a corportion
     * @param currentUser - Data of the user logged
     * @param corporation - Data of the corporation
     * @param hashItems - List of items to delete
     * @param level - Level of the items
     * @param levelContainer - Level of the parent item
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     */
	public void corporationDeleteCountry(CorporationData corporation, Hashtable hashItems,
			int level, String levelContainer,UserSessionData userSessionData) throws Exception {
		if (userSessionData == null) {
			throw new DeslogedException("corporationDeleteCountry","userSessionData = null");
		}
		if (corporation == null) {
			throw new InvalidDataException("corporationDeleteCountry","corporation = null");
		}
		CorporationABM corporationABM=null;
		try {

		    CorporationABMHome home = CorporationABMUtil.getHome();
	        corporationABM = home.create();

			if(corporation.getDivGeoDataSet() != null) {
			    Iterator itLevel1 = corporation.getDivGeoDataSet().getItemIterator();
			    while(itLevel1.hasNext()) {
			        GeoItemData item1 = (GeoItemData)itLevel1.next();
			        if(level == 1) {
			            if(hashItems.containsKey(item1.getId())) {
			                int levelDelete = 1;
			                if(item1.getSubItems() != null) {
			                    Iterator itLevel2 = item1.getSubItems().getItemIterator();
			                    while(itLevel2.hasNext()) {
			        		        GeoItemData item2 = (GeoItemData)itLevel2.next();
			        		        if(item2.getSubItems() != null) {
					                    Iterator itLevel3 = item2.getSubItems().getItemIterator();
					                    while(itLevel3.hasNext()) {
					        		        GeoItemData item3 = (GeoItemData)itLevel3.next();
					        		        itLevel3.remove();
					        		        corporationABM.deleteCountry(userSessionData,item3.getId(),item2.getId(),3);
					                    }
				        		        itLevel2.remove();
				        		        corporationABM.deleteCountry(userSessionData,item2.getId(),null,2);
			        		        }else {
			        		            levelDelete = 2;
			        		            itLevel2.remove();
			        		            corporationABM.deleteCountry(userSessionData,item2.getId(),item1.getId(),3);
			        		        }
			                    }
		        		        corporationABM.deleteCountry(userSessionData,item1.getId(),null,levelDelete);
			                }else {
		        		        corporationABM.deleteCountry(userSessionData,item1.getId(),null,3);
			                }
			            }
			        }else if(level == 2) {
		                if(item1.getSubItems() != null) {
		                    Iterator itLevel2 = item1.getSubItems().getItemIterator();
			                int levelDelete = 1;
		                    while(itLevel2.hasNext()) {
		        		        GeoItemData item2 = (GeoItemData)itLevel2.next();
		    		            if(hashItems.containsKey(item2.getId())) {
			        		        if(item2.getSubItems() != null) {
					                    Iterator itLevel3 = item2.getSubItems().getItemIterator();
					                    while(itLevel3.hasNext()) {
					        		        GeoItemData item3 = (GeoItemData)itLevel3.next();
					        		        corporationABM.deleteCountry(userSessionData,item3.getId(),item2.getId(),3);
					        		        itLevel3.remove();
					                    }
				        		        itLevel2.remove();
				        		        corporationABM.deleteCountry(userSessionData,item2.getId(),null,2);
			        		        }else {
						                levelDelete = 2;
			        		            if(String.valueOf(item1.getId()).equals(levelContainer)) {
			        		                itLevel2.remove();
			        		                corporationABM.deleteCountry(userSessionData,item2.getId(),item1.getId(),3);
			        		            }
			        		        }
		    		            }
		                    }
		                    if(item1.getSubItems().isEmpty()) {
		        		        corporationABM.deleteCountry(userSessionData,item1.getId(),null,levelDelete);
		                    }
		                }
			        }else if(level == 3) {
		                if(item1.getSubItems() != null) {
		                    Iterator itLevel2 = item1.getSubItems().getItemIterator();
		                    while(itLevel2.hasNext()) {
		        		        GeoItemData item2 = (GeoItemData)itLevel2.next();
		        		        if(item2.getSubItems() != null && String.valueOf(item2.getId()).equals(levelContainer)) {
				                    Iterator itLevel3 = item2.getSubItems().getItemIterator();
				                    while(itLevel3.hasNext()) {
				        		        GeoItemData item3 = (GeoItemData)itLevel3.next();
				    		            if(hashItems.containsKey(item3.getId())) {
				    		                itLevel3.remove();
					        		        corporationABM.deleteCountry(userSessionData,item3.getId(),new Integer(levelContainer),3);
				    		            }
				                    }
		        		        }
		        		        if(item2.getSubItems().isEmpty()) {
		        		            itLevel2.remove();
			        		        corporationABM.deleteCountry(userSessionData,item2.getId(),null,2);
		        		        }
		                    }
		                    if(item1.getSubItems().isEmpty()) {
		        		        corporationABM.deleteCountry(userSessionData,item1.getId(),null,1);
		                    }
		                }
			        }
			    }
			}

			corporationABM.logChanges(userSessionData,LogActions.UPDATE);

		} catch (Exception e) {
			Object[] parameters = new Object[4];
			parameters[0] = corporation;
			parameters[1] = hashItems;
			parameters[2] = level;
			parameters[3] = levelContainer;

            handler.handleException("corporationDeleteCountry",e,userSessionData,parameters);
		}
    }

    /**
     * @ejb.interface-method
     * @ejb.transaction type="Required"
     * @ejb.permission role-name = "administrator,corporationmodify"
     * Adds items of geographic divisions to the corporation in work
     * @param data Items
     * @param corporation Data of the corporation
     * @param user Data of the user logged
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @throws AlreadyExistsException
     */
	public void corporationAddCountry(GeoLabelData data,CorporationData corporation,UserSessionData userSessionData) throws Exception {
		if (userSessionData == null) {
			throw new DeslogedException("corporationAddCountry","userSessionData = null");
		}
		if (corporation == null) {
			throw new InvalidDataException("corporationAddCountry","corporation = null");
		}
		if (data == null) {
			throw new InvalidDataException("corporationAddCountry","data = null");
		}
		CorporationABM corporationABM=null;
		CorporationReport corporationReport=null;
		try {

		    CorporationABMHome home = CorporationABMUtil.getHome();
	        corporationABM = home.create();

	        corporationABM.corporationAddCountry(userSessionData,data,corporation);

		    CorporationReportHome reportHome = CorporationReportUtil.getHome();
		    corporationReport = reportHome.create();

		    corporation = corporationReport.findCorporationByPrimaryKey(corporation.getId(),userSessionData);

		} catch (Exception e) {
			Object[] parameters = new Object[2];
			parameters[0] = data;
			parameters[1] = corporation;
			handler.handleException("corporationAddCountry",e,userSessionData,parameters);
		}
    }

