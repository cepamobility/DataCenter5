	public void ejbCreate()	throws javax.ejb.CreateException { }

	/**
	 * @ejb.interface-method
	 * 		view-type = "remote"
     * @ejb.transaction type="Required"
     * @ejb.permission role-name = "administrator,corporationcreate"
	 * Create a corporation
	 * @param data - Data of the corporation
	 * @throws Exception
	 */
	public void corporationCreate(CorporationData data,Collection texts,UserSessionData userSessionData) throws Exception{

		if (userSessionData == null) {
			throw new DeslogedException("corporationCreate","userSessionData = null");
		}
		if (data == null) {
			throw new InvalidDataException("corporationCreate","data = null");
		}
		if (!validate(data)) {
			throw new InvalidDataException("corporationCreate","generic.error.emptydata");
		}
		CorporationABM crpABM=null;
		try {
            LanguageABMHome languageHome = LanguageABMUtil.getHome();
            LanguageABM languageABM = languageHome.create();
            Iterator it = texts.iterator();
            while(it.hasNext()) {
                String[] s = (String[])it.next();
                languageABM.saveText(s[0],GeneralMessage.SPANISH,s[1], userSessionData);
                languageABM.saveText(s[0],GeneralMessage.ENGLISH,s[2], userSessionData);
                languageABM.saveText(s[0],GeneralMessage.PORTUGUESE,s[3], userSessionData);
            }

			CorporationABMHome home = CorporationABMUtil.getHome();
			crpABM = home.create();
			Integer corporationId = crpABM.corporationCreate(data, userSessionData);

			UserABM userABM = UserABMUtil.getHome().create();
            userABM.associateUserToCorporation(corporationId,userSessionData.getFilter().getLoginName(),userSessionData.getRole().getName(),userSessionData);

		} catch (Exception e) {
			Object[] parameters = new Object[2];
			parameters[0] = data;
			parameters[1] = texts;
            handler.handleException("corporationCreate",e, userSessionData, parameters);
		}
	}

	/**
	 * @ejb.interface-method
	 * 		view-type = "remote"
     * @ejb.transaction type="Required"
     * @ejb.permission role-name = "administrator,corporationmodify"
	 * Modifies a corporation
	 * @param data Data of the corporation modified
	 * @throws InvalidDataException
	 * @throws CommunicationProblemException
	 * @throws DeslogedException
	 */
	public CorporationData corporationUpdate(CorporationData data,UserSessionData userSessionData) throws Exception{

		if (userSessionData == null) {
			throw new DeslogedException("corporationUpdate","generic.error.notuserlogged");
		}
		if (data == null) {
			throw new InvalidDataException("corporationUpdate","generic.error.emptydata");
		}
		if (!validate(data)) {
			throw new InvalidDataException("corporationUpdate","generic.error.invaliddata");
		}
		CorporationABM crpABM=null;
		try {

			CorporationABMHome home = CorporationABMUtil.getHome();
			crpABM = home.create();
			return crpABM.corporationUpdate(data, userSessionData);
        } catch (Exception e) {
        	Object[] parameters = new Object[1];
        	parameters[0] = data;
            handler.handleException("corporationUpdate",e,userSessionData,parameters);
        }
        return null;
	}

