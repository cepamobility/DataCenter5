	}

	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,eventcreate"
   	 * Create driver account
     * @throws Exception
   	 */
	public void addEvent(EventDataType event, UserSessionData userSessionData) throws Exception {
		Collection<PointMoveData> moves = new LinkedList<PointMoveData>();
		Calendar c = Calendar.getInstance();
		c.setTime(event.getDate());

		boolean added = false;
		CorporationReport corporationReport = CorporationReportUtil.getHome().create();
		PointAccountData driverAccount = corporationReport.getPointAccount(PointAccountData.DRIVER, event.getDriver().getId(), userSessionData);
		boolean isEvitable = event.getEvitability().equals("generic.messages.yes");
		switch(userSessionData.getCorporationId()) {
			case CorporationData.BAYER_MX:
				if(isEvitable) {
					String[] keys = {PointsDefinitionData.EVENTO_EVITABLE_FATAL,PointsDefinitionData.EVENTO_EVITABLE_FATAL_COSTO,PointsDefinitionData.EVENTO_EVITABLE_LESION,PointsDefinitionData.EVENTO_EVITABLE_LESION_COSTO,PointsDefinitionData.EVENTO_EVITABLE,PointsDefinitionData.EVENTO_EVITABLE_COSTO,
							PointsDefinitionData.TWO_ACCIDENT_YEAR,PointsDefinitionData.THREE_ACCIDENT_YEAR, PointsDefinitionData.EVENTO_EVITABLE_MENORCOSTO};
					HashMap<String,PointsDefinitionData> definitions = corporationReport.getPointsDefinition(keys,userSessionData);
					PointsDefinitionData definition = null;
					if(event.hasDeceased()) {
						if(event.getCost() != null && event.getCost() >= 50000) {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE_FATAL_COSTO);
						}else {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE_FATAL);
						}
					} else if(event.hasInjured()) {
						if(event.getCost() != null && event.getCost() >= 50000) {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE_LESION_COSTO);
						}else {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE_LESION);
						}
					} else {
						if(event.getCost() != null && event.getCost() >= 50000) {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE_COSTO);
						}else if(event.getCost() != null && event.getCost() > 5000) {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE);
						}else {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE_MENORCOSTO);
						}
					}
					definition.pound(event.getAge(),userSessionData.getCorporationId());
					moves.add(new PointMoveData(definition,c,String.valueOf(event.getId())));
					PointMoveData price = corporationReport.eventAward(event.getDate(), driverAccount.getId(), userSessionData);
					if(price != null) {
						moves.add(price);
					}
					added = true;

					Calendar cal = Calendar.getInstance();
					cal.add(Calendar.YEAR, -1);
					Integer count = corporationReport.getMoveCount(event.getDriver().getId(), c, PointsDefinitionData.CATEGORY_ACCIDENT, userSessionData);
					double total = driverAccount.getTotal() + definition.getAmount();
					if(count >= 2 && total < 50) {
						definition = definitions.get(PointsDefinitionData.THREE_ACCIDENT_YEAR);
						PointMoveData move = new PointMoveData(definition,Calendar.getInstance(),Util.formatDate(Calendar.getInstance().getTime()));
						move.setAmount(50.0-total);
						moves.add(move);
					} else if(count == 1 && driverAccount.getTotal() < 30) {
						definition = definitions.get(PointsDefinitionData.TWO_ACCIDENT_YEAR);
						PointMoveData move = new PointMoveData(definition,Calendar.getInstance(),Util.formatDate(Calendar.getInstance().getTime()));
						move.setAmount(30.0-total);
						moves.add(move);
					}
				}
				break;
			case CorporationData.MONTES_DE_PLATA:
				if(isEvitable) {
					String[] keys1 = {PointsDefinitionData.ATROPELLAMIENTO, PointsDefinitionData.VUELCO, PointsDefinitionData.COLISION_FRONTAL, PointsDefinitionData.COLISION_LATERAL, PointsDefinitionData.COLISION_TRASERA, PointsDefinitionData.COLISION_TRANSVERSAL, PointsDefinitionData.OBJETO_FIJO, PointsDefinitionData.COLISION_ANIMAL};
					HashMap<String,PointsDefinitionData> definitions1 = corporationReport.getPointsDefinition(keys1,userSessionData);
					PointsDefinitionData clasification = null;
					Iterator<PointsDefinitionData> it = definitions1.values().iterator();
					if(event.getClasification3() != null) {
						String eventClasification = event.getClasification3().getResourceBundleId();
						while(it.hasNext()) {
							PointsDefinitionData definition = it.next();
							if(definition.getReference().equals(eventClasification) || definition.getDescription().equals(eventClasification)) {
								if(clasification == null || clasification.getAmount() < definition.getAmount()) {
									clasification = definition;
								}
							}
						}
					}
					if(clasification != null) {
						moves.add(new PointMoveData(clasification,c,String.valueOf(event.getId())));
					}

					String[] keys2 = {PointsDefinitionData.FATAL_ACCIDENT, PointsDefinitionData.INJURED_ACCIDENT, PointsDefinitionData.ACCIDENT_WITH_DAMAGE, PointsDefinitionData.ACCIDENT_WITH_ENVIRONMENT_DAMAGE};
					HashMap<String,PointsDefinitionData> definitions2 = corporationReport.getPointsDefinition(keys2,userSessionData);
					if(definitions2.containsKey(PointsDefinitionData.FATAL_ACCIDENT) && event.hasDeceased()) {
						PointsDefinitionData definition = definitions2.get(PointsDefinitionData.FATAL_ACCIDENT);
						moves.add(new PointMoveData(definition,c,String.valueOf(event.getId())));
						added = true;
					}
					if(!added && event.hasInjured() && definitions2.containsKey(PointsDefinitionData.INJURED_ACCIDENT)) {
						PointsDefinitionData definition = definitions2.get(PointsDefinitionData.INJURED_ACCIDENT);
						moves.add(new PointMoveData(definition,c,String.valueOf(event.getId())));
						added = true;
					}
					if(!added && event.isDamage() && definitions2.containsKey(PointsDefinitionData.ACCIDENT_WITH_DAMAGE)) {
						PointsDefinitionData definition = definitions2.get(PointsDefinitionData.ACCIDENT_WITH_DAMAGE);
						moves.add(new PointMoveData(definition,c,String.valueOf(event.getId())));
						added = true;
					}
					if(!added && event.isDoubleCabin() && definitions2.containsKey(PointsDefinitionData.ACCIDENT_WITH_ENVIRONMENT_DAMAGE)) {
						PointsDefinitionData definition = definitions2.get(PointsDefinitionData.ACCIDENT_WITH_ENVIRONMENT_DAMAGE);
						moves.add(new PointMoveData(definition,c,String.valueOf(event.getId())));
					}
				}
				break;
			default:
				if(event.getEvitability().equals("generic.messages.yes")) {
					String[] keys = {PointsDefinitionData.FATAL_ACCIDENT,PointsDefinitionData.INJURED_ACCIDENT_WLOSTDAY,PointsDefinitionData.ACCIDENT_WITH_DAMAGE,PointsDefinitionData.ACCIDENT};
					HashMap<String,PointsDefinitionData> definitions = corporationReport.getPointsDefinition(keys,userSessionData);

					if(definitions.containsKey(PointsDefinitionData.FATAL_ACCIDENT) && event.hasDeceased()) {
						PointsDefinitionData definition = definitions.get(PointsDefinitionData.FATAL_ACCIDENT);
						definition.pound(event.getAge(),userSessionData.getCorporationId());
						moves.add(new PointMoveData(definition,c,String.valueOf(event.getId())));
						added = true;
					}
					if(!added && event.hasDaysLost()) {
						if(definitions.containsKey(PointsDefinitionData.INJURED_ACCIDENT_WLOSTDAY)) {
							PointsDefinitionData definition = definitions.get(PointsDefinitionData.INJURED_ACCIDENT_WLOSTDAY);
							definition.pound(event.getAge(),userSessionData.getCorporationId());
							moves.add(new PointMoveData(definition,c,String.valueOf(event.getId())));
							added = true;
						}
					}
					if(!added) {
						Calendar eventDate = Calendar.getInstance();
						eventDate.setTime(event.getDate());
						if(eventDate.get(Calendar.YEAR) <= 2015) {
							if(!added && event.getAccident().getResourceBundleId().equals("datatype.accidentclasification.tumble") || event.getAccident().getResourceBundleId().equals("datatype.accidentclasification.rollover")){
								if(definitions.containsKey(PointsDefinitionData.ACCIDENT_WITH_DAMAGE)) {
									PointsDefinitionData definition = definitions.get(PointsDefinitionData.ACCIDENT_WITH_DAMAGE);
									definition.pound(event.getAge(),userSessionData.getCorporationId());
									moves.add(new PointMoveData(definition,c,String.valueOf(event.getId())));
									added = true;
								}
							}
							if(!added && definitions.containsKey(PointsDefinitionData.ACCIDENT)) {
								PointsDefinitionData definition = definitions.get(PointsDefinitionData.ACCIDENT);
								definition.pound(event.getAge(),userSessionData.getCorporationId());
								moves.add(new PointMoveData(definition,c,String.valueOf(event.getId())));
							}
						}else {
							if(event.getClasification4() != null && event.isDamage()) {
								PointsDefinitionData definition = corporationReport.getPointsDefinitions(PointsDefinitionData.NEW_ACCIDENT_WITH_DAMAGE, event.getClasification4().getResourceBundleId(), userSessionData);
								if(definition != null) {
									definition.pound(event.getAge(),userSessionData.getCorporationId());
									moves.add(new PointMoveData(definition,c,String.valueOf(event.getId())));
								}
							}
						}
					}
				}
				break;
		}
		if(moves.size() > 0) {
			addMoves(driverAccount, moves, userSessionData);
		}
	}


	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,eventcreate"
   	 * Create driver account
