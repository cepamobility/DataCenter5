				if(definitions2.containsKey(PointsDefinitionData.FATAL_ACCIDENT) && event.hasDeceased()) {
					consequence = definitions2.get(PointsDefinitionData.FATAL_ACCIDENT);
				}
				if(consequence == null && event.hasInjured() && definitions2.containsKey(PointsDefinitionData.INJURED_ACCIDENT)) {
					consequence = definitions2.get(PointsDefinitionData.INJURED_ACCIDENT_WLOSTDAY);
				}
				if(consequence == null &&  event.isDamage() && definitions2.containsKey(PointsDefinitionData.ACCIDENT_WITH_DAMAGE)) {
					consequence = definitions2.get(PointsDefinitionData.ACCIDENT_WITH_DAMAGE);
				}
			}
