			Collection moves = corporationReport.getPointMoves(driverAccount.getId(),userSessionData);
			Iterator it = moves.iterator();

			while(it.hasNext()) {
				PointMoveData move = (PointMoveData) it.next();
				if(Integer.parseInt(move.getReference()) == event.getId().intValue()) {
					if(move.getDefitionName())
				}
			}*/

		}else {
			if(userSessionData.isCorporation(CorporationData.BAYER_MX)) {
				String[] keys = {PointsDefinitionData.EVENTO_NOEVITABLE,PointsDefinitionData.EVENTO_EVITABLE_FATAL,PointsDefinitionData.EVENTO_EVITABLE_FATAL_COSTO,PointsDefinitionData.EVENTO_EVITABLE_LESION,PointsDefinitionData.EVENTO_EVITABLE_LESION_COSTO,PointsDefinitionData.EVENTO_EVITABLE,PointsDefinitionData.EVENTO_EVITABLE_COSTO,PointsDefinitionData.EVENTO_EVITABLE_MENORCOSTO};
				HashMap<String,PointsDefinitionData> definitions = corporationReport.getPointsDefinition(keys,userSessionData);
				if(event.getEvitability().equals("generic.messages.yes")) {
					if(event.hasDeceased()) {
						if(event.getCost() != null && event.getCost() >= 50000) {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE_FATAL_COSTO);
						}else {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE_FATAL);
						}
					} else if(event.hasInjured()) {
						if(event.getCost() != null && event.getCost() >= 50000) {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE_LESION_COSTO);
						}else {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE_LESION);
						}
					} else {
						if(event.getCost() != null && event.getCost() >= 50000) {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE_COSTO);
						}else if(event.getCost() != null && event.getCost() > 5000) {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE);
						}else {
							definition = definitions.get(PointsDefinitionData.EVENTO_EVITABLE_MENORCOSTO);
						}
					}
				}
			}else {
				if(event.getEvitability().equals("generic.messages.yes")) {
					String[] keys = {PointsDefinitionData.FATAL_ACCIDENT,PointsDefinitionData.INJURED_ACCIDENT_WLOSTDAY,PointsDefinitionData.ACCIDENT_WITH_DAMAGE,PointsDefinitionData.ACCIDENT};
					HashMap<String,PointsDefinitionData> definitions = corporationReport.getPointsDefinition(keys,userSessionData);
					if(definitions.containsKey(PointsDefinitionData.FATAL_ACCIDENT) && event.hasDeceased()) {
						definition = definitions.get(PointsDefinitionData.FATAL_ACCIDENT);
					}
					if(definition == null && event.hasDaysLost()) {
						if(definitions.containsKey(PointsDefinitionData.INJURED_ACCIDENT_WLOSTDAY)) {
							definition = definitions.get(PointsDefinitionData.INJURED_ACCIDENT_WLOSTDAY);
						}
					}
					if(definition == null) {
						Calendar eventDate = Calendar.getInstance();
						eventDate.setTime(event.getDate());
						if(eventDate.get(Calendar.YEAR) <= 2015) {
							if(definition == null && definitions.containsKey(PointsDefinitionData.ACCIDENT_WITH_DAMAGE)) {
								definition = definitions.get(PointsDefinitionData.ACCIDENT_WITH_DAMAGE);
							}
							if(definition == null && definitions.containsKey(PointsDefinitionData.ACCIDENT)) {
								definition = definitions.get(PointsDefinitionData.ACCIDENT);
							}
						}else {
							if(event.getClasification4() != null && event.isDamage()) {
								definition = corporationReport.getPointsDefinitions(PointsDefinitionData.NEW_ACCIDENT_WITH_DAMAGE, event.getClasification4().getResourceBundleId(), userSessionData);
							}
						}
					}
				}
			}
			PointAccountData driverAccount = corporationReport.getPointAccount(PointAccountData.DRIVER, event.getDriver().getId(), userSessionData);
			PointMoveData move = corporationReport.getPointMove(driverAccount.getId(),String.valueOf(event.getId()),null,userSessionData);
			Calendar c = Calendar.getInstance();
			c.setTime(event.getDate());
			if(move == null) {
				if(definition != null) {
					Collection<PointMoveData> moves = new LinkedList<PointMoveData>();
					definition.pound(event.getAge(),userSessionData.getCorporationId());
					moves.add(new PointMoveData(definition,c,String.valueOf(event.getId())));
					addMoves(driverAccount, moves, userSessionData);
				}
			}else {
				if(definition == null) {
					removeMove(driverAccount,move,userSessionData);
				}else if (definition.getId().intValue() != move.getDefinition().intValue()){
					removeMove(driverAccount,move,userSessionData);
					Collection<PointMoveData> moves = new LinkedList<PointMoveData>();
					definition.pound(event.getAge(),userSessionData.getCorporationId());
					moves.add(new PointMoveData(definition,c,String.valueOf(event.getId())));
					addMoves(driverAccount, moves, userSessionData);
				}
			}
		}
	}

	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,eventcreate,cepascheduleactivitycreate,cepascheduleactivityupdate,jjreporter"
   	 * Create driver account
     * @throws Exception
   	 */
	public void addActivity(CEPAActivityScheduleData activity, UserSessionData userSessionData) throws Exception {
		CorporationReport corporationReport = CorporationReportUtil.getHome().create();
		PointsDefinitionData definition = corporationReport.getPointsDefinitions(PointsDefinitionData.ACTIVITY, activity.getType().getResourceBundleId(), userSessionData);

		if(definition != null || userSessionData.isCorporation(CorporationData.BAYER_MX)) {
			ActivityReport activityReport = ActivityReportUtil.getHome().create();
			Object[][] registries = activityReport.getParticipantsRegistry(activity.getActivityId(), userSessionData);
			for(int i = 0; i < registries.length; i++) {
				Integer driver = (Integer) registries[i][4];
				String note = (String) registries[i][3];
				if(definition != null) {
					Collection<PointMoveData> moves = new LinkedList<PointMoveData>();

					if(userSessionData.isCorporation(CorporationData.BAYER_MX) && activity.isType(CEPAActivityConstants.REPORTERJJ_COMMENTARYDRIVE)) {
						Calendar c = Calendar.getInstance();
						c.setTime(activity.getDate());
						if(c.get(Calendar.MONTH) > 5) {
							definition.setAmount(-10.0);
						}
					}
					PointAccountData driverAccount = corporationReport.getPointAccount(PointAccountData.DRIVER, driver, userSessionData);
					PointMoveData move = corporationReport.getPointMove(driverAccount.getId(),String.valueOf(activity.getActivityId()),definition.getId(),userSessionData);
					if(move != null) {
						if(definition.getCondition() != null && !note.equals("generic.activity.note.approved") && !note.equals("generic.activity.note.approvedwithobservations")) {
							removeMove(driverAccount,move,userSessionData);
							driverAccount.sum(move.getAmount()*-1, userSessionData.getCorporationId());
						}
					} else {
						if(definition.getCondition() == null || note.equals("generic.activity.note.apruved") || note.equals("generic.activity.note.apruvedwithobservations")) {
							definition.pound(activity.getAge(),userSessionData.getCorporationId());
							Calendar c = Calendar.getInstance();
							c.setTime(activity.getDate());
							moves.add(new PointMoveData(definition,c,String.valueOf(activity.getActivityId())));
						}
						if(moves.size() > 0) {
							addMoves(driverAccount, moves, userSessionData);
						}
					}
				}
				if(userSessionData.isCorporation(CorporationData.BAYER_MX)) {
					String activityDefinition = activity.getDefinition().getResourceKeyName();
					if((activityDefinition.equals(CEPAActivityConstants.BTW1) || activityDefinition.equals(CEPAActivityConstants.BTW2)
							 || activityDefinition.equals(CEPAActivityConstants.BTWONBOARD) || activityDefinition.equals(CEPAActivityConstants.BTW1_NEW_FORM_TABLET)
							 || activityDefinition.equals(CEPAActivityConstants.BTW1ONBOARD_TABLET) || activityDefinition.equals(CEPAActivityConstants.BTWPLUS1ONBOARD_TABLET)
							 || activityDefinition.equals(CEPAActivityConstants.HRD) || activityDefinition.equals(CEPAActivityConstants.PHRD_TABLET) || activityDefinition.equals(CEPAActivityConstants.REPORTERJJ_COMMENTARYDRIVE)
							 || activityDefinition.equals(CEPAActivityConstants.FEEDBACK_LINE_MANAGER)) && !note.equals("generic.activity.note.practicepending")){
						DriverABMUtil.getHome().create().completeMitigationPlanActiviy(driver,activityDefinition,activity.getDate(),userSessionData);
					}
				}
			}
		}
		if( userSessionData.isCorporation(CorporationData.BAYER_MX)){
			ActivityReport activityReport = ActivityReportUtil.getHome().create();
			Object[][] registries = activityReport.getParticipantsRegistry(activity.getActivityId(), userSessionData);
			for(int i = 0; i < registries.length; i++) {
				Integer driver = (Integer) registries[i][4];
				boolean result=((String)registries[i][3]).equals(CEPAActivityConstants.APRUVED) || ((String)registries[i][3]).equals(CEPAActivityConstants.WITHOUTNOTE);
				//Plan Anual
				String activityDefinition = activity.getDefinition().getResourceKeyName();
				DriverABMUtil.getHome().create().completeAnualPlanActivity(driver, activityDefinition, result, userSessionData);
			}
		}
	}

	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,eventcreate,cepascheduleactivitycreate,cepascheduleactivityupdate,jjreporter"
   	 * Create driver account
     * @throws Exception
   	 */
	public void addActivity(CEPAActivityScheduleData activity, Integer activityId, Integer driver, String note, Integer corporation, UserSessionData userSessionData) throws Exception {
		CorporationReport corporationReport = CorporationReportUtil.getHome().create();
		PointsDefinitionData definition = corporationReport.getPointsDefinitions(PointsDefinitionData.ACTIVITY, activity.getType().getResourceBundleId(), activity.getCorpooration().getId() , note, userSessionData);

		if(definition != null) {
			Collection<PointMoveData> moves = new LinkedList<PointMoveData>();

			PointAccountData driverAccount = corporationReport.getPointAccount(PointAccountData.DRIVER, driver, corporation, userSessionData);
			PointMoveData move = corporationReport.getPointMove(driverAccount.getId(),String.valueOf(activity.getActivityId()),definition.getId(),userSessionData);
			if(move != null) {
				if(definition.getCondition() != null && !note.equals("generic.activity.note.approved") && !note.equals("generic.activity.note.approvedwithobservations")) {
					removeMove(driverAccount,move,userSessionData);
					driverAccount.sum(move.getAmount()*-1, userSessionData.getCorporationId());
				}
			} else {
				if(definition.getCondition() == null || note.equals(definition.getCondition())) {
					Calendar c = Calendar.getInstance();
					c.setTime(activity.getDate());
					moves.add(new PointMoveData(definition,c,String.valueOf(activityId)));
				}
				if(moves.size() > 0) {
					addMoves(driverAccount, moves, userSessionData);
				}
			}
		}

	}

  	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,eventcreate,cepascheduleactivitycreate,cepascheduleactivityupdate"
   	 * Create driver account
     * @throws Exception
   	 */
	public void removeActivity(CEPAActivityScheduleData activity, UserSessionData userSessionData) throws Exception {
		try {
			CorporationReport corporationReport = CorporationReportUtil.getHome().create();
			PointsDefinitionData definition = corporationReport.getPointsDefinitions(PointsDefinitionData.ACTIVITY, activity.getType().getResourceBundleId(), userSessionData);

			if(definition != null) {
				ActivityReport activityReport = ActivityReportUtil.getHome().create();
				Object[][] registries = activityReport.getParticipantsRegistry(activity.getActivityId(), userSessionData);
				for(int i = 0; i < registries.length; i++) {
					Integer driver = (Integer) registries[i][4];
					PointAccountData driverAccount = corporationReport.getPointAccount(PointAccountData.DRIVER, driver, userSessionData);
					PointMoveData move = corporationReport.getPointMove(driverAccount.getId(),String.valueOf(activity.getActivityId()),definition.getId(),userSessionData);
					if(move != null) {
						removeMove(driverAccount,move,userSessionData);
						driverAccount.sum(move.getAmount()*-1, userSessionData.getCorporationId());
					}
				}
			}

		} catch (Exception e) {
			Object[] parameters = {activity};
    		handler.handleException("removeActivity",e,userSessionData,parameters);
		}
	}


   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,drivercreate,finecreate,drivercreatefine"
   	 * Create driver account
     * @throws Exception
   	 */
	public void addMove(Integer account, int points, String defintionType, String comment, UserSessionData userSessionData) throws Exception {
		addMove(Calendar.getInstance(),account,points,defintionType,comment,userSessionData);
	}
   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,drivercreate,finecreate,drivercreatefine"
   	 * Create driver account
     * @throws Exception
   	 */
	public void addMove(Calendar assignedDate,Integer account, int points, String defintionType, String comment, UserSessionData userSessionData) throws Exception {
		CorporationReport corporationReport = CorporationReportUtil.getHome().create();
		ArrayList<PointsDefinitionData> definitions = corporationReport.getPointsDefinitions(defintionType,userSessionData);
		if(definitions != null && definitions.size() > 0) {
			PointsDefinitionData definition = definitions.iterator().next();
			PointMoveData move = new PointMoveData(definition, assignedDate, comment);
			move.setAccount(account);
			move.setAmount(new Integer(points).doubleValue());
			CorporationABM corpABM = CorporationABMUtil.getHome().create();
			corpABM.savePointMove(move, userSessionData);

			PointAccountData driverAccount = corporationReport.getPointAccount(account, userSessionData);
			if(userSessionData.isCorporation(new int[] {CorporationData.BAYER_MX, CorporationData.MONTES_DE_PLATA})) {
				Collection<PointMoveData> moves = corporationReport.getPointMoves(account, userSessionData);
				moves.add(move);
				Collections.sort((List)moves);
				double sum = (userSessionData.isCorporation(CorporationData.MONTES_DE_PLATA)) ? 100.0 : 0.0;
				Iterator<PointMoveData> it = moves.iterator();
				while(it.hasNext()) {
					sum += it.next().getAmount();
					if(sum < 0)
						sum = 0.0;
					if(userSessionData.isCorporation(CorporationData.MONTES_DE_PLATA) && sum > 100)
						sum = 100.0;
				}
				driverAccount.setTotal(sum);
				corpABM.savePointAccount(driverAccount, userSessionData);
			} else {
				driverAccount.sum(new Integer(points).doubleValue(), userSessionData.getCorporationId());
				corpABM.savePointAccount(driverAccount, userSessionData);
			}
		}
	}

   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,drivercreate,finecreate,drivercreatefine"
   	 * Create driver account
     * @throws Exception
   	 */
	public void updateMove(Integer account, int difference, PointMoveData move, UserSessionData userSessionData) throws Exception {
		CorporationABM corpABM = CorporationABMUtil.getHome().create();
		corpABM.updatePointMove(move, userSessionData);
		PointAccountData driverAccount = CorporationReportUtil.getHome().create().getPointAccount(account, userSessionData);
		if(userSessionData.isCorporation(new int[] {CorporationData.BAYER_MX, CorporationData.MONTES_DE_PLATA})) {
			Collection<PointMoveData> baseMoves = CorporationReportUtil.getHome().create().getPointMoves(driverAccount.getId(), userSessionData);
			Collections.sort((List)baseMoves);
			double sum = (userSessionData.isCorporation(CorporationData.MONTES_DE_PLATA)) ? 100.0 : 0.0;
			Iterator<PointMoveData> it = baseMoves.iterator();
			while(it.hasNext()) {
				PointMoveData moveData = it.next();
				if(moveData.getId().intValue() == move.getId().intValue()) {
					sum += move.getAmount();
				}else {
					sum += moveData.getAmount();
				}
				if(sum < 0)
					sum = 0.0;
				if(userSessionData.isCorporation(CorporationData.MONTES_DE_PLATA) && sum > 100)
					sum = 100.0;
			}
			driverAccount.setTotal(sum);
			corpABM.savePointAccount(driverAccount, userSessionData);
		} else {
			if(difference != 0) {
				driverAccount.sum(new Integer(difference).doubleValue(), userSessionData.getCorporationId());
				corpABM.savePointAccount(driverAccount, userSessionData);
			}
		}
	}

