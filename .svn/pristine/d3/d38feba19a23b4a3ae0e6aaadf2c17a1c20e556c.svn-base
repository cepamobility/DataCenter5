<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">


<hibernate-mapping package="persistence.administration.corporation.tables" >

	<class name="PointsDefinition" table="pointsdefinitions">
		<id column="id" name="id" type="java.lang.Integer">
            <generator class="sequence">
            	<param name="sequence">PointsDefinitions_Sequence</param>
            </generator>
		</id>
	  
	    <property name="type"	column="type" type="java.lang.String" not-null="true" />
	    <property name="amount"	column="value" type="java.lang.Double" not-null="true" />
	    <property name="corporationId"	column="corporationId" type="java.lang.Integer" />
	    <property name="reference"	column="reference" type="java.lang.String" not-null="true" />
	    <property name="condition"	column="condition" type="java.lang.String" />
	   	<property name="description"	column="description" type="java.lang.String" not-null="true" />
		<property name="description2"	column="description2" type="java.lang.String"/>
		<property name="category"	column="category" type="java.lang.Integer"/>
		
  	</class>
</hibernate-mapping>
