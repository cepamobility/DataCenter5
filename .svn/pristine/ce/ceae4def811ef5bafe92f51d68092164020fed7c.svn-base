package business.ws.client.activity;

import java.io.Serializable;
import java.util.Date;

public class WSLCEPAActivityScheduleRegistryData implements Serializable {

	private static final long serialVersionUID = 1L;
	
	private Date fecha;
	private Integer id;
	private String note;
	private String type;
	
	public WSLCEPAActivityScheduleRegistryData(){}

	public Date getFecha() {
		return fecha;
	}

	public void setFecha(Date fecha) {
		this.fecha = fecha;
	}

	public Integer getId() {
		return id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public String getNote() {
		return note;
	}

	public void setNote(String note) {
		this.note = note;
	}

	public String getType() {
		return type;
	}

	public void setType(String type) {
		this.type = type;
	}

	
	
}
