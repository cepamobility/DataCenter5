package business.ws.client.common;

import java.io.Serializable;

import business.ws.client.vehicle.WSLVehicleStatusData;


public class ListWSLVehicleStatusDataResult implements Serializable {

	private static final long serialVersionUID = 1L;
	
	private WSLVehicleStatusData[] elements;
	private int total;
	
	public ListWSLVehicleStatusDataResult(){
		
	}

	public WSLVehicleStatusData[] getElements() {
		return elements;
	}

	public void setElements(WSLVehicleStatusData[] elements) {
		this.elements = elements;
	}

	public int getTotal() {
		return total;
	}

	public void setTotal(int total) {
		this.total = total;
	}

}
