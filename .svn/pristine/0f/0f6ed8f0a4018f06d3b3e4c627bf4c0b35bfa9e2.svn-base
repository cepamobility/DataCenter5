package communication.alert;

import java.io.Serializable;

import communication.datatype.tables.AlertTypeDataType;

public class AlertExtraInformationData implements Serializable  {
	private AlertTypeDataType type;
	private String value;
	private Integer id;

	public AlertExtraInformationData(Integer id,AlertTypeDataType type,String value) {
		this.type =type;
		this.value=value;
		this.id=id;
	}
	
	public Integer getId() {
		return id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public AlertTypeDataType getType() {
		return type;
	}

	public void setType(AlertTypeDataType type) {
		this.type = type;
	}

	public String getValue() {
		return value;
	}

	public void setValue(String value) {
		this.value = value;
	}

	public AlertExtraInformationData() {

	}

}
