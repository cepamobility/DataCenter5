    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate"
     */
    public void deleteProvisionalBTW(Integer driver,Date expiry,UserSessionData userSessionData) throws Exception {
        try{
            Session session=HibernateUtil.currentSession();
            
            Query query=session.createQuery("select p from ProvisionalBTW as p where p.pk.driver="+driver);
            
            List result= query.list();
            Iterator iter=result.iterator();
            boolean deleted=false;
            while(iter.hasNext() && !deleted){
            	ProvisionalBTW pbtw=(ProvisionalBTW)iter.next();
            	
            	if(pbtw.getDate().getYear()==expiry.getYear() && pbtw.getDate().getMonth()==expiry.getMonth() && pbtw.getDate().getDay()==expiry.getDay()){
            		deleted=true;
            		query=session.createQuery("Delete from ProvisionalBTW as p where p.pk.driver=(:idDriver) and p.pk.expiry=(:expiry) ");
            		query.setParameter("idDriver",pbtw.getPk().getDriver() );
            		query.setParameter("expiry", pbtw.getPk().getExpiry());
            		query.executeUpdate();
            	}
            }
            
            Date btwDate=Calendar.getInstance().getTime();
            ProvisionalBTWLog log = new ProvisionalBTWLog(driver,expiry,Calendar.getInstance().getTime(),userSessionData.getFilter().getLoginName(),"",LogActions.DELETE,btwDate);
            session.save(log);

        }catch(Exception e) {
			Object[] parameters = {driver,expiry};
            handler.getException(e,"deleteProvisionalBTW",userSessionData,parameters);
        }
    }
    
