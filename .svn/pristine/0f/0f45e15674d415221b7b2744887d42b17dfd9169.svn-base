    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate,drivertests"
     */
    public void deleteDriverPrize(Integer driverId, String date, UserSessionData userSessionData) throws Exception {
        try{
            Session session=HibernateUtil.currentSession();
            DriverPrize prize = (DriverPrize)session.load(DriverPrize.class, new DriverPrizePK(driverId,date));
            session.delete(prize);
        }catch(Exception e) {
