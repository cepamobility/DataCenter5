	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,driverupdate,driverupdateowndata,driverbayerdata"
	 * @param data
	 * @param userRequest
	 */        			
	public void driverUpdate(DriverData data, UserSessionData userSessionData, String comment, int action) throws Exception {
	    try{
	        Session session=HibernateUtil.currentSession();
            if(userSessionData.isDriver() && !data.getId().equals(userSessionData.getDriverData().getId())) {
                throw new InvalidDataException("driverUpdate","user driver wrong id");
            }
	        validate(data,userSessionData,"update");

	        if (data.getId() != null){
	        	Driver driver = (Driver)session.load(Driver.class,data.getId());
	        	if(userSessionData.isCorporation(new int[] {CorporationData.MONSANTO,CorporationData.BAYER}) && driver.isBrasilCountry()) {
		        	boolean exclude = false;
		        	boolean include = false;
		        	boolean changeVehicle = false;
		        	boolean changeObs = false;
	        		if(userSessionData.isCorporation(CorporationData.MONSANTO)) {
	        			changeVehicle = changeVehicleAllowed(driver,data);
	        			changeObs = changeVehicleAllowedObs(driver,data);
	        		}
	        		exclude = data.getExclusionDate() != null && driver.getExclusionDate() == null;
	        		include = data.getExclusionDate() == null && driver.getExclusionDate() != null;
//	        		if(changeVehicle || changeObs|| exclude || include) 
//		        		changeDriverEmail(changeVehicle,exclude,include,data,driver,userSessionData);
	        		if(changeVehicle && data.getVehicleAllowed().getResourceBundleId().equals(TypeVehicle.NO_VEHICLE) && data.getEmail() != null) {
	        			sendDriverChange(data, userSessionData);
	        		}
	        	}
	        	driver.updateData(data);
	        	session.update(driver);
		
	        	DriverLog log = new DriverLog(driver,userSessionData.getFilter().getLoginName(),new Date(),action,comment);
	        	session.save(log);
	        }
	        
	    } catch (Exception e) {
			Object[] parameters = {data,comment,action};
            handler.getException(e,"driverUpdate",userSessionData,parameters);
	    }
	}
	
	private boolean changeVehicleAllowed(Driver driver, DriverData driverData) {
		boolean change = false;
		try {
			if(driver.getVehicleAllowed() == null && driverData.getVehicleAllowed() == null)
				change = false;
			else if(driver.getVehicleAllowed() == null && driverData.getVehicleAllowed() != null)
				change = true;
			else if(driver.getVehicleAllowed() != null && driverData.getVehicleAllowed() == null)
				change = true;
			else
				change = !driver.getVehicleAllowed().getResourceBundleId().equals(driverData.getVehicleAllowed().getResourceBundleId());
		}catch (Exception e) {
			e.printStackTrace();
		}
		return change;
	}

	private boolean changeVehicleAllowedObs(Driver driver, DriverData driverData) {
		boolean change = false;
		try {
			change = !String.valueOf(driver.getLicenseObs()).equals(String.valueOf(driverData.getLicenseObs()));
		}catch (Exception e) {
			e.printStackTrace();
		}
		return change;
	}

	private void changeDriverEmail(boolean changeVehicle,boolean exclude,boolean include, DriverData data, Driver driver, UserSessionData userSessionData) {
		MailSender sender = new MailSender();
		try {
			boolean sended = false;
			int count = 0;
			Collection<String> to = new LinkedList<String>();
			if(SecurityConstants.isProductionServer()) {
				to.add(AlertConstants.EMAIL_CRIS);
			}else {
				to.add(AlertConstants.EMAIL_JUAN);
			}
			while(!sended && count < 10) {
				try {
					sended = sender.sendImageMandrill(to, "CEPA DataCenter", AlertConstants.EMAIL_SUPPORT, "Mudança Condutor", AlertConstants.getBodyChangeDriver(changeVehicle,exclude,include,data,driver,userSessionData.getCorporationId()), new LinkedList<String>(), new LinkedList<String>(), AlertConstants.EMAIL_SUPPORT, "CEPA DataCenter", new LinkedList<String>(), null);
				}catch (Exception e) {
					e.printStackTrace();
				}
				count++;
			}

		}catch (Exception e) {
			e.printStackTrace();
		}
		
	}

	public void sendDriverChange(DriverData driver, UserSessionData userSessionData) {
		String body = "<p>Prezado , boa tarde!</p>" +
				"<p></p>" +
				"<p>Você consta no Data Center como condutor Monsanto, porém na última atualização enviada pela empresa não foi informado o tipo de veículo que você está autorizado a dirigir.<p>" +
				"<p></p>"+
				"<p>Por favor, nos confirmar se devemos considerar veículo de passeio, pick up S10, reboque, Caminhão, ônibus, etc... para atualização de dados e verificação das datas de renovação dos treinamentos necessários.</p>"+
				"<p></p>"+
				"<p>As respostas tem que ser encaminhadas ao monsanto_atualizacao@cepadc.com</p>"+
				"<p></p>"+
				"<p>Atenciosamente.</p>";
		body = Util.toHTMLString(body);
		try {
			boolean sended = false;
			int count = 0;
			Collection<String> to = new LinkedList<String>();
			if(SecurityConstants.isProductionServer()) {
				to.add(driver.getEmail());
			}else {
				to.add(AlertConstants.EMAIL_JUAN);
			}
			MailSender sender = new MailSender();
			while(!sended && count < 0/*10*/) {
				try {
					sended = sender.sendImageMandrill(to, "CEPA DataCenter", "monsanto_atualizacao@cepadc.com", "Treinamento de Direção Defensiva - atualização base de dados", body, new LinkedList<String>(), new LinkedList<String>(), "monsanto_atualizacao@cepadc.com", "CEPA DataCenter", new LinkedList<String>(), null);
				}catch (Exception e) {
					e.printStackTrace();
				}
				count++;
			}

		}catch (Exception e) {
			e.printStackTrace();
		}
	}
	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,driverupdate,driverupdateowndata,driverbayerdata"
	 * @param data
	 * @param userRequest
	 */        			
	public void driverUpdateForestales(DriverData data, Integer divorg, UserSessionData userSessionData, String comment, int action) throws Exception {
	    try{
	        Session session=HibernateUtil.currentSession();
            if(userSessionData.isDriver() && !data.getId().equals(userSessionData.getDriverData().getId())) {
                throw new InvalidDataException("driverUpdate","user driver wrong id");
            }
	        validate(data,userSessionData,"update");

	        if (data.getId() != null){
	        	Driver driver = (Driver)session.load(Driver.class,data.getId());
	        	driver.updateDataForestal(data);
	        	if(divorg != null) {
	        		DivOrgItemLevel1 divorgItem = (DivOrgItemLevel1)session.load(DivOrgItemLevel1.class, divorg);
	        		if(driver.getCorporation().getId().intValue() == CorporationData.WEYERHAEUSER) {
	        			driver.setDivOrg3(divorgItem);
	        		}else {
	        			driver.setDivOrg1(divorgItem);
	        		}
	        	}
	        	session.update(driver);
		
	        	DriverLog log = new DriverLog(driver,userSessionData.getFilter().getLoginName(),new Date(),action,comment);
	        	session.save(log);
	        }
	        
	    } catch (Exception e) {
			Object[] parameters = {data,comment,action};
            handler.getException(e,"driverUpdate",userSessionData,parameters);
	    }
	}
	
