	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,driverdelete" 
	 * @param data
	 * @param userRequest
	 */
	public void driverDelete(DriverData data, UserSessionData userRequest,String comment) throws Exception {
	    try{
	        Session session=HibernateUtil.currentSession();
            validate(data,userRequest,"delete");

	        Driver driver =null;
	        driver=(Driver)session.load(Driver.class, data.getId());
		    
	        DriverLog log = new DriverLog(driver,userRequest.getFilter().getLoginName(),new Date(),LogActions.DELETE,comment);
	        session.save(log);
	     
	        session.delete(driver);                                                                                                                                                     
            		
	    }catch(Exception e) {
			Object[] parameters = {data,comment};
            handler.getException(e,"driverDelete",userRequest,parameters);
	    }
	}
	
	
	/**
	 * @param data
	 * @return null if is valid, String with message if is invalid
	 */
	
	private void validate(DriverData data,UserSessionData userSession,String function) throws Exception {
        if (userSession == null) {
            throw new DeslogedException("Session data is empty","generic.error.deslogued");
        }
        if (data == null) {
            throw new InvalidDataException("User data is empty","generic.user.userdata.isempty");
        }
        if(function.equals("delete")) {
            if (data.getId() == null) {
                throw new InvalidDataException("Class persistence.driver.DriverABM(driverDelete), primary key is empty","persistence.driver.driverdata.primarykey.isempty");
            }
        }else {
    		int driverCorporation = data.getCorporation().getId();
            if (data.getFirstName() == null || data.getFirstName().trim().length() == 0) {
                throw new InvalidDataException("Class persistence.driver.DriverABM, invalid driver data","generic.driver.driverdata.firstNameInvalid");
            }
            if (data.getLastName() == null || data.getLastName().trim().length() == 0) {
                throw new InvalidDataException("Class persistence.driver.DriverABM, invalid driver data","generic.driver.driverdata.lastNameInvalid");
            }
            if (data.getBirthDate() == null) {
                throw new InvalidDataException("Class persistence.driver.DriverABM, invalid driver data","generic.driver.driverdata.birthDateInvalid");
            }
            if ((data.getSex() == null) || (data.getSex().getResourceBundleId() == null)){
                throw new InvalidDataException("Class persistence.driver.DriverABM, invalid driver data","generic.driver.driverdata.sexInvalid");
            }
            if (data.getCountry() == null) {
                throw new InvalidDataException("Class persistence.driver.DriverABM, invalid driver data","generic.driver.driverdata.countryInvalid");
            }

            if(data.getCorporation()==null){
                throw new InvalidDataException("Class persistence.driver.DriverABM, invalid driver data","generic.driver.driverdata.corporationInvalid");
            }
            
    		if(driverCorporation != CorporationData.FORESTALORIENTAL &&
    				driverCorporation != CorporationData.WEYERHAEUSER &&
    				driverCorporation != CorporationData.MONTES_DE_PLATA) {
	            if(!userSession.isDriver()) {
	                Iterator divOrgsIterator = data.getDivOrgsIterator();
	                if(divOrgsIterator == null) {
	                    throw new InvalidDataException("Class persistence.driver.DriverABM, invalid driver data","generic.driver.driverdata.divorgInvalid");
	                }else {
	                    String message = Validate.validateDivOrg(data.getDivOrgsIterator(),userSession);
	                    if(message != null) {
	                        throw new InvalidDataException("Class persistence.driver.DriverABM, invalid driver data",message);
	                    }
	                }
	                if(!Validate.validateDivGeo(data.getCountry(),userSession)) {
	                    throw new InvalidDataException("Class persistence.driver.DriverABM, invalid driver data","generic.driver.driverdata.divgeoInvalid");
	                }
	            }
	        }
		}
	}

