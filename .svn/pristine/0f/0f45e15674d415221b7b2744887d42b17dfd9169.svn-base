    /**
     * Init transaction
     * @ejb.create-method
     * @ejb.permission role-name = "administrator,driverupdate,driverdelete,drivercreate,drivertests,driverupdateowndata,doorcontrol,driverbayerdata,jjreporter"
     */
    public void ejbCreate() throws javax.ejb.CreateException { }

	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,drivercreate"
	 * @param data Driver that will be created 
	 * @param userRequest User logged
	 */
	public Integer driverCreate(DriverData data, UserSessionData userRequest, String comment) throws Exception {
		
		try{
            Session session=HibernateUtil.currentSession();			
            
            validate(data,userRequest,"create");
			
			Driver driver = new Driver(data);

            Integer id = (Integer)session.save(driver);
			driver.setId(id);
			
			DriverLog log = new DriverLog(driver,userRequest.getFilter().getLoginName(),new Date(),LogActions.CREATE,comment);
			session.save(log);
			
			if(driver.getCorporation().getId().equals(CorporationData.DPA)){
				LevelOfServiceDriverDPAData dataLevel=new LevelOfServiceDriverDPAData();
				dataLevel.setInspector(userRequest.getFullName());
				dataLevel.setDriverId(id);
				dataLevel.setDate(new Date());
				dataLevel.setStatus("A");
				dataLevel.setCorporationId(data.getCorporationId());
				dataLevel.setFirstName(data.getFirstName());
				dataLevel.setLastName(data.getLastName());
				dataLevel.setCelular(data.getSuperviser());
				dataLevel.setUf(data.getStateOrRegion());
				dataLevel.setCpf(data.getIdDallas());
				dataLevel.setRg(data.getBpsregistry());
				dataLevel.setBirthDate(data.getBirthDate());
				dataLevel.setVcnh(data.getLicenseExpiry());
				Iterator it = data.getDivOrgsIterator();
			    if(it.hasNext()) {
			        DivOrgData divOrg = (DivOrgData)it.next();
			        ItemData item1 = (ItemData)divOrg.getDivOrgLevels().getItemIterator().next();
			        while(item1.getSubItems() != null) {
			            item1 = (ItemData)item1.getSubItems().getItemIterator().next();
			        }
			        dataLevel.setFleet(item1.getId());
			    }
				    
				LevelOfServiceDriverDPA level=new LevelOfServiceDriverDPA(dataLevel);
				session.save(level);
			}
			
            return id;
		} catch (Exception e) {
			Object[] parameters = {data,comment};
            handler.getException(e,"driverCreate",userRequest,parameters);
        }
        return null;
	}
	
