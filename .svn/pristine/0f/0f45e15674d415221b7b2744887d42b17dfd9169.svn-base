	/**
	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivitycreate,cepascheduleactivityupdate,jjreporter"
	 * @param data Driver that will be created 
	 * @param userRequest User logged
	 */
	public void completeMitigationPlanActiviy(Integer driver, String activityDefinition, Date activityDate, UserSessionData userSessionData) throws Exception {
		try{
            Session session=HibernateUtil.currentSession();
            String activity = String.valueOf(MitigationPlanActivityData.BTW);
            if(activityDefinition.equals(CEPAActivityConstants.HRD) || activityDefinition.equals(CEPAActivityConstants.PHRD_TABLET)) {
            	activity = String.valueOf(MitigationPlanActivityData.HRD);
            } 
            if(activityDefinition.equals(CEPAActivityConstants.REPORTERJJ_COMMENTARYDRIVE)) {
            	activity = String.valueOf(MitigationPlanActivityData.MONITOR)+","+String.valueOf(MitigationPlanActivityData.SECOND_MONITOR);   	
            }
            if(activityDefinition.equals(CEPAActivityConstants.FEEDBACK_LINE_MANAGER)) {
            	activity = String.valueOf(MitigationPlanActivityData.FEEDBACK_LINE_MANAGER);
            }
            Query q = session.createSQLQuery("SELECT mp.id, activity FROM mitigationplans mp JOIN mitigationplanactivities mpa ON mpa.id = mp.id WHERE status = "+MitigationPlanData.PENDING+
            		" AND driver = "+driver+" AND activity in ("+activity+") AND done = 'f' AND mp.date < "+Util.formatSQL(activityDate)+" ORDER BY activity").addScalar("id", Hibernate.INTEGER).addScalar("activity", Hibernate.INTEGER);
            Iterator it = q.list().iterator();
            if(it.hasNext())  {
            	Object[] data = (Object[])it.next();
            	updateMigrationPlanActivity((Integer) data[0],(Integer) data[1], true, userSessionData);
            }
        }catch(Exception e) {
			Object[] parameters = {driver, activityDefinition};
			handler.getException(e,"updateMigrationPlanActivity",userSessionData,parameters);
        }
	}
	
	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,driverview,cepascheduleactivitycreate,cepascheduleactivityupdate"
	 * @param data Driver that will be created 
	 * @param userRequest User logged
	 */
	public void updateMigrationPlanActivity (Integer planId, Integer activity, boolean done, UserSessionData userSessionData) throws Exception {
		try{
            Session session=HibernateUtil.currentSession();
            MitigationPlan plan = (MitigationPlan) session.load(MitigationPlan.class, planId); 
            
            MitigationPlanActivity planActivity = (MitigationPlanActivity) session.load(MitigationPlanActivity.class, new MitigationPlanActivityPK(activity,plan));
            planActivity.setDone(done);
            session.update(planActivity);
            
        	Query q = session.createSQLQuery("SELECT done,COUNT(*) AS c FROM mitigationplanactivities WHERE id = "+plan.getId()+" GROUP BY done").addScalar("done",Hibernate.BOOLEAN).addScalar("c",Hibernate.INTEGER);
        	Iterator it = q.list().iterator();
        	double total = 0.0;
        	double doneActivities = 0.0;
        	while(it.hasNext()) {
        		Object[] data = (Object[])it.next();
        		if(((Boolean)data[0]).booleanValue()) {
        			doneActivities = ((Integer)data[1]).doubleValue();
        		}
    			total += ((Integer)data[1]).doubleValue();
        	}
        	if(done)
        		doneActivities++;
        	else
        		doneActivities--;
        	if(total == doneActivities){
            	plan.setStatus(MitigationPlanData.COMPLETE);
        	}else{
            	plan.setStatus(MitigationPlanData.PENDING);
        	}
        	
        	plan.setAdvance(new Integer(String.valueOf((Math.round(doneActivities * 100 / total)))));
            session.update(plan);
        }catch(Exception e) {
			Object[] parameters = {planId, activity, done};
			handler.getException(e,"updateMigrationPlanActivity",userSessionData,parameters);
        }
	}
	
	/** @ejb.interface-method
	 * @ejb.permission role-name = "administrator,driverview,cepascheduleactivitycreate,cepascheduleactivityupdate"
	 * @param data Driver that will be created 
	 * @param userRequest User logged
	 */
	public void updateAnualPlanActivity (Integer planId,boolean done, UserSessionData userSessionData) throws Exception {
		try{
            Session session=HibernateUtil.currentSession();
            AnualPlan plan = (AnualPlan) session.load(AnualPlan.class, planId); 
            
            if(done){
            	plan.setDate(new Date());
            	plan.setStatus(AnualPlanData.COMPLETE);
            	plan.setResullt(AnualPlanData.APROBADO);
            }else{
            	plan.setDate(null);
            	plan.setStatus(AnualPlanData.PENDING);
            	plan.setResullt(AnualPlanData.NO_NOTE);
            }
            
            session.update(plan);
        }catch(Exception e) {
			Object[] parameters = {planId,  done};
			handler.getException(e,"updateAnualPlanActivity",userSessionData,parameters);
        }
	}
	
	/**
	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivitycreate,cepascheduleactivityupdate,jjreporter"
	 * @param data Driver that will be created 
	 * @param userRequest User logged
	 */
	public void completeAnualPlanActivity (Integer driverId,String activityDefinition,boolean result, UserSessionData userSessionData) throws Exception {
		try{
            Session session=HibernateUtil.currentSession();
            String activity = "-1";
			if(activityDefinition.equals(CEPAActivityConstants.BTW1) || activityDefinition.equals(CEPAActivityConstants.BTW2)
					 || activityDefinition.equals(CEPAActivityConstants.BTWONBOARD) || activityDefinition.equals(CEPAActivityConstants.BTW1_NEW_FORM_TABLET)
					 || activityDefinition.equals(CEPAActivityConstants.BTW1ONBOARD_TABLET) || activityDefinition.equals(CEPAActivityConstants.BTW1_NEW_FORM_TABLET)
						 || activityDefinition.equals(CEPAActivityConstants.HRD) || activityDefinition.equals(CEPAActivityConstants.PHRD_TABLET) 
					 || activityDefinition.equals(CEPAActivityConstants.FEEDBACK_LINE_MANAGER)) {
				activity=String.valueOf(AnualPlanData.TYPE_ACTIVITY_BTW);
			}
            if(activityDefinition.equals(CEPAActivityConstants.COMMENTARYDRIVE)) {
            	activity = String.valueOf(AnualPlanData.TYPE_ACTIVITY_COMMENTED);
            } 
            if(activityDefinition.equals(CEPAActivityConstants.INDUCTION_NEW_FUNCTIONARY)) {
            	activity = String.valueOf(AnualPlanData.TYPE_ACTIVITY_INDUCTION);   	
            }
            if(activityDefinition.equals(CEPAActivityConstants.ASSESSMENT)) {
            	activity = String.valueOf(AnualPlanData.TYPE_ACTIVITY_EASSESMENT);
            }
            if(activityDefinition.equals(CEPAActivityConstants.MONITORS) || activityDefinition.equals(CEPAActivityConstants.MONITORS2)|| activityDefinition.equals(CEPAActivityConstants.MONITORS2_REFRESHMENT)) {
            	activity = String.valueOf(AnualPlanData.TYPE_ACTIVITY_MONITORS);
            }
            if(activityDefinition.equals(CEPAActivityConstants.ELEARNINGPACK)) {
            	activity = String.valueOf(AnualPlanData.TYPE_ACTIVITY_ELEARNING_1)+","+String.valueOf(AnualPlanData.TYPE_ACTIVITY_ELEARNING_2)+","+String.valueOf(AnualPlanData.TYPE_ACTIVITY_ELEARNING_FEEDBACK)+","+String.valueOf(AnualPlanData.TYPE_ACTIVITY_ELEARNING_MONITORS);
            }
            Calendar cal=Calendar.getInstance();
            Query query=session.createQuery("select a from AnualPlan as a where a.driver="+driverId+" and a.type in ("+activity+") and a.year="+cal.get(Calendar.YEAR)+" and a.status in ("+AnualPlanData.PENDING+","+AnualPlanData.SCHEDULE+") ORDER BY a.type");
            Iterator<AnualPlan> iter=query.list().iterator();
            if(iter.hasNext()){
            	AnualPlan plan=iter.next();
            	plan.setStatus(AnualPlanData.COMPLETE);
            	plan.setResullt(result?AnualPlanData.APROBADO:AnualPlanData.NO_APROBADO);
            	plan.setDate(new Date());
            	session.saveOrUpdate(plan);
            }
        }catch(Exception e) {
			Object[] parameters = {driverId, activityDefinition};
			handler.getException(e,"completeAnualPlanActivity",userSessionData,parameters);
        }
	}
	
	
	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,driverview"
	 * @param data Driver that will be created 
	 * @param userRequest User logged
	 */
	public void associateAnualPlan (Integer driverId, Integer plan, UserSessionData userSessionData) throws Exception {
		try{
            Session session=HibernateUtil.currentSession();
            
            Query delete = session.createQuery("DELETE FROM AnualPlan ap WHERE ap.driver.id = "+driverId);
            delete.executeUpdate();

            Driver driver = (Driver)session.load(Driver.class, driverId);
            SQLQuery query = session.createSQLQuery("SELECT activity,startType,start,days,alert1,alert2,alert3 FROM anualplandefinitions WHERE plan = "+plan);
            query.addScalar("activity",Hibernate.INTEGER);
            query.addScalar("startType",Hibernate.INTEGER);
            query.addScalar("start",Hibernate.DATE);
            query.addScalar("days",Hibernate.INTEGER);
            query.addScalar("alert1",Hibernate.INTEGER);
            query.addScalar("alert2",Hibernate.INTEGER);
            query.addScalar("alert3",Hibernate.INTEGER);
            Iterator<Object[]> it = query.list().iterator();
            while(it.hasNext()) {
            	Object[] data = it.next();
            	Date start = null;
            	switch((Integer)data[1]) {
            		case 1:
            			start = driver.getInclusionDate();
            			break;
            		case 2:
            			start = Calendar.getInstance().getTime();
            			break;
            		case 3:
            			start = (Date)data[2];
            			break;
            	}
            	AnualPlan anualPlan = new AnualPlan(driver,(Integer)data[0],start,(Integer)data[3],(Integer)data[4],(Integer)data[5],(Integer)data[6]);
            	session.save(anualPlan);
            }
         }catch(Exception e) {
			Object[] parameters = {driverId,  plan};
			handler.getException(e,"associateAnualPlan",userSessionData,parameters);
        }
    }
	
	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,driverview"
	 * @param data Driver that will be created 
	 * @param userRequest User logged
	 */
	public void updateAnualPlan(Integer driver, UserSessionData userSessionData) throws Exception {
		try {
            Session session=HibernateUtil.currentSession();
			String[] queries = {
					"update anualplans set status = 2, date = ca.date from activityregistry ar, cepaactivity ca  where ar.driver = anualplans.driver and ca.activityid = ar.activity and anualplans.type = 1 and anualplans.status = 0 and ca.date >= anualplans.datestart  and anualplans.expiry >= ca.date and ca.type in ('datatype.scheduledactivitytype.reporterjj.commentarydrive')",
					"update anualplans set status = 2, date = ca.date from activityregistry ar, cepaactivity ca  where ar.driver = anualplans.driver and ca.activityid = ar.activity and anualplans.type = 2 and anualplans.status = 0 and ca.date >= anualplans.datestart  and anualplans.expiry >= ca.date and ca.type in ('datatype.scheduledactivitytype.elearningpackbackrisk')",
					"update anualplans set status = 2, date = ca.date from activityregistry ar, cepaactivity ca  where ar.driver = anualplans.driver and ca.activityid = ar.activity and anualplans.type = 5 and anualplans.status = 0 and ca.date >= anualplans.datestart  and anualplans.expiry >= ca.date and ca.type in ('datatype.scheduledactivitytype.elearningfeedbackroad')",
					"update anualplans set status = 2, date = ca.date from activityregistry ar, cepaactivity ca  where ar.driver = anualplans.driver and ca.activityid = ar.activity and anualplans.type = 7 and anualplans.status = 0 and ca.date >= anualplans.datestart  and anualplans.expiry >= ca.date and ca.type in ('tablet.form.btw1plusonboard','datatype.scheduledactivitytype.btwonboard','datatype.scheduledactivitytype.ebtwteorico')",
					"update anualplans set status = 2, date = ca.date from activityregistry ar, cepaactivity ca  where ar.driver = anualplans.driver and ca.activityid = ar.activity and anualplans.type = 8 and anualplans.status = 0 and ca.date >= anualplans.datestart  and anualplans.expiry >= ca.date and ca.type in ('datatype.scheduledactivitytype.assessment')",
					"update anualplans set status = 2, date = ca.date from activityregistry ar, cepaactivity ca  where ar.driver = anualplans.driver and ca.activityid = ar.activity and anualplans.type = 9 and anualplans.status = 0 and ca.date >= anualplans.datestart  and anualplans.expiry >= ca.date and ca.type in ('datatype.scheduledactivitytype.elearningpackmonitores')",
					"update anualplans set status = 2, date = ca.date from activityregistry ar, cepaactivity ca  where ar.driver = anualplans.driver and ca.activityid = ar.activity and anualplans.type = 3 and anualplans.status = 0 and ca.date >= anualplans.datestart  and anualplans.expiry >= ca.date and ca.type in ('datatype.scheduledactivitytype.elearningspeed')"};
			for(int i = 0; i < queries.length; i++) {
				String sql = queries[i];
				if(driver != null) {
					sql += " AND ar.driver = "+driver;
				}
				Query q = session.createSQLQuery(sql);
				q.executeUpdate();
			}
		}catch(Exception e) {
			Object[] parameters = {driver};
			handler.getException(e,"updateAnualPlan",userSessionData,parameters);
        }
	}
}
