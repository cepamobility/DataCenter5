	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate,driverupload"
     */
    public void addTelematicControl(TelematicControlData telematicControlData,
      UserSessionData userSessionData) throws Exception {
        try{
            Session session = HibernateUtil.currentSession();
            TelematicControl control = new TelematicControl(telematicControlData,session);
            telematicControlData.setId((Integer)session.save(control));
            if(telematicControlData.getFileName()!=null){
            	String fileName=control.getId()+"_Telec"+"_"+telematicControlData.getFileName();
                 
            	File fileDelete=new File(AlertConstants.TEMP_DIRECTORY_IMAGE_DPA+fileName);
            	if(fileDelete.exists()){
            		fileDelete.delete();
            	}
              
                FileOutputStream fout;
        
                InputStream reportStream = telematicControlData.getFileInputStream();
                fout = new FileOutputStream(AlertConstants.TEMP_DIRECTORY_IMAGE_DPA+fileName);
        
                int c = 0;
                while ( (c=reportStream.read()) != -1){
                	fout.write(c);
                }   
                fout.flush();
                fout.close(); 
        
                control.setImage(fileName);
                session.update(control);
            }
            
        }catch(Exception e) {
        	Object[] parameters = {telematicControlData};
            handler.getException(e,"addTelematicControl",userSessionData,parameters);
        }
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate"
     */
    public void updateTelematicControl(TelematicControlData telematicControlData,UserSessionData userSessionData) throws Exception {
        try{
        	
        	 if(telematicControlData.getFileName()!=null){
             	String fileName=telematicControlData.getId()+"_Telec"+"_"+telematicControlData.getFileName();
                  
                 File fileDelete=new File(AlertConstants.TEMP_DIRECTORY_IMAGE_DPA+fileName);
