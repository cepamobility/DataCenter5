    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate,drivertests"
     */
    public boolean existAptitudTest(Integer driverId, Date date, UserSessionData userSessionData) throws Exception {
        try{
            Session session=HibernateUtil.currentSession();
            Query q = session.createSQLQuery("SELECT COUNT(*) AS c FROM aptitudtests WHERE id = "+driverId+" and date_trunc('day', date) = "+Util.formatSQL(date)).addScalar("c",Hibernate.INTEGER);
            List list = q.list();
            if(list.size() > 0) {
            	return (((Integer)list.get(0)).intValue() > 0); 
            }
        }catch(Exception e) {
			Object[] parameters = {driverId,date};
            handler.getException(e,"existAptitudTest",userSessionData,parameters);
        }
        return false;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate,drivertests"
     */
    public boolean existDriverLogistic(Integer driverId, String activity, UserSessionData userSessionData) throws Exception {
        try{
            Session session=HibernateUtil.currentSession();
            Query q = session.createSQLQuery("SELECT COUNT(*) AS c FROM driverlogistic WHERE driver = "+driverId+" AND activity = '"+activity+"'").addScalar("c",Hibernate.INTEGER);
            List list = q.list();
            if(list.size() > 0) {
            	return (((Integer)list.get(0)).intValue() > 0); 
            }
        }catch(Exception e) {
			Object[] parameters = {driverId,activity};
            handler.getException(e,"existDriverLogistic",userSessionData,parameters);
        }
        return false;
    }

