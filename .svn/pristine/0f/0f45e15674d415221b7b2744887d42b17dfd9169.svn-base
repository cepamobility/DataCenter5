    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate"
     */
    public void unificateDrivers(Integer origin, Integer destiny, boolean delete, String comment, UserSessionData userSessionData) throws Exception {
        try{
            Session session = HibernateUtil.currentSession();
            
            Driver destinyDriver = (Driver)session.load(Driver.class, destiny);
        	Query q = session.createQuery("SELECT v FROM Vehicle AS v WHERE v.driver.id = "+origin);
        	Iterator it = q.list().iterator();
        	while(it.hasNext()) {
        		Vehicle v = (Vehicle)it.next();
        		v.setDriver(destinyDriver);
        		session.update(v);
        		
    			VehicleLog log = new VehicleLog(v,userSessionData.getFilter().getLoginName(),
    					new Date(),LogActions.UPDATE,comment);
    			session.save(log);									

        	}
        	
        	q = session.createQuery("SELECT u FROM User AS u WHERE u.driver.id = "+origin);
        	it = q.list().iterator();
        	while(it.hasNext()) {
        		User u = (User)it.next();
        		u.setDriver(destinyDriver);
        		session.update(u);
        	}

        	q = session.createQuery("SELECT e FROM EventAbstract AS e WHERE e.driver.id = "+origin);
        	it = q.list().iterator();
        	while(it.hasNext()) {
        		EventAbstract event = (EventAbstract) it.next();
        		event.setDriver(destinyDriver);
        		session.update(event);
        		
        		if(event instanceof Event) {
        			EventLog log = new EventLog(userSessionData.getFilter().getLoginName(),
    					new Date(),LogActions.UPDATE,(Event)event,comment);
        			session.save(log);						
        		}
        	}
        	
        	q = session.createQuery("SELECT activity FROM CEPAScheduleActivityRegistry AS activity WHERE activity.driver.id = "+origin);
        	it = q.list().iterator();
        	while(it.hasNext()) {
        		CEPAScheduleActivityRegistry activity = (CEPAScheduleActivityRegistry) it.next();
        		activity.setDriver(destinyDriver);
        		session.update(activity);
        	}
        	 
        	q = session.createQuery("SELECT at FROM AptitudTest AS at WHERE at.pk.driver.id = "+origin);
        	it = q.list().iterator();
        	while(it.hasNext()) {
        		AptitudTest at = (AptitudTest) it.next();
        		if(!existAptitudTest(destiny, at.getPk().getDate(), userSessionData)) {
            		AptitudTest atNuevo = new AptitudTest(destiny, at.getData(), session);
        			session.save(atNuevo);
        		}
        		session.delete(at);
        	}

        	q = session.createQuery("SELECT dl FROM DriverLogistic AS dl WHERE dl.pk.driver.id = "+origin);
        	it = q.list().iterator();
        	while(it.hasNext()) {
        		DriverLogistic dl = (DriverLogistic) it.next();
        		DriverLogistic dlNuevo = new DriverLogistic(dl.getData());
        		dlNuevo.getPk().setDriver(destinyDriver);
        		if(!existDriverLogistic(destiny, dl.getPk().getActivity().getResourceBundleId(), userSessionData)) {
        			session.save(dlNuevo);
        		}
        		session.delete(dl);
        	}

        	q = session.createQuery("SELECT control FROM TelematicControl AS control WHERE control.driver.id = "+origin);
        	it = q.list().iterator();
        	while(it.hasNext()) {
        		TelematicControl control = (TelematicControl) it.next();
        		control.setDriver(destinyDriver);
        		session.update(control);
        	}

        	q = session.createSQLQuery("UPDATE gab_drivers SET dcdriverid = "+destiny+" WHERE dcdriverid = "+origin);
        	q.executeUpdate();
        	
        	q = session.createSQLQuery("SELECT id FROM pointaccount WHERE type = 1 AND reference = "+origin).addScalar("id",Hibernate.INTEGER);
        	it = q.list().iterator();
        	int originAccount = (it.hasNext()) ? ((Integer)it.next()).intValue() : -1;
        	
        	q = session.createSQLQuery("SELECT id FROM pointaccount WHERE type = 1 AND reference = "+destiny).addScalar("id",Hibernate.INTEGER);
        	it = q.list().iterator();
        	int destinyAccount = (it.hasNext()) ? ((Integer)it.next()).intValue() : -1;

        	Query query = session.createQuery("UPDATE PointMove pm SET pm.account = "+destinyAccount+" WHERE pm.account = "+originAccount);
        	query.executeUpdate();
        	
        	CorporationABMUtil.getHome().create().updatePointAccount(destinyAccount,userSessionData);
        	
        	if(delete) {    
        		q = session.createQuery("SELECT mp FROM MitigationPlan mp WHERE mp.driver = "+origin);
            	it = q.list().iterator();
            	while(it.hasNext()) {
            		MitigationPlan mp = (MitigationPlan) it.next();
            		Iterator it2 = mp.getActivitySet().iterator();
            		while(it2.hasNext()) {
            			MitigationPlanActivity activity = (MitigationPlanActivity)it2.next();
            			session.delete(activity);
            		}
            		session.delete(mp);
            	}

        		q = session.createQuery("SELECT ap FROM AnualPlan ap WHERE ap.driver = "+origin);
            	it = q.list().iterator();
            	while(it.hasNext()) {
            		AnualPlan ap = (AnualPlan) it.next();
            		session.delete(ap);
            	}

            	query = session.createQuery("DELETE FROM PointAccount pa WHERE pa.type = 1 AND pa.reference = "+origin);
        		query.executeUpdate();
        		
        		query = session.createQuery("DELETE FROM DriverPointHistory AS dph WHERE dph.pk.driver.id=(:driver)");
        		query.setParameter("driver", origin);
        		query.executeUpdate();
        		
        		query = session.createQuery("DELETE FROM DriverPointMoveHistory AS dph WHERE dph.pk.driver.id=(:driver)");
        		query.setParameter("driver", origin);
        		query.executeUpdate();

        		Driver originDriver = (Driver)session.load(Driver.class, origin);
                DriverLog log = new DriverLog(originDriver,userSessionData.getFilter().getLoginName(),
    					new Date(),LogActions.DELETE,comment);
                
                session.delete(originDriver);
                session.save(log);
        	}
        }catch(Exception e) {
			Object[] parameters = {origin,destiny,delete,comment};
			handler.getException(e,"unificateDrivers",userSessionData,parameters);
        }
    }
    
