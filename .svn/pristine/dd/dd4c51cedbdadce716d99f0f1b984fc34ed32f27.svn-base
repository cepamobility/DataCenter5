    public String getData(int type, int index, int j) {
        if(type == DIV_ORG) {
            Iterator<DivOrgData> it = getDivOrgsIterator();
            DivOrgData data = null;
            for(int i = 0; i < index; i++) {
                data = (DivOrgData)it.next();
            }
            LabelItemData label = data.getDivOrgLevels(); 
            for(int i = 1; i < j; i++) {
                label = ((ItemData)label.getItemIterator().next()).getSubItems();
            }
            return ((ItemData)label.getItemIterator().next()).getName();
        }else{
            GeoLabelData label = getCountrygeo(); 
            for(int i = 1; i < j; i++) {
                label = ((GeoItemData)label.getItemIterator().next()).getSubItems();
            }
           return ((GeoItemData)label.getItemIterator().next()).getName();
        }
    }

	public String getKey() {
		String key = "";
		Iterator<DivOrgData> it = this.getDivOrgsIterator();
    	while(it.hasNext()) {		
    		DivOrgData divOrgData = (DivOrgData)it.next();
    		if(divOrgData.getDivOrgLevels() != null) {
    			ItemData item = (ItemData)divOrgData.getDivOrgLevels().getItemIterator().next();
        		while(item.getSubItems() != null) {
    				item = (ItemData)item.getSubItems().getItemIterator().next();
				} // end if(item2.getSubItems() != null)
				key += item.getId()+";";
    		}
    	}
	    GeoItemData itemData1 = (GeoItemData)countrygeo.getItemIterator().next();
	    while(itemData1.getSubItems() != null) {
	        itemData1 = (GeoItemData)itemData1.getSubItems().getItemIterator().next();
	    }
	    key += String.valueOf(itemData1.getId());
    	return key;
	}

	public HashMap<String, CEPAActivityScheduleData> divide(Collection<DriverData> drivers) {
		HashMap<String, CEPAActivityScheduleData> newActivities = new HashMap<String, CEPAActivityScheduleData>(); 
		String activityKey = getKey();
		Iterator<DriverData> driversIt = drivers.iterator();
		while(driversIt.hasNext()) {
			DriverData driver = driversIt.next();
			String driverKey = driver.getKey();
			if(activityKey.equals(driverKey)) {
				addDriver(driver);
			}else {
				if(!newActivities.containsKey(driverKey)) {
					CEPAActivityScheduleData newActivity = new CEPAActivityScheduleData(this,driver);
					newActivity.setActivityId(null);
					newActivity.addDriver(driver);
					newActivities.put(driverKey, newActivity);
				}else {
					CEPAActivityScheduleData activity = newActivities.get(driverKey);
					activity.addDriver(driver);
				}
			}
		}
		if(this.drivers != null && this.drivers.size() > 0) {
			newActivities.put(activityKey, this);
		}
		return newActivities;
	}

	private void addDriver(DriverData driver) {
		if(drivers == null) {
			drivers = new LinkedList<DriverData>();
		}
		drivers.add(driver);
	}

	public LinkedList<DriverData> getDrivers() {
		return drivers;
	}

	public void setDrivers(LinkedList<DriverData> drivers) {
		this.drivers = drivers;
	}
    
	public void replaceDivOrg(int index, Integer item1, Integer item2, Integer item3) {
		LabelItemData lid = getLabelItemData(item1, item2, item3);  	

		Iterator<DivOrgData> it = this.getDivOrgsIterator();
		DivOrgData divOrgData = null;
    	for(int i = 1; i <= index && it.hasNext(); i++) {		
    		divOrgData = (DivOrgData)it.next();
    	}
    	divOrgData.setDivOrgLevels(lid);
	}

	public void removeDivOrg(int index) {
		Iterator<DivOrgData> it = this.getDivOrgsIterator();
    	int i = 1;
    	while(it.hasNext()) {		
    		it.next();
    		if(i >= index)
    	    	it.remove();
    		i++;
    	}
	}

	private LabelItemData getLabelItemData(Integer item1, Integer item2,
			Integer item3) {
		Collection items1 = new LinkedList();
        if(item2 == null) {
            items1.add(new ItemData(item1,"",true,null));
        }else{
            if(item3 == null) {
                Collection items2 = new LinkedList();
                items2.add(new ItemData(item2,"",true,null));
                LabelItemData level1 = new LabelItemData(null,null,items2,null);
                items1.add(new ItemData(item1,"",true,level1));
            }else {
                Collection items3 = new LinkedList();
                items3.add(new ItemData(item3,"",true,null));
                LabelItemData level2 = new LabelItemData(null,null,items3,null);
                
                Collection items2 = new LinkedList();
                items2.add(new ItemData(item2,"",true,level2));
                LabelItemData level1 = new LabelItemData(null,null,items2,null);
                
                items1.add(new ItemData(item1,"",true,level1));
                
            }
        }
        LabelItemData lid = new LabelItemData(null,null,items1,null);
		return lid;
	}
	
	public void addDivOrg(Integer divOrgid, String divOrgName, Integer item1, Integer item2, Integer item3) {
		LabelItemData lid = getLabelItemData(item1, item2, item3);  	
    	getDivOrgSet().add(new DivOrgData(divOrgid,divOrgName,lid));
	}
	
	public void replaceDivGeo(Integer item1, Integer item2, Integer item3) {
		Collection items1 = new LinkedList();
        if(item2 == null) {
            items1.add(new GeoItemData(item1,"",true,null));
        }else{
            if(item3 == null) {
                Collection items2 = new LinkedList();
                items2.add(new GeoItemData(item2,"",true,null));
                GeoLabelData level1 = new GeoLabelData(null,null,null,items2);
                items1.add(new GeoItemData(item1,"",true,level1));
            }else {
                Collection items3 = new LinkedList();
                items3.add(new GeoItemData(item3,"",true,null));
                GeoLabelData level2 = new GeoLabelData(null,null,null,items3);
                
                Collection items2 = new LinkedList();
                items2.add(new GeoItemData(item2,"",true,level2));
                GeoLabelData level1 = new GeoLabelData(null,null,null,items2);
                
                items1.add(new GeoItemData(item1,"",true,level1));
            }
        }
        setCountrygeo(new GeoLabelData(null,null,null,items1));       		
	}

	public boolean isCommentaryDrive() {
		String typeStr = type.getResourceBundleId();
		return typeStr.equals(CEPAActivityConstants.COMMENTARYDRIVE) ||
				typeStr.equals(CEPAActivityConstants.COMMENTARYDRIVE_INSTRUCTORES) ||
				typeStr.equals(CEPAActivityConstants.COMMENTARYDRIVE_JJ2) ||
				typeStr.equals(CEPAActivityConstants.COMMENTARYDRIVE_NOVARTIS) ||
				typeStr.equals(CEPAActivityConstants.COMMENTARYDRIVE_RENOVATION) ||
				typeStr.equals(CEPAActivityConstants.INITIAL_FOREIGN_EVALUATION) ||
				typeStr.equals(CEPAActivityConstants.COMMENTARYDRIVEARGENTINA) ||
				typeStr.equals(CEPAActivityConstants.COMMENTARYDRIVEARGENTINA_NUEVO) ||
				typeStr.equals(CEPAActivityConstants.COMMENTARYDRIVEHIGHRISK) ||
				typeStr.equals(CEPAActivityConstants.COMMENTARYDRIVENALCO) ||
				typeStr.equals(CEPAActivityConstants.COMMENTARYDRIVEOTHER) ||
				typeStr.equals(CEPAActivityConstants.COMMENTARYDRIVEOTHERSPECIAL) ||
				typeStr.equals(CEPAActivityConstants.COMMENTARYDRIVETIMEEXPIRY);
	}

	public int getAge() {
		return Util.getAge(date);
	}

	public String getDivOrg(int[] divOrgs) {
		Iterator<DivOrgData> it = getDivOrgsIterator();
		DivOrgData divOrg = null;
		for(int i = 0; i < divOrgs[0]; i++) 
			divOrg = it.next();
		LabelItemData lid = divOrg.getDivOrgLevels();
		for(int i = 1; i < divOrgs[1]; i++) { 
			lid = ((ItemData)lid.getItemIterator().next()).getSubItems();
		}
		// TODO Auto-generated method stub
		return ((ItemData)lid.getItemIterator().next()).getName();
	}

	public boolean hasNewReports() {
		String defName = definition.getResourceKeyName();
		return defName.equals(CEPAActivityConstants.BTW1_NEW_FORM_TABLET) || defName.equals(CEPAActivityConstants.BTW2_NEW_FORM_TABLET)
		 || defName.equals(CEPAActivityConstants.BTW2ONBOARD_TABLET)  || defName.equals(CEPAActivityConstants.BTW1ONBOARD_TABLET)
		 || defName.equals(CEPAActivityConstants.TRAINING_ON_THE_JOB_TABLET) || defName.equals(CEPAActivityConstants.PHRD_TABLET)
		 || defName.equals(CEPAActivityConstants.EVALUACION_EN_CABINA_TABLET) || defName.equals(CEPAActivityConstants.TOJ_ECONOMIC_TABLET)
		 || defName.equals(CEPAActivityConstants.TRAINING_ON_THE_JOB_4X4_TABLET) || defName.equals(CEPAActivityConstants.SPECIALDAYOFTRAINING_TABLET)
		 || defName.equals(CEPAActivityConstants.TRANSIT_BEHAVIOUR_TABLET) || defName.equals(CEPAActivityConstants.SAFE_DRIVE_TABLET)
		 || defName.equals(CEPAActivityConstants.BTW3_VIA_PUBLICA_TABLET) || defName.equals(CEPAActivityConstants.BTW2REFRESHONBOARD_TABLET)
		 || defName.equals(CEPAActivityConstants.EBTW_PISTA_TABLET) || defName.equals(CEPAActivityConstants.BTWPLUS1_TABLET)
		 || defName.equals(CEPAActivityConstants.BTWPLUS1ONBOARD_TABLET) || defName.equals(CEPAActivityConstants.BTWPLUS2_TABLET)
		 || defName.equals(CEPAActivityConstants.BTWPLUS2ONBOARD_TABLET) || defName.equals(CEPAActivityConstants.EVALUACIONINICIALCEPA_TABLET)
		 || defName.equals(CEPAActivityConstants.EVALUACIONPLANAUTOCEPA_TABLET) || defName.equals(CEPAActivityConstants.BTWPLUS2_TABLET_CON_SKID);
	}

