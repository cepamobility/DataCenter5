    public Iterator<DivOrgData> getDivOrgsIterator() {
        if(this.divOrgSet == null) {
            return null;
        }
        Collections.sort((List)divOrgSet);
        return divOrgSet.iterator();
    }
    
  
    public String getDivision() {
    	Iterator<DivOrgData> it;
    	it = this.getDivOrgsIterator();
    	String division = "";
    	while(it.hasNext()) {		
    		DivOrgData divOrgData = (DivOrgData)it.next();
    		if (divOrgData.getName().equals("corporation.monsanto.divisions")) {
    		if(divOrgData.getDivOrgLevels() != null) {
    			ItemData item1 = (ItemData)divOrgData.getDivOrgLevels().getItemIterator().next();

        		if(item1.getSubItems() != null) {
    				ItemData item2 = (ItemData)item1.getSubItems().getItemIterator().next();

    				division = item2.getName();
    				    
				} // end if(item2.getSubItems() != null)

    		}
    		}
    	}
    	return division;
    }
    
