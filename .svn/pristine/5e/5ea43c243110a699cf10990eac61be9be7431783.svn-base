import org.apache.struts.action.ActionForm;
import org.jfree.report.ElementAlignment;
import org.jfree.report.ItemBand;
import org.jfree.report.ReportFooter;
import org.jfree.report.ReportHeader;
import org.jfree.report.elementfactory.DateFieldElementFactory;
import org.jfree.report.elementfactory.LabelElementFactory;
import org.jfree.report.elementfactory.NumberFieldElementFactory;
import org.jfree.report.elementfactory.StaticShapeElementFactory;
import org.jfree.report.elementfactory.TextFieldElementFactory;
import org.jfree.report.function.CreateHyperLinksFunction;
import org.jfree.report.function.ElementColorFunction;
import org.jfree.report.function.ElementVisibilityFunction;
import org.jfree.report.function.ExpressionCollection;
import org.jfree.report.function.ItemCountFunction;
import org.jfree.report.function.TextFormatExpression;

import presentation.report.ReportFactory;
import presentation.translator.web.driver.DriverPointReportForm;
import presentation.translator.web.util.Util;
import business.SystemAccess;

import communication.administration.corporation.tables.CorporationData;
import communication.language.Text;

public class DriverPointReportFactory extends ReportFactory {

    protected Text messages;
    private SystemAccess sys;
    
    private int last;
    private int[][] principal;
    
    private boolean resumed;
    
    public DriverPointReportFactory(String name, TableModel model, ActionForm form, SystemAccess sys, Text messages, boolean resumed) {
        super(name, model, form);
        this.messages = messages;
        parseDivisionValues(sys,messages);
        this.sys = sys;
        last = (sys.isCorporation(CorporationData.BAYER_MX)) ? 1260 : 730;
        principal = sys.getUserSessionData().getFilter().getPrincipalDivOrgs();
        for(int i = 0; i < principal.length; i++) {
            if(principal[i][0] != 0) {
                last += 100;
            }
        }
        this.resumed = resumed;
    }

    protected int getWidth() {
        return last+82;
    }

    protected int getReportWidth() {
    	return last;
    }
    
    protected ItemBand createItemBand() {
        ItemBand items = super.createItemBand();
        items.addElement(StaticShapeElementFactory.createRectangleShapeElement("Variance Field", null, null,new Rectangle2D.Float(10, 0, getReportWidth(), 15), false, true));
        int x = 10;
        if(sys.isCorporation(CorporationData.BAYER_MX)) {
            items.addElement(TextFieldElementFactory.createStringElement("URL-Field",new Rectangle2D.Float(x, 0, 100, 15),Color.BLACK,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"","corporationId"));
            x += 100;
        }
        items.addElement(TextFieldElementFactory.createStringElement("URL-Field",new Rectangle2D.Float(x, 0, 100, 15),Color.BLACK,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"","firstname"));
        x += 100;
        items.addElement(TextFieldElementFactory.createStringElement("URL-Field",new Rectangle2D.Float(x, 0, 100, 15),Color.BLACK,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"","lastname"));
        x += 100;
        items.addElement(TextFieldElementFactory.createStringElement("director",new Rectangle2D.Float(x, 0, 60, 15),Color.BLACK,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"","director"));
        x += 60;
        items.addElement(TextFieldElementFactory.createStringElement("country",new Rectangle2D.Float(x, 0, 100, 15),Color.BLACK,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"","country"));
        x += 100;
        if(sys.isCorporation(CorporationData.BAYER_MX)) {
            items.addElement(TextFieldElementFactory.createStringElement("manager",new Rectangle2D.Float(x, 0, 100, 15),Color.BLACK,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"","manager"));
            x += 100;
        }
        for(int i = 0; i < principal.length; i++) {
            if(principal[i][0] != 0) {
                items.addElement(TextFieldElementFactory.createStringElement("divorg"+String.valueOf(i+1),new Rectangle2D.Float(x, 0, 100, 15),Color.BLACK,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"","divorg"+String.valueOf(i+1)));
                x += 100;
            }
        }
        if(sys.isCorporation(CorporationData.BAYER_MX)) {
            items.addElement(StaticShapeElementFactory.createRectangleShapeElement("veryhighriskColor", Color.BLACK, null,new Rectangle2D.Float(x, 0, 100, 15), false, true));
            items.addElement(StaticShapeElementFactory.createRectangleShapeElement("highriskColor", Color.RED, null,new Rectangle2D.Float(x, 0, 100, 15), false, true));
            items.addElement(StaticShapeElementFactory.createRectangleShapeElement("mediumriskColor", Color.YELLOW, null,new Rectangle2D.Float(x, 0, 100, 15), false, true));
            items.addElement(StaticShapeElementFactory.createRectangleShapeElement("lowriskColor", Color.GREEN, null,new Rectangle2D.Float(x, 0, 100, 15), false, true));
            items.addElement(TextFieldElementFactory.createStringElement("fontColorRisk",new Rectangle2D.Float(x, 0, 100, 15),Color.WHITE,ElementAlignment.CENTER,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"","risk"));
            x += 100;
        }
        items.addElement(TextFieldElementFactory.createStringElement("points",new Rectangle2D.Float(x, 0, 60, 15),Color.BLACK,ElementAlignment.CENTER,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"","points"));
        x += 60;
        if(resumed) {
	        for(int i = 0; i < 5; i++) {
	            items.addElement(TextFieldElementFactory.createStringElement("category"+i,new Rectangle2D.Float(x, 0, 60, 15),Color.BLACK,ElementAlignment.CENTER,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"---","category"+i));
	            x += 60;
	            if(sys.isCorporation(CorporationData.BAYER_MX) && i == 3) {
		            items.addElement(TextFieldElementFactory.createStringElement("ebtw"+i,new Rectangle2D.Float(x, 0, 60, 15),Color.BLACK,ElementAlignment.CENTER,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"---","ebtw"));
		            x += 60;
		            items.addElement(TextFieldElementFactory.createStringElement("da"+i,new Rectangle2D.Float(x, 0, 60, 15),Color.BLACK,ElementAlignment.CENTER,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"---","da"));
		            x += 60;	            	
	            }
	        }
        }else {
            items.addElement(DateFieldElementFactory.createDateElement("date",new Rectangle2D.Float(x, 0, 60, 15),Color.BLACK,ElementAlignment.CENTER,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"-",DATE_FORMAT,"amount"));
            x += 60;
            items.addElement(TextFieldElementFactory.createStringElement("amount",new Rectangle2D.Float(x, 0, 60, 15),Color.BLACK,ElementAlignment.CENTER,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"---","amount"));
            x += 60;
            items.addElement(TextFieldElementFactory.createStringElement("move",new Rectangle2D.Float(x, 0, 240, 15),Color.BLACK,ElementAlignment.CENTER,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"---","move"));
            x += 180;
        }
        if(sys.isCorporation(CorporationData.BAYER_MX)) {
            items.addElement(TextFieldElementFactory.createStringElement("mitigationplan",new Rectangle2D.Float(x, 0, 110, 15),Color.BLACK,ElementAlignment.CENTER,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"---","mitigationplan"));
            x += 110;
        }
        return items;
    }
    
    protected ReportHeader createReportHeader() {
        DriverPointReportForm reportForm = (DriverPointReportForm)form;
        ReportHeader reportHeader = new ReportHeader();
        int height = writeFilter(reportForm, reportHeader);
                
        reportHeader.addElement(StaticShapeElementFactory.createRectangleShapeElement(null,FirstLevelColor, null,
                new Rectangle2D.Float(10, height, getReportWidth(), 18), false, true));
       
        int x = 10;
        if(sys.isCorporation(CorporationData.BAYER_MX)) {
            reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 100, 18), 
            		Color.WHITE,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,messages.getText("generic.driver.driverdata.corporationid")));
            x += 100;
        }
        reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 100, 18), 
        		Color.WHITE,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,messages.getText("generic.driver.driverdata.firstname")));
        x += 100;
        reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 100, 18), 
        		Color.WHITE,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,messages.getText("generic.driver.driverdata.lastname")));
        x += 100;
        reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 60, 18), 
        		Color.WHITE,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,messages.getText("generic.driver.driverdata.director")));
        x += 60;
        reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 100, 18), 
        		Color.WHITE,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,messages.getText("generic.driver.driverdata.country")));
        x += 100;
        if(sys.isCorporation(CorporationData.BAYER_MX)) {
            reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 100, 18), 
            		Color.WHITE,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,messages.getText("divorg.bayer_mx.manager")));
            x += 100;
        }
        for(int i = 0; i < principal.length; i++) {
            if(principal[i][0] != 0) {
                reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 100, 18),
                    Color.WHITE,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,divOrgLabels[principal[i][0]-1][principal[i][1]-1]));
                x += 100;
            }
        }
        if(sys.isCorporation(CorporationData.BAYER_MX)) {
            reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 100, 18),
            		Color.WHITE,ElementAlignment.CENTER, ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,"Risk"));
            x += 100;
        }
        reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 60, 18),
        		Color.WHITE,ElementAlignment.CENTER, ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,messages.getText("generic.messages.total")));
        x += 60;
        if(resumed) {
	        for(int i = 0; i < 5; i++) {
	        	reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 60, 18),
	            		Color.WHITE,ElementAlignment.CENTER, ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,messages.getText("bayer.points.category"+i)));
	            x += 60;
	            if(sys.isCorporation(CorporationData.BAYER_MX) && i == 3) {
		        	reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 60, 18),
		            		Color.WHITE,ElementAlignment.CENTER, ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,"eBTW"));
		            x += 60;
		        	reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 60, 18),
		            		Color.WHITE,ElementAlignment.CENTER, ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,"eAssessment"));
		            x += 60;	            	
	            }
	        }
        } else {
        	reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 60, 18),
            		Color.WHITE,ElementAlignment.CENTER, ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,messages.getText("generic.messages.date")));
            x += 60;
        	reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 60, 18),
        			Color.WHITE,ElementAlignment.CENTER, ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,messages.getText("generic.driver.points")));
            x += 60;
        	reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 240, 18),
            		Color.WHITE,ElementAlignment.CENTER, ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,messages.getText("driver.point.move")));        	
        }
        if(sys.isCorporation(CorporationData.BAYER_MX)) {
        	reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(x, height, 110, 18),
            		Color.WHITE,ElementAlignment.CENTER, ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT, messages.getText("generic.driver.mitigationplan")));        	
            x += 110;
        }
        return reportHeader;
    }

	protected int writeFilter(DriverPointReportForm reportForm, ReportHeader reportHeader) {
		
        reportHeader.addElement(StaticShapeElementFactory.createRectangleShapeElement(null, FourLevelColor, null,
                new Rectangle2D.Float(10, 0, getReportWidth(), 25), false, true));
		reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(10, 0, getReportWidth(), 25),
        		Color.BLACK,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_TITLE,messages.getText("query.driverpoints.title")));
        
        int height = 25;

        height = writeParametersTitle(messages.getText("generic.driver.personaldata"),reportHeader,height,10,160);
        
        height = writeParameter(messages.getText("generic.driver.driverdata.firstname")+":",reportForm.getFirstName(),reportHeader,height,10,100,110,100);
        height = writeParameter(messages.getText("generic.driver.driverdata.lastname")+":",reportForm.getLastName(),reportHeader,height,10,100,110,100);
        height = writeParameter(messages.getText("generic.driver.driverdata.status")+":",reportForm.getStatus(messages),reportHeader,height,10,100,110,100);

        height = writeParametersTitle(messages.getText("generic.driver.divgeo"),reportHeader,height,10,200); 
        for(int i = 0; i < 3; i++) {
            if(divGeoLabels[i]!=null) {
                height = writeParameter(divGeoLabels[i]+":",divGeoValues[i],reportHeader,height,10,100,110,100);
            }
        }
        
        int maxHeight = height;
        height = 25;
       
        String[] divOrgs = sys.getUserSessionData().getFilter().getLevelLabels();
        for(int i = 0; i < divOrgs.length; i++) {
            if(!Util.empty(divOrgs[i])) {
                height = writeParametersTitle(messages.getText(divOrgs[i]),reportHeader,height,270,200);
                for(int j = 0; j < 3; j++) {
                    if(!(sys.getUserSessionData().getFilter().getCorporationId().intValue() == 1 && i == 1 && j== 0) && 
                            !(sys.getUserSessionData().getFilter().getCorporationId().intValue() == 1 && i == 2 && j== 0)) {
                        if(!Util.empty(divOrgLabels[i][j])) {
                            height = writeParameter(divOrgLabels[i][j]+":",divOrgValues[i][j],reportHeader,height,270,100,370,100);
                        }
                    }
                }
            }
        }
        maxHeight=Math.max(maxHeight,height);

        return maxHeight;
	}

    protected int writeParameter(String parameterName,String parameterValue,ReportHeader reportHeader,int height,int xLabel,int wLabel,int xValue,int wValue) {
    	 
		
    	if(!Util.empty(parameterValue)) {
    		reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(xLabel, height, wLabel, 18),
                    Color.BLACK,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,parameterName));
    		reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(xValue, height, wValue, 18),
                    Color.BLACK,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,parameterValue));
    		return height+20;
    	}else if(!Util.empty(parameterName)){ 
    		reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(xLabel, height, wLabel, 18),
                    Color.BLACK,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_BOLD_FONT,parameterName));
    		reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(xValue, height, wValue, 18),
                    Color.BLACK,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_SIMPLE_FONT,"--"));
        	return height+20;
        }
    	return height;
    }
    protected int writeParametersTitle(String parameterName,ReportHeader reportHeader,int height,int xLabel,int wLabel) {
    		reportHeader.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(xLabel, height, wLabel, 18),
                    Color.blue,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_TITLE_PARAM_FONT,parameterName)); 
    		return height+20;
    }
    
    protected ReportFooter createReportFooter() {
        ReportFooter reportFooter = new ReportFooter();
        reportFooter.addElement(StaticShapeElementFactory.createRectangleShapeElement(null, FirstLevelColor, null,
                new Rectangle2D.Float(10, 10, getReportWidth(), 20), false, true));
        reportFooter.addElement(LabelElementFactory.createLabelElement(null,new Rectangle2D.Float(10, 10, 160, 20),
                Color.WHITE,ElementAlignment.LEFT,ElementAlignment.MIDDLE,STYLE_TOTAL_FONT,messages.getText("query.driver.driverdata.total")));
        reportFooter.addElement(NumberFieldElementFactory.createNumberElement(null,new Rectangle2D.Float(last-90, 10, 90, 20),
                Color.WHITE,ElementAlignment.CENTER,ElementAlignment.MIDDLE,STYLE_TOTAL_FONT,"", "#####","total"));

        return reportFooter;
    }

    protected ExpressionCollection createFunctions() {
        ExpressionCollection functions = super.createFunctions();
        
        final ItemCountFunction countFunction = new ItemCountFunction();
        countFunction.setName("total");
        countFunction.setGroup("dummy");
        functions.add(countFunction);
        
        final ElementColorFunction color = new ElementColorFunction();
        color.setName("changeColor");
        color.setElement("Variance Field");
        color.setField("color");
        color.setColorTrue(Color.WHITE);
        color.setColorFalse(DCGray2);
        functions.add(color);

        final ElementColorFunction fontcolor = new ElementColorFunction();
        fontcolor.setName("changeFontColor");
        fontcolor.setElement("fontColorRisk");
        fontcolor.setField("colorRisk");
        fontcolor.setColorTrue(Color.BLACK);
        fontcolor.setColorFalse(Color.WHITE);
        functions.add(fontcolor);

        final ElementVisibilityFunction functionVHRisk = new ElementVisibilityFunction();
        functionVHRisk.setName("VHRisk");
        functionVHRisk.setElement("veryhighriskColor");
        functionVHRisk.setField("veryhighRisk");
        functions.add(functionVHRisk);
        
        final ElementVisibilityFunction functionHRisk = new ElementVisibilityFunction();
        functionHRisk.setName("HRisk");
        functionHRisk.setElement("highriskColor");
        functionHRisk.setField("highRisk");
        functions.add(functionHRisk);
        
        final ElementVisibilityFunction functionMRisk = new ElementVisibilityFunction();
        functionMRisk.setName("MRisk");
        functionMRisk.setElement("mediumriskColor");
        functionMRisk.setField("medRisk");
        functions.add(functionMRisk);
        
        final ElementVisibilityFunction functionLRisk = new ElementVisibilityFunction();
        functionLRisk.setName("LRisk");
        functionLRisk.setElement("lowriskColor");
        functionLRisk.setField("lowRisk");
        functions.add(functionLRisk);
        
        TextFormatExpression textExp = new TextFormatExpression();
        textExp.setName("URLCreateExpression");
        textExp.setPattern("./layout.jsp?refer=/driver/DriverView.jsp?id={0}");
        textExp.setField(0,"id");
        functions.add(textExp);

        CreateHyperLinksFunction link = new CreateHyperLinksFunction();
        link.setName("AddHRefs");
        link.setField("URLCreateExpression");
        link.setElement("URL-Field");
        functions.add(link);

        return functions;
    }
}
