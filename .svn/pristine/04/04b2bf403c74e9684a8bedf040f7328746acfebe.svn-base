package business.ws.client.vehicle;

import java.io.Serializable;
import java.util.Date;

import business.ws.client.common.WSLDivOrgData;

import communication.administration.corporation.tables.CorporationData;
import communication.administration.corporation.tables.DivOrgData;
import communication.administration.corporation.tables.GeoLabelData;
import communication.vehicle.tables.VehicleOptionalInfoData;

public class WSLVehicleOdometerData implements Serializable{

	private Integer id;
	private String plate;
	
	private Integer lastPeriod;
	private Integer lastYear;
	private Integer lastOdometer;

	private Integer previousPeriod;
	private Integer previousYear;
	private Integer previousOdometer;
		
    private static final long serialVersionUID = 1L;

    public WSLVehicleOdometerData(){}
		
	public WSLVehicleOdometerData(Integer id, String matricula) {
		this.id = id;
		this.plate = matricula;
	}

	public Integer getId() {
		return id;
	}

	public void setId(Integer id) {
		this.id = id;
	}

	public String getPlate() {
		return plate;
	}

	public void setPlate(String plate) {
		this.plate = plate;
	}

	public Integer getLastPeriod() {
		return lastPeriod;
	}

	public void setLastPeriod(Integer lastPeriod) {
		this.lastPeriod = lastPeriod;
	}

	public Integer getLastYear() {
		return lastYear;
	}

	public void setLastYear(Integer lastYear) {
		this.lastYear = lastYear;
	}

	public Integer getLastOdometer() {
		return lastOdometer;
	}

	public void setLastOdometer(Integer lastOdometer) {
		this.lastOdometer = lastOdometer;
	}

	public Integer getPreviousPeriod() {
		return previousPeriod;
	}

	public void setPreviousPeriod(Integer previousPeriod) {
		this.previousPeriod = previousPeriod;
	}

	public Integer getPreviousYear() {
		return previousYear;
	}

	public void setPreviousYear(Integer previousYear) {
		this.previousYear = previousYear;
	}

	public Integer getPreviousOdometer() {
		return previousOdometer;
	}

	public void setPreviousOdometer(Integer previousOdometer) {
		this.previousOdometer = previousOdometer;
	}

}
