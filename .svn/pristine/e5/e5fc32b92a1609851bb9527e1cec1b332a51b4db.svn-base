							</td>
					<%=(line) ? "</tr>" : "" %>							
							<!-- Agregar Instructor -->	
<%							line = !line;
%>					<%=(!line) ? "<tr>" : "" %>														
							<td style="width:50%">
	                			<img align="middle" border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
								<a href="<%=hrefInstructor %>#" onClick="javascript:document.forms['addInstructor'].submit()" class="texts" >
									<%=messages.getText("generic.messages.addinstructor")%>
								</a>
							</td>
					<%=(line) ? "</tr>" : "" %>							
<%							}
					  	}
					 }
				}
				// Fin Editar Actividad

				// OPCION: DELETE
				if((userSessionData.checkPermission(SecurityConstants.DELETE_CEPASCHEDULEACTIVITY) || 
						userSessionData.checkPermission(SecurityConstants.DELETE_CD_ACTIVITY)) && 
						!data.getIsOld()  && userSessionData.canModifyActivityRegitry(data.getType().getResourceBundleId())) {	
					// Puedo borrar una actividad UNICAMENTE si no tiene conductores asignados.
					if (drivers.size() == 0) {	
						// Si es MonsantoAdministrator, solo puede borrar la actividad
						// si es CommentaryDrive.
    					if (isCommentaryDrive) {
							if (userSessionData.checkPermission(SecurityConstants.DELETE_CD_ACTIVITY)  && userSessionData.canModifyActivityRegitry(data.getType().getResourceBundleId())) {
							line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
						<td style="width:50%">
							<img align="middle" border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
							<%
								String href1 = "javascript:setAction(document.forms['delete'],'delete');deleteIFConfirm(document.forms['delete'],'"+ messages.getText("generic.driver.driverdata.confirmdelete") + "');";
							%>
							<a href='<%=href1 %>' class="texts">
								<%=messages.getText("generic.messages.delete")%>
							</a>
						</td>	
					<%=(line) ? "</tr>" : "" %>							
<%							}
						}else {
							if (userSessionData.checkPermission(SecurityConstants.DELETE_CEPASCHEDULEACTIVITY)  && userSessionData.canModifyActivityRegitry(data.getType().getResourceBundleId())) {							
							line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
						<td style="width:50%">
        					<img align="middle" border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
        					<%
        					String href2 = "javascript:setAction(document.forms['delete'],'delete');deleteIFConfirm(document.forms['delete'],'" + messages.getText("generic.driver.driverdata.confirmdelete") + "');";
        					%>
							<a href='<%=href2%>' class="texts">
								<%=messages.getText("generic.messages.delete")%>
							</a>
						</td>								
					<%=(line) ? "</tr>" : "" %>							
<%							}
						}	
%>					</tr>
<%					}					
				}
				if((userSessionData.checkPermission(SecurityConstants.EDIT_CEPASCHEDULEACTIVITYREGISTRY) || 
						userSessionData.checkPermission(SecurityConstants.MODIFY_CD_ACTIVITY))
						&& !data.getIsOld()   && userSessionData.canModifyActivityRegitry(data.getType().getResourceBundleId()) && 
						!data.getState().getResourceBundleId().equals(CEPAActivityConstants.DICTADA)) {						
					if (!isCommentaryDrive) {
						if (userSessionData.checkPermission(SecurityConstants.EDIT_CEPASCHEDULEACTIVITYREGISTRY)
								|| (userSessionData.isGerente() && (definition.equals(CEPAActivityConstants.INITIAL_FOREIGN_EVALUATION)
								|| definition.equals(CEPAActivityConstants.SAFE_FLEET_MULTIPLIER_SPEECH)))) {

							if (userSessionData.isInstructor()){
								
								if (data.getState().getResourceBundleId().equals("datatype.scheduledactivitystate.prevista") 
										&& !data.getType().getResourceBundleId().equals(CEPAActivityConstants.SECURITY_TALK_KIDS)) { 
							line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
						<td style="width:50%">
							<img align="middle" border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
							<%
								String href3 = "layout.jsp?refer=/driver/DriverSearchForActivity.jsp?idActivity="+idActivity;
							%>
							<a href='<%=href3%>' class="texts">
								<%=messages.getText("generic.activity.addriver")%>
							</a>
						</td>
					<%=(line) ? "</tr>" : "" %>							
<%								} 
							}else {
								if (!data.getType().getResourceBundleId().equals(CEPAActivityConstants.SECURITY_TALK_KIDS)) { 
									line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
						<td style="width:50%">
							<img align="middle" border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
							<%
								String href4 = "layout.jsp?refer=/driver/DriverSearchForActivity.jsp?idActivity="+idActivity;
							%>
							<a href='<%=href4%>' class="texts">
								<%=messages.getText("generic.activity.addriver")%>
							</a>
						</td>		
					<%=(line) ? "</tr>" : "" %>							
<%								}
							}
						}							
					}
				}
				if((userSessionData.checkPermission(SecurityConstants.MODIFY_CEPASCHEDULEACTIVITY) || userSessionData.checkPermission(SecurityConstants.MODIFY_CD_ACTIVITY) )  && userSessionData.canModifyActivityRegitry(data.getType().getResourceBundleId())){								
							line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
						<td style="width:50%">
							<img align="middle" border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
							<a href="#" onClick="javascript:document.forms['divide'].submit()" class="texts" >
								<%=messages.getText("generic.messages.divideactivity")%>
							</a>
						</td>							
					<%=(line) ? "</tr>" : "" %>							
<%				}
				line = !line;
%>					<%=(!line) ? "<tr>" : "" %>							
						<td style="width:50%">
                			<img align="middle" border="0" src="/datacenter/util/imgs/icon2.gif" width="12">&nbsp;
							<a href="#" onClick="javascript:document.forms['cancel'].submit()" class="texts">
								<%=messages.getText("generic.messages.cancel")%>
							</a>
						</td>
					</tr>
					</table>
					<jsp:include page="../../component/utilitybox3bottom.jsp"/>
				</td>
			</tr>
  		<tr>
			<jsp:include  page="../../component/spaceline.jsp" />
  		</tr>   
	</table>
<%				}else {
%>	<jsp:include  page='<%="/util/allowedData.jsp?message=activity.error.access.activity" %>'/>
<%			}
		}else{
			dispatcher = request.getRequestDispatcher("/activity/schedule/CEPAActivityScheduleList.jsp");
			dispatcher.forward(request,response);	
		}
	}

	session.removeAttribute("ActivityForm"); 
%>	
