<%@page language="java"
	errorPage="../../exception.jsp"
	import="java.util.*"
	import="business.*"
	import="business.activity.*" 
	import="communication.language.*"
	import="communication.security.*"
	import="communication.administration.corporation.tables.*"
	import="communication.administration.corporation.tables.ItemData"
	import="communication.administration.user.tables.*"
	import="communication.activity.tables.*"
	import="communication.activity.tables.CEPAActivityConstants"
	import="communication.util.*"	
 	import="presentation.translator.web.util.*"
 	import="presentation.translator.web.activity.schedule.*"
	import="communication.administration.user.UserSessionData" 	
	import="communication.driver.tables.DriverData" 		
	import="communication.driver.tables.DriverData" 		
	import="presentation.translator.web.util.Util"
	import="communication.activity.tables.*"
%>

<%@ taglib uri="/WEB-INF/struts-html.tld"
        prefix="html"
%>

<%! RequestDispatcher dispatcher; 
	
	Text messages; 
	SystemAccess sys; 
	CEPAActivityScheduleData data; 
	ActivityReportFacade activityReport;
	UserSessionData userSessionData;		
	boolean isCommentaryDrive = false;
	Collection drivers = new LinkedList();
	
%>
<%
	sys = (SystemAccess)session.getAttribute("SystemAccess");
	
	String idDrivers = "";
	String idActivity = "";
	
	userSessionData =sys.getUserSessionData();
	
	String check = Util.checkPermission(sys,SecurityConstants.VIEW_CEPASCHEDULE_ACTIVITY);
	String check1 = Util.checkPermission(sys,SecurityConstants.MODIFY_CD_ACTIVITY);
	
	if ((check!=null) && (check1!=null))  {	
		response.sendRedirect(request.getContextPath()+check);
	}else {
		messages=sys.getText();

		dispatcher=request.getRequestDispatcher("/util/jsp/message.jsp");
		dispatcher.include(request,response);

		idActivity = request.getParameter("id");
		if(Util.empty(idActivity)) {
			idActivity = request.getParameter("idActivity"); // Refactoring.
			if (Util.empty(idActivity)){
		    	idActivity = (String)session.getAttribute("id");
		    	session.removeAttribute("id");
			}
		}
		
		// Refactoring:
		// session.setAttribute("url","activity/schedule/CEPAActivityScheduleView.jsp?id="+idActivity);
		userSessionData.setUrl("activity/schedule/CEPAActivityScheduleView.jsp?idActivity="+idActivity);
		
		if (session.getAttribute("from") != null) { //Variable seteada en la pg. de CommentaryForm y utilizada en VehicleCreateForm
			session.removeAttribute("from");
		}		
		
		if(idActivity != null){	
			session.setAttribute("target","ActivityView");

			activityReport=sys.getActivityReportFacade();
			data = activityReport.findCEPAActivityScheduleByPrimaryKey(new Integer(idActivity),userSessionData); 
			String definition = data.getDefinition().getResourceKeyName();
			boolean hasNewReports = data.hasNewReports();
			if(data != null) {
				drivers = activityReport.getParticipants(new Integer(idActivity),userSessionData);
				
				// Veo si es o no una Actividad de Tipo: Commentary Drive 
				// o que tenga un unico driver y pase automaticamente a estado dictada	
				isCommentaryDrive =	( definition.equals(CEPAActivityConstants.COMMENTARYDRIVE) || 
						definition.equals(CEPAActivityConstants.COMMENTARYDRIVEOTHER) ||
						definition.equals(CEPAActivityConstants.COMMENTARYDRIVEHIGHRISK) ||
						definition.equals(CEPAActivityConstants.COMMENTARYDRIVEARGENTINA) ||
						definition.equals(CEPAActivityConstants.COMMENTARYDRIVE_NOVARTIS) ||
						definition.equals(CEPAActivityConstants.COMMENTARYDRIVE_JJ2) ||
						definition.equals(CEPAActivityConstants.COMMENTARYDRIVE_RENOVATION) ||
						definition.equals(CEPAActivityConstants.INITIAL_FOREIGN_EVALUATION) ||
						definition.equals(CEPAActivityConstants.COMMENTARYDRIVEARGENTINA_NUEVO) ||
									
									// CEPA SYSTEM ENTRENADORES, un unico driver (y pasa a dictada automaticamente, no va mas)
									// pero no Pepsico, cambio solicitado el 19/10/2010 por Dennis
									(definition.equals(CEPAActivityConstants.CEPA_SYSTEM_COURSE_2_ENTRENADORES)
										&& data.getCorpooration().getId().intValue() != CorporationData.PEPSICO 
										&& data.getCorpooration().getId().intValue() != CorporationData.CEPA)						
									) ;
			
				ActivityForm activityForm = ActivityUtil.createActivityForm(data,ActivityUtil.VIEW,messages);
				session.setAttribute("ActivityForm",activityForm); 

				if(session.getAttribute("Breadcrumb") != null) {
				    Hashtable parameters = new Hashtable();
				    parameters.put("id",data.getActivityId().toString());
				    parameters.put("name",messages.getText(definition)+" "+Util.formatDate(data.getDate()));
				    ((Breadcrumb)session.getAttribute("Breadcrumb")).addItem(Breadcrumb.ACTIVITY_EDIT,parameters);
				}
				
				// Link para agregar instructores a la actividad>
				String hrefInstructor = "layout.jsp?refer=/user/InstructorSearchForActivity.jsp?idActivity="+idActivity; 
%>

<%@page import="communication.administration.RoleData"%><script language="javascript" src='/datacenter/menu/js/driverFunctions.js' type='text/javascript' >
</script>
<script language="javascript" src='/datacenter/util/js/Prepared_Parameters.js' type='text/javascript' >
</script>
<script type="text/javascript" language="javascript" >
	function reportAllPDF(form){		
		<% 
			idDrivers ="";
			if (drivers.size() > 0){
				Iterator it = drivers.iterator();
				while (it.hasNext()){
					DriverData driver = (DriverData)it.next();
					idDrivers += driver.getId().toString()+";";
				}
				idDrivers = idDrivers.substring(0,idDrivers.length()-1);
			}
		%>
		
		form.idDrivers.value = '<%=idDrivers%>';
		form.idActivity.value = '<%=idActivity%>';
		form.activityType.value = '<%=data.getType().getResourceBundleId()%>';
		form.checklist.value = '<%=data.getDefinition().getCheckList().getId().toString()%>';
		form.submit();	
	}	
	
	function setAction(form,action){
		form.action.value=action;
	}
	
	function deleteIFConfirm(form,msg){
		form.submit();
	} 
	
	function setDelete(form,action){
		if(preparedCheckboxParameters(form)) {
			form.action.value=action;
			form.submit();
		}
	}
	function openCertificate(driver) {
		var form = document.forms['ActivityCertificateForm'];
		form.driver.value = driver;
		form.submit();
	}
	function openNewReport(driver,type) {
		var form = document.forms['ActivityReportFormVersion2'];
		form.driver.value = driver;
		form.type.value = type;
		form.submit();
	}
	function openCarnet(driver) {
		var form = document.forms['ActivityCarnetForm'];
		form.driver.value = driver;
		form.submit();
	}
	
	function reportAll(form1,form2,action){
		var list="";		
		var elements=form1.elements;
		for(i = 0; i < elements.length; i++){
			var element=elements[i];
			if(element.type.toLowerCase()=="checkbox"){
				if(element.checked){
					if(list==""){
						list=element.value;
					}else{
						list=element.value+"<"+list;
					}	
				}	
			} 		
		}
		if(list.length > 0){
			form2.idDrivers.value=list;
			form2.submit();
		}
	}
</script>
