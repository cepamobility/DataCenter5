   				<jsp:include  page='<%="../../component/titlecomponent.jsp?colspan=3&title="+messages.getText("web.activity.view")			+" "+messages.getText(data.getType().getResourceBundleId())+" "+messages.getText(data.getCountryName())+" " + Util.formatDate(data.getDate()) %>' />			
