package presentation.translator.web.vehicle;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

import org.apache.struts.action.ActionForm;
import org.apache.struts.action.ActionForward;
import org.apache.struts.action.ActionMapping;

import presentation.translator.web.util.AbstractAction;
import business.SystemAccess;
import business.vehicle.VehicleABMFacade;

import communication.administration.corporation.tables.CorporationData;
import communication.administration.user.UserSessionData;
import communication.language.Text;
import communication.vehicle.tables.VehicleData;

/**
 * @author adocarmo
 *
 * TODO To change the template for this generated type comment go to
 * Window - Preferences - Java - Code Style - Code Templates
 */
public class VehicleCreateAction extends AbstractAction {
	
	/**
	 * Log this class
	 */
		
	public ActionForward action(ActionMapping mapping, ActionForm form, HttpServletRequest request, HttpServletResponse response) throws Exception {
			
        HttpSession session = request.getSession();
        SystemAccess sys = ((SystemAccess)session.getAttribute("SystemAccess"));
        Text messages = sys.getText();
		UserSessionData userSessionData = sys.getUserSessionData();
		
		VehicleForm createData = (VehicleForm)form;
		
		//Control de matricula (elimina los caracteres especiales y los espacios) 
		String matricula = VehicleUtil.getCleanMatricula(createData.getMatricula());
		createData.setMatricula(matricula);
		
		createData.setDriver(null);
		if (session.getAttribute("driverId") !=null) {		
			createData.setDriver((String) session.getAttribute("driverId"));
			createData.setUse("persistence.datatype.typeuse.individual");
		}					
		else {
			createData.setUse("persistence.datatype.typeuse.institutional");
		}
				
		String message = createData.validate(userSessionData); 

		if(message != null) {				
		    //Some attribute data is invalid	
			//Si en el struts config indico que el form es de sesion la línea de abajo es inneseraria
		    session.setAttribute("VehicleCreateFormNew",createData);			
			session.setAttribute("Msg", messages.getText(message));
			return mapping.findForward("create");		
		}
		
		// Si ya existe un vehiculo con igual matricula en el mismo pais no 
		// permite la creación de otro 
		message = VehicleUtil.vehicleExist(sys,createData,userSessionData);
		if(message != null) {				
			    //Some attribute data is invalid
			    //Si en el struts config indico que el form es de sesion la línea de abajo es inneseraria			
			    session.setAttribute("VehicleCreateFormNew",createData);			
				session.setAttribute("Msg", messages.getText(message));
				return mapping.findForward("create");
		}
		
		
		/* Valido campos opcionales: */
		if (sys.getCorporationId() == CorporationData.KLABIN){
				
			message = VehicleUtil.validateVehicleOptionalInfo(sys,createData,userSessionData);
			if(message != null) {				
			    //Some attribute data is invalid
			    session.setAttribute("VehicleCreateFormNew",createData);			
				session.setAttribute("Msg", messages.getText(message));
				return mapping.findForward("create");
			}
		}		
		
		
		
		VehicleData vehicle = VehicleUtil.createVehicleData(userSessionData,createData);
		VehicleABMFacade vehicleABM = null;
			
		//Access VehicleABMFacade
		vehicleABM = sys.getVehicleABMFacade();				
		vehicleABM.vehicleCreate(vehicle,createData.getComment(),userSessionData);					
				
		// 	Clean session
		session.removeAttribute("VehicleCreateFormNew");		
		session.removeAttribute("driverId");					
		session.removeAttribute("useType");
					
		return mapping.findForward("success");
	}
			
    public ActionForward cancel(HttpSession session,ActionMapping mapping, ActionForm form) {
		// 	Clean session
		session.removeAttribute("VehicleCreateFormNew");			
		session.removeAttribute("driverId");					
		session.removeAttribute("useType");
		
        return mapping.findForward("VehicleList");
    }    

}
