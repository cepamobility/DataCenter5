<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">


<hibernate-mapping package="persistence.driver.tables">
	<class name="AlcoholControl" table="alcoholcontrols">
		
       	<composite-id class="AlcoholControlPK" name="pk" >
       		<key-many-to-one
       			 name="driver"
       			 column="id"
       			 class="Driver"
       	 	/>
	        <key-property 	name="date"	type="java.util.Date"	column="date" />
		</composite-id>
		
        <property column="result" name="result" type="java.lang.Integer" not-null="true" />
		
  	</class>
</hibernate-mapping>
