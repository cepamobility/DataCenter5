 		}
 		
 	 
     }
   			
   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator, drivercreate, cepascheduleactivitysupervise, jjreporter, systemaccess"
   	 * Create driver account
     * @throws Exception
     * 
   	 */
   	public PointAccountData saveDriverAccount(Integer driver, Integer corporation, UserSessionData userSession) throws Exception {
   		try{
   			PointAccount account = new PointAccount();
   			account.setReference(driver);
   			if(corporation.equals(CorporationData.MONTES_DE_PLATA)) {
   				account.setTotal(new Double(100));
   			}else {
   				account.setTotal(new Double(0));
   			}
   			account.setCreated(Calendar.getInstance().getTime());
   			account.setType(1);
   			account.setId((Integer)HibernateUtil.currentSession().save(account));
   			return account.getData();
   		} catch (Exception e) {
			Object[] parameters = {driver};
    		handler.getException(e,"saveDriverAccount",userSession,parameters);
    	}	
   		return null;
   	}
   	
   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,dpachecklist"
   	 * Create driver account
     * @throws Exception
     * 
   	 */
   	public PointAccountData saveVehicleAccount(Integer vehicle, UserSessionData userSession) throws Exception {
   		try{
   			PointAccount account = new PointAccount();
   			account.setReference(vehicle);
   			if(userSession.getCorporationId()==CorporationData.FORESTALORIENTAL){
   				account.setTotal(new Double(100));	
   			}
   			account.setCreated(Calendar.getInstance().getTime());
   			account.setType(2);
   			account.setId((Integer)HibernateUtil.currentSession().save(account));
   			
   			return account.getData();
   		} catch (Exception e) {
			Object[] parameters = {vehicle};
    		handler.getException(e,"saveVehicleAccount",userSession,parameters);
    	}	
   		return null;
   	}
   	
	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,systemaccess,pointconfupdate,dpachecklist,dpachecklist, drivercreate,cepascheduleactivitycreate,cepascheduleactivityupdate"
   	 *  
     * @throws Exception
     * 
   	 */
   	public void savePointMove(PointMoveData moveData, UserSessionData userSession) throws Exception{
   		try{
   			Session session = HibernateUtil.currentSession();
   			PointMove move=new PointMove(moveData);
   			Integer id = (Integer)session.save(move);
   			
   			if(userSession.isCorporation(CorporationData.MONTES_DE_PLATA)) {
   				Query q = session.createSQLQuery("SELECT d.id, divorg1 AS c FROM drivers d JOIN pointaccount pa on pa.reference = d.id WHERE pa.type = 1 AND d.corporation = "+CorporationData.MONTES_DE_PLATA+" AND pa.id = "+move.getAccount()+" AND d.exclusiondate IS NULL");
   				Iterator driverIt = q.list().iterator();
   				if(driverIt.hasNext()) {
   					Object[] data = (Object[])driverIt.next();
   					ContractorPoint contractorPoint = new ContractorPoint(null,(Integer)data[1],(Integer)data[0],id,moveData.getAmount(),moveData.getDate().getTime());
   					session.save(contractorPoint);
   				}
   			}
   		} catch (Exception e) {
			Object[] parameters = {moveData};
    		handler.getException(e,"savePointMove",userSession,parameters);
    	}	
   	}
   	
