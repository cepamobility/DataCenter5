    public void createOrUpdateUnconformityDPA(UnconformityDPAData data, UserSessionData userSessionData) throws Exception {
    	try{       
    		Session session = HibernateUtil.currentSession();
    		UnconformityDPA unconformity=new UnconformityDPA();
    		unconformity.setCorpId(userSessionData.getCorporationId());
    		if(data.getId()!=null && data.getId()>0){
    			unconformity=(UnconformityDPA)session.load(UnconformityDPA.class, data.getId());
    		}else{
    			if(data.getType().getResourceBundleId().equals(UnconformityTypeDPADataType.TYPE_VEHICLE_CHECK)){
    				//Controlo que no exista una ya y si existe se actualiza
    				Query query=session.createQuery("select id from UnconformityDPA where check="+data.getCheck());
		            List aux=query.list();
		            Iterator iter= aux.iterator();
		            if(aux.size()>0){
		            	unconformity=(UnconformityDPA)session.load(UnconformityDPA.class, (Integer)iter.next());
		            }
		    	}else{
    				//Controlo que no exista una ya y si existe se actualiza
    				/*Query query=session.createQuery("select id from UnconformityDPA where driverId="+data.getDriverId());
		            List aux=query.list();
		            Iterator iter= aux.iterator();
		            if(aux.size()>0){
		            	unconformity=(UnconformityDPA)session.load(UnconformityDPA.class, (Integer)iter.next());
		            }*/
		    	}
    		}
    		
    		unconformity.updateData(data);
    		session.saveOrUpdate(unconformity);
    		
       	} catch (Exception e) {
       		e.printStackTrace();
			Object[] parameters = {data};
    		handler.getException(e,"createOrUpdateUnconformityDPA",userSessionData,parameters);
    	}

    }
    
    /**
     * Returns menu options.
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,vehicleview,driverview,cepascheduleactivitycreate,cdactivitycreate,vehicleview,driverview,vehiclechecklist,dpachecklist"
	 * @throws Exception
	 */
    public void createOrUpdateCorrectiveActionDPA(CorrectiveActionDPAData data, UserSessionData userSessionData) throws Exception {
    	try{       
    		Session session = HibernateUtil.currentSession();
    		CorrectiveActionDPA correctiveAction=new CorrectiveActionDPA(data);
    		if(data.getId()!=null && data.getId()>0){
    			correctiveAction=(CorrectiveActionDPA)session.load(CorrectiveActionDPA.class, data.getId());
    		}
    		correctiveAction.updateData(data);
    		session.saveOrUpdate(correctiveAction);
    		
    		Iterator iter=data.getImages().iterator();
    		while(iter.hasNext()){
    			CorrectiveActionImageDPAData imageData=(CorrectiveActionImageDPAData)iter.next();
    			if(imageData.getInputStream()!=null){
		    		String fileName="CA_"+correctiveAction.getId()+"_"+imageData.getFileName();
		            Iterator iter2=correctiveAction.getImages().iterator();
		            while(iter2.hasNext()){
		            	CorrectiveActionImageDPA iAux=(CorrectiveActionImageDPA)iter2.next();
		            	if(iAux.getImageName().equals(imageData.getFileName())){
		            		iAux.setImageName(fileName);
		            		break;
		            	}
		            }
		            File fileDelete=new File(AlertConstants.TEMP_DIRECTORY_IMAGE_DPA+fileName);
			        if(fileDelete.exists()){
			        	fileDelete.delete();
			        }
			        
		            FileOutputStream fout;
					
					InputStream reportStream = imageData.getInputStream();
					fout = new FileOutputStream(AlertConstants.TEMP_DIRECTORY_IMAGE_DPA+fileName);
					
					int c = 0;
					while ( (c=reportStream.read()) != -1){
						fout.write(c);
					}			
					fout.flush();
					fout.close();
    			}
				
    		}
    		
    		session.saveOrUpdate(correctiveAction);
    		
       	} catch (Exception e) {
			Object[] parameters = {data};
    		handler.getException(e,"createOrUpdateCorrectiveActionDPA",userSessionData,parameters);
    	}

    }
    
   
    
