   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,dpachecklist,systemaccess"
   	 *  
   	 *  reasonCode:
   	 *  -1:Para estado ACTIVO sin penalizacion
   	 *     0: OTROS FO (Ej: documentación)
     *     1: CEPA-Puntos
     *     2: CEPA-No Conformidad
     *
     *  typeOfPenalty:    
     *  -1:Para estado ACTIVO sin penalizacion
   	 *     0: Indeterminada
     *     1: Por tiempo
     *
     * @throws Exception
     * 
   	 */
   	public void suspendedPlateFOSAAsync(Integer vehicle,Double totalLessPoints, Double accountTotal, String plateIn,Integer hours,String reasonDescription,Integer reasonCode,String dateHourStartPenalty,Integer typeOfPenalty, UserSessionData userSession) throws Exception{
   		try{
   		
   			Session session=HibernateUtil.currentSession();
   			
   			FOSAAsyncCall call=new FOSAAsyncCall();
   			call.setReference(vehicle);
   			call.setCallDate(null);
   			call.setCount(0);
   			call.setHours(hours);
   			call.setPlate(plateIn);
   			call.setReasonCode(reasonCode);
   			call.setReasonDescription(reasonDescription);
   			call.setTypeOfPenalty(typeOfPenalty);
   			call.setAccountTotal(accountTotal);
   			call.setTotalLessPoints(totalLessPoints);
   			call.setDateHourStartPenalty(dateHourStartPenalty);
   			
   			
   			session.save(call);
   		}
   		catch (Exception e) {
			Object[] parameters = {plateIn};
    		handler.getException(e,"suspendedPlate",userSession,parameters);
    	}	
   		
   	}
   	
   	
   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,dpachecklist,systemaccess"
   	 *  
   	 *  reasonCode:
   	 *  -1:Para estado ACTIVO sin penalizacion
   	 *     0: OTROS FO (Ej: documentación)
     *     1: CEPA-Puntos
     *     2: CEPA-No Conformidad
     *
     *  typeOfPenalty:    
     *  -1:Para estado ACTIVO sin penalizacion
   	 *     0: Indeterminada
     *     1: Por tiempo
     *
     * @throws Exception
     * 
   	 */
   	public WSResultData suspendedPlate(String plateIn,Integer hours,String reasonDescription,Integer reasonCode,String dateHourStartPenalty,Integer typeOfPenalty, UserSessionData userSession) throws Exception{
   		WSResultData result=new WSResultData(0,"OK");
   		try{
   			
   			System.out.println("FOSA,MDP:suspendedPlate matricula "+plateIn+", hours "+hours+", reasonDescription:"+reasonDescription+",reasonCode:"+reasonCode+",dateHourStartPenalty="+dateHourStartPenalty+",typeOfPenalty="+typeOfPenalty);
   			
   			if(plateIn!=null){//Si no viene matricula se descarta
   				String plate=plateIn.toUpperCase().replaceAll(" ","");
   				VehicleReport vehicleReport =VehicleReportUtil.getHome().create();
   	   			VehicleData vehicle=vehicleReport.findVehicleByPlateInCorporation(plate, userSession);
   	   			if(vehicle!=null){
    	   			VehicleState state=getOrCreateVehicleState(vehicle);
    	   			Date startDate=Util.getDate(dateHourStartPenalty,"dd/MM/yyyy HH:mm:ss");
    	   			if(startDate==null){
    	   				result.setCode(3);
   	   					result.setDescription("Valor invalido para dateHourStartPenalty, el formato permitido es dd/MM/yyyy HH:mm:ss , ver http://docs.oracle.com/javase/7/docs/api/java/text/SimpleDateFormat.html");
    	   				throw new GenericException("Valor invalido para dateHourStartPenalty, el formato permitido es dd/MM/yyyy HH:mm:ss , ver http://docs.oracle.com/javase/7/docs/api/java/text/SimpleDateFormat.html","");
    	   			}
    	   			
    	   		
    	   			if(reasonDescription==null || reasonDescription.trim().length()==0){
    	   				result.setCode(5);
   	   					result.setDescription("Valor invalido para reasonDescription,tiene que ser un valor no nulo ni vacio");
    	   				throw new GenericException("Valor invalido para reasonDescription,tiene que ser un valor no nulo ni vacio","");
    	   			}
    	   			if(reasonCode==null || reasonCode<0){
    	   				result.setCode(6);
   	   					result.setDescription("Valor invalido para reasonCode,tiene que ser un valor mayor o igual a 0");
    	   				throw new GenericException("Valor invalido para reasonCode,tiene que ser un valor mayor o igual a 0","");
    	   			}
    	   			
    	   			if(!(typeOfPenalty.equals(VehicleStateData.TYPEOFPENALTY_CODE_INDETERMINATE) || typeOfPenalty.equals(VehicleStateData.TYPEOFPENALTY_CODE_TIME))){
   	   					result.setCode(7);
   	   					result.setDescription("Valor invalido para typeOfPenalty, solo se permite 0-Indeterminada, 1-Por tiempo");
   	   					throw new GenericException("Valor invalido para typeOfPenalty, solo se permite 0-Indeterminada, 1-Por tiempo","");
   	   				}
    	   			if(typeOfPenalty.equals(VehicleStateData.TYPEOFPENALTY_CODE_INDETERMINATE)){
    	   				hours=0;
    	   			}
    	   			if( typeOfPenalty.equals(VehicleStateData.TYPEOFPENALTY_CODE_TIME)){
    	   				if(hours==null || hours<0){
        	   				result.setCode(4);
       	   					result.setDescription("Valor invalido para hours,tiene que ser un valor mayor o igual a 0");
        	   				throw new GenericException("Valor invalido para hours,tiene que ser un valor mayor o igual a 0","");
        	   			}
    	   			}
    	   			
    	   			//Controlo que la matricula no tenga ya una suspension y si la tiene me quedo con la mas larga
    	   			boolean useNewState=false;
    	   			if(!state.getReasonCode().equals(VehicleStateData.RASON_CODE_NONE)){
    	   				//Esta suspendido
    	   				System.out.println("FOSA,MDP:suspendedPlate matricula ya suspendida");
    	   				if(state.getTypeOfPenalty().equals(VehicleStateData.TYPEOFPENALTY_CODE_TIME)){
    	   					Calendar calStateSuspended=Calendar.getInstance();
    	   					calStateSuspended.setTime(state.getStateDate());
    	   					calStateSuspended.add(Calendar.HOUR, state.getHours());
    	   					if(typeOfPenalty.equals(VehicleStateData.TYPEOFPENALTY_CODE_INDETERMINATE)){
    	   						
    	   						useNewState=true;
    	   	   				}else if(typeOfPenalty.equals(VehicleStateData.TYPEOFPENALTY_CODE_TIME)){
    	   	   					Calendar calNewStateSuspended=Calendar.getInstance();
    	   	   					calNewStateSuspended.setTime(startDate);
    	   	   					calNewStateSuspended.add(Calendar.HOUR, hours);
    	   	   					if(calNewStateSuspended.compareTo(calStateSuspended)>=0){
    	   	   						useNewState=true;
    	   	   					}
    	   	   				}
    	   				}else if(state.getTypeOfPenalty().equals(VehicleStateData.TYPEOFPENALTY_CODE_INDETERMINATE)){
    	   						useNewState=true;
    	   	   			}
    	   			}else{
    	   				useNewState=true;
    	   			}
    	   			if(useNewState){
    	   				state.setStateDate(startDate);
        	   			state.setHours(hours);
        	   			state.setReasonCode(reasonCode);
        	   			state.setReasonDescription(reasonDescription);
        	   			state.setTypeOfPenalty(typeOfPenalty);
        	   			
       	   				if(typeOfPenalty.equals(VehicleStateData.TYPEOFPENALTY_CODE_INDETERMINATE)){
       	   					state.setState(VehicleStateData.SUSPENDED_INDETERMINATE);
       	   				}else if(typeOfPenalty.equals(VehicleStateData.TYPEOFPENALTY_CODE_TIME)){
       	   					state.setState(VehicleStateData.SUSPENDED_HOURS);
       	   				}
       	   				System.out.println("FOSA,MDP:suspendedPlate se salva nuevo estado");
       	   				saveNewVehicleStateHistory(state);
    	   			}else{
    	   				System.out.println("FOSA,MDP:suspendedPlate se deja suspencion anterior y se guarda estado en el historico");
    	   				//Este caso es en el que no se afecta el estado actual pero si se gurda en el historial, porque puede que se levante
    	   				//la penalizacion anterior y entre en vigor esta
    	   				//Caso de ej: Estado actual suspendido por no conformidades, llega nueva suspension por puntos de 72hs, antes de que pasen las 72hs 
    	   				 //se levanta la suspension indeterminada y se tiene que suspender por puntos
    	   				if(typeOfPenalty.equals(VehicleStateData.TYPEOFPENALTY_CODE_INDETERMINATE)){
    	   					addNewVehicleStateHistory(state, VehicleStateData.SUSPENDED_INDETERMINATE, startDate, hours, reasonCode, reasonDescription, typeOfPenalty); 
       	   				}else if(typeOfPenalty.equals(VehicleStateData.TYPEOFPENALTY_CODE_TIME)){
       	   					addNewVehicleStateHistory(state, VehicleStateData.SUSPENDED_HOURS, startDate, hours, reasonCode, reasonDescription, typeOfPenalty);
       	   				}
    	   				
    	   			}
    	   			
   	   			}else{
   	   				System.out.println("CorporationABMBean.suspendedPlate: No existe placa  "+plateIn);
   	   				result.setCode(2);
   	   				result.setDescription("No existe vehiculo con placa "+plateIn);
   	   			}
   			}
   			
   		}
   		catch(GenericException ge){
   			System.out.println("CorporationABMBean.suspendedPlate:ERROR AL INVOCAR("+plateIn+")  "+ge.getMsg());
   			throw ge; 
   			
   		}
   		catch (Exception e) {
			Object[] parameters = {plateIn};
    		handler.getException(e,"suspendedPlate",userSession,parameters);
    		result.setCode(1);
    		result.setDescription(e.getMessage());
    	}	
   		
   		return result;
   	}
   	
	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,dpachecklist,systemaccess"
   	 *  
   	 *  reasonCode:
   	 *  -1:Para estado ACTIVO sin penalizacion
   	 *     0: OTROS FO (Ej: documentación)
     *     1: CEPA-Puntos
     *     2: CEPA-No Conformidad
     *
     *  typeOfPenalty:    
     *  -1:Para estado ACTIVO sin penalizacion
   	 *     0: Indeterminada
     *     1: Por tiempo
     *
     * @throws Exception
     * 
   	 */
   	public WSResultData activePlate(String plateIn,UserSessionData userSession) throws Exception{
   		WSResultData result=new WSResultData(0,"OK");
   		try{
   			
   			if(plateIn!=null){//Si no viene matricula se descarta
   				String plate=plateIn.toUpperCase().replaceAll(" ","");
   				VehicleReport vehicleReport =VehicleReportUtil.getHome().create();
   	   			VehicleData vehicle=vehicleReport.findVehicleByPlateInCorporation(plate, userSession);
   	   			if(vehicle!=null){
    	   			VehicleState state=getOrCreateVehicleState(vehicle);
    	   			state.activate();
    	   			saveNewVehicleStateHistory(state);
   	   			}else{
   	   				System.out.println("CorporationABMBean.activePlate: No existe placa  "+plateIn);
   	   				result.setCode(2);
   	   				result.setDescription("No existe vehiculo con placa "+plateIn);
   	   			}
   			}
   		}
   		catch(GenericException ge){
   			System.out.println("CorporationABMBean.activePlate:ERROR AL INVOCAR("+plateIn+")  "+ge.getMsg());
   		}
   		catch (Exception e) {
   			
			Object[] parameters = {plateIn};
    		handler.getException(e,"suspendedPlate",userSession,parameters);
    		result.setCode(1);
    		result.setDescription(e.getMessage());
    	}	
   		
   		return result;
   	}
   	
   	
   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,dpachecklist,systemaccess"
     * 
   	 */
   	public WSResultData newDriverState(String ci,DriverStateHistoryData data,UserSessionData userSession) throws Exception{
   		WSResultData result=new WSResultData(0,"OK");
   		try{
   			
   			if(ci!=null){//Si no viene matricula se descarta
   				String ciplana=ci.toUpperCase().replaceAll(" ","").replaceAll("-","").replaceAll("\\.","");
   				DriverReport driverReport =DriverReportUtil.getHome().create();
   				Iterator iter=driverReport.findDriverByCorporationId(ciplana, userSession).iterator();
   				if(iter.hasNext()){
   	   	   			DriverData driver=(DriverData)iter.next();
   	   	   			if(driver!=null){
   	    	   			DriverState state=getOrCreateDriverState(driver);
	   	    	   		state.setState(data.getState());
	   	    	   		state.setReasonDescription(data.getReasonDescription());
	   	    	   		state.setStateDate(data.getStateDate());
	   	    	   		
   	    	   			saveNewDriverStateHistory(state);
   	   	   			}else{
   	   	   				System.out.println("CorporationABMBean.newDriverState: No existe ci  "+ci);
   	   	   				result.setCode(2);
   	   	   				result.setDescription("No existe conductor con ci "+ci);
   	   	   			}
   				}
   			}
   		}
   		catch(GenericException ge){
   			System.out.println("CorporationABMBean.newDriverState:ERROR AL INVOCAR("+ci+")  "+ge.getMsg());
   		}
   		catch (Exception e) {
   			
			Object[] parameters = {ci,data};
    		handler.getException(e,"newDriverState",userSession,parameters);
    		result.setCode(1);
    		result.setDescription(e.getMessage());
    	}	
   		
   		return result;
   	}
   	
   	
 	
   	/**
   	 * @param state
   	 * @throws Exception
   	 */
   	private void saveNewDriverStateHistory(DriverState state)throws Exception{
   		Session session = HibernateUtil.currentSession();
   		DriverStateHistory history=new DriverStateHistory();
   		history.setState(state.getState());
   		history.setStateDate(state.getStateDate());
   		history.setReasonDescription(state.getReasonDescription());
			
   		if(state.getHistory()!=null){
   			state.setHistory(new HashSet<DriverStateHistory>());
   		}
   		state.getHistory().add(history);
   		session.update(state);
   		System.out.println("MDP:saveNewDriverStateHistory ci "+state.getDriver().getCorporationId()+" se salva nuevo estado "+state.getState());
			
   	}
   	
   	
   	
   	/**
   	  *  reasonCode:
   	  *    -1:Para estado ACTIVO sin penalizacion
   	 *     0: OTROS FO (Ej: documentación)
     *     1: CEPA-Puntos
     *     2: CEPA-No Conformidad
     *	   Pueden veni otros, es un campo libre
     *  typeOfPenalty:    
     *  -1:Para estado ACTIVO sin penalizacion
   	 *     0: Indeterminada
     *     1: Por tiempo
   	 * @param state
   	 * @throws Exception
   	 */
   	private void saveNewVehicleStateHistory(VehicleState state)throws Exception{
   		Session session = HibernateUtil.currentSession();
   		VehicleStateHistory history=new VehicleStateHistory();
   		history.setState(state.getState());
   		history.setStateDate(state.getStateDate());
   		history.setHours(state.getHours());
   		history.setReasonCode(state.getReasonCode());
   		history.setReasonDescription(state.getReasonDescription());
		history.setTypeOfPenalty(state.getTypeOfPenalty());
			
   		if(state.getHistory()!=null){
   			state.setHistory(new HashSet<VehicleStateHistory>());
   		}
   		state.getHistory().add(history);
   		session.update(state);
   		System.out.println("FOSA:saveNewVehicleStateHistory matricula "+state.getVehicle().getMatricula()+" se salva nuevo estado "+state.getState());
			
   	}
   	
   	/**
  	  *  reasonCode:
  	  *    -1:Para estado ACTIVO sin penalizacion
  	 *     0: OTROS FO (Ej: documentación)
    *     1: CEPA-Puntos
    *     2: CEPA-No Conformidad
    *	   Pueden veni otros, es un campo libre
    *  typeOfPenalty:    
    *  -1:Para estado ACTIVO sin penalizacion
  	 *     0: Indeterminada
    *     1: Por tiempo
  	 * @param state
  	 * @throws Exception
  	 */
  	private void addNewVehicleStateHistory(VehicleState state,String stateStr,Date stateDate,Integer hours, Integer reasonCode,String reasonDescription,Integer typeOfPenalty)throws Exception{
  		Session session = HibernateUtil.currentSession();
  		VehicleStateHistory history=new VehicleStateHistory();
  		history.setState(stateStr);
  		history.setStateDate(stateDate);
  		history.setHours(hours);
  		history.setReasonCode(reasonCode);
  		history.setReasonDescription(reasonDescription);
		history.setTypeOfPenalty(typeOfPenalty);
			
  		if(state.getHistory()!=null){
  			state.setHistory(new HashSet<VehicleStateHistory>());
  		}
  		state.getHistory().add(history);
  		session.update(state);
  	}
  	
  	
	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,dpachecklist,vehicleview"
   	 * 
   	 */
   	public DriverState getOrCreateDriverState(DriverData driver) throws Exception{
    	 Session session = HibernateUtil.currentSession();
   		 Query queryState=session.createQuery("select s from DriverState as s where s.driver.id="+driver.getId());
		 List list=queryState.list();
		 DriverState vstate=new DriverState();
		 if(list.iterator().hasNext()){
			 vstate = (DriverState)list.iterator().next();
		 }else{
		 	 vstate.setState(DriverStateData.ACTIVE);
			 vstate.setStateDate(driver.getInclusionDate()!=null?driver.getInclusionDate():new Date());
			 vstate.setReasonDescription("ACTIVO");
			 vstate.setDriver((Driver)session.load(Driver.class, driver.getId()));
			 session.save(vstate);
			 saveNewDriverStateHistory(vstate);
		 }
		 
		 return vstate;
   	}
   	
   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,dpachecklist,vehicleview"
   	 *   SOLO ES PARA USARSE EN CAPA PERSISTENCIA
   	 *  reasonCode:
   	 *     0: OTROS FO (Ej: documentación)
     *     1: CEPA-Puntos
     *     2: CEPA-No Conformidad
     *
     *  typeOfPenalty:    
   	 *     0: Indeterminada
     *     1: Por tiempo
     *
     * @throws Exception
     * 
   	 */
   	public VehicleState getOrCreateVehicleState(VehicleData vehicle) throws Exception{
    	 Session session = HibernateUtil.currentSession();
   		 Query queryState=session.createQuery("select s from VehicleState as s where s.vehicle.id="+vehicle.getId());
		 List list=queryState.list();
		 VehicleState vstate=new VehicleState();
		 if(list.iterator().hasNext()){
			 vstate = (VehicleState)list.iterator().next();
		 }else{
		 	 vstate.setState(VehicleStateData.ACTIVE);
			 vstate.setStateDate(vehicle.getInclusionDate()!=null?vehicle.getInclusionDate():new Date());
			 vstate.setVehicle((Vehicle)session.load(Vehicle.class, vehicle.getId()));
			 session.save(vstate);
			 saveNewVehicleStateHistory(vstate);
		 }
		 
		 return vstate;
   	}
   	
