	 */
	public void deleteCorporationMenuItems(UserSessionData userSession) throws Exception {
	
        if (userSession == null) {
            throw new DeslogedException("deleteCorporationMenuItems","userRequest = null");
        }
		try {
			Session session = HibernateUtil.currentSession();
			session.createQuery("DELETE FROM CorporationMenu menu WHERE menu.pk.corporation = "+userSession.getCorporationId()).executeUpdate();
			
			
		}catch (Exception e) {
