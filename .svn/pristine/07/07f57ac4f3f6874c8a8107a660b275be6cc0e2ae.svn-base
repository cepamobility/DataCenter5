    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,vehicleupdate,vehicledelete,vehiclercreate"
	 * @throws Exception
	 */
    public void createLevelOfServiceVehicleDPA(LevelOfServiceVehicleDPAData data, UserSessionData userSessionData) throws Exception {
    	try{
    		Session session = HibernateUtil.currentSession();
    		
    		LevelOfServiceVehicleDPA levelOfService=new LevelOfServiceVehicleDPA(data);
    		
    		session.save(levelOfService);    		
    		
    		//Hay que actualizar los datos del vehicle pero se tiene que corroborar que el nuevo nivel de servicio
    		//tiene efectivamente la fecha mas nueva porque se puede estar dando de alta un nivel de servicio en el "pasado"
    		//en cuyo caso no se debe ctualizar los datos del driver.
    		Query query2=session.createQuery("select c from LevelOfServiceVehicleDPA as c where c.vehicleId="+data.getVehicleId()+" and c.date in(select max(c2.date)  from LevelOfServiceVehicleDPA as c2 where c2.vehicleId=c.vehicleId)");
    		List auxList=query2.list();
    		boolean updateVehicle=false;
    		if(auxList.size()>0){
    			LevelOfServiceVehicleDPA cAux=(LevelOfServiceVehicleDPA)auxList.iterator().next();
    			if(cAux.getDate().compareTo(data.getDate())<=0){
    				//Tiene una fecha mayor a la de todos los niveles de servicio
    				updateVehicle=true;
    			}
    		}else{
    			//Es el primer nivel de servicio
    			updateVehicle=true;
    		}
    		
    		if(updateVehicle){
    			Query query=session.createQuery("select d from Vehicle as d where d.id="+data.getVehicleId());
	    		Vehicle vehicle=(Vehicle)  query.uniqueResult();
	    		vehicle.setMatricula(data.getMatricula());
	    		vehicle.setChasisNumber(data.getChassi());
	    		vehicle.setYear(data.getYearModel()!=null?Integer.valueOf(data.getYearModel()):null);
	    		vehicle.setModel(data.getModel());
	    		vehicle.setPermissionNumber(data.getRenavan());
	    		if(levelOfService.getFleet()!=null){
	    			DivOrgItemLevel1 divOrg=(DivOrgItemLevel1)session.load(DivOrgItemLevel1.class, levelOfService.getFleet());
	    			vehicle.setDivOrg1(divOrg);
	    		}
	    		
	    		if(vehicle.getExclusionDate()==null && data.getStatus().equalsIgnoreCase("I")){
	    			vehicle.setExclusionDate(data.getDate());
	    		}else if(vehicle.getExclusionDate()!=null && data.getStatus().equalsIgnoreCase("A") ){
	    			vehicle.setExclusionDate(null);
	    		}
	    		session.save(vehicle);
    		}
    		
    	} catch (Exception e) {
			Object[] parameters = {data};
    		handler.getException(e,"createLevelOfServiceVehicleDPA",userSessionData,parameters);
    	}
    }
    
