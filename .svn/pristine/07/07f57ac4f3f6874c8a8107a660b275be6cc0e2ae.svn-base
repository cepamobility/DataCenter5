	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,dpachecklist,systemaccess"
   	 *  
   	 *
     * @throws Exception
     * 
   	 */
   	public void saveMDPSIGAsyncCall(Integer contractorIDSIG,String contractor,String driver,Date dateChecklist,String pathToPDF,String description,String plate,Integer checklist,Integer vehiclechecklist, UserSessionData userSession) throws Exception{
   		try{
   		
   			Session session=HibernateUtil.currentSession();
   			
   			MDPSIGAsyncCall call=new MDPSIGAsyncCall();
   			call.setContractorIDSIG(contractorIDSIG);
   			
   			call.setContractor(contractor);
   			call.setDriver(driver);
   			call.setDateChecklist(dateChecklist);
   			call.setChecklist(checklist);
   			call.setDescription(description);
   			call.setPathToPDF(pathToPDF);
   			call.setPlate(plate);
   			call.setVehiclechecklist(vehiclechecklist);
   			call.setCallDate(null);
   			call.setPathToPDF(pathToPDF);
   			call.setCount(0);
   			call.setSigID(0);
   			
   			session.save(call);
   		}
   		catch (Exception e) {
			Object[] parameters = {pathToPDF, description, plate, checklist, vehiclechecklist};
    		handler.getException(e,"saveMDPSIGAsyncCall",userSession,parameters);
    	}	
   		
   	}
   	
	/**
	 * @ejb.permission role-name = "administrator,cepascheduleactivityupdate,cdactivitymodify" 
	 * @ejb.interface-method view-type = "both"
	 * @param data
	 * @param userRequest
	 */
   	public void updateActivityPoints(Integer activity, Integer driverId, Integer activityId, UserSessionData userSessionData) throws Exception {
   		try{
   			Session session=HibernateUtil.currentSession();
			Query q = session.createSQLQuery("SELECT pm.id FROM pointmoves pm " +
					"JOIN pointaccount pa ON pa.id = pm.account " +
					"JOIN pointsdefinitions pd ON pd.id = pm.definition " +
					"WHERE pa.type = 1 AND pd.category = 3 " +
					"AND pm.reference = '"+activity+"' and pa.reference = "+driverId).addScalar("id",Hibernate.INTEGER);
			Iterator driverIt = q.list().iterator();
			if(driverIt.hasNext()) {
				Integer data = (Integer)driverIt.next();
	            q = session.createQuery("UPDATE PointMove SET reference = '"+activityId+"' WHERE id = "+data);
	            q.executeUpdate();
			}
   		}catch (Exception e) {
			Object[] parameters = {activity, driverId, activityId};
    		handler.getException(e,"updateActivityPoints",userSessionData,parameters);
    	}	
   	}

}
