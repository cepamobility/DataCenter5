	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,systemaccess,dpachecklist, drivercreate,cepascheduleactivitycreate,cepascheduleactivityupdate"
   	 *  
     * @throws Exception
     * 
   	 */
   	public void updatePointAccount(Integer accountId, UserSessionData userSession) throws Exception{
   		try{
   			Session session=HibernateUtil.currentSession();
   			PointAccount account=(PointAccount)session.load(PointAccount.class, accountId);
			double total = 0;
			Query q = session.createSQLQuery("SELECT amount FROM pointmoves WHERE account = "+account.getId()+" ORDER BY date, amount DESC").addScalar("amount", Hibernate.DOUBLE);
			Iterator it = q.list().iterator();
			while(it.hasNext()) {
				total += ((Double)it.next()).doubleValue();
	   			if(userSession.isCorporation(CorporationData.BAYER_MX) && total < 0)
					total = 0;
			}
			account.setTotal(total);
   			session.update(account);
   			
   		} catch (Exception e) {
			Object[] parameters = {accountId};
    		handler.getException(e,"updatePointAccount",userSession,parameters);
    	}	
   	}
   	
