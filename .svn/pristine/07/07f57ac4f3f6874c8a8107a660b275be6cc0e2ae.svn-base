    /**
   	 * @ejb.interface-method
   	 * @ejb.permission role-name = "administrator,corporationmodify"
   	 * Modify a corporation
   	 * @throws Exception
   	 */
   	public void saveCorporationConfig(Integer corporationId,ArrayList<CorporationConfigData> values,UserSessionData userSession) throws Exception {
   	
       if (userSession == null) {
           throw new DeslogedException("saveCorporationConfig","userRequest = null");
       }
   		try {
               Session session = HibernateUtil.currentSession();
               Query query=null;
               
               if(corporationId!=null){
               		query=session.createQuery("delete from CorporationConfig as c where c.corporationId="+corporationId);
               }else{
            	   query=session.createQuery("delete from CorporationConfig as c where c.corporationId="+userSession.getCorporationId());
               }
               
               query.executeUpdate();
               
               for(CorporationConfigData data: values){
            	   CorporationConfig conf=new CorporationConfig(data);
            	   conf.setId(null);
            	   session.save(conf);
               }
               
   		}catch (Exception e) {
   			Object[] parameters = {values};
               handler.getException(e,"saveCorporationConfig",userSession,parameters);
   		}
   		
   	 
       }
   
  
