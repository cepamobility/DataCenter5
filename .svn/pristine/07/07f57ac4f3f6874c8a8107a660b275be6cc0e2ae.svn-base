 *           description="Description for CorporationABM"
 *           jndi-name="ejb/CorporationABM" type="Stateless" view-type="remote"
 *           
 *	 @ejb.ejb-ref ejb-name = "VehicleReport" ref-name = "ejb/VehicleReport"
 *              view-type = "remote" link = "VehicleReport"
 *	 @ejb.ejb-ref ejb-name = "DriverReport" ref-name = "ejb/DriverReport"
 *              view-type = "remote" link = "DriverReport"
 */
public abstract class CorporationABMBean implements SessionBean {

    private ExceptionHandler handler = new ExceptionHandler(CorporationABMBean.class);

    /**
     * Init transaction
     * @ejb.create-method
     * @ejb.permission role-name = "administrator,query,driverview,vehicleview,dpachecklist,corporationmodify,corporationcreate,corporationdelete,addreport, drivercreate,cepascheduleactivitycreate,cepascheduleactivityupdate,eventdelete,cepascheduleactivitysupervise,jjreporter"
     */
    public void ejbCreate() throws javax.ejb.CreateException {  }

	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,corporationcreate"
     * Create a corporation  
     * @param data - Contains the data of the new corporation
     * @param userRequest - Logged user
     * @throws Exception
	 */
	public Integer corporationCreate(CorporationData data, UserSessionData userRequest) throws Exception {
	
		if (userRequest == null) {
			throw new DeslogedException("persistence.corporation.create","userRequest = null");
		}

		if (data == null) {
            throw new InvalidDataException("persistence.corporation.create","data = null");
		}

		if (!validateCorporationData(data)) {
            throw new InvalidDataException("persistence.corporation.create","exception.corporation.invalid");
		}
		
		//check user exist
		if (corporationExist(data.getName())) {
			throw new AlreadyExistsException("persistence.corporation.create","exception.corporation.alreadyexist");
		}

		try {
            Session session = HibernateUtil.currentSession();
		    // Save corporation
            Corporation corporation = new Corporation(data);
			Integer id = (Integer) session.save(corporation);
            corporation.setId(id);
			
            //Log changes
			CorporationLog log = new CorporationLog(corporation,userRequest.getFilter().getLoginName(),new Date(),Integer.valueOf(LogActions.CREATE),session);
			session.save(log);
            
            return id;
		} catch (Exception e) {
			Object[] parameters = {data};
            handler.getException(e,"corporationCreate",userRequest,parameters);
		}
        return null;
    }

	
	/**
	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,corporationmodify"
	 * Modify a corporation
	 * @param data - Data with the change of the corporation
	 * @param userRequest - Logged user
     * @throws Exception
	 */
	public CorporationData corporationUpdate(CorporationData data,UserSessionData userRequest) throws Exception {
	
        if (userRequest == null) {
            throw new DeslogedException("persistence.corporation.update","userRequest = null");
        }

		if (data == null) {
			throw new InvalidDataException("Error in class persistence.administration.corporation.CorporationABM - CorporationUpdate, corporation data is empty","generic.error.emptydata");
		}

		if (!validateCorporationData(data)) {
			throw new InvalidDataException("Error in class persistence.administration.corporation.CorporationABM - CorporationUpdate, invalid corporation data","generic.corporation.error.invaliddata");
		}
		
		try {
            Session session = HibernateUtil.currentSession();
		    // Save changes
		    Corporation corporation = new Corporation(data);
			session.update(corporation);
			
            // Log changes
			CorporationLog log = new CorporationLog(corporation,userRequest.getFilter().getLoginName(),new Date(),Integer.valueOf(LogActions.UPDATE),session);
			session.save(log);

			return corporation.getData();
		}catch (Exception e) {
			Object[] parameters = {data};
            handler.getException(e,"corporationUpdate",userRequest,parameters);
		}
        return null;
    }
	
