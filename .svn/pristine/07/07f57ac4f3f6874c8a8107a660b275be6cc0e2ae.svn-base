            handler.getException(e,"deleteCorporationMenuItems",userSession,parameters);
		}
    }

	
	/**
	 * Validates if the name of the corporation is not empty
	 * @param data Data of the corporation
	 * @return boolean empty or not
	 */
	private boolean validateCorporationData(CorporationData data) {
		return !Util.empty(data.getName());
	}

    /**
     * Verifies if a corporation exist
     * @param name  name of the corporation
     * @return if corporation exists or not
     * @throws Exception
     */
	private boolean corporationExist(String name)throws Exception{
		Session session = HibernateUtil.currentSession();

        Query query = session.createQuery("select corporation from persistence.administration.corporation.tables.Corporation corporation " +
				"where corporation.name = (:name) ");
		query.setParameter("name", name);
 
		Iterator iter = query.list().iterator();
		return iter.hasNext();
	}

	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,corporationmodify,corporationcreate,corporationdelete"
     * gets a corporation 
     * @param id - id of the corporation
     * @param userRequest - Logged user
     * @return Corporation if founded, if not null
     * @throws Exception
	 */
	public Corporation loadCorporation(Integer id, UserSessionData userRequest) throws Exception {
        if (userRequest == null) {
            throw new DeslogedException("persistence.corporation.load","userRequest = null");
        }

		Corporation corporation=null;
		try {
			Session session = HibernateUtil.currentSession();
			corporation=(Corporation)session.load(Corporation.class,id);
			
		}catch (Exception e) {
			Object[] parameters = {id};
            handler.getException(e,"loadCorporation",userRequest,parameters);
		}
		return corporation;
	}
	
	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,corporationmodify"
     * Deletes an item of a organizational division of the corporation in use  
     * @param userRequest - Logged user
     * @param itemId - Id of the item to be deleted
     * @param level - Level of the item
     * @throws Exception
	 */
	public void deleteItemLevel(UserSessionData userRequest,Integer itemId, int level) throws Exception {
	    
        if (userRequest == null) {
            throw new DeslogedException("persistence.corporation.deleteitemlevel","userRequest = null");
        }
	
		try {
            Session session = HibernateUtil.currentSession();
		    if(level == 2) {
	            DivOrgItemLevel2 itemLevel2 = (DivOrgItemLevel2)session.load(DivOrgItemLevel2.class,itemId);
	            itemLevel2.setDivOrgItemLevel3(null);
	            session.delete(itemLevel2);
		    } else {	        
            	DivOrgItemLevel3 itemLevel3 = (DivOrgItemLevel3)session.load(DivOrgItemLevel3.class,itemId);
            	session.delete(itemLevel3);
		    }
		} catch (Exception e) {
			Object[] parameters = {itemId,level};
            handler.getException(e,"deleteItemLevel",userRequest,parameters);
		} 
	}

	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,corporationmodify"
     * Delete the relation between a corporation and a country 
     * @param userRequest - Logged user
     * @param itemId - country to delete
     * @param id - Id of the corporation
     * @param level - level of the country
     * @throws Exception
	 */
	public void deleteCountry(UserSessionData userRequest,Integer itemId, Integer id, int level) throws Exception {
	    
        if (userRequest == null) {
            throw new DeslogedException("deleteCountry","userRequest = null");
        }
	
		try {
            Session session = HibernateUtil.currentSession();
		    switch(level) {
		        case 3:
                    String message = validateDelete(userRequest.getFilter().getCorporationId(),itemId,id);
		            if(message == null) {
			            Corporation corp = new Corporation();
			            corp.setId(userRequest.getFilter().getCorporationId());
			            Country coun = new Country();
			            coun.setId(itemId);
			            CorporationCountry country = (CorporationCountry)session.load(CorporationCountry.class,new CorporationCountryPK(coun,corp));
			            Iterator it = country.getGeoLevel1Set().iterator();
			            while(it.hasNext()) {
			                if(id != null && ((GeoLevel1)it.next()).getId().equals(id)) {
			                    it.remove();
			                }
			            }
			            if(country.getGeoLevel1Set().size() == 0) {
			                session.delete(country);
			            }
		            }else {
		                throw new InvalidDataException("deleteCountry",message);
                    }
		            break;
		        case 2:
		            GeoLevel1 level1 = (GeoLevel1)session.load(GeoLevel1.class,itemId);
		            level1.setGeoLevel2(null);
		            session.delete(level1);
		            break;
		        case 1:
		            GeoLevel2 level2 = (GeoLevel2)session.load(GeoLevel2.class,itemId);
		            session.delete(level2);
		            break;
		    } 
		} catch (Exception e) {
			Object[] parameters = {itemId,level,id};
            handler.getException(e,"deleteCountry",userRequest,parameters);
		} 
	}

	/**
     * Verifies if a country can be deleted 
     * @param corporation Corporation associated to country
     * @param country id of the country
     * @param level1 - level of the country
     * @return
	 */
    private String validateDelete(Integer corporation, Integer country, Integer level1) {
        Session session = HibernateUtil.currentSession();

        String queryStr = "SELECT count(*) FROM GroupLine g WHERE g.groupElement.corporation = (:corporation) AND g.country = (:item)";
        Query query = session.createQuery(queryStr);
        query.setParameter("item", country);
        query.setParameter("corporation", corporation);
        if(((Integer)query.uniqueResult()).intValue() > 0) {
            return "error.corporation.deletecountry.groupasociated";
        }

        queryStr = "SELECT count(*) FROM Driver d WHERE d.corpCountry.pk.corporation.id = (:corporation) AND d.corpCountry.pk.country = (:item)";
        query = session.createQuery(queryStr);
        query.setParameter("item", country);
        query.setParameter("corporation", corporation);
        if(((Long)query.uniqueResult()).intValue() > 0) {
            return "error.corporation.deletecountry.driverasociated";
        }

        queryStr = "SELECT count(*) FROM Vehicle v WHERE v.corpCountry.pk.corporation.id = (:corporation) AND v.corpCountry.pk.country =  (:item)";
        query = session.createQuery(queryStr);
        query.setParameter("item", country);
        query.setParameter("corporation", corporation);
        if(((Long)query.uniqueResult()).intValue() > 0) {
            return "error.corporation.deletecountry.vehicleasociated";
        }

        queryStr = "SELECT count(*) FROM EventAbstract e WHERE e.corpCountry.pk.corporation.id = (:corporation) AND e.corpCountry.pk.country =  (:item)";
        query = session.createQuery(queryStr);
        query.setParameter("item", country);
        query.setParameter("corporation", corporation);
        if(((Long)query.uniqueResult()).intValue() > 0) {
            return "error.corporation.deletecountry.eventasociated";
        }

        queryStr = "SELECT count(*) FROM FleetDivision f WHERE f.fleet.corporation = (:corporation) AND f.country = (:item)";
        query = session.createQuery(queryStr);
        query.setParameter("item", country);
        query.setParameter("corporation", corporation);
        if(((Long)query.uniqueResult()).intValue() > 0) {
            return "error.corporation.deletecountry.fleetasociated";
        }
        
        queryStr = "SELECT count(*) FROM CEPAScheduleActivity a WHERE a.corpCountry.pk.corporation.id = (:corporation) AND a.corpCountry.pk.country = (:item)";
        query = session.createQuery(queryStr);
        query.setParameter("item", country);
        query.setParameter("corporation", corporation);
        if(((Long)query.uniqueResult()).intValue() > 0) {
            return "error.corporation.deletecountry.activityasociated";
        }
        
        return null;
    }

    /**
     * @ejb.interface-method   
     * @ejb.permission role-name = "administrator,corporationmodify"
     * Add a relation between a corporation and a country 
     * @param userRequest - Logged user
     * @param newData - Geograhic division of the country 
     * @param corporation Corporation
     * @throws Exception
     */
	public void corporationAddCountry(UserSessionData userRequest,GeoLabelData newData,CorporationData corporation) throws Exception {
    
        if (userRequest == null) {
            throw new DeslogedException("persistence.corporation.addcountry","userRequest = null");
        }

		try {
            Session session = HibernateUtil.currentSession();
		    int levels = corporation.getGeoLabels().length;
		    Iterator itLevel1 = newData.getItemIterator();
		    while(itLevel1.hasNext()) {
		        GeoItemData dataLevel1 = (GeoItemData)itLevel1.next();
		        if(levels == 1) {
		            CorporationCountry corporationCountry = new CorporationCountry(corporation.getId(),dataLevel1.getId(),true,null);
		            session.save(corporationCountry);
		        }else {
		            if(levels == 2) {
		                GeoLevel1 level1 = new GeoLevel1(dataLevel1);
		                if(dataLevel1.getId() == null) {
		                    session.save(level1);
		                }else {
		                    level1 = (GeoLevel1) session.load(GeoLevel1.class,dataLevel1.getId());
		                }
                        Iterator itLevel2 = dataLevel1.getSubItems().getItemIterator();
                        while(itLevel2.hasNext()) {
                            GeoItemData dataLevel2 = (GeoItemData)itLevel2.next();
                            CorporationCountry corporationCountry = getCorporationCountry(corporation.getId(),dataLevel2.getId());
                            if(corporationCountry == null) {
                                Set level1s = new HashSet();
                                level1s.add(level1);
                                corporationCountry = new CorporationCountry(corporation.getId(),dataLevel2.getId(),true,level1s);
                                session.save(corporationCountry);
                            }else {
                                corporationCountry.getGeoLevel1Set().add(level1);
                                session.update(corporationCountry);
                            }
		                }		                
		            }else {
		                GeoLevel2 level2 = null;
		                if(dataLevel1.getId() == null) {
		                    level2 = new GeoLevel2(dataLevel1);
		                }else {
		                    level2 = (GeoLevel2) session.load(GeoLevel2.class,dataLevel1.getId());
		                }
		                Iterator itLevel2 = dataLevel1.getSubItems().getItemIterator();
		                while(itLevel2.hasNext()) {
		    		        GeoItemData dataLevel2 = (GeoItemData)itLevel2.next();
			                GeoLevel1 level1 = new GeoLevel1(dataLevel2);
			                if(dataLevel2.getId() == null) {
				                level1.setGeoLevel2(level2);
			                    session.save(level1);
			                }else {
			                    level1 = (GeoLevel1) session.load(GeoLevel1.class,dataLevel2.getId());
			                }
			                Iterator itLevel3 = dataLevel2.getSubItems().getItemIterator();
			                while(itLevel3.hasNext()) {
			    		        GeoItemData dataLevel3 = (GeoItemData)itLevel3.next();
			    		        CorporationCountry corporationCountry = getCorporationCountry(corporation.getId(),dataLevel3.getId());
					            if(corporationCountry == null) {
						            Set level1s = new HashSet();
						            level1s.add(level1);
					                corporationCountry = new CorporationCountry(corporation.getId(),dataLevel3.getId(),true,level1s);
					                session.save(corporationCountry);
					            }else {
					                corporationCountry.getGeoLevel1Set().add(level1);
					                session.update(corporationCountry);
					            }
			                }		                
		                }
		            }
		        }
		    }
		    logChanges(userRequest,LogActions.UPDATE);
		}catch(Exception e) {
			Object[] parameters = {newData,corporation};
            handler.getException(e,"addCountry",userRequest,parameters);
		}
	}

    /**
     * Gets a relation between a corporation and a country
     * @param corporation id of the corporation
     * @param country id of the country
     * @return Relation
     * @throws Exception
     */
    private CorporationCountry getCorporationCountry(Integer corporation, Integer country) throws Exception {

		Session session = HibernateUtil.currentSession();

		String queryStr = "select corpCountry from persistence.administration.corporation.tables.CorporationCountry corpCountry " +
				"where corpCountry.pk.corporation.id = (:corp) and corpCountry.pk.country.id = (:country) ";
		Query query = session.createQuery(queryStr);
		query.setParameter("corp", corporation);
		query.setParameter("country", country);
 
		Iterator iter = query.list().iterator();
		return (iter.hasNext()) ? (CorporationCountry)iter.next() : null;

    }

	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,corporationmodify"
     * Modifies data of a geographic division 
     * @param userRequest Logged user
     * @param corporation Corporation that contains the geographic division 
     * @param countries ids of countries to modify
     * @throws Exception
	 */
	public void corporationUpdateCountry(UserSessionData userRequest,CorporationData corporation, Collection countries)	throws Exception {
        if (userRequest == null) {
            throw new DeslogedException("persistence.corporation.updatecountry","userRequest = null");
        }
		try {
            Session session = HibernateUtil.currentSession();
	
		    Iterator it = countries.iterator();
		    while(it.hasNext()) {
		        CorporationCountry corpCountry = (CorporationCountry)session.load(CorporationCountry.class, new CorporationCountryPK((Integer)it.next(),corporation.getId()));
		        if(corpCountry != null) {
		            corpCountry.setActive(!corpCountry.isActive());
		            session.update(corpCountry);
		        }
		    }
            logChanges(userRequest,LogActions.UPDATE);
		}catch(Exception e) {
			Object[] parameters = {corporation,countries};
            handler.getException(e,"corporationUpdatecountry",userRequest,parameters);
		}
	}

	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,corporationmodify"
     * Validates if an organizational division coud be deleted 
     * @param itemId item to delete
     * @param level level of the item
     * @return if could be deleted or not
	 */
    public String validateDeleteItem(Integer itemId, int level) {
        
        if(level == 1) {
            Session session = HibernateUtil.currentSession();

            String queryStr = "SELECT count(*) FROM GroupLine WHERE (divOrg11 = (:item) OR divOrg21 = (:item) OR divOrg31 = (:item))";
            Query query = session.createQuery(queryStr);
            query.setParameter("item", itemId);
            if(((Long)query.uniqueResult()).intValue() > 0) {
                return "error.corporation.deleteitem.groupasociated";
            }

            queryStr = "SELECT count(*) FROM Driver WHERE (divOrg1 = (:item) OR divOrg2 = (:item) OR divOrg3 = (:item))";
            query = session.createQuery(queryStr);
            query.setParameter("item", itemId);
            if(((Long)query.uniqueResult()).intValue() > 0) {
                return "error.corporation.deleteitem.driverasociated";
            }

            queryStr = "SELECT count(*) FROM Vehicle WHERE (divOrg1 = (:item) OR divOrg2 = (:item) OR divOrg3 = (:item))";
            query = session.createQuery(queryStr);
            query.setParameter("item", itemId);
            if(((Long)query.uniqueResult()).intValue() > 0) {
                return "error.corporation.deleteitem.vehicleasociated";
            }

            queryStr = "SELECT count(*) FROM EventAbstract WHERE (divOrg1 = (:item) OR divOrg2 = (:item) OR divOrg3 = (:item))";
            query = session.createQuery(queryStr);
            query.setParameter("item", itemId);
            if(((Long)query.uniqueResult()).intValue() > 0) {
                return "error.corporation.deleteitem.eventasociated";
            }

            queryStr = "SELECT count(*) FROM FleetDivision WHERE (divOrg11 = (:item) OR divOrg21 = (:item) OR divOrg31 = (:item))";
            query = session.createQuery(queryStr);
            query.setParameter("item", itemId);
            if(((Long)query.uniqueResult()).intValue() > 0) {
                return "error.corporation.deleteitem.fleetasociated";
            }
            
            queryStr = "SELECT count(*) FROM CEPAScheduleActivity WHERE (divOrg1 = (:item) OR divOrg2 = (:item) OR divOrg3 = (:item))";
            query = session.createQuery(queryStr);
            query.setParameter("item", itemId);
            if(((Long)query.uniqueResult()).intValue() > 0) {
                return "error.corporation.deleteitem.activityasociated";
            }
        }
        return null;
    }

	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,corporationmodify"
     * Renames a geographic divisions item 
     * @param userRequest - Logged user
     * @param level - level of the geographic division 
     * @param item - id of the item
     * @throws Exception
	 */
    public void renameDivGeo(UserSessionData userRequest,int level,GeoItemData item) throws Exception {
        if (userRequest == null) {
            throw new DeslogedException("persistence.corporation.renamedivgeo","userRequest = null");
        }
        try {
            Session session = HibernateUtil.currentSession();
            switch(level) {
                case 1:
                    GeoLevel1 level1 = (GeoLevel1)session.load(GeoLevel1.class,item.getId());
                    level1.setResourceKey(item.getName());
                    session.update(level1);
                    break;
                case 2:
                    GeoLevel2 level2 = (GeoLevel2)session.load(GeoLevel2.class,item.getId());
                    level2.setResourceKey(item.getName());
                    session.update(level2);
                    break;
            }
            logChanges(userRequest,LogActions.UPDATE);
        }catch(Exception e) {
			Object[] parameters = {level,item};
            handler.getException(e,"renameDivGeo",userRequest,parameters);
        }
    }
    
	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,corporationmodify,corporationcreate,corporationdelete"
     * Makes a log of last changes in corporation
     * @param userRequest Logged user
     * @param action action made in change
     * @throws Exception
	 */
    public void logChanges(UserSessionData userRequest, int action) throws Exception {
        if (userRequest == null) {
            throw new DeslogedException("persistence.corporation.logchanges","userRequest = null");
        }
        try {
            Session session = HibernateUtil.currentSession();
            Corporation corporation = loadCorporation(userRequest.getFilter().getCorporationId(),userRequest);
            CorporationLog log = new CorporationLog(corporation,userRequest.getFilter().getLoginName(),new Date(),Integer.valueOf(action),session);
            session.save(log);
        } catch (Exception e) {
			Object[] parameters = {action};
            handler.getException(e,"logChanges",userRequest,parameters);
        }
    }

