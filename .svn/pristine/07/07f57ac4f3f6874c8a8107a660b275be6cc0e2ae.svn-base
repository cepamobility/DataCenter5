   	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,dpachecklist, drivercreate,cepascheduleactivitycreate,cepascheduleactivityupdate"
   	 *  
     * @throws Exception
     * 
   	 */
   	public WSResultData newFOSAPlate(ContractorPlateFOSAData plateFOSA, UserSessionData userSession) throws Exception{
   		WSResultData result=new WSResultData(0,"OK");
   		try{
   			Session session = HibernateUtil.currentSession();
   			if(plateFOSA.getPlate()!=null){//Si no viene matricula se descarta
   				String plate=plateFOSA.getPlate().toUpperCase().replaceAll(" ","");
   	   			Query query=session.createQuery("select f from ContractorPlateFOSA as f where f.plate=(:plate)");
   	   			query.setParameter("plate",plate);
   	   			List list=query.list();
   	   			Iterator iter=list.iterator();
   	   			if(iter.hasNext()){
   	   				ContractorPlateFOSA contractorPlateFOSA=(ContractorPlateFOSA)iter.next();
   	   				contractorPlateFOSA.setFosaId(plateFOSA.getFosaId());
   	   				session.update(contractorPlateFOSA);
    	   		}else{
    	   			ContractorPlateFOSA contractorPlateFOSA=new ContractorPlateFOSA();
    	   			contractorPlateFOSA.setPlate(plate);
    	   			contractorPlateFOSA.setFosaId(plateFOSA.getFosaId());
    	   			session.save(contractorPlateFOSA);
    	   		}
   	   			
   			}else{
   				result.setCode(2);
   	    		result.setDescription("La placa no puede ser vacia");
   			}

   			
   		} catch (Exception e) {
			Object[] parameters = {plateFOSA};
    		handler.getException(e,"newFOSAPlate",userSession,parameters);
    		result.setCode(1);
    		result.setDescription(e.getMessage());
    	}	
   		
   		return result;
   	}
   	
