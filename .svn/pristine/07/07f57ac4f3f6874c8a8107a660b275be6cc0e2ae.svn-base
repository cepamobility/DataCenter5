	/**
   	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,dpachecklist, drivercreate,cepascheduleactivitycreate,cepascheduleactivityupdate,eventdelete"
   	 *  
     * @throws Exception
     * 
   	 */
   	public void removeEventMove(Integer event, UserSessionData userSession) throws Exception{
   		try{
   			Session session=HibernateUtil.currentSession();
   			Query q = session.createSQLQuery("SELECT m.id, m.account, m.amount FROM pointmoves m JOIN genericevents ge ON cast(ge.id as text) = m.reference WHERE ge.id = "+event).addScalar("id", Hibernate.INTEGER).addScalar("account", Hibernate.INTEGER).addScalar("amount", Hibernate.DOUBLE);
   			List list = q.list();
   			if(list != null && list.size() > 0) {
   				Object[] values = (Object[])list.iterator().next();
   				PointMove move = (PointMove)session.load(PointMove.class, (Integer) values[0]);
   				session.delete(move);
   				PointAccount account = (PointAccount)session.load(PointAccount.class, (Integer) values[1]);
   				account.setTotal(account.getTotal()-(Double)values[2]);
   				session.update(account);
   			}
   		} catch (Exception e) {
			Object[] parameters = {event};
    		handler.getException(e,"removeEventMove",userSession,parameters);
    	}	
   	}

