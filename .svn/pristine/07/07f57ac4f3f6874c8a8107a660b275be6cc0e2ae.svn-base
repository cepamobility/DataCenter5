    /**
     * Returns menu options.
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,cepascheduleactivitycreate,cdactivitycreate,vehiclechecklist,dpachecklist"
	 * @throws Exception
	 */
    public void deleteUnconformityDPA(String ids, UserSessionData userSessionData) throws Exception {
    	try{
    		Session session = HibernateUtil.currentSession();
    		String[] idsA=ids.split(",");
    		SimpleDateFormat format=new SimpleDateFormat("dd/MM/yyyy HH:mm:ss");
    		
    		for(int i=0;i<idsA.length;i++){
    			UnconformityDPA unconformity=(UnconformityDPA)session.load(UnconformityDPA.class, Integer.valueOf(idsA[i]));
    			Iterator<UnconformityItemDPA> iter=unconformity.getItems().iterator();
    			while(iter.hasNext()){
    				UnconformityItemDPA item=iter.next();
    				Query query=session.createSQLQuery("select v.matricula"+
				   			 " from unconformityitemdpa as i "+
							 " INNER JOIN unconformitydpa as u on i.unconformitydpa=u.id "+  
							 " INNER JOIN vehiclecheck as vc on vc.vehiclecheckid=u.vehiclecheckid "+   
							 " INNER JOIN vehicles as v on vc.vehicle=v.id   "+
							 " inner JOIN contractordata as cd on (cd.corporation=v.corporation and cd.id=v.divOrg1) "+   
							 " where v.corporation in (9) "+
							 " and i.id in (select reference from asynccallfosa  where   reasoncode=2 and reference=i.id) "+
							 " and not i.id in (select reference from asynccallfosa  where   reasoncode=3 and reference=i.id)"+
							 " and i.id="+item.getId());
    				List list=query.list();
    				if(list.size()>0){
    					 String plate=(String)list.iterator().next();	
    					 FOSAAsyncCall call=new FOSAAsyncCall();
    					 call.setReference(item.getId());
    					 call.setReasonCode(3);
    					 call.setDateHourStartPenalty(format.format(new Date()));
    					 call.setTypeOfPenalty(2);
    					 call.setTotalLessPoints(0d);
    					 call.setAccountTotal(0d);
    					 
    					 call.setPlate(plate);
    					 session.save(call);
    				}
    			}
    		}
    		
    		for(int i=0;i<idsA.length;i++){
    			Query query=session.createQuery("select c from CorrectiveActionDPA as c where c.unconformityDPA.id="+Integer.valueOf(idsA[i]));
                List aux=query.list();
                Iterator iter= aux.iterator();
                while(iter.hasNext()){
                	CorrectiveActionDPA corrective=(CorrectiveActionDPA)iter.next();
                	session.delete(corrective);
                }
    			session.delete(session.load(UnconformityDPA.class, Integer.valueOf(idsA[i])));
    		}
    		
    		
    	} catch (Exception e) {
			Object[] parameters = {ids};
    		handler.getException(e,"deleteUnconformityDPA",userSessionData,parameters);
    	}
    }

    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate,driverdelete,drivercreate"
	 * @throws Exception
	 */
    public void createLevelOfServiceDriverDPA(LevelOfServiceDriverDPAData data, UserSessionData userSessionData) throws Exception {
    	try{
    		Session session = HibernateUtil.currentSession();
    		
    		LevelOfServiceDriverDPA levelOfService=new LevelOfServiceDriverDPA(data);
    		
    		session.save(levelOfService);    		
    		
    		//Hay que actualizar los datos del driver pero se tiene que corroborar que el nuevo nivel de servicio
    		//tiene efectivamente la fecha mas nueva porque se puede estar dando de alta un nivel de servicio en el "pasado"
    		//en cuyo caso no se debe ctualizar los datos del driver.
    		Query query2=session.createQuery("select c from LevelOfServiceDriverDPA as c where c.driverId="+data.getDriverId()+" and c.date in(select max(c2.date)  from LevelOfServiceDriverDPA as c2 where c2.driverId=c.driverId) order by c.firstName,c.lastName");
    		List auxList=query2.list();
    		boolean updateDriver=false;
    		if(auxList.size()>0){
    			LevelOfServiceDriverDPA cAux=(LevelOfServiceDriverDPA)auxList.iterator().next();
    			if(cAux.getDate().compareTo(data.getDate())<=0){
    				//Tiene una fecha mayor a la de todos los niveles de servicio
		    		updateDriver=true;
    			}
    		}else{
    			//Es el primer nivel de servicio
    			updateDriver=true;
    		}
    		
    		if(updateDriver){
    			Query query=session.createQuery("select d from Driver as d where d.id="+data.getDriverId());
	    		Driver driver=(Driver)  query.uniqueResult();
	    		
	    		driver.setLicenseExpiry(data.getVcnh());
	    		driver.setFirstName(data.getFirstName());
	    		driver.setLastName(data.getLastName());
	    		driver.setBirthDate(data.getBirthDate());
	    		driver.setStateOrRegion(data.getUf());		
				driver.setIdDallas(data.getCpf());		
				driver.setBpsregistry(data.getRg());		
	    		driver.setSuperviser(data.getCelular());
	    		if(driver.getExclusionDate()==null && data.getStatus().equalsIgnoreCase("I")){
	    			driver.setExclusionDate(data.getDate());
	    		}else if(driver.getExclusionDate()!=null && data.getStatus().equalsIgnoreCase("A") ){
	    			driver.setExclusionDate(null);
	    		}
	    		session.save(driver);
    		}
    		
    	} catch (Exception e) {
    		
			Object[] parameters = {data};
    		handler.getException(e,"createLevelOfServiceDriverDPA",userSessionData,parameters);
    	}
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverupdate,driverdelete,drivercreate,driverview"
	 * @throws Exception
	 */
    public LevelOfServiceDriverDPAData getLastLevelOfServiceDriver(Integer driverid, UserSessionData userSessionData)throws Exception {
    	try{
    		Session session = HibernateUtil.currentSession();
	    	Query query2=session.createQuery("select c from LevelOfServiceDriverDPA as c where c.driverId="+driverid+" and c.date in(select max(c2.date)  from LevelOfServiceDriverDPA as c2 where c2.driverId=c.driverId) order by c.firstName,c.lastName");
			List auxList=query2.list();
			Iterator iter=auxList.iterator();
			if(iter.hasNext()){
				return ((LevelOfServiceDriverDPA)iter.next()).getLevelOfServiceDriverDPAData(userSessionData);
			}
    	} catch (Exception e) {
			Object[] parameters = {driverid};
    		handler.getException(e,"getLastLevelOfServiceDriver",userSessionData,parameters);
    	}
    	
    	return null;
    }
    
