        }

		if (itemId == null) {
			throw new InvalidDataException("Error in class persistence.administration.corporation.CorporationABM - corporationMenuUpdate, corporationMenu data is empty","generic.error.emptydata");
		}
		
		try {
            Session session = HibernateUtil.currentSession();
		    // Save changes
            
		    CorporationMenu corporationMenuItem = new CorporationMenu(userSession.getFilter().getCorporationId(),itemId,session);
		    corporationMenuItem.setEnable(true);
			session.save(corporationMenuItem);
			
		}catch (Exception e) {
			Object[] parameters = {itemId};
            handler.getException(e,"corporationMenuUpdate",userSession,parameters);
		}
    }
	
	
	/**
	 * @ejb.interface-method
