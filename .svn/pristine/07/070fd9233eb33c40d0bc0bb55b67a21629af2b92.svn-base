package communication.datatype.tables;

import java.io.Serializable;


public class AlertFrecuencyDataType extends GeneralDTData implements Serializable {

    private static final long serialVersionUID = 1L;
    
    /**
     * Frecuencia: Daily (Diaria)
     */
    public static final String DAILY = "generic.alert.frecuency.daily";
    /**
     * Frecuencia: Weekly (Semanal)
     */
    public static final String WEEKLY = "generic.alert.frecuency.weekly";
    /**
     * Frecuencia: Monthly (Mensual)
     */
    public static final String MONTHLY = "generic.alert.frecuency.monthly";
    /**
     * Frecuencia: Yearly (Anual)
     */
    public static final String YEARLY = "generic.alert.frecuency.yearly";
    /**
     * Frecuencia: N/A
     */
    public static final String NA = "generic.alert.frecuency.na";
    
    /**
     * Constructor.
     * @param resourceKey
     */
    public AlertFrecuencyDataType(String resourceKey) {
		super(resourceKey);
	}
	
}
