<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.administration.tables" >
    <class name="UnconformityItemDPA" table="unconformityitemdpa">

        <id
            name="id"
            column="id"
            type="java.lang.Integer"
        >
            <generator class="native">
            </generator>
        </id>
        
		<property name="type" not-null="true"></property>
		<property name="notify"></property>
		<property name="comment"></property>
		<property name="expirity" type="java.util.Date"></property>
		<property name="correctiveActionId" column="correctiveactiondpa"></property>
	</class>

</hibernate-mapping>
