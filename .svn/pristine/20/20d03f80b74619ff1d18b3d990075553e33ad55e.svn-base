	<!--  Form para vincular conductor temporal y existente, manteniendo datos
		del conductor existente o aceptar el conductor temporal como fijo
		formName: TemporalDriverForm 
		el action puedes ser link o accept
		-->
	<html:form action="/TemporalDriver"  method="post" >
		<html:hidden property="target"  value="TemporalDriverList"/>
		<html:hidden property="idDriver" value="" />
		<html:hidden property="idTemporalDriver" value="<%= idTemporalDriver %>"  />
		<html:hidden property="idActivity" value="<%=idActivity %>" />
		<html:hidden property="action" value="" />
	</html:form>
	
</body>
<%
	}

	}catch(Exception e){
		e.printStackTrace();
	}
%>	
</html:html>
