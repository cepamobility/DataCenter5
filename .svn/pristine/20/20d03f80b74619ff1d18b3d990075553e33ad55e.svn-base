<%@page language="java" 
	errorPage="../exception.jsp"
	import="java.util.*"
	import="business.*"
	import="business.driver.*"
	import="business.administration.user.*"
	import="communication.language.*"
	import="communication.security.*"
	import="communication.administration.user.tables.*"
	import="communication.driver.tables.*"
	import="communication.administration.corporation.tables.*"
	import="communication.driver.tables.*"
	import="communication.util.*"
 	import="presentation.translator.web.util.*"
 	import="presentation.translator.web.driver.*"
%>

<%@ taglib uri="/WEB-INF/struts-html.tld"
        prefix="html"
%>

<html:html>
<%!
	RequestDispatcher dispatcher; String context;
	Text messages; SystemAccess sys;
	DriverData data;
%> 
<%
	try{

	sys=(SystemAccess)session.getAttribute("SystemAccess");
	String check = Util.checkPermission(sys,SecurityConstants.VIEW_DRIVER_LIST);
	if(check!=null) {
	}else {
	    String url = "driver/TemporalDriverList.jsp";

		context=request.getContextPath();
		dispatcher=request.getRequestDispatcher("/util/jsp/message.jsp");
		dispatcher.include(request,response);
	
		messages=sys.getText();
		boolean temporal =  false;
		
		
		temporal = (request.getParameter("temporal") == null) ? false : 
			Boolean.parseBoolean(request.getParameter("temporal"));
				
		session.setAttribute("target","TemporalDriverList");
		boolean already = (request.getParameter("already") == null) ? false : 
			Boolean.parseBoolean(request.getParameter("already"));
		DriverUtil util = new DriverUtil();
		Hashtable parameters = util.getParameters(session,request);	
		boolean advanced = ((Boolean)parameters.get("advanced")).booleanValue();
		
		String idTemporalDriver = (String)request.getParameter("idTemporalDriver");
		if(idTemporalDriver == null && session.getAttribute("idTemporalDriver") != null) {
			idTemporalDriver = (String)session.getAttribute("idTemporalDriver") ;
		}
		data = sys.getDriverReportFacade().getDriver(new Integer(idTemporalDriver), sys.getUserSessionData());
		session.setAttribute("idTemporalDriver",idTemporalDriver);
		
		if(!Util.empty(request.getParameter("first"))) {
			parameters.put("value", data.getLastName().trim());
		}
		parameters.put("temp", String.valueOf(DriverData.ONLY_NOT_TEMPORAL));

		session.setAttribute("url",url);
		DriverReportFacade driverReportFacade = sys.getDriverReportFacade();
		String link = "/driver/TemporalDriverList.jsp";
		ListResult driverSearchList = null;
		if(!advanced && !already) {
			driverSearchList = driverReportFacade.findDriverList(parameters,sys.getUserSessionData());
			session.setAttribute("driverSearchList",driverSearchList);			
		}else {
			DriverAdvancedSearchForm form = null;
			if(session.getAttribute("driverForm") != null) {
			    form = (DriverAdvancedSearchForm)session.getAttribute("driverForm");
			}else {
			    form = new DriverAdvancedSearchForm();
			    form.setPageNum((String)request.getParameter("pageNum"));
			    form.setCount((String)request.getParameter("pageSize"));
			    form.setStatus((String)request.getParameter("status"));
			    form.setNextLink(link);
			}
			session.setAttribute("DriverAdvancedSearchForm",form);			
		}
				
		String idActivity = request.getParameter("idActivity");
		if(Util.empty(idActivity)) {
			idActivity = (String)session.getAttribute("idActivity");
		}
		// System.out.println("IdActivity: " + idActivity);
		session.setAttribute("idActivity",idActivity);
		
		
		
%>

<script language="javascript" src='./menu/js/driverFunctions.js' type='text/javascript' >
</script>


<script language="JavaScript" type="text/javascript"  charset="ISO-8859-1">

function submitPagination(page,all) {
	document.forms[2].all.value = all;
	document.forms[2].pageNum.value = page;
	document.forms[2].submit();
}

function enabledLink(){
	// Habilita el boton de vincular.
	document.getElementById("linkButton").disabled = "";
}

function setAction(form,action){
		if (action == "link"){
			var ok =  confirm('<%= messages.getText("generic.driver.temporal.areyousuretolink") %> ');
			if (ok) { 

				// Vinculo conductor temporal a existente: 
				form.action.value = action;
			
				var radioObj = document.listForm.idDriver;
				var radioLength = radioObj.length;
				if (radioLength == undefined){
					// si no esta definido el radiobutton:
					if (radioObj.checked) 
						form.idDriver.value = radioObj.value;
					else 
						form.idDriver.value = "";
				}else{
					// si hay valores en el radio button, itero sobre los mismos
					// hasta encontrar el checked.
					for (var i= 0; i < radioLength; i++){
						if (radioObj[i].checked){
							form.idDriver.value = radioObj[i].value;
							break;
						}
					} // end for
				} // end if
				// form.idDriver.value = .value;
				form.submit();
			}
		}else if (action == 'accept'){
			// Acepto conductor temporal
			form.action.value = action;
			
			var radioObj = document.listForm.idDriver;
			var radioLength = radioObj.length;
			if (radioLength == undefined){
				// si no esta definido el radiobutton:
				if (radioObj.checked) 
					form.idDriver.value = radioObj.value;
				else 
					form.idDriver.value = "";
			}else{
				// si hay valores en el radio button, itero sobre los mismos
				// hasta encontrar el checked.
				for (var i= 0; i < radioLength; i++){
					if (radioObj[i].checked){
						form.idDriver.value = radioObj[i].value;
						break;
					}
				} // end for
			} // end if
			form.submit(); 
		}
}

</script>

<body bgcolor="#FFFFFF">

	<table width="800" border="0" align="center" cellpadding="0" cellspacing="0">
		<tr class="guide1">
			<jsp:include  page='<%="../component/titlecomponent.jsp?title="+messages.getText("generic.driver.linkdriver")%>' />
  		</tr>
      	<tr>
			<jsp:include  page="../component/spaceline.jsp" />
  		</tr>
      	<tr>
        	<td valign="top" <%=(advanced)?"colspan=3":"width='60%'"%>height="100%">
				<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("generic.messages.search")%>' />
				<table width="100%" height="60" border="0" cellpadding="0" cellspacing="0">
					<tr>
						<td width="100%" align="right" valign="top">
<%		if(advanced) { 
    			session.setAttribute("paramters",parameters)	;	
%>						<jsp:include page='<%="/driver/advancedSearch.jsp" %>'/>
<%		}else {
%>						<form action="layout.jsp?refer=/driver/TemporalDriverList.jsp" method="post" name="searchTemporal" >
							<input type="hidden" name="pageNum" value='<%=String.valueOf(parameters.get("pageNum"))%>'>    
							<input type="hidden" name="all" value='<%=String.valueOf(parameters.get("all"))%>'>    
    						<input type="hidden" name="pageSize" value='<%=String.valueOf(parameters.get("pageSize"))%>'/>										  
    						<input type="hidden" name="temporal" value='true' />
    						<input type="hidden" name="temp" value='<%=DriverData.ONLY_NOT_TEMPORAL %>' />
    						<input type="hidden" name="idDriver" value='' />
    						<input type="hidden"  name="idActivity" value='<%= idActivity %>'   /> 
    						<input type="hidden" name="idTemporalDriver"   value="<%= idTemporalDriver %>"   />
							<table width="100%" height="20" border="0" cellpadding="0" cellspacing="1">									
								<tr>
    								<td width="41%" align="left" class="texts">
										<%=messages.getText("generic.driver.driverdata.firstorlastname")%>										
									</td>
    								<td width="59%" colspan="2" align="right">
    									<input type="text" name="value" value='<%=String.valueOf(parameters.get("value"))%>' size="40" class="input">
  									</td>
								</tr>
								<tr>
									<td height="20" colspan="3" align="left" valign="top" class="texts">
										<table width="60%" border="0" align="right" cellpadding="0" cellspacing="0" class="specialarea">
                                    		<tr>
                                        		<td width="29%" valign="middle">
                                        			<input type="radio" class="specialarea" name="status" value='<%=String.valueOf(DriverData.ACTIVE)%>' <%=util.isChecked(parameters,DriverData.ACTIVE)%>>
	                                            	<%=messages.getText("generic.messages.active")%> 
    	                                        </td>
        	                                    <td width="37%" valign="middle">
            	                                	<input type="radio" class="specialarea" name="status" value='<%=String.valueOf(DriverData.EXCLUDED)%>' <%=util.isChecked(parameters,DriverData.EXCLUDED)%>>
                	                            	<%=messages.getText("generic.messages.excluded")%> 
                    	                        </td>
                        	                    <td width="34%" align="left" valign="middle">
                            	                	<input type="radio" class="specialarea" name="status" value='<%=String.valueOf(DriverData.ALL)%>' <%=util.isChecked(parameters,DriverData.ALL)%>>
                                    	        	<%=messages.getText("generic.messages.all.pl")%> 
                                	            </td>
                                          	</tr>
                                        </table>
                                     </td>
								</tr>
								<tr>
									<td height="10" colspan="3">
										<img src="x" width="1" height="1">
									</td>
								</tr>
								<tr>
									<td height="10" colspan="3">
										<table width="100%" cellpadding="0" cellspacing="0" border="0">
                                        	<tr>
                                          		<td valign="middle">
                                          			<img align="middle" border="0" src="/datacenter/util/imgs/icon1.jpg" width="12"> 
                                          		</td>
                                          		<td colspan="3" align="left" valign="middle" class="texts">
                                          			<a href='<%=util.getTemporalAdvancedLink(parameters)%>' class="texts">
                                          				<%=messages.getText("generic.messages.advancedsearch")%>
                                          			</a> 
                                          		</td>
                                          		<td align="right" valign="bottom" class="texts">
                                          			<input name="button" type="button" onClick="javascript:document.forms['searchTemporal'].submit();" value='<%=messages.getText("generic.messages.search")%>' class="input"/>
                                          		</td>
                                        	</tr>
                                      	</table>
									</td>
								</tr>
						  	</table>	
						</form>
<%		}
%>						</td>
					</tr>
				</table>			
   				<jsp:include page="../component/utilityboxbottom.jsp"/>	
		  	</td>
		  	
		  	
<%		if(!advanced) { %>			
        	<td width="16">&nbsp;</td>
        	<td width="70%" valign="top" height="100%">
				<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+
						messages.getText("generic.messages.temporaldriver")%>' />
					<table width="100%" height="60" border="0" cellpadding="0" cellspacing="0">
