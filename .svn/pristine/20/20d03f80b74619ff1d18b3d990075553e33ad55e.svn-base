<%				}	
%>	          							<td width='15%' align="right">
<%				if(sys.getUserSessionData().checkPermission(SecurityConstants.EDIT_DRIVER)) {
%>	              							<a href='layout.jsp?refer=/driver/TemporalDriverView.jsp?id=<%=driver.getId()%>&idTemporalDriver=<%=idTemporalDriver%>&idActivity=<%=idActivity%>' > <%=driver.getFirstName()%> </a>
<%				}else {		
%>                  						<%=driver.getFirstName()%>
<%				}					
