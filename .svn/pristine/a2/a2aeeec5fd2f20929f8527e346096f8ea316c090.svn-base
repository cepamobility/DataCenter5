14151	datatype.zone.populatedrural	t	f	f	EL MARTES 20 DE DICIEMBRE SALÍA DE CAPITAL FEDERAL A LAS 19.50 HS HACIA PILAR. HABÍA MUCHO CONGESTIONAMIENTO DE TRÁNSITO YA QUE ERA HORA PICO. VENÍA POR LA AV FIGUEROA ALCORTA LENTAMENTE PUES NO SE PODÍA AVANZAR Y LLEGANDO A LA CALLE LA PAMPA, FRENO PUES EL TRÁNSITO SE DETENÍA. AL INSTANTE ME CHOCAN. EL CONDUCTOR QUE VENÍA DETRÁS NO LLEGÓ A FRENAR, ME COMENTÓ LUEGO QUE SE LE HABÍA RESBALADO EL PIE. EL IMPACTO FUÉ MENOR PUES TRASITÁBAMOS A BAJA VELOCIDAD.	datatype.collisionclasification.incident	\N	datatype.incidentclasification.almostaccident	datatype.vehiclebehaviour.stuck	generic.messages.nodata	generic.messages.nodata	f	f	f	f	f	f	f	f	f	f	f	f	\N	datatype.driverstate.safe	0	\N	0	0	\N	\N	f	f	f	f	f	f	f	f	f	f	\N	\N	\N	\N	\N	\N	\N	\N	\N	\N	generic.messages.nodata	generic.messages.nodata	datatype.way.straight	datatype.circulationdirection.nodata	generic.messages.nodata	generic.messages.nodata	datatype.conditionrout.inreparation	0	0	\N	\N	\N	\N	\N	\N
14143	datatype.zone.populatedrural	t	f	f	CIRCULANDO POR LA RUTA 33, DESDE RIVADAVIA A GRAL. VILLEGAS, ESCUCHO UN RUIDO EN EL GUARDABARRO E INMEDIATAMENTE NOTO UN PEQUENO DESPLAZAMIENTO TRASERO DEL AUTO. NO OBSERVO NADIE POR EL ESPEJO RETROVISOR Y ME DETENGO INMEDIATAMENTE EN LA BANQUINA OBSERVANDO CASI DESINFLADO TOTALMENTE EL NEUMÁTICO TRASERO. COMO VIAJABA ACOMPANADO POR MARCELO BOJANICH, PROCEDEMOS A CAMBIAR EL NEUMÁTICO OBSERVANDO QUE EL MISMO HABÍA SIDO PERFORADO POR ALGÚN OBJETO PUNZANTE. SEGUIMOS VIAJANDO YA POR LA RUTA 188 CON DESTINO A PERGAMINO CUANDO PASANDO POR LA LAGUNA DE GÓMEZ (KM 171) SE ESCUCHA APENAS UNA PEQUENA EXPLOSIÓN Y UNA LEVE DESESTABILIZACIÓN DEL AUTO. COMO NO SE VEÍA NADIE CERCA, ME DETENGO EN LA BANQUINA OBSERVANDO QUE EL OTRO NEUMÁTICO TRASERO (IZQUIERDO) HABÍA REVENTADO SOBRE EL TALÓN. COMO NO TENÍAMOS UN SEGUNDO NEUMÁTICO DE AUXILIO, DEBIDO A QUE EL ANTERIOR NO SE PUDO ARREGLAR, LLAMO AL NRO. DEL SEGURO Y EN 45 MINUTOS NOS ENVÍAN EL AUXILIO QUE NOS TRAE DE REGRESSO E PERGAMINO. SE LE COLOCARON DOS CUBIERTAS NUEVAS ADELANTE Y LAS DE ADELANTE ATRÁS. SE LE REALIZÓ ALINEACIÓN Y BALANCEO.	datatype.collisionclasification.incident	\N	datatype.incidentclasification.almostaccident	datatype.vehiclebehaviour.forward	generic.messages.nodata	generic.messages.nodata	f	f	f	f	f	f	f	f	f	f	f	f	\N	datatype.driverstate.safe	0	\N	0	0	\N	\N	f	f	f	f	f	f	f	f	f	f	\N	\N	\N	\N	\N	\N	\N	\N	\N	\N	generic.messages.nodata	generic.messages.nodata	datatype.way.straight	datatype.circulationdirection.nodata	generic.messages.nodata	generic.messages.nodata	datatype.conditionrout.inreparation	0	0	\N	\N	\N	\N	\N	\N
14149	datatype.zone.populatedrural	t	f	f	TRANSITANDO POR LA RUTA N.51 A LA ALTURA DE SAN ANDRES DE GILES EN DIRECCIÓN A MAR DEL PLATA, UNA CAMIONETA FORD QUE TRANSITABA EN DIRECCIÓN OPUESTA A LA MÍA, SE DISPONE A SUPERAR/PASAR UN CAMIÓN CON TANQUE TÉRMICO QUE TRANSITABA EN EL MISMO SENTIDO QUE LA CAMIONETA. REALIZA ESTA MANIOBRA CUANDO MI CAMIÓN YA ESTABA MUY PRÓXIMO A LOS DOS VEHÍCULOS, POR LO QUE LA CAMIONETA NO ALCANZA A SOBREPASAR EL CAMIÓN. LE HAGO REPETIDAMENTE SENAS DE LUCES, BAJO LA VELOCIDAD, Y LA CAMIONETA TERMINA TIRÁNDOSE A LA BANQUINA Y PASANDO POR EL LADO DERECHO DE MI CAMIÓN. NO SUFRIMOS CONSECUENCIAS PORQUE RECORDÉ LOS CURSOS DE MANEJO, Y ME MANTUVE SOBRE EL ASFALTO, SIN INTENTAR MANIOBRAR HACIA LOS LADOS.	datatype.collisionclasification.incident	\N	datatype.incidentclasification.almostaccident	datatype.vehiclebehaviour.forward	generic.messages.nodata	generic.messages.nodata	f	f	f	f	f	f	f	f	f	f	f	f	\N	datatype.driverstate.safe	0	\N	0	0	\N	\N	f	f	f	f	f	f	f	f	f	f	\N	\N	\N	\N	\N	\N	\N	\N	\N	\N	generic.messages.nodata	generic.messages.nodata	datatype.way.straight	datatype.circulationdirection.twowaywithout	generic.messages.nodata	generic.messages.nodata	datatype.conditionrout.inreparation	0	0	\N	\N	\N	\N	\N	\N
14135	datatype.zone.populatedrural	t	f	f	ME TRASLADABA DESDE LA LOCALIDAD DE PEHUAJO, DEL REGRESO A MI CASA EN GENERAL PICO, CUANDO DE REPENTE EL MOTOR PERDIÓ FUERZA Y DEJO DE RESPONDER EL ACELERADOR. INSTANTÁNEAMENTE MIRE, HACIA ATRÁS POR EL RETROVISOR PARA REALIZAR UNA MANIOBRA PRUDENTE Y ESTACIONAR EN LA BANQUINA. AL HACERLO VEO QUE POR EL CANO DE ESCAPE, EL AUTO ELIMINABA UN DENSO HUMO BLANCO. DETUVE LA MARCHA, COLOQUE LAS BALIZAS, Y ME COMUNIQUE CON LA GRUA. ACLARO QUE EL AUTO VENIA REGISTRANDO UN CONSUMO EXCESIVO DE ACEITE, SIN ENCONTRARSE EN LOS REPETIDOS CONTROLES QUE LE REALICE, PÉRDIDA ALGUNA. EL PRIMER DIAGNOSTICO QUE ME HA BRINDADO LA CONCESIONARIA ES, ROTURA DE PISTONES, Y PERFORACIÓN DEL BLOCK DEL MOTOR. 	datatype.collisionclasification.incident	\N	datatype.incidentclasification.mecanicalfail	datatype.vehiclebehaviour.forward	generic.messages.nodata	generic.messages.nodata	f	f	f	f	f	f	f	f	f	f	f	f	\N	datatype.driverstate.safe	0	\N	0	0	\N	\N	f	f	f	f	f	f	f	f	f	f	\N	\N	\N	\N	\N	\N	\N	\N	\N	\N	generic.messages.nodata	generic.messages.nodata	datatype.way.straight	datatype.circulationdirection.nodata	generic.messages.nodata	generic.messages.nodata	datatype.conditionrout.inreparation	0	0	\N	\N	\N	\N	\N	\N
