--
-- Name: vehiclelog; Type: TABLE; Schema: public; Owner: postgres; Tablespace: 
--

CREATE TABLE vehiclelog (
    vehicle integer NOT NULL,
    userid character varying(255) NOT NULL,
    date timestamp without time zone NOT NULL,
    "action" integer NOT NULL,
    "comment" character varying(255) NOT NULL,
    divorg1 integer,
    divorg2 integer,
    divorg3 integer,
    geolevel1 integer,
    corporationid integer NOT NULL,
    country integer NOT NULL,
    matricula character varying(255) NOT NULL,
    model character varying(255) NOT NULL,
    trade character varying(255) NOT NULL,
    cover character varying(255),
    "type" character varying(255) NOT NULL,
    "year" integer NOT NULL,
    colour character varying(255),
    permissionnumber character varying(255),
    use character varying(255) NOT NULL,
    permissionexpiry timestamp without time zone,
    ownership character varying(255),
    fuel character varying(255),
    purchasedate timestamp without time zone,
    chasisnumber character varying(255),
    engine character varying(255),
    tankcapacity integer,
    tankunit character varying(255),
    abs boolean,
    airbag boolean,
    aireacondicionado boolean,
    odometerunit character varying(255),
    driver integer
);


ALTER TABLE public.vehiclelog OWNER TO postgres;

--
-- Name: vehicles; Type: TABLE; Schema: public; Owner: postgres; Tablespace: 
--

CREATE TABLE vehicles (
    id integer NOT NULL,
    matricula character varying(255) NOT NULL,
    model character varying(255) NOT NULL,
    trade character varying(255) NOT NULL,
    cover character varying(255),
    "type" character varying(255) NOT NULL,
    "year" integer NOT NULL,
    colour character varying(255),
    permissionnumber character varying(255),
    use character varying(255) NOT NULL,
    permissionexpiry timestamp without time zone,
    centercost character varying(255),
    fuel character varying(255),
    purchasedate timestamp without time zone,
    chasisnumber character varying(255),
    engine character varying(255),
    tankcapacity integer,
    tankunit character varying(255),
    abs boolean,
    airbag boolean,
    aireacondicionado boolean,
    odometerunit character varying(255),
    driver integer,
    unit integer,
    geolevel1 integer,
    corporation integer,
    country integer,
    divorg1 integer,
    divorg2 integer,
    divorg3 integer
);


ALTER TABLE public.vehicles OWNER TO postgres;

--
