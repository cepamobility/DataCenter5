--
-- Data for Name: fines; Type: TABLE DATA; Schema: public; Owner: postgres
--

COPY fines (id, "type", points, qualify, cost, observations) FROM stdin;
\.


--
-- Data for Name: fleetaccidents; Type: TABLE DATA; Schema: public; Owner: postgres
--

COPY fleetaccidents (id, fleet, period, "year", corporation, unit, country, divorg1, divorg2, divorg3, clasification, consequence, number, cost) FROM stdin;
\.


--
-- Data for Name: fleetdivisiondetail; Type: TABLE DATA; Schema: public; Owner: postgres
--

COPY fleetdivisiondetail (id, period, "year", vehicles, miles, accidents, incidents, apmm) FROM stdin;
\.


--
-- Data for Name: fleetdivisions; Type: TABLE DATA; Schema: public; Owner: postgres
--

COPY fleetdivisions (id, fleet, vehicletype, odometer, geolevel2, geolevel1, country, unit, divorg11, divorg12, divorg13, divorg21, divorg22, divorg23, divorg31, divorg32, divorg33) FROM stdin;
\.


--
-- Data for Name: fleetincidents; Type: TABLE DATA; Schema: public; Owner: postgres
--

COPY fleetincidents (id, fleet, period, "year", corporation, unit, country, divorg1, divorg2, divorg3, clasification, number, cost) FROM stdin;
\.


