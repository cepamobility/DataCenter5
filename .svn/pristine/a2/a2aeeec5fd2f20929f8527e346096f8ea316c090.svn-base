11631	datatype.zone.populatedrural	t	f	f	ESTAVA ME DESLOCANDO DO AEROPORTO PARA A MINHA RESIDÊNCIA, CHEGANDO DE VIAGEM À TRABALHO. ESTAVA ACOMPANHADO DE MINHA FAMÍLIA. PAREI O CARRO ATRÁS E AO LADO DE OUTROS VEÍCULOS. O TRÂNSITO ESTAVA CALMO. OBSERVANDO O RETROVISOR NOTEI UM CAMINHÃO VERMELHO SE APROXIMANDO EM VELOCIDADE, SE DESLOCANDO PARA A MINHA DIREITA. NÃO HAVIA COMO PASSAR A DIREITA SOMENTE SOBRE O MEIO FIO. ELE COLIDIU NA LATERAL TRASEIRA DIREITA. ME DESLOQUEI UM POUCO À ESQUERDA, POIS ESPERAVA A COLISÃO, SOLTANDO O PEDAL DO FREIO. O IMPACTO FOI PEQUENO, CAUSANDO APENAS DANOS MATERIAIS. TODOS NÓS, DA MINHA FAMÍLIA E DO CAMINHÃO, NÃO SOFREMOS NENHUM DANO PESSOAL. O MOTORISTA DO CAMINHÃO CONCORDOU COM ESTA VERSÃO E INFORMOU QUE ESTAVA COM PROBLEMAS NO SISTEMA DE FREIO, CONFORME BOLETIM MUNICIPAL DE OCORRÊNCIA. A EMPRESA DO MOTORISTA DO CAMINHÃO ACIONOU A SEGURADORA E ASSUMIU VERBALMENTE A RESPONSABILIDADE.	datatype.collisionclasification.incident	\N	datatype.incidentclasification.almostaccident	datatype.vehiclebehaviour.stuck	generic.messages.nodata	generic.messages.nodata	f	f	f	f	f	f	f	f	f	f	f	f	\N	datatype.driverstate.safe	0	\N	0	0	\N	\N	f	f	f	f	f	f	f	f	f	f	\N	\N	\N	\N	\N	\N	\N	\N	\N	\N	datatype.climate.goodweather	datatype.lighting.daylight	datatype.way.straight	datatype.circulationdirection.oneway	generic.messages.nodata	generic.messages.nodata	datatype.conditionrout.dry	3500	0	\N	\N	\N	\N	\N	\N
12845	datatype.zone.populatedrural	t	f	f	AS 11:30, NA ROD WASHINGTON LUIZ, KM 176, UM CAMINHAO QUE SEGUIA PELA VIA DA DIREITA, COLIDIU NA TRASEIRA DE OUTRO CAMINHAO, SENDO DESLOCADO PARA A VIA DA ESQUERDA, 30 M A FRENTE DE MEU VEÍCULO. ESTAVA CONDUZINDO MEU VEÍCULO A VELOCIDADE DE 90 KM/H, QUANDO PERCEBI O ACIDENTE, BREQUEI BOMBANDO O FREIO E DESVIEI PARA A ESQUERDA, EVITANDO COLISÃO TRASEIRA NO CAMINHÃO, PORÉM HOUVE UM ARRANHÃO LATERAL DA CAÇAMBA DO CAMINHÃO NO MEU VEÍCULO. O CAMINHÃO TRANSPORTAVA BARRIS DE FERRO VAZIO E UM DOS BARRIS CAIU DO CAMINHAO E BATEU NA FRENTE DO MEU VEICULO, CAUSANDO LEVES DANOS NO PARA-CHOQUE, PLACA E FAROL DE MILHA. OBS:O TREINAMENTO REALIZADO PELA CEPA FOI MUITO INFLUENTE NA MINHA REAÇÃO, PARA DESVIAR E PARAR O VEICULO SEM MAIORES DANOS PESSOAIS E MATERIAIS.	datatype.collisionclasification.incident	\N	datatype.incidentclasification.objectfall	datatype.vehiclebehaviour.forward	generic.messages.nodata	generic.messages.nodata	f	f	f	f	f	f	f	f	f	f	f	f	\N	datatype.driverstate.safe	0	\N	0	0	\N	\N	f	f	f	f	f	f	f	f	f	f	\N	\N	\N	\N	\N	\N	\N	\N	\N	\N	datatype.climate.goodweather	datatype.lighting.daylight	datatype.way.straight	datatype.circulationdirection.oneway	generic.messages.nodata	generic.messages.nodata	datatype.conditionrout.dry	113	0	\N	\N	\N	\N	\N	\N
