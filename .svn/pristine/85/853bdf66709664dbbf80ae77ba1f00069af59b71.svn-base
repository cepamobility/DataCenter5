package persistence.driver.tables;


public class DriverPointHistory {

    private DriverPointHistoryPK pk;
    private Double total;
    private Integer level;
    
    public DriverPointHistory() {
    }

	public DriverPointHistoryPK getPk() {
		return pk;
	}

	public void setPk(DriverPointHistoryPK pk) {
		this.pk = pk;
	}

	public Double getTotal() {
		return total;
	}

	public void setTotal(Double total) {
		this.total = total;
	}

	public Integer getLevel() {
		return level;
	}

	public void setLevel(Integer level) {
		this.level = level;
	}

}
