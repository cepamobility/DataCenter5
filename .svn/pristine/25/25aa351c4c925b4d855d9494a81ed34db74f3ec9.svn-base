		this.vehicle = vehicle;
		this.date = date;
		this.itemValueSet = itemValueSet;
		this.name = name;
		this.obs = obs;
		this.result = result;
		this.inspectedby = inspectedby;
		this.distrito = distrito;
		this.grupo = grupo;
	}	
	
		
	
