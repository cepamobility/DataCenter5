package communication.fleet.tables;

import java.io.Serializable;

import communication.datatype.tables.TypeVehicleDataType;

public class ColectiveFleetData extends FleetData implements Serializable {

    private TypeVehicleDataType vehicleType;
    
    public ColectiveFleetData() {
    }

    /**
     * @return Returns the vehicleType.
     */
    public TypeVehicleDataType getVehicleType() {
        return vehicleType;
    }

    /**
     * @param vehicleType The vehicleType to set.
     */
    public void setVehicleType(TypeVehicleDataType vehicleType) {
        this.vehicleType = vehicleType;
    }
}
