							<a href="layout.jsp?refer=/driver/DriverSearch.jsp?link=layout.jsp?refer=/user/driverUser.jsp&title=generic.user.selectdriver">
								<%=messages.getText("generic.user.newdriveruser")%> 
							</a>
            			</td>
            		</tr>
					<tr>
						<td class="linetwo">
            				<img align="middle" border="0" height="12" src="/datacenter/util/imgs/icon1.jpg" width="12">&nbsp; 
							<a href="layout.jsp?refer=/driver/DriverSearch.jsp?link=layout.jsp?refer=/user/cdsUser.jsp&title=generic.user.selectdriver&type=cds">
								<%=messages.getText("generic.user.newcdsuser")%> 
							</a>
            			</td>
            		</tr>
					<tr>
						<td class="linetwo">
            				<img align="middle" border="0" height="12" src="/datacenter/util/imgs/icon1.jpg" width="12">&nbsp; 
							<a href="layout.jsp?refer=/driver/DriverSearch.jsp?link=layout.jsp?refer=/user/fleetDriverUser.jsp&title=generic.user.selectdriver">
								<%=messages.getText("generic.user.newfleetdriveruser")%> 
							</a>
            			</td>
            		</tr>
            		<% if (sys.getUserSessionData().getFilter().getCorporationId().intValue() == CorporationData.FORESTALORIENTAL ||sys.getUserSessionData().getFilter().getCorporationId().intValue() == CorporationData.MONTES_DE_PLATA ||
            			   sys.getUserSessionData().getFilter().getCorporationId().intValue() == CorporationData.LOSPIQUES){
            				// Usuarios Contratistas:
            			%>
            		<tr>
						<td class="linetwo">
            				<img align="middle" border="0" height="12" src="/datacenter/util/imgs/icon1.jpg" width="12">&nbsp; 
							<a href="layout.jsp?refer=/user/contractorUser.jsp?target=UserNEDList"> 
            					<%=messages.getText("web.user.usernedlist.newcontractoruser")%> 
            				</a>
            			</td>
            		</tr>
            		<% } // Fin Usuarios Contratistas %>
<%			}	
%>        		</table>
				<jsp:include  page="../component/utilityboxbottom.jsp" />
			</td>
    		<td width="16">&nbsp;</td>
    		<td width="292" valign="top">
				<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("generic.messages.search")%>' />
	    		<table width="100%" border="0" cellpadding="0" cellspacing="0">
					<tr>
						<td>
							<form action="layout.jsp?refer=/user/UserNEDList.jsp" method="post">
								<input type="hidden" name="pageNum" value='<%=String.valueOf(pageNum)%>'/>
<%			if(all) {
%>								<input type="hidden" name="all" value="all"/>
<%			}
%>								<input type="hidden" name="pageNum2" value='<%=pageNum%>'/>
								<select name="attribute" class="input" onChange="javascript:modifyOptions()">
									<option value="firstName" <%= (attribute.equals("firstName"))?"selected":""%>><%=messages.getText("generic.user.userdata.firstname")%></option>
									<option value="lastName" <%= (attribute.equals("lastName"))?"selected":""%>><%=messages.getText("generic.user.userdata.lastname")%></option>
								</select>
								<input type="text" name="value" size="16" class="input" value='<%=value%>'/>
								<input name="button" type="button" onClick="javascript:doSubmit();" value='<%=messages.getText("generic.messages.search")%>' class="input"/>
								<input type="hidden" name="pageSize" value='<%=pageSize%>'/>
							</form>
						</td>
					</tr>
				</table>
				<jsp:include  page="../component/utilityboxbottom.jsp" />
			</td>
	  	</tr>
  		<tr>
			<jsp:include  page="../component/spaceline.jsp" />
  		</tr>
  		<tr>
    		<td colspan="3">
				<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("web.user.usernedlist.systemusers")%>' />
    			<table width="100%" border="0" align="center" cellpadding="0" cellspacing="0">
      				<tr>
<%!		Iterator iter; UserAttributes user; int i;
		String uid; boolean linetwo;
%>
<%		linetwo = true;
		if(col!=null && col.isEmpty()){
%>
		                <td class="guide2" width="18%"><%=messages.getText("generic.user.userdata.firstname")%></td>
		                <td class="guide2" width="18%"><%=messages.getText("generic.user.userdata.lastname")%></td>
		                <td class="guide2" width="18%"><%=messages.getText("generic.user.userdata.nickname")%></td>
		                <td class="guide2" width="30%"><%=messages.getText("generic.user.userdata.mail")%></td>
		                <td class="guide2" width="18%"><%=messages.getText("generic.user.userdata.language")%></td>
              		</tr>
              		<tr>
              			<td colspan="5"><%=messages.getText("generic.messages.notresult")%></td>
              		</tr>
            	</table>
<%		}else {
			if(col!=null) {
				iter=col.iterator();
%>	        	<html:form action="/Userdelete"  >
              		<table width="100%" border="0">
                		<tr align="center">
<%				if(sys.getUserSessionData().checkPermission(SecurityConstants.DELETE_USER)) {		
%>							<td width="3%" class="guide2">&nbsp;</td>
<%				}		
%>					        <td width="18%" class="guide2"><%=messages.getText("generic.user.userdata.firstname")%></td>
			                <td width="18%" class="guide2"><%=messages.getText("generic.user.userdata.lastname")%></td>
			                <td width="18%" class="guide2"><%=messages.getText("generic.user.userdata.nickname")%></td>
			                <td width="30%" class="guide2"><%=messages.getText("generic.user.userdata.mail")%></td>
			                <td width="18%" class="guide2"><%=messages.getText("generic.user.userdata.language")%></td>
                		</tr>
              		</table>
              		<table name="users" width="100%" >
<%				while(iter.hasNext()){
	    			user=(UserAttributes)iter.next();
%>	            		<tr align=center class='<%=(linetwo)?"linetwo":"lineone"%>'>
<%					linetwo = !linetwo;	
					if(sys.getUserSessionData().checkPermission(SecurityConstants.DELETE_USER)) {	
%>	              			<td width="3%" align="center">
								<input type='checkbox' name='<%=user.getLoginName()%>' value='<%=user.getLoginName()%>' >                  
							</td>
<%					}	
%>	              			<td width="18%" align="right">
<%					if(sys.getUserSessionData().checkPermission(SecurityConstants.EDIT_USER)) {	
%>		              			<a href='layout.jsp?refer=/user/UserView.jsp?uid=<%=user.getLoginName()%>' > <%=user.getFirstName()%> </a>
<%					}else{	
%>	                  			<%=user.getFirstName()%>
<%					}	
%>                  		</td>
                  			<td width="18%" align="right"><%=user.getLastName()%></td>
                  			<td width="18%" align="right"><%=user.getLoginName()%></td>
                  			<td width="30%" align="right"><%=user.getEmail()%></td>
                  			<td width="18%" align="right"><%=messages.getText(user.getLanguage())%></td>
                		</tr>
<%				}
%>		            </table>
              		<html:hidden property="checkboxParamList" />
            	</html:form>
            	<table width='100%'  border="0" cellpadding="0" cellspacing="0" class="default">
