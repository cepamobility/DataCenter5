package persistence.util.tables;

public class ContratistType {

	private Integer contratist;
	private Integer type;
	private String emails;
	
	public ContratistType() {
	}

	public ContratistType(Integer contratist, Integer type, String emails) {
		this.contratist = contratist;
		this.type = type;
		this.emails = emails;
	}

	public Integer getContratist() {
		return contratist;
	}
	
	public void setContratist(Integer contratist) {
		this.contratist = contratist;
	}
	
	public Integer getType() {
		return type;
	}
	
	public void setType(Integer type) {
		this.type = type;
	}

	public String getEmails() {
		return emails;
	}

	public void setEmails(String emails) {
		this.emails = emails;
	}
	
}
