package persistence.util.tables;

import java.io.Serializable;
import java.util.Date;

public class DriverAccessLogPK implements Serializable {

	public Integer driver;
	public String userId;
	public Date date;

	public DriverAccessLogPK() {
	}

	public DriverAccessLogPK(Integer driver, String userId, Date date) {
		this.driver = driver;
		this.userId = userId;
		this.date = date;
	}

	public Integer getDriver() {
		return driver;
	}

	public void setDriver(Integer driver) {
		this.driver = driver;
	}

	public String getUserId() {
		return userId;
	}

	public void setUserId(String userId) {
		this.userId = userId;
	}

	public Date getDate() {
		return date;
	}

	public void setDate(Date date) {
		this.date = date;
	}
	
	
}
