    public Object[] findFleetData(Integer fleet,UserSessionData userSessionData) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"findFleetData",this.getClass());
        Object[] data = null;
        try {
            Session session = HibernateUtil.currentSession();
            Query q = session.createSQLQuery(
            		"SELECT name,description,period,exclusiondate " +
            		"FROM genericfleets WHERE id = "+String.valueOf(fleet)).
            		addScalar("name",Hibernate.STRING).
            		addScalar("description",Hibernate.STRING).
            		addScalar("period",Hibernate.INTEGER).
            		addScalar("exclusiondate",Hibernate.STRING);
            data = (Object[])q.uniqueResult();
        }catch(Exception e) {
        	Object[] parameters = {fleet};
            handler.getException(e,"findFleetData",userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"findFleetData",this.getClass());
        return data;
    }

    /**
