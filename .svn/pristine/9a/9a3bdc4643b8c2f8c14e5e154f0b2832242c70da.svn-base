    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetedit,fleetinsertdata"
     */
    public Collection findFleetIncidents(Integer fleetId,Integer period,Integer year,UserSessionData userSessionData) throws Exception{
        if (fleetId == null) {
            throw new InvalidDataException("findFleetIncidents","fleetId = null");
        }
        
        if (period == null) {
            throw new InvalidDataException("findFleetIncidents","period = null");
        }
        if (year == null) {
            throw new InvalidDataException("findFleetIncidents","year = null");
        }
        if (userSessionData == null) {
            throw new DeslogedException("findFleetIncidents","userSessionData = null");
        }
        try{            
            Session session = HibernateUtil.currentSession();
            Query query = session.createQuery("select incident from FleetIncident as incident " +
                    "where incident.corporation.id = "+userSessionData.getFilter().getCorporationId()+
                    " and incident.fleet.id = :fleet and incident.period = :period and incident.year = :year");
            query.setParameter("fleet", fleetId);
            query.setParameter("period", period);
            query.setParameter("year", year);
            Iterator it = query.list().iterator();
            Collection list = new LinkedList();
            while(it.hasNext()) {
                FleetIncident fleet = (FleetIncident)it.next(); 
                list.add(fleet.getFleetIncidentData());
            }
            return list;
        } catch(Exception e){
        	Object[] parameters = {fleetId,period,year};
            handler.getException(e,"findFleetIncidents",userSessionData,parameters);
        }
        return null;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetedit,driverfleetinsertdata,fleetinsertdata"
     */
    public Hashtable findOdometers(Integer fleet,Integer currentPeriod,Integer currentYear,
    		Integer year,Integer vehicle,UserSessionData userSessionData) throws Exception {
        Hashtable odometers = new Hashtable();
        if (fleet == null) {
            throw new InvalidDataException("findOdometers","fleet = null");
        }
        if (userSessionData == null) {
            throw new DeslogedException("findOdometers","userSessionData = null");
        }
        try{            
            Session session = HibernateUtil.currentSession();
            String query = "SELECT o.vehicle,o.period,o.year,o.odometer,o.accidents," +
            		"o.incidents,o.fuel,o.fueltype,o.nearmiss FROM odometers o ";
            if(userSessionData.isDriver()) {
                query += "JOIN vehicles v ON o.vehicle = v.id ";
            }
            query += "WHERE o.fleet = "+String.valueOf(fleet);
            if(userSessionData.isDriver()) {
                query += " AND v.driver = "+String.valueOf(userSessionData.getDriverData().getId());
            }
            query += " AND (o.year = "+String.valueOf(currentYear)+" AND o.period <= "+String.valueOf(currentPeriod)+" OR o.year < "+String.valueOf(currentYear)+") "; 
            query += " ORDER BY o.vehicle asc, o.year DESC, o.period DESC";
            SQLQuery q = session.createSQLQuery(query);
            q.addScalar("vehicle",Hibernate.INTEGER);
            q.addScalar("period",Hibernate.INTEGER);
            q.addScalar("year",Hibernate.INTEGER);
            q.addScalar("odometer",Hibernate.INTEGER);
            q.addScalar("accidents",Hibernate.INTEGER);
            q.addScalar("incidents",Hibernate.INTEGER);
            q.addScalar("fuel",Hibernate.INTEGER);
            q.addScalar("fueltype",Hibernate.STRING);
            q.addScalar("nearmiss",Hibernate.INTEGER);
            
            List list = q.list();
            if (list != null){
	            Iterator it = list.iterator();
	            while(it.hasNext()) {
	                Object[] odometer = (Object[])it.next(); 
	                Integer id = (Integer)odometer[0];
	                if(odometers.containsKey(id)) {
	                    OdometerData data = (OdometerData) odometers.get(id);
	                    data.addPrevious((Integer)odometer[1],(Integer)odometer[2],(Integer)odometer[3]);
	                }else {
	                    OdometerData odometerData = new OdometerData(odometer);
	                    if(!odometerData.getPeriod().equals(currentPeriod) || 
	                    	!odometerData.getYear().equals(currentYear)) {
	                    	
	                        odometerData.setPeriod(currentPeriod);
	                        odometerData.setYear(currentYear);
	                        odometerData.setOdometer(null);
	                        odometerData.setAccidents(null);
	                        odometerData.setIncidents(null);
	                        odometerData.setFuel(null);
	                        odometerData.setNearmiss(null);
	                        odometerData.addPrevious((Integer)odometer[1],(Integer)odometer[2],
	                        		(Integer)odometer[3]);
	                    }
	                    odometers.put(id,odometerData);
	                }
	            }
            }
        }catch(Exception e) {
        	Object[] parameters = {fleet,currentPeriod,currentYear,year,vehicle};
            handler.getException(e,"findOdometers",userSessionData,parameters);
        }
        return odometers;
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Collection getReportAPMM(String periodFrom,Integer yearFrom, String periodTo, Integer yearTo, Integer[][] divOrgs, Integer[] divGeos, int order1, int order2, int order3, int order4, UserSessionData userSessionData, Text messages) throws Exception {
        try{            
            Session session = HibernateUtil.currentSession();
            String query = "select sum(detail.vehicles), sum(detail.miles), sum(detail.accidents), " +
            		"sum(detail.incidents), sum(detail.nearmiss), detail.pk.fleet.fleet.period, detail.pk.year, detail.pk.period";
            if(userSessionData.isCorporation(CorporationData.BAYER)) {
            	query += getBayerIndex(order1);
            	query += getBayerIndex(order2);
            	query += getBayerIndex(order3);
            	query += getBayerIndex(order4);
            }else {
	            if(order1 != 4) {
	                if(order1 == 3) {
	                    query += ",detail.pk.fleet.country.id,detail.pk.fleet.country.resourceKey";
	                }else {
	                    String divOrg = userSessionData.getFilter().get2IndexString(order1,0);
	                    if(divOrg != null) {
	                        query += ",detail.pk.fleet."+divOrg+",detail.pk.fleet."+userSessionData.getFilter().get2IndexString(order1,1);
	                    }
	                }
	            }
	            if(order2 != 4) {
	                if(order2 == 3) {
	                    query += ",detail.pk.fleet.country.id,detail.pk.fleet.country.resourceKey";
	                }else {
	                    String divOrg = userSessionData.getFilter().get2IndexString(order2,0);
	                    if(divOrg != null) {
	                        query += ",detail.pk.fleet."+divOrg+",detail.pk.fleet."+userSessionData.getFilter().get2IndexString(order2,1);
	                    }
	                }
	            }
	            if(order3 != 4) {
	                if(order3 == 3) {
	                    query += ",detail.pk.fleet.country.id,detail.pk.fleet.country.resourceKey";
	                }else {
	                    String divOrg = userSessionData.getFilter().get2IndexString(order3,0);
	                    if(divOrg != null) {
	                        query += ",detail.pk.fleet."+divOrg+",detail.pk.fleet."+userSessionData.getFilter().get2IndexString(order3,1);
	                    }
	                }
	            }
	            if(order4 != 4) {
	                if(order4 == 3) {
	                    query += ",detail.pk.fleet.country.id,detail.pk.fleet.country.resourceKey";
	                }else {
	                    String divOrg = userSessionData.getFilter().get2IndexString(order4,0);
	                    if(divOrg != null) {
	                        query += ",detail.pk.fleet."+divOrg+",detail.pk.fleet."+userSessionData.getFilter().get2IndexString(order4,1);
	                    }
	                }
	            }
            }
            query += " from FleetDivisionDetail detail ";
            query += " where detail.pk.fleet.fleet.corporation.id = "+userSessionData.getFilter().getCorporationId();
            query += " and (detail.pk.year = "+String.valueOf(yearFrom)+" AND detail.pk.period >= "+periodFrom+" OR detail.pk.year > "+String.valueOf(yearFrom)+")";
            query += " and (detail.pk.year = "+String.valueOf(yearTo)+" AND detail.pk.period <= "+periodTo+" OR detail.pk.year < "+String.valueOf(yearTo)+")";
            if(divGeos.length > 0) {
                query += " and detail.pk.fleet.country.id in (";
                for(int i = 0; i < divGeos.length; i++) {
                    query += (i == 0) ? String.valueOf(divGeos[i]) : ","+String.valueOf(divGeos[i]);
                }
                query += ") "; 
            }

            if(divOrgs.length > 0 && divOrgs[0] != null) {
                if(divOrgs[0].length > 0) {
                    query += " and detail.pk.fleet.divOrg11.id in (";
                    for(int i = 0; i < divOrgs[0].length; i++) {
                        query += (i == 0) ? String.valueOf(divOrgs[0][i]) : ","+String.valueOf(divOrgs[0][i]);
                    }
                    query += ") "; 
                }
            }
                        
            if(divOrgs.length > 1 && divOrgs[1] != null) {
                if(divOrgs[1].length > 0) {
                    query += " and detail.pk.fleet.divOrg21.id in (";
                    for(int i = 0; i < divOrgs[1].length; i++) {
                        query += (i == 0) ? String.valueOf(divOrgs[1][i]) : ","+String.valueOf(divOrgs[1][i]);
                    }
                    query += ") "; 
                }
            }
            if(divOrgs.length > 2 && divOrgs[2] != null) {
                if(divOrgs[2].length > 0) {
                    query += " and detail.pk.fleet.divOrg31.id in (";
                    for(int i = 0; i < divOrgs[2].length; i++) {
                        query += (i == 0) ? String.valueOf(divOrgs[2][i]) : ","+String.valueOf(divOrgs[2][i]);
                    }
                    query += ") "; 
                }
            }
            query += " group by detail.pk.fleet.fleet,detail.pk.fleet.fleet.period,detail.pk.year,detail.pk.period";
            if(userSessionData.isCorporation(CorporationData.BAYER)) {
            	query += getBayerIndex(order1);
            	query += getBayerIndex(order2);
            	query += getBayerIndex(order3);
            	query += getBayerIndex(order4);
            }else {
	            if(order1 == 3) {
	                query += ",detail.pk.fleet.country.id,detail.pk.fleet.country.resourceKey";
	            }else {
	                String divOrg = userSessionData.getFilter().get2IndexString(order1,0);
	                if(divOrg != null) {
	                    query += ",detail.pk.fleet."+divOrg+",detail.pk.fleet."+userSessionData.getFilter().get2IndexString(order1,1);
	                }
	            }
	            if(order2 != 4) {
	                if(order2 == 3) {
	                    query += ",detail.pk.fleet.country.id,detail.pk.fleet.country.resourceKey";
	                }else {
	                    String divOrg = userSessionData.getFilter().get2IndexString(order2,0);
	                    if(divOrg != null) {
	                        query += ",detail.pk.fleet."+divOrg+",detail.pk.fleet."+userSessionData.getFilter().get2IndexString(order2,1);
	                    }
	                }
	            }
	            if(order3 != 4) {
	                if(order3 == 3) {
	                    query += ",detail.pk.fleet.country.id,detail.pk.fleet.country.resourceKey";
	                }else {
	                    String divOrg = userSessionData.getFilter().get2IndexString(order3,0);
	                    if(divOrg != null) {
	                        query += ",detail.pk.fleet."+divOrg+",detail.pk.fleet."+userSessionData.getFilter().get2IndexString(order3,1);
	                    }
	                }
	            }
	            if(order4 != 4) {
	                if(order4 == 3) {
	                    query += ",detail.pk.fleet.country.id,detail.pk.fleet.country.resourceKey";
	                }else {
	                    String divOrg = userSessionData.getFilter().get2IndexString(order4,0);
	                    if(divOrg != null) {
	                        query += ",detail.pk.fleet."+divOrg+",detail.pk.fleet."+userSessionData.getFilter().get2IndexString(order4,1);
	                    }
	                }
	            }
            }
            //float months = (12 - Integer.parseInt(periodFrom) + 1) + ((yearTo.intValue() - yearFrom.intValue() - 1) * 12) + Integer.parseInt(periodTo);
            Query q = session.createQuery(query);
            Iterator it = q.list().iterator();
            Collection result = new LinkedList();
            while(it.hasNext()) {
                Object[] data = (Object[])it.next();
                APMMByDivisionData detail = new APMMByDivisionData();
                Integer period = (Integer)data[5];
                detail.setTotalVehicles(((Long) data[0]).floatValue(),period);
                String key = data[6]+"-"+data[7];
                detail.setMiles(new Integer(((Long) data[1]).intValue()));
                detail.setAccidents(new Integer(((Long) data[2]).intValue()));
                detail.setIncidents(new Integer(((Long) data[3]).intValue()));
                detail.setNearmiss(new Integer(((Long) data[4]).intValue()));
                int index = 8;
                if(order1 != 4) {
                    detail.setDivOrg1Id((Integer) data[index]);
                    index++;
                    if(order1 == 3){
                        detail.setDivOrg1Name(messages.getText((String) data[index]));
                    }else {
                        detail.setDivOrg1Name((String) data[index]);
                    }
                    index++;
                }
                if(order2 != 4) {
                    detail.setDivOrg2Id((Integer) data[index]);
                    index++;
                    if(order2 == 3){
                        detail.setDivOrg2Name(messages.getText((String) data[index]));
                    }else {
                        detail.setDivOrg2Name((String) data[index]);
                    }
                    index++;
                }
                if(order3 != 4) {
                    detail.setDivOrg3Id((Integer) data[index]);
                    index++;
                    if(order3 == 3){
                        detail.setDivOrg3Name(messages.getText((String) data[index]));
                    }else {
                        detail.setDivOrg3Name((String) data[index]);
                    }
                    index++;
                }
                if(order4 != 4) {
                    detail.setDivOrg4Id((Integer) data[index]);
                    index++;
                    if(order4 == 3){
                        detail.setDivOrg4Name(messages.getText((String) data[index]));
                    }else {
                        detail.setDivOrg4Name((String) data[index]);
                    }
                    index++;
                }
                Iterator it2 = result.iterator();
                boolean find = false;
                while(it2.hasNext() && !find) {
                    APMMByDivisionData divisionData = (APMMByDivisionData)it2.next();
                    if(divisionData.equalsData(detail)) {
                        find = true;
                        divisionData.addTotalData(detail,key,period);
                    }
                }
                if(!find) {
                    detail.addMonth(key,period);
                    result.add(detail);
                }
            }
            return result;
        } catch(Exception e){
            Object[] parameters = {periodFrom,yearFrom,periodTo,yearTo,divOrgs,divGeos,order1,order2,order3,order4,messages};
            handler.getException(e,"getReportAPMM",userSessionData,parameters);
        }
        return null;
    }
    
    private String getBayerIndex(int order) {
		switch(order) {
			case 2:
				return ",detail.pk.fleet.divOrg11.id,detail.pk.fleet.divOrg11.resourceKey";
			case 1:
				return ",detail.pk.fleet.divOrg12.id,detail.pk.fleet.divOrg12.resourceKey";
			case 0:
				return ",detail.pk.fleet.divOrg13.id,detail.pk.fleet.divOrg13.resourceKey";
			case 3:
				return ",detail.pk.fleet.country.id,detail.pk.fleet.country.resourceKey";
			case 7:
				return ",detail.pk.fleet.divOrg21.id,detail.pk.fleet.divOrg21.resourceKey";
			case 6:
				return ",detail.pk.fleet.divOrg22.id,detail.pk.fleet.divOrg22.resourceKey";
			case 5:
				return ",detail.pk.fleet.divOrg23.id,detail.pk.fleet.divOrg23.resourceKey";
		}
		return "";
	}

