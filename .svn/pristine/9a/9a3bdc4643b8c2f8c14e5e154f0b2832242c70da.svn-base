     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetinsertdata"
     */
    public Collection getFleetDivisions(Integer fleet, UserSessionData userSessionData) throws Exception {    
        Collection result = new LinkedList();
        try {    
            Session session = HibernateUtil.currentSession();
            Query query = session.createQuery("SELECT fd FROM FleetDivision AS fd WHERE fd.fleet.id = "+String.valueOf(fleet));
            List list = query.list();
            if (list != null){
	            Iterator it = list.iterator();
	            while (it.hasNext()) {
	                result.add(((FleetDivision)it.next()).getData());
	            }
            }
        } catch(Exception e){
        	Object[] parameters = {fleet};
            handler.getException(e,"getFleetDivisions",userSessionData,parameters);
        }
        return result;
    }

    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetinsertdata"
     */
    public Collection getVehiclesByFleet(Integer fleet,UserSessionData userSessionData) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"getVehiclesByFleet",this.getClass());
        Collection data = new LinkedList();
        try {
            Session session = HibernateUtil.currentSession();
            String sql = "SELECT v.id,v.matricula,d.firstname,d.lastname,v.country,v.divorg1,v.divorg2,v.divorg3, "+
            		"v.trade,v.model,v.year, d.id as iddriver " +
            		"FROM vehiclefleets vf ";
            sql += " JOIN vehicles v ON vf.vehicle = v.id "; 
            sql += " LEFT JOIN drivers d ON v.driver = d.id "; 
            sql += " WHERE v.exclusiondate IS NULL AND vf.id = "+String.valueOf(fleet);
            sql += " ORDER BY v.country,v.divorg1,v.divorg2,v.divorg3, d.firstname, d.lastname, v.matricula ";
            SQLQuery q = session.createSQLQuery(sql);
            q.addScalar("id",Hibernate.INTEGER);
            q.addScalar("matricula",Hibernate.STRING);
            q.addScalar("firstname",Hibernate.STRING);
            q.addScalar("lastname",Hibernate.STRING);
            q.addScalar("country",Hibernate.INTEGER);
            q.addScalar("divorg1",Hibernate.INTEGER);
            q.addScalar("divorg2",Hibernate.INTEGER);
            q.addScalar("divorg3",Hibernate.INTEGER);
            q.addScalar("trade",Hibernate.STRING);
            q.addScalar("model",Hibernate.STRING);
            q.addScalar("year",Hibernate.INTEGER);
            q.addScalar("iddriver",Hibernate.INTEGER);
            data = q.list();
        } catch (Exception e) {
        	Object[] parameters = {fleet};
        	handler.getException(e,"getVehiclesByFleet",userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"getVehiclesByFleet",getClass());
        return data;
    }
    
    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetinsertdata"
     */
    public Hashtable getOdometerType(Integer fleet,UserSessionData userSessionData) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"getOdometerType",this.getClass());
        Hashtable hash = new Hashtable();
        try {
            Session session = HibernateUtil.currentSession();
            SQLQuery q = session.createSQLQuery("SELECT odometer,country,divorg11,divorg21,divorg31 " +
            		"FROM fleetdivisions WHERE fleet = "+String.valueOf(fleet));
            q.addScalar("odometer",Hibernate.STRING);
            q.addScalar("country",Hibernate.INTEGER);
            q.addScalar("divorg11",Hibernate.INTEGER);
            q.addScalar("divorg21",Hibernate.INTEGER);
            q.addScalar("divorg31",Hibernate.INTEGER);
            List list = q.list();
            if (list != null){
	            Iterator it = list.iterator();
	            while(it.hasNext()) {
	                Object[] data = (Object[])it.next();
	                String key = String.valueOf(data[1])+"-"+String.valueOf(data[2])+"-"+String.valueOf(data[3])+"-"+String.valueOf(data[4]);
	                hash.put(key,data[0]);
	            }
            }
        } catch (Exception e) {
        	Object[] parameters = {fleet};
        	handler.getException(e,"getOdometerType",userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"getOdometerType",getClass());
        return hash;
    }

