            		" FROM vehicles v" +
            		" WHERE v.driver IS NOT NULL AND v.exclusiondate IS NULL " +
            		" AND v.driver IN (" + inSQL + ") " +
/*cambio ecolab ene            		" AND v.id NOT IN (SELECT DISTINCT vehicle FROM odometers WHERE year = "+year+")";*/
/*Cambio ecolab dic*/   		" AND v.id NOT IN (SELECT DISTINCT vehicle FROM odometers WHERE ((year = "+year+" and period < 12) or (year = "+String.valueOf(year-1)+" and period = 12)))";
