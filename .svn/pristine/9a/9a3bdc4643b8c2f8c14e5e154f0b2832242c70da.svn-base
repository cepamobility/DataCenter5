        }
        if (period == null) {
            throw new InvalidDataException("findFleetAccidents","period = null");
        }
        if (year == null) {
            throw new InvalidDataException("findFleetAccidents","year = null");
        }
        if (userSessionData == null) {
            throw new DeslogedException("findFleetAccidents","userSessionData = null");
        }
        try{            
            Session session = HibernateUtil.currentSession();
            Query query = session.createQuery("select accident from FleetAccident as accident " +
                    "where accident.corporation.id = "+userSessionData.getFilter().getCorporationId()+
                    " and accident.fleet.id = :fleet and accident.period = :period and accident.year = :year");
            query.setParameter("fleet", fleetId);
            query.setParameter("period", period);
            query.setParameter("year", year);
        	
            Collection list = new LinkedList();
            List list2 = query.list();
            if (list2 != null){
            	Iterator it = list2.iterator();
            	while(it.hasNext()) {
            		FleetAccident fleet = (FleetAccident)it.next(); 
            		list.add(fleet.getFleetAccidentData());
            	}
            }
            return list;
        } catch(Exception e){
        	Object[] parameters = {fleetId,period,year};
            handler.getException(e,"findFleetAccidents",userSessionData,parameters);
        }
        return null;
    }

    /**
