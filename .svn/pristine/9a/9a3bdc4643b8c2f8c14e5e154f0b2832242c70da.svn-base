    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetdelete"
     * @param id Fleet that will be delete
     * @param userRequest User logged
     */
    public boolean validateDelete(Integer fleetId, UserSessionData userSessionData) throws Exception {
        try{ 
        	int value = 0;
        	Object result;
            Session session = HibernateUtil.currentSession();
            
            Query query = session.createQuery("select count(detail) from FleetDivisionDetail as detail " +
                    "where detail.pk.fleet.fleet.id = :fleet ");
            query.setParameter("fleet",fleetId);
            result = query.uniqueResult();
            if (result != null){
            	value = ((Long)result).intValue();
            }            
            if(value != 0) {
                return false;
            }
            
            query = session.createQuery("select count(odometer) from Odometer as odometer " +
                "where odometer.pk.fleet.id = :fleet ");
            query.setParameter("fleet",fleetId);
            result = query.uniqueResult();
            if (result != null){
            	value = ( (Long)result).intValue();
            }
            if(value != 0) {
                return false;
            }
            
        }catch(Exception e) {
            Object[] parameters = {fleetId};
            handler.getException(e,"validateDelete",userSessionData,parameters);
        }
        return true;
    }

