    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetinsertdata"
     */
    public Collection getExcludedOdometer(Integer fleet,Integer period,Integer year,Integer country,Integer divorg1,Integer divorg2,Integer divorg3,UserSessionData userSessionData) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"getExcludedOdometer",this.getClass());
        Collection list = new LinkedList();
        try {
            Session session = HibernateUtil.currentSession();
            String sql = "SELECT v.id,v.matricula,d.firstname,d.lastname "+
                "FROM odometers o "+
                "JOIN vehicles v ON o.vehicle = v.id "+
                "LEFT JOIN drivers d ON v.driver = d.id "+
                "WHERE fleet = "+String.valueOf(fleet)+" "+ 
                "AND o.period = "+String.valueOf(period)+" "+
                "AND o.year = "+String.valueOf(year)+" "+
                "AND vehicle NOT IN (SELECT vehicle FROM vehiclefleets WHERE fleet = "+String.valueOf(fleet)+") "+
                "AND v.country = "+String.valueOf(country)+" "+
                "AND v.divorg1 = "+String.valueOf(divorg1)+" "+
                "AND v.divorg2 = "+String.valueOf(divorg2)+" "+
                "AND v.divorg3 = "+String.valueOf(divorg3);
            SQLQuery q = session.createSQLQuery(sql);
            q.addScalar("id",Hibernate.INTEGER);
            q.addScalar("matricula",Hibernate.STRING);
            q.addScalar("firstname",Hibernate.STRING);
            q.addScalar("lastname",Hibernate.STRING);
            list = q.list();
        }catch (Exception e) {
        	Object[] parameters = {fleet,period,year,country,divorg1,divorg2,divorg3};
            handler.getException(e,"getExcludedOdometer",userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"getExcludedOdometer",getClass());
        return list;
    }

    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetview"
     */
    public Collection getFleetDivisionData(Integer fleet,UserSessionData userSessionData) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"getFleetDivisionData",this.getClass());
        Collection list = new LinkedList();
        try {
            Session session = HibernateUtil.currentSession();

            String query = "SELECT country.resourceKey";
            int[][] divorgs = userSessionData.getFilter().getPrincipalDivOrgs();
            for(int i = 0; i < divorgs.length; i++) {
                if(divorgs[i][0] != 0) {
                    int length = userSessionData.getFilter().getDivOrgLevel(divorgs[i][0]-1);
                    switch(length) {
                        case 1:
                            query += ",divOrg"+String.valueOf(divorgs[i][0])+"1.resourceKey";
                            break;
                        case 2:
                            if(divorgs[i][1] == 1) {
                                query += ",divOrg"+String.valueOf(divorgs[i][0])+"2.resourceKey"; 
                            }else {
                                query += ",divOrg"+String.valueOf(divorgs[i][0])+"1.resourceKey"; 
                            }
                            break;
                        case 3:
                            if(divorgs[i][1] == 1) {
                                query += ",divOrg"+String.valueOf(divorgs[i][0])+"3.resourceKey"; 
                            }else if(divorgs[i][1] == 2) {
                                query += ",divOrg"+String.valueOf(divorgs[i][0])+"2.resourceKey"; 
                            }else {
                                query += ",divOrg"+String.valueOf(divorgs[i][0])+"1.resourceKey"; 
                            }
                            break;
                    }
                }
            }
            query += ",exclusionDate,id from FleetDivision WHERE fleet = "+String.valueOf(fleet);
            
            Query q = session.createQuery(query);
            list = q.list();
        }catch (Exception e) {
        	Object[] parameters = {fleet};
            handler.getException(e,"getFleetDivisionData",userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"getFleetDivisionData",getClass());
        return list;
    }

    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetview"
     */
    public int getFleetType(Integer fleet,UserSessionData userSessionData) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"getFleetType",this.getClass());
        int value = 0;
        try {
            Session session = HibernateUtil.currentSession();
            Query q = session.createSQLQuery("SELECT COUNT(*) AS count FROM individualfleets WHERE id = "+String.valueOf(fleet)).addScalar("count",Hibernate.INTEGER);
            value = (((Integer)q.uniqueResult()).intValue() == 1) ? FleetData.INDIVIDUAL : FleetData.COLECTIVE;
        }catch(Exception e) {
        	Object[] parameters = {fleet};
            handler.getException(e,"getFleetType",userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"getFleetType",this.getClass());
        return value;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query" 
     */
    public Collection kmByTrade(String frommonth, String fromyear, String tomonth, String toyear, String plate, int status, Integer[][] divOrgs, Integer[][] divGeos, UserSessionData userSessionData) throws Exception {
        try {
            Session session = HibernateUtil.currentSession();
            String[] s = userSessionData.getFilter().getFields("v");
            String sql = "SELECT v.matricula,d.firstname,d.lastname" +
                   
            		// Si ingresan odometros equivocados, menores que el mes anterior, este valor 
            		// siempre es positivo y eso esta mal, deberia dar negativo:
            		// ",MAX(o.odometer) - MIN(o.odometer) AS kms " +
            
            		// Si el odometro del mes-aÃ±o TO es nulo o cero no se igreso odometro para ese mes-aÃ±o 
            		// => (Odometro <= -1000000) (DEBERIA MOSTRAR 0 ),
            		// De lo contrario  pongo -Odometro Anterior + Odometro Actual => 
            		// Esto da + si esta bien ingresado y negativo si el conductor ingreso un odometro incorrecto menor al anterior.
            		", " +
            		"	SUM (" +
            		"		CASE WHEN o.period =  " + frommonth + " and o.year = " + fromyear + 
            							" and (o.odometer is not null  and o.odometer != 0) THEN  -o.odometer " +
            		"		WHEN o.period = " + tomonth + " and o.year = " + toyear + " " +
            							" and (o.odometer is not null  and o.odometer != 0) THEN o.odometer "+
            		"		WHEN o.period = " + tomonth + " and o.year = " + toyear +
            							" and (o.odometer is null or o.odometer = 0) THEN -1000000 "+
            		"		ELSE 0 END ) " +
            		"		as kms "+

                   // Si hago la suma me suma tambien los accidentes del periodo (mes) anterior, asi que hago un filtro mas fino:
                   // " SUM(accidents) AS accidents" +                   
                   ", SUM(CASE WHEN o.period = " + frommonth + " and o.year = "+ fromyear + " THEN 0 ELSE o.accidents END) AS accidents "+
                   
                   // Si hago la suma me suma tambien los incidentes del periodo (mes) anterior, asi que hago un filtro mas fino:
                   // ",SUM(incidents) AS incidents" +
                   ", SUM(CASE WHEN o.period = " + frommonth + " and o.year = " + fromyear +" THEN 0 ELSE o.incidents END) AS incidents" +
                   
                   // Si hago la suma me suma tambien los fuel del periodo (mes) anterior, asi que hago un filtro mas fino:
                   // ",SUM(o.fuel) as fuel " +
                   ", SUM(CASE WHEN o.period = " + frommonth + " and o.year = " + fromyear + " THEN 0 ELSE o.fuel END) AS fuel " +
                   
                   
                   ",v.fuel AS fueltype,d.superviser,d.manager " + 
                   ", v.id as vehicleid, d.id as driverid, c.resourcekey as country  " + // Agregado 20/10/2011
                   s[0] +                   
                   " FROM odometers o,genericfleets gf,vehicles v,drivers d, country c  " + s[1] +
                   UtilityQuery.corporationDivisionsRestictionsSQL("v",userSessionData)+
                   " AND gf.id = o.fleet " +
                   " AND o.vehicle = v.id " +
                   " AND d.id = v.driver " + s[2] +
                   " AND c.id = d.country " +
                   " AND (o.year > "+fromyear+" OR (o.year = "+fromyear+" AND o.period >= "+frommonth+")) "+
                   " AND (o.year < "+toyear+" OR (o.year = "+toyear+" AND o.period <= "+tomonth+")) ";
            if(!Util.empty(plate)) {
                sql += " AND matricula LIKE '%" + plate + "%' ";                
            }
            switch (status) {
                case VehicleData.ACTIVE:
                    sql += " AND v.exclusionDate IS NULL";
                    break;
                case VehicleData.EXCLUDED:
                    sql += " AND v.exclusionDate IS NOT NULL";
                    break;
            }
            
            if(divOrgs != null && divOrgs.length > 0) {
                for(int j = 0; j < divOrgs.length; j++) {
                    if(divOrgs[j] != null && divOrgs[j].length > 0) {
                        sql += " AND v.divOrg"+String.valueOf(j+1)+" in (";
                        for(int i = 0; i < divOrgs[j].length; i++) {
                            sql += divOrgs[j][i];
                            sql += (i == divOrgs[j].length-1) ? ") " : ",";
                        }
                    }
                }
            }   
            if(divGeos != null) {
                if(divGeos[0] != null && divGeos[0].length > 0) {
                    sql += " AND v.country in (";
                    for(int i = 0; i < divGeos[0].length; i++) {
                        sql += divGeos[0][i];
                        sql += (i == divGeos[0].length-1) ? ")" : ",";
                    }
                }
            }

            sql += " GROUP BY matricula,firstname,lastname,v.fuel,d.superviser,d.manager, " +
            		" v.id, d.id, c.resourcekey, " + s[3] + " ORDER BY matricula";
            SQLQuery query = session.createSQLQuery(sql);
            query.addScalar("matricula",Hibernate.STRING); // 0
            query.addScalar("firstname",Hibernate.STRING); // 1
            query.addScalar("lastname",Hibernate.STRING); // 2
            query.addScalar("kms",Hibernate.INTEGER); // 3
            query.addScalar("accidents",Hibernate.INTEGER) ; // 4
            query.addScalar("incidents",Hibernate.INTEGER); // 5
            query.addScalar("fuel",Hibernate.INTEGER);  //6 
            query.addScalar("fueltype",Hibernate.STRING); // 7
            query.addScalar("superviser",Hibernate.STRING); // 8
            query.addScalar("manager",Hibernate.STRING);  //9 
            
            query.addScalar("vehicleid",Hibernate.INTEGER); //10
            query.addScalar("driverid",Hibernate.INTEGER); //11
            query.addScalar("country",Hibernate.STRING); // 12
            
            StringTokenizer divorgs = new StringTokenizer(s[3],",");
            while (divorgs.hasMoreTokens()){
                query.addScalar(divorgs.nextToken(),Hibernate.STRING);
            }    
            
            List list = query.list();
            return list;
        } catch (Exception e) {
        	Object[] parameters = {frommonth,fromyear,tomonth,toyear,plate,status,divOrgs,divGeos};
            handler.getException(e,"kmByTrade",userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"kmByTrade",getClass());
        return null;
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query" 
     */
    public Collection kmByTradeNew(String frommonth, String fromyear, String tomonth, String toyear, String plate, int status, Integer[][] divOrgs, Integer[][] divGeos, UserSessionData userSessionData) throws Exception {
        try {
            Session session = HibernateUtil.currentSession();
            String[] s = userSessionData.getFilter().getFields("v");
            String sql = "SELECT v.matricula,d.firstname,d.lastname,o.period,o.year,o.odometer,o.accidents,o.incidents,o.fuel" +
                   ",v.fuel AS fueltype,d.superviser,d.manager " + 
                   ", v.id as vehicleid, d.id as driverid, c.resourcekey as country,d.director  " + // Agregado 20/10/2011
                   s[0] +                   
                   " FROM odometers o,genericfleets gf,vehicles v,drivers d, country c  " + s[1] +
                   UtilityQuery.corporationDivisionsRestictionsSQL("v",userSessionData)+
                   " AND gf.id = o.fleet " +
                   " AND o.vehicle = v.id " +
                   " AND d.id = v.driver " + s[2] +
                   " AND c.id = d.country " +
                   " AND (o.year > "+fromyear+" OR (o.year = "+fromyear+" AND o.period >= "+frommonth+")) "+
                   " AND (o.year < "+toyear+" OR (o.year = "+toyear+" AND o.period <= "+tomonth+")) ";
            if(!Util.empty(plate)) {
                sql += " AND matricula LIKE '%" + plate + "%' ";                
            }
            switch (status) {
                case VehicleData.ACTIVE:
                    sql += " AND v.exclusionDate IS NULL";
                    break;
                case VehicleData.EXCLUDED:
                    sql += " AND v.exclusionDate IS NOT NULL";
                    break;
            }
            
            if(divOrgs != null && divOrgs.length > 0) {
                for(int j = 0; j < divOrgs.length; j++) {
                    if(divOrgs[j] != null && divOrgs[j].length > 0) {
                        sql += " AND v.divOrg"+String.valueOf(j+1)+" in (";
                        for(int i = 0; i < divOrgs[j].length; i++) {
                            sql += divOrgs[j][i];
                            sql += (i == divOrgs[j].length-1) ? ") " : ",";
                        }
                    }
                }
            }   
            if(divGeos != null) {
                if(divGeos[0] != null && divGeos[0].length > 0) {
                    sql += " AND v.country in (";
                    for(int i = 0; i < divGeos[0].length; i++) {
                        sql += divGeos[0][i];
                        sql += (i == divGeos[0].length-1) ? ")" : ",";
                    }
                }
            }

            sql += " ORDER BY vehicleid,year,period";
            SQLQuery query = session.createSQLQuery(sql);
            query.addScalar("matricula",Hibernate.STRING); // 0
            query.addScalar("firstname",Hibernate.STRING); // 1
            query.addScalar("lastname",Hibernate.STRING); // 2
            query.addScalar("period",Hibernate.INTEGER); // 3
            query.addScalar("year",Hibernate.INTEGER); // 4
            query.addScalar("odometer",Hibernate.INTEGER); // 5
            query.addScalar("accidents",Hibernate.INTEGER) ; // 6
            query.addScalar("incidents",Hibernate.INTEGER); // 7
            query.addScalar("fuel",Hibernate.INTEGER);  // 8
            query.addScalar("fueltype",Hibernate.STRING); // 9
            query.addScalar("superviser",Hibernate.STRING); // 10
            query.addScalar("manager",Hibernate.STRING);  //11 
            
            query.addScalar("vehicleid",Hibernate.INTEGER); //12
            query.addScalar("driverid",Hibernate.INTEGER); //13
            query.addScalar("country",Hibernate.STRING); // 14
            query.addScalar("director",Hibernate.BOOLEAN); // 15
            
            StringTokenizer divorgs = new StringTokenizer(s[3],",");
            while (divorgs.hasMoreTokens()){
                query.addScalar(divorgs.nextToken(),Hibernate.STRING);
            }    
            
            List list = query.list();
            return list;
        } catch (Exception e) {
        	Object[] parameters = {frommonth,fromyear,tomonth,toyear,plate,status,divOrgs,divGeos};
            handler.getException(e,"kmByTrade",userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"kmByTrade",getClass());
        return null;
    }

