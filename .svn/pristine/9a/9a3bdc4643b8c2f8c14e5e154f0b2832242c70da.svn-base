    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Object[][] getOdometersLog(Date start, Date end, String fromMonth, String fromYear, String toMonth, String toYear, String plate, int status, String use, String type, String fleets, UserSessionData userSessionData) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"getOdometersLog",this.getClass());
        Collection result = new LinkedList();
        try {
            Session session = HibernateUtil.currentSession();
	        String[] fields =  userSessionData.getFilter().getFields("v");
	        
	        String sqlQuery = "";
			if(!Util.empty(use)) {
		        sqlQuery = getOdometerLogQuery(fields,start,end,fromMonth,fromYear,toMonth,toYear,plate,status,use,type,fleets,userSessionData,session);
				
			}else {
				sqlQuery = getOdometerLogQuery(fields,start,end,fromMonth,fromYear,toMonth,toYear,plate,status,TypeUseDataType.INSTITUTIONAL,type,fleets,userSessionData,session);
				sqlQuery += " UNION ("+getOdometerLogQuery(fields,start,end,fromMonth,fromYear,toMonth,toYear,plate,status,TypeUseDataType.INDIVIDUAL,type,fleets,userSessionData,session)+")";
			}

			sqlQuery += " ORDER BY id,date DESC";
			SQLQuery query = session.createSQLQuery(sqlQuery)
				.addScalar("period",Hibernate.INTEGER)
				.addScalar("year",Hibernate.INTEGER)
				.addScalar("userid",Hibernate.STRING)
				.addScalar("date",Hibernate.DATE)
				.addScalar("odometer",Hibernate.INTEGER)
				.addScalar("accidents",Hibernate.INTEGER)
				.addScalar("incidents",Hibernate.INTEGER)
				.addScalar("id",Hibernate.INTEGER)
				.addScalar("matricula",Hibernate.STRING)
				.addScalar("trade",Hibernate.STRING)
				.addScalar("model",Hibernate.STRING)
				.addScalar("name",Hibernate.STRING)
				.addScalar("driverId",Hibernate.INTEGER)
				.addScalar("firstName",Hibernate.STRING)
				.addScalar("lastName",Hibernate.STRING)
				.addScalar("director",Hibernate.BOOLEAN);
			StringTokenizer divorgs = new StringTokenizer(fields[3],",");
			while (divorgs.hasMoreTokens()){
			    query.addScalar(divorgs.nextToken(),Hibernate.STRING);
			}            
	
			
	        Iterator it = query.list().iterator();
	        Integer last = new Integer(0);
	        while(it.hasNext()) {
	            Object[] data = (Object[])it.next();
	            if(!data[7].equals(last)) {
	                last = (Integer)data[7];
	                result.add(data);
	            }
	        }
	
        }catch(Exception e) {
        	Object[] parameters = {start,end,fromMonth,fromYear,toMonth,toYear,plate,status,use,type,fleets};
            handler.getException(e,"getOdometersLog",userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"getOdometersLog",this.getClass());
        return (Object[][])result.toArray(new Object[0][0]);
    }

    private String getOdometerLogQuery(String[] fields, Date start, Date end,
			String fromMonth, String fromYear, String toMonth, String toYear,
			String plate, int status, String use, String type, String fleets,
			UserSessionData userSessionData, Session session) {
        String sqlQuery = "SELECT ol.period,ol.year,ol.userid,ol.date,ol.odometer,ol.accidents,ol.incidents " +
	        ",v.id,v.matricula,v.trade,v.model,gf.name,";
        if(use.equals(TypeUseDataType.INDIVIDUAL)) {
        	sqlQuery += "d.id as driverId,d.firstname,d.lastname,d.director as director";
        }else {
        	sqlQuery += "0 as driverId,'' as firstname,'' as lastname, false as director";
        }
        sqlQuery += fields[0];
        sqlQuery += " FROM odometerlog ol,vehicles v,genericfleets gf";
        if(use.equals(TypeUseDataType.INDIVIDUAL)) {
        	sqlQuery += ",drivers as d ";
        }	
        sqlQuery += fields[1]+" WHERE ol.vehicle = v.id ";
        if(use.equals(TypeUseDataType.INDIVIDUAL)) {
        	sqlQuery += " AND v.driver = d.id ";
        }	
        sqlQuery += " AND ol.fleet = gf.id "+fields[2];
		if(!Util.empty(fleets)) {
		    sqlQuery += " AND ol.fleet IN ("+fleets+") ";
		}
		if(start != null) {
		    sqlQuery += " AND ol.date >= "+Util.formatSQL(start);
		}
		if(end != null) {
		    sqlQuery += " AND ol.date <= "+Util.formatSQL(end);
		}
		if(!Util.empty(fromMonth) && !fromMonth.equals("0") && !Util.empty(fromYear) && !fromYear.equals("0")) {
		    sqlQuery += " AND (ol.year > "+fromYear+" OR (ol.year = "+fromYear+" AND ol.period >= "+fromMonth+")) ";
		}
		if(!Util.empty(toMonth) && !toMonth.equals("0") && !Util.empty(toYear) && !toYear.equals("0")) {
		    sqlQuery += " AND (ol.year < "+toYear+" OR (ol.year = "+toYear+" AND ol.period <= "+toMonth+")) ";
		}
		sqlQuery += " AND ol.vehicle IN (SELECT id FROM vehicles v "+UtilityQuery.corporationDivisionsRestictionsSQL("v",userSessionData);
		if(!Util.empty(plate)) {
		    sqlQuery += " AND v.matricula LIKE '%"+plate+"%' ";
		}
		if(!Util.empty(use)) {
		    sqlQuery += " AND v.use = '"+use+"' ";
		}
		if(!Util.empty(type) && !type.equals("datatype.vehicletype.all")) {
		    sqlQuery += " AND v.type = '"+type+"' ";
		}
		switch (status) {
		    case VehicleData.ACTIVE:
		        sqlQuery += " AND v.exclusiondate is NULL ";
		        break;
		    case VehicleData.EXCLUDED:
		        sqlQuery += " AND v.exclusionDate is not NULL ";
		        break;
		}
	    sqlQuery += ") ";
		return sqlQuery;
	}

	/**
     * @ejb.interface-method
