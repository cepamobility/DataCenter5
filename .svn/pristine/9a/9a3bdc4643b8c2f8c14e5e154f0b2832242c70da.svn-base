    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "fleetview,administrator,driverfleetinsertdata,fleetinsertdata"
     */
    public ListResult findList(String name, int type, int first, int count, 
    		UserSessionData userSessionData, int status) throws Exception {
        try{
            Session session = HibernateUtil.currentSession();
            if(userSessionData.isDriver()) {
                String queryStr = "select fleet from IndividualFleet as fleet ";
                queryStr += " where fleet.corporation = "+userSessionData.getFilter().getCorporationId();
                if(name != null) {
                    queryStr += " and lower(fleet.name) like lower(:name)";            
                }
                
                queryStr += " and fleet.id not in ("+getUserPermissions(userSessionData)+")";
                queryStr += " order by fleet.name, fleet.description ";
                Query query = session.createQuery(queryStr);
                if(name != null) {
                    query.setParameter("name","%"+name+"%");
                }    
                Iterator list = query.list().iterator();
                Collection result = new LinkedList();
                while(list.hasNext()) {
                    IndividualFleet fleet = (IndividualFleet) list.next();
                    if(containsVehicleDriver(fleet,userSessionData.getDriverData().getId())) {
                        result.add(fleet.getMainAttributes());
                    }
                }
        
                ListResult returnListResult = new ListResult(result, result.size());
                
                return returnListResult;
            }else {
                String query1 = "select count(*) from AbstractFleet as fleet ";
                String query2 = "select fleet from AbstractFleet as fleet ";
                switch(type) {
                    case FleetData.INDIVIDUAL: 
                        query1 = "select count(*) from IndividualFleet as fleet ";
                        query2 = "select fleet from IndividualFleet as fleet ";
                        break;
                    case FleetData.COLECTIVE:
                        query1 = "select count(*) from ColectiveFleet as fleet ";
                        query2 = "select fleet from ColectiveFleet as fleet ";
                        break;
                }
    
                String queryEnd = " where fleet.corporation = "+userSessionData.getFilter().getCorporationId();
                queryEnd += " and fleet.id not in ("+getUserPermissions(userSessionData)+")";
                
                switch (status){                
                	case FleetData.ACTIVE: // Activos
                		queryEnd += " and fleet.exclusionDate is null ";
                		break;
                	case FleetData.EXCLUDED: // Excluidos
                		queryEnd += " and fleet.exclusionDate is not null ";
                		break;                		
                }
                
                if(name != null) {
                    queryEnd += " and lower(fleet.name) like lower(:name)";            
                }
                 
                Query query = session.createQuery(query1+queryEnd);
                if(name != null) {
                    query.setParameter("name","%"+name+"%");
                }    
    
                List userColl = query.list();
                Iterator iter = userColl.iterator();
                Integer total = new Integer(0);
                while (iter.hasNext()) {
                    total = new Integer(((Long) iter.next()).intValue());
                }

                queryEnd += " order by fleet.name, fleet.description ";                
                query = session.createQuery(query2+queryEnd);
                if(name != null) {
                    query.setParameter("name","%"+name+"%");
                }    
    
                if(count != -1) {
                    if(total.intValue() < first) {
                        if(total.intValue() % count == 0) {
                            first = total.intValue() - count;
                        }else {
                            first = total.intValue() - (total.intValue() % count);
                        }
                    }
                    query.setFirstResult(first);
                    query.setMaxResults(count);
                }
                userColl = query.list();
                Collection result = new LinkedList();
                iter = userColl.iterator();
                while (iter.hasNext()) {
                    AbstractFleet fleet = (AbstractFleet) iter.next();
                    result.add(fleet.getMainAttributes());
                }
        
                ListResult returnListResult = new ListResult(result, total.intValue());
                
                return returnListResult;
            }
        }catch (Exception e) {
        	Object[] parameters = {name,type,first,count,status};
            handler.getException(e,"findList",userSessionData,parameters);
        }
        return null;
    }

    public static String getUserPermissions(UserSessionData userSessionData) {
        String where = "SELECT division.fleet.id FROM FleetDivision division ";
        where += "WHERE division.fleet.corporation.id = "+userSessionData.getFilter().getCorporationId();
        
        int  divOrgCount=userSessionData.getFilter().getDivOrgCount();
        String[] leaves = userSessionData.getFilter().getDivOrgLeaves();
        
        if(divOrgCount == 1) {
            where += " and division.divOrg11 not in ("+leaves[0]+") ";
        }
        if(divOrgCount == 2) {
            where += " and (division.divOrg11 not in ("+leaves[0]+") ";
            where += " or division.divOrg21 not in ("+leaves[1]+")) ";
        }
        if(divOrgCount == 3) {
            where += " and (division.divOrg11 not in ("+leaves[0]+") ";
            where += " or division.divOrg21 not in ("+leaves[1]+") ";
            where += " or division.divOrg31 not in ("+leaves[2]+")) ";
        }

        String in = userSessionData.getFilter().getDivGeoLeaves(null,null);
        if(divOrgCount == 0) {
            where += " and division.country not in ("+in+") ";
        }else {
            where += " or division.country not in ("+in+") ";
        }
        
        return where;
    }

    private boolean containsVehicleDriver(IndividualFleet fleet, Integer id) {
        Iterator it = fleet.getVehicleSet().iterator();
        while(it.hasNext()) {
            Vehicle vehicle = (Vehicle)it.next();
            if(vehicle.getDriver() != null && vehicle.getDriver().getId().equals(id)) {
                return true;
            }
        }
        return false;
    }
   
    

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetedit,driverfleetinsertdata,fleetinsertdata,fleetblockdata"
     * @param userSessionData
     * @param regions
     */        
	public Collection getBlockPeriods(UserSessionData userSessionData, LinkedList regions) throws Exception {				

		// Local Variables:
		Session session;
    	Query query;
    	Iterator it;
    	LinkedList result = new LinkedList();   	
    	Object [] row;
    	GeoItemData region;
    	String corpId = userSessionData.getFilter().getCorporationId().toString();
    	RegionBlockData rbd = null;
    	String sqlQuery ="";
    	try{  
    	    /* Itero sobre las regiones y obtengo la flota
    	     * de cada region que tenga el periodo de bloqueo con
    	     * fecha mas alta.
    	     */
    		session = HibernateUtil.currentSession();
    		if (!regions.isEmpty()){
    			it = regions.iterator();
    			while (it.hasNext()){
    				region = (GeoItemData)it.next();
    				// TODO: Leer el Bloqueo de una region (no de las flotas)
    				sqlQuery = 
    					" SELECT regionId, regionName, blockYear," +
    							" blockMonth, corporationId, userId, date" +
    					" FROM regionblock AS rb " +
    					" WHERE rb.corporationId = " + corpId + 
    							" AND rb.regionId = "+region.getId().toString() + 
    							" AND rb.date >= ALL ( " +
    								" SELECT rb2.date " +
    								" FROM regionblock rb2 " +
    								" WHERE rb2.regionId = rb.regionId " + 
    								" AND rb2.corporationId = rb.corporationId )" +
    					" LIMIT 1 ";

    					query = session.createSQLQuery(sqlQuery)
    						.addScalar("regionId", Hibernate.INTEGER)
    						.addScalar("regionName", Hibernate.STRING)
    						.addScalar("blockYear", Hibernate.INTEGER)
    						.addScalar("blockMonth", Hibernate.INTEGER)
    						.addScalar("corporationId", Hibernate.INTEGER)
    						.addScalar("userId",Hibernate.STRING)
    						.addScalar("date",Hibernate.DATE);
    						
    					
    					List list = query.list();
    					if (!list.isEmpty()){
    						Iterator it2 = list.iterator();       					
	    					while(it2.hasNext()) {
	    						row = (Object[])it2.next(); 
	    						rbd = new RegionBlockData();
	    						rbd.setRegionId((Integer)row[0]);
	    						rbd.setRegionName((String)row[1]);
	    						rbd.setBlockYear((Integer)row[2]);
	    						rbd.setBlockMonth((Integer)row[3]);    	        	
	    						rbd.setCorporationId((Integer)row[4]);
	    						rbd.setUserId((String)row[5]);
	    						rbd.setDate((Date)row[6]);
	    						result.add(rbd);
	    						break; // Para forzar que solo lea un registro
	    					}
    					}else{
    						rbd = new RegionBlockData();
    						rbd.setRegionId(region.getId());
    						rbd.setRegionName(region.getName());
    						rbd.setBlockYear(new Integer(1998));
    						rbd.setBlockMonth(new Integer(1));   	        	
    						rbd.setCorporationId(new Integer(corpId));
    						rbd.setUserId(userSessionData.getFilter().getLoginName());
    						rbd.setDate(Calendar.getInstance().getTime());
    						result.add(rbd);
    					}
    			}    	       
    	        return result; 
       		}else{
    			return null;
    		}    		
    	}
    	catch (Exception e) {
        	Object[] parameters = {regions};
    		handler.getException(e,"getBlockPeriods",userSessionData,parameters);    	        
    	}
    	return null;
	}
    
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetedit,driverfleetinsertdata,fleetinsertdata,fleetblockdata"
     */
    public Collection findFleetsByRegion(Integer regionId, UserSessionData userSessionData) throws Exception{

    	Session session;
    	Query query;
    	Iterator it;
    	LinkedList result;	
    	AbstractFleet fleet;
    	try{            
              session = HibernateUtil.currentSession();
              query = session.createQuery(
            		  " SELECT fleet " +
            		  " FROM AbstractFleet AS fleet " +
                      " WHERE fleet.corporation = "
            		  				+userSessionData.getFilter().getCorporationId()+
                      " AND fleet.id NOT IN (" +
                      "				SELECT DISTINCT(fleetdiv.fleet.id)  " +
                      "				FROM FleetDivision fleetdiv " +
                      "				WHERE fleetdiv.fleet.corporation = " +
                      						userSessionData.getFilter().getCorporationId() +
                      "				AND fleetdiv.geoLevel1 != " + regionId + ")" +
                      " AND fleet.id NOT IN ("+getUserPermissions(userSessionData)+") ");
              
              it = query.list().iterator();
              result = new LinkedList();    	
              while(it.hasNext()) {
                  fleet = (AbstractFleet)it.next(); 
                  result.add(fleet.getFleetData());
              }
            
              return result;
    	}
    	catch (Exception e)	{
    		Object[] parameters = {regionId};
    		handler.getException(e,"findFleetsByRegion",userSessionData,parameters);    	        
    	}
    	return null;
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetedit,driverfleetinsertdata,fleetinsertdata"
     */
    public FleetData findFleetByPrimaryKey(Integer id,UserSessionData userSessionData) throws Exception{
        if (id == null) {
            throw new InvalidDataException("findFleetByPrimaryKey","id = null");
        }
        if (userSessionData == null) {
            throw new DeslogedException("findFleetByPrimaryKey","userSessionData = null");
        }
        try{            
            Session session = HibernateUtil.currentSession();
            Query query = session.createQuery("select fleet from AbstractFleet as fleet " +
                    "where fleet.corporation.id = "+userSessionData.getFilter().getCorporationId()+
                    "and fleet.id = :id  and fleet.id not in ("+getUserPermissions(userSessionData)+")");
            query.setParameter("id", id);
            Object result = query.uniqueResult();
            if(result != null) {
                AbstractFleet fleet = (AbstractFleet)result;                
                if (ColectiveFleet.class.isInstance(fleet) && !userSessionData.isDriver())
                {
                    ColectiveFleet cfleet = (ColectiveFleet) fleet;
                	return cfleet.getFleetData();                    
                }
                else if (IndividualFleet.class.isInstance(fleet) && userSessionData.isDriver())                		
                {
                	IndividualFleet ifleet = (IndividualFleet) fleet;
                    return ifleet.getFleetData(userSessionData.getDriverData().getId());
                }
                else if (IndividualFleet.class.isInstance(fleet) && !userSessionData.isDriver())
                {
                	IndividualFleet ifleet = (IndividualFleet) fleet;
                	return ifleet.getFleetData(); 
                }
                	
            }
        } catch(Exception e){
        	e.printStackTrace();
        	Object[] parameters = {id};
            handler.getException(e,"findFleetByPrimaryKey",userSessionData,parameters);
        }
        return null;
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetedit,driverfleetinsertdata,fleetinsertdata"
     */
    public Integer countFleetsWithVehicle(Integer vehicleId, UserSessionData userSessionData) throws Exception{
        if (vehicleId == null) {
            throw new InvalidDataException("countFleetsWithVehicle","vehicleId = null");
        }
        try{            
            Session session = HibernateUtil.currentSession();
            SQLQuery query = session.createSQLQuery("select count(*) as registries from vehiclefleets " +
                    "where vehiclefleets.vehicle = "+vehicleId );
            query.addScalar("registries",Hibernate.INTEGER);
            Object result = query.uniqueResult();
            if(result != null) {
                Integer fleets = new Integer (( (Long)result).intValue());
                return fleets;
            }
        } catch(Exception e){
        	Object[] parameters = {vehicleId};
            handler.getException(e,"countFleetsWithVehicle",userSessionData,parameters);
        }
        return null;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetedit,fleetinsertdata"
     */
    public Hashtable findFleetDetail(Integer fleetId,Integer period,Integer year,UserSessionData userSessionData) throws Exception{
        if (fleetId == null) {
            throw new InvalidDataException("findFleetDetail","fleetId = null");
        }
        if (period == null) {
            throw new InvalidDataException("findFleetDetail","period = null");
        }
        if (year == null) {
            throw new InvalidDataException("findFleetDetail","year = null");
        }
        if (userSessionData == null) {
        	
            throw new DeslogedException("findFleetDetail","userSessionData = null");
        }
        try{            
            Session session = HibernateUtil.currentSession();
            Query query = session.createQuery("select detail from FleetDivisionDetail as detail " +
                    "where detail.pk.fleet.fleet.id = :fleet and " +
                    "detail.pk.period = :period and " +
                    "detail.pk.year = :year");
            query.setParameter("fleet", fleetId);
            query.setParameter("period", period);
            query.setParameter("year", year);
            
            /*
             select * from fleetdivisiondetail as detail 
				inner join fleetdivisions fd on detail.id = fd.id
				where fd.fleet = 1058 and 
				detail.period = 1 and detail.year = 2010;
                         
             */
        	Hashtable list = new Hashtable();
            List list2 = query.list();
            if (list2 != null && list2.size() > 0){
            	Iterator it = list2.iterator();
            
            	while(it.hasNext()) {
            		FleetDivisionDetail fleet = (FleetDivisionDetail)it.next(); 
            		list.put(fleet.getPk().getFleet().getId(),fleet.getData());
            	}
            }
            return list;
        } catch(Exception e){
        	e.printStackTrace();
        	Object[] parameters = {fleetId,period,year};
            handler.getException(e,"findFleetDetail",userSessionData,parameters);
        }
        return null;
    }

    /**
