    public List getFleets(String fleets, UserSessionData userRequest) throws Exception {    
        try {    
            Session session = HibernateUtil.currentSession();
        
            String queryStr = "select fleet from  AbstractFleet as fleet where "+
               // UtilityQuery.corporationDivisionsRestictions("fleet",userRequest)+
                " fleet.id in ("+fleets+")";
        
            Query query = session.createQuery(queryStr);
            List userColl = query.list();
            List result = new LinkedList();
            if (userColl != null){
            	Iterator iter = userColl.iterator();
            	while (iter.hasNext()) {
            		AbstractFleet fleet = (AbstractFleet) iter.next();
            		result.add(fleet.getMainAttributes());
            	}
            }
            return result;
        
        } catch(Exception e){
        	Object[] parameters = {fleets};
            handler.getException(e,"getFleets",userRequest,parameters);
        }
        return null;
    }
    
    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "query,administrator"
     */
    public Hashtable getFleetDivisionsData(String fleets, UserSessionData userSessionData) throws Exception {    
        Hashtable values = new Hashtable();
        try {    
            Session session = HibernateUtil.currentSession();
        
            String sql = "SELECT DISTINCT fd.fleet,fd.odometer " +
            		"FROM fleetdivisions fd JOIN genericfleets gf ON gf.id = fd.fleet " +
            		"WHERE gf.corporation = "+userSessionData.getFilter().getCorporationId()+
            		" AND odometer IS NOT NULL ";
            if(fleets != null) {
            	sql += "AND fleet IN ("+fleets+")";
            }
            SQLQuery query = session.createSQLQuery(sql);
            query.addScalar("fleet", Hibernate.INTEGER);
            query.addScalar("odometer", Hibernate.STRING);
            Iterator iter = query.list().iterator();
            while (iter.hasNext()) {
            	Object[] data = (Object[]) iter.next();
            	values.put(data[0], data[1]);
            }       
            return values;
        
        } catch(Exception e){
        	Object[] parameters = {fleets};
            handler.getException(e,"getFleets",userSessionData,parameters);
        }
        return values;
    }
    
