    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Collection getOdometerValues(int[] orders, int[] from, int[] to, Integer[][] divOrgs, Integer[] divGeos, UserSessionData userSessionData) throws Exception {
    	try {
    		String[] s = userSessionData.getFilter().getFields(orders,"v");
    		String sql = "SELECT "+s[0]+" o1.period, o1.year, COUNT(*) AS count, SUM(o1.odometer - o2.odometer) AS sum " +
    				"FROM odometers o1 " +
    				"JOIN vehicles v ON v.id = o1.vehicle " +
    				"JOIN odometers o2 ON o1.vehicle = o2.vehicle " +
    				s[1] +
    				" WHERE o1.fleet = 9508 " +
    				"AND ((o1.period = o2.period + 1 AND o1.year = o2.year) OR (o1.year = o2.year + 1 AND o1.period = 1 AND o2.period = 12)) " +
    				"AND (o1.year < "+to[1]+"  OR o1.year = "+to[1]+" AND o1.period <= "+to[0]+") " +
    				"AND (o1.year > "+from[1]+" OR o1.year = "+from[1]+" AND o1.period >= "+from[0]+") " +
    				"AND o1.odometer >= o2.odometer " +
    				"GROUP BY "+s[3]+" o1.period, o1.year " +
    				"UNION (" +
    				"SELECT "+s[0]+" o1.period, o1.year, COUNT(*) AS count, SUM(o1.odometer) AS sum " +
    				"FROM odometers o1 " +
    				"JOIN vehicles v ON v.id = o1.vehicle " +
    				s[1] +
    				" WHERE o1.fleet = 9508 " +
    				"AND o1.vehicle NOT IN (" +
    					"SELECT vehicle FROM odometers o2 WHERE o2.fleet = o1.fleet " +
    					"AND (" +
    					"	(o2.year = o1.year AND o2.period = o1.period -1)" +
    					" OR (o2.year = o1.year-1 AND o1.period = 1 AND o2.period = 12)" +
    					")" +
    				") " +
    				"AND (o1.year < "+to[1]+"  OR o1.year = "+to[1]+" AND o1.period <= "+to[0]+") " +
    				"AND (o1.year > "+from[1]+" OR o1.year = "+from[1]+" AND o1.period >= "+from[0]+") " +
    				"GROUP BY "+s[3]+" o1.period, o1.year" +
    				") ORDER BY year,period";
    		Session session = HibernateUtil.currentSession();
    		SQLQuery query = session.createSQLQuery(sql);
            StringTokenizer divorgs = new StringTokenizer(s[2],",");
            while (divorgs.hasMoreTokens()){
            	String f = divorgs.nextToken();
            	if(f.length() > 0)
	            	if(f.startsWith("id"))
	            		query.addScalar(f,Hibernate.INTEGER);
	            	else
	            		query.addScalar(f,Hibernate.STRING);
            }
    		query.addScalar("period",Hibernate.INTEGER);
    		query.addScalar("year",Hibernate.INTEGER);
    		query.addScalar("count",Hibernate.INTEGER);
    		query.addScalar("sum",Hibernate.INTEGER);
            return query.list();
    	}catch (Exception e) {
        	Object[] p = {orders, from, to, divOrgs, divGeos};
            handler.getException(e,"getInsertedOdometers", userSessionData, p);
		}
    	return new LinkedList();
    }

    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Collection getEcolabInstalled(Integer month, Integer year, String list, UserSessionData userSessionData) throws Exception {
    	try {
			String sql = "SELECT d.id AS driver, v.id AS vehicle FROM drivers d JOIN vehicles v ON v.driver = d.id WHERE v.id IN ("+list+")" +
					"AND v.id NOT IN (SELECT vehicle FROM odometers WHERE vehicle IN ("+list+") " +
					" AND (year < "+year+" OR (year = "+year+" AND period < "+month+")))";
    		Session session = HibernateUtil.currentSession();
    		SQLQuery query = session.createSQLQuery(sql);
    		query.addScalar("driver",Hibernate.INTEGER);
    		query.addScalar("vehicle",Hibernate.INTEGER);
    		return query.list();
		}catch (Exception e) {
	    	Object[] p = {month, year, list};
	        handler.getException(e,"getInsertedOdometers", userSessionData, p);
		}
    	return new LinkedList();
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverodometer"
     */
    public boolean isValidOdometer(Integer odometer, Integer vehicle, Integer period, Integer year, UserSessionData userSessionData) throws Exception {
    	try {
			String sql = "SELECT COUNT(*) AS c FROM odometers WHERE vehicle = "+vehicle+" and (year < "+year+" or (year = "+year+" and period < "+period+")) and odometer > "+odometer;
    		Session session = HibernateUtil.currentSession();
    		SQLQuery query = session.createSQLQuery(sql);
    		query.addScalar("c",Hibernate.INTEGER);
    		int value = ((Integer)query.uniqueResult()).intValue();
    		
    		sql = "SELECT COUNT(*) AS c FROM odometers WHERE vehicle = "+vehicle+" and (year > "+year+" or (year = "+year+" and period > "+period+")) and odometer < "+odometer;
    		query = session.createSQLQuery(sql);
    		query.addScalar("c",Hibernate.INTEGER);
    		value += ((Integer)query.uniqueResult()).intValue();
    		
    		return value == 0;
		}catch (Exception e) {
	    	Object[] p = {odometer, period, year, vehicle};
	        handler.getException(e,"isValidOdometer", userSessionData, p);
		}
    	return false;
    }
}

