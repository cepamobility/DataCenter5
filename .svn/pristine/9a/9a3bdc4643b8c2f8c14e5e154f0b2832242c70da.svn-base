    public Collection getOdometerValues(Integer vehicle,String fleet,UserSessionData userSessionData) throws Exception {
    	Collection result = new LinkedList();
		Session session = HibernateUtil.currentSession();
    	try {
    		String select = "SELECT odometer,period,year " +
    				" FROM odometers " +
    				" WHERE fleet = "+fleet+" AND vehicle = "+vehicle+
    				" ORDER BY year, period";
    		Query q = session.createSQLQuery(select)
    				.addScalar("odometer", Hibernate.INTEGER)
    				.addScalar("period", Hibernate.INTEGER)
    				.addScalar("year", Hibernate.INTEGER);
    		result.addAll(q.list());
    	}catch (Exception e) {
        	Object[] p = {vehicle,fleet};
            handler.getException(e,"getOdometerValues", userSessionData, p);
		}
    	return result;
    }	
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetinsertdata"
     */
    public FleetDivisionDetailData getLastDivisionValue(Integer id, Integer period, Integer year, UserSessionData userSessionData) throws Exception {
		Session session = HibernateUtil.currentSession();
    	try {
            Query query = session.createQuery("SELECT detail FROM FleetDivisionDetail AS detail " +
                    " WHERE detail.pk.fleet.id = " + id +
                    " AND (detail.pk.year = " + year + " AND detail.pk.period <= " + period + ")" +
                    " AND detail.pk.year  <= " + year + " ORDER BY detail.pk.year DESC, detail.pk.period DESC");
            Iterator it = query.list().iterator();
            if(it.hasNext()) {
            	return ((FleetDivisionDetail)it.next()).getData();
            }
    	}catch (Exception e) {
        	Object[] p = {id,period,year};
            handler.getException(e,"getLastDivisionValue", userSessionData, p);
		}
    	return null;
    }

    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetinsertdata"
     */
    public HashMap<String, String> findFleetKeys(Integer fleetId, UserSessionData userSessionData) throws Exception {
    	HashMap<String, String> values = new HashMap<String, String>();
		Session session = HibernateUtil.currentSession();
    	try {
            Query query = session.createSQLQuery("SELECT id,"+UtilityQuery.getCorporationFleetKey(userSessionData.getCorporationId()).replaceAll(","," || ';' || ")+" AS key " +
            		"from fleetdivisions where fleet = " + fleetId+" AND exclusiondate IS NULL").addScalar("id",Hibernate.INTEGER).addScalar("key",Hibernate.STRING);
            Iterator it = query.list().iterator();
            while(it.hasNext()) {
            	Object[] data = (Object[])it.next();
            	values.put(String.valueOf(data[0]), String.valueOf(data[1]));
            }
    	}catch (Exception e) {
        	Object[] p = {fleetId};
        	
            handler.getException(e,"findFleetKeys", userSessionData, p);
		}
    	return values;
    } 

    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetinsertdata"
     */
    public HashMap<String,Integer> getIndividualMiles(Integer fleet, Integer lastPeriod, Integer lastYear, Integer currentPeriod, Integer currentYear, UserSessionData userSessionData) throws Exception {
    	HashMap<String, Integer> values = new HashMap<String, Integer>();
		Session session = HibernateUtil.currentSession();
    	try {
			String[] keys = UtilityQuery.getCorporationKey("v",userSessionData.getCorporationId());
			switch(userSessionData.getCorporationId()) {
				case CorporationData.MONSANTO:
					keys[0] = "v.country,o1.divorg2,o1.divorg3";
					keys[2] = "v.country,o1.divorg2,o1.divorg3";
					break;
				case CorporationData.ALLERGAN:
					keys[0] = "v.country,o1.divorg1,o1.divorg2";
					keys[2] = "v.country,o1.divorg1,o1.divorg2";
					break;
				case CorporationData.DOW:
					keys[0] = "v.country,o1.divorg1";
					keys[2] = "v.country,o1.divorg1";
					break;
			}
    		String sql = "SELECT "+keys[0].replaceAll(","," || ';' || ")+" AS key, SUM(o1.odometer -o2.odometer) AS sum " +
    				" FROM odometers o1 " + keys[1] +
					" JOIN vehiclefleets vf ON (o1.vehicle = vf.vehicle AND o1.fleet = vf.id) "+
					" JOIN odometers o2 ON (o2.vehicle = vf.vehicle AND o2.fleet = vf.id) "+
    				" JOIN vehicles v ON v.id = o1.vehicle " +
    				" WHERE vf.id = "+fleet+
    				" AND o1.year = "+currentYear+" AND o2.year = "+ lastYear +
    				" AND o1.period = "+currentPeriod+" AND o2.period = " + lastPeriod +
    				" AND o2.odometer > 0"+
    				" GROUP BY "+keys[2];
            Query query = session.createSQLQuery(sql).addScalar("key",Hibernate.STRING).addScalar("sum",Hibernate.INTEGER);
            Iterator it = query.list().iterator();
            while(it.hasNext()) {
            	Object[] data = (Object[])it.next();
            	values.put((String)data[0], (Integer)data[1]);
            }
            
            /*if(userSessionData.isCorporation(CorporationData.ALLERGAN)) {
	            sql = "SELECT "+keys[0].replaceAll(","," || ';' || ")+" AS key, COUNT(v.matricula) AS count " +
	            		"FROM odometers o1 " + keys[1] +
	            		"JOIN vehicles v ON v.id = o1.vehicle " +
	            		"WHERE o1.fleet = "+fleet+" AND o1.year = "+currentYear+" AND o1.period = "+currentPeriod+
	            		" AND o1.vehicle NOT IN (select vehicle from odometers where fleet = "+fleet+" AND year = "+lastYear+"  AND period = " + lastPeriod +") " +
	            		"GROUP BY "+keys[2];
	            query = session.createSQLQuery(sql).addScalar("key",Hibernate.STRING).addScalar("count",Hibernate.INTEGER);
	            it = query.list().iterator();
	            while(it.hasNext()) {
	            	Object[] data = (Object[])it.next();
	            	if(values.containsKey((String)data[0])) {
	            		values.get((String)data[0])[0] += ((Integer)data[1]).intValue();
	            	}else {
	            		values.put((String)data[0], new int[] {((Integer)data[1]).intValue(),0});
	            	}
	            }
            //}*/            
    	}catch (Exception e) {
        	Object[] p = {fleet,lastPeriod,lastYear,currentPeriod,currentYear};
            handler.getException(e,"getIndividualMiles", userSessionData, p);
		}
    	return values;
    }

    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public FleetBayerData getFleetBayerReport(Calendar start, Calendar end, UserSessionData userSessionData) throws Exception {
    	FleetBayerData data = new FleetBayerData();
		Session session = HibernateUtil.currentSession();
    	try {
    		String sql = "select round(avg(fdd.vehicles)) AS vehicles,sum(fdd.miles) AS miles,sum(fdd.accidents) AS accidents," +
    				"fd.divorg12,d2.resourcekey AS d12," +
    				"fd.divorg11,d1.resourcekey AS d11," +
    				"fd.divorg23,d5.resourcekey AS d23," +
    				"fd.divorg22,d4.resourcekey AS d22," +
    				"fd.divorg21,d3.resourcekey AS d21 " +
    				"from fleetdivisiondetail fdd " +
    				"join fleetdivisions fd on fdd.id = fd.id " +
    				"join divorgitemlevel1s d1 on d1.id = fd.divorg11 " +
    				"join divorgitemlevel2s d2 on d2.id = fd.divorg12 " +
    				"join divorgitemlevel1s d3 on d3.id = fd.divorg21 " +
    				"join divorgitemlevel2s d4 on d4.id = fd.divorg22 " +
    				"join divorgitemlevel3s d5 on d5.id = fd.divorg23 " +
    				"where fd.fleet in (9559) ";
    		if(start != null) {
    			sql += "and (fdd.year > "+start.get(Calendar.YEAR)+" OR (fdd.year = "+start.get(Calendar.YEAR)+") AND fdd.period >= "+String.valueOf(start.get(Calendar.MONTH)+1)+") ";
    		}
    		if(end != null) {
    			sql += "and (fdd.year < "+end.get(Calendar.YEAR)+" OR (fdd.year = "+end.get(Calendar.YEAR)+") AND fdd.period <= "+String.valueOf(end.get(Calendar.MONTH)+1)+") ";
    		}
    		sql +="group by fd.divorg12,d2.resourcekey, " +
    				"fd.divorg11,d1.resourcekey, " +
    				"fd.divorg23,d5.resourcekey, " +
    				"fd.divorg22,d4.resourcekey, " +
    				"fd.divorg21,d3.resourcekey";
    		SQLQuery query = session.createSQLQuery(sql);
    		String[] s = {"d12","d11","d23","d22","d21","vehicles","miles","accidents","divorg12","divorg11","divorg23","divorg22","divorg21"};
    		for(int i = 0; i < s.length; i++) {
    			if(i < 5) {
    	    		query.addScalar(s[i], Hibernate.STRING);
    			}else {
    	    		query.addScalar(s[i], Hibernate.INTEGER);    				
    			}
    		}
    		List list = query.list();
    		if(list.size() > 0) {
    			Iterator it = list.iterator();
    			while(it.hasNext()) {
    				data.addData((Object[])it.next());
    			}
    		}
    	}catch (Exception e) {
        	Object[] p = {start,end};
            handler.getException(e,"getIndividualMiles", userSessionData, p);
		}
    	return data;
    }

    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public HashMap<String,Object[]> getInsertedOdometerLogs(Integer fleet, Integer periodFrom, Integer periodTo, Integer yearFrom, Integer yearTo, UserSessionData userSessionData) throws Exception {
    	HashMap<String,Object[]> values = new HashMap<String,Object[]>();
    	try {
    		Session session = HibernateUtil.currentSession();
    		String sql = "SELECT vehicle, period, year, date, userid, role " +
    				"FROM odometerlog ol " +
    				"LEFT JOIN usercorporations uc ON uc.loginname = ol.userid"+
            		" WHERE ol.fleet = "+ String.valueOf(fleet) +
            		" AND (ol.year > "+yearFrom+" OR (ol.year = "+yearFrom+" AND ol.period >= "+periodFrom+"))" +
            		" AND (ol.year < "+yearTo+" OR (ol.year = "+yearTo+" AND ol.period <= "+periodTo+")) " +
            		"ORDER BY year, period, date";
    		SQLQuery query = session.createSQLQuery(sql).addScalar("vehicle", Hibernate.INTEGER).addScalar("period", Hibernate.INTEGER).addScalar("year", Hibernate.INTEGER).addScalar("date", Hibernate.DATE).addScalar("userid", Hibernate.STRING).addScalar("role", Hibernate.STRING);
    		Iterator it = query.list().iterator();
    		while(it.hasNext()) {
    			Object[] data = (Object[])it.next();
    			String key = data[0]+"-"+data[1]+"-"+data[2];
    			if(!values.containsKey(key)) {
    				String insert = "";
    				if(data[5] == null) {
    					insert = (String)data[4];
    				}else {
    					insert = (data[5].equals("fleetdriver")) ? "query.insertedodometers.fleetdriver" : "query.insertedodometers.accountmanager";
    				}
    				Object[] value = {data[3], insert};
    				values.put(key, value);
    			}
    		}
    	} catch (Exception e) {
        	Object[] p = {fleet,periodFrom,periodTo,yearFrom,yearTo};
            handler.getException(e,"getInsertedOdometers", userSessionData, p);
		}
    	return values;
    }

    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Collection<InsertedOdometer> getInsertedOdometers(Integer fleet, Integer periodFrom, Integer periodTo, Integer yearFrom, Integer yearTo, UserSessionData userSessionData) throws Exception {
    	Collection<InsertedOdometer> vehicles = new LinkedList<InsertedOdometer>();
    	try {
            String[] s = userSessionData.getFilter().getFields("v");
    		String sql = "SELECT v.id as vehicle,v.matricula,d.firstname,d.lastname,o.period AS period,o.year AS year,o.odometer AS odometer" + s[0] +
            		" FROM odometers o, vehicles v, drivers d " + s[1] +
            		" WHERE o.vehicle = v.id " +
            		" AND d.id = v.driver " + s[2] +
            		" AND o.fleet = "+ String.valueOf(fleet) +
            		" AND (o.year > "+yearFrom+" OR (o.year = "+yearFrom+" AND o.period >= "+periodFrom+"))" +
            		" AND (o.year < "+yearTo+" OR (o.year = "+yearTo+" AND o.period <= "+periodTo+"))" +
            		"UNION (" +
            		"SELECT v.id as vehicle,v.matricula,d.firstname,d.lastname,0 AS period,0 AS year,0 AS odometer" + s[0] + 
            		" FROM vehicles v, vehiclefleets vf, drivers d " + s[1] +
            		" WHERE vf.vehicle = v.id " +
            		" AND d.id = v.driver " + s[2] +
            		" AND vf.id = "+ String.valueOf(fleet) +
            		" AND v.id NOT IN (SELECT DISTINCT vehicle FROM odometers WHERE fleet = "+ String.valueOf(fleet) +
            		" AND (year > "+yearFrom+" OR (year = "+yearFrom+" AND period >= "+periodFrom+"))" +
            		" AND (year < "+yearTo+" OR (year = "+yearTo+" AND period <= "+periodTo+")))" +
            		") UNION (" +
            		"SELECT v.id as vehicle,v.matricula,'---' AS firstname,'---' AS lastname,o.period AS period,o.year AS year,o.odometer AS odometer" + s[0] +
            		" FROM odometers o, vehicles v " + s[1] +
            		" WHERE o.vehicle = v.id " + s[2] +
            		" AND v.driver IS NULL " +
            		" AND o.fleet = "+ String.valueOf(fleet) +
            		" AND (o.year > "+yearFrom+" OR (o.year = "+yearFrom+" AND o.period >= "+periodFrom+"))" +
            		" AND (o.year < "+yearTo+" OR (o.year = "+yearTo+" AND o.period <= "+periodTo+"))" +
            		") UNION (" +
            		"SELECT v.id as vehicle,v.matricula,'---' AS firstname,'---' AS lastname,0 AS period,0 AS year,0 AS odometer" + s[0] + 
            		" FROM vehicles v, vehiclefleets vf " + s[1] +
            		" WHERE vf.vehicle = v.id " + s[2] +
            		" AND vf.id = "+ String.valueOf(fleet) +
            		" AND v.driver IS NULL " +
            		" AND v.id NOT IN (SELECT DISTINCT vehicle FROM odometers WHERE fleet = "+ String.valueOf(fleet) +
            		" AND (year > "+yearFrom+" OR (year = "+yearFrom+" AND period >= "+periodFrom+"))" +
            		" AND (year < "+yearTo+" OR (year = "+yearTo+" AND period <= "+periodTo+")))" +
            		") order by vehicle,year,period";
    		Session session = HibernateUtil.currentSession();
    		SQLQuery query = session.createSQLQuery(sql);
    		query.addScalar("vehicle",Hibernate.INTEGER);
    		query.addScalar("matricula",Hibernate.STRING);
    		query.addScalar("firstname",Hibernate.STRING);
    		query.addScalar("lastname",Hibernate.STRING);
    		query.addScalar("period",Hibernate.INTEGER);
    		query.addScalar("year",Hibernate.INTEGER);
    		query.addScalar("odometer",Hibernate.INTEGER);
            StringTokenizer divorgs = new StringTokenizer(s[3],",");
            while (divorgs.hasMoreTokens()){
                query.addScalar(divorgs.nextToken(),Hibernate.STRING);
            }
        	HashMap<Integer,InsertedOdometer> values = new HashMap<Integer,InsertedOdometer>();
            Iterator it = query.list().iterator();
            while(it.hasNext()) {
        		Object[] data = (Object[]) it.next();
            	if(values.containsKey(data[0])) {
        			values.get(data[0]).putOdometer((Integer) data[4], (Integer) data[5], (Integer) data[6]);
            	}else {
            		values.put((Integer)data[0],new InsertedOdometer(data));
            	}
            }
            vehicles.addAll(values.values());
    	} catch (Exception e) {
        	Object[] p = {fleet,periodFrom,periodTo,yearFrom,yearTo};
            handler.getException(e,"getInsertedOdometers", userSessionData, p);
		}
    	return vehicles;
    }
    
    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetinsertdata"
     */
    public Collection<String[]> getDriverLinks(String fleets, UserSessionData userSessionData) throws Exception {
    	Collection<String[]> links = new LinkedList<String[]>();
    	Collection<Integer> drivers = new LinkedList<Integer>();
    	try {
			String query = "SELECT DISTINCT u.loginname,u.password,d.email,u.driver,d.firstname,d.lastname,gf.name " +
			"FROM vehiclefleets vf " +
			"JOIN vehicles v ON v.id = vf.vehicle " +
			"JOIN drivers d ON d.id = v.driver "+
			"JOIN users u ON u.driver = v.driver " +
			"JOIN usercorporations uc ON uc.loginname = u.loginname "+
			"JOIN genericfleets gf ON vf.id = gf.id "+
			"WHERE vf.id in ("+fleets+")  AND d.exclusiondate IS NULL AND uc.role = 'fleetdriver' ";

			Session session = HibernateUtil.currentSession();
    		SQLQuery q = session.createSQLQuery(query);
    		q.addScalar("loginname",Hibernate.STRING);
    		q.addScalar("password",Hibernate.STRING);
    		q.addScalar("driver",Hibernate.INTEGER);
    		q.addScalar("email",Hibernate.STRING);
    		q.addScalar("firstname",Hibernate.STRING);
    		q.addScalar("lastname",Hibernate.STRING);
    		q.addScalar("name",Hibernate.STRING);

    		Iterator it = q.list().iterator();
    		MD5 md5 = new MD5();
    		while(it.hasNext()) {
    			Object[] data = (Object[]) it.next();
    			String login = (String) data[0];
    			String password = (String) data[1];
    			Integer driverId = (Integer) data[2];
    			if(!drivers.contains(driverId)) {
	    			boolean found = false;
	    			int index = 1;
	    			while(!found && index < 10) {
	    				String link = "fleetUser"+driverId+"_"+index;
	    				String cryptUser = md5.encriptar(link);
	    				String pass = md5.encriptar(md5.encriptar(cryptUser));
						if(cryptUser.equals(login) && pass.equals(password)) {
							String[] newLink = {data[4] + " " + data[5],(String)data[3],(String)data[6],"https://www.cepadc.com/datacenter/home.jsp?login="+link};
							drivers.add(driverId);
							links.add(newLink);
						}
						index++;
	    			}
    			}
    		}
    		
			query = "SELECT DISTINCT d.firstname,d.lastname,d.email,gf.name " +
			"FROM vehiclefleets vf " +
			"JOIN vehicles v ON v.id = vf.vehicle " +
			"JOIN drivers d ON d.id = v.driver "+
			"JOIN genericfleets gf ON vf.id = gf.id "+
			"WHERE vf.id in ("+fleets+") AND d.exclusiondate IS NULL " +
			"AND d.id NOT IN (SELECT driver FROM users u JOIN usercorporations uc on u.loginname = uc.loginname " +
				"WHERE uc.role = 'fleetdriver' AND uc.id = "+userSessionData.getCorporationId()+")";
    		SQLQuery q2 = session.createSQLQuery(query);
    		q2.addScalar("firstname",Hibernate.STRING);
    		q2.addScalar("lastname",Hibernate.STRING);
    		q2.addScalar("email",Hibernate.STRING);
    		q2.addScalar("name",Hibernate.STRING);
    		it = q2.list().iterator();
    		while(it.hasNext()) {
    			Object[] data = (Object[]) it.next();
				String[] newLink = {data[0] + " " + data[1],(String)data[2],(String)data[3],"----"};
				links.add(newLink);
    		}

    	} catch (Exception e) {
        	Object[] p = {fleets};
            handler.getException(e,"getInsertedOdometers", userSessionData, p);
		}
    	return links;
    }

    /**
     * @throws Exception
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Collection getInsertedOdometers(Integer year, Integer dpt, Integer distrit, UserSessionData userSessionData) throws Exception {
    	try {
    		String inSQL = "SELECT id FROM drivers WHERE corporation = "+userSessionData.getCorporationId();
    		if(dpt != null)
    			inSQL += " AND divorg1 = " + dpt;
    		if(distrit != null)
    			inSQL += " AND divorg2 = "+distrit;
    		String sql = "SELECT v.driver,v.id AS vehicle,v.matricula,o.period AS period,o.year AS year,o.odometer AS odometer" +
            		" FROM odometers o, vehicles v" +
            		" WHERE o.vehicle = v.id AND v.driver IS NOT NULL AND v.exclusiondate IS NULL" +
            		" AND v.driver IN (" + inSQL + ") " +
/*Cambio ecolab dic*/		" AND ((o.period <= 11 and o.year = "+year+") OR (o.period >= 11 and o.year = "+String.valueOf(year-1)+"))";
/*cambio ecolab ene	" AND ((o.period <= 12 and o.year = "+year+") OR (o.period >= 12 and o.year = "+String.valueOf(year-1)+"))";*/
    		Session session = HibernateUtil.currentSession();
    		SQLQuery query = session.createSQLQuery(sql);
    		query.addScalar("driver",Hibernate.INTEGER);
    		query.addScalar("vehicle",Hibernate.INTEGER);
    		query.addScalar("matricula",Hibernate.STRING);
    		query.addScalar("period",Hibernate.INTEGER);
    		query.addScalar("year",Hibernate.INTEGER);
    		query.addScalar("odometer",Hibernate.INTEGER);
            return query.list();
    	} catch (Exception e) {
        	Object[] p = {year,dpt};
            handler.getException(e,"getInsertedOdometers", userSessionData, p);
		}
    	return new LinkedList();
    }

