	                    if(divOrg != null) {
	                        query += ",detail.pk.fleet."+divOrg+",detail.pk.fleet."+userSessionData.getFilter().get2IndexString(order4,1);
	                    }
	                }
	            }
            }
            Query q = session.createQuery(query);
            List l = q.list();
            return l;
            
        } catch(Exception e){
            Object[] parameters = {periodFrom,yearFrom,periodTo,yearTo,divOrgs,divGeos,type,order1,order2,order3,order4};
            handler.getException(e,"getNewReportAPMMByPeriod",userSessionData,parameters);
        }
        return null;
    }


    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Hashtable getNewReportAPMMByPeriodIndividual(String periodFrom,Integer yearFrom, String periodTo, Integer yearTo, Integer[][] divOrgs, Integer[] divGeos, int type, UserSessionData userSessionData) throws Exception {
        Hashtable periods = new Hashtable();
        try {
            Session session = HibernateUtil.currentSession();

            String query = "select odometer from Odometer odometer "+
                "where odometer.pk.fleet.corporation.id = "+String.valueOf(userSessionData.getFilter().getCorporationId());
            if(divOrgs != null && divOrgs.length > 0) {
                for(int j = 0; j < divOrgs.length; j++) {
                    if(divOrgs[j] != null && divOrgs[j].length > 0) {
                        query += " and odometer.pk.vehicle.divOrg"+String.valueOf(j+1)+" in (";
                        for(int i = 0; i < divOrgs[j].length; i++) {
                            query += divOrgs[j][i];
                            query += (i == divOrgs[j].length-1) ? ") " : ",";
                        }
                    }
                }
            }   
            if(divGeos != null) {
                if(divGeos != null && divGeos.length > 0) {
                    query += "and odometer.pk.vehicle.corpCountry.pk.country in (";
                    for(int i = 0; i < divGeos.length; i++) {
                        query += divGeos[i];
                        query += (i == divGeos.length-1) ? ")" : ",";
                    }
                }
            }
            if(periodFrom.equals("1")) {
                periodFrom = "12";
                yearFrom = new Integer(yearFrom.intValue() - 1);
            }else {
                periodFrom = String.valueOf(Integer.parseInt(periodFrom) - 1);
            }
            query += " and (odometer.pk.year = "+String.valueOf(yearFrom)+" AND odometer.pk.period >= "+periodFrom+" OR odometer.pk.year > "+String.valueOf(yearFrom)+")";
            query += " and (odometer.pk.year = "+String.valueOf(yearTo)+" AND odometer.pk.period <= "+periodTo+" OR odometer.pk.year < "+String.valueOf(yearTo)+")";
            query += " order by odometer.pk.vehicle.id,odometer.pk.year,odometer.pk.period";
    
            Query q = session.createQuery(query);
            List list = q.list();
            if (list != null){
            	Iterator it = list.iterator();
	            while(it.hasNext()) {
	                Odometer odometer = (Odometer)it.next();
	                String period = String.valueOf(odometer.getPk().getPeriod())+"/"+String.valueOf(odometer.getPk().getYear());
	                String prePeriod = getPreviousPeriod(odometer.getPk().getPeriod(),odometer.getPk().getYear(),-1);
	                int lastOdometer = 0;
	                if(periods.containsKey(prePeriod)) {
	                    Hashtable vehicles = (Hashtable)periods.get(prePeriod);
	                    if(vehicles.containsKey(odometer.getPk().getVehicle().getId())) {
	                        Object[] data = (Object[])vehicles.get(odometer.getPk().getVehicle().getId());
	                        lastOdometer = ((Integer)data[2]).intValue();
	                    }
	                }
	                Object[] data = {odometer.getPk().getVehicle().getVehicleData(),new Integer(lastOdometer),odometer.getOdometer(),null};
	                if(type == EventDataType.ACCIDENT) {
	                    data[3] = odometer.getAccidents();
	                }else {
	                    data[3] = odometer.getIncidents();
	                }
	                if(periods.containsKey(period)) {
	                    Hashtable vehicles = (Hashtable)periods.get(period);
	                    vehicles.put(odometer.getPk().getVehicle().getId(),data);
	                }else {
	                    Hashtable vehicles = new Hashtable();
	                    vehicles.put(odometer.getPk().getVehicle().getId(),data);
	                    periods.put(period,vehicles);
	                }
	            }
            }
        } catch(Exception e){        	
            Object[] parameters = {periodFrom,yearFrom,periodTo,yearTo,divOrgs,divGeos,type};
            handler.getException(e,"getNewReportAPMMByPeriodIndividual",userSessionData,parameters);
        }
        return periods;
    }

    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public String[] getFleetDescriptions(String fleet, UserSessionData userSessionData) throws Exception{
        try{            
            Session session = HibernateUtil.currentSession();
            String[] st = null;
            String query = "select fleet.name,fleet.description from AbstractFleet as fleet ";
            query += " where fleet.corporation.id = "+userSessionData.getFilter().getCorporationId();
            query += " and fleet.id in ("+fleet+")";
            List list = session.createQuery(query).list();
            if (list != null){
            	st = new String[list.size()];
            	Iterator it = list.iterator();
            	int index = 0;
            	while(it.hasNext()) {
            		Object[] data = (Object[])it.next();
            		st[index] = data[0]+" ("+data[1]+")";
            		index++;
            	}
            }
            return st;
        } catch(Exception e){
            Object[] parameters = {fleet};
            handler.getException(e,"getFleetDescriptions",userSessionData,parameters);
        }
        return null;
    }
    
    /**
     * @throws InvalidDataException
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "fleetview,administrator"
     */
    public Collection getObservations(Integer fleetId, UserSessionData userRequest) throws Exception
    {
        try
        {    
            Session session = HibernateUtil.currentSession();
        
            String queryStr = "select log from AbstractFleetLog as log "+
                " where log.pk.fleet = (:fleet)";
        
            Query query = session.createQuery(queryStr);
            query.setParameter("fleet",fleetId);
            
            List userColl = query.list();
            List result = new LinkedList();
            Iterator iter = userColl.iterator();
            while (iter.hasNext()) {
            	AbstractFleetLog log = (AbstractFleetLog)iter.next();
                result.add(log.getFleetObservations());
            }
       
            return result;
        
        }
        catch(Exception e) {
            Object[] parameters = {fleetId};
        	handler.getException(e,"getObservations",userRequest,parameters);
        }
        return null;
    }	

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,fleetedit,fleetinsertdata"
     * 
     */
    public Collection findConsumedFuel(Integer fleetId,Integer period,Integer year,UserSessionData userSessionData) throws Exception{
        if (fleetId == null) {
            throw new InvalidDataException("findConsumedFuel","fleetId = null");
        }
        if (period == null) {
            throw new InvalidDataException("findConsumedFuel","period = null");
        }
        if (year == null) {
            throw new InvalidDataException("findConsumedFuel","year = null");
        }
        if (userSessionData == null) {
            throw new DeslogedException("findConsumedFuel","userSessionData = null");
        }
        try{            
            Session session = HibernateUtil.currentSession();
            Query query = session.createQuery("SELECT fuel FROM ConsumedFuel as fuel " +
                    "WHERE fuel.corporation = "+userSessionData.getFilter().getCorporationId()+
                    " AND fuel.fleet = "+String.valueOf(fleetId)+
                    " AND fuel.period = "+String.valueOf(period)+
                    " AND fuel.year = "+String.valueOf(year));
            Iterator it = query.list().iterator();
            Collection list = new LinkedList();
            while(it.hasNext()) {
                ConsumedFuel fuel = (ConsumedFuel)it.next(); 
                list.add(fuel.getData());
            }
            return list;
        } catch(Exception e){
            Object[] parameters = {fleetId,period,year};
            handler.getException(e,"findConsumedFuel",userSessionData,parameters);
        }
        return null;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     * 
     */
    public Collection findConsumedFuelReport(String periodFrom,Integer yearFrom, String periodTo, Integer yearTo, Integer[][] divOrgs, Integer[][] divGeos, int order1, int order2, int order3, int order4, UserSessionData userSessionData, Text messages) throws Exception {
        try{            
            Session session = HibernateUtil.currentSession();
            String query = "select fuel.typeVehicle.resourceBundleId,fuel.fuel.resourceBundleId, sum(fuel.vehicles) as vehicles, sum(fuel.miles) as miles, sum(fuel.liters) as liters ";
            if(order1 == 3) {
                query += ",fuel.country.id,fuel.country.resourceKey";
            }else {
                String divOrg = userSessionData.getFilter().getReportFilter(order1,0);
                if(divOrg != null) {
                    query += ",fuel."+divOrg+",fuel."+userSessionData.getFilter().getReportFilter(order1,1);
                }
            }
            if(order2 == 3) {
                query += ",fuel.country.id,fuel.country.resourceKey";
            }else {
                String divOrg = userSessionData.getFilter().getReportFilter(order2,0);
                if(divOrg != null) {
                    query += ",fuel."+divOrg+",fuel."+userSessionData.getFilter().getReportFilter(order2,1);
                }
            }
            if(order3 == 3) {
                query += ",fuel.country.id,fuel.country.resourceKey";
            }else {
                String divOrg = userSessionData.getFilter().getReportFilter(order3,0);
                if(divOrg != null) {
                    query += ",fuel."+divOrg+",fuel."+userSessionData.getFilter().getReportFilter(order3,1);
                }
            }
            if(order4 == 3) {
                query += ",fuel.country.id,fuel.country.resourceKey";
            }else {
                String divOrg = userSessionData.getFilter().getReportFilter(order4,0);
                if(divOrg != null) {
                    query += ",fuel."+divOrg+",fuel."+userSessionData.getFilter().getReportFilter(order4,1);
                }
            }
            query += " from ConsumedFuel fuel ";
            query += " where fuel.corporation.id = "+userSessionData.getFilter().getCorporationId();
            query += " and (fuel.year = "+String.valueOf(yearFrom)+" AND fuel.period >= "+periodFrom+" OR fuel.year > "+String.valueOf(yearFrom)+")";
            query += " and (fuel.year = "+String.valueOf(yearTo)+" AND fuel.period <= "+periodTo+" OR fuel.year < "+String.valueOf(yearTo)+")";
            if(divGeos[0].length > 0) {
                query += " and fuel.country.id in (";
                for(int i = 0; i < divGeos[0].length; i++) {
                    query += (i == 0) ? String.valueOf(divGeos[0][i]) : ","+String.valueOf(divGeos[0][i]);
                }
                query += ") "; 
            }
            if(divOrgs[0].length > 0) {
                query += " and fuel.divOrg1.id in (";
                for(int i = 0; i < divOrgs[0].length; i++) {
                    query += (i == 0) ? String.valueOf(divOrgs[0][i]) : ","+String.valueOf(divOrgs[0][i]);
                }
                query += ") "; 
            }
            if(divOrgs[1].length > 0) {
                query += " and fuel.divOrg2.id in (";
                for(int i = 0; i < divOrgs[1].length; i++) {
                    query += (i == 0) ? String.valueOf(divOrgs[1][i]) : ","+String.valueOf(divOrgs[1][i]);
                }
                query += ") "; 
            }
            if(divOrgs[2].length > 0) {
                query += " and fuel.divOrg3.id in (";
                for(int i = 0; i < divOrgs[2].length; i++) {
                    query += (i == 0) ? String.valueOf(divOrgs[2][i]) : ","+String.valueOf(divOrgs[2][i]);
                }
                query += ") "; 
            }
            query += " group by fuel.typeVehicle.resourceBundleId,fuel.fuel.resourceBundleId";
            if(order1 == 3) {
                query += ",fuel.country.id,fuel.country.resourceKey";
            }else {
                String divOrg = userSessionData.getFilter().getReportFilter(order1,0);
                if(divOrg != null) {
                    query += ",fuel."+divOrg+",fuel."+userSessionData.getFilter().getReportFilter(order1,1);
                }
            }
            if(order2 == 3) {
                query += ",fuel.country.id,fuel.country.resourceKey";
            }else {
                String divOrg = userSessionData.getFilter().getReportFilter(order2,0);
                if(divOrg != null) {
                    query += ",fuel."+divOrg+",fuel."+userSessionData.getFilter().getReportFilter(order2,1);
                }
            }
            if(order3 == 3) {
                query += ",fuel.country.id,fuel.country.resourceKey";
            }else {
                String divOrg = userSessionData.getFilter().getReportFilter(order3,0);
                if(divOrg != null) {
                    query += ",fuel."+divOrg+",fuel."+userSessionData.getFilter().getReportFilter(order3,1);
                }
            }
            if(order4 == 3) {
                query += ",fuel.country.id,fuel.country.resourceKey";
            }else {
                String divOrg = userSessionData.getFilter().getReportFilter(order4,0);
                if(divOrg != null) {
                    query += ",fuel."+divOrg+",fuel."+userSessionData.getFilter().getReportFilter(order4,1);
                }
            }
            Query q = session.createQuery(query);
            Collection result = new LinkedList();
            List list = q.list();
            if (list != null){
	            Iterator it = list.iterator();
	            
	            while(it.hasNext()) {
	                Object[] data = (Object[])it.next();
	                ReportConsumedFuelData fuel = new ReportConsumedFuelData();
	                fuel.setVehicleType((String)data[0]);
	                fuel.setFuel((String)data[1]);
	                fuel.setVehicles((Integer)data[2]);
	                fuel.setMiles((Integer)data[3]);
	                fuel.setLiters((Integer)data[4]);
	                int index = 5;
	                if(order1 != 4) {
	                    fuel.setDivOrg1Id((Integer) data[index]);
	                    index++;
	                    if(order1 != 3) {
	                        fuel.setDivOrg1Name((String) data[index]);
	                    }else {
	                        fuel.setDivOrg1Name(messages.getText((String) data[index]));
	                    }
	                    index++;
	                }
	                if(order2 != 4) {
	                    fuel.setDivOrg2Id((Integer) data[index]);
	                    index++;
	                    if(order2 != 3) {
	                        fuel.setDivOrg2Name((String) data[index]);
	                    }else {
	                        fuel.setDivOrg2Name(messages.getText((String) data[index]));
	                    }
	                    index++;
	                }
	                if(order3 != 4) {
	                    fuel.setDivOrg3Id((Integer) data[index]);
	                    index++;
	                    if(order3 != 3) {
	                        fuel.setDivOrg3Name((String) data[index]);
	                    }else {
	                        fuel.setDivOrg3Name(messages.getText((String) data[index]));
	                    }
	                    index++;
	                }
	                if(order4 != 4) {
	                    fuel.setDivOrg4Id((Integer) data[index]);
	                    index++;
	                    if(order4 != 3) {
	                        fuel.setDivOrg4Name((String) data[index]);
	                    }else {
	                        fuel.setDivOrg4Name(messages.getText((String) data[index]));
	                    }
	                    index++;
	                }
	                result.add(fuel);
	            }
            }
            return result;
        } catch(Exception e){
            Object[] parameters = {periodFrom,yearFrom,periodTo,yearTo,divOrgs,divGeos,order1,order2,order3,order4};
            handler.getException(e,"findConsumedFuelReport",userSessionData,parameters);
        }
        return null;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Hashtable getReportIndividualFuel(String periodFrom,Integer yearFrom, String periodTo, Integer yearTo, Integer[][] divOrgs, Integer[] divGeos, UserSessionData userSessionData) throws Exception {
        Hashtable periods = new Hashtable();
        try{            

            Session session = HibernateUtil.currentSession();

            String query = "select odometer from Odometer odometer "+
            "where odometer.pk.fleet.corporation.id = "+
            String.valueOf(userSessionData.getFilter().getCorporationId());
            
            HashSet set = new HashSet();
            String divOrgStr = "";
            if(divOrgs != null && divOrgs.length > 0) {
                for(int j = 0; j < divOrgs.length; j++) {
                    if(divOrgs[j] != null && divOrgs[j].length > 0) {
                        divOrgStr = "";
                        divOrgStr = " and odometer.pk.vehicle.divOrg"+String.valueOf(j+1)+" in (";
                        for(int i = 0; i < divOrgs[j].length; i++) {
                            set.add(divOrgs[j][i]);
                        }
                        Iterator it = set.iterator();
                        int i = 0;
                        while (it.hasNext()){
                            String div = ((Integer)it.next()).toString();
                            divOrgStr += div;
                            divOrgStr += (i == set.size()-1) ? ") " : ",";
                            i++;
                        }
                        query+=divOrgStr;
                    }
                }
            }   
            
            if(divGeos != null) {
                if(divGeos != null && divGeos.length > 0) {
                    query += "and odometer.pk.vehicle.corpCountry.pk.country in (";
                    for(int i = 0; i < divGeos.length; i++) {
                        query += divGeos[i];
                        query += (i == divGeos.length-1) ? ")" : ",";
                    }
                }
            }
            if(periodFrom.equals("1")) {
                periodFrom = "12";
                yearFrom = new Integer(yearFrom.intValue() - 1);
            }else {
                periodFrom = String.valueOf(Integer.parseInt(periodFrom) - 1);
            }
            query += " and (odometer.pk.year = "+String.valueOf(yearFrom)+" AND odometer.pk.period >= "+periodFrom+" OR odometer.pk.year > "+String.valueOf(yearFrom)+")";
            query += " and (odometer.pk.year = "+String.valueOf(yearTo)+" AND odometer.pk.period <= "+periodTo+" OR odometer.pk.year < "+String.valueOf(yearTo)+") ";
            query += " order by odometer.pk.vehicle.id,odometer.pk.year,odometer.pk.period";

            Query q = session.createQuery(query);
            List list = q.list();
            if (list != null){
	            Iterator it = list.iterator();
	            while(it.hasNext()) {
	                Odometer odometer = (Odometer)it.next();
	                String period = String.valueOf(odometer.getPk().getPeriod())+"/"+String.valueOf(odometer.getPk().getYear());
	                String prePeriod = getPreviousPeriod(odometer.getPk().getPeriod(),odometer.getPk().getYear(),-1);
	                int lastOdometer = 0;
	                if(periods.containsKey(prePeriod)) {
	                    Hashtable vehicles = (Hashtable)periods.get(prePeriod);
	                    if(vehicles.containsKey(odometer.getPk().getVehicle().getId())) {
	                        Object[] data = (Object[])vehicles.get(odometer.getPk().getVehicle().getId());
	                        lastOdometer = ((Integer)data[2]).intValue();
	                    }
	                }
	                Integer fuel = (odometer.getFuel() == null) ? new Integer(0) : odometer.getFuel();
	                String fuelTypeStr = (odometer.getFuelType() == null) ? "" : odometer.getFuelType().getResourceBundleId();
	                Object[] data = {odometer.getPk().getVehicle().getVehicleData(),new Integer(lastOdometer),odometer.getOdometer(),fuel,fuelTypeStr};
	                if(periods.containsKey(period)) {
	                    Hashtable vehicles = (Hashtable)periods.get(period);
	                    vehicles.put(odometer.getPk().getVehicle().getId(),data);
	                }else {
	                    Hashtable vehicles = new Hashtable();
	                    vehicles.put(odometer.getPk().getVehicle().getId(),data);
	                    periods.put(period,vehicles);
	                }
	            }
            }
        } catch(Exception e){
            Object[] parameters = {periodFrom,yearFrom,periodTo,yearTo,divOrgs,divGeos};
            handler.getException(e,"getReportIndividualFuel",userSessionData,parameters);
        }
        return periods;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "driverodometer"
     */
    public int findFleetPeriodType(Integer vehicleId,UserSessionData userSessionData) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"findFleetPeriodType",this.getClass());
        int type = -1;
        try {
            Session session = HibernateUtil.currentSession();
            Query query = session.createSQLQuery("SELECT period FROM vehiclefleets vf JOIN genericfleets gf ON gf.id = vf.id WHERE vehicle = "+String.valueOf(vehicleId)).addScalar("period",Hibernate.INTEGER);
            List list = query.list();
            if (list != null){
            	Iterator it = list.iterator();
            	if(it.hasNext()) {
            		type = ((Integer)it.next()).intValue();
            	}
            }
        }catch(Exception e) {
        	Object[] parameters = {vehicleId};
            handler.getException(e,"findFleetPeriodType",userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"findFleetPeriodType",this.getClass());
        return type;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "driverodometer"
     */
    public Calendar findNextOdometer(Integer vehicleId,UserSessionData userSessionData) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"findNextOdometer",this.getClass());
        Calendar calendar = Calendar.getInstance();
        try {
            Session session = HibernateUtil.currentSession();
            Query query = session.createSQLQuery("SELECT period,year FROM odometers WHERE vehicle = "+String.valueOf(vehicleId)+" ORDER BY year DESC,period DESC").addScalar("period",Hibernate.INTEGER).addScalar("year",Hibernate.INTEGER);
            List list = query.list();
            if (list != null){
            	Iterator it = list.iterator();
	            if(it.hasNext()) {
	                Object[] data = ((Object[])it.next());
	                calendar.set(Calendar.MONTH,((Integer)data[0]).intValue()-1);
	                calendar.set(Calendar.YEAR,((Integer)data[1]).intValue());
	                calendar.add(Calendar.MONTH,1);
	            }else {
	                calendar = null;
	            }
            }
        }catch(Exception e) {
        	Object[] parameters = {vehicleId};
            handler.getException(e,"findNextOdometer",userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"findNextOdometer",this.getClass());
        return calendar;
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "driverodometer"
     */
    public Calendar findLastOdometer(Integer vehicleId,UserSessionData userSessionData) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"findNextOdometer",this.getClass());
        Calendar calendar = Calendar.getInstance();
        try {
            Session session = HibernateUtil.currentSession();
            Query query = session.createSQLQuery("SELECT period,year FROM odometers WHERE vehicle = "+String.valueOf(vehicleId)+" ORDER BY year DESC,period DESC").addScalar("period",Hibernate.INTEGER).addScalar("year",Hibernate.INTEGER);
            Iterator it = query.list().iterator();
            if(it.hasNext()) {
                Object[] data = ((Object[])it.next());
                calendar.set(Calendar.MONTH,((Integer)data[0]).intValue()-1);
                calendar.set(Calendar.YEAR,((Integer)data[1]).intValue());
            }else {
                calendar = null;
            }
        }catch(Exception e) {
        	Object[] parameters = {vehicleId};
            handler.getException(e,"findNextOdometer",userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"findLastOdometer",this.getClass());
        return calendar;
    }

