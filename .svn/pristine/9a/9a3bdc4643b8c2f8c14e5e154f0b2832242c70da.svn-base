    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Collection getReportAPMMByPeriod(String periodFrom,Integer yearFrom, String periodTo, Integer yearTo, Integer[][] divOrgs, Integer[][] divGeos, int first, int count, UserSessionData userSessionData) throws Exception {
        try{            

            Session session = HibernateUtil.currentSession();
            String query = "select sum(detail.miles), sum(detail.accidents)";
            for(int i = 0; i < 3; i++) {
                String divOrg = userSessionData.getFilter().get2IndexString(i,0);
                if(divOrg != null) {
                    query += ",detail.pk.fleet."+divOrg+",detail.pk.fleet."+userSessionData.getFilter().get2IndexString(i,1);
                }
            }
            query += " from FleetDivisionDetail detail ";
            query += " where detail.pk.fleet.fleet.corporation.id = "+userSessionData.getFilter().getCorporationId();
            query += " and (detail.pk.year = "+String.valueOf(yearFrom)+" AND detail.pk.period >= "+periodFrom+" OR detail.pk.year > "+String.valueOf(yearFrom)+")";
            query += " and (detail.pk.year = "+String.valueOf(yearTo)+" AND detail.pk.period <= "+periodTo+" OR detail.pk.year < "+String.valueOf(yearTo)+")";
            if(divGeos[0].length > 0) {
                query += " and detail.pk.fleet.country.id = "+String.valueOf(divGeos[0][0])+" ";
            }
            if(divOrgs[0].length > 0) {
                query += " and detail.pk.fleet.divOrg11.id = "+String.valueOf(divOrgs[0][0])+" ";
            }
            if(divOrgs[1].length > 0) {
                query += " and detail.pk.fleet.divOrg21.id in (";
                for(int i = 0; i < divOrgs[1].length; i++) {
                    query += (i == 0) ? String.valueOf(divOrgs[1][i]) : ","+String.valueOf(divOrgs[1][i]);
                }
                query += ") "; 
            }
            query += " group by ";
            for(int i = 0; i < 3; i++) {
                String divOrg = userSessionData.getFilter().get2IndexString(i,0);
                if(divOrg != null) {
                    if(i > 0) {
                        query += ",";
                    }
                    query += "detail.pk.fleet."+divOrg+",detail.pk.fleet."+userSessionData.getFilter().get2IndexString(i,1);
                }
            }
            Query q = session.createQuery(query);
            return q.list();
            
        } catch(Exception e){
            Object[] parameters = {periodFrom,yearFrom,periodTo,yearTo,divOrgs,divGeos,first,count};
            handler.getException(e,"getReportAPMMByPeriod",userSessionData,parameters);
        }
        return null;
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Collection getReportAccidentType(String frommonth, Integer fromyear, String tomonth, Integer toyear, Integer[][] divOrgs, Integer[] divGeos, String accidents, UserSessionData userSessionData,int order1,int order2,int order3,int order4,Text messages) throws Exception {
        Collection elements = new LinkedList();
        try{            
            Session session = HibernateUtil.currentSession();
            String queryStr = "SELECT SUM(accident.number), SUM(accident.cost), " +
                    " accident.clasification.resourceBundleId, accident.collisionClasification.resourceBundleId, accident.consequence.resourceBundleId ";
            if(order1 == 3) {
                queryStr += ",accident.country.id,accident.country.resourceKey";
            }else {
                String filter = userSessionData.getFilter().getReportFilter(order1,0);
                if(filter != null) {
                    queryStr += ",accident."+filter+",accident."+userSessionData.getFilter().getReportFilter(order1,1);
                }
            }
            if(order2 == 3) {
                queryStr += ",accident.country.id,accident.country.resourceKey";
            }else {
                String filter = userSessionData.getFilter().getReportFilter(order2,0);
                if(filter != null) {
                    queryStr += ",accident."+filter+",accident."+userSessionData.getFilter().getReportFilter(order2,1);
                }
            }
            if(order3 == 3) {
                queryStr += ",accident.country.id,accident.country.resourceKey";
            }else {
                String filter = userSessionData.getFilter().getReportFilter(order3,0);
                if(filter != null) {
                    queryStr += ",accident."+filter+",accident."+userSessionData.getFilter().getReportFilter(order3,1);
                }
            }
            if(order4 == 3) {
                queryStr += ",accident.country.id,accident.country.resourceKey";
            }else {
                String filter = userSessionData.getFilter().getReportFilter(order4,0);
                if(filter != null) {
                    queryStr += ",accident."+filter+",accident."+userSessionData.getFilter().getReportFilter(order4,1);
                }
            }
            queryStr += " FROM FleetAccident AS accident "+
                    " WHERE accident.corporation = "+userSessionData.getFilter().getCorporationId()+
                    " AND (accident.year = "+String.valueOf(fromyear)+" AND accident.period >= "+String.valueOf(frommonth)+" OR accident.year > "+String.valueOf(fromyear)+") "+
                    " AND (accident.year = "+String.valueOf(toyear)+" AND accident.period <= "+String.valueOf(tomonth)+" OR accident.year < "+String.valueOf(toyear)+") ";
            if(divOrgs != null && divOrgs.length > 0) {
                for(int j = 0; j < divOrgs.length; j++) {
                    if(divOrgs[j] != null && divOrgs[j].length > 0) {
                        queryStr += " AND accident.divOrg"+String.valueOf(j+1)+" in (";
                        for(int i = 0; i < divOrgs[j].length; i++) {
                            queryStr += divOrgs[j][i];
                            queryStr += (i == divOrgs[j].length-1) ? ") " : ",";
                        }
                    }
                }
            }   
            if(divGeos != null) {
                if(divGeos.length > 0) {
                    queryStr += "AND accident.country in (";
                    for(int i = 0; i < divGeos.length; i++) {
                        queryStr += divGeos[i];
                        queryStr += (i == divGeos.length-1) ? ")" : ",";
                    }
                }
            }
            queryStr += " AND accident.clasification in ("+accidents+") ";
            queryStr += " GROUP BY accident.clasification.resourceBundleId, accident.collisionClasification.resourceBundleId, accident.consequence.resourceBundleId";
            if(order1 == 3) {
                queryStr += ",accident.country.id,accident.country.resourceKey";
            }else {
                String filter = userSessionData.getFilter().getReportFilter(order1,0);
                if(filter != null) {
                    queryStr += ",accident."+filter+",accident."+userSessionData.getFilter().getReportFilter(order1,1);
                }
            }
            if(order2 == 3) {
                queryStr += ",accident.country.id,accident.country.resourceKey";
            }else {
                String filter = userSessionData.getFilter().getReportFilter(order2,0);
                if(filter != null) {
                    queryStr += ",accident."+filter+",accident."+userSessionData.getFilter().getReportFilter(order2,1);
                }
            }
            if(order3 == 3) {
                queryStr += ",accident.country.id,accident.country.resourceKey";
            }else {
                String filter = userSessionData.getFilter().getReportFilter(order3,0);
                if(filter != null) {
                    queryStr += ",accident."+filter+",accident."+userSessionData.getFilter().getReportFilter(order3,1);
                }
            }
            if(order4 == 3) {
                queryStr += ",accident.country.id,accident.country.resourceKey";
            }else {
                String filter = userSessionData.getFilter().getReportFilter(order4,0);
                if(filter != null) {
                    queryStr += ",accident."+filter+",accident."+userSessionData.getFilter().getReportFilter(order4,1);
                }
            }
            Query query = session.createQuery(queryStr);
            List list = query.list();
            if (list != null){
	            Iterator it = list.iterator();
	            while(it.hasNext()) {
	                Object[] data = (Object[])it.next();
	                int count = ((Long)data[0]).intValue();
	                int cost = ((Long)data[1]).intValue();
	                String eventType = (String)data[2];
	                int corpNumber=userSessionData.getFilter().getCorporationId().intValue();
	                if((corpNumber != CorporationData.MONSANTO)) {
	                    if(eventType.equals("datatype.accidentclasification.other")) {
	                        eventType = ((String)data[3])+"_"+eventType;
	                    }
	                }
	                String consequence = (String)data[4];
	                Integer divOrg1Id = (data.length > 5) ? (Integer)data[5] : null;
	                String divOrg1Name = (data.length > 6) ? (String)data[6] : null;
	                if(order1 == 3) {
	                    divOrg1Name = messages.getText(divOrg1Name);
	                }
	                Integer divOrg2Id = (data.length > 7) ? (Integer)data[7] : null;
	                String divOrg2Name = (data.length > 8) ? (String)data[8] : null;
	                if(order2 == 3) {
	                    divOrg2Name = messages.getText(divOrg2Name);
	                }
	                Integer divOrg3Id = (data.length > 9) ? (Integer)data[9] : null;
	                String divOrg3Name = (data.length > 10) ? (String)data[10] : null;
	                if(order3 == 3) {
	                    divOrg3Name = messages.getText(divOrg3Name);
	                }
	                Integer divOrg4Id = (data.length > 11) ? (Integer)data[11] : null;
	                String divOrg4Name = (data.length > 12) ? (String)data[12] : null;
	                if(order4 == 3) {
	                    divOrg4Name = messages.getText(divOrg4Name);
	                }
	                elements.add(new EventTypeData(count,cost,eventType,consequence,divOrg1Id,divOrg1Name,divOrg2Id,divOrg2Name,divOrg3Id,divOrg3Name,divOrg4Id,divOrg4Name,"accident"));
	            }
            }
        } catch(Exception e){
        	Object[] parameters = {frommonth,fromyear,tomonth,toyear,divOrgs,divGeos,accidents,order1,order2,order3,order4};
            handler.getException(e,"getReportAccidentType",userSessionData,parameters);
        }
        return elements;
    }

