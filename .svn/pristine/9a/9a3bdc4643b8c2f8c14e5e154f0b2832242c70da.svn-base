    public Collection kmByTradeInstitutional(String frommonth, String fromyear, String tomonth, String toyear, String plate, int status, Integer[][] divOrgs, Integer[][] divGeos, UserSessionData userSessionData) throws Exception {
        try {
            Session session = HibernateUtil.currentSession();
            String[] s = userSessionData.getFilter().getFields("v");
            String sql = "SELECT v.matricula,o.period,o.year,o.odometer,o.accidents,o.incidents,o.fuel" +
                   ",v.fuel AS fueltype,v.id as vehicleid, c.resourcekey as country  " + // Agregado 20/10/2011
                   s[0] +                   
                   " FROM odometers o,genericfleets gf,vehicles v,country c  " + s[1] +
                   UtilityQuery.corporationDivisionsRestictionsSQL("v",userSessionData)+
                   " AND gf.id = o.fleet " +
                   " AND o.vehicle = v.id " +
                   s[2] +
                   " AND c.id = v.country " +
                   " AND v.driver IS NULL " +
                   " AND (o.year > "+fromyear+" OR (o.year = "+fromyear+" AND o.period >= "+frommonth+")) "+
                   " AND (o.year < "+toyear+" OR (o.year = "+toyear+" AND o.period <= "+tomonth+")) ";
            if(!Util.empty(plate)) {
                sql += " AND matricula LIKE '%" + plate + "%' ";                
            }
            switch (status) {
                case VehicleData.ACTIVE:
                    sql += " AND v.exclusionDate IS NULL";
                    break;
                case VehicleData.EXCLUDED:
                    sql += " AND v.exclusionDate IS NOT NULL";
                    break;
            }
            
            if(divOrgs != null && divOrgs.length > 0) {
                for(int j = 0; j < divOrgs.length; j++) {
                    if(divOrgs[j] != null && divOrgs[j].length > 0) {
                        sql += " AND v.divOrg"+String.valueOf(j+1)+" in (";
                        for(int i = 0; i < divOrgs[j].length; i++) {
                            sql += divOrgs[j][i];
                            sql += (i == divOrgs[j].length-1) ? ") " : ",";
                        }
                    }
                }
            }   
            if(divGeos != null) {
                if(divGeos[0] != null && divGeos[0].length > 0) {
                    sql += " AND v.country in (";
                    for(int i = 0; i < divGeos[0].length; i++) {
                        sql += divGeos[0][i];
                        sql += (i == divGeos[0].length-1) ? ")" : ",";
                    }
                }
            }

            sql += " ORDER BY vehicleid,year,period";
            SQLQuery query = session.createSQLQuery(sql);
            query.addScalar("matricula",Hibernate.STRING); // 0
            query.addScalar("period",Hibernate.INTEGER); // 1
            query.addScalar("year",Hibernate.INTEGER); // 2
            query.addScalar("odometer",Hibernate.INTEGER); // 3
            query.addScalar("accidents",Hibernate.INTEGER) ; // 4
            query.addScalar("incidents",Hibernate.INTEGER); // 5
            query.addScalar("fuel",Hibernate.INTEGER);  // 6
            query.addScalar("fueltype",Hibernate.STRING); // 7
            
            query.addScalar("vehicleid",Hibernate.INTEGER); //8
            query.addScalar("country",Hibernate.STRING); // 9
            
            StringTokenizer divorgs = new StringTokenizer(s[3],",");
            while (divorgs.hasMoreTokens()){
                query.addScalar(divorgs.nextToken(),Hibernate.STRING);
            }    
            
            List list = query.list();
            return list;
        } catch (Exception e) {
        	Object[] parameters = {frommonth,fromyear,tomonth,toyear,plate,status,divOrgs,divGeos};
            handler.getException(e,"kmByTrade",userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"kmByTrade",getClass());
        return null;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query" 
     */
    public Collection getMissingOdometers(String period,String year,Integer[][] divOrgs,
    		Integer[] divGeos,String plate,int status,String fleets,
    		UserSessionData userSessionData) throws Exception {
    	try {
	        String[] fields =  userSessionData.getFilter().getFields("v");
	    	String sqlWhere = UtilityQuery.corporationDivisionsRestictionsSQL("v",userSessionData);

	    	// Consulta los vehículos con conductor asociado
	    	String sql1 = "SELECT DISTINCT d.firstname,d.lastname,v.matricula," +
	    			"c.resourcekey AS country,gf.name,d.id AS driverId,v.id AS " +
	    			"vehicleId,d.email,d.director"+fields[0]+" FROM vehicles AS v,drivers AS d " +
	    			",country AS c,vehiclefleets vf,genericfleets gf"+fields[1]+sqlWhere;
	        sql1 += " AND v.driver = d.id AND v.country = c.id AND vf.vehicle = v.id AND vf.id = gf.id "+fields[2];
	    	
	     // Consulta los vehículos sinn conductor asociado
	        String sql2 = "SELECT DISTINCT '--' AS firstname,'--' AS lastname,v.matricula," +
	    			"c.resourcekey AS country,gf.name,0 AS driverId,v.id AS " +
	    			"vehicleId,'--' AS email,false as director"+fields[0]+" FROM vehicles AS v " +
	    			",country AS c,vehiclefleets vf,genericfleets gf"+fields[1]+sqlWhere;
	        sql2 += " AND v.use = '"+TypeUseDataType.INSTITUTIONAL+"' AND v.country = c.id AND vf.vehicle = v.id AND vf.id = gf.id "+fields[2];
	    	
	        String sqlConditions = "";
	        HashSet set = new HashSet();
	        if(divOrgs != null && divOrgs.length > 0) {
	            for(int j = 0; j < divOrgs.length; j++) {
	                if(divOrgs[j] != null && divOrgs[j].length > 0) {
	                    sqlConditions += " AND v.divOrg"+String.valueOf(j+1)+" in (";
	                    for(int i = 0; i < divOrgs[j].length; i++) {
	                    	set.add(divOrgs[j][i]); 
	                    }
	                    Iterator it = set.iterator();
	                    int i = 0;
	                    while (it.hasNext()){
	                    	sqlConditions += ((Integer)it.next()).toString();
	                        sqlConditions += (i == set.size()-1) ? ") " : ",";
	                        i++;
	                    }
	                }
	            }
	        }   
	        
	        if(divGeos != null) {
	            if(divGeos.length > 0) {
	            	sqlConditions += " AND v.country in (";
	                for(int i = 0; i < divGeos.length; i++) {
	                	sqlConditions += divGeos[i];
	                	sqlConditions += (i == divGeos.length-1) ? ")" : ",";
	                }
	            }
	        }
	
	        switch (status) {
	        	case VehicleData.ACTIVE:
	        		sqlConditions += " AND v.exclusionDate is null";
	        		break;
	        	case VehicleData.EXCLUDED:
	        		sqlConditions += " AND v.exclusionDate is not null";
	        		break;
	        }

	        if(!Util.empty(plate)) {
		        sqlConditions += " AND LOWER(v.matricula) LIKE '%"+plate.toLowerCase()+"%' ";
	        }
	        sqlConditions += " AND gf.id IN ("+fleets+") ";
	        sqlConditions += " AND v.id NOT IN (SELECT vehicle FROM odometers WHERE fleet IN ("+fleets+") AND period = "+period+" AND year = "+year+")";
	        
	        String sql = sql1 + sqlConditions + " UNION (" + sql2 + sqlConditions +") ORDER BY name,matricula";
	        
	        Session session = HibernateUtil.currentSession();
	        SQLQuery query = session.createSQLQuery(sql);
	        query.addScalar("name",Hibernate.STRING);
	        query.addScalar("firstname",Hibernate.STRING);
	        query.addScalar("lastname",Hibernate.STRING);
	        query.addScalar("matricula",Hibernate.STRING);
	        query.addScalar("country",Hibernate.STRING);
	        query.addScalar("driverId",Hibernate.INTEGER);
	        query.addScalar("vehicleId",Hibernate.INTEGER);
	        query.addScalar("email",Hibernate.STRING);
	        query.addScalar("director",Hibernate.BOOLEAN);
            StringTokenizer divorgs = new StringTokenizer(fields[3],",");
            while (divorgs.hasMoreTokens()){
                query.addScalar(divorgs.nextToken(),Hibernate.STRING);
            }
            
            return query.list();
            
    	}catch (Exception e) {
        	Object[] parameters = {period,year,divOrgs,divGeos,plate,status,fleets};
            handler.getException(e,"getMissingOdometers",userSessionData,parameters);
		}
        
        return new LinkedList();
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverodometer"
     */
    public Integer[][] getLastOdometers(Integer vehicle, Integer period, Integer year,UserSessionData userSessionData) throws Exception {
    	Integer[][] values = new Integer[2][3];
    	try {
    		Session session = HibernateUtil.currentSession();
    		SQLQuery query = session.createSQLQuery("SELECT odometer,period,year FROM odometers WHERE vehicle = "+String.valueOf(vehicle)+
    			" AND (year < "+String.valueOf(year)+" OR (year = "+String.valueOf(year)+" and period < "+String.valueOf(period)+")) "+
    			"ORDER BY year DESC,period DESC");
    		query.addScalar("odometer", Hibernate.INTEGER);
    		query.addScalar("period", Hibernate.INTEGER);
    		query.addScalar("year", Hibernate.INTEGER);
    		Iterator it = query.list().iterator();
    		for(int j = 0; j < 2 && it.hasNext(); j++) {
    			Object[] data = (Object[])it.next();
    			for(int i = 0; i < 3; i++) {
    				values[j][i] = (Integer)data[i];
    			}
    		}
    	}catch (Exception e) {
        	Object[] parameters = {vehicle,period,year};
            handler.getException(e,"getLastOdometers",userSessionData,parameters);
		}
    	return values;
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverodometer"
     */
    public Collection getOdometers(String fleet, String period, String year, int operator, UserSessionData userSessionData) throws Exception {
    	try {
    		Session session = HibernateUtil.currentSession();
    		String sql = "SELECT vehicle, odometer, period, year, incidents, accidents FROM odometers WHERE fleet = "+fleet;
    		switch(operator) {
    			case -1:
        			sql += " AND (year < "+year+" OR (year = "+year+" and period < "+period+")) ";
        			break;
    			case 0:
        			sql += " AND year = "+year+" AND period = "+period;
        			break;
    		}

    		SQLQuery query = session.createSQLQuery(sql);
    		query.addScalar("vehicle", Hibernate.INTEGER);
    		query.addScalar("odometer", Hibernate.INTEGER);
    		query.addScalar("period", Hibernate.INTEGER);
    		query.addScalar("year", Hibernate.INTEGER);
    		query.addScalar("incidents", Hibernate.INTEGER);
    		query.addScalar("accidents", Hibernate.INTEGER);
    		return query.list();
    	}catch (Exception e) {
        	Object[] parameters = {fleet,period,year,operator};
            handler.getException(e,"getOdometers",userSessionData,parameters);
		}
    	return null;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverodometer"
     */
    public Hashtable getFleetDrivers(Integer fleet,UserSessionData userSessionData) throws Exception {
		Hashtable users = new Hashtable();
		Session session = HibernateUtil.currentSession();
    	try {
    		String query = "SELECT DISTINCT u.loginname,u.password,u.email,u.driver,u.firstname,u.lastname " +
    				"FROM vehiclefleets vf " +
    				"JOIN vehicles v ON v.id = vf.vehicle " +
    				"JOIN users u ON u.driver = v.driver " +
    				"JOIN usercorporations uc ON uc.loginname = u.loginname "+  
    				"WHERE vf.id = "+String.valueOf(fleet)+" AND uc.role = 'fleetdriver' ";
    				//"AND email IN ('marcia.g.andrade@monsanto.com','rogerio.c.alves@monsanto.com')";
    		Query q = session.createSQLQuery(query).addScalar("loginname", Hibernate.STRING).
    		addScalar("password", Hibernate.STRING).addScalar("email", Hibernate.STRING).
    		addScalar("driver", Hibernate.INTEGER).addScalar("firstname", Hibernate.STRING).
    		addScalar("lastname", Hibernate.STRING);
    		Iterator it = q.list().iterator();
    		MD5 md5 = new MD5();
    		while(it.hasNext()) {
    			Object[] data = (Object[])it.next();
                String loginName = (String)data[0];
                String email = (String)data[2];
                String driver = String.valueOf(data[3]);
                if(email != null && email.length() > 0) {
	            	String crypt = md5.encriptar(md5.encriptar(loginName));
	            	String cryptUser = null;
	            	String user = null;
	            	boolean found = false;
	        		if(!data[1].equals(crypt)) {
	            		System.out.println("Password incorrecto "+crypt+" "+data[0]);
	            	}else {
	                    int i = 1;
	                    user = "fleetUser"+driver+"_"+i;
	                    cryptUser = md5.encriptar(user);
	                    found = cryptUser.equals(loginName);
	                    while(!found && i < 10) {
	                    	i++;
	                        user = "fleetUser"+driver+"_"+i;
	                        cryptUser = md5.encriptar(user); 
	                        found = cryptUser.equals(loginName);
	                    }
	            	}
	        		if(found) {
	        			if(!users.containsKey(driver)) {
	        				System.out.println(data[4]+","+data[5]+","+email+",https://www.cepadc.com/datacenter/home.jsp?login="+user);
	        				users.put(driver, user);
	        			}
	            	}
                }
    		}
    	}catch (Exception e) {
        	Object[] parameters = {fleet};
            handler.getException(e,"getFleetDrivers",userSessionData,parameters);
		}
    	return users;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverodometer"
     */
    public Hashtable getFleetDriversWithoutOdometer(Integer fleet,String period,String year,UserSessionData userSessionData) throws Exception {
		Hashtable users = new Hashtable();
		Session session = HibernateUtil.currentSession();
    	try {
    		String query = "SELECT DISTINCT u.loginname,u.email,u.driver FROM vehiclefleets vf " +
    				"JOIN vehicles v ON v.id = vf.vehicle " +
    				"JOIN users u ON u.driver = v.driver " +
    				"JOIN usercorporations uc ON uc.loginname = u.loginname "+  
    				"WHERE vf.id = "+String.valueOf(fleet)+" AND uc.role = 'fleetdriver' "+
    				" AND v.id NOT IN (SELECT vehicle FROM odometers WHERE fleet = "+String.valueOf(fleet)+
    				" AND period = "+period+" AND year = "+year+")";
    		Query q = session.createSQLQuery(query).addScalar("loginname", Hibernate.STRING).addScalar("email", Hibernate.STRING).addScalar("driver", Hibernate.INTEGER);
    		Iterator it = q.list().iterator();
    		MD5 md5 = new MD5();
    		while(it.hasNext()) {
    			Object[] data = (Object[])it.next();
                String loginName = (String)data[0];
                String email = (String)data[1];
                if(email != null && email.length() > 0) {
                    int i = 0;
                    String user = null;
                    boolean found = false;;
                    do {
                    	i++;
                    	user = "fleetUser"+String.valueOf(data[2])+"_"+i;
                    	found = md5.encriptar(user).equals(loginName);
                    }while (!found && i < 10);
	        		if(found) {
	        			if(!users.containsKey(email)) {
	        				users.put(email, user);
	        			}
	            	}
                }
    		}
    	}catch (Exception e) {
        	Object[] parameters = {fleet,period,year};
            handler.getException(e,"getFleetDriversWithoutOdometer",userSessionData,parameters);
		}
    	return users;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverodometer"
     */
    public Object[] getFleetVehicle(String plate,String fleet,UserSessionData userSessionData) throws Exception {
    	Object[] result = null;
		Session session = HibernateUtil.currentSession();
    	try {
    		String select = "SELECT o.vehicle,d.id,d.firstname,d.lastname,d.iddallas " +
    				" FROM odometers o " +
    				" JOIN vehicles v ON o.vehicle = v.id " +
    				" JOIN vehiclefleets vf ON (vf.vehicle = o.vehicle AND vf.id = o.fleet) " +
    				" LEFT JOIN drivers d ON v.driver = d.id " +
    				" WHERE vf.fleet = "+fleet+" AND lower(trim(v.matricula)) = '"+plate.trim().toLowerCase()+"'";
    		Query q = session.createSQLQuery(select)
    				.addScalar("vehicle", Hibernate.INTEGER)
    				.addScalar("id", Hibernate.INTEGER)
    				.addScalar("firstname", Hibernate.STRING)
    				.addScalar("lastname", Hibernate.STRING)
    				.addScalar("iddallas", Hibernate.STRING);
    		Iterator it = q.list().iterator();
    		if(it.hasNext()) {
    			result = (Object[])it.next();
    		}

    	}catch (Exception e) {
        	Object[] p = {plate,fleet};
            handler.getException(e,"getFleetVehicle", userSessionData, p);
		}
    	return result;
    }	

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverodometer"
     */
    public Object[] getFleetVehicle(String plate,UserSessionData userSessionData) throws Exception {
    	Object[] result = null;
		Session session = HibernateUtil.currentSession();
    	try {
    		String select = "SELECT vf.id AS fleet, v.id AS vehicle " +
    				"FROM vehiclefleets vf " +
    				"JOIN vehicles v ON vf.vehicle = v.id " +
    				"JOIN genericfleets gf ON gf.id = vf.id " +
    				"WHERE lower(trim(v.matricula)) = '"+plate.trim().toLowerCase()+"' " +
    				"AND gf.exclusiondate IS NULL " +
    				"AND gf.corporation = " + userSessionData.getCorporationId()+ " AND v.corporation = " + userSessionData.getCorporationId();
    		Query q = session.createSQLQuery(select)
    				.addScalar("fleet", Hibernate.INTEGER)
    				.addScalar("vehicle", Hibernate.INTEGER);
    		Iterator it = q.list().iterator();
    		if(it.hasNext()) {
    			result = (Object[])it.next();
    		}

    	}catch (Exception e) {
        	Object[] p = {plate};
            handler.getException(e,"getFleetVehicle", userSessionData, p);
		}
    	return result;
    }	

