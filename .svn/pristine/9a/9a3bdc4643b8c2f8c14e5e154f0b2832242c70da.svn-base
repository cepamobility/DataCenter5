    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     *
    public Hashtable apmmReportByDivision(String periodFrom, Integer yearFrom, String periodTo, Integer yearTo, Integer[][] divOrgs, Integer[] divGeos, UserSessionData userSessionData) throws Exception {
*/
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Hashtable getReportIndividualAPMMByDivision(String periodFrom,Integer yearFrom, String periodTo, 
    		Integer yearTo, Integer[][] divOrgs, Integer[] divGeos, UserSessionData userSessionData) throws Exception {
        Hashtable periods = new Hashtable();
        try{            

            Session session = HibernateUtil.currentSession();

            String query = "select odometer from Odometer odometer "+
            "where odometer.pk.fleet.corporation.id = "+
            String.valueOf(userSessionData.getFilter().getCorporationId());                     
            
            // Divorgs para los Vehiculos:
            HashSet set = new HashSet();
            String divOrgStr = "";
            if(divOrgs != null && divOrgs.length > 0) {
                for(int j = 0; j < divOrgs.length; j++) {
                    if(divOrgs[j] != null && divOrgs[j].length > 0) {
                    	divOrgStr = "";
                        divOrgStr = " and odometer.pk.vehicle.divOrg"+String.valueOf(j+1)+" in (";
                        for(int i = 0; i < divOrgs[j].length; i++) {
                        	set.add(divOrgs[j][i]); // Para evitar repetidos                        	
                        }
                        Iterator it = set.iterator();
                        int i = 0;
                        while (it.hasNext()){
                        	String div = ((Integer)it.next()).toString();
                        	divOrgStr += div;
                            divOrgStr += (i == set.size()-1) ? ") " : ",";
                            i++;
                        }
                        query+=divOrgStr;
                    }
                }
            }              
           
            
            if(divGeos != null) {
                if(divGeos != null && divGeos.length > 0) {
                    query += "and odometer.pk.vehicle.corpCountry.pk.country in (";
                    for(int i = 0; i < divGeos.length; i++) {
                        query += divGeos[i];
                        query += (i == divGeos.length-1) ? ")" : ",";
                    }
                }
            }
            if(periodFrom.equals("1")) {
                periodFrom = "12";
                yearFrom = new Integer(yearFrom.intValue() - 1);
            }else {
                periodFrom = String.valueOf(Integer.parseInt(periodFrom) - 1);
            }
            query += " and (odometer.pk.year = "+String.valueOf(yearFrom)+" AND odometer.pk.period >= "+periodFrom+" OR odometer.pk.year > "+String.valueOf(yearFrom)+")";
            query += " and (odometer.pk.year = "+String.valueOf(yearTo)+" AND odometer.pk.period <= "+periodTo+" OR odometer.pk.year < "+String.valueOf(yearTo)+")";
            query += " order by odometer.pk.vehicle.id,odometer.pk.year,odometer.pk.period";

            Query q = session.createQuery(query);
            List list = q.list();
            Iterator it = list.iterator();
            while(it.hasNext()) {
                Odometer odometer = (Odometer)it.next();
                String period = String.valueOf(odometer.getPk().getPeriod())+"/"+String.valueOf(odometer.getPk().getYear());
                String prePeriod = getPreviousPeriod(odometer.getPk().getPeriod(),odometer.getPk().getYear(),-1);
                int lastOdometer = 0;
                if(periods.containsKey(prePeriod)) {
                    Hashtable vehicles = (Hashtable)periods.get(prePeriod);
                    if(vehicles.containsKey(odometer.getPk().getVehicle().getId())) {
                        Object[] data = (Object[])vehicles.get(odometer.getPk().getVehicle().getId());
                        lastOdometer = ((Integer)data[2]).intValue();
                    }
                }
                if(odometer.getOdometer().intValue() > 0) {
                	
                	/* por el tema de lazy inicialization */
                	Collection unconformities = odometer.getPk().getVehicle().getVehicleData().getUnconformities();
                	
                    Object[] data = {odometer.getPk().getVehicle().getVehicleData(),
                    		new Integer(lastOdometer),
                    		odometer.getOdometer(),odometer.getAccidents(),
                    		odometer.getIncidents(),
                    		odometer.getPk().getFleet().getId(),odometer.getNearmiss()};
                    if(periods.containsKey(period)) {
                        Hashtable vehicles = (Hashtable)periods.get(period);
                        vehicles.put(odometer.getPk().getVehicle().getId(),data);
                    }else {
                        Hashtable vehicles = new Hashtable();
                        vehicles.put(odometer.getPk().getVehicle().getId(),data);
                        periods.put(period,vehicles);
                    }
                }
            }
        } catch(Exception e){
        	e.printStackTrace();
            Object[] parameters = {periodFrom,yearFrom,periodTo,yearTo,divOrgs,divGeos};
            handler.getException(e,"getReportIndividualAPMMByDivision",userSessionData,parameters);
        }
        return periods;
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Hashtable getReportIndividualMileage(String periodFrom,Integer yearFrom, String periodTo, Integer yearTo, String fleets, UserSessionData userSessionData) throws Exception {
        Hashtable periods = new Hashtable();
        try{            

        	
            Session session = HibernateUtil.currentSession();

            String query = "select odometer from Odometer odometer "+
            "where odometer.pk.fleet.corporation.id = "+String.valueOf(userSessionData.getFilter().getCorporationId());
            if(!Util.empty(fleets)) {
                query += " and odometer.pk.fleet.id in ("+fleets+") ";
            }
            if(periodFrom.equals("1") || periodFrom.equals("2")) {
                periodFrom = String.valueOf(10 + Integer.parseInt(periodFrom));
                yearFrom = new Integer(yearFrom.intValue() - 1);
            }else {
                periodFrom = String.valueOf(Integer.parseInt(periodFrom) - 2);
            }
            query += " and (odometer.pk.year = "+String.valueOf(yearFrom)+" AND odometer.pk.period >= "+periodFrom+" OR odometer.pk.year > "+String.valueOf(yearFrom)+")";
            query += " and (odometer.pk.year = "+String.valueOf(yearTo)+" AND odometer.pk.period <= "+periodTo+" OR odometer.pk.year < "+String.valueOf(yearTo)+")";
            query += " order by odometer.pk.vehicle.id,odometer.pk.year,odometer.pk.period";

            Query q = session.createQuery(query);
            Iterator it = q.list().iterator();
            while(it.hasNext()) {
                Odometer odometer = (Odometer)it.next();
                String period = String.valueOf(odometer.getPk().getPeriod())+"/"+String.valueOf(odometer.getPk().getYear());
                int lastOdometer = getLasOdometer(periods,odometer);
                Object[] data = {odometer.getPk().getVehicle().getVehicleData(),new Integer(lastOdometer),odometer.getOdometer(),odometer.getAccidents(),odometer.getIncidents(),odometer.getPk().getFleet().getId(),odometer.getNearmiss()};
                if(odometer.getOdometer().intValue() < lastOdometer) {
	                String s = new String(period +" " + odometer.getPk().getVehicle().getMatricula()+": "+odometer.getOdometer()+" - "+lastOdometer+"\n");
	        
                }
                if(periods.containsKey(period)) {
                    Hashtable vehicles = (Hashtable)periods.get(period);
                    vehicles.put(odometer.getPk().getVehicle().getId(),data);
                }else {
                    Hashtable vehicles = new Hashtable();
                    vehicles.put(odometer.getPk().getVehicle().getId(),data);
                    periods.put(period,vehicles);
                }
            }
        } catch(Exception e){
            Object[] parameters = {periodFrom,yearFrom,periodTo,yearTo,fleets};
            handler.getException(e,"getReportIndividualMileage",userSessionData,parameters);
        }
        return periods;
    }

    /**
     * 
     * @param periods
     * @param odometer
     * @return
     */
    private int getLasOdometer(Hashtable periods, Odometer odometer) {
        // String period = String.valueOf(odometer.getPk().getPeriod())+"/"+String.valueOf(odometer.getPk().getYear());
        String prePeriod1 = getPreviousPeriod(odometer.getPk().getPeriod(),odometer.getPk().getYear(),-1);
        String prePeriod2 = getPreviousPeriod(odometer.getPk().getPeriod(),odometer.getPk().getYear(),-2);
        int lastOdometer1 = -1;
        int lastOdometer2 = -1;
        if(periods.containsKey(prePeriod1)) {
            Hashtable vehicles = (Hashtable)periods.get(prePeriod1);
            if(vehicles.containsKey(odometer.getPk().getVehicle().getId())) {
                Object[] data = (Object[])vehicles.get(odometer.getPk().getVehicle().getId());
                lastOdometer1 = ((Integer)data[2]).intValue();
            }
        }
        if(periods.containsKey(prePeriod2)) {
            Hashtable vehicles = (Hashtable)periods.get(prePeriod2);
            if(vehicles.containsKey(odometer.getPk().getVehicle().getId())) {
                Object[] data = (Object[])vehicles.get(odometer.getPk().getVehicle().getId());
                lastOdometer2 = ((Integer)data[2]).intValue();
            }
        }
        
        if(lastOdometer1 <= 0) {
        	return (lastOdometer2 == -1)  ? lastOdometer1 : lastOdometer2;
        }else {
            return (lastOdometer1 > lastOdometer2)  ? lastOdometer1 : lastOdometer2;
        }
	}

	/**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public Collection getDriversMileage(String periodFrom,Integer yearFrom, String periodTo, Integer yearTo, String fleets, UserSessionData userSessionData) throws Exception {
        Collection drivers = new LinkedList();
        try{            

            Session session = HibernateUtil.currentSession();

            String query = "SELECT d.firstname,d.lastname,d.divorg1,d.divorg2,d.divorg3,d.country,o.year,o.period " +
            	"FROM odometers o JOIN genericfleets gf ON gf.id = o.fleet " +
            	"JOIN vehicles v ON o.vehicle = v.id " +
            	"JOIN drivers d ON d.id = v.driver " +
            	"WHERE gf.corporation = "+String.valueOf(userSessionData.getFilter().getCorporationId());
            if(!Util.empty(fleets)) {
                query += " AND o.fleet IN ("+fleets+") ";
            }
            if(periodFrom.equals("1")) {
                periodFrom = "12";
                yearFrom = new Integer(yearFrom.intValue() - 1);
            }else {
                periodFrom = String.valueOf(Integer.parseInt(periodFrom) - 1);
            }
            query += " AND (o.year = "+String.valueOf(yearFrom)+" AND o.period >= "+periodFrom+" OR o.year > "+String.valueOf(yearFrom)+")";
            query += " AND (o.year = "+String.valueOf(yearTo)+" AND o.period <= "+periodTo+" OR o.year < "+String.valueOf(yearTo)+")";
            query += " ORDER BY o.year,o.period";

            SQLQuery q = session.createSQLQuery(query);
            q.addScalar("firstname", Hibernate.STRING);
            q.addScalar("lastname", Hibernate.STRING);
            q.addScalar("divorg1", Hibernate.INTEGER);
            q.addScalar("divorg2", Hibernate.INTEGER);
            q.addScalar("divorg3", Hibernate.INTEGER);
            q.addScalar("country", Hibernate.INTEGER);
            q.addScalar("year", Hibernate.INTEGER);
            q.addScalar("period", Hibernate.INTEGER);
            List list = q.list();
            if (list != null){
	            Iterator it = list.iterator();
	            while(it.hasNext()) {
	                Object[] data = (Object[])it.next();
	                drivers.add(data);
	            }
            }
        } catch(Exception e){
            Object[] parameters = {periodFrom,yearFrom,periodTo,yearTo,fleets};
            handler.getException(e,"getReportIndividualMileage",userSessionData,parameters);
        }
        return drivers;
    }

    /**
     * 
     * @param period
     * @param year
     * @param change
     * @return
     */
    private String getPreviousPeriod(Integer period, Integer year, int change) {
        if(String.valueOf(period).equals("1")) {
            period = new Integer(12);
            year = new Integer(year.intValue() + change);
        }else {
            period = new Integer(period.intValue() + change);
        }
        return String.valueOf(period)+"/"+String.valueOf(year);
    }

    /**
     * 
     * @param periodFrom
     * @param yearFrom
     * @param periodTo
     * @param yearTo
     * @param fleets
     * @param userSessionData
     * @return
     */
    private String createQuery(String periodFrom, String yearFrom, String periodTo, 
    		String yearTo, String fleets, UserSessionData userSessionData) {
        
        String[] ids = userSessionData.getFilter().getAllElements(0);
        String[] labels = userSessionData.getFilter().getAllElements(1);

        String query = "select sum(detail.vehicles),sum(detail.miles),sum(detail.accidents)," +
                "sum(detail.incidents),sum(detail.nearmiss),detail.pk.period,detail.pk.year";
        query += ",detail.pk.fleet.country.resourceKey";
        query += ",detail.pk.fleet.vehicleType.resourceBundleId ";
        for(int i = 0; i < ids.length; i++) {
            if(ids[i] != null) {
                query += ",detail.pk.fleet."+ids[i]+",detail.pk.fleet."+labels[i];
            }
        }
        query += " from FleetDivisionDetail detail "+
        "where detail.pk.fleet.fleet.corporation.id = "+String.valueOf(userSessionData.getFilter().getCorporationId());
        if(!Util.empty(fleets)) {
            query += " and detail.pk.fleet.fleet.id in ("+fleets+") ";
        }
        query += " and (detail.pk.year = "+String.valueOf(yearFrom)+" and detail.pk.period >= "+periodFrom+" OR detail.pk.year > "+String.valueOf(yearFrom)+")";
        query += " and (detail.pk.year = "+String.valueOf(yearTo)+" and detail.pk.period <= "+periodTo+" OR detail.pk.year < "+String.valueOf(yearTo)+")";
        query += " group by detail.pk.year,detail.pk.period";
        query += ",detail.pk.fleet.country.resourceKey";
        for(int i = 0; i < ids.length; i++) {
            if(ids[i] != null) {
                query += ",detail.pk.fleet."+ids[i]+",detail.pk.fleet."+labels[i];
            }
        }
        query += ",detail.pk.fleet.vehicleType.resourceBundleId ";

        System.out.println("DEBUG Query: "+query);
        return query;
    }

    private String createQueryTotal(String periodFrom, String yearFrom, String periodTo, String yearTo, String fleets, UserSessionData userSessionData) {
        
        String[] ids = userSessionData.getFilter().getAllElements(0);
        String[] labels = userSessionData.getFilter().getAllElements(1);

        String query = "select sum(detail.vehicles),sum(detail.miles),sum(detail.accidents)," +
                "sum(detail.incidents),sum(detail.nearmiss)";
        query += ",detail.pk.fleet.country.resourceKey,detail.pk.fleet.vehicleType.resourceBundleId ";
        for(int i = 0; i < ids.length; i++) {
            if(ids[i] != null) {
                query += ",detail.pk.fleet."+ids[i]+",detail.pk.fleet."+labels[i];
            }
        }
        query += " from FleetDivisionDetail detail "+
        "where detail.pk.fleet.fleet.corporation.id = "+String.valueOf(userSessionData.getFilter().getCorporationId());
        if(!Util.empty(fleets)) {
            query += " and detail.pk.fleet.fleet.id in ("+fleets+") ";
        }
        query += " and (detail.pk.year = "+String.valueOf(yearFrom)+" AND detail.pk.period >= "+periodFrom+" OR detail.pk.year > "+String.valueOf(yearFrom)+")";
        query += " and (detail.pk.year = "+String.valueOf(yearTo)+" AND detail.pk.period <= "+periodTo+" OR detail.pk.year < "+String.valueOf(yearTo)+")";
        query += " group by ";
        query += "detail.pk.fleet.country.resourceKey";
        for(int i = 0; i < ids.length; i++) {
            if(ids[i] != null) {
                query += ",detail.pk.fleet."+ids[i]+",detail.pk.fleet."+labels[i];
            }
        }
        query += ",detail.pk.fleet.vehicleType.resourceBundleId ";
        System.out.println("DEBUG Query: "+ query);
        return query;
    }

    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driverfleetinsertdata,fleetinsertdata"
     * @throws Exception
     */
    public Calendar getLastPeriod(Integer fleetId,UserSessionData userSessionData,int type) throws Exception {
        Calendar instance = Calendar.getInstance();
        try{            
            Session session = HibernateUtil.currentSession();
            String queryStr = null;
            if(type  == FleetData.COLECTIVE) {
                queryStr = "select detail.pk.period as period,detail.pk.year as year " +
                		"from FleetDivisionDetail as detail " +
                "where detail.pk.fleet.fleet.id = :fleet order by detail.pk.year desc,detail.pk.period desc";
            }else {
                queryStr = "select detail.pk.period as period,detail.pk.year as year " +
                		"from Odometer as detail " +
                "where detail.pk.fleet.id = :fleet order by detail.pk.year desc,detail.pk.period desc";
            }
            Query query = session.createQuery(queryStr);
            query.setParameter("fleet", fleetId);
            List list = query.list();
            if (list != null){
            	Iterator it = list.iterator();
	            if(it.hasNext()) {
	                Object[] data = (Object[])it.next();
	                if (data[0] != null){
	                	instance.set(Calendar.MONTH,((Integer)data[0]).intValue());
	                }
	                if (data[1] != null){
	                	instance.set(Calendar.YEAR,((Integer)data[1]).intValue());
	                }
	            }
            }
        } catch(Exception e){
        	Object[] parameters = {fleetId,type};
            handler.getException(e,"getLastPeriod",userSessionData,parameters);
        }
        return instance;
    }

