<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">


<hibernate-mapping package="persistence.log.corporation" >
    <class name="GeoLabelLog" table="geolabellog" >

       	<composite-id class="persistence.log.IdLogPK" name="pk" >
	        <key-property	name="id"	type="java.lang.Integer"	column="id"/>
	        <key-property	name="loginUser"	type="java.lang.String"	column="loginuser"/>
	        <key-property	name="date"	type="java.util.Date"	column="date"/>
       	</composite-id>

		<many-to-one name="corporation" not-null="true">
			<column name="corporationLevel2" /> 
			<column name="loginLevel2" /> 
			<column name="dateLevel2" />
		</many-to-one>

        <property column="resourcekey" name="resourceKey" type="java.lang.String" not-null="true" />
        <property column="level" name="level" type="java.lang.Integer" not-null="true" />
        
    </class>
</hibernate-mapping>
