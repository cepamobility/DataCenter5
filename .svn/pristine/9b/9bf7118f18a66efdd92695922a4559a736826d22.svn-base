	 * @ejb.interface-method	 
	 * @param userRequest
	 * @param firstName
	 * @param lastName
	 * @param birthday
	 * 
	 * Devuelve true si existe un driver con ese nombre, apellido y fecha de nacimiento.
	 * 
	 * @return
	 * @throws Exception
	 */
	public boolean existDriver(UserSessionData userSessionData,String firstName, 
			String lastName, Date birthday) throws Exception {
       
		MemoryLog.getInstance().log(MemoryLog.START,"existDriver",getClass());
        boolean data = false;
		
        try{
			
        	DriverReportHome home = DriverReportUtil.getHome();
		 	DriverReport driverReport = home.create();  
            data = driverReport.existDriver(userSessionData,firstName,lastName,birthday);
		
        }catch (Exception e) {
			Object[] parameters = new Object[3];
        	parameters[0] = firstName;
        	parameters[1] = lastName;
        	parameters[2] = birthday;
    	 	handler.handleException("existDriver",e,userSessionData,parameters);
     	}
        MemoryLog.getInstance().log(MemoryLog.END,"existDriver",getClass());
        return data;
	}
	
