    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,query"
     */
    public ListResult getCombinedHistory(Hashtable parameters, int first, int count, UserSessionData userSessionData) throws Exception {
        
    	MemoryLog.getInstance().log(MemoryLog.START,"getCombinedHistory",getClass());
        ListResult data = null;
        
        try{
            
        	DriverReportHome home = DriverReportUtil.getHome();
            DriverReport driverReport = home.create();  
            data = driverReport.getCombinedHistory(parameters,first,count,userSessionData);        
       
        }catch (Exception e) {
        	Object[] p = new Object[parameters.size()];
        	Enumeration pEnum = parameters.elements();
        	int i = 0;
        	while(pEnum.hasMoreElements()) {
            	p[i] = pEnum.nextElement();
            	i++;
        	}
            handler.handleException("getCombinedHistory",e,userSessionData,p);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"getCombinedHistory",getClass());
        return data;
    }
    
    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,doorcontrol"
     */
    public String[][] verifyAccess(Integer driver,Text messages,UserSessionData userSessionData) throws Exception {
    	Collection list = new LinkedList();
        int access = DriverData.AVAILABLE;
    	try {
            DriverReport driverReport = DriverReportUtil.getHome().create();  
    		DriverData driverData = driverReport.findDriverByPrimaryKey(driver, userSessionData);
            ContratistDataType contratistType = driverReport.getDriverType(driver, userSessionData);
            Object[] errors = new Object[6];
    		if(driverData.getExclusionDate() != null) {
    			list.add(messages.getText("doorcontrol.invalid.excludeddriver"));
    			access = DriverData.UNAVAILABLE;
    			errors[0] = driverData.getExclusionDate();
    		}else {
	            ActivityReport activityReport = ActivityReportUtil.getHome().create();
	            int type = DriverData.TYPE_D;
	            if(contratistType != null) {
	            	type = contratistType.getType();
	            }
	            switch(type) {
		        	case DriverData.TYPE_A:
		        		Calendar today = Calendar.getInstance();
		        		if(driverData.getLicenseExpiry() == null) {
		        			list.add(messages.getText("doorcontrol.invalid.missinglicenseexpiry"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[1] = new Integer(1);
		        		}else if(isExpiry(today,driverData.getLicenseExpiry())) {
		        			list.add(messages.getText("doorcontrol.invalid.licenseexpiry"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[1] = driverData.getLicenseExpiry();
		        		}
		        		if(driverData.getHealthExpiry() == null) {
		        			list.add(messages.getText("doorcontrol.invalid.missinghealthexpiry"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[2] = new Integer(1);
		        		}else if(isExpiry(today,driverData.getHealthExpiry())) {
		        			list.add(messages.getText("doorcontrol.invalid.healthexpiry"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[2] = driverData.getHealthExpiry();
		        		}
		        		AptitudTestData lastAptitudTest = driverReport.findLastAptitudTest(driver,userSessionData);
		        		if(lastAptitudTest == null) {
		        			list.add(messages.getText("doorcontrol.invalid.missingaptitudtest"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[3] = new Integer(1);
		        		}else if(isExpiry(today,lastAptitudTest.getExpiry())) {
		        			
		        			if(isExpiryNextMonth(today, lastAptitudTest.getExpiry())) {
		        				list.add(messages.getText("doorcontrol.invalid.expiredaptitudtest"));
		        				access = DriverData.UNAVAILABLE;
		        				errors[3] = lastAptitudTest.getExpiry();
		        			}else {
		        				list.add(messages.getText("doorcontrol.warning.expiredaptitudtest")+" "+getDifference(today, lastAptitudTest.getExpiry())+" "+messages.getText("generic.messages.days"));
		        			}
		        		}else if(!lastAptitudTest.isApt()) {
		        			list.add(messages.getText("doorcontrol.invalid.aptitudtest"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[3] = new Integer(2);
		        		}
		        		Date lastRadar = activityReport.findLastActivity(driver,CEPAActivityConstants.RADAR,userSessionData);
		        		if(lastRadar == null) {
		        			list.add(messages.getText("doorcontrol.invalid.missingradar"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[4] = new Integer(1);
		        		}
		        		Date lastInduction = activityReport.findLastActivity(driver,CEPAActivityConstants.INDUCTION_TRAINING,userSessionData);
		        		if(lastInduction == null) {
		        			list.add(messages.getText("doorcontrol.invalid.missinginduction"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[5] = new Integer(1);
		        		}
		        		break;
		        	case DriverData.TYPE_B:
		        		today = Calendar.getInstance();
		        		if(driverData.getLicenseExpiry() == null) {
		        			list.add(messages.getText("doorcontrol.invalid.missinglicenseexpiry"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[1] = new Integer(1);
		        		}else if(isExpiry(today,driverData.getLicenseExpiry())) {
		        			list.add(messages.getText("doorcontrol.invalid.licenseexpiry"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[1] = driverData.getLicenseExpiry();
		        		}
		        		if(driverData.getHealthExpiry() == null) {
		        			list.add(messages.getText("doorcontrol.invalid.missinghealthexpiry"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[2] = new Integer(1);
		        		}else if(isExpiry(today,driverData.getHealthExpiry())) {
		        			list.add(messages.getText("doorcontrol.invalid.healthexpiry"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[2] = driverData.getHealthExpiry();
		        		}
		        		lastRadar = activityReport.findLastActivity(driver,CEPAActivityConstants.RADAR,userSessionData);
		        		if(lastRadar == null) {
		        			list.add(messages.getText("doorcontrol.invalid.missingradar"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[4] = new Integer(1);
		        		}
		        		lastInduction = activityReport.findLastActivity(driver,CEPAActivityConstants.INDUCTION_TRAINING,userSessionData);
		        		if(lastInduction == null) {
		        			list.add(messages.getText("doorcontrol.invalid.missinginduction"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[5] = new Integer(1);
		        		}
		        		break;
		        	case DriverData.TYPE_C:
		        		today = Calendar.getInstance();
		        		today.add(Calendar.YEAR, -1);
		        		lastInduction = activityReport.findLastActivity(driver,CEPAActivityConstants.INDUCTION_TRAINING,userSessionData);
		        		if(lastInduction == null) {
		        			list.add(messages.getText("doorcontrol.invalid.missinginduction"));
		        			access = DriverData.UNAVAILABLE;
		        			errors[5] = new Integer(1);
		        		}
		        		break;
	            }
    		}
    		DriverABMUtil.getHome().create().saveAccessLog(driverData.getId(),contratistType.getContratist(),errors,userSessionData);
    		if(list.size() > 0 && !empty(contratistType.getEmails())) {
    			sendDriverAccessEmail(driverData, errors, contratistType.getEmails());
    		}
    	} catch (Exception e) {
        	Object[] p = {driver};
            handler.handleException("verifyAccess",e,userSessionData,p);
		}
    	int length = (list.size() == 0) ? 1 : list.size();
    	String[][] result = new String[2][length];
    	result[0][0] = String.valueOf(access);
    	result[1] = (String[])list.toArray(new String[0]);
    	return result;
    }

	private int getDifference(Calendar start, Date date) {
		Calendar calendar = Calendar.getInstance();
		calendar.setTime(date);
		calendar.add(Calendar.MONTH, 1);
		int result = calendar.get(Calendar.DAY_OF_YEAR) - start.get(Calendar.DAY_OF_YEAR);
		if(result < 0) {
			return 365 + result;
		}else {
			return result;
		}
	}

	private boolean isExpiry(Calendar start,Date date) {
		Calendar calendar = Calendar.getInstance();
		calendar.setTime(date);
		return start.after(calendar);
	}
	
	private boolean isExpiryNextMonth(Calendar start,Date date) {
		Calendar calendar = Calendar.getInstance();
		calendar.setTime(date);
		calendar.add(Calendar.MONTH, 1);
		return start.after(calendar);
	}

