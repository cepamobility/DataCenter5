        	parameters[3] = divOrgs;
        	parameters[4] = divGeos;
        	parameters[5] = first;
        	parameters[6] = count;
        	                               
            handler.handleException("getHistoryDrivers",e,userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"getHistoryDrivers",getClass());
        return data;
    }

