    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,systemaccess,driverview,driversearch,cepascheduleactivityregistrycreate,cepascheduleactivityregistryupdate"
     */
    public ListResult findDriverList(Hashtable parameters,UserSessionData userSessionData) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"findDriverList",getClass());
        ListResult returnListResult = new ListResult(new LinkedList(),0);
        try{
            if(!parameters.containsKey("attribute")) {
                throw new InvalidDataException("findDriverList","attrName = null");
            }
            DriverReportHome driverHome = DriverReportUtil.getHome();
            DriverReport driverReport = driverHome.create();
            int first = 0;
            int count = Integer.parseInt((String)parameters.get("pageSize"));
            if(((Boolean)parameters.get("all")).booleanValue()) {
                count=-1;
            }else{
                first=(Integer.parseInt((String)parameters.get("pageNum"))-1) * Integer.parseInt((String)parameters.get("pageSize"));
            }
            int temporal = (parameters.containsKey("temp")) ? Integer.parseInt((String)parameters.get("temp")) : 0;
             returnListResult = driverReport.findList((String)parameters.get("value"),(String)parameters.get("corporationid"),userSessionData, getAttribute((String)parameters.get("attribute"),userSessionData), first, count, Integer.parseInt((String)parameters.get("status")),temporal);
        } catch (Exception e) {
        	Object[] parameters2 = new Object[1];
        	parameters2[0] = parameters;
            handler.handleException("findDriverList",e, userSessionData, parameters2);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"findDriverList",getClass());
        return returnListResult;
    }

    private int getAttribute(String attrName,UserSessionData userSessionData) throws Exception{
	    try{
	    	if (attrName.equalsIgnoreCase("firstorlastNameorcorpid")){
	    		return DriverReportBean.FIRST_OR_LAST_NAME_OR_CORP_ID;
	    	}else
	        if (attrName.equalsIgnoreCase("firstorlastName")) {
	            return DriverReportBean.FIRST_OR_LAST_NAME;
	        } else if (attrName.equalsIgnoreCase("id")){
	        	return DriverReportBean.ID;
	        }
	        	
	    } catch(Exception e){
	    	Object[] parameters = new Object[1];
	    	parameters[0] = attrName;
	        handler.handleException("getAttribute",e,userSessionData, parameters);
	    }
		throw new InvalidDataException("business.driver.getAttribute","attrName != firstorlastName");
	}
	
