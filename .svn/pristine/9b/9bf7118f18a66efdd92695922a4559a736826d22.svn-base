    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "driverview,administrator"
     */
    public DriverReportData getReportDrivers(Hashtable parameters, Integer[][] divOrgs, 
    		Integer[][] divGeos, int first, int count,UserSessionData userSessionData) throws Exception{
        MemoryLog.getInstance().log(MemoryLog.START,"getReportDrivers",getClass());
        DriverReportData data = null;
        try{
            DriverReportHome home = DriverReportUtil.getHome();
            DriverReport driverReport = home.create();  
            parameters.put("type","simple");
            data = new DriverReportData(driverReport.getForestReportDrivers(parameters,divOrgs,divGeos,first,count,userSessionData));
            if(userSessionData.getFilter().getCorporationId() == CorporationData.CIMSA) {
            	// data.setPoints(driverReport.getDriverPoints(userSessionData));
            }
        }catch (Exception e) {
        	Object[] parameters2 = new Object[5];
        	parameters2[0] = parameters;
        	parameters2[1] = divOrgs;
        	parameters2[2] = divGeos;
        	parameters2[3] = first;
        	parameters2[4] = count;
            handler.handleException("getReportDrivers",e,userSessionData,parameters2);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"getReportDrivers",getClass());
        return data;
    }
    
