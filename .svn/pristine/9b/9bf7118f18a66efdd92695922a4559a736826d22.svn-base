	/**
	 * @ejb.interface-method
	 * @ejb.permission role-name = "administrator,query"
	 */
	public EcolabReportData getEcolabReportData(Integer month, Integer yearReport, Integer depto, Integer distrit, UserSessionData userSessionData) throws Exception {
		EcolabReportData reportData = new EcolabReportData(depto);
		try{
			Integer year = (month == 0) ? yearReport + 1 : yearReport;
			DriverReport driverReport = DriverReportUtil.getHome().create();
			
			Integer[][] divorgs = new Integer[2][1];
			if(depto == null)
				divorgs[0] = null;
			else
				divorgs[0][0] = depto;
			if(distrit == null)
				divorgs[1] = null;
			else
				divorgs[1][0] = distrit;
			Integer[][] divgeos = new Integer[1][1];
			divgeos[0][0] = CountryData.BRASIL_ID;
			reportData.setDrivers(driverReport.findDriversByDivisions(divorgs, new Integer[0], DriverData.ACTIVE, userSessionData));
			
			Calendar from = Calendar.getInstance();
			from.set(Calendar.YEAR,year);
			from.set(Calendar.MONTH,month-1);
			from.set(Calendar.DATE,1);

			Calendar to = Calendar.getInstance();
			if(month == 12) {
				to.set(Calendar.YEAR,year+1);				
				to.set(Calendar.MONTH,0);
			}else {
				to.set(Calendar.YEAR,year);
				to.set(Calendar.MONTH,month);
			}
			to.set(Calendar.DATE,1);

			reportData.setTelematicControls(driverReport.findTelematicControls(null, null, from.getTime(), to.getTime(), 0, DriverData.ACTIVE, divorgs, divgeos, userSessionData));
			
			FleetReport fleetReport = FleetReportUtil.getHome().create();
			reportData.setOdometers(fleetReport.getInsertedOdometers(year, depto, distrit, userSessionData),year.intValue());
			reportData.setVehiclesWO_Odometers(fleetReport.getVehicleWO_Odometers(year, depto, distrit, userSessionData));
			reportData.setInstaled(fleetReport.getEcolabInstalled(month,year,reportData.getInstaledList(month+1),userSessionData));
			
			EventReport eventReport = EventReportUtil.getHome().create();

			reportData.setFines(eventReport.getEcolabFines(year, depto, distrit, userSessionData),month);
			reportData.setEvitableAccidents(eventReport.getEcolabEvitableAccidents(year, depto, distrit, userSessionData),month);
			
			reportData.setDriverSpeeds(driverReport.getEcolabSpeeds(year,depto,distrit,userSessionData));
        } catch(Exception e){
            handler.handleException("getEcolabReportData",e,userSessionData,null);
        }
		return reportData;
	}

