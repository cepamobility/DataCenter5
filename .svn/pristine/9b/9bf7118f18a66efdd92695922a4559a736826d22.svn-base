	/**
	 * @throws Exception 
	 * @ejb.permission role-name ="administrator,driveredit,driverviewowndata"
	 * @ejb.interface-method 
	 */
	public void exporTelematicControlsSendMail(Date start, Date end,UserSessionData userSessionData,Text messages, OutputStream out) throws Exception{
		try{
            ArrayList<TelematicControlSendMailData>list= DriverReportUtil.getHome().create().findTelematicControlsSendMail(start, end, userSessionData);
            ArrayList<ArrayList<String>> page=new ArrayList<ArrayList<String>>();
	        ArrayList<String> header=new ArrayList<String>();
	        header.add("ID TELEMATIC CONTROL");
	        header.add("TC DATA");
	        header.add("TC TIPO");
	        header.add("NOME");
	        header.add("SOBRENOME");
	        header.add("PLACA");
	        header.add("USUARIO");
	        header.add("DATA ENVIO");
	        header.add("ASUNTO");
	        header.add("DESTINATARIOS");
	        header.add("MESAGEM");
	        page.add(header);
	        Iterator<TelematicControlSendMailData> iter=list.iterator();
	        while(iter.hasNext()){
	        	TelematicControlSendMailData tc=iter.next();
	        	 
	        	ArrayList<String> rowStr=new ArrayList<String>();
	        	
	        	rowStr.add(tc.getTelematicControlData().getId().toString());
	        	rowStr.add(Util.formatDateWithHour(tc.getDate()));
	        	rowStr.add(messages.getText(tc.getTelematicControlData().getStringType()));
	        	if(tc.getTelematicControlData().getDriver()!=null){
	        		rowStr.add(tc.getTelematicControlData().getDriver().getFirstName());
	        		rowStr.add(tc.getTelematicControlData().getDriver().getLastName());
	        	}else{
	        		rowStr.add("");
	        		rowStr.add("");
	        	}
	        	if(tc.getTelematicControlData().getVehicle()!=null){
	        		rowStr.add(tc.getTelematicControlData().getVehicle().getMatricula());
	        	}else{
	        		rowStr.add("");
	        	}
	        	rowStr.add(tc.getUserData().getFirstName()+" "+tc.getUserData().getLastName());
	        	rowStr.add(Util.formatDateWithHour(tc.getDate()));
	        	rowStr.add(tc.getSubject());
	        	rowStr.add(tc.getTo());
	        	rowStr.add(tc.getBody());
	        	page.add(rowStr);
	        }
	        
	        ExcelGenerator.generatorXLS(page, "TelematicControlsSendMail", out);
            
        } catch(Exception e){
            handler.handleException("findTelematicControlsSendMail",e,userSessionData,null);
        }
        
	}
	

