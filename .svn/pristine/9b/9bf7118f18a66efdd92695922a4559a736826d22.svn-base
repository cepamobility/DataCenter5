    /**
     * @ejb.interface-method
     * @ejb.permission role-name = "administrator,driveredit,eventcreate,finecreate,driverupdate,drivertests,cepascheduleactivityregistrycreate,query"
     */
    public DriverMainAttributes findDriverForestalData(Integer id, int divorg, UserSessionData userSessionData) throws Exception{
        MemoryLog.getInstance().log(MemoryLog.START,"findDriverForestalData",getClass());
        DriverMainAttributes data=null;
        try{
            if (id == null) {
                throw new InvalidDataException("findDriverForestalData","id = null");
            }
            DriverReportHome home = DriverReportUtil.getHome();
            DriverReport driverReport = home.create();
            data=driverReport.findDriverForestalData(id,divorg,userSessionData);
        } catch(Exception e){
        	Object[] parameters = new Object[1];
        	parameters[0] = id;
            handler.handleException("findDriverForestalData",e,userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"findDriverForestalData",getClass());
        return data;
    }
    
