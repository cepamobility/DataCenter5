	/**
	 * @ejb.interface-method
     * @ejb.permission role-name = "administrator,systemaccess,driverview,driversearch,cepascheduleactivityregistrycreate,cepascheduleactivityregistryupdate"
	 */
	public ListResult findDriverList(String attrName, String attrValue,int first, 
			int count, int status,UserSessionData userSessionData) throws Exception {
        MemoryLog.getInstance().log(MemoryLog.START,"findDriverList",getClass());
        ListResult returnListResult = new ListResult(new LinkedList(),0);
        try{
	        if (attrName == null) {
	            throw new InvalidDataException("findDriverList","attrName = null");
	        }
	        DriverReportHome driverHome = DriverReportUtil.getHome();
	        DriverReport driverReport = driverHome.create();
	        returnListResult = driverReport.findList(attrValue,null,userSessionData, getAttribute(attrName,userSessionData), first, count, status, 0);
        } catch (Exception e) {
        	Object[] parameters = new Object[5];
        	parameters[0] = attrName;
        	parameters[1] = attrValue;
        	parameters[2] = first;
        	parameters[3] = count;
        	parameters[4] = status;       	
        	
            handler.handleException("findDriverList",e, userSessionData, parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"findDriverList",getClass());
        return returnListResult;
	}

