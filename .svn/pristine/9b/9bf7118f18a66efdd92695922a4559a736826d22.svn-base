	/**
	 * @throws Exception
	 * @ejb.interface-method
	 * @ejb.permission role-name = "driverview,administrator"
	 */
	public ListResult getTelematicControlQuery(Integer fromday, Integer frommonth,
			Integer fromYear, Integer today, Integer tomonth, Integer toYear,
			Integer[][] divOrgs, Integer[][] divGeos, String firstname,
			String lastname, String idDallas, Integer type, Integer recomendation,			
			String status, int first, int count,String colorOrType, String reportType,String color,
			UserSessionData userSessionData) throws Exception {		

    	MemoryLog.getInstance().log(MemoryLog.START,"getTelematicControlQuery",getClass());
        ListResult result = null;
        
        try{
        	
            DriverReportHome home = DriverReportUtil.getHome();
            DriverReport driverReport = home.create();
            if (colorOrType.equalsIgnoreCase("color") ){
            	// Filtro por Color 
            	result = driverReport.getTelematicControlQueryByColor(fromday,frommonth,fromYear,
                		today,tomonth,toYear,divOrgs,divGeos,firstname,lastname,idDallas, 
                		status,first, count, color, userSessionData);
            
            }else{
            	// Filtro por tipo de eventos
            	result = driverReport.getTelematicControlQuery(fromday,frommonth,fromYear,
            		today,tomonth,toYear,divOrgs,divGeos,firstname,lastname,idDallas, type,
            		recomendation,status,first, count, userSessionData);
            }
            
        }catch (Exception e) {
        	Object[] parameters = { fromday,frommonth, fromYear,today, tomonth, toYear,
					divOrgs, divGeos, firstname, lastname, type, recomendation, status, first, count };
            handler.handleException("getTelematicControlQuery",e,userSessionData,parameters);
        }
        MemoryLog.getInstance().log(MemoryLog.END,"getTelematicControlQuery",getClass());
        return result;
        
	}
    
