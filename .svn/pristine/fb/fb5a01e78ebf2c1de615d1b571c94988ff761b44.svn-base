	                	it = list.iterator();
	                	if (it != null){
	                		while(it.hasNext()) {
	                			result.add(new BrasilStateDataType((String) it.next()));
	                		}
	                	}
	                }
	                return result;
                case DataTypeConstants.DPA_UNCONFORMITY_TYPE:
                	query = session.createSQLQuery("SELECT resourcebundleid FROM datatypedpaunconformitytype ").
                	addScalar("resourcebundleid",Hibernate.STRING);
	                list = query.list();
	                if (list != null){
	                	it = list.iterator();
	                	if (it != null){
	                		while(it.hasNext()) {
	                			result.add(new UnconformityTypeDPADataType((String) it.next()));
	                		}
	                	}
	                }
	                return result;   
                case DataTypeConstants.DPA_UNCONFORMITY_ITEM_TYPE:
                	query = session.createSQLQuery("SELECT resourcebundleid FROM datatypedpaunconformityitemtype ").
                	addScalar("resourcebundleid",Hibernate.STRING);
	                list = query.list();
	                if (list != null){
	                	it = list.iterator();
	                	if (it != null){
	                		while(it.hasNext()) {
	                			result.add(new UnconformityItemTypeDPADataType((String) it.next()));
	                		}
	                	}
	                }
	                return result;      
			}

			List dtColl = query.list();
			Iterator iter = dtColl.iterator();

			while (iter.hasNext()) {
                if(attribute == DataTypeConstants.ACCIDENT_CLASIFICATION) {
                    Object[] data = (Object[]) iter.next();
                    AccidentClasificationDataType datatype = (AccidentClasificationDataType)((GeneralDataType)data[0]).getData();
                    if (data[1] !=null)
                    	datatype.setActive(((Boolean) data[1]).booleanValue());
                    result.add(datatype);
                }else {
    				GeneralDataType dataType = (GeneralDataType) iter.next();
    				result.add(dataType.getData());
                }
			}

			session.close();

		} catch (Exception e) {
			Object[] parameters = {attribute};
			e.printStackTrace();
            handler.getException(e,"findAll",userSessionData,parameters);
		} 

		return result;

	}

    /**
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "systemaccess,administrator,resetpassword"
     */      
    public Collection findAllCEPA(UserSessionData userRequest, int attribute) throws Exception {
        
        if (userRequest == null) {
            throw new DeslogedException("findAllCEPA","userRequest = null");
        }
        List result = new LinkedList();

        Session session = null;

        try {
            session = HibernateUtil.currentSession();
            
            Transaction tx = session.beginTransaction();
            int corporation = (userRequest.isCorporation(CorporationData.MONTES_DE_PLATA)) ? CorporationData.MONTES_DE_PLATA * -1 : CorporationData.SUPERVISION; 

            Query query = null;
            switch(attribute) {
                case DataTypeConstants.ACCIDENT_CLASIFICATION:
                    query = session.createQuery("select accident from persistence.datatype.tables.AccidentClasification accident,persistence.datatype.tables.AccidentClasificationByCorporation accidentbycorporation where accident.resourceBundleId=accidentbycorporation.resourceBundleId and accidentbycorporation.corporationId =" + corporation);
                    break;                      
                case DataTypeConstants.INCIDENT_CLASIFICATION:
                    query = session.createQuery("select incident from persistence.datatype.tables.IncidentClasification incident, persistence.datatype.tables.IncidentClasificationByCorporation incidentbycorporation where incident.resourceBundleId=incidentbycorporation.resourceBundleId and incidentbycorporation.corporationId =" + corporation);
                    break;
                case DataTypeConstants.COLLISION_CLASIFICATION:
                    query = session.createQuery("select collision from persistence.datatype.tables.CollisionClasification collision,persistence.datatype.tables.CollisionClasificationByCorporation collisionbycorporation where collision.resourceBundleId=collisionbycorporation.resourceBundleId and collisionbycorporation.corporationId =" + corporation);
                    break; 
                case DataTypeConstants.FINE_QUALIFY:
               	 	query = session.createQuery("select fine from persistence.datatype.tables.FineQualify qualify, persistence.datatype.tables.FineQualifyByCorporation finebycorporation where fine.resourceBundleId=finebycorporation.resourceBundleId and finebycorporation.corporationId =" + CorporationData.MONSANTO);
                    break;
            }

            List dtColl = query.list();
            Iterator iter = dtColl.iterator();

            while (iter.hasNext()) {
                GeneralDataType dataType = (GeneralDataType) iter.next();
                result.add(dataType.getData());
            }

            tx.commit();
            session.close();

        } catch (Exception e) {
			Object[] parameters = {attribute};
            handler.getException(e,"findAllCEPA",userRequest,parameters);
        } 

        return result;
    }
    
    
    /**
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "systemaccess,administrator"
     */      
    public Collection findAllClasificationLevel(UserSessionData userRequest, int attribute, String parent) throws Exception {
        
        if (userRequest == null) {
            throw new DeslogedException("findAllClasificationLevel","userRequest = null");
        }
        List result = new LinkedList();

        Session session = null;

        try {
            session = HibernateUtil.currentSession();
            
            Transaction tx = session.beginTransaction();
           
            Query query = null;
            switch(attribute) {
                case DataTypeConstants.ACCIDENT_CLASIFICATION_LEVEL1:
                    //query = session.createQuery("select accident from persistence.datatype.tables.AccidentClasificationLevel1 accident,persistence.datatype.tables.AccidentClasificationByCorporation accidentbycorporation where accident.resourceBundleId=accidentbycorporation.resourceBundleId and accidentbycorporation.corporationId =" + corporation);
                	String prefix = (parent == null) ? "general" : parent;
                	query = session.createQuery("select accident from persistence.datatype.tables.AccidentClasificationLevel1 accident WHERE accident.resourceBundleId LIKE '"+prefix+"%'");
                    break;                      
                case DataTypeConstants.ACCIDENT_CLASIFICATION_LEVEL2:
                	 //query = session.createQuery("select accident from persistence.datatype.tables.AccidentClasificationLevel1 accident,persistence.datatype.tables.AccidentClasificationByCorporation accidentbycorporation where accident.resourceBundleId=accidentbycorporation.resourceBundleId and accidentbycorporation.corporationId =" + corporation);
                	query = session.createQuery("select accident from persistence.datatype.tables.AccidentClasificationLevel2 accident where accident.parent='"+parent+"'");
                    break;
                case  DataTypeConstants.ACCIDENT_CLASIFICATION_LEVEL3:
                	//query = session.createQuery("select accident from persistence.datatype.tables.AccidentClasificationLevel1 accident,persistence.datatype.tables.AccidentClasificationByCorporation accidentbycorporation where accident.resourceBundleId=accidentbycorporation.resourceBundleId and accidentbycorporation.corporationId =" + corporation);
            		query = session.createQuery("select accident from persistence.datatype.tables.AccidentClasificationLevel3 accident where accident.parent='"+parent+"'");
                    break; 
                case DataTypeConstants.ACCIDENT_CLASIFICATION_LEVEL4:
                	//query = session.createQuery("select accident from persistence.datatype.tables.AccidentClasificationLevel1 accident,persistence.datatype.tables.AccidentClasificationByCorporation accidentbycorporation where accident.resourceBundleId=accidentbycorporation.resourceBundleId and accidentbycorporation.corporationId =" + corporation);
            		query = session.createQuery("select accident from persistence.datatype.tables.AccidentClasificationLevel4 accident where accident.parent='"+parent+"' ORDER BY resourceBundleId");
                    break;
            }

            List dtColl = query.list();
            Iterator iter = dtColl.iterator();

            while (iter.hasNext()) {
                GeneralDataType dataType = (GeneralDataType) iter.next();
                if(dataType.getResourceBundleId().equals("general.eventdata.accidentclasification3") && userRequest.isCorporation(CorporationData.MONSANTO))
                	result.add(dataType.getData());
                else if(!dataType.getResourceBundleId().equals("general.eventdata.accidentclasification3")){
                	result.add(dataType.getData());
                }
            }

            tx.commit();
            session.close();

        } catch (Exception e) {
			Object[] parameters = {attribute};
            handler.getException(e,"findAllClasificationLevel",userRequest,parameters);
        } 

        return result;
    }
    
    
    /**
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "systemaccess,administrator,resetpassword"
     */      
    public Collection getActivityWithExpiry(UserSessionData userSessionData,Integer[][] divOrgs,Integer[] divGeos,Date from, Date to,int status,String firstName,String lastName,String vehicleAllowed) throws Exception {
    	try {
    		Session session = HibernateUtil.currentSession();
            String select = "select distinct ";
            switch(userSessionData.getCorporationId()) {
            	case CorporationData.MONSANTO:
            		select += "CASE WHEN ca.type IN ('datatype.scheduledactivitytype.btw1','datatype.scheduledactivitytype.btw2','datatype.scheduledactivitytype.btw2-4x4','datatype.scheduledactivitytype.btw2onboard','datatype.scheduledactivitytype.btw2onboard2','datatype.scheduledactivitytype.btw2spv','datatype.scheduledactivitytype.btwutilitarioreboque','datatype.scheduledactivitytype.outtraininglivianos','datatype.scheduledactivitytype.outtrainingpesados','tablet.form.btw1.livianos','tablet.form.btw2.livianos','tablet.form.btw2onboard') THEN 'datatype.scheduledactivitytype.btw1' " +
                				"WHEN ca.type IN ('tablet.form.toj','tablet.form.specialdayoftraining','tablet.form.phrd','datatype.scheduledactivitytype.trainingonthejob','datatype.scheduledactivitytype.specialdayoftraining','datatype.scheduledactivitytype.hrd') THEN 'datatype.scheduledactivitytype.trainingonthejob' " +
                				"WHEN ca.type IN ('datatype.scheduledactivitytype.btw3','datatype.scheduledactivitytype.btw3update') THEN 'datatype.scheduledactivitytype.btw3' " +
                				"ELSE ca.type " +
                				"END as type ";
    	        	break;
            	case CorporationData.JJ:
            		select += "CASE WHEN ca.type IN ('tablet.form.btw1onboard','tablet.form.btw1.livianos','datatype.scheduledactivitytype.btwonboard2','datatype.scheduledactivitytype.btw1') THEN 'datatype.scheduledactivitytype.btw1' "+
            				"WHEN ca.type IN ('tablet.form.btw2onboard','datatype.scheduledactivitytype.btw2onboard2','tablet.form.btw2.livianos','datatype.scheduledactivitytype.btw2') THEN 'datatype.scheduledactivitytype.btw2' " +
            				"WHEN ca.type IN ('datatype.scheduledactivitytype.trainingonthejob','tablet.form.toj') THEN 'datatype.scheduledactivitytype.trainingonthejob' " +
            				"WHEN ca.type IN ('datatype.scheduledactivitytype.evaluacionencabina','tablet.form.evaluacionencabina') THEN 'datatype.scheduledactivitytype.evaluacionencabina' " +
            				"WHEN ca.type IN ('tablet.form.phrd','datatype.scheduledactivitytype.hrd') THEN 'datatype.scheduledactivitytype.hrd' " +
            				"ELSE ca.type " +
            				"END as type ";
            		break;
               /* case CorporationData.BAYER: case CorporationData.COVESTRO:
                	select += "CASE WHEN ca.type IN ('datatype.scheduledactivitytype.btw1','datatype.scheduledactivitytype.btw2','datatype.scheduledactivitytype.btw2onboard','datatype.scheduledactivitytype.btw2onboard2','datatype.scheduledactivitytype.btwonboard2', 'datatype.scheduledactivitytype.btwutilitarioreboque','tablet.form.btw1.livianos','tablet.form.btw1onboard','tablet.form.btw2.livianos','tablet.form.btw2onboard' ) THEN 'datatype.scheduledactivitytype.btw1' " +
                				"ELSE ca.type " +
                				"END as type ";
    	        	break;*/
                default:
                	select += "ca.type as type ";
            }
            select += " from cepaactivity ca,activityregistry ar,drivers d,cepaactivitydefinition ad ";

            //restricciones de permisos
            select += UtilityQuery.filterDivs(divOrgs,divGeos,"d",userSessionData);
                
                //joins
            select += " AND ca.activityid = ar.activity "+
                   		"AND d.id = ar.driver "+
                   		"AND ca.activityid = ar.activity and ad.resourcekeyname = ca.type " +
                   		"AND ad.timeexpiry > 0";

                
            if(!Util.empty(firstName)) {
            	select += " AND lower(d.firstname) like '%"+firstName.toLowerCase()+"%' ";
            }
            if(!Util.empty(lastName)) {
            	select += " AND lower(d.lastname) like '%"+lastName.toLowerCase()+"%' ";
            }
            switch (status) {
            	case DriverData.ACTIVE:
            	   select += " AND d.exclusionDate is null ";
                   break;
            	case DriverData.EXCLUDED:
            	   select += " AND d.exclusionDate is not null ";
                   break;
            }
            if(!Util.empty(vehicleAllowed) && !vehicleAllowed.equals("datatype.vehicletype.all")) {
            	select += " AND d.vehicleallowed = '"+vehicleAllowed+"' ";
            }

            if(from != null) {
            	select += " AND ca.dateexpiry >= "+Util.formatSQL(from, 0);
            }

            if(to != null) {
            	select += " AND ca.dateexpiry < "+Util.formatSQL(to, 1);
            }
                
                //solo actividades dictadas
            select += " and ca.state = 'datatype.scheduledactivitystate.dictada'";
    			
            SQLQuery query = session.createSQLQuery(select).addScalar("type",Hibernate.STRING);
			return query.list();
        } catch (Exception e) {
			Object[] parameters = {};
            handler.getException(e,"getActivityWithExpiry",userSessionData,parameters);
        } 

        return new LinkedList();
    }

    /**
     * @throws DeslogedException
     * @throws CommunicationProblemException
     * @ejb.interface-method
     * @ejb.permission role-name = "systemaccess,administrator,resetpassword"
     */      
    public String[] getAvailableAddress(Integer corporation, UserSessionData userSessionData) throws Exception {
    	String[] address = new String[2];
    	try {
    		Session session = HibernateUtil.currentSession();
    		Calendar today = Calendar.getInstance();
    		String sql = "";
    		
    		if (corporation != null && corporation.intValue() == CorporationData.BAYER){
	    	  
    			String mailUsed = AlertConstants.BAYER_ALERT_EMAILS[(new Double(Math.random()*19)).intValue()];
    			address[0] = mailUsed;
    			address[1] =  AlertConstants.BAYER_ALERT_EMAILS_PASSWORD;// password
    			return address;
	    	  
    		}else {
    			sql = "SELECT email FROM EmailAddress email WHERE address LIKE '%@cepalogistica%' ORDER BY date, sended";
	      
    			Query q = session.createQuery(sql);
    			Iterator it = q.list().iterator();
    			
    			boolean found = false;
    			while(it.hasNext() && !found) {
    				EmailAddress emailAddress = (EmailAddress) it.next(); 
    				Calendar last = Calendar.getInstance();
    				last.setTime(emailAddress.getDate());
		      
					address[0] = emailAddress.getAddress();
					address[1] = emailAddress.getPassword();
    				if(last.get(Calendar.DATE) != today.get(Calendar.DATE) || last.get(Calendar.MONTH) != today.get(Calendar.MONTH) || last.get(Calendar.YEAR) != today.get(Calendar.YEAR)) {
    					
    					emailAddress.setDate(today.getTime());
    					emailAddress.setSended(new Integer(1));
    					session.update(emailAddress);
    					return address;
    				}else {
    					int sended = emailAddress.getSended();
    					if(sended < 100) {
    						emailAddress.setSended(new Integer(sended+1));
        					session.update(emailAddress);
        					return address;
    					}
    				}
    			}	
    		}
        } catch (Exception e) {
			Object[] parameters = {};
            handler.getException(e,"getActivityWithExpiry",userSessionData,parameters);
        } 
    	return null;
    }
}
