<%@page language="java" 
	errorPage="../exception.jsp" 
	import="business.*"
	import="business.activity.*"
	import="business.administration.user.*"
	import="communication.language.*"
	import="communication.security.*"
	import="communication.administration.user.tables.*"
	import="communication.vehicle.tables.*"
	import="communication.util.*"
 	import="presentation.translator.web.util.*"
 	import="presentation.translator.web.activity.schedule.*" 	
 	import="presentation.translator.web.vehicle.*"
 	import="communication.administration.user.*" 	
 	import="communication.datatype.tables.ActivityTypeDataType"
	import="business.vehicle.VehicleReportFacade"
	import="java.util.*"	
	import ="org.apache.struts.action.DynaActionForm"
	import ="communication.activity.tables.*"
%>

<%@ taglib uri="/WEB-INF/struts-html.tld"
        prefix="html"
%>
<html:html>
<%!
	Text messages; SystemAccess sys;
	UserSessionData userSessionData; 
	VehicleData  vehicle;
%>
<%
	sys = (SystemAccess)session.getAttribute("SystemAccess");
	userSessionData=sys.getUserSessionData();	
	
	String check = Util.checkPermission(sys,SecurityConstants.EDIT_VEHICLE);
	String check1 = Util.checkPermission(sys,SecurityConstants.MODIFY_VEHICLE);	
	String check2 = Util.checkPermission(sys,SecurityConstants.CHECKLIST_VEHICLE);	
	
	if ((check!=null) && (check1!=null) && (check2!=null))  {
		response.sendRedirect(request.getContextPath()+check);	
	}else {
		messages=sys.getText();
	
		String idCheck = request.getParameter("check");
		if(Util.empty(idCheck)) {
		    idCheck = String.valueOf(session.getAttribute("check"));
		}

		session.setAttribute("url","vehicle/VehiclePursuitRouteView.jsp?check="+idCheck);
		
		VehiclePursuitRouteData vehicleCheck = sys.getVehicleReportFacade().findVehiclePursuitRoute(new Integer(idCheck),userSessionData);
		session.setAttribute("id",String.valueOf(vehicleCheck.getVehicle().getId()));
%>	
<LINK REL=StyleSheet HREF="../util/css/estilo.css" TYPE="text/css">

<head>
	<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">
</head>

<script>
	function deleteIfConfirm(form,msg){
		if(confirm(msg)) {
			form.submit();
		}
	} 
</script>

<html:form action="/VehiclePursuitRouteListDelete">
	<html:hidden property="check" value='<%=idCheck%>'/>
</html:form>	

<form action='<%="layout.jsp?refer=/vehicle/VehiclePursuitRouteForm.jsp?type=edit&check="+vehicleCheck.getPursuitRouteId().toString()+"&id="+String.valueOf(vehicleCheck.getVehicle().getId())%>' name='edit' method="post">
</form>	

<body>
	<center>
	<table width="768" border="0" cellspacing="0" cellpadding="0">  
		<tr class="guide1">
			<jsp:include  page='<%="../component/titlecomponent.jsp?title="+messages.getText("generic.activity.form.seguimientoenruta.title")%>' />
  		</tr>
      	<tr>
			<jsp:include  page="../component/spaceline.jsp" />
  		</tr>
		<tr> 
			<td height="40" colspan="5" valign="middle">
				<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText("generic.activity.form.tranningonthejob.proofdata")%>' />
				<table width="100%" height="60" border="0" cellpadding="0" cellspacing="0">
   	 				<tr> 
       					<td width="50%" align="left" class="linetwo">        
   							<%= messages.getText("generic.activity.form.seguimientoenruta.corporation")%>
						</td>
						<td width="50%" align="right" class="linetwo">
							<%=vehicleCheck.getDivorg1()%>
						</td>
   					</tr>
			      	<tr>
						<jsp:include  page="../component/spaceline.jsp" />
			  		</tr>
     				<tr> 
        				<td width="50%" align="left" class="linetwo">        
       						<%= messages.getText("generic.activity.date")%><%=" ( "+messages.getText("generic.messages.dateformat")+" ) "%>
						</td>
						<td width="50%" align="right" class="linetwo">		
							<%=Util.formatDate(vehicleCheck.getDate())%>
        				</td>
     				</tr>
			      	<tr>
						<jsp:include  page="../component/spaceline.jsp" />
			  		</tr>
     				<tr  class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
     				<tr> 
        				<td width="50%" align="left" class="linetwo">        
       						<%= messages.getText("generic.activity.form.seguimientoenruta.plate")%>
						</td>
						<td width="50%" align="right" class="linetwo">		
							<%=vehicleCheck.getVehicle().getMatricula()%>
        				</td>
     				</tr>
					<tr  class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
     				<tr class="linetwo"> 
        				<td width="50%" align="left">        
       						<%= messages.getText("generic.activity.form.seguimientoenruta.evaluationtime")+" (hh:mm)" %>
						</td>
						<td width="50%" align="right" class="linetwo">
							<%= vehicleCheck.getEvaluationTimeHour()%>:<%= vehicleCheck.getEvaluationTimeMinute()%>
						</td>
     				</tr>     
					<tr  class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>
     				<tr> 
        				<td width="50%" align="left" class="linetwo">        
       						<%= messages.getText("generic.activity.form.seguimientoenruta.instructor")%>
						</td>
						<td width="50%" align="right" class="linetwo">		
							<%= vehicleCheck.getInstructor() %>
        				</td>
     				</tr>
					<tr  class="space"><th align="right">&nbsp;</th><td align="right">&nbsp;</td></tr>     				
     				<tr> 
        				<td width="50%" align="left" class="linetwo">        
       						<%= messages.getText("generic.activity.form.seguimientoenruta.evaluationarea")%>
						</td>
						<td width="50%" align="right" class="linetwo">		
							<%= vehicleCheck.getArea() %>                                   
        				</td>
     				</tr>
				</table>
				<jsp:include  page="../component/utilityboxbottom.jsp" />
			</td>
		</tr>  
      	<tr>
			<jsp:include  page="../component/spaceline.jsp" />
  		</tr>
<%		CheckListData checkList = sys.getVehicleReportFacade().getCheckList(CheckListData.PURSUIT_ROUTE_CHECKLIST,sys.getUserSessionData());
		Iterator points = checkList.getSortPoints();
%>		<tr>
			<td valign="top">
				<table width="100%" height="60" border="0" cellpadding="0" cellspacing="0">
					<tr>
						<td width="100%" valign="top">
							<table width="100%" height="60" border="0" cellpadding="0" cellspacing="0">
<%				while (points.hasNext()) {
				    PointData point = (PointData)points.next();
%>								<tr>
									<td valign="top">
										<jsp:include  page='<%="../component/utilityboxtop.jsp?title="+messages.getText(point.getText())%>' />
										<table width="100%" height="60" border="0" cellpadding="0" cellspacing="0">
<%					Iterator items = point.getSortItems();
					while(items.hasNext()) {
						ItemData item = (ItemData)items.next();
%>											<tr class="linetwo">
												<td width="50%" align="left">
		   											<%=messages.getText(item.getText())%>
												</td>	
												<td width="50%" align="right">
													<%=(vehicleCheck.getValueFromItem(item.getId()).equals("1")) ? messages.getText("generic.activity.form.seguimientoenruta.yes") : messages.getText("generic.activity.form.seguimientoenruta.no")%>
												</td>
											</tr>
<%						if(items.hasNext()) {	
%>			      							<tr>
												<jsp:include  page="../component/spaceline.jsp" />
									  		</tr>
<%						}
					}
%>										</table>
										<jsp:include  page="../component/utilityboxbottom.jsp" />
									</td>	
								</tr>	
     							<tr>
									<jsp:include  page="../component/spaceline.jsp" />
						  		</tr>
<%					
				}
%>							</table>
						</td>
					</tr>
				</table>
			</td>
		</tr>	
	  	<tr>
			<jsp:include  page="../component/spaceline.jsp" />
  		</tr>
		<tr> 
			<td height="40" colspan="5" valign="middle">
				<jsp:include  page='<%="../component/utilitybox2top.jsp?title="+messages.getText("generic.activity.observations")%>' />
				<table width="100%" height="60" border="0" cellpadding="0" cellspacing="0">
		            <tr> 
              			<td class="lineone">
       						<%=vehicleCheck.getObs()%>
                		</td>
		            </tr>
		        </table>
				<jsp:include  page="../component/utilitybox2bottom.jsp" />
			</td>
		</tr>  
      	<tr>
			<jsp:include  page="../component/spaceline.jsp" />
  		</tr>
       	<tr>   		
	   		<td align="right">
	   			<a href='<%="layout.jsp?refer=/vehicle/VehicleView.jsp?id="+vehicleCheck.getVehicle().getId().toString()%>'>
		   			<input name="button" type="button" value='<%=messages.getText("generic.messages.accept")%>' class="input"/>	 		                             
				</a>	   			
	   			<input name="button" type="button" value='<%=messages.getText("generic.messages.edit")%>' class="input" onclick="javascript:document.forms['edit'].submit();"/>	 		                             
	   			<input name="button2" type="button" value='<%=messages.getText("generic.messages.delete")%>' onClick="deleteIfConfirm(document.forms['VehiclePursuitRouteListDeleteForm'],'<%=messages.getText("trailer.seguimientoenruta.delete.confirm")%>');" class="input"/>	 		                             		   			
           	</td>                 							
   	  	</tr>              
	</table>
	</center>
</body>
<%
	}	
%>	

</html:html>
