<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.log.tables" >
    <class name="Loggings" table="loggings">
		
		<id name="id" column="id" >
			<generator class="sequence">
				<param name="sequence">loggings_sequence</param>
	         </generator>
		</id>
    	
    	<property name="userID" column="userID" />
        <property name="log_date" column="log_date" />
        <property name="log_level" column="log_level" />
        <property name="location"  column="location" />
        <property name="message"   column="message" type="text" />
        
   </class>

</hibernate-mapping>