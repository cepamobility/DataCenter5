<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">


<hibernate-mapping package="persistence.administration.corporation.tables" >

	<class name="ContractorPoint" table="contractorpoints">
		<id column="id" name="id" type="java.lang.Integer">
            <generator class="sequence">
            	<param name="sequence">ContractorPoint_Sequence</param>
            </generator>
		</id>
	    <property name="contractor"	column="contractor" type="java.lang.Integer" not-null="true" />
	   	<property name="driver"		column="driver" 	type="java.lang.Integer" not-null="true" />
	   	<property name="move"		column="move" 		type="java.lang.Integer" not-null="true" />
   		<property name="date" 	type="java.sql.Date" column="date"	not-null="true"/>
	   	<property name="amount"	column="amount" type="java.lang.Double" not-null="true" />
  	</class>
</hibernate-mapping>
