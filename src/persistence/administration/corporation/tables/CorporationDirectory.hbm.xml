<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.administration.corporation.tables">
    
    <class name="CorporationDirectory" table="corporationdirectory">	 	
    
    	<id  name="corporationId" column="corpid" type="java.lang.Integer">
            <generator class="native">  </generator>
        </id>
        <property column="directory" name="directory" type="java.lang.String" />
        
    </class>
</hibernate-mapping>
