<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">


<hibernate-mapping package="persistence.administration.corporation.tables" >

<class table="corporations" name="Corporation">

	
	<id name="id" type="java.lang.Integer" column="id">
		<generator class="sequence">
			<param name="sequence">Corporation_Sequence</param>
		</generator>
	</id>
	
	<property name="name" type="java.lang.String" column="name" not-null="true"/>
	
	<property name="type" type="java.lang.Integer" column="type"/>
	
	
	<set name="DivOrgSet" cascade="all-delete-orphan" inverse="true">
		<key column="corporation" not-null="true"/>
		<one-to-many class="DivOrg"/>
	</set>
	
	
	<set name="GeoLabelSet" cascade="all-delete-orphan" inverse="true">
		<key column="corporation" not-null="true"/>
		<one-to-many class="GeoLabel"/>
	</set>

</class>
</hibernate-mapping>
