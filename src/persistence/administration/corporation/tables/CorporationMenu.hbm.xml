<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.administration.corporation.tables">
    <class name="CorporationMenu" table="corporationmenu">

        
        <composite-id class="CorporationMenuPK" name="pk" >
       		<key-property 	name="corporation"	type="java.lang.Integer" column="corporation" />
      
       		<key-many-to-one name="MenuOption" column="id" class="MenuOption" />
	   </composite-id>
	   <property name="enable"/>
       
    </class>
</hibernate-mapping>
