<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.administration.user.tables">
    <class name="User" table="users">

        <id name="loginName" column="loginname" type="java.lang.String">
            <generator class="assigned">
            </generator>
        </id>

        <property 	name="firstName"		type="java.lang.String"	column="firstName" 		not-null="true"/>
        <property 	name="lastName" 		type="java.lang.String" 	column="lastname"		not-null="true"/>
       	<property 	name="language"		type="java.lang.String" 	column="language"/>
        <property 	name="email"		type="java.lang.String" 	column="email"/>
        <property	name="password"		type="java.lang.String"	column="password"		not-null="true"/>
 		<property	name="corporationId"	type="java.lang.Integer"	column="corporationId"	not-null="true"/>
        <many-to-one name="driver" class="persistence.driver.tables.Driver" column="driver" />
        <property	name="contractorId"	type="java.lang.Integer"	column="contractorId" />
        
        <property	name="alertDate"	type="java.util.Date"	column="alertDate"	/>
       
    </class>

</hibernate-mapping>
