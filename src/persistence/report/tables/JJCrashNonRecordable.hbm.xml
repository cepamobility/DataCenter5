<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.report.tables">
    <class name="JJCrashNonRecordable" table="jjcrashnonrecordable">
  
        <id	column="id"	name="id"	type="java.lang.Integer">
            <generator class="sequence">
            	<param name="sequence">JJReports_cnr_Sequence</param>
            </generator>
        </id>
        
        <property	name="linelabel"	type="java.lang.String"		column="linelabel"		not-null="true" />
        
       
	    <property	name="count"	type="java.lang.Integer"		column="count"		not-null="true" />
	 
	    <many-to-one name="snapshot" column="snapshot" not-null="true"/>
	    
    </class>
</hibernate-mapping>
