<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.log.user">
    <class
        name="UserLog"
        table="userslog"
    >

       <composite-id class="UserLogPK" name="pk" >
	        <key-property	name="userId"	type="java.lang.String"	column="userid"/>
	        <key-property	name="loginUser"	type="java.lang.String"	column="loginuser"/>
	        <key-property	name="date"	type="java.util.Date"	column="date"/>
       </composite-id>

        <property
            name="action"
            type="java.lang.Integer"
            column="action"
            not-null="true"
        />

        <property
            name="firstName"
            type="java.lang.String"
            column="firstName"
            not-null="true"
        />

        <property
            name="lastName"
            type="java.lang.String"
            column="lastname"
            not-null="true"
        />
        
       <property
            name="language"
            type="java.lang.String"
            column="language"
        />

        <property
            name="email"
            type="java.lang.String"
            column="email"
        />

        <property
            name="password"
            type="java.lang.String"
            column="password"
            not-null="true"
        />
        
 		<property
 			name="corporationId"
            type="java.lang.Integer"
            column="corporationId"
            not-null="true"
 		/>
        
    </class>

</hibernate-mapping>
