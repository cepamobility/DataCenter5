<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.event.tables" >
	<class name="EventDamage" table="eventdamage">
		<id column="eventdamageid" name="id">
            <generator class="sequence"> 
            	<param name="sequence">EventDamage_Sequence</param>
            </generator>
        </id>    
       <property name="damage" type="java.lang.Integer"  column="damage"/>
    </class>
</hibernate-mapping>
        
       