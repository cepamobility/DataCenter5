<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.event.tables" >
	<class name="ReparationComment" table="reparationcomments">
        
		<id column="id" name="id">
            <generator class="sequence">
            	<param name="sequence">ReparationComment_Sequence</param>
            </generator>
        </id>		 
		   		
   		<property 	name="reparation" 	type="java.lang.Integer" column="reparation"	not-null="true"/>
		
		<property 	name="maintenance1" 	type="java.lang.Integer" column="maintenance1"	not-null="true"/>
   		<property 	name="comment" 				type="text" column="comment"/>
   									
    </class>
</hibernate-mapping>
