<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.datatype.tables" >
    <class name="UnconformityType" table="UnconformityTypes">
	 	<id column="id" name="id">
            <generator class="assigned">
            </generator>
        </id>
        <property	name="resourceBundleId" type="java.lang.String" column="resourceBundleId"/>                		        		
        <property	name="corporationId" type="integer" column="corporationId"/>                		        		        
   </class>
</hibernate-mapping>