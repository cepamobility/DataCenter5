<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.vehicle.tables" >
    <class name="VehicleTrailer" table="vehicletrailers">

       <composite-id class="VehicleTrailerPK" name="pk" >
       		<key-many-to-one name="vehicle" column="vehicle" class="Vehicle" />
       	 	<key-many-to-one name="trailer" column="trailer" class="Trailer" />
       </composite-id>

	</class>
</hibernate-mapping>
