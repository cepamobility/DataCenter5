<?xml version="1.0"?>

<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.cepasystem.tables" >
    <class name="CepaSystemActivityRegistry" table="cepasystemactivityregistry">
		
	 	<id column="id" name="id" >
            <generator class="sequence">
            	<param name="sequence">CENAPRAActivityRegistry_Sequence</param>
            </generator>
        </id>

        <many-to-one name="activity" class="CepaSystemActivity" not-null="true" column="activity" />        
        <many-to-one name="driver" class="persistence.driver.tables.Driver" not-null="true" column="driver" />

       	<property name="observations" type="java.lang.String" column="observations"  />
	 </class>

</hibernate-mapping>