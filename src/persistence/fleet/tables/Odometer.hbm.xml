<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.fleet.tables" >
	<class name="Odometer" table="odometers">
        
       <composite-id class="OdometerPK" name="pk" >
       		<key-many-to-one
       			 name="fleet"
       			 column="fleet"
       			 class="persistence.fleet.tables.IndividualFleet"
       	 	/>
       		<key-many-to-one
       			 name="vehicle"
       			 column="vehicle"
       			 class="persistence.vehicle.tables.Vehicle"
       	 	/>
	        <key-property 	name="period"	type="java.lang.Integer"	column="period" />
    	    <key-property 	name="year"		type="java.lang.Integer"	column="year" />
       </composite-id>

   	    <property 	name="odometer"		type="java.lang.Integer"	column="odometer" />

   	    <property 	name="accidents"	type="java.lang.Integer"	column="accidents" />
   	    <property 	name="incidents"	type="java.lang.Integer"	column="incidents" />
   	    
   	    <property 	name="nearmiss"	type="java.lang.Integer" >
   	    	<column name="nearmiss" default="0" not-null="true">
   	    	</column>
   	    </property>

   	    <property 		name="fuel"			type="java.lang.Integer"	column="fuel" />
        <many-to-one 	name="fuelType" 	class="persistence.datatype.tables.TypeFuel"	column="fueltype"/>                        

        <many-to-one name="divOrg1" class="persistence.administration.corporation.tables.DivOrgItemLevel1" column="divorg1" />
        <many-to-one name="divOrg2" class="persistence.administration.corporation.tables.DivOrgItemLevel1" column="divorg2" />
        <many-to-one name="divOrg3" class="persistence.administration.corporation.tables.DivOrgItemLevel1" column="divorg3" />
    </class>
</hibernate-mapping>
