<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.activity.tables">
	<class name="CheckListItem" table="checklistitems">
        
       <composite-id class="CheckListItemPK" name="pk" >
       		<key-many-to-one
       			 name="checkList"
       			 column="checklist"
       			 class="persistence.activity.tables.CheckList"
       	 	/>
	        <key-property 	name="item"	type="java.lang.Integer"	column="item" />
	        <key-property 	name="index"	type="java.lang.Integer"	column="index" />
       </composite-id>
    </class>
</hibernate-mapping>
