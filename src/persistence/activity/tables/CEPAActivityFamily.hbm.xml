<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.activity.tables">
    <class name="CEPAActivityFamily" table="cepaactivityfamily">

        <id	column="id"	name="id"	type="java.lang.Integer">
            <generator class="assigned" />
        </id>
        <property name="name" column="name" not-null="true" unique="true" type="java.lang.String" />
        
        <many-to-one name="clasification" column="clasification"
        	class="persistence.activity.tables.CEPAActivityFamilyClasification">
        </many-to-one>
                
    </class>
</hibernate-mapping>
