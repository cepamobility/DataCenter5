<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="persistence.driver.tables">
    <class name="DriverLicenseImage" table="driverlicenseimages">

        <id	column="id"	name="id" type="java.lang.Integer">
            <generator class="assigned">
            </generator>
        </id>

	    <property 	name="image"	type="text"	column="image" />
        <property 	name="file" 	type="java.lang.String" column="file" />
        <property 	name="date" 	type="java.sql.Date" 	column="date" />
        
    </class>
</hibernate-mapping>
