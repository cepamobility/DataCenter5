<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">


<hibernate-mapping package="persistence.driver.tables">
	<class name="DriverPointMoveHistory" table="driverpointmovehistory">
		
       	<composite-id class="DriverPointMoveHistoryPK" name="pk" >
       		<key-many-to-one name="driver" column="id" class="Driver" />
	        <key-property column="period" name="period" type="java.lang.Integer" />
	        <key-property column="year" name="year" type="java.lang.Integer" />
	        <key-property column="move" name="move" type="java.lang.Integer" />
	  	</composite-id>
		
	   	<property name="amount"	column="amount" type="java.lang.Double" not-null="true" />
       	<property 	name="date" 	type="java.sql.Date" column="date"	not-null="true"/>
   		<property 	name="definition" 	type="java.lang.Integer" column="definition" />
   		<property 	name="reference" 	type="java.lang.String" column="reference" />
   		<property 	name="moveReference" 	type="java.lang.String" column="movereference" />
   				
  	</class>
</hibernate-mapping>
